node_modules
quality/tools/javascript/node_modules
.opencode/
.dx/
# Disposable trees also gitignored (.gitignore): keep Bazel from watching
# or querying them (issue #953). File singletons (*.profraw, *.profdata,
# opencode.json, *.pyc, ...) have no .bazelignore form — only directories
# are listed here; they stay Bazel-visible by design and are contained via
# .gitignore plus LLVM_PROFILE_FILE scratch plus no BUILD glob (issue #1002).
.cache
.direnv
.tmp
__pycache__
dist
release
.ruff_cache
# Gazelle rejects glob patterns; list the four output symlinks explicitly
# (bazel-<workspace_name> is the execroot symlink for this workspace).
bazel-bin
bazel-out
bazel-testlogs
bazel-rules_dx
# Parity notes (mirrors .gitignore): .ruff_cache is the Ruff cache dir;
# bazel-* covers output symlinks (git: /bazel-*); .opencode/ is agent-local
# whole-dir state (git: .opencode/); .dx/ is dx managed state (git: .dx/).
# Editor parity (issue #1072): biome.json files.includes mirrors these
# disposable dirs for editors (Biome v2 uses includes negations: regular
# !**/node_modules plus force-ignore !! for build outputs/caches/state).
