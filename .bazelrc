# dx Bazel preset; comment out an import to drop that layer.
try-import %workspace%/.dx/bazelrc/correctness.bazelrc
try-import %workspace%/.dx/bazelrc/performance.bazelrc
try-import %workspace%/.dx/bazelrc/resources.bazelrc

coverage --test_tag_filters=-no-coverage,-dx-no-coverage-collector

common --local_resources=nested_bazel=2
common --local_resources=msix_package_store=1
common --local_resources=android_emulator=1
common --local_resources=ios_simulator=1
test --test_env=DX_NESTED_BAZEL_HEAP
test:nested_record --test_env=DX_NESTED_BAZEL_NETWORK=1
common --registry=https://bcr.bazel.build

common --incompatible_exclude_starlark_flags_from_exec_config
common --check_direct_dependencies=error
common --downloader_config=tools/workspace/downloader.cfg

startup:macos --host_jvm_args=-XX:MaxRAMPercentage=50
common:macos --local_resources=nested_bazel=1

startup:windows --output_user_root=C:/bz
startup:windows --windows_enable_symlinks

common:windows --override_repository=bazel_tools+winsdk_configure+local_config_winsdk=%workspace%/tools/platforms/no_winsdk

build --@rules_rust//rust/settings:extra_rustc_flags=--deny=warnings
build --@rules_rust//rust/settings:clippy.toml=//tools/workspace:clippy.toml
common --@rules_dx//config:clippy_flag=-Dclippy::unwrap_used
common --@rules_dx//config:clippy_flag=-Dclippy::expect_used
common --@rules_dx//config:clippy_flag=-Dclippy::panic
common --@rules_dx//config:clippy_flag=-Dclippy::unreachable
common --@rules_dx//config:clippy_flag=-Dclippy::exit
common --@rules_dx//config:clippy_flag=-Dclippy::todo
common --@rules_dx//config:clippy_flag=-Dclippy::unimplemented
common --@rules_dx//config:clippy_flag=-Dclippy::get_unwrap
common --@rules_dx//config:clippy_flag=-Dclippy::string_slice
common --@rules_dx//config:clippy_flag=-Dclippy::indexing_slicing
common --@rules_dx//config:clippy_flag=-Dclippy::let_underscore_must_use
common --@rules_dx//config:clippy_flag=-Dclippy::let_underscore_untyped
common --@rules_dx//config:clippy_flag=-Dclippy::fallible_impl_from
common --@rules_dx//config:clippy_flag=-Dclippy::unwrap_in_result
common --@rules_dx//config:clippy_flag=-Dclippy::panic_in_result_fn
common --@rules_dx//config:clippy_flag=-Dclippy::allow_attributes
common --@rules_dx//config:clippy_flag=-Dclippy::allow_attributes_without_reason
common --@rules_dx//config:clippy_flag=-Dclippy::undocumented_unsafe_blocks
common --@rules_dx//config:clippy_flag=-Dclippy::wildcard_enum_match_arm
common --@rules_dx//config:clippy_flag=-Dclippy::match_wildcard_for_single_variants
common --@rules_dx//config:clippy_flag=-Dclippy::let_underscore_future
common --@rules_dx//config:clippy_flag=-Dclippy::unchecked_time_subtraction
common --@rules_dx//config:clippy_flag=-Dclippy::large_futures
common --@rules_dx//config:clippy_flag=-Dclippy::try_err
common --@rules_dx//config:clippy_flag=-Dclippy::infinite_loop
common --@rules_dx//config:clippy_flag=-Dclippy::cast_possible_truncation
common --@rules_dx//config:clippy_flag=-Dclippy::cast_possible_wrap
common --@rules_dx//config:clippy_flag=-Dclippy::mem_forget
common --@rules_dx//config:clippy_flag=-Dclippy::rc_mutex
common --@rules_dx//config:clippy_flag=-Dclippy::multiple_unsafe_ops_per_block
common --@rules_dx//config:clippy_flag=-Dclippy::string_add
common --@rules_dx//config:clippy_flag=-Dclippy::create_dir
common --@rules_dx//config:clippy_flag=-Dclippy::iter_over_hash_type
common --@rules_dx//config:clippy_flag=-Dclippy::map_err_ignore
common --@rules_dx//config:clippy_flag=-Dclippy::unused_result_ok
common --@rules_dx//config:clippy_flag=-Dunsafe_code
common --@rules_dx//config:clippy_flag=-Dunsafe_op_in_unsafe_fn
common --@rules_dx//config:clippy_flag=-Dunused_must_use
build:linux --@rules_rust//rust/settings:pipelined_compilation=true
build:linux --linkopt=-Wno-unused-command-line-argument
build:linux --host_linkopt=-Wno-unused-command-line-argument
build:macos --@rules_rust//rust/settings:pipelined_compilation=true
# Windows rmeta and rlib can carry different SVHs, which breaks pipelined linking.
build:windows --@rules_rust//rust/settings:pipelined_compilation=false
build:windows --@rules_rust//rust/settings:extra_rustc_flag=-Ctarget-feature=+crt-static

build --javacopt=-Xlint:all
build --experimental_strict_java_deps=error

build --features=treat_warnings_as_errors

build --test_env=PYTHONWARNINGS=error

# Apple Clang profiles cannot merge with the hermetic LLVM in Rust test wrappers.
coverage:macos --copt=-fno-profile-instr-generate
coverage:macos --copt=-fno-coverage-mapping

common:bb --remote_cache=grpcs://remote.buildbuddy.io
common:bb --remote_cache_compression
common:bb --remote_timeout=10m
common:bb --credential_helper=remote.buildbuddy.io=%workspace%/tools/buildbuddy-credential-helper.sh
common:bb-ro --config=bb
common:bb-ro --noremote_upload_local_results
common:ci --remote_cache=grpcs://remote.buildbuddy.io
common:ci --experimental_remote_downloader=grpcs://remote.buildbuddy.io
common:ci --experimental_remote_downloader_local_fallback
common:ci --build_metadata=ROLE=CI
common:ci --build_metadata=DISABLE_COMMIT_STATUS_REPORTING=true

common:rbe --remote_executor=grpcs://remote.buildbuddy.io
common:rbe --remote_default_exec_properties=OSFamily=Linux
common:rbe --remote_default_exec_properties=Arch=amd64
common:rbe --remote_default_exec_properties=container-image=docker://gcr.io/flame-public/rbe-ubuntu24-04@sha256:be9853fc45092d2cf2bda3abed30d22182881659a50bf35c7125161d7cfc8a75
common:rbe --remote_default_exec_properties=dockerUser=nobody
common:rbe --remote_local_fallback
common:rbe --strategy=TestRunner=remote,sandboxed,local

build:linux --@rules_rust_wasm_bindgen//settings:test_browser=firefox

build --//ruby/private/quality:rubocop=@gems//bin:rubocop

try-import %workspace%/user.bazelrc

build:scalac_cold --noremote_accept_cached --disk_cache=
build:scalac_diag --config=scalac_cold --worker_extra_flag=Scalac=--wrapper_script_flag=--jvm_flag=-XX:+DisplayVMOutputToStderr --worker_extra_flag=Scalac=--wrapper_script_flag=--jvm_flag=-XX:+ErrorFileToStderr
build:scalac_local --config=scalac_cold --strategy=Scalac=local
build:scalac_noshare --config=scalac_cold --worker_extra_flag=Scalac=--wrapper_script_flag=--jvm_flag=-Xshare:off
