import %workspace%/tools/bazelrc/correctness.bazelrc
import %workspace%/tools/bazelrc/performance.bazelrc
import %workspace%/tools/bazelrc/resources.bazelrc

# Keep -no-coverage and also skip languages with no coverage collector yet.
coverage --test_tag_filters=-no-coverage,-dx-no-coverage-collector

test:retry --flaky_test_attempts=3
test --test_timeout=60,300,900,3600
common --local_resources=nested_bazel=2
test --test_env=DX_NESTED_BAZEL_SLOTS
test --test_env=DX_NESTED_BAZEL
test --test_env=DX_NESTED_BAZEL_ROOT
test --test_env=DX_NESTED_BAZEL_HEAP
test --test_env=DX_NESTED_BAZEL_DISK_CACHE
test --test_env=DX_NESTED_BAZEL_REPOSITORY_CACHE
test --test_env=BAZELISK_BASE_URL
test --test_env=BAZELISK_HOME
common --registry=https://bcr.bazel.build
common --check_direct_dependencies=error
common --experimental_repository_downloader_retries=5

startup:macos --host_jvm_args=-XX:MaxRAMPercentage=50
common:macos --local_resources=nested_bazel=1

startup:windows --output_user_root=C:/bz
startup:windows --windows_enable_symlinks

common:windows --experimental_override_platform_cpu_name=//tools/platforms:windows_msvc_host=wx
common:windows --repo_env=BAZEL_MSVC_RUNTIME_VISUAL_STUDIO_EULA=1
common:windows --extra_toolchains=@pythons_hub//:all
common:windows --repo_env=BAZEL_WINDOWS_SDK_EULA=1
build:windows --per_file_copt=external/protobuf[+]/upb/wire/encode[.]c@-D__SEH__
build:windows --host_per_file_copt=external/protobuf[+]/upb/wire/encode[.]c@-D__SEH__

build --@rules_rust//rust/settings:extra_rustc_flags=--deny=warnings
build --@rules_rust//rust/settings:clippy.toml=//tools/workspace:clippy.toml
common:apple_family --extra_toolchains=@local_config_apple_cc_toolchains//:all
build:linux --@rules_rust//rust/settings:pipelined_compilation=true
build:linux --linkopt=-Wno-unused-command-line-argument
build:linux --host_linkopt=-Wno-unused-command-line-argument
build:macos --@rules_rust//rust/settings:pipelined_compilation=true
build:windows --@rules_rust//rust/settings:pipelined_compilation=true
# Statically link the MSVC CRT so Windows binaries need no vcruntime DLLs.
build:windows --@rules_rust//rust/settings:extra_rustc_flag=-Ctarget-feature=+crt-static

build --javacopt=-Xlint:all
build --experimental_strict_java_deps=error

build --features=treat_warnings_as_errors

build --test_env=PYTHONWARNINGS=error

build --@rules_rust//cargo/settings:use_default_shell_env=False

# Apple Clang's C++ profiles cannot merge with the hermetic LLVM in Rust test wrappers.
coverage:macos --copt=-fno-profile-instr-generate
coverage:macos --copt=-fno-coverage-mapping


# The conda ocamlc finds its stdlib relative to the unresolved executable path, which the darwin sandbox leaves without lib/ocaml.
build:macos --modify_execution_info=CompileOcaml.*=+no-sandbox,CompileOCaml.*=+no-sandbox,ArchiveOCaml.*=+no-sandbox,LinkOCaml.*=+no-sandbox

coverage:windows --features=-coverage
coverage:windows --features=-gcc_coverage_map_format
coverage:windows --per_file_copt=.*compiler-rt/lib/profile/.*@-D__MINGW_EXTENSION=

common:bb --remote_cache=grpcs://remote.buildbuddy.io
common:bb --remote_cache_compression
common:bb --remote_timeout=10m
common:bb --credential_helper=remote.buildbuddy.io=%workspace%/tools/buildbuddy-credential-helper.sh
common:ci --remote_cache=grpcs://remote.buildbuddy.io
common:ci --build_metadata=ROLE=CI
common:ci --build_metadata=DISABLE_COMMIT_STATUS_REPORTING=true

common:rbe --remote_executor=grpcs://remote.buildbuddy.io
common:rbe --remote_default_exec_properties=OSFamily=Linux
common:rbe --remote_default_exec_properties=Arch=amd64
common:rbe --remote_default_exec_properties=container-image=docker://gcr.io/flame-public/rbe-ubuntu24-04:latest
common:rbe --remote_default_exec_properties=dockerUser=nobody
common:rbe --remote_local_fallback
common:rbe --strategy=TestRunner=remote,sandboxed,local

# Fixture for consumer --config passthrough checks.
build:dx_consumer_probe --copt=-DDX_CONSUMER_PROBE

# Compilation modes for evidence.yml, which only accepts --config flags.
build:cc_dbg --compilation_mode=dbg
build:cc_opt --compilation_mode=opt

# iOS simulator builds run debug code for arm64 simulators.
build:ios_sim --compilation_mode=dbg
build:ios_sim --ios_multi_cpus=sim_arm64

build:linux --@rules_rust_wasm_bindgen//settings:test_browser=firefox

# Source builds of Python sdists run without network.
common --modify_execution_info=PySdist.*=+block-network

# rules_dx binds its own native configs once in this policy.
common --//config:workspace=//:dx_workspace_policy

try-import %workspace%/user.bazelrc

build --//quality/tools/ruby:rubocop=@bundle//bin:rubocop
