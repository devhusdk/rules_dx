import %workspace%/tools/bazelrc/preset.bazelrc

test --flaky_test_attempts=3
test --test_timeout=300
test --local_test_jobs=4

startup:windows --output_user_root=C:/bz

build --@rules_rust//rust/settings:extra_rustc_flags=--deny=warnings

# The generated JavaScript tool launchers walk a materialized runfiles tree, which Windows
# otherwise leaves unmaterialized and resolves to manifest-only. Every other host already
# builds the links.
build --build_runfile_links

build --javacopt=-Werror
build --javacopt=-Xlint:all

build --test_env=PYTHONWARNINGS=error

build --java_runtime_version=remotejdk_21
build --tool_java_runtime_version=remotejdk_21

build --@rules_rust//cargo/settings:use_default_shell_env=False

# Apple Clang's C++ profiles cannot merge with the hermetic LLVM in Rust test wrappers.
coverage:macos --copt=-fno-profile-instr-generate
coverage:macos --copt=-fno-coverage-mapping

common:bb --remote_cache=grpcs://remote.buildbuddy.io
common:bb --remote_cache_compression
common:bb --remote_timeout=10m
common:bb --remote_download_outputs=all
common:ci --remote_cache=grpcs://remote.buildbuddy.io
common:ci --remote_cache_compression
common:ci --remote_timeout=10m
common:ci --remote_download_outputs=all
common:ci --announce_rc
common:ci --build_metadata=ROLE=CI
common:ci --build_metadata=DISABLE_COMMIT_STATUS_REPORTING=true
common:ci-pr --noremote_upload_local_results

try-import %workspace%/user.bazelrc
