load("@rules_dx//quality:fixtures.bzl", "real_source_target")

"""BCR submission templates."""

package(default_visibility = ["//:__subpackages__"])

exports_files(
    ["presubmit.yml"],
    visibility = ["//deploy/release/tests:__pkg__"],
)

filegroup(
    name = "templates",
    srcs = [
        "config.yml",
        "metadata.template.json",
        "presubmit.yml",
        "source.template.json",
    ],
)

filegroup(
    name = "family_templates",
    srcs = glob(
        ["families/*/*"],
        allow_empty = True,
    ),
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
