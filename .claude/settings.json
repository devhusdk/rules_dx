{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/tools/dx worktree hook guard",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/tools/dx worktree hook stop",
            "type": "command"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/tools/dx worktree hook create",
            "type": "command"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/tools/dx worktree hook remove",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(tools/dx check *)",
      "Bash(tools/dx test *)",
      "Bash(tools/dx build *)",
      "Bash(tools/dx status *)",
      "Bash(tools/dx version *)"
    ]
  }
}
