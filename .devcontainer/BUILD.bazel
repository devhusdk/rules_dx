load("@crates//:crates.bzl", "aliases")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")

package(default_visibility = ["//:__subpackages__"])

rust_test(
    name = "devcontainer_parity_test",
    srcs = ["devcontainer_parity_test.rs"],
    aliases = aliases(
        package_name = "devcontainer_tests",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "devcontainer_parity_test",
    crate_root = "devcontainer_parity_test.rs",
    data = [
        ":devcontainer.json",
        "//cli/cli:dx",
    ],
    env = {
        "DX_DEVCONTAINER_EXPECTED": "$(rootpath :devcontainer.json)",
        "DX_DX_BIN": "$(rootpath //cli/cli:dx)",
    },
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["//tools/testing:dx_testing"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
