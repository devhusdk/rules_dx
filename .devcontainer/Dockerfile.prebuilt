# Prebuilt devcontainer image with a pinned base and Bazelisk.
FROM ubuntu:24.04@sha256:69cecf4bbf72d2d44a9eef1b71fb98c7fb973d78af11399deccef19beb008ad9

ENV DEBIAN_FRONTEND=noninteractive

# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/*

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Pinned Bazelisk launcher.
COPY tools/bazelisk/pin.env .bazelversion /tmp/pins/
# hadolint ignore=SC1091
RUN . /tmp/pins/pin.env \
    && curl -fsSL --proto '=https' --tlsv1.2 --retry 3 --retry-delay 2 -o /tmp/bazelisk \
      "https://github.com/bazelbuild/bazelisk/releases/download/v${BAZELISK_VERSION}/bazelisk-linux-amd64" \
    && echo "${BAZELISK_SHA256_LINUX_AMD64}  /tmp/bazelisk" | sha256sum -c - \
    && install -m755 /tmp/bazelisk /usr/local/bin/bazel \
    && rm /tmp/bazelisk \
    && USE_BAZEL_VERSION="$(cat /tmp/pins/.bazelversion)" bazel version \
    && rm -r /tmp/pins

# Non-root dev user matching the devcontainers convention.
RUN useradd -m -s /bin/bash vscode
# hadolint ignore=DL3066
USER vscode
WORKDIR /workspaces/rules_dx
