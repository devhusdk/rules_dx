{
  "name": "rules_dx",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/bazel:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer","golang.go","llvm-vs-code-extensions.vscode-clangd","redhat.java","fwcd.kotlin","scalameta.metals","ms-dotnettools.csharp","ionide.ionide-fsharp"]
    }
  },
  "postCreateCommand": "bazel run //dx:env && bazel run @rules_dx//:dx -- setup"
}
