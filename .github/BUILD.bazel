"""Repository GitHub metadata corpus."""

load("//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

filegroup(
    name = "workflows",
    srcs = glob(
        [
            "workflows/*.yml",
            "workflows/*.yaml",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "actions",
    srcs = glob(["actions/*/action.yml"]),
)

exports_files([
    "actions/assert-no-secret/scan.cjs",
    "actions/remote-cache-helper/helper.cjs",
    "actionlint.yaml",
    "review-paths.txt",
    "rulesets/main.json",
    "workflows/README.md",
] + glob(
    [
        "workflows/*.yml",
        "workflows/*.yaml",
    ],
    allow_empty = True,
))

real_source_target(
    name = "corpus_markdown",
    markdown_siblings = [
        "//docs:github-ci.md",
    ],
    markdown_srcs = [
        "ISSUE_TEMPLATE/bug_report.md",
        "ISSUE_TEMPLATE/feature_proposal.md",
        "PULL_REQUEST_TEMPLATE.md",
        "workflows/README.md",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = [
        "BUILD.bazel",
        "workflows/dx-update.yml",
    ],
    visibility = ["//:__subpackages__"],
)
