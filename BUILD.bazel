package(default_visibility = ["//:__subpackages__"])

alias(
    name = "dx",
    actual = "@dx_prebuilt//:dx",
    visibility = ["//visibility:public"],
)

js_library(
    name = "package_json",
    srcs = ["package.json"],
)

npm_link_all_packages(name = "node_modules")

exports_files([
    "clippy.toml",
    ".bazelignore",
    ".bazelrc",
    ".bazelversion",
    ".clang-format",
    ".editorconfig",
    ".gitignore",
    ".npmrc",
    ".shellcheckrc",
    "MODULE.bazel",
    "MODULE.bazel.lock",
    "README.md",
    "android/README.md",
    "csharp/README.md",
    "cuda/README.md",
    "d/README.md",
    "elixir/README.md",
    "fortran/README.md",
    "fsharp/README.md",
    "lua/README.md",
    "ocaml/README.md",
    "perl/README.md",
    "php/README.md",
    "powershell/README.md",
    "ruby/README.md",
    "julia/README.md",
    "zig/README.md",
    "cargo-bazel-lock.json",
    "package.json",
    "pnpm-lock.yaml",
    ".vale.ini",
    "biome.json",
    "ruff.toml",
    "pnpm-workspace.yaml",
    "licenses.toml",
])

filegroup(
    name = "audit_curator",
    srcs = ["licenses.toml"],
)

filegroup(
    name = "module_srcs",
    srcs = [
        ".bazelversion",
        "BUILD.bazel",
        "MODULE.bazel",
        "MODULE.bazel.lock",
        "//cli/prebuilt:module_srcs",
        "//config:module_srcs",
        "//libs/starlark:module_srcs",
        "//modules:module_srcs",
        "//quality:module_srcs",
        "//rust/rules:module_srcs",
    ],
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "packaging_root_data",
    srcs = [
        "README.md",
        "//docs:github-ci.md",
    ],
)

rustfmt_config(
    name = "rustfmt_config",
    src = "rustfmt.toml",
    visibility = ["//:__subpackages__"],
)

scalafmt_config(
    name = "scalafmt_config",
    src = ".scalafmt.conf",
    visibility = ["//:__subpackages__"],
)

ruff_config(
    name = "ruff_config",
    src = "ruff.toml",
    visibility = ["//:__subpackages__"],
)

biome_config(
    name = "biome_config",
    src = "biome.json",
    visibility = ["//:__subpackages__"],
)

clang_format_config(
    name = "clang_format_config",
    src = ".clang-format",
    visibility = ["//:__subpackages__"],
)

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["//quality:corpus_vale_config"],
    markdown_siblings = [
        "//docs:README.md",
        "//docs:adopting-existing-bazel.md",
        "//docs:cli/commands/README.md",
        "//docs:github-ci.md",
        "//docs:support-matrix.md",
        "//examples:README.md",
        "LICENSE",
    ],
    markdown_srcs = [
        "AGENTS.md",
        "CONTRIBUTING.md",
        "README.md",
        "SECURITY.md",
        "android/README.md",
        "csharp/README.md",
        "d/README.md",
        "elixir/README.md",
        "fortran/README.md",
        "fsharp/README.md",
        "lua/README.md",
        "ocaml/README.md",
        "perl/README.md",
        "php/README.md",
        "//haskell:README.md",
        "patches/README.md",
        "powershell/README.md",
        "ruby/README.md",
        "julia/README.md",
        "zig/README.md",
        "cuda/README.md",
        "CLAUDE.md",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "MODULE.bazel",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = [
        "clippy.toml",
        "ruff.toml",
        "rustfmt.toml",
        "licenses.toml",
        "security.toml",
    ],
)

vale_config(
    name = "vale_config",
    src = ".vale.ini",
    data = ["//quality:corpus_styles/Dx/Markers.yml"],
    visibility = ["//:__subpackages__"],
)

buildifier_config(
    name = "buildifier_config",
    src = ".buildifier.json",
    visibility = ["//:__subpackages__"],
)
