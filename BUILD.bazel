# keep
rust_test(
    name = "preset_parity_test",
    srcs = ["preset_parity_test.rs"],
    data = [
        "//cli/cli:dx",
        "//tools/bazelrc:preset.bazelrc",
        "//tools/bazelrc:src/lib.rs",
    ],
    env = {
        "DX_DX_BIN": "$(rootpath //cli/cli:dx)",
        "DX_PRESET_EXPECTED": "$(rootpath //tools/bazelrc:preset.bazelrc)",
        "DX_PRESET_RS": "$(rootpath //tools/bazelrc:src/lib.rs)",
    },
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//tools/bazelrc:dx_preset",
        "//tools/testing:dx_testing",
    ],
)

