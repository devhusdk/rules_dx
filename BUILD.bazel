package(default_visibility = ["//:__subpackages__"])

alias(
    name = "dx",
    actual = "@dx_prebuilt//:dx",
    visibility = ["//visibility:public"],
)

js_library(
    name = "package_json",
    srcs = ["package.json"],
)

npm_link_all_packages(name = "node_modules")

exports_files([
    "LICENSE",
    "RELEASING.md",
    "clippy.toml",
    ".bazelignore",
    ".bazelrc",
    ".bazelversion",
    ".clang-format",
    ".editorconfig",
    ".gitignore",
    ".npmrc",
    ".scalafmt.conf",
    ".shellcheckrc",
    "MODULE.bazel",
    "MODULE.bazel.lock",
    "README.md",
    "cuda/README.md",
    "d/README.md",
    "fortran/README.md",
    "go/README.md",
    "javascript/README.md",
    "lua/README.md",
    "ocaml/README.md",
    "perl/README.md",
    "php/README.md",
    "powershell/README.md",
    "python/README.md",
    "julia/README.md",
    "swift/README.md",
    "typescript/README.md",
    "zig/README.md",
    "cargo-bazel-lock.json",
    "package.json",
    "pnpm-lock.yaml",
    ".vale.ini",
    "biome.json",
    "ruff.toml",
    "pnpm-workspace.yaml",
    "licenses.toml",
    "security.toml",
    ".dx/config/licenses/standard.toml",
    ".dx/config/licenses/strict.toml",
    ".dx/config/security/standard.toml",
    ".dx/config/security/strict.toml",
])

filegroup(
    name = "audit_bases",
    srcs = [
        ".dx/config/licenses/standard.toml",
        ".dx/config/licenses/strict.toml",
        ".dx/config/security/standard.toml",
        ".dx/config/security/strict.toml",
    ],
)

filegroup(
    name = "audit_curator",
    srcs = [
        "licenses.toml",
        ":audit_bases",
    ],
)

filegroup(
    name = "module_srcs",
    srcs = [
        ".bazelversion",
        "BUILD.bazel",
        "MODULE.bazel",
        "MODULE.bazel.lock",
        "//cli/prebuilt:module_srcs",
        "//config:module_srcs",
        "//libs/starlark:module_srcs",
        "//modules:module_srcs",
        "//quality:module_srcs",
        "//rust/rules:module_srcs",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "packaging_root_data",
    srcs = [
        "README.md",
        "//docs:github-ci.md",
    ],
)

rustfmt_config(
    name = "rustfmt_config",
    src = "rustfmt.toml",
    visibility = ["//:__subpackages__"],
)

scalafmt_config(
    name = "scalafmt_config",
    src = ".scalafmt.conf",
    visibility = ["//visibility:public"],
)

ruff_config(
    name = "ruff_config",
    src = "ruff.toml",
    visibility = ["//:__subpackages__"],
)

biome_config(
    name = "biome_config",
    src = "biome.json",
    visibility = ["//:__subpackages__"],
)

clang_format_config(
    name = "clang_format_config",
    src = ".clang-format",
    visibility = ["//:__subpackages__"],
)

real_source_target(
    name = "corpus_markdown",
    markdown_siblings = [
        "//docs:README.md",
        "//docs:adopting-existing-bazel.md",
        "//docs:adopting-without-bazel.md",
        "//docs:bazel-for-dx-users.md",
        "//docs:cli/commands/README.md",
        "//docs:github-ci.md",
        "//docs:support-matrix.md",
        "//examples:README.md",
        "LICENSE",
    ],
    markdown_srcs = [
        "AGENTS.md",
        "CONTRIBUTING.md",
        "README.md",
        "SECURITY.md",
        "d/README.md",
        "fortran/README.md",
        "go/README.md",
        "javascript/README.md",
        "lua/README.md",
        "ocaml/README.md",
        "perl/README.md",
        "php/README.md",
        "patches/README.md",
        "powershell/README.md",
        "python/README.md",
        "julia/README.md",
        "swift/README.md",
        "typescript/README.md",
        "zig/README.md",
        "cuda/README.md",
        "CLAUDE.md",
        "RELEASING.md",
        "containers/README.md",
        "flutter/README.md",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "MODULE.bazel",
    ],
    tags = ["corpus"],
)

json_schema(
    name = "security_schema",
    src = "//cli/audit:schema/security.schema.json",
    files = [
        "security.toml",
        ".dx/config/security/standard.toml",
        ".dx/config/security/strict.toml",
    ],
    url = "https://raw.githubusercontent.com/devhusdk/rules_dx/main/cli/audit/schema/security.schema.json",
)

json_schema(
    name = "licenses_schema",
    src = "//cli/audit:schema/licenses.schema.json",
    files = [
        "licenses.toml",
        ".dx/config/licenses/standard.toml",
        ".dx/config/licenses/strict.toml",
    ],
    url = "https://raw.githubusercontent.com/devhusdk/rules_dx/main/cli/audit/schema/licenses.schema.json",
)

json_schemas(
    name = "json_schemas",
    schemas = [
        ":licenses_schema",
        ":security_schema",
    ],
)

real_source_target(
    name = "corpus_toml",
    aspect_hints = [":json_schemas"],  # keep
    tags = ["corpus"],
    toml_srcs = [
        "clippy.toml",
        "ruff.toml",
        "rustfmt.toml",
        "licenses.toml",
        "security.toml",
        ".dx/config/licenses/standard.toml",
        ".dx/config/licenses/strict.toml",
        ".dx/config/security/standard.toml",
        ".dx/config/security/strict.toml",
    ],
)

vale_config(
    name = "vale_config",
    src = ".vale.ini",
    data = [
        "//quality:corpus_styles/Dx/Launcher.yml",
        "//quality:corpus_styles/Dx/Markers.yml",
    ],
    visibility = ["//:__subpackages__"],
)

buildifier_config(
    name = "buildifier_config",
    src = ".buildifier.json",
    visibility = ["//visibility:public"],
)

workspace_policy(
    name = "dx_workspace_policy",
    configs = [
        ":biome_config",
        ":buildifier_config",
        ":clang_format_config",
        ":ruff_config",
        ":rustfmt_config",
        ":scalafmt_config",
        ":vale_config",
        "//quality:corpus_checkstyle_config",
    ],
    extends = "//quality:default_workspace_policy",
    visibility = ["//visibility:public"],
)
