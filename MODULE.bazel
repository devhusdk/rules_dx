module(
    name = "rules_dx",
    version = "0.0.0",
)

bazel_dep(name = "rules_rust", version = "0.74.0")
single_version_override(
    module_name = "rules_rust",
    patch_strip = 1,
    patches = ["//patches/rules_rust:lld_link.patch"],
    version = "0.74.0",
)

bazel_dep(name = "rules_rust_wasm_bindgen", version = "0.74.0")
single_version_override(
    module_name = "rules_rust_wasm_bindgen",
    patch_strip = 1,
    patches = ["//patches/rules_rust_wasm_bindgen:no_wasm_coverage.patch"],
    version = "0.74.0",
)

bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "llvm", version = "0.8.23")
bazel_dep(name = "rules_cuda", version = "0.3.0")
bazel_dep(name = "toolchains_llvm", version = "1.12.0")
bazel_dep(name = "googletest", version = "1.18.0")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.52.2")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "apple_support", version = "2.9.1")
bazel_dep(name = "rules_apple", version = "5.2.0")

gazelle_go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
gazelle_go_deps.from_file(go_mod = "//third_party/go:go.mod")
use_repo(gazelle_go_deps, "cc_mvdan_gofumpt", "com_github_bazelbuild_buildtools", "com_github_google_go_cmp", "com_github_pmezard_go_difflib", "com_github_yuin_goldmark", "org_golang_x_mod", "org_golang_x_net")
