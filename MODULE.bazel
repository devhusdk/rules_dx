# explicit drops rules_foreign_cc's system cmake fallback, so a platform without a pinned cmake fails analysis
_foreign_cc_tools = use_extension("@rules_foreign_cc//foreign_cc:extensions.bzl", "tools", dev_dependency = True)
_foreign_cc_tools.explicit()
_foreign_cc_tools.cmake(
    mode = "binary",
    version = "3.31.12",
)
_foreign_cc_tools.ninja(
    exec_compatible_with = ["@platforms//os:linux"],
    mode = "custom",
    target = "@ninja",
)
_foreign_cc_tools.ninja(
    exec_compatible_with = ["@platforms//os:macos"],
    mode = "custom",
    target = "@ninja",
)

# make, m4 and pkgconfig are not needed by the Ninja generator on Windows and do not build with cl.exe, so they are noop there (#6220)
# the pinned ninja source does not build with clang-cl (std::set_terminate), so Windows uses the prebuilt binary; the linux and macos tags above win elsewhere (#6220)
_foreign_cc_tools.ninja(
    mode = "binary",
    version = "1.13.2",
)
_foreign_cc_tools.make(
    exec_compatible_with = ["@platforms//os:linux"],
    mode = "custom",
    target = "@make",
)
_foreign_cc_tools.make(
    exec_compatible_with = ["@platforms//os:macos"],
    mode = "custom",
    target = "@make",
)
_foreign_cc_tools.make(
    exec_compatible_with = ["@platforms//os:windows"],
    mode = "noop",
)
_foreign_cc_tools.m4(
    exec_compatible_with = ["@platforms//os:linux"],
    mode = "custom",
    target = "@m4",
)
_foreign_cc_tools.m4(
    exec_compatible_with = ["@platforms//os:macos"],
    mode = "custom",
    target = "@m4",
)
_foreign_cc_tools.m4(
    exec_compatible_with = ["@platforms//os:windows"],
    mode = "noop",
)
_foreign_cc_tools.pkgconfig(
    exec_compatible_with = ["@platforms//os:linux"],
    mode = "custom",
    target = "@pkgconf//:pkg-config",
)
_foreign_cc_tools.pkgconfig(
    exec_compatible_with = ["@platforms//os:macos"],
    mode = "custom",
    target = "@pkgconf//:pkg-config",
)
_foreign_cc_tools.pkgconfig(
    exec_compatible_with = ["@platforms//os:windows"],
    mode = "noop",
)

