# go_deps rejects module_override in a non-root module, so gotreesitter is fetched
# directly. It embeds grammars/grammar_blobs/go.bin from a sibling package, which
# Gazelle cannot express; the patch adds that file to the root library's embedsrcs.
# map_kind makes the generated loads use rules_go's name in this module.
# Return to a version once a gotreesitter release carries odvcencio/gotreesitter#1574.
go_repository = use_repo_rule("@gazelle//internal:go_repository.bzl", "go_repository")

go_repository(
    name = "com_github_odvcencio_gotreesitter",
    build_directives = [
        "gazelle:map_kind go_library go_library @rules_go//go:def.bzl",
        "gazelle:map_kind go_test go_test @rules_go//go:def.bzl",
        "gazelle:map_kind go_binary go_binary @rules_go//go:def.bzl",
    ],
    importpath = "github.com/odvcencio/gotreesitter",
    patch_args = ["-p1"],
    patches = ["//third_party/go:gotreesitter_embed.patch"],
    sha256 = "6c915c29ff5db03bcb2f2db690caed293c689c32bf445d48b5c0e2f5997a7a4a",
    strip_prefix = "gotreesitter-a8d5183f93260b8c3743375f70f4dee5b1778569",
