# ring's build.rs only accepts plain clang on windows_arm64; the hermetic
# toolchain uses clang-cl (#6337, briansmith/ring#2673). cl.exe opens the
# fiat includes without collapsing `..`, which overflows MAX_PATH under the
# build script runfiles (#8290). The MSVC compiler has no clang, so ring's
# aarch64 build script gets the hermetic clang-cl as CC (#9224). ring's /Wall
# is -Weverything in clang-cl, so the MSVC toolchain's /WX is turned off.
crate.annotation(
    crate = "ring",
    patch_args = ["-p1"],
    patches = [
        "@rules_dx//patches/ring:clang_cl_aarch64_windows.patch",
        "@rules_dx//patches/ring:msvc_fiat_include_path.patch",
    ],
    repositories = ["dx_crates"],
    version = "0.17.14",
)

# cc-rs archives objects under absolute paths; msvc_lib makes them relative.
crate.annotation_select(
    build_script_env = {
        "AR_aarch64_pc_windows_msvc": "$(execpath @@//rust/tools/msvc_paths:msvc_lib)",
        "AR_x86_64_pc_windows_msvc": "$(execpath @@//rust/tools/msvc_paths:msvc_lib)",
    },
    build_script_tools = ["@@//rust/tools/msvc_paths:msvc_lib"],
    crate = "blake3",
    repositories = ["dx_crates"],
    triples = ["aarch64-pc-windows-msvc"],
)
crate.annotation_select(
    build_script_env = {
        "AR_aarch64_pc_windows_msvc": "$(execpath @@//rust/tools/msvc_paths:msvc_lib)",
        "AR_x86_64_pc_windows_msvc": "$(execpath @@//rust/tools/msvc_paths:msvc_lib)",
    },
    build_script_tools = ["@@//rust/tools/msvc_paths:msvc_lib"],
    crate = "libz-sys",
    repositories = ["dx_crates"],
    triples = [
        "aarch64-pc-windows-msvc",
        "x86_64-pc-windows-msvc",
    ],
)
crate.annotation_select(
