load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//quality:fixtures.bzl", "real_source_target")
load(":inventory_tests.bzl", "v1_inventory_registry_tests")
load(":v1_inventory.bzl", "PROMISES", "V1_EVIDENCE")
load(":workflow_capability_tests.bzl", "workflow_capability_unit_tests")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

exports_files([
    "inventory_tests.bzl",
    "testdata/test_targets.txt",
    "workflow_capabilities.bzl",
    "workflow_capability_tests.bzl",
])

v1_inventory_registry_tests(name = "inventory_registry")

write_file(
    name = "v1_promises_json",
    out = "v1_promises.json",
    content = [json.encode_indent({
        "evidence": V1_EVIDENCE,
        "promises": PROMISES,
    })],
)

workflow_capability_unit_tests(name = "workflow_capability_unit")

test_suite(
    name = "all",
    tests = [
        ":inventory_registry",
        ":workflow_capability_unit",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "inventory_tests.bzl",
        "v1_inventory.bzl",
        "workflow_capabilities.bzl",
        "workflow_capability_tests.bzl",
    ],
    tags = ["corpus"],
)
