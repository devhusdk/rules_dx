load("@bazel_skylib//rules:common_settings.bzl", "int_setting", "string_flag")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//android/private/sdk:emulator.bzl", "declared_emulator")

package(default_visibility = ["//visibility:public"])

exports_files([
    "README.md",
    "defs.bzl",
    "extensions.bzl",
    "repositories.bzl",
    "lang.json",
    "pins.json",
])

alias(
    name = "llvm_readelf",
    actual = "@android_ndk_toolchain//:llvm_readelf",
)

int_setting(
    name = "api_level",
    build_setting_default = 0,
    visibility = ["//android:__subpackages__"],
)

string_flag(
    name = "emulator_serial",
    build_setting_default = "",
)

config_setting(
    name = "emulator_undeclared",
    flag_values = {":emulator_serial": ""},
)

declared_emulator(
    name = "declared_emulator",
    testonly = True,
)

platform(
    name = "android_device",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:arm64",
    ],
)

platform(
    name = "android_emulator",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "arm64-v8a",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:arm64",
    ],
)

platform(
    name = "x86_64",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "is_device",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "is_emulator",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:x86_64",
    ],
)

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
        "pins.json",
    ]) + [
        "//android/private/library:module_srcs",
        "//android/private/packaging:module_srcs",
        "//android/private/platforms:module_srcs",
        "//android/private/quality:module_srcs",
        "//android/private/sdk:module_srcs",
        "//android/private/toolchain:module_srcs",
    ],
    visibility = ["//:__subpackages__"],
)

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
    visibility = ["//:__subpackages__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "extensions.bzl",
        "repositories.bzl",
    ],
    tags = ["corpus"],
    visibility = ["//:__subpackages__"],
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//tools/api:__pkg__"],
)
