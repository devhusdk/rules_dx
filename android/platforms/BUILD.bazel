load("@bazel_skylib//rules:common_settings.bzl", "int_setting")
load("//core/quality:fixtures.bzl", "real_source_target")
load(":metadata_tests.bzl", "android_platform_tests")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
    "metadata_tests.bzl",
    "validate.bzl",
])

int_setting(
    name = "api_level",
    build_setting_default = 0,
    visibility = ["//android:__subpackages__"],
)

platform(
    name = "android_device",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:arm64",
    ],
)

platform(
    name = "android_emulator",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "arm64-v8a",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:arm64",
    ],
)

platform(
    name = "x86_64",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "is_device",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "is_emulator",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:x86_64",
    ],
)

android_platform_tests(name = "metadata")

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "metadata_tests.bzl",
        "validate.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
    ]),
    visibility = ["//:__subpackages__"],
)
