load("//core:failure_test.bzl", "failure_test")
load("//quality:fixtures.bzl", "real_source_target")
load("@rules_java//java:java_binary.bzl", "java_binary")
load("@rules_java//java:java_import.bzl", "java_import")
load(":defs.bzl", "android_adb_install", "android_adb_log", "android_adb_start", "android_apk_set", "android_check", "android_sign", "rust_android_apk")
load(":metadata_tests.bzl", "android_packaging_tests")
load(":rotation_tests.bzl", "keystore_properties_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "adb_ops.sh",
    "build_apk_set.sh",
    "check_package.sh",
    "defs.bzl",
    "metadata_tests.bzl",
    "repos.bzl",
    "rotation_tests.bzl",
    "sign_aab.sh",
    "sign_apk.sh",
    "validate.bzl",
])

android_packaging_tests(name = "metadata")

genrule(
    name = "rotated_second_key",
    srcs = ["@rules_android//tools/android:debug_keystore"],
    outs = ["rotated_second.keystore"],
    cmd = "cp $< $@",
)

rust_android_apk(
    name = "rotated",
    app_id = "com.example.rotated",
    debug_signing_keys = [
        "@rules_android//tools/android:debug_keystore",
        ":rotated_second_key",
    ],
    debug_signing_lineage_file = "lineage.bin",
    tags = ["manual"],
    deps = [],
)

keystore_properties_test(
    name = "rotated_bundle_test",
    oldest_key_short_path = "../rules_android+/tools/android/debug_keystore",
    tags = ["manual"],
    target_under_test = ":rotated_bundle",
)

java_import(
    name = "bundletool_jar",
    jars = ["@dx_android_sdk//:bundletool_jar"],
    visibility = ["//android:__subpackages__"],
)

java_binary(
    name = "bundletool",
    main_class = "com.android.tools.build.bundletool.BundleToolMain",
    runtime_deps = [":bundletool_jar"],
)

rust_android_apk(
    name = "bad_app_id",
    app_id = "app",
    deps = [],
)

failure_test(
    name = "bad_app_id_test",
    expected_failure_substring = "needs at least two dot-separated parts",
    target = ":bad_app_id_manifest",
)

rust_android_apk(
    name = "bad_abi",
    app_id = "com.example.app",
    platforms = ["//android/platforms:mips"],
    deps = [],
)

failure_test(
    name = "bad_abi_test",
    expected_failure_substring = "//android/platforms:mips' is unknown",
    target = ":bad_abi",
)

failure_test(
    name = "bad_abi_aab_file_test",
    expected_failure_substring = "//android/platforms:mips' is unknown",
    target = ":bad_abi_aab_file",
)

rust_android_apk(
    name = "bad_api",
    api_level = 29,
    app_id = "com.example.app",
    deps = [],
)

failure_test(
    name = "bad_api_test",
    expected_failure_substring = "api_level 29 is below 31",
    target = ":bad_api_manifest",
)

rust_android_apk(
    name = "bad_version",
    app_id = "com.example.app",
    version_code = 0,
    deps = [],
)

failure_test(
    name = "bad_version_test",
    expected_failure_substring = "version_code 0 must be positive",
    target = ":bad_version",
)

rust_android_apk(
    name = "bad_abis",
    app_id = "com.example.app",
    platforms = [],
    deps = [],
)

rust_android_apk(
    name = "bad_dup_abis",
    app_id = "com.example.app",
    platforms = [
        "//android/platforms:x86_64",
        "//android/platforms:x86_64",
    ],
    deps = [],
)

failure_test(
    name = "bad_dup_abis_test",
    expected_failure_substring = "platforms holds duplicates",
    target = ":bad_dup_abis",
)

failure_test(
    name = "bad_abis_test",
    expected_failure_substring = "platforms must name at least one ABI",
    target = ":bad_abis",
)

rust_android_apk(
    name = "bad_activity",
    activity = "",
    app_id = "com.example.app",
    deps = [],
)

failure_test(
    name = "bad_activity_test",
    expected_failure_substring = "activity must not be empty",
    target = ":bad_activity_manifest",
)

android_adb_install(
    name = "no_serial_install",
    apk = ":bad_app_id",
    serial = "",
)

failure_test(
    name = "no_serial_install_test",
    expected_failure_substring = "serial names the target device",
    target = ":no_serial_install_selection",
)

android_adb_start(
    name = "bad_start_app",
    app_id = "app",
    serial = "emulator-5554",
)

failure_test(
    name = "bad_start_app_test",
    expected_failure_substring = "needs at least two dot-separated parts",
    target = ":bad_start_app_selection",
)

android_adb_start(
    name = "no_serial_start",
    app_id = "com.example.app",
    serial = "",
)

failure_test(
    name = "no_serial_start_test",
    expected_failure_substring = "serial names the target device",
    target = ":no_serial_start_selection",
)

android_adb_log(
    name = "no_serial_log",
    serial = "",
)

failure_test(
    name = "no_serial_log_test",
    expected_failure_substring = "serial names the target device",
    target = ":no_serial_log_selection",
)

android_sign(
    name = "bad_scheme_sign",
    package = "//android/tests/fixtures/rust_apk:dummy.apk",
    schemes = ["v9"],
)

failure_test(
    name = "bad_scheme_sign_test",
    expected_failure_substring = "scheme 'v9' is unknown",
    target = ":bad_scheme_sign_selection",
)

android_sign(
    name = "low_sdk_sign",
    min_sdk = 21,
    package = "//android/tests/fixtures/rust_apk:dummy.apk",
)

failure_test(
    name = "low_sdk_sign_test",
    expected_failure_substring = "min_sdk 21 is below 31",
    target = ":low_sdk_sign_selection",
)

android_sign(
    name = "v4_only_sign",
    package = "//android/tests/fixtures/rust_apk:dummy.apk",
    schemes = ["v4"],
)

failure_test(
    name = "v4_only_sign_test",
    expected_failure_substring = "v4 needs v2 or v3",
    target = ":v4_only_sign_selection",
)

android_check(
    name = "bad_abi_aab_check",
    package = "//android/tests/fixtures/rust_apk:dummy.apk",
    platforms = ["//android/platforms:mips"],
    tags = ["manual"],
)

failure_test(
    name = "bad_abi_aab_check_test",
    expected_failure_substring = "//android/platforms:mips' is unknown",
    target = ":bad_abi_aab_check_selection",
)

android_check(
    name = "bad_resource_aab_check",
    package = "//android/tests/fixtures/rust_apk:dummy.apk",
    resources = ["app_name"],
    tags = ["manual"],
)

failure_test(
    name = "bad_resource_aab_check_test",
    expected_failure_substring = "resource 'app_name' must be type/name",
    target = ":bad_resource_aab_check_selection",
)

android_sign(
    name = "json_sign",
    package = "//android/tests/fixtures/rust_apk:device_x86_64.json",
)

failure_test(
    name = "json_sign_test",
    expected_failure_substring = "built 0 .apk/.aab files, want exactly one",
    target = ":json_sign_selection",
)

android_sign(
    name = "aab_scheme_sign",
    package = "//android/tests/fixtures/rust_apk:test_bundle.aab",
    schemes = ["v2"],
)

failure_test(
    name = "aab_scheme_sign_test",
    expected_failure_substring = "schemes and min_sdk apply to APKs only",
    target = ":aab_scheme_sign_selection",
)

android_adb_install(
    name = "install_both",
    apk = "//android/tests/fixtures/rust_apk:dummy.apk",
    apk_set = "//android/tests/fixtures/rust_apk:device_x86_64.json",
    serial = "emulator-5554",
)

failure_test(
    name = "install_both_test",
    expected_failure_substring = "install takes exactly one of apk or apk_set",
    target = ":install_both_selection",
)

android_adb_install(
    name = "install_none",
    serial = "emulator-5554",
)

failure_test(
    name = "install_none_test",
    expected_failure_substring = "install takes exactly one of apk or apk_set",
    target = ":install_none_selection",
)

android_adb_install(
    name = "install_not_set",
    apk_set = "//android/tests/fixtures/rust_apk:dummy.apk",
    serial = "emulator-5554",
)

failure_test(
    name = "install_not_set_test",
    expected_failure_substring = "is not an android_apk_set",
    target = ":install_not_set_apk_set",
)

android_apk_set(
    name = "apk_set_bad_spec",
    aab = "//android/tests/fixtures/rust_apk:dummy.apk",
    device_spec = "//android/tests/fixtures/rust_apk:dummy.apk",
    tags = ["manual"],
)

failure_test(
    name = "apk_set_bad_spec_test",
    expected_failure_substring = "device_spec names 0 json files, want exactly one",
    target = ":apk_set_bad_spec",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "metadata_tests.bzl",
        "repos.bzl",
        "rotation_tests.bzl",
        "validate.bzl",
    ],
    tags = ["corpus"],
)

android_check(
    name = "apk_platforms_check",
    package = "//android/tests/fixtures/rust_apk:dummy.apk",
    resources = ["string/app_name"],
    tags = ["manual"],
)

failure_test(
    name = "apk_platforms_check_test",
    expected_failure_substring = "apply to App Bundles only",
    target = ":apk_platforms_check_selection",
)

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
    ]),
    visibility = ["//:__subpackages__"],
)
