load("@rules_java//java:java_binary.bzl", "java_binary")
load("@rules_java//java:java_import.bzl", "java_import")
load("//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

exports_files([
    "defs.bzl",
    "repos.bzl",
    "validate.bzl",
])

java_import(
    name = "bundletool_jar",
    jars = ["@dx_android_sdk//:bundletool_jar"],
    visibility = ["//android:__subpackages__"],
)

java_binary(
    name = "bundletool",
    main_class = "com.android.tools.build.bundletool.BundleToolMain",
    runtime_deps = [":bundletool_jar"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "repos.bzl",
        "validate.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["*.bzl"]) + [
        "BUILD.bazel",
        "//android/private/packaging/ops:module_srcs",
    ],
    visibility = ["//:__subpackages__"],
)
