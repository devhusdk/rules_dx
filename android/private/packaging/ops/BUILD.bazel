load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library")

package(default_visibility = ["//android:__subpackages__"])

# keep
rust_library(
    name = "ops",
    srcs = [
        "src/adb.rs",
        "src/apk_set.rs",
        "src/check.rs",
        "src/lib.rs",
        "src/sign.rs",
        "src/util.rs",
    ],
    crate_name = "dx_android_ops",
    crate_root = "src/lib.rs",
    visibility = [
        "//android:__subpackages__",
        "//cli/cli:__pkg__",
        "//cli/runtime:__pkg__",
    ],
    deps = [
        "//cli/archive:dx_archive",
        "//cli/atomic_fs:dx_atomic_fs",
        "@crates//:tempfile",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)

exports_files(
    [
        "src/lib.rs",
        "src/sign.rs",
    ],
    visibility = ["//:__subpackages__"],
)
