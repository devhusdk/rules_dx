load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")
load("//tools/testing:nested_bazel.bzl", "NESTED_BAZEL_DATA", "NESTED_BAZEL_ENV", "NESTED_BAZEL_TAGS")

# keep
rust_test(
    name = "fetch_test",
    size = "enormous",
    srcs = ["fetch_test.rs"],
    data = [
        "fixtures/android-ndk-r27-linux.zip",
        "//:module_srcs",
    ] + NESTED_BAZEL_DATA,
    env = {"RUST_TEST_THREADS": "1"} | NESTED_BAZEL_ENV,
    env_inherit = [
        "HOME",
        "PATH",
    ],
    tags = NESTED_BAZEL_TAGS,
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [
        "//tools/testing:dx_nested",
        "//tools/testing:dx_testing",
    ],
)

rustfmt_test(
    name = "fetch_fmt_test",
    size = "small",
    targets = [":fetch_test"],
)

rust_clippy_test(
    name = "fetch_clippy_test",
    size = "small",
    targets = [":fetch_test"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "repos.bzl",
    ],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)
