    name = "conformance",
    srcs = ["Clean.java"],
    custom_package = "com.example.dxconformance",
)

android_java_library(
    name = "lint_dirty",
    srcs = ["LintDirty.java"],
    custom_package = "com.example.dxconformance",
    tags = ["manual"],
)

android_java_library(
    name = "format_dirty",
    srcs = ["FormatDirty.java"],
    custom_package = "com.example.dxconformance",
    tags = ["manual"],
)

dx_conformance_suite(
    name = "",
    size = "small",
    binary = ":conformance",
    covered_source = "",
    expected = "",
    failing_case = "",
    failing_test = ":conformance",
    lang = "android",
    not_applicable = {
        "build_test": "an APK runs on a device, not on the host",
        "coverage_test": "android has no host test rule",
        "cross_test": "android_rust_apk builds every ABI it lists, whatever the host",
        "fail_test": "android has no host test rule",
        "lock_test": "android has no lockfile",
        "pass_test": "android has no host test rule",
        "runfiles_test": "an APK runs on a device, not on the host",
    },
    passing_test = ":conformance",
    quality = {
        "clean": ":conformance",
        "format_dirty": ":format_dirty",
