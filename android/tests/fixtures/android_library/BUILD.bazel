# gazelle:ignore
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//android:defs.bzl", "android_java_library", "android_kotlin_library")
load(":android_library_tests.bzl", "android_library_providers_test")

android_java_library(
    name = "java_screen",
    testonly = True,
    srcs = ["java/Screen.java"],
    custom_package = "com.example.dxjava",
    visibility = ["//visibility:private"],
)

android_kotlin_library(
    name = "kotlin_screen",
    testonly = True,
    srcs = ["kotlin/Screen.kt"],
    custom_package = "com.example.dxkotlin",
    visibility = ["//visibility:private"],
)

build_test(
    name = "android_libraries_build",
    size = "small",
    testonly = True,
    targets = [
        ":java_screen",
        ":kotlin_screen",
    ],
)

android_library_providers_test(
    name = "java_screen_providers_test",
    kotlin = False,
    library = "java_screen",
)

android_library_providers_test(
    name = "kotlin_screen_providers_test",
    kotlin = True,
    library = "kotlin_screen",
)
