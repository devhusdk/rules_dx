# gazelle:ignore

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//android/packaging:defs.bzl", "android_adb_install", "android_adb_log", "android_adb_start", "android_apk_check", "android_apk_release_sign", "rust_android_apk")
load("//android/sdk:repos.bzl", "BUILD_TOOLS")
load("//cc/rules:defs.bzl", "cc_library")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_static_library", "rust_test", "rustfmt_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

rust_static_library(
    name = "app_rust",
    srcs = ["src/lib.rs"],
    crate_name = "rust_apk",
)

rust_test(
    name = "app_rust_test",
    crate = ":app_rust",
)

rustfmt_test(
    name = "app_rust_fmt_test",
    size = "small",
    targets = [":app_rust"],
)

cc_library(
    name = "app_jni",
    srcs = ["activity.c"],
    linkopts = [
        "-landroid",
        "-llog",
    ],
    tags = ["manual"],
    deps = [":app_rust"],
    alwayslink = True,
)

rust_android_apk(
    name = "app_apk",
    app_id = "com.example.dxrustapk",
    assets = glob(["assets/**"]),
    assets_dir = "assets",
    permissions = ["android.permission.INTERNET"],
    resource_files = glob(["res/**"]),
    visibility = ["//visibility:public"],
    deps = [":app_jni"],
)

android_adb_install(
    name = "install",
    apk = ":app_apk_file",
    serial = "emulator-5554",
)

android_adb_install(
    name = "install_probe",
    apk = ":dummy.apk",
    serial = "emulator-5554",
)

android_adb_start(
    name = "start",
    app_id = "com.example.dxrustapk",
    serial = "emulator-5554",
)

android_adb_log(
    name = "log",
    serial = "emulator-5554",
)

rust_android_apk(
    name = "custom_apk",
    abis = ["x86_64"],
    api_level = 33,
    app_id = "org.example.custom.dxrustapk",
    assets = glob(["assets/**"]),
    assets_dir = "assets",
    permissions = [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE",
    ],
    resource_files = glob(["res/**"]),
    version_code = 7,
    version_name = "2.3",
    visibility = ["//visibility:public"],
    deps = [":app_jni"],
)

android_apk_release_sign(
    name = "sign",
    apk = ":unsigned.apk",
)

android_apk_release_sign(
    name = "sign_app",
    apk = ":app_apk_unsigned_file",
)

android_apk_check(
    name = "check_unsigned_test",
    apk = ":unsigned.apk",
)

android_apk_check(
    name = "check_app_unsigned_test",
    apk = ":app_apk_unsigned_file",
    tags = ["manual"],
)

sh_test(
    name = "check_rejects_test",
    srcs = ["check_rejects.sh"],
    args = [
        "$(rootpath //android/packaging:check_apk.sh)",
        "$(rootpath :unsigned.apk)",
        "$(rootpath :dummy.apk)",
        "$(rootpath :signed_fixture.apk)",
        "$(rootpath :v2_only_fixture.apk)",
    ],
    data = [
        ":dummy.apk",
        ":signed_fixture.apk",
        ":unsigned.apk",
        ":v2_only_fixture.apk",
        "//android/packaging:check_apk.sh",
    ],
)

sh_test(
    name = "sign_test",
    srcs = ["sign_test.sh"],
    args = [
        "$(rootpath :sign)",
        "$(rootpath :unsigned.apk)",
        "$(rootpath :dummy.apk)",
        BUILD_TOOLS,
    ],
    data = [
        ":dummy.apk",
        ":sign",
        ":unsigned.apk",
    ],
    tags = ["manual"],
)

sh_test(
    name = "sign_app_test",
    srcs = ["sign_test.sh"],
    args = [
        "$(rootpath :sign_app)",
        "$(rootpath :app_apk_unsigned_file)",
        "$(rootpath :dummy.apk)",
        BUILD_TOOLS,
    ],
    data = [
        ":app_apk_unsigned_file",
        ":dummy.apk",
        ":sign_app",
    ],
    tags = ["manual"],
)

sh_test(
    name = "inspect_apk_test",
    srcs = ["inspect_apk.sh"],
    args = [
        "$(location :app_apk_file)",
        "com.example.dxrustapk",
        "app_apk",
        "arm64-v8a,x86_64",
        "$(location @android_ndk_toolchain//:llvm_readelf)",
        "31",
        "android.permission.INTERNET",
        "1",
        "1.0",
    ],
    data = [
        ":app_apk_file",
        "@android_ndk_toolchain//:llvm_readelf",
    ],
    tags = ["manual"],
)

sh_test(
    name = "inspect_custom_apk_test",
    srcs = ["inspect_apk.sh"],
    args = [
        "$(location :custom_apk_file)",
        "org.example.custom.dxrustapk",
        "custom_apk",
        "x86_64",
        "$(location @android_ndk_toolchain//:llvm_readelf)",
        "33",
        "android.permission.VIBRATE",
        "7",
        "2.3",
        "android.permission.ACCESS_NETWORK_STATE",
    ],
    data = [
        ":custom_apk_file",
        "@android_ndk_toolchain//:llvm_readelf",
    ],
    tags = ["manual"],
)

sh_test(
    name = "install_test",
    srcs = ["adapter_test.sh"],
    args = [
        "install",
        "$(location :install_probe)",
        "$(location :fake_adb.sh)",
        "$(location :dummy.apk)",
    ],
    data = [
        ":dummy.apk",
        ":fake_adb.sh",
        ":install_probe",
    ],
)

sh_test(
    name = "install_exit_test",
    srcs = ["adapter_test.sh"],
    args = [
        "install",
        "$(location :install_probe)",
        "$(location :fake_adb.sh)",
        "$(location :dummy.apk)",
    ],
    data = [
        ":dummy.apk",
        ":fake_adb.sh",
        ":install_probe",
    ],
    env = {"ADB_EXIT": "3"},
)

sh_test(
    name = "install_missing_test",
    srcs = ["adapter_test.sh"],
    args = [
        "missing",
        "$(location :install_probe)",
        "$(location :fake_adb.sh)",
        "$(location :dummy.apk)",
    ],
    data = [
        ":dummy.apk",
        ":fake_adb.sh",
        ":install_probe",
    ],
)

sh_test(
    name = "start_test",
    srcs = ["adapter_test.sh"],
    args = [
        "start",
        "$(location :start)",
        "$(location :fake_adb.sh)",
    ],
    data = [
        ":fake_adb.sh",
        ":start",
    ],
)

sh_test(
    name = "start_exit_test",
    srcs = ["adapter_test.sh"],
    args = [
        "start",
        "$(location :start)",
        "$(location :fake_adb.sh)",
    ],
    data = [
        ":fake_adb.sh",
        ":start",
    ],
    env = {"ADB_EXIT": "5"},
)

sh_test(
    name = "log_test",
    srcs = ["adapter_test.sh"],
    args = [
        "log",
        "$(location :log)",
        "$(location :fake_adb.sh)",
    ],
    data = [
        ":fake_adb.sh",
        ":log",
    ],
)

sh_test(
    name = "log_exit_test",
    srcs = ["adapter_test.sh"],
    args = [
        "log",
        "$(location :log)",
        "$(location :fake_adb.sh)",
    ],
    data = [
        ":fake_adb.sh",
        ":log",
    ],
    env = {"ADB_EXIT": "7"},
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
