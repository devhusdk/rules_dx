load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rustfmt_test")
load("//tools/testing/hermetic:defs.bzl", "nested_bazel_test")

nested_bazel_test(
    name = "starter_test",
    size = "enormous",
    srcs = ["starter_test.rs"],
    data = [
        "//:module_srcs",
        "//cli/cli:dx",
    ],
    env = {"DX_BIN": "$(rootpath //cli/cli:dx)"},
    env_inherit = [
        "ANDROID_HOME",
        "ANDROID_NDK_REVISION",
        "ANDROID_SDK_ROOT",
        "HOME",
        "PATH",
    ],
    # The nested consumer fetches its rules_rust toolchains.
    network = True,
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [
        "//tools/testing:dx_nested",
        "//tools/testing:dx_testing",
    ],
)

rustfmt_test(
    name = "starter_fmt_test",
    size = "small",
    targets = [":starter_test"],
)

rust_clippy_test(
    name = "starter_clippy_test",
    size = "small",
    targets = [":starter_test"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//tools/docs/support_matrix:__pkg__"],
)
