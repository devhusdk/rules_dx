{
  "$schema": "../core/modules/lang.schema.json",
  "name": "ansible",
  "title": "Ansible",
  "family": "core",
  "ecosystems": [
    "ansible"
  ],
  "manifests": [
    "MODULE.bazel"
  ],
  "lockfiles": [],
  "setup": {
    "hubs": [
      {
        "ecosystem": "ansible",
        "manifest": "MODULE.bazel",
        "lock": null,
        "state": null,
        "extension": "@rules_dx//ansible:extensions.bzl",
        "tag": null,
        "hub": "ansible_collections",
        "resolver": null,
        "imports": "name"
      }
    ]
  },
  "tools": [
    "ansible_lint",
    "yamlfmt"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64"
  ],
  "pins": [],
  "entry_points": [
    "ansible_library",
    "ansible_lock"
  ],
  "quality": {
    "bzl": "ansible/private/quality:ansible.bzl",
    "every_workspace": true,
    "file_extensions": [
      ".yaml",
      ".yml"
    ],
    "aspects": {
      "lint": [
        "real_ansible_lint_aspect"
      ]
    }
  }
}
