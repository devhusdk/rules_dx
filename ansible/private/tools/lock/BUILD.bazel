load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//cli/launcher:defs.bzl", "dx_subcommand")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS_PUBLIC)

rust_library(
    name = "ansible_lock_lib",
    srcs = ["src/resolve.rs"],
    aliases = aliases(
        package_name = "ansible/private/tools/ansible_lock",
        normal = True,
    ),
    crate_name = "ansible_lock",
    crate_root = "src/resolve.rs",
    visibility = ["//cli/cli:__pkg__"],
    deps = all_crate_deps(
        package_name = "ansible/private/tools/ansible_lock",
        normal = True,
    ) + [
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
    ],
)

dx_subcommand(
    name = "lock",
    subcommand = "ansible_lock",
    visibility = VIS_TOOLS_PUBLIC,
)

rust_test(
    name = "resolve_test",
    size = "small",
    srcs = ["resolve_test.rs"],
    aliases = aliases(
        package_name = "ansible/private/tools/ansible_lock",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "resolve_test",
    crate_root = "resolve_test.rs",
    data = [
        "testdata/golden.lock.json",
        "testdata/other.tar.gz",
        "testdata/tiny.tar.gz",
    ],
    env = {
        "GOLDEN": "$(rootpath testdata/golden.lock.json)",
        "OTHER": "$(rootpath testdata/other.tar.gz)",
        "TINY": "$(rootpath testdata/tiny.tar.gz)",
    },
    tags = ["block-network"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = all_crate_deps(
        package_name = "ansible/private/tools/ansible_lock",
        normal = True,
        normal_dev = True,
    ) + [
        ":ansible_lock_lib",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
        "//cli/lock:dx_lock_testing",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = VIS_TOOLS_PUBLIC,
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
