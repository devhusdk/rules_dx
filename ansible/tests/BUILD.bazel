load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//ansible/rules:defs.bzl", "ansible_library")
load("//libs/starlark:failure_test.bzl", "failure_test")
load("//quality:fixtures.bzl", "real_source_target")
load(":library_tests.bzl", "mixed_split_test", "plain_yaml_test")
load(":lock_tests.bzl", "lock_unit_tests")

ansible_library(
    name = "mixed",
    srcs = [
        "fixtures/plain/data.yml",
        "fixtures/roles/web/tasks/main.yml",
    ],
)

mixed_split_test(
    name = "mixed_split_test",
    size = "small",
    target_under_test = ":mixed",
)

ansible_library(
    name = "plain",
    srcs = ["fixtures/plain/data.yml"],
)

plain_yaml_test(
    name = "plain_yaml_test",
    size = "small",
    target_under_test = ":plain",
)

ansible_library(
    name = "bad_playbook",
    srcs = ["fixtures/plain/data.yml"],
    playbooks = ["fixtures/site.yml"],
    tags = ["manual"],
)

failure_test(
    name = "bad_playbook_fails",
    expected_failure_substring = "playbooks entry ansible/tests/fixtures/site.yml is not in srcs",
    target = ":bad_playbook",
)

lock_unit_tests(name = "lock_unit")

sh_test(
    name = "collections_hub_test",
    size = "small",
    srcs = ["collections_hub_test.sh"],
    data = ["@dx_ansible_test_collections//:collections"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "library_tests.bzl",
        "lock_tests.bzl",
    ],
    tags = ["corpus"],
)
