# The checked-in public API snapshot. `bazel run //tools/api:update` writes it.
filegroup(
    name = "snapshot",
    srcs = [
        "cli.json",
        "schemas.txt",
    ],
    visibility = ["//tools/api:__pkg__"],
)

# Written by hand when a name is deprecated; //tools/ci:zero_compat_test checks it against the code.
exports_files(
    ["deprecations.txt"],
    visibility = ["//tools/ci:__pkg__"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
