load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")

# The checked-in public API snapshot. `bazel run //tools/api:update` writes it.
filegroup(
    name = "snapshot",
    srcs = [
        "cli.json",
        "labels.txt",
        "schemas.txt",
    ],
    visibility = ["//tools/api:__pkg__"],
)

# Written by hand, one line per name marked for removal; //tools/ci:zero_compat_test checks it against the code.
exports_files(
    ["deprecations.txt"],
    visibility = ["//tools/ci:__pkg__"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
