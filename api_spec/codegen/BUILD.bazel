load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_test", "rustfmt_test")

package(default_visibility = ["//api_spec/rules:__pkg__"])

# keep
rust_binary(
    name = "preflight",
    srcs = ["preflight_main.rs"],
    crate_name = "openapi_codegen_preflight",
    crate_root = "preflight_main.rs",
    deps = ["//quality/adapter:quality_adapter"],
)

# keep
rust_test(
    name = "preflight_test",
    srcs = ["preflight_main.rs"],
    crate_name = "openapi_codegen_preflight",
    crate_root = "preflight_main.rs",
    deps = ["//quality/adapter:quality_adapter"],
)

rustfmt_test(
    name = "preflight_fmt_test",
    targets = [
        ":preflight",
        ":preflight_test",
    ],
)

rust_clippy_test(
    name = "preflight_clippy_test",
    targets = [":preflight"],
)

exports_files([
    "openapi_python_client.yaml",
    "redocly.yaml",
])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
