# gazelle:ignore
load("@crates//:crates.bzl", "aliases")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//api_spec/private:__pkg__"])

rust_library(
    name = "codegen",
    srcs = [
        "lib.rs",
        "oapi_codegen.rs",
        "preflight.rs",
    ],
    aliases = aliases(
        package_name = "api_spec/private/openapi_codegen_preflight",
        normal = True,
    ),
    crate_name = "api_spec_codegen",
    crate_root = "lib.rs",
    visibility = ["//cli/cli:__pkg__"],
    deps = ["//core/quality/adapter:quality_adapter"],
)

[rust_binary(
    name = name,
    srcs = ["bin_{}.rs".format(name)],
    crate_name = name,
    crate_root = "bin_{}.rs".format(name),
    visibility = ["//visibility:public"],
    deps = [":codegen"],
) for name in [
    "api_spec_preflight",
    "oapi_codegen",
]]

rust_test(
    name = "codegen_test",
    size = "small",
    aliases = aliases(
        package_name = "api_spec/private/openapi_codegen_preflight",
        normal = True,
        normal_dev = True,
    ),
    crate = ":codegen",
)

exports_files([
    "openapi_python_client.yaml",
    "redocly.yaml",
])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
