load("@crates//:crates.bzl", "aliases")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_test")

package(default_visibility = ["//api_spec/private:__pkg__"])

rust_binary(
    name = "preflight",
    srcs = ["preflight_main.rs"],
    aliases = aliases(
        package_name = "api_spec/private/openapi_codegen_preflight",
        normal = True,
    ),
    crate_name = "preflight",
    crate_root = "preflight_main.rs",
    deps = ["//core/quality/adapter:quality_adapter"],
)

exports_files([
    "openapi_python_client.yaml",
    "redocly.yaml",
])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

rust_test(
    name = "preflight_test",
    aliases = aliases(
        package_name = "api_spec/private/openapi_codegen_preflight",
        normal = True,
        normal_dev = True,
    ),
    crate = ":preflight",
    deps = [],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
