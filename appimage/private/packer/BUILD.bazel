# gazelle:ignore
load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//appimage:__subpackages__"])

_LINUX = ["@platforms//os:linux"]

rust_library(
    name = "appimage_packer_lib",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "appimage/private/appimage_packer",
        normal = True,
    ),
    crate_name = "appimage_packer",
    crate_root = "src/lib.rs",
    target_compatible_with = _LINUX,
    deps = all_crate_deps(
        package_name = "appimage/private/appimage_packer",
        normal = True,
    ),
)

rust_binary(
    name = "appimage_packer",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "appimage/private/appimage_packer",
        normal = True,
    ),
    crate_name = "appimage_packer",
    crate_root = "src/main.rs",
    target_compatible_with = _LINUX,
    deps = all_crate_deps(
        package_name = "appimage/private/appimage_packer",
        normal = True,
    ) + [":appimage_packer_lib"],
)

rust_test(
    name = "appimage_packer_test",
    aliases = aliases(
        package_name = "appimage/private/appimage_packer",
        normal = True,
        normal_dev = True,
    ),
    crate = ":appimage_packer_lib",
    env = {"RUST_TEST_THREADS": "1"},
    target_compatible_with = _LINUX,
    deps = all_crate_deps(
        package_name = "appimage/private/appimage_packer",
        normal = True,
        normal_dev = True,
    ),
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    [
        "src/lib.rs",
        "src/main.rs",
    ],
    visibility = ["//core/quality:__pkg__"],
)
