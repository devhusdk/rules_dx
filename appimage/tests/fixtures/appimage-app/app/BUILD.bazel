# gazelle:resolve cc greet.h //appimage/tests/fixtures/appimage-app/greet:greet
load("@rules_dx//appimage:defs.bzl", "appimage_package")
load("@rules_dx//cc:defs.bzl", "cc_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//core/quality:fixtures.bzl", "real_source_target")

_PUBLIC = ["//visibility:public"]

package(default_visibility = _PUBLIC)

exports_files([
    "BUILD.bazel",
    "NOTICE.txt",
    "dxappimage.desktop",
    "dxappimage.png",
    "greeting.txt",
    "main.c",
    "run_test.sh",
])

cc_binary(
    name = "dxappimage",
    srcs = ["main.c"],
    dynamic_deps = ["//appimage/tests/fixtures/appimage-app/greet:greet_shared"],
    linkopts = ["-Wl,-rpath,$ORIGIN/../lib"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["//appimage/tests/fixtures/appimage-app/greet"],
)

appimage_package(
    name = "app",
    app_name = "dxappimage",
    binary = ":dxappimage",
    data = ["greeting.txt"],
    desktop = "dxappimage.desktop",
    icon = "dxappimage.png",
    libs = ["//appimage/tests/fixtures/appimage-app/greet:greet_shared"],
    notice = ["NOTICE.txt"],
    version = "1.2.3",
)

config_setting(
    name = "consumer_probe",
    values = {"copt": "-DDX_CONSUMER_PROBE"},
)

sh_test(
    name = "run_test",
    size = "small",
    srcs = ["run_test.sh"],
    args = ["$(rootpaths :app)"] + select({
        ":consumer_probe": ["on"],
        "//conditions:default": ["off"],
    }),
    data = [":app"],
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
