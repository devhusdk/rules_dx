exports_files([
    "README.md",
    "defs.bzl",
])

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
    ]) + [
        "//apple/private/bundle:module_srcs",
        "//apple/private/ios:module_srcs",
        "//apple/private/macos:module_srcs",
        "//apple/private/provisioning:module_srcs",
        "//apple/private/signing:module_srcs",
    ],
    visibility = ["//:__subpackages__"],
)

platform(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "macos_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:macos",
    ],
    visibility = ["//visibility:public"],
)
