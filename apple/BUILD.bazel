load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//apple/private/ios:simulator.bzl", "declared_simulator")

exports_files([
    "README.md",
    "defs.bzl",
    "lang.json",
    "pins.json",
])

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
        "pins.json",
    ]) + [
        "//apple/private/bundle:module_srcs",
        "//apple/private/ios:module_srcs",
        "//apple/private/macos:module_srcs",
        "//apple/private/provisioning:module_srcs",
        "//apple/private/signing:module_srcs",
        "//apple/private/xcode:module_srcs",
    ],
    visibility = ["//:__subpackages__"],
)

string_flag(
    name = "simulator_runtime",
    build_setting_default = "",
    visibility = ["//visibility:public"],
)

config_setting(
    name = "simulator_undeclared",
    flag_values = {":simulator_runtime": ""},
    visibility = ["//visibility:public"],
)

declared_simulator(
    name = "declared_simulator",
    testonly = True,
    visibility = ["//visibility:public"],
)

platform(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "macos_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:macos",
    ],
    visibility = ["//visibility:public"],
)

alias(
    name = "ios_arm64",
    actual = "@apple_support//platforms:ios_arm64",
    visibility = ["//visibility:public"],
)

alias(
    name = "ios_sim_arm64",
    actual = "@apple_support//platforms:ios_sim_arm64",
    visibility = ["//visibility:public"],
)

alias(
    name = "ios_x86_64",
    actual = "@apple_support//platforms:ios_x86_64",
    visibility = ["//visibility:public"],
)

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
    ],
    tags = ["corpus"],
)
