load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")

exports_files([
    "README.md",
    "defs.bzl",
    "lang.json",
    "pins.json",
])

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
    ]) + [
        "//apple/private/bundle:module_srcs",
        "//apple/private/ios:module_srcs",
        "//apple/private/macos:module_srcs",
        "//apple/private/provisioning:module_srcs",
        "//apple/private/signing:module_srcs",
    ],
    visibility = ["//:__subpackages__"],
)

platform(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "macos_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:macos",
    ],
    visibility = ["//visibility:public"],
)

alias(
    name = "ios_arm64",
    actual = "@apple_support//platforms:ios_arm64",
    visibility = ["//visibility:public"],
)

alias(
    name = "ios_sim_arm64",
    actual = "@apple_support//platforms:ios_sim_arm64",
    visibility = ["//visibility:public"],
)

alias(
    name = "ios_x86_64",
    actual = "@apple_support//platforms:ios_x86_64",
    visibility = ["//visibility:public"],
)

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
    ],
    tags = ["corpus"],
)
