load("@apple_support//xcode:xcode_config.bzl", "xcode_config")
load("@apple_support//xcode:xcode_version.bzl", "xcode_version")
load("//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
    "validate.bzl",
])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "validate.bzl",
    ],
    tags = ["corpus"],
)

xcode_version(
    name = "xcode_16_4",
    aliases = [
        "16",
        "16.4",
    ],
    default_ios_sdk_version = "18.5",
    default_macos_sdk_version = "15.5",
    version = "16.4.0.16F6",
)

xcode_config(
    name = "managed_xcodes",
    default = ":xcode_16_4",
    versions = [":xcode_16_4"],
)

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
    ]),
    visibility = ["//:__subpackages__"],
)
