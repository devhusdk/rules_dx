failure_test(
    name = "auto_download_test",
    expected_failure_substring = "no unattended download",
    target = ":auto_download_selection",
)

apple_provisioning(
    name = "missing_license",
    host = "macos_arm64",
    route = "local",
    sdk = "iphoneos",
    xcode_version = "16.2",
)

failure_test(
    name = "missing_license_test",
    expected_failure_substring = "accept apple-xcode-license",
    target = ":missing_license_selection",
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "metadata_tests.bzl",
    ],
    tags = ["corpus"],
)
