    target = ":managed_no_endpoint_selection",
)

apple_provisioning(
    name = "managed_no_credential",
    accept_licenses = ["apple-xcode-license"],
    endpoint = "https://mac.example.com",
    host = "macos_arm64",
    route = "managed",
    sdk = "iphoneos",
)

failure_test(
    name = "managed_no_credential_test",
    expected_failure_substring = "needs credential_file",
    target = ":managed_no_credential_selection",
)

apple_provisioning(
    name = "inline_secret",
    accept_licenses = ["apple-xcode-license"],
    api_token = "s3cret",
    host = "macos_arm64",
    route = "local",
    sdk = "iphoneos",
    xcode_version = "16.2",
)

failure_test(
    name = "inline_secret_test",
    expected_failure_substring = "must stay empty",
    target = ":inline_secret_selection",
)

apple_provisioning(
    name = "auto_download",
    accept_licenses = ["apple-xcode-license"],
