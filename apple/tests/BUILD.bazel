load("@crates//:crates.bzl", "aliases")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")
load(":toolchain_tests.bzl", "apple_ios_tests", "apple_provisioning_tests")

rust_test(
    name = "path_test",
    testonly = True,
    srcs = ["path_test.rs"],
    aliases = aliases(
        package_name = "apple/apple_tests",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "path_test",
    crate_root = "path_test.rs",
    data = [
        "//apple/private/bundle:defs.bzl",
        "//apple/private/ios:app.bzl",
        "//apple/private/macos:app.bzl",
        "//apple/private/provisioning:probe.bzl",
    ],
    env = {"DX_APPLE_PATH_SOURCES": "$(rootpath //apple/private/bundle:defs.bzl) $(rootpath //apple/private/ios:app.bzl) $(rootpath //apple/private/macos:app.bzl) $(rootpath //apple/private/provisioning:probe.bzl)"},
    deps = ["//tools/testing:dx_testing"],
)

rust_test(
    name = "xcframework_script_test",
    testonly = True,
    srcs = ["xcframework_script_test.rs"],
    aliases = aliases(
        package_name = "apple/apple_tests",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "xcframework_script_test",
    crate_root = "xcframework_script_test.rs",
    data = ["//apple/private/ios:xcframework_check.sh"],
    env = {"DX_XCFRAMEWORK_CHECK": "$(rootpath //apple/private/ios:xcframework_check.sh)"},
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["//tools/testing:dx_testing"],
)

apple_ios_tests(
    name = "ios_metadata",
    size = "small",
)

apple_provisioning_tests(
    name = "provisioning_metadata",
    size = "small",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "toolchain_tests.bzl",
    ],
    tags = ["corpus"],
    visibility = ["//visibility:public"],
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

real_source_target(
    name = "corpus_toml",
    testonly = True,
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
