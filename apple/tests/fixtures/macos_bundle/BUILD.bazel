# gazelle:ignore
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//rust:defs.bzl", "rust_static_library")
load("//apple:defs.bzl", "apple_macos_app")

_MACOS_ARM64 = [
    "@platforms//os:macos",
    "@platforms//cpu:arm64",
]

rust_static_library(
    name = "ledger_rust",
    srcs = ["ledger.rs"],
    edition = "2021",
    tags = ["manual"],
    target_compatible_with = _MACOS_ARM64,
)

apple_macos_app(
    name = "ledger",
    srcs = ["main.m"],
    bundle_id = "com.example.ledger",
    deployment = "14.0",
    library = ":ledger_rust",
    resources = ["entries.txt"],
    tags = ["manual"],
    version = "2.3",
)

build_test(
    name = "ledger_build_test",
    target_compatible_with = _MACOS_ARM64,
    targets = [":ledger"],
)
