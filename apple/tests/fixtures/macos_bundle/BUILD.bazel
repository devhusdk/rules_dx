# gazelle:ignore
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//rust:defs.bzl", "rust_static_library")
load("//apple:defs.bzl", "apple_macos_app")
load("//apple/tests:coverage_tests.bzl", "apple_coverage_link_test")
load("//swift:defs.bzl", "swift_library")

_MACOS_ARM64 = [
    "@platforms//os:macos",
    "@platforms//cpu:arm64",
]

rust_static_library(
    name = "ledger_rust",
    srcs = ["ledger.rs"],
    edition = "2021",
    tags = ["manual"],
    target_compatible_with = _MACOS_ARM64,
)

apple_macos_app(
    name = "ledger",
    srcs = ["main.m"],
    bundle_id = "com.example.ledger",
    deployment = "14.0",
    library = ":ledger_rust",
    resources = ["entries.txt"],
    tags = ["manual"],
    version = "2.3",
)

swift_library(
    name = "desk",
    srcs = ["DeskApp.swift"],
    module_name = "desk",
    tags = ["manual"],
    target_compatible_with = _MACOS_ARM64,
)

apple_macos_app(
    name = "desk_app",
    bundle_id = "com.example.desk",
    entry = ":desk",
    tags = ["manual"],
    version = "1.0",
)

apple_coverage_link_test(
    name = "desk_app_coverage_link_test",
    size = "small",
    target_under_test = ":desk_app_bundle",
)

build_test(
    name = "ledger_build_test",
    target_compatible_with = _MACOS_ARM64,
    targets = [
        ":desk_app",
        ":ledger",
    ],
)
