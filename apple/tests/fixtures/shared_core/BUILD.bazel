# gazelle:ignore
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//rust:defs.bzl", "rust_binary", "rust_static_library")
load("//apple:defs.bzl", "APPLE_HOSTS", "apple_ios_xcframework")

_MACOS_ARM64 = [
    "@platforms//os:macos",
    "@platforms//cpu:arm64",
]

rust_static_library(
    name = "core_rust",
    srcs = ["core.rs"],
    edition = "2021",
    tags = ["manual"],
    target_compatible_with = APPLE_HOSTS,
    deps = ["//examples/shared-rust:tasks_core"],
)

rust_binary(
    name = "core_cli",
    srcs = ["cli.rs"],
    edition = "2021",
    tags = ["manual"],
    target_compatible_with = _MACOS_ARM64,
    deps = ["//examples/shared-rust:tasks_core"],
)

apple_ios_xcframework(
    name = "core_framework",
    bundle_id = "com.example.sharedcore",
    bundle_name = "SharedCore",
    deployment = "17.0",
    hdrs = ["shared_core.h"],
    library = ":core_rust",
    platforms = [
        "@apple_support//platforms:ios_arm64",
        "@apple_support//platforms:ios_sim_arm64",
    ],
    resources = ["board.txt"],
    tags = ["manual"],
    version = "1.0",
)

build_test(
    name = "core_build_test",
    target_compatible_with = _MACOS_ARM64,
    targets = [
        ":core_cli",
        ":core_framework",
    ],
)
