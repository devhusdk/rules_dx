# gazelle:ignore
load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//javascript/private:frameworks.bzl", "dx_framework_jest_files")

package(default_visibility = [
    "//:__pkg__",
    "//astro:__subpackages__",
    "//tools/ci:__pkg__",
])

exports_files([
    "astro_tool.mjs",
    "defs.bzl",
    "jest.config.cjs",
    "jest_transform.mjs",
])

copy_to_bin(
    name = "astro_tool_entry",
    srcs = ["astro_tool.mjs"],
)

dx_framework_jest_files("jest_transform.mjs")

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "bzl_srcs",
    srcs = glob(["*.bzl"]),
    visibility = ["//tools/api:__pkg__"],
)
