# gazelle:ignore
load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//javascript/private:frameworks.bzl", "dx_framework_jest_files")
load("//javascript/private:windows_tool.bzl", "js_build_tool")

package(default_visibility = [
    "//:__pkg__",
    "//astro:__subpackages__",
    "//tools/ci:__pkg__",
])

exports_files([
    "astro_tool.mjs",
    "defs.bzl",
    "jest.config.cjs",
    "jest_transform.mjs",
])

js_binary(
    name = "astro_tool",
    entry_point = "astro_tool.mjs",
    visibility = ["//visibility:public"],
)

js_build_tool(
    name = "astro_build_tool",
    tool = ":astro_tool",
    visibility = ["//visibility:public"],
)

dx_framework_jest_files("jest_transform.mjs")

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "bzl_srcs",
    srcs = glob(["*.bzl"]),
    visibility = ["//tools/api:__pkg__"],
)
