load("//astro:defs.bzl", "astro_build", "astro_library")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//tools/testing:web_hello.bzl", "dx_web_app")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

dx_web_app(
    size = "small",
    srcs = glob(["src/**"]),
    build = astro_build,
    config = "astro.config.mjs",
    library = astro_library,
    library_srcs = glob(["src/**/*.astro"]),
    package_json = "package.json",
    public = glob(["public/**"]),
    tests = {
        "site_static_test": [":site"],
        "site_island_test": [
            ":site",
            "//:node_modules/jest-environment-jsdom",
        ],
    },
    deps = [
        "//:node_modules/@astrojs/preact",
        "//:node_modules/preact",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
