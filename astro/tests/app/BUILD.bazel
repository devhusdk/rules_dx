load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//astro/rules:defs.bzl", "astro_build", "astro_check", "astro_library")
load("//javascript/rules:defs.bzl", "javascript_test")
load("//javascript/rules:web.bzl", "javascript_web_server")
load("//quality:fixtures.bzl", "real_source_target")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

_SRCS = glob(["src/**"])

_DEPS = [
    "//:node_modules/@astrojs/preact",
    "//:node_modules/preact",
]

astro_library(
    name = "components",
    srcs = glob(["src/**/*.astro"]),
)

astro_build(
    name = "site",
    srcs = _SRCS,
    config = "astro.config.mjs",
    node_modules = "//:node_modules",
    package_json = "package.json",
    public = glob(["public/**"]),
    deps = _DEPS,
)

astro_check(
    name = "check",
    srcs = _SRCS,
    config = "astro.config.mjs",
    node_modules = "//:node_modules",
    package_json = "package.json",
    tsconfig = "tsconfig.json",
    deps = _DEPS,
)

javascript_web_server(
    name = "serve",
    app = ":site",
    aspect_hints = ["//:ruff_config"],
)

javascript_test(
    name = "site_static_test",
    srcs = ["site_static.test.js"],
    aspect_hints = ["//:biome_config"],
    data = [":site"],
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
    package_json = "//:package_json",
)

javascript_test(
    name = "site_island_test",
    srcs = ["site_island.test.js"],
    aspect_hints = ["//:biome_config"],
    data = [
        ":site",
        "//:node_modules/jest-environment-jsdom",
    ],
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
    package_json = "//:package_json",
)

build_test(
    name = "app_build_test",
    targets = [
        ":components",
        ":serve",
        ":site",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
