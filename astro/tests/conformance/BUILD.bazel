# gazelle:ignore
load("//astro:defs.bzl", "astro_library", "astro_test")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "dx_coverage_test", "subject_compatible_with")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

astro_library(
    name = "conformance",
    srcs = ["Hello.astro"],
)

astro_test(
    name = "pass_subject_test",
    size = "small",
    srcs = ["pass.test.js"],
    data = [
        ":Hello.astro",
        ":helper.js",
    ],
    node_modules = "//:node_modules",
    package_json = "//:package_json",
    target_compatible_with = subject_compatible_with(),
)

astro_test(
    name = "fail_subject_test",
    size = "small",
    srcs = ["fail.test.js"],
    data = [
        ":Hello.astro",
        ":helper.js",
    ],
    node_modules = "//:node_modules",
    package_json = "//:package_json",
    target_compatible_with = subject_compatible_with(),
)

astro_test(
    name = "wrapper_test",
    size = "small",
    srcs = ["pass.test.js"],
    data = [
        ":Hello.astro",
        ":helper.js",
    ],
    node_modules = "//:node_modules",
    package_json = "//:package_json",
)

dx_coverage_test(
    name = "component_coverage_test",
    size = "small",
    covered_source = "conformance/Hello.astro",
    subject = ":wrapper_test",
)

dx_conformance_suite(
    name = "",
    binary = ":conformance",
    covered_source = "helper.js",
    expected = "",
    failing_case = "failing case",
    failing_pattern = "Hello.astro › {case}",
    failing_test = ":fail_subject_test",
    lang = "astro",
    not_applicable = {
        "build_test": "astro has no binary rule",
        "cross_test": "astro has no binary rule",
        "lock_test": "astro has no binary rule",
        "runfiles_test": "astro has no binary rule",
    },
    passing_test = ":pass_subject_test",
    size = "small",
)
