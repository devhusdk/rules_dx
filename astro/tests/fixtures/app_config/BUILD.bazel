# gazelle:ignore
load("//astro:defs.bzl", "astro_build")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//javascript:defs.bzl", "javascript_library", "javascript_test")
load("//typescript:defs.bzl", "typescript_config")
load("//typescript/tests:windows_tool_tests.bzl", "framework_build_tool_tests")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

_SRCS = glob(["src/**"]) + ["astro.config.mjs"]

astro_build(
    name = "site",
    srcs = _SRCS,
    config = "configs/astro.site.mjs",
    node_modules = "//:node_modules",
    package_json = "package.json",
)

javascript_test(
    name = "config_file_test",
    testonly = True,
    srcs = ["config_file.test.js"],
    data = [":site"],
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
    package_json = "//:package_json",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

javascript_library(
    name = "astro_config",
    testonly = True,
    srcs = ["astro.config.mjs"],
    deps = ["//:node_modules/astro"],
)

typescript_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = ["//visibility:public"],
)

framework_build_tool_tests(
    name = "build_tool_tests",
    build = "site",
)
