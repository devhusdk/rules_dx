# gazelle:ignore
# gazelle:dx_ignore_import cc avro/tests/shapes_cc.hh
# gazelle:dx_ignore_import cc avro/tests/shape_avsc_cc.hh
load("//avro:defs.bzl", "avro_cc_library", "avro_java_library", "avro_library")
load("//cc:defs.bzl", "cc_test")
load("//core/codegen:codegen_tests.bzl", "codegen_shard_argv_test")
load("//java:defs.bzl", "java_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load(":defs_tests.bzl", "avro_library_tests")

package(default_visibility = ["//visibility:private"])

avro_library_tests(name = "avro_library_tests")

avro_library(
    name = "point",
    srcs = ["point.avsc"],
)

avro_library(
    name = "shape",
    srcs = ["shape.avdl"],
    deps = [":point"],
)

avro_library(
    name = "ring",
    srcs = ["ring.avdl"],
    deps = [":point"],
)

avro_cc_library(
    name = "shapes_cc",
    namespace = "dx_avro",
    deps = [
        ":ring",
        ":shape",
    ],
)

# keep
cc_test(
    name = "cc_roundtrip_test",
    srcs = ["cc_roundtrip_test.cc"],
    copts = ["-std=c++17"],
    linkstatic = True,
    deps = [":shapes_cc"],
)

avro_cc_library(
    name = "point_cc",
    namespace = "dx_avro",
    deps = [":point"],
)

codegen_shard_argv_test(
    name = "point_cc_shard_argv_test",
    expected = [
        "--producer",
        "//avro/tests:point_cc",
        "--language",
        "cpp",
        "--entry",
        "gen/point_cc.hh|gen|dx_avro|avro/tests/_avro_cc/point_cc/avro/tests/point_cc.hh",
        "--output",
    ],
    output = "avro/tests/point_cc.dxcodegen.pb",
    target_under_test = ":point_cc",
)

codegen_shard_argv_test(
    name = "shapes_cc_shard_argv_test",
    expected = [
        "--producer",
        "//avro/tests:shapes_cc",
        "--language",
        "cpp",
        "--entry",
        "gen/shapes_cc.hh|gen|dx_avro|avro/tests/_avro_cc/shapes_cc/avro/tests/shapes_cc.hh",
        "--output",
    ],
    output = "avro/tests/shapes_cc.dxcodegen.pb",
    target_under_test = ":shapes_cc",
)

avro_library(
    name = "base",
    srcs = ["base.avsc"],
)

avro_library(
    name = "shape_avsc",
    srcs = ["shape.avsc"],
    deps = [":base"],
)

avro_library(
    name = "ping",
    srcs = ["ping.avdl"],
)

avro_cc_library(
    name = "shape_avsc_cc",
    namespace = "dx_test",
    deps = [":shape_avsc"],
)

# keep
cc_test(
    name = "cc_shape_avsc_roundtrip_test",
    srcs = ["cc_shape_avsc_roundtrip_test.cc"],
    copts = ["-std=c++17"],
    linkstatic = True,
    deps = [":shape_avsc_cc"],
)

avro_java_library(
    name = "shapes_java",
    deps = [
        ":ping",
        ":ring",
        ":shape_avsc",
    ],
)

java_test(
    name = "RoundtripTest",
    srcs = ["RoundtripTest.java"],
    jvm_flags = ["-Dorg.apache.avro.SERIALIZABLE_PACKAGES=dx.test,dx.avro"],
    main_class = "RoundtripTest",
    tags = ["no-lint"],
    test_class = "RoundtripTest",
    use_testrunner = False,
    deps = [":shapes_java"],
)

codegen_shard_argv_test(
    name = "shapes_java_shard_argv_test",
    size = "small",
    expected = [
        "--producer",
        "//avro/tests:shapes_java",
        "--language",
        "java",
        "--entry",
        "gen/shapes_java.srcjar|gen||avro/tests/shapes_java.srcjar",
        "--output",
    ],
    output = "avro/tests/shapes_java.dxcodegen.pb",
    target_under_test = ":shapes_java",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "defs_tests.bzl",
    ],
    tags = ["corpus"],
    visibility = ["//:__pkg__"],
)
