load("//avro:defs.bzl", "avro_cc_library", "avro_java_library", "avro_library")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite")
load(":quality.bzl", "avro_format_subject")

# The dirty fixtures stay in their own manual targets; gazelle would merge them
# into the clean library.
# gazelle:exclude lint_dirty.avsc
# gazelle:exclude format_dirty.avsc

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

avro_library(
    name = "conformance",
    testonly = True,
    srcs = ["greet.avsc"],
)

# keep
avro_library(
    name = "format_dirty",
    srcs = ["format_dirty.avsc"],
)

# keep
avro_library(
    name = "lint_dirty",
    srcs = ["lint_dirty.avsc"],
)

dx_conformance_suite(
    name = "",
    size = "small",
    binary = ":conformance",
    covered_source = "",
    expected = "",
    failing_case = "",
    failing_test = ":conformance",
    lang = "avro",
    not_applicable = {
        "build_test": "avro has no binary rule",
        "coverage_test": "avro has no test rule",
        "cross_test": "avro has no binary rule",
        "fail_test": "avro has no test rule",
        "lock_test": "avro has no package manager",
        "pass_test": "avro has no test rule",
        "runfiles_test": "avro has no binary rule",
    },
    passing_test = ":conformance",
    quality = {
        "clean": ":conformance",
        "format_dirty": ":format_dirty",
        "format_source": "format_dirty.avsc",
        "format_subject": avro_format_subject,
        "lint_dirty": ":lint_dirty",
        "lint_line": 1,
        "lint_rule": "error",
        "lint_source": "lint_dirty.avsc",
    },
)

avro_cc_library(
    name = "conformance_cc",
    testonly = True,
    visibility = ["//visibility:public"],
    deps = [":conformance"],
)

avro_java_library(
    name = "conformance_java",
    testonly = True,
    visibility = ["//visibility:public"],
    deps = [":conformance"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "quality.bzl",
    ],
    tags = ["corpus"],
)
