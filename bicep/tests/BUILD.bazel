load(":library_tests.bzl", "owns_bicep_class_test", "registry_deps_test", "registry_unit_tests", "transitive_context_test")

bicep_library(
    name = "lib",
    srcs = ["fixtures/lib.bicep"],
    data = ["fixtures/data.json"],
)

bicep_library(
    name = "app",
    srcs = ["fixtures/app.bicep"],
    deps = [":lib"],
)

owns_bicep_class_test(
    name = "owns_bicep_class_test",
    size = "small",
    target_under_test = ":app",
)

transitive_context_test(
    name = "transitive_context_test",
    size = "small",
    target_under_test = ":app",
)

bicep_library(
    name = "bad_src",
    srcs = ["fixtures/notes.txt"],
    tags = ["manual"],
)

failure_test(
    name = "non_bicep_src_fails",
    expected_failure_substring = "notes.txt",
    target = ":bad_src",
)

bicep_library(
    name = "config_in_data",
    data = ["fixtures/bicepconfig.json"],
    tags = ["manual"],
)

failure_test(
    name = "config_in_data_fails",
    expected_failure_substring = "bind it with bicep_config",
    target = ":config_in_data",
)

registry_unit_tests(name = "registry_unit")

bicep_registry_module(
    name = "registry_fixture",
    srcs = [
        "fixtures/registry/main.json",
        "fixtures/registry/manifest",
    ],
    cache_root = "fixtures/registry",
    ref = "br:example.invalid/m:1",
)

bicep_library(
    name = "registry_app",
    srcs = ["fixtures/registry_app.bicep"],
    deps = [":registry_fixture"],
)

registry_deps_test(
    name = "registry_deps_test",
    size = "small",
    target_under_test = ":registry_app",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "library_tests.bzl",
    ],
    tags = ["corpus"],
)
