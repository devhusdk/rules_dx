load("//core/quality:fixtures.bzl", "real_source_target")
load(":defs.bzl", "capnproto_std_stage")

package(default_visibility = [
    "//:__pkg__",
    "//capnproto:__subpackages__",
    "//tools/ci:__pkg__",
])

exports_files([
    "codegen.bzl",
    "defs.bzl",
    "providers.bzl",
])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "codegen.bzl",
        "defs.bzl",
        "providers.bzl",
        "java.BUILD.bazel",
        "rust.BUILD.bazel",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
        "java.BUILD.bazel",
        "rust.BUILD.bazel",
    ]),
    visibility = ["//:__subpackages__"],
)

capnproto_std_stage(
    name = "std_stage",
    srcs = ["//capnproto:std"],
    visibility = ["//visibility:public"],
)
