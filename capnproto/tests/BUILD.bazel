# gazelle:ignore
load("//capnproto:defs.bzl", "capnproto_cc_library", "capnproto_java_library", "capnproto_rust_library")
load("//cc:defs.bzl", "cc_test")
load("//core:failure_test.bzl", "failure_test")
load("//core/codegen:codegen_tests.bzl", "codegen_shard_argv_test")
load("//java:defs.bzl", "java_test")
load("//rust:defs.bzl", "rust_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load(":defs_tests.bzl", "capnp_library_tests")
load(":failure_tests.bzl", "capnp_undeclared_rust_test")

package(default_visibility = ["//visibility:private"])

capnp_library_tests(name = "capnp_library_tests")

# C++ for both libraries; the schema in api/ imports the one in base/.
capnproto_cc_library(
    name = "shapes_cc",
    deps = [
        "//capnproto/tests/api",
        "//capnproto/tests/base",
    ],
)

cc_test(
    name = "cc_roundtrip_test",
    srcs = ["cc_roundtrip_test.cc"],
    copts = select({
        "@platforms//os:windows": ["/std:c++17"],
        "//conditions:default": ["-std=c++17"],
    }),
    deps = [":shapes_cc"],
    # macOS: capnp compile of kj-async fails, pthread.h not found.
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

# A second library over the same schemas must share the one compile per library.
capnproto_cc_library(
    name = "shapes_cc_again",
    deps = [
        "//capnproto/tests/api",
        "//capnproto/tests/base",
    ],
)

cc_test(
    name = "cc_both_libraries_test",
    srcs = ["cc_roundtrip_test.cc"],
    copts = select({
        "@platforms//os:windows": ["/std:c++17"],
        "//conditions:default": ["-std=c++17"],
    }),
    deps = [
        ":shapes_cc",
        ":shapes_cc_again",
    ],
    # macOS: capnp compile of kj-async fails, pthread.h not found.
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

codegen_shard_argv_test(
    name = "shapes_cc_shard_argv_test",
    expected = [
        "--producer",
        "//capnproto/tests:shapes_cc",
        "--language",
        "cpp",
        "--entry",
        "gen/common.capnp.h|gen||capnproto/tests/base/_capnp_cc/capnproto/tests/base/common.capnp.h",
        "--entry",
        "gen/common.capnp.c++|gen||capnproto/tests/base/_capnp_cc/capnproto/tests/base/common.capnp.c++",
        "--entry",
        "gen/kind.capnp.h|gen||capnproto/tests/api/_capnp_cc/capnproto/tests/api/kind.capnp.h",
        "--entry",
        "gen/kind.capnp.c++|gen||capnproto/tests/api/_capnp_cc/capnproto/tests/api/kind.capnp.c++",
        "--entry",
        "gen/shape.capnp.h|gen||capnproto/tests/api/_capnp_cc/capnproto/tests/api/shape.capnp.h",
        "--entry",
        "gen/shape.capnp.c++|gen||capnproto/tests/api/_capnp_cc/capnproto/tests/api/shape.capnp.c++",
        "--output",
    ],
    output = "capnproto/tests/shapes_cc.dxcodegen.pb",
    target_under_test = ":shapes_cc",
)

# api_rs mirrors the api -> base dependency and refers to base_rs types by path.
capnproto_rust_library(
    name = "base_rs",
    library = "//capnproto/tests/base",
)

capnproto_rust_library(
    name = "api_rs",
    library = "//capnproto/tests/api",
    deps = [":base_rs"],
)

codegen_shard_argv_test(
    name = "base_rs_shard_argv_test",
    expected = [
        "--producer",
        "//capnproto/tests:base_rs_generated",
        "--language",
        "rust",
        "--entry",
        "gen/common_capnp.rs|gen||capnproto/tests/base_rs_generated_capnp_rs/capnproto/tests/base/common_capnp.rs",
        "--output",
    ],
    output = "capnproto/tests/base_rs_generated.dxcodegen.pb",
    target_under_test = ":base_rs_generated",
)

codegen_shard_argv_test(
    name = "api_rs_shard_argv_test",
    expected = [
        "--producer",
        "//capnproto/tests:api_rs_generated",
        "--language",
        "rust",
        "--entry",
        "gen/kind_capnp.rs|gen||capnproto/tests/api_rs_generated_capnp_rs/capnproto/tests/api/kind_capnp.rs",
        "--entry",
        "gen/shape_capnp.rs|gen||capnproto/tests/api_rs_generated_capnp_rs/capnproto/tests/api/shape_capnp.rs",
        "--output",
    ],
    output = "capnproto/tests/api_rs_generated.dxcodegen.pb",
    target_under_test = ":api_rs_generated",
)

# Java: one compile per capnproto_library, against the runtime from the pinned archive.
capnproto_java_library(
    name = "shapes_java",
    deps = [
        "//capnproto/tests/api",
        "//capnproto/tests/base",
    ],
)

java_test(
    name = "JavaRoundtripTest",
    srcs = ["JavaRoundtripTest.java"],
    main_class = "JavaRoundtripTest",
    tags = ["no-lint"],  # no lint config in this fixture package
    test_class = "JavaRoundtripTest",
    use_testrunner = False,
    deps = [":shapes_java"],
    # macOS: capnp compile of kj-async fails, pthread.h not found.
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

codegen_shard_argv_test(
    name = "shapes_java_shard_argv_test",
    expected = [
        "--producer",
        "//capnproto/tests:shapes_java",
        "--language",
        "java",
        "--entry",
        "gen/base.srcjar|gen||capnproto/tests/base/_capnp_java/base.srcjar",
        "--entry",
        "gen/api.srcjar|gen||capnproto/tests/api/_capnp_java/api.srcjar",
        "--output",
    ],
    output = "capnproto/tests/shapes_java.dxcodegen.pb",
    target_under_test = ":shapes_java",
)

# Failing fixtures: only built by the analysis tests below.

# A rust crate whose library depends on base, but whose deps omit base_rs.
capnproto_rust_library(
    name = "api_rs_nodep",
    library = "//capnproto/tests/api",
    tags = ["manual"],
)

failure_test(
    name = "rust_missing_crate_dep_test",
    expected_failure_substring = "has no capnproto_rust_library in deps",
    target = ":api_rs_nodep_generated",
)

failure_test(
    name = "rust_duplicate_module_test",
    expected_failure_substring = "generate module common_capnp",
    target = "//capnproto/tests/dup:dup_rs_generated",
)

capnp_undeclared_rust_test(
    name = "undeclared_rs_test",
    size = "small",
    target_under_test = "//capnproto/tests/lost:lost_rs_generated",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "defs_tests.bzl",
        "failure_tests.bzl",
    ],
    tags = ["corpus"],
    visibility = ["//:__pkg__"],
)

rust_test(
    name = "rust_roundtrip_test",
    srcs = ["rs_roundtrip_test.rs"],
    deps = [
        ":api_rs",
        ":base_rs",
        "//capnproto:runtime_rust",
    ],
)
