load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//rust/rules:defs.bzl", "rust_binary", "rust_library", "rust_test", "rustfmt_test")
load("//quality:fixtures.bzl", "real_source_target")

# gazelle:resolve rust dx_testing //tools/testing:dx_testing

package(default_visibility = ["//:__subpackages__"])

exports_files(["Cargo.toml"])

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

rust_library(
    name = "cc_context",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "cc/cc_context",
        normal = True,
    ),
    crate_name = "cc_context",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = all_crate_deps(
        package_name = "cc/cc_context",
        normal = True,
    ),
)

rust_test(
    name = "cc_context_test",
    size = "small",
    srcs = [
        "src/lib.rs",
        "src/lib_tests.rs",
    ],
    aliases = aliases(
        package_name = "cc/cc_context",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "cc_context",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = all_crate_deps(
        package_name = "cc/cc_context",
        normal = True,
        normal_dev = True,
    ),
)

rust_binary(
    name = "compile_db",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "cc/cc_context",
        normal = True,
    ),
    crate_name = "compile_db",
    crate_root = "src/main.rs",
    edition = "2021",
    deps = all_crate_deps(
        package_name = "cc/cc_context",
        normal = True,
    ) + [":cc_context"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

rust_test(
    name = "context_clang_tidy_test",
    size = "medium",
    srcs = ["tests/context_clang_tidy.rs"],
    aliases = aliases(
        package_name = "cc/cc_context",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "context_clang_tidy_test",
    crate_root = "tests/context_clang_tidy.rs",
    data = [
        "//cc/tests/fixtures/compilation_db:.clang-tidy",
        "//cc/tests/fixtures/compilation_db:limits_h",
        "//cc/tests/fixtures/compilation_db:probe.c",
        "//cc/tests/fixtures/compilation_db:probe_consumer_toolchain.aquery.json",
        "//cc/tests/fixtures/compilation_db:probe_legacy.aquery.json",
        "//cc/tests/fixtures/compilation_db:probe_plain.aquery.json",
        "@llvm//tools:clang-tidy",
    ],
    edition = "2021",
    env = {
        "DX_CLANG_TIDY": "$(rootpath @llvm//tools:clang-tidy)",
        "DX_GENERATED_HEADER": "$(rootpath //cc/tests/fixtures/compilation_db:limits_h)",
    },
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = all_crate_deps(
        package_name = "cc/cc_context",
        normal = True,
        normal_dev = True,
    ) + [":cc_context"],
)

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["//quality:corpus_vale_config"],
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

rust_test(
    name = "headless_lsp_test",
    size = "medium",
    timeout = "long",
    srcs = ["tests/headless_lsp.rs"],
    aliases = aliases(
        package_name = "cc/cc_context",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "headless_lsp_test",
    crate_root = "tests/headless_lsp.rs",
    data = [
        "//cc/tests/fixtures/compilation_db:limits_h",
        "//cc/tests/fixtures/compilation_db:probe.c",
        "//cc/tests/fixtures/compilation_db:probe_legacy.aquery.json",
        "@llvm//tools:clang",
        "@llvm//tools:clangd",
        "@rust_analyzer_1.98.0_tools//:rust_analyzer",
        "@rust_analyzer_1.98.0_tools//:rustc",
        "@rust_linux_x86_64__x86_64-unknown-linux-gnu__stable_tools//:rustc",
    ],
    edition = "2021",
    env = {
        "DX_LSP_AQUERY": "$(rootpath //cc/tests/fixtures/compilation_db:probe_legacy.aquery.json)",
        "DX_LSP_CLANG": "$(rootpath @llvm//tools:clang)",
        "DX_LSP_CLANGD": "$(rootpath @llvm//tools:clangd)",
        "DX_LSP_LIMITS_H": "$(rootpath //cc/tests/fixtures/compilation_db:limits_h)",
        "DX_LSP_PROBE_C": "$(rootpath //cc/tests/fixtures/compilation_db:probe.c)",
        "DX_LSP_RUSTC_CHECK": "$(rootpath @rust_linux_x86_64__x86_64-unknown-linux-gnu__stable_tools//:rustc)",
        "DX_LSP_RUSTC_PROJECT": "$(rootpath @rust_analyzer_1.98.0_tools//:rustc)",
        "DX_LSP_RUST_ANALYZER": "$(rootpath @rust_analyzer_1.98.0_tools//:rust_analyzer)",
    },
    tags = ["no-remote-exec"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = all_crate_deps(
        package_name = "cc/cc_context",
        normal = True,
        normal_dev = True,
    ) + [
        ":cc_context",
        "//tools/testing:dx_testing",
    ],
)

rustfmt_test(
    name = "context_fmt_test",
    size = "small",
    targets = [
        ":cc_context",
        ":cc_context_test",
        ":compile_db",
    ],
)

rustfmt_test(
    name = "context_linux_x86_64_fmt_test",
    size = "small",
    targets = [
        ":context_clang_tidy_test",
        ":headless_lsp_test",
    ],
)
