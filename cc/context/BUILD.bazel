load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//rust/rules:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//cc/context:identity.bzl", "cc_context_exec_identity", "cc_context_identity")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "identity.bzl",
    ],
    tags = ["corpus"],
)

alias(
    name = "clangd",
    actual = "@llvm//tools:clangd",
    visibility = ["//visibility:public"],
)

cc_context_identity(
    name = "identity",
    visibility = ["//visibility:public"],
)

cc_context_exec_identity(
    name = "identity_exec",
    identity = ":identity",
    visibility = ["//visibility:public"],
)

rust_library(
    name = "cc_context",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "cc/cc_context",
        normal = True,
    ),
    crate_name = "cc_context",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cc/cc_context",
        normal = True,
    ) + ["@crates//:serde"],
)

rust_test(
    name = "cc_context_test",
    srcs = [
        "src/lib.rs",
        "src/lib_tests.rs",
    ],
    aliases = aliases(
        package_name = "cc/cc_context",
        normal = True,
        normal_dev = True,
    ),
    coverage_lib = ":cc_context",
    crate_name = "cc_context",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cc/cc_context",
        normal = True,
        normal_dev = True,
    ) + ["@crates//:serde"],
)

rust_binary(
    name = "qualify",
    srcs = ["qualify/main.rs"],
    aliases = aliases(
        package_name = "cc/cc_context",
        normal = True,
    ),
    crate_name = "qualify",
    crate_root = "qualify/main.rs",
    deps = all_crate_deps(
        package_name = "cc/cc_context",
        normal = True,
    ) + [":cc_context"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

rust_test(
    name = "context_clang_tidy_test",
    srcs = ["tests/context_clang_tidy.rs"],
    aliases = aliases(
        package_name = "cc/cc_context",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "context_clang_tidy_test",
    crate_root = "tests/context_clang_tidy.rs",
    data = [
        ":identity",
        ":identity_exec",
        "//cc/tests/fixtures/compilation_db:.clang-tidy",
        "//cc/tests/fixtures/compilation_db:limits_h",
        "//cc/tests/fixtures/compilation_db:probe.c",
        "//cc/tests/fixtures/compilation_db:probe_consumer_toolchain.aquery.json",
        "//cc/tests/fixtures/compilation_db:probe_legacy.aquery.json",
        "//cc/tests/fixtures/compilation_db:probe_plain.aquery.json",
        "@llvm//tools:clang-tidy",
    ],
    env = {
        "DX_CLANG_TIDY": "$(rootpath @llvm//tools:clang-tidy)",
        "DX_IDENTITY": "$(rootpath :identity)",
        "DX_IDENTITY_EXEC": "$(rootpath :identity_exec)",
        "DX_GENERATED_HEADER": "$(rootpath //cc/tests/fixtures/compilation_db:limits_h)",
    },
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = all_crate_deps(
        package_name = "cc/cc_context",
        normal = True,
        normal_dev = True,
    ) + [":cc_context"],
)

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

rust_test(
    name = "headless_lsp_clangd_test",
    srcs = ["tests/headless_lsp/clangd.rs"],
    crate_name = "headless_lsp_clangd_test",
    crate_root = "tests/headless_lsp/clangd.rs",
    data = [
        "//cc/tests/fixtures/compilation_db:limits_h",
        "//cc/tests/fixtures/compilation_db:probe.c",
        "//cc/tests/fixtures/compilation_db:probe_legacy.aquery.json",
        "@llvm//tools:clang",
        "@llvm//tools:clangd",
    ],
    env = {
        "DX_LSP_AQUERY": "$(rootpath //cc/tests/fixtures/compilation_db:probe_legacy.aquery.json)",
        "DX_LSP_CLANG": "$(rootpath @llvm//tools:clang)",
        "DX_LSP_CLANGD": "$(rootpath @llvm//tools:clangd)",
        "DX_LSP_LIMITS_H": "$(rootpath //cc/tests/fixtures/compilation_db:limits_h)",
        "DX_LSP_PROBE_C": "$(rootpath //cc/tests/fixtures/compilation_db:probe.c)",
    },
    tags = ["no-remote-exec"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        ":cc_context",
        "//tools/testing:dx_testing",
        "//tools/testing/lsp:dx_lsp",
        "@crates//:serde_json",
    ],
)

# size: medium, rust-analyzer startup, measured 121s linux_x86_64 2026-11-04
rust_test(
    name = "headless_lsp_rust_analyzer_test",
    size = "medium",
    srcs = ["tests/headless_lsp/rust_analyzer.rs"],
    crate_name = "headless_lsp_rust_analyzer_test",
    crate_root = "tests/headless_lsp/rust_analyzer.rs",
    data = [
        "@rust_analyzer",
        "@rust_analyzer//:rustc",
        "@rust_linux_x86_64__x86_64-unknown-linux-gnu__stable_tools//:rustc",
    ],
    env = {
        "DX_LSP_RUSTC_CHECK": "$(rootpath @rust_linux_x86_64__x86_64-unknown-linux-gnu__stable_tools//:rustc)",
        "DX_LSP_RUSTC_PROJECT": "$(rootpath @rust_analyzer//:rustc)",
        "DX_LSP_RUST_ANALYZER": "$(rootpath @rust_analyzer//:rust_analyzer)",
    },
    tags = ["no-remote-exec"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        "//tools/testing:dx_testing",
        "//tools/testing/lsp:dx_lsp",
        "@crates//:serde_json",
    ],
)
