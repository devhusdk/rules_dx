{
  "$schema": "../core/modules/lang.schema.json",
  "name": "cc",
  "title": "C and C++",
  "family": "core",
  "ecosystems": [
    "conan"
  ],
  "depcheck": "cc",
  "semver": false,
  "manifests": [
    "conanfile.txt"
  ],
  "lockfiles": [
    "conan.lock"
  ],
  "tools": [
    "clang_format",
    "clang_syntax",
    "clang_tidy"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_arm64",
    "windows_x86_64"
  ],
  "pins": [
    "toolchains/pins.bzl"
  ],
  "entry_points": [
    "cc_coverage_features",
    "cc_coverage_settings",
    "cc_coverage_unsupported",
    "cc_coverage_mismatch",
    "cc_coverage_probe",
    "cc_param_file_features",
    "cc_library",
    "objc_library",
    "cc_binary",
    "cc_test",
    "cc_fuzz_test",
    "cc_bench"
  ],
  "quality": {
    "bzl": "quality:families/cc.bzl",
    "file_extensions": [
      ".c",
      ".cc",
      ".cpp",
      ".cu",
      ".cuh",
      ".cxx",
      ".h",
      ".hh",
      ".hpp",
      ".hxx",
      ".inl",
      ".ipp",
      ".m",
      ".mm"
    ],
    "aspects": {
      "format": [
        "real_cc_format_aspect"
      ],
      "lint": [
        "real_cc_lint_aspect"
      ],
      "typecheck": [
        "real_cc_typecheck_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_cc_format_probe_aspect"
      ],
      "lint": [
        "real_cc_lint_probe_aspect"
      ],
      "typecheck": [
        "real_cc_typecheck_probe_aspect"
      ]
    }
  },
  "docs": {
    "bzl": "tools/docs/cc:aspect.bzl",
    "file_extensions": [
      ".c",
      ".cc",
      ".cpp",
      ".cu",
      ".cuh",
      ".cxx",
      ".h",
      ".hh",
      ".hpp",
      ".hxx",
      ".inl",
      ".ipp"
    ],
    "aspects": [
      "real_cc_docs_aspect"
    ]
  }
}
