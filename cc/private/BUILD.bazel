# gazelle:ignore
# gazelle:exclude fuzz_driver.cc
load("//core/quality:fixtures.bzl", "real_source_target")
load(":defs.bzl", "cc_coverage_probe", "cc_library")

package(default_visibility = ["//cc:__subpackages__", "//tools/ci:__pkg__", "//:__pkg__"])

exports_files([
    "bench_run.sh",
    "defs.bzl",
])

cc_coverage_probe(
    name = "coverage_probe",
    visibility = ["//:__subpackages__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "clang_syntax.bzl",
        "defs.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)

cc_library(
    name = "fuzz_driver",
    testonly = True,
    srcs = ["fuzz_driver.cc"],
    visibility = ["//visibility:private"],
)
