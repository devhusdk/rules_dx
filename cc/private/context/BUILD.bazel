load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//cc/private/context:identity.bzl", "cc_context_exec_identity", "cc_context_identity")
load("//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "identity.bzl",
    ],
    tags = ["corpus"],
)

alias(
    name = "clangd",
    actual = "@llvm//tools:clangd",
    visibility = ["//visibility:public"],
)

cc_context_identity(
    name = "identity",
    visibility = ["//visibility:public"],
)

cc_context_exec_identity(
    name = "identity_exec",
    identity = ":identity",
    visibility = ["//visibility:public"],
)

rust_library(
    name = "cc_context",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "cc/private/cc_context",
        normal = True,
    ),
    crate_name = "cc_context",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cc/private/cc_context",
        normal = True,
    ) + ["@crates//:serde"],
)

rust_test(
    name = "cc_context_test",
    size = "small",
    srcs = [
        "src/lib.rs",
        "src/lib_tests.rs",
    ],
    aliases = aliases(
        package_name = "cc/private/cc_context",
        normal = True,
        normal_dev = True,
    ),
    coverage_lib = ":cc_context",
    crate_name = "cc_context",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cc/private/cc_context",
        normal = True,
        normal_dev = True,
    ) + [
        "//cli/test_scratch:dx_test_scratch",
        "@crates//:serde",
    ],
)

rust_binary(
    name = "qualify",
    srcs = ["qualify/main.rs"],
    aliases = aliases(
        package_name = "cc/private/cc_context",
        normal = True,
    ),
    crate_name = "qualify",
    crate_root = "qualify/main.rs",
    deps = all_crate_deps(
        package_name = "cc/private/cc_context",
        normal = True,
    ) + [":cc_context"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
