load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//cc/private/context:identity.bzl", "cc_context_exec_identity", "cc_context_identity")
load("//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "identity.bzl",
    ],
    tags = ["corpus"],
)

alias(
    name = "clangd",
    actual = "@llvm//tools:clangd",
    visibility = ["//visibility:public"],
)

cc_context_identity(
    name = "identity",
    visibility = ["//visibility:public"],
)

cc_context_exec_identity(
    name = "identity_exec",
    identity = ":identity",
    visibility = ["//visibility:public"],
)

rust_library(
    name = "cc_context",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "cc/private/cc_context",
        normal = True,
    ),
    crate_name = "cc_context",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cc/private/cc_context",
        normal = True,
    ) + ["@crates//:serde"],
)

rust_test(
    name = "cc_context_test",
    srcs = [
        "src/lib.rs",
        "src/lib_tests.rs",
    ],
    aliases = aliases(
        package_name = "cc/private/cc_context",
        normal = True,
        normal_dev = True,
    ),
    coverage_lib = ":cc_context",
    crate_name = "cc_context",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cc/private/cc_context",
        normal = True,
        normal_dev = True,
    ) + ["@crates//:serde"],
)

rust_binary(
    name = "qualify",
    srcs = ["qualify/main.rs"],
    aliases = aliases(
        package_name = "cc/private/cc_context",
        normal = True,
    ),
    crate_name = "qualify",
    crate_root = "qualify/main.rs",
    deps = all_crate_deps(
        package_name = "cc/private/cc_context",
        normal = True,
    ) + [":cc_context"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

rust_test(
    name = "context_clang_tidy_test",
    srcs = ["tests/context_clang_tidy.rs"],
    aliases = aliases(
        package_name = "cc/private/cc_context",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "context_clang_tidy_test",
    crate_root = "tests/context_clang_tidy.rs",
    data = [
        ":identity",
        ":identity_exec",
        "//cc/tests/fixtures/compilation_db:.clang-tidy",
        "//cc/tests/fixtures/compilation_db:limits_h",
        "//cc/tests/fixtures/compilation_db:probe.c",
        "//cc/tests/fixtures/compilation_db:probe_consumer_toolchain.aquery.json",
        "//cc/tests/fixtures/compilation_db:probe_legacy.aquery.json",
        "//cc/tests/fixtures/compilation_db:probe_plain.aquery.json",
        "@llvm//tools:clang-tidy",
    ],
    env = {
        "DX_CLANG_TIDY": "$(rootpath @llvm//tools:clang-tidy)",
        "DX_IDENTITY": "$(rootpath :identity)",
        "DX_IDENTITY_EXEC": "$(rootpath :identity_exec)",
        "DX_GENERATED_HEADER": "$(rootpath //cc/tests/fixtures/compilation_db:limits_h)",
    },
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = all_crate_deps(
        package_name = "cc/private/cc_context",
        normal = True,
        normal_dev = True,
    ) + [":cc_context"],
)

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)
