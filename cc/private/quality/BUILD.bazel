load("//core/quality:fixtures.bzl", "real_source_target")
load(":nvcc_syntax_tests.bzl", "nvcc_syntax_unit_tests")

package(default_visibility = [
    "//:__pkg__",
    "//cc:__subpackages__",
    "//core/quality:__subpackages__",
    "//tools/ci:__pkg__",
])

exports_files([
    "cc.bzl",
    "cc_tools.bzl",
    "nvcc_syntax.bzl",
])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "cc.bzl",
        "cc_tools.bzl",
        "nvcc_syntax.bzl",
        "nvcc_syntax_tests.bzl",
    ],
    tags = ["corpus"],
)

nvcc_syntax_unit_tests(
    name = "nvcc_syntax_unit",
    size = "small",
)

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
    ]),
    visibility = ["//:__subpackages__"],
)
