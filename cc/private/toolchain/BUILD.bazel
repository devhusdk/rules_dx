load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//deploy/private:native_runtime.bzl", "native_runtime")
load(":pins.bzl", "GCC_GLIBC", "GCC_VERSION")
load(":runtime_libs.bzl", "gcc_runtime_libs")
load(":select.bzl", "gcov_tool")
load(":unavailable.bzl", "GCC_UNSUPPORTED", "cc_toolchain_unavailable")

package(default_visibility = ["//:__subpackages__"])

config_setting(
    name = "gcc_selected",
    flag_values = {"//cc:compiler": "gcc"},
    visibility = [
        "//:__subpackages__",
        "@dx_cc_toolchains//:__pkg__",
    ],
)

config_setting(
    name = "msvc_selected",
    flag_values = {"//cc:compiler": "msvc"},
    visibility = [
        "//:__subpackages__",
        "@dx_cc_toolchains//:__pkg__",
    ],
)

cc_toolchain_unavailable(
    name = "gcc_unsupported_impl",
    error = GCC_UNSUPPORTED,
    tags = ["manual"],
    visibility = [
        "//:__subpackages__",
        "@dx_cc_toolchains//:__pkg__",
    ],
)

gcov_tool(
    name = "gcov_tool",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//visibility:private"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "bindings.bzl",
        "identity_subject.bzl",
        "pins.bzl",
        "extensions.bzl",
        "hub.bzl",
        "select.bzl",
        "unavailable.bzl",
        "runtime_libs.bzl",
    ],
    tags = ["corpus"],
)

exports_files(
    ["pins.bzl"],
    visibility = ["//cc/tests/gcc_linux_x86_64:__pkg__"],
)

exports_files(
    ["notices/MSVC_REDISTRIBUTABLE.txt"],
    visibility = ["//qt/private/toolchain:__pkg__"],
)

native_runtime(
    name = "gcc_linux_glibc",
    redistribution = "os_supplied",
    source = "gcc " + GCC_VERSION + " sysroot",
    version = GCC_GLIBC.removeprefix("glibc_"),
    visibility = ["//visibility:public"],
)

gcc_runtime_libs(
    name = "gcc_linux_libstdcxx_libs",
    srcs = select({
        ":linux_arm64": ["@dx_gcc_linux_aarch64_cross//:lib"],
        "//conditions:default": ["@dx_gcc_linux_x86_64//:lib"],
    }),
)

native_runtime(
    name = "gcc_linux_libstdcxx",
    srcs = [":gcc_linux_libstdcxx_libs"],
    notice = "gcc_linux_libstdcxx_NOTICE.txt",
    redistribution = "app_local",
    source = "gcc " + GCC_VERSION,
    version = GCC_VERSION,
    visibility = ["//visibility:public"],
)

copy_file(
    name = "msvc_vcruntime_notice",
    src = "notices/MSVC_REDISTRIBUTABLE.txt",
    out = "msvc_vcruntime_NOTICE.txt",
    visibility = ["//visibility:public"],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
)

alias(
    name = "msvc_vcruntime",
    actual = "@dx_msvc//:msvc_vcruntime",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

native_runtime(
    name = "windows_ucrt",
    provides = [
        "api-ms-win-*",
        "ucrtbase.dll",
    ],
    redistribution = "os_supplied",
    source = "Windows 10 Universal CRT",
    version = "10.0",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
