load("@apple_support//configs:platforms.bzl", "APPLE_PLATFORMS_CONSTRAINTS")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)

[
    toolchain(
        name = "xcode_" + arch + "_" + cpu,
        exec_compatible_with = [
            "@platforms//os:macos",
            "@platforms//cpu:" + cpu,
        ],
        target_compatible_with = APPLE_PLATFORMS_CONSTRAINTS[arch],
        target_settings = ["//config:toolchains_on"],
        toolchain = "@apple_support//toolchain",
        toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
    )
    for arch in APPLE_PLATFORMS_CONSTRAINTS.keys()
    for cpu in [
        "arm64",
        "x86_64",
    ]
]

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
