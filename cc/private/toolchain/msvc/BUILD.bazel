load("//cc/private/toolchain:unavailable.bzl", "cc_toolchain_unavailable")
load("//core/quality:fixtures.bzl", "real_source_target")
load(":unavailable.bzl", "UNSUPPORTED")

package(default_visibility = ["//cc/private/toolchain:__subpackages__"])

cc_toolchain_unavailable(
    name = "unsupported",
    error = UNSUPPORTED,
    tags = ["manual"],
    visibility = [
        "//cc/private/toolchain:__pkg__",
        "@dx_cc_toolchains//:__pkg__",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "layout.bzl",
        "repos.bzl",
        "extensions.bzl",
        "subject.bzl",
        "toolchain.bzl",
        "unavailable.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
    ]),
    visibility = ["//:__subpackages__"],
)
