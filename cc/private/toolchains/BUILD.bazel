# The glibc and libgcc of the pinned GCC sysroot come from the host OS, and
# libstdc++ is linked statically, so nothing ships with the app.
dx_native_runtime(
    name = "gcc_linux_glibc",
    redistribution = "os_supplied",
    source = "gcc " + GCC_VERSION + " sysroot",
    version = GCC_GLIBC.removeprefix("glibc_"),
    visibility = ["//visibility:public"],
)

# The dynamic_libstdcxx feature links against libstdc++ and libgcc_s, which
# ship next to the app and are found through its $ORIGIN rpath. They come from
# the GCC archive of the target CPU; the ARM64 one is the cross repo, which
# also builds on x86_64.
genrule(
    name = "gcc_linux_libstdcxx_libs",
    srcs = select({
        ":linux_arm64": ["@dx_gcc_linux_aarch64_cross//:lib"],
        "//conditions:default": ["@dx_gcc_linux_x86_64//:lib"],
    }),
    outs = [
        "gcc_linux_libstdcxx/libgcc_s.so.1",
        "gcc_linux_libstdcxx/libstdc++.so.6",
    ],
    cmd = """
for f in $(SRCS); do
  case "$$f" in
    */lib64/libstdc++.so.6|*/lib64/libgcc_s.so.1) cp -L "$$f" "$(RULEDIR)/gcc_linux_libstdcxx/$$(basename "$$f")" ;;
  esac
done
""",
)

genrule(
    name = "gcc_linux_libstdcxx_notice",
    srcs = [
        "notices/GCC_RUNTIME_LIBRARY_EXCEPTION.txt",
        "notices/GPL-3.txt",
    ],
    outs = ["gcc_linux_libstdcxx_NOTICE.txt"],
    cmd = "cat $(SRCS) > $@",
)

dx_native_runtime(
    name = "gcc_linux_libstdcxx",
    srcs = [":gcc_linux_libstdcxx_libs"],
    notice = ":gcc_linux_libstdcxx_notice",
    redistribution = "app_local",
    source = "gcc " + GCC_VERSION,
    version = GCC_VERSION,
    visibility = ["//visibility:public"],
)

genrule(
    name = "msvc_vcruntime_notice",
    srcs = ["notices/MSVC_REDISTRIBUTABLE.txt"],
    outs = ["msvc_vcruntime_NOTICE.txt"],
    cmd = "cp $< $@",
    visibility = ["//visibility:public"],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)

# The distributable Visual C++ runtime ships next to the app. Building it
# needs the dx_msvc license acceptance.
alias(
    name = "msvc_vcruntime",
    actual = "@dx_msvc//:msvc_vcruntime",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# The Universal CRT is part of Windows 10 and later.
dx_native_runtime(
    name = "windows_ucrt",
    provides = [
        "api-ms-win-*",
        "ucrtbase.dll",
    ],
    redistribution = "os_supplied",
    source = "Windows 10 Universal CRT",
    version = "10.0",
    visibility = ["//visibility:public"],
)

