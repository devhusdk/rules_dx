)

exports_files(
    ["notices/MSVC_REDISTRIBUTABLE.txt"],
    visibility = ["//qt/private/sdk:__pkg__"],
)

# glibc and libgcc come from the host OS and libstdc++ links statically.
dx_native_runtime(
    name = "gcc_linux_glibc",
    redistribution = "os_supplied",
    source = "gcc " + GCC_VERSION + " sysroot",
    version = GCC_GLIBC.removeprefix("glibc_"),
    visibility = ["//visibility:public"],
)

# libstdc++ and libgcc_s for dynamic_libstdcxx, shipped next to the app and found via $ORIGIN.
gcc_runtime_libs(
    name = "gcc_linux_libstdcxx_libs",
    srcs = select({
        ":linux_arm64": ["@dx_gcc_linux_aarch64_cross//:lib"],
        "//conditions:default": ["@dx_gcc_linux_x86_64//:lib"],
    }),
)

dx_native_runtime(
    name = "gcc_linux_libstdcxx",
    srcs = [":gcc_linux_libstdcxx_libs"],
    notice = "gcc_linux_libstdcxx_NOTICE.txt",
    redistribution = "app_local",
    source = "gcc " + GCC_VERSION,
    version = GCC_VERSION,
    visibility = ["//visibility:public"],
)

copy_file(
    name = "msvc_vcruntime_notice",
    src = "notices/MSVC_REDISTRIBUTABLE.txt",
    out = "msvc_vcruntime_NOTICE.txt",
    visibility = ["//visibility:public"],
)

