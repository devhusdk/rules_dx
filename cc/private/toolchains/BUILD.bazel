# Distributable Visual C++ runtime; building it needs the dx_msvc license acceptance.
alias(
    name = "msvc_vcruntime",
    actual = "@dx_msvc//:msvc_vcruntime",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# The Universal CRT is part of Windows 10 and later.
dx_native_runtime(
    name = "windows_ucrt",
    provides = [
        "api-ms-win-*",
        "ucrtbase.dll",
    ],
    redistribution = "os_supplied",
    source = "Windows 10 Universal CRT",
    version = "10.0",
    visibility = ["//visibility:public"],
)

