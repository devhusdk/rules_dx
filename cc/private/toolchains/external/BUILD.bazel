load("@rules_cc//cc:defs.bzl", "cc_toolchain")
load("@rules_dx//cc/private:wrapper_tests.bzl", "cc_external_asan_env_tests", "cc_external_coverage_tests")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//cc/private/toolchains:identity_subject.bzl", "cc_toolchain_identity_subject")
load(":fake_config.bzl", "fake_cc_toolchain_config")
load(":tests.bzl", "external_toolchain_tests")

package(default_visibility = ["//:__subpackages__"])

filegroup(name = "empty")

fake_cc_toolchain_config(
    name = "gcc_config",
    compiler = "gcc",
    target = "fake-gcc-linux-gnu",
)

fake_cc_toolchain_config(
    name = "icx_config",
    compiler = "icx",
    target = "fake-icx-linux-gnu",
)

fake_cc_toolchain_config(
    name = "msvc_cl_config",
    compiler = "msvc-cl",
    target = "x86_64-pc-windows-msvc",
)

fake_cc_toolchain_config(
    name = "clang_cl_config",
    compiler = "clang-cl",
    target = "x86_64-pc-windows-msvc",
)

fake_cc_toolchain_config(
    name = "clang_msvc_config",
    compiler = "clang",
    target = "x86_64-pc-windows-msvc",
)

fake_cc_toolchain_config(
    name = "fake_windows_cc_config",
    compiler = "msvc-cl",
    target = "x86_64-pc-windows-msvc",
    tool = "C:/fake/bin/cl.exe",
)

[
    (
        cc_toolchain(
            name = name + "_cc_toolchain",
            all_files = ":empty",
            ar_files = ":empty",
            compiler_files = ":empty",
            dwp_files = ":empty",
            linker_files = ":empty",
            objcopy_files = ":empty",
            strip_files = ":empty",
            supports_param_files = False,
            toolchain_config = ":" + name + "_config",
        ),
        toolchain(
            name = name + "_toolchain",
            exec_compatible_with = ["@platforms//os:windows"] if name == "fake_windows_cc" else [],
            target_compatible_with = ["@platforms//os:windows"] if name == "fake_windows_cc" else [],
            toolchain = ":" + name + "_cc_toolchain",
            toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
        ),
    )
    for name in [
        "clang_cl",
        "clang_msvc",
        "fake_windows_cc",
        "gcc",
        "icx",
        "msvc_cl",
    ]
]

cc_toolchain_identity_subject(
    name = "gcc_subject",
    extra_toolchains = ["//cc/private/toolchains/external:gcc_toolchain"],
)

cc_toolchain_identity_subject(
    name = "gcc_flag_subject",
    compiler = "gcc",
    extra_toolchains = ["//cc/private/toolchains/external:gcc_toolchain"],
)

cc_toolchain_identity_subject(
    name = "icx_subject",
    extra_toolchains = ["//cc/private/toolchains/external:icx_toolchain"],
)

external_toolchain_tests(name = "external")

cc_external_asan_env_tests(
    name = "asan_env_tests",
    target = "//cc/tests/fixtures/prebuilt_interop:interop_test",
)

cc_external_coverage_tests(
    name = "coverage_tests",
    target = "//cc/tests/fixtures/prebuilt_interop:interop_test",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "fake_config.bzl",
        "tests.bzl",
    ],
    tags = ["corpus"],
)
