load("@crates//:crates.bzl", "aliases")
load("@rules_dx//rust:defs.bzl", "rust_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load(":defs_tests.bzl", "cc_wrapper_contract_tests")
load(":resolved_toolchain.bzl", "APPLE_SUPPORT_TOOLCHAIN_ID", "resolved_cc_toolchain")

# gazelle:lang rust,dx_dispatch

package(default_visibility = ["//:__subpackages__"])

rust_test(
    name = "driver_policy_test",
    testonly = True,
    srcs = ["driver_policy.rs"],
    aliases = aliases(
        package_name = "cc/cc_tests",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "driver_policy_test",
    crate_root = "driver_policy.rs",
    data = [
        "//cc/tests/fixtures/copts:cxx23.cc",
        "//cc/tests/fixtures/copts:cxx23.h",
        "//cc/tests/fixtures/copts:strict.c",
        "//cc/tests/fixtures/copts:strict.h",
        "//cc/tests/fixtures/warnings:warn.c",
        "@llvm//tools:clang",
        "@llvm//tools:clang++",
        "@llvm//tools:clang-cl",
    ],
    env = {
        "DX_CLANG": "$(rootpath @llvm//tools:clang)",
        "DX_CLANGCL": "$(rootpath @llvm//tools:clang-cl)",
        "DX_CLANGXX": "$(rootpath @llvm//tools:clang++)",
    },
    tags = ["no-coverage"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = ["//cli/test_scratch:dx_test_scratch"],
)

