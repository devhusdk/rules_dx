load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "subject_compatible_with")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

cc_library(
    name = "conformance",
    srcs = ["greet.cc"],
    hdrs = ["greet.h"],
)

cc_library(
    name = "lint_dirty",
    srcs = ["lint_dirty.cc"],
    tags = ["manual"],
)

cc_library(
    name = "format_dirty",
    srcs = ["format_dirty.cc"],
    tags = ["manual"],
)

cc_binary(
    name = "hello",
    srcs = ["main.cc"],
    deps = [":conformance"],
)

cc_test(
    name = "pass_subject_test",
    size = "small",
    srcs = ["pass_test.cc"],
    linkstatic = True,
    target_compatible_with = subject_compatible_with(),
    deps = [":conformance"],
)

cc_test(
    name = "fail_subject_test",
    size = "small",
    srcs = ["fail_test.cc"],
    target_compatible_with = subject_compatible_with(),
    deps = [":conformance"],
)

cc_binary(
    name = "runfiles_hello",
    srcs = ["runfiles_main.cc"],
    data = ["data.txt"],
    deps = ["@rules_cc//cc/runfiles"],
)

dx_conformance_suite(
    name = "",
    size = "small",
    binary = ":hello",
    covered_source = "greet.cc",
    expected = "hello world",
    failing_case = "failingCase",
    failing_pattern = "{case}",
    failing_test = ":fail_subject_test",
    lang = "cc",
    passing_test = ":pass_subject_test",
    quality = {
        "clean": ":conformance",
        "format_dirty": ":format_dirty",
        "format_source": "format_dirty.cc",
        "lint_dirty": ":lint_dirty",
        "lint_line": 6,
        "lint_rule": "readability-else-after-return",
        "lint_source": "lint_dirty.cc",
    },
    runfiles = {
        "binary": ":runfiles_hello",
        "data": "data.txt",
        "expected": "hello runfiles",
    },
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
