load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rustfmt_test")
load("//tools/testing/hermetic:defs.bzl", "nested_bazel_test")

nested_bazel_test(
    name = "app_consumer_test",
    size = "enormous",
    srcs = ["app_consumer_test.rs"],
    data = [
        "app_consumer_test.rs",
        "//cli/cli:dx",
        "//examples/c-app:consumer_srcs",
        "//examples/cpp-app:consumer_srcs",
    ],
    env = {"DX_BIN": "$(rootpath //cli/cli:dx)"},
    env_inherit = [
        "HOME",
        "PATH",
    ],
    # LLVM, cJSON and fmt come from outside the BCR.
    network = True,
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [
        "//tools/testing:dx_nested",
        "//tools/testing:dx_testing",
    ],
)

rustfmt_test(
    name = "app_consumer_fmt_test",
    size = "small",
    targets = [":app_consumer_test"],
)

rust_clippy_test(
    name = "app_consumer_clippy_test",
    size = "small",
    targets = [":app_consumer_test"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//tools/docs/support_matrix:__pkg__"],
)
