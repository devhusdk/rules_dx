load("@rules_dx//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")
load("//tools/testing:hello_output.bzl", "dx_hello_output_test")
load("//tools/testing:test_macros.bzl", "CLANG_FORMAT_ARGS", "dx_format_test")

package(default_visibility = ["//cc/tests/fixtures/cpp-app:__subpackages__"])

exports_files(
    [
        "main.cc",
        "report.cc",
        "report.h",
        "report_test.cc",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "report",
    srcs = ["report.cc"],
    hdrs = ["report.h"],
    copts = ["-std=c++17"],
    deps = [
        "//cc/tests/fixtures/cpp-app/core",
        "@cpp_app_fmt//:fmt",
    ],
)

cc_binary(
    name = "pantry",
    srcs = ["main.cc"],
    copts = ["-std=c++17"],
    data = ["//cc/tests/fixtures/cpp-app/core:menu.csv"],
    local_defines = ['MENU_RLOCATION=\\"$(rlocationpath //cc/tests/fixtures/cpp-app/core:menu.csv)\\"'],
    deps = [
        ":report",
        "@rules_cc//cc/runfiles",
    ],
)

cc_test(
    name = "report_test",
    srcs = ["report_test.cc"],
    copts = ["-std=c++17"],
    data = ["//cc/tests/fixtures/cpp-app/core:menu.csv"],
    deps = [
        ":report",
        "@googletest//:gtest_main",
    ],
)

dx_hello_output_test(
    name = "pantry_output_test",
    binary = ":pantry",
    expected = """soup        starter    6.50
salad       starter    7.20
risotto        main   14.80
steak          main   23.50
tiramisu    dessert    7.90
total dessert 790
total main 3830
total starter 1370""",
)

rust_test(
    name = "exit_codes_test",
    srcs = ["exit_codes_test.rs"],
    data = [
        ":pantry",
        "//cc/tests/fixtures/cpp-app/core:bad_menu.csv",
        "//cc/tests/fixtures/cpp-app/core:menu.csv",
    ],
    env = {
        "PANTRY_BAD_MENU": "$(rootpath //cc/tests/fixtures/cpp-app/core:bad_menu.csv)",
        "PANTRY_BIN": "$(rootpath :pantry)",
        "PANTRY_MENU": "$(rootpath //cc/tests/fixtures/cpp-app/core:menu.csv)",
    },
    deps = ["//tools/testing:dx_testing"],
)

dx_format_test(
    name = "format_test",
    srcs = [
        "main.cc",
        "report.cc",
        "report.h",
        "report_test.cc",
    ],
    args = CLANG_FORMAT_ARGS,
    config = "//:.clang-format",
    tool = "@llvm//tools:clang-format",
)

filegroup(
    name = "consumer_srcs",
    srcs = glob([
        "*.cc",
        "*.h",
    ]) + [
        "BUILD.bazel",
    ],
    visibility = ["//cc/tests/fixtures/cpp-app:__pkg__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = [
        "//tools/ci:__pkg__",
    ],
)
