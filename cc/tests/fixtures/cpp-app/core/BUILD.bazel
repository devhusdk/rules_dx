load("@rules_dx//cc:defs.bzl", "cc_library", "cc_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//tools/testing:test_macros.bzl", "CLANG_FORMAT_ARGS", "dx_format_test")

package(default_visibility = ["//cc/tests/fixtures/cpp-app:__subpackages__"])

exports_files(
    [
        "VERSION",
        "bad_menu.csv",
        "group.h",
        "menu.cc",
        "menu.csv",
        "menu.h",
        "menu_test.cc",
    ],
    visibility = ["//visibility:public"],
)

genrule(
    name = "build_config_h",
    srcs = ["VERSION"],
    outs = ["build_config.h"],
    cmd = "printf 'inline constexpr int kMenuVersion = %s;\\n' \"$$(cat $<)\" > $@",
)

cc_library(
    name = "core",
    srcs = ["menu.cc"],
    hdrs = [
        "group.h",
        "menu.h",
        ":build_config_h",
    ],
    copts = ["-std=c++17"],
    data = ["menu.csv"],
)

cc_test(
    name = "menu_test",
    srcs = ["menu_test.cc"],
    copts = ["-std=c++17"],
    data = ["menu.csv"],
    deps = [
        ":core",
        "@googletest//:gtest_main",
    ],
)

dx_format_test(
    name = "format_test",
    srcs = [
        "group.h",
        "menu.cc",
        "menu.h",
        "menu_test.cc",
    ],
    args = CLANG_FORMAT_ARGS,
    config = "//:.clang-format",
    tool = "@llvm//tools:clang-format",
)

filegroup(
    name = "consumer_srcs",
    srcs = glob([
        "*.cc",
        "*.h",
        "*.csv",
    ]) + [
        "BUILD.bazel",
        "VERSION",
    ],
    visibility = ["//cc/tests/fixtures/cpp-app:__pkg__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = [
        "//tools/ci:__pkg__",
    ],
)
