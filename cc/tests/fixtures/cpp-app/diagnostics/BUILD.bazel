load("//core/quality:fixtures.bzl", "real_source_target")
load("//tools/testing:test_macros.bzl", "dx_diagnostics_test")

package(default_visibility = ["//cc/tests/fixtures/cpp-app:__subpackages__"])

dx_diagnostics_test(
    name = "diagnostics_test",
    language = "clang",
    data = [
        "clean.cc",
        "lint_error.cc",
        "modernize.cc",
        "syntax_error.cc",
        "type_error.cc",
        "unused.cc",
        "//core/quality/tiers/clang_tidy:standard.clang-tidy",
        "//core/quality/tiers/clang_tidy:strict.clang-tidy",
        "@llvm//tools:clang",
        "@llvm//tools:clang-tidy",
    ],
    env = {
        "DX_CLANG": "$(rootpath @llvm//tools:clang)",
        "DX_CLANG_TIDY": "$(rootpath @llvm//tools:clang-tidy)",
        "DX_CLEAN": "$(rootpath clean.cc)",
        "DX_LINT": "$(rootpath lint_error.cc)",
        "DX_MODERNIZE": "$(rootpath modernize.cc)",
        "DX_STD": "-std=c++17",
        "DX_STANDARD": "$(rootpath //core/quality/tiers/clang_tidy:standard.clang-tidy)",
        "DX_STRICT": "$(rootpath //core/quality/tiers/clang_tidy:strict.clang-tidy)",
        "DX_SYNTAX": "$(rootpath syntax_error.cc)",
        "DX_TIDY_STANDARD": "$(rootpath //core/quality/tiers/clang_tidy:standard.clang-tidy)",
        "DX_TYPE": "$(rootpath type_error.cc)",
        "DX_UNUSED": "$(rootpath unused.cc)",
    },
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = [
        "//tools/ci:__pkg__",
    ],
)
