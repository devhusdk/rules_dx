load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "fmt",
    srcs = ["src/format.cc"],
    hdrs = glob(["include/fmt/*.h"]),
    linkstatic = True,
    copts = ["-std=c++17"],
    defines = select({
        "@platforms//os:windows": ["FMT_UNICODE=0"],
        "//conditions:default": [],
    }),
    features = ["-treat_warnings_as_errors"],
    includes = ["include"],
    visibility = ["//visibility:public"],
)
