load("//core/quality:fixtures.bzl", "real_source_target")
load("//cc/private/toolchains:identity_subject.bzl", "cc_toolchain_identity_subject")
load("//cc/private/toolchains:select.bzl", "cc_toolchain_test")
load(":identity.bzl", "custom_gcc_identity_test")

package(default_visibility = ["//:__subpackages__"])

_LINUX_X86_64 = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

toolchain(
    name = "custom_gcc_x86_64",
    exec_compatible_with = _LINUX_X86_64,
    target_compatible_with = _LINUX_X86_64,
    toolchain = "@custom_gcc_x86_64//:_cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

cc_toolchain_identity_subject(
    name = "custom_gcc_subject",
    extra_toolchains = ["//cc/tests/fixtures/custom_gcc:custom_gcc_x86_64"],
)

custom_gcc_identity_test(
    name = "custom_gcc_identity",
    size = "small",
)

cc_toolchain_test(
    name = "custom_gcc_hello_test",
    compiler = "gcc",
    size = "small",
    extra_toolchains = ["//cc/tests/fixtures/custom_gcc:custom_gcc_x86_64"],
    target_compatible_with = _LINUX_X86_64,
    test = "//cc/tests/fixtures/hello:hello_private_header_test",
)

test_suite(
    name = "custom_gcc",
    tests = [
        ":custom_gcc_hello_test",
        ":custom_gcc_identity",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "identity.bzl",
    ],
    tags = ["corpus"],
)
