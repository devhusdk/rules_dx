load("@rules_dx//cc:defs.bzl", "cc_test")
load("@rules_dx//cc/private/toolchains:select.bzl", "cc_toolchain_files")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")
load(
    ":failure_tests.bzl",
    "cmake_toolchain_present_test",
    "cmake_toolchain_probe",
    "missing_cmake_toolchain_test",
    "unknown_generator_test",
)
load(":transition.bzl", "arm64_files", "wrong_arch_link")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

_THIRD_PARTY = [
    "no-audit",
    "no-coverage",
    "no-format",
    "no-lint",
    "no-typecheck",
]

_LINUX_X86_64 = [
    "@platforms//cpu:x86_64",
    "@platforms//os:linux",
]

cmake(
    name = "zlib_static",
    build_args = ["--verbose"],
    cache_entries = {"CMAKE_C_FLAGS": "-DDX_FOREIGN_CMAKE_FLAG=1"},
    generate_args = ["-GNinja"],
    lib_source = "@foreign_cmake_zlib//:all_srcs",
    out_static_libs = ["libz.a"],
    tags = _THIRD_PARTY,
    target_compatible_with = _LINUX_X86_64,
)

cmake(
    name = "zlib_shared",
    build_args = ["--verbose"],
    cache_entries = {"CMAKE_C_FLAGS": "-DDX_FOREIGN_CMAKE_FLAG=1"},
    generate_args = ["-GNinja"],
    lib_source = "@foreign_cmake_zlib//:all_srcs",
    out_shared_libs = ["libz.so.1"],
    tags = _THIRD_PARTY,
    target_compatible_with = _LINUX_X86_64,
)

cmake(
    name = "zlib_arm64",
    build_args = ["--verbose"],
    generate_args = [
        "-GNinja",
        "--trace-expand",
    ],
    lib_source = "@foreign_cmake_zlib//:all_srcs",
    out_static_libs = ["libz.a"],
    tags = _THIRD_PARTY,
)

arm64_files(
    name = "zlib_arm64_log",
    srcs = [":zlib_arm64"],
    tags = _THIRD_PARTY,
)

wrong_arch_link(
    name = "zlib_arm64_wrong_arch_link",
    lib = ":zlib_arm64",
    tags = _THIRD_PARTY,
    target_compatible_with = _LINUX_X86_64,
)

cc_test(
    name = "zlib_static_test",
    srcs = ["zlib_test.cc"],
    tags = _THIRD_PARTY,
    target_compatible_with = _LINUX_X86_64,
    deps = [":zlib_static"],
)

cc_test(
    name = "zlib_shared_test",
    srcs = ["zlib_test.cc"],
    tags = _THIRD_PARTY,
    target_compatible_with = _LINUX_X86_64,
    deps = [":zlib_shared"],
)

filegroup(
    name = "zlib_log",
    srcs = [":zlib_static"],
    output_group = "CMake_logs",
    tags = _THIRD_PARTY,
    target_compatible_with = _LINUX_X86_64,
)

filegroup(
    name = "zlib_include",
    srcs = [":zlib_static"],
    output_group = "include",
    tags = _THIRD_PARTY,
    target_compatible_with = _LINUX_X86_64,
)

_MSVC_NO_WX = {
    "CMAKE_EXE_LINKER_FLAGS": "/WX:NO",
    "CMAKE_SHARED_LINKER_FLAGS": "/WX:NO",
    "CMAKE_STATIC_LINKER_FLAGS": "/WX:NO",
}

_WINDOWS_X86_64 = [
    "@platforms//cpu:x86_64",
    "@platforms//os:windows",
]

cmake(
    name = "zlib_msvc_static",
    build_args = ["--verbose"],
    cache_entries = _MSVC_NO_WX,
    generate_args = [
        "-GNinja",
        "--trace-expand",
    ],
    lib_source = "@foreign_cmake_zlib//:all_srcs",
    out_static_libs = ["zlibstatic.lib"],
    tags = _THIRD_PARTY,
    target_compatible_with = _WINDOWS_X86_64,
)

cmake(
    name = "zlib_msvc_shared",
    build_args = ["--verbose"],
    cache_entries = _MSVC_NO_WX,
    generate_args = ["-GNinja"],
    lib_source = "@foreign_cmake_zlib//:all_srcs",
    out_interface_libs = ["zlib.lib"],
    out_shared_libs = ["zlib.dll"],
    tags = _THIRD_PARTY,
    target_compatible_with = _WINDOWS_X86_64,
)

cc_test(
    name = "zlib_msvc_static_test",
    srcs = ["zlib_test.cc"],
    tags = _THIRD_PARTY,
    target_compatible_with = _WINDOWS_X86_64,
    deps = [":zlib_msvc_static"],
)

cc_test(
    name = "zlib_msvc_shared_test",
    srcs = ["zlib_test.cc"],
    tags = _THIRD_PARTY,
    target_compatible_with = _WINDOWS_X86_64,
    deps = [":zlib_msvc_shared"],
)

filegroup(
    name = "zlib_msvc_log",
    srcs = [":zlib_msvc_static"],
    output_group = "CMake_logs",
    tags = _THIRD_PARTY,
    target_compatible_with = _WINDOWS_X86_64,
)

platform(
    name = "linux_x86_64",
    constraint_values = _LINUX_X86_64,
)

cc_toolchain_files(
    name = "zlib_log_gcc",
    srcs = [":zlib_log"],
    compiler = "gcc",
    platforms = ["//cc/tests/fixtures/foreign_cmake:linux_x86_64"],
    tags = _THIRD_PARTY,
    target_compatible_with = _LINUX_X86_64,
)

genrule(
    name = "zlib_log_gcc_copy",
    srcs = [":zlib_log_gcc"],
    outs = ["gcc_configure.log"],
    cmd = "for f in $(locations :zlib_log_gcc); do case $$f in *CMake.log) cp $$f $@;; esac; done",
    tags = _THIRD_PARTY,
    target_compatible_with = _LINUX_X86_64,
)

cmake(
    name = "zlib_bogus_generator",
    generate_args = ["-GBogus"],
    lib_source = "@foreign_cmake_zlib//:all_srcs",
    out_static_libs = ["libz.a"],
    tags = _THIRD_PARTY + ["manual"],
    target_compatible_with = _LINUX_X86_64,
)

unknown_generator_test(
    name = "unknown_generator_test",
    size = "small",
    target_under_test = ":zlib_bogus_generator",
    target_compatible_with = _LINUX_X86_64,
)

platform(
    name = "linux_riscv64_exec",
    constraint_values = [
        "@platforms//cpu:riscv64",
        "@platforms//os:linux",
    ],
)

cmake_toolchain_probe(
    name = "cmake_probe",
    tags = _THIRD_PARTY,
)

cmake_toolchain_probe(
    name = "cmake_probe_riscv64",
    exec_compatible_with = ["@platforms//cpu:riscv64"],
    tags = _THIRD_PARTY + ["manual"],
)

cmake_toolchain_present_test(
    name = "cmake_toolchain_present_test",
    size = "small",
    target_under_test = ":cmake_probe",
    target_compatible_with = _LINUX_X86_64,
)

missing_cmake_toolchain_test(
    name = "missing_cmake_toolchain_test",
    size = "small",
    target_under_test = ":cmake_probe_riscv64",
    target_compatible_with = _LINUX_X86_64,
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
