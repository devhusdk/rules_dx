load("//cc:defs.bzl", "cc_library", "cc_test")
load("//cc/private/toolchains:select.bzl", "cc_gcov_fixture")
load("//core/quality:fixtures.bzl", "real_source_target")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

_GCC_ONLY = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

cc_library(
    name = "lib",
    srcs = ["lib.c"],
    hdrs = ["lib.h"],
    tags = ["manual"],
    target_compatible_with = _GCC_ONLY,
)

cc_test(
    name = "main_test",
    srcs = ["main.cc"],
    tags = ["manual"],
    target_compatible_with = _GCC_ONLY,
    deps = [":lib"],
)

cc_library(
    name = "lib_alt",
    srcs = ["lib.c"],
    hdrs = ["lib.h"],
    copts = ["-DALT_BUILD"],
    tags = ["manual"],
    target_compatible_with = _GCC_ONLY,
)

cc_test(
    name = "main_alt_test",
    srcs = ["main.cc"],
    tags = ["manual"],
    target_compatible_with = _GCC_ONLY,
    deps = [":lib_alt"],
)

cc_gcov_fixture(
    name = "gcov_fixture",
    tags = ["manual"],
    libraries = ["//cc/tests/fixtures/gcc_shared:greet"],
    target_compatible_with = _GCC_ONLY,
    tests = [
        ":main_test",
        "//cc/tests/fixtures/gcc_shared:shared_test",
    ],
)

cc_gcov_fixture(
    name = "gcov_fixture_alt",
    tags = ["manual"],
    target_compatible_with = _GCC_ONLY,
    tests = [":main_alt_test"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
