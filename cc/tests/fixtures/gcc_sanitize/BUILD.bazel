load("//cc/rules:defs.bzl", "cc_test")
load("//cc/rules:wrapper_tests.bzl", "cc_gcc_asan_env_tests")
load("//quality:fixtures.bzl", "real_source_target")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

_GCC_ONLY = [
    "@platforms//os:linux",
] + select({
    "@platforms//cpu:arm64": [],
    "@platforms//cpu:x86_64": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

cc_test(
    name = "asan_test",
    srcs = ["sanitize_test.cc"],
    local_defines = ["DX_EXPECT_ASAN"],
    tags = ["manual"],
    target_compatible_with = _GCC_ONLY,
)

cc_test(
    name = "asan_env_override_test",
    srcs = ["sanitize_test.cc"],
    env = {"ASAN_OPTIONS": "detect_leaks=0"},
    local_defines = ["DX_EXPECT_ASAN"],
    tags = ["manual"],
    target_compatible_with = _GCC_ONLY,
)

cc_gcc_asan_env_tests(
    name = "asan_default_env_tests",
    expect = "verify_asan_link_order=0",
    target = ":asan_test",
    target_compatible_with = _GCC_ONLY,
)

cc_gcc_asan_env_tests(
    name = "asan_override_env_tests",
    expect = "detect_leaks=0",
    expect_llvm = "detect_leaks=0",
    target = ":asan_env_override_test",
    target_compatible_with = _GCC_ONLY,
)

cc_test(
    name = "ubsan_test",
    srcs = ["sanitize_test.cc"],
    copts = ["-fno-sanitize-recover=undefined"],
    tags = ["manual"],
    target_compatible_with = _GCC_ONLY,
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
