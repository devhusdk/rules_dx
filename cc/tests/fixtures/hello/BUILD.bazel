load("//cc/rules:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//cc/rules:wrapper_tests.bzl", "cc_coverage_env_tests")
load("//libs/starlark/tests:direct_sources.bzl", "dx_direct_sources_test")
load("//libs/starlark/tests:thin_compare.bzl", "run_env_compare_subject", "thin_compare_cc_env_tests", "thin_compare_cc_tests", "thin_compare_subject")
load("//quality:fixtures.bzl", "real_source_target")
load("//tools/testing:hello_output.bzl", "dx_hello_output_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

cc_library(
    name = "hello_lib",
    srcs = ["hello.cc"],
    hdrs = ["hello.h"],
)

cc_binary(
    name = "hello",
    srcs = ["main.cc"],
    deps = [":hello_lib"],
)

cc_test(
    name = "hello_test",
    srcs = ["hello_test.cc"],
    env = {"DX_HELLO_ENV": "1"},
    env_inherit = ["HOME"],
    deps = [":hello_lib"],
)

cc_test(
    name = "hello_private_header_test",
    srcs = [
        "private_header_test.cc",
        "private_helper.h",
    ],
)

dx_direct_sources_test(
    name = "private_header_sources_test",
    expected = {
        "c": ["private_helper.h"],
        "cpp": ["private_header_test.cc"],
    },
    target_under_test = ":hello_private_header_test",
)

cc_library(
    name = "hello_c_lib",
    srcs = ["hello.c"],
    hdrs = ["hello_c.h"],
)

cc_test(
    name = "hello_c_test",
    srcs = ["hello_c_test.c"],
    deps = [":hello_c_lib"],
)

cc_coverage_env_tests(
    name = "coverage_env_test",
    target = ":hello_c_test",
)

dx_hello_output_test(
    name = "hello_output_test",
    binary = ":hello",
    expected = "hello 42",
)

thin_compare_subject(
    name = "thin_cc_subject",
    kind = "cc_library",
    thin = ":hello_lib_upstream",
    wrapper = ":hello_lib",
)

thin_compare_cc_tests(name = "thin_cc_test")

run_env_compare_subject(
    name = "thin_cc_env_subject",
    thin = ":hello_test_upstream",
    wrapper = ":hello_test",
)

thin_compare_cc_env_tests(name = "thin_cc_env_test")

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
