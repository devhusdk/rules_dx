load("//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//cc/private:wrapper_tests.bzl", "cc_build_id_test", "cc_coverage_env_tests", "cc_macos_no_dylib_test", "cc_macos_static_link_test", "cc_windows_static_link_test")
load("//cc/private/toolchains:action_tests.bzl", "cc_action_tests")
load("//core/tests:direct_sources.bzl", "dx_direct_sources_test")
load("//core/tests:thin_compare.bzl", "run_env_compare_subject", "thin_compare_cc_env_tests", "thin_compare_cc_tests", "thin_compare_subject")
load("//quality:fixtures.bzl", "real_source_target")
load("//tools/testing:hello_output.bzl", "dx_hello_output_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

cc_library(
    name = "hello_lib",
    srcs = ["hello.cc"],
    hdrs = ["hello.h"],
)

cc_binary(
    name = "hello",
    srcs = ["main.cc"],
    visibility = ["//visibility:public"],
    deps = [":hello_lib"],
)

cc_library(
    name = "hello_main_lib",
    srcs = ["main.cc"],
    deps = [":hello_lib"],
)

cc_binary(
    name = "hello_main_in_dep",
    deps = [":hello_main_lib"],
)

cc_binary(
    name = "hello_linkopts_none",
    srcs = ["main.cc"],
    linkopts = None,
    deps = [":hello_lib"],
)

cc_binary(
    name = "hello_linkopts_lm",
    srcs = ["main.cc"],
    linkopts = ["-lm"],
    deps = [":hello_lib"],
)

cc_test(
    name = "hello_test",
    srcs = ["hello_test.cc"],
    env = {"DX_HELLO_ENV": "1"},
    env_inherit = ["HOME"],
    deps = [":hello_lib"],
)

cc_test(
    name = "hello_private_header_test",
    srcs = [
        "private_header_test.cc",
        "private_helper.h",
    ],
)

dx_direct_sources_test(
    name = "private_header_sources_test",
    expected = {
        "c": ["private_helper.h"],
        "cpp": ["private_header_test.cc"],
    },
    target_under_test = ":hello_private_header_test",
)

cc_library(
    name = "hello_c_lib",
    srcs = ["hello.c"],
    hdrs = ["hello_c.h"],
)

cc_test(
    name = "hello_c_test",
    srcs = ["hello_c_test.c"],
    deps = [":hello_c_lib"],
)

cc_macos_no_dylib_test(
    name = "macos_no_dylib_test",
    target = ":hello_c_lib_upstream",
)

cc_macos_static_link_test(
    name = "macos_static_link_test",
    target = ":hello_c_test_upstream",
)

cc_windows_static_link_test(
    name = "windows_static_link_test",
    target = ":hello_c_test_upstream",
)

cc_coverage_env_tests(
    name = "coverage_env_test",
    target = ":hello_c_test",
)

cc_action_tests(
    name = "toolchain_action_tests",
    compile_target = ":hello_c_lib_upstream",
    link_target = ":hello_upstream",
)

cc_build_id_test(
    name = "build_id_test",
    target = ":hello_upstream",
)

cc_build_id_test(
    name = "build_id_linkopts_none_test",
    target = ":hello_linkopts_none_upstream",
)

cc_build_id_test(
    name = "build_id_linkopts_lm_test",
    target = ":hello_linkopts_lm_upstream",
)

dx_hello_output_test(
    name = "hello_output_test",
    binary = ":hello",
    expected = "hello 42",
)

dx_hello_output_test(
    name = "hello_main_in_dep_output_test",
    binary = ":hello_main_in_dep",
    expected = "hello 42",
)

thin_compare_subject(
    name = "thin_cc_subject",
    kind = "cc_library",
    thin = ":hello_lib_upstream",
    wrapper = ":hello_lib",
)

thin_compare_cc_tests(name = "thin_cc_test")

run_env_compare_subject(
    name = "thin_cc_env_subject",
    thin = ":hello_test_upstream",
    wrapper = ":hello_test",
)

thin_compare_cc_env_tests(name = "thin_cc_env_test")

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//tools/docs/support_matrix:__pkg__"],
)
