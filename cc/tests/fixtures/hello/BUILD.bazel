load("//cc/rules:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//tools/testing:hello_output.bzl", "dx_hello_output_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

cc_library(
    name = "hello_lib",
    srcs = ["hello.cc"],
    hdrs = ["hello.h"],
)

cc_binary(
    name = "hello",
    srcs = ["main.cc"],
    deps = [":hello_lib"],
)

cc_test(
    name = "hello_test",
    srcs = ["hello_test.cc"],
    deps = [":hello_lib"],
)

cc_library(
    name = "hello_c_lib",
    srcs = ["hello.c"],
    hdrs = ["hello_c.h"],
)

cc_test(
    name = "hello_c_test",
    srcs = ["hello_c_test.c"],
    deps = [":hello_c_lib"],
)

dx_hello_output_test(
    name = "hello_output_test",
    binary = ":hello",
    expected = "hello 42",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
