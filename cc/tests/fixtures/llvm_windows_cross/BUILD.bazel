load("//cc/private/toolchain:select.bzl", "cc_toolchain_binary", "cc_toolchain_files")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")

package(default_testonly = True)

_LANGS = [
    "cc",
    "go",
    "rust",
    "zig",
]

_LINUX_X86_64 = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

[
    cc_toolchain_files(
        name = lang,
        srcs = ["//%s/tests/conformance:hello" % lang],
        compiler = "llvm",
        platforms = ["//tools/platforms:windows_x86_64"],
        target_compatible_with = _LINUX_X86_64,
    )
    for lang in _LANGS
]

cc_toolchain_binary(
    name = "rust_opt",
    binary = "//rust/tests/conformance:hello",
    compilation_mode = "opt",
    compiler = "llvm",
    platforms = ["//tools/platforms:windows_x86_64"],
    target_compatible_with = _LINUX_X86_64,
)

[
    rust_test(
        name = lang + "_test",
        size = "small",
        srcs = [
            "//tools/testing/conformance:cross_test.rs",
            "//tools/testing/conformance:runfiles_manifest.rs",
        ],
        crate_root = "//tools/testing/conformance:cross_test.rs",
        data = [":" + lang],
        env = {
            "DX_CONFORMANCE_SUBJECT": "$(rlocationpaths :%s)" % lang,
            "DX_CONFORMANCE_TEXT": "windows_x86_64",
        },
        target_compatible_with = _LINUX_X86_64,
        deps = [
            "//tools/testing:dx_testing",
            "//tools/testing/image:dx_testing_image",
            "//tools/testing/msix:dx_testing_msix",
        ],
    )
    for lang in _LANGS + ["rust_opt"]
]

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
