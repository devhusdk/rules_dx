load("//cc/rules:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//cc/rules:probe.bzl", "dx_cc_wrapper_subject")
load("//libs/starlark:defs.bzl", "starlark_test")
load("//quality:fixtures.bzl", "real_source_target")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

cc_library(
    name = "greet_lib",
    srcs = ["greet.cc"],
    hdrs = ["greet.h"],
)

cc_binary(
    name = "greet",
    srcs = ["greet_main.cc"],
    hdrs = ["greet.h"],
    deps = [":greet_lib"],
)

cc_test(
    name = "greet_test",
    srcs = ["greet_test.cc"],
    hdrs = ["greet.h"],
    deps = [":greet_lib"],
)

cc_test(
    name = "public_test_attrs_test",
    size = "large",
    timeout = "moderate",
    srcs = ["public_test_attrs.c"],
    env = {
        "DX_PUBLIC_TEST_ENV": "declared-value",
    },
    flaky = True,
    shard_count = 2,
)

cc_test(
    name = "manual_test",
    srcs = ["manual_test.c"],
    tags = ["manual"],
)

dx_cc_wrapper_subject(
    name = "greet_subject",
    upstream = ":greet_upstream",
    wrapper = ":greet",
)

dx_cc_wrapper_subject(
    name = "greet_test_subject",
    upstream = ":greet_test_upstream",
    wrapper = ":greet_test",
)

dx_cc_wrapper_subject(
    name = "public_test_attrs_subject",
    upstream = ":public_test_attrs_test_upstream",
    wrapper = ":public_test_attrs_test",
)

dx_cc_wrapper_subject(
    name = "manual_test_subject",
    upstream = ":manual_test_upstream",
    wrapper = ":manual_test",
)

