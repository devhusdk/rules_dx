load("//cc:defs.bzl", "cc_binary")
load("//cc/private/toolchains:select.bzl", "cc_toolchain_files")
load("//core/quality:fixtures.bzl", "real_source_target")

package(default_testonly = True)

cc_binary(
    name = "hello_c",
    srcs = ["hello_c.c"],
)

cc_toolchain_files(
    name = "gcc_arm64",
    srcs = [
        ":hello_c",
        "//cc/tests/fixtures/hello",
        "//rust/tests/fixtures/native_call:native_call_bin",
    ],
    compiler = "gcc",
    platforms = ["//tools/platforms:linux_arm64"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
