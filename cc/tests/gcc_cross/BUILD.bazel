load("//cc/rules:defs.bzl", "cc_binary")
load("//cc/toolchains:select.bzl", "cc_toolchain_files")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")

package(default_testonly = True)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

cc_binary(
    name = "hello_c",
    srcs = ["hello_c.c"],
)

cc_toolchain_files(
    name = "gcc_arm64",
    srcs = [
        "//cc/tests/fixtures/hello:hello",
        ":hello_c",
        "//rust/tests/fixtures/native_call:native_call_bin",
    ],
    compiler = "gcc",
    platforms = ["//cc/tests/gcc_cross:linux_arm64"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

rust_test(
    name = "cross_arm64_test",
    srcs = ["cross_arm64_test.rs"],
    data = [":gcc_arm64"],
    env = {"GCC_ARM64": "$(rootpaths :gcc_arm64)"},
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = ["//tools/testing:dx_testing"],
)

rustfmt_test(
    name = "cross_arm64_fmt_test",
    targets = [":cross_arm64_test"],
)

rust_clippy_test(
    name = "cross_arm64_clippy_test",
    targets = [":cross_arm64_test"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
