load("@crates//:crates.bzl", "aliases")
load("//cc:defs.bzl", "cc_binary")
load("//cc/private/toolchains:select.bzl", "cc_toolchain_files")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")

package(default_testonly = True)

cc_binary(
    name = "hello_c",
    srcs = ["hello_c.c"],
)

cc_toolchain_files(
    name = "gcc_arm64",
    srcs = [
        ":hello_c",
        "//cc/tests/fixtures/hello",
        "//rust/tests/fixtures/native_call:native_call_bin",
    ],
    compiler = "gcc",
    platforms = ["//tools/platforms:linux_arm64"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

rust_test(
    name = "cross_arm64_test",
    testonly = True,
    srcs = ["cross_arm64_test.rs"],
    aliases = aliases(
        package_name = "cc/tests/cc_tests_gcc_cross",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "cross_arm64_test",
    crate_root = "cross_arm64_test.rs",
    data = [":gcc_arm64"],
    env = {"GCC_ARM64": "$(rootpaths :gcc_arm64)"},
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = ["//tools/testing:dx_testing"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    testonly = True,
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
