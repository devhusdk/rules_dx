load("//cc/rules:defs.bzl", "cc_binary")
load("//cc/toolchains:select.bzl", "cc_toolchain_binary")
load("//deploy/rules:archive.bzl", "consumer_archive")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_test")

package(default_testonly = True)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

cc_binary(
    name = "hello_c",
    srcs = ["hello_c.c"],
)

cc_toolchain_binary(
    name = "hello_gcc",
    binary = ":hello_c",
    compiler = "gcc",
    platforms = ["//cc/tests/gcc_linux_arm64:linux_arm64"],
)

consumer_archive(
    name = "hello_gcc_release",
    app = ":hello_gcc",
    min_runtime = "glibc-2.28",
    notice = "//deploy/tests/fixtures/consumer_archive:consumer_notice_files",
    platform = ":linux_arm64",
    runtime = ["//cc/toolchains:gcc_linux_glibc"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)

cc_binary(
    name = "hello_cxx",
    srcs = ["hello_cxx.cc"],
    linkstatic = False,
)

cc_toolchain_binary(
    name = "hello_cxx_gcc",
    binary = ":hello_cxx",
    compiler = "gcc",
    extra_features = ["dynamic_libstdcxx"],
    platforms = ["//cc/tests/gcc_linux_arm64:linux_arm64"],
)

consumer_archive(
    name = "hello_cxx_release",
    app = ":hello_cxx_gcc",
    min_runtime = "glibc-2.28",
    notice = "//deploy/tests/fixtures/consumer_archive:consumer_notice_files",
    platform = ":linux_arm64",
    runtime = [
        "//cc/toolchains:gcc_linux_glibc",
        "//cc/toolchains:gcc_linux_libstdcxx",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)

rust_test(
    name = "libstdcxx_archive_test",
    srcs = ["libstdcxx_archive_test.rs"],
    data = [":hello_cxx_release"],
    env = {"ARCHIVE": "$(rootpath :hello_cxx_release)"},
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    deps = [
        "//deploy/rules:dx_deploy_tools",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "archive_test",
    srcs = ["archive_test.rs"],
    data = [":hello_gcc_release"],
    env = {"ARCHIVE": "$(rootpath :hello_gcc_release)"},
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    deps = [
        "//deploy/rules:dx_deploy_tools",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "native_arm64_test",
    srcs = ["native_arm64_test.rs"],
    data = [":hello_gcc"],
    env = {"APP": "$(rootpath :hello_gcc)"},
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    deps = ["//tools/testing:dx_testing"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

test_suite(
    name = "all",
    tests = [
        ":archive_test",
        ":libstdcxx_archive_test",
        ":native_arm64_test",
    ],
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//tools/docs/support_matrix:__pkg__"],
)
