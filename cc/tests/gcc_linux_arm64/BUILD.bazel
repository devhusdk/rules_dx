load("//cc/rules:defs.bzl", "cc_binary")
load("//cc/toolchains:select.bzl", "cc_toolchain_binary")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")

package(default_testonly = True)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

cc_binary(
    name = "hello_c",
    srcs = ["hello_c.c"],
)

cc_toolchain_binary(
    name = "hello_gcc",
    binary = ":hello_c",
    compiler = "gcc",
    platforms = ["//cc/tests/gcc_linux_arm64:linux_arm64"],
)

rust_test(
    name = "native_arm64_test",
    srcs = ["native_arm64_test.rs"],
    data = [":hello_gcc"],
    env = {"APP": "$(rootpath :hello_gcc)"},
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    deps = ["//tools/testing:dx_testing"],
)

rustfmt_test(
    name = "native_arm64_fmt_test",
    targets = [":native_arm64_test"],
)

rust_clippy_test(
    name = "native_arm64_clippy_test",
    targets = [":native_arm64_test"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
