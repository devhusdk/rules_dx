load("@crates//:crates.bzl", "aliases")
load("//cc:defs.bzl", "cc_binary")
load("//cc/private/toolchains:select.bzl", "cc_toolchain_binary")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//deploy:defs.bzl", "consumer_archive")
load("//rust:defs.bzl", "rust_test")

package(default_testonly = True)

cc_binary(
    name = "hello_c",
    srcs = ["hello_c.c"],
)

cc_toolchain_binary(
    name = "hello_gcc",
    binary = ":hello_c",
    compiler = "gcc",
    platforms = ["//tools/platforms:linux_arm64"],
)

consumer_archive(
    name = "hello_gcc_release",
    app = ":hello_gcc",
    min_runtime = "glibc-2.28",
    notice = "//deploy/tests/fixtures/consumer_archive:consumer_notice_files",
    platform = "//tools/platforms:linux_arm64",
    runtime = ["//cc/private/toolchains:gcc_linux_glibc"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)

cc_binary(
    name = "hello_cxx",
    srcs = ["hello_cxx.cc"],
    linkstatic = False,
)

cc_toolchain_binary(
    name = "hello_cxx_gcc",
    binary = ":hello_cxx",
    compiler = "gcc",
    extra_features = ["dynamic_libstdcxx"],
    platforms = ["//tools/platforms:linux_arm64"],
)

consumer_archive(
    name = "hello_cxx_release",
    app = ":hello_cxx_gcc",
    min_runtime = "glibc-2.28",
    notice = "//deploy/tests/fixtures/consumer_archive:consumer_notice_files",
    platform = "//tools/platforms:linux_arm64",
    runtime = [
        "//cc/private/toolchains:gcc_linux_glibc",
        "//cc/private/toolchains:gcc_linux_libstdcxx",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)

rust_test(
    name = "libstdcxx_archive_test",
    size = "small",
    testonly = True,
    srcs = ["libstdcxx_archive_test.rs"],
    aliases = aliases(
        package_name = "cc/tests/cc_tests_gcc_linux_arm64",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "libstdcxx_archive_test",
    crate_root = "libstdcxx_archive_test.rs",
    data = [":hello_cxx_release"],
    env = {"ARCHIVE": "$(rootpath :hello_cxx_release)"},
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//deploy/private:dx_deploy_tools",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "archive_test",
    size = "small",
    testonly = True,
    srcs = ["archive_test.rs"],
    aliases = aliases(
        package_name = "cc/tests/cc_tests_gcc_linux_arm64",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "archive_test",
    crate_root = "archive_test.rs",
    data = [":hello_gcc_release"],
    env = {"ARCHIVE": "$(rootpath :hello_gcc_release)"},
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//deploy/private:dx_deploy_tools",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "native_arm64_test",
    size = "small",
    testonly = True,
    srcs = ["native_arm64_test.rs"],
    aliases = aliases(
        package_name = "cc/tests/cc_tests_gcc_linux_arm64",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "native_arm64_test",
    crate_root = "native_arm64_test.rs",
    data = [":hello_gcc"],
    env = {"APP": "$(rootpath :hello_gcc)"},
    tags = ["row:cc_gcc"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    deps = ["//tools/testing:dx_testing"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    testonly = True,
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

test_suite(
    name = "all",
    tests = [
        ":archive_test",
        ":libstdcxx_archive_test",
        ":native_arm64_test",
    ],
)
