load("//cc/rules:defs.bzl", "cc_binary")
load("//cc/toolchains:select.bzl", "cc_toolchain_files")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")

package(default_testonly = True)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

cc_binary(
    name = "hello_c",
    srcs = ["hello_c.c"],
)

cc_toolchain_files(
    name = "gcc_x86_64",
    srcs = [
        ":hello_c",
        "//cc/tests/fixtures/gcc_shared:greet_shared",
        "//cc/tests/fixtures/hello:hello",
    ],
    compiler = "gcc",
    platforms = ["//cc/tests/gcc_linux_x86_64:linux_x86_64"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

rust_test(
    name = "artifacts_test",
    srcs = ["artifacts_test.rs"],
    data = [
        ":gcc_x86_64",
        "//cc/toolchains:pins.bzl",
    ],
    env = {
        "GCC_X86_64": "$(rootpaths :gcc_x86_64)",
        "PINS": "$(rootpath //cc/toolchains:pins.bzl)",
    },
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = ["//tools/testing:dx_testing"],
)

rustfmt_test(
    name = "artifacts_fmt_test",
    targets = [":artifacts_test"],
)

rust_clippy_test(
    name = "artifacts_clippy_test",
    targets = [":artifacts_test"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

test_suite(
    name = "all",
    tests = [
        ":artifacts_clippy_test",
        ":artifacts_fmt_test",
        ":artifacts_test",
    ],
)
