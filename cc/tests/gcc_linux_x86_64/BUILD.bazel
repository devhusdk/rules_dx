load("@crates//:crates.bzl", "aliases")
load("//cc:defs.bzl", "cc_binary")
load("//cc/private/toolchains:pins.bzl", "GCC_VERSION")
load("//cc/private/toolchains:select.bzl", "cc_toolchain_binary", "cc_toolchain_files")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//deploy:defs.bzl", "consumer_archive")
load("//rust:defs.bzl", "rust_test")

package(default_testonly = True)

cc_binary(
    name = "hello_c",
    srcs = ["hello_c.c"],
)

cc_toolchain_files(
    name = "gcc_x86_64",
    srcs = [
        ":hello_c",
        "//cc/tests/fixtures/hello",
        "//cc/tests/fixtures/shared:greet_shared",
    ],
    compiler = "gcc",
    platforms = ["//tools/platforms:linux_x86_64"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

cc_toolchain_binary(
    name = "hello_gcc",
    binary = ":hello_c",
    compiler = "gcc",
    platforms = ["//tools/platforms:linux_x86_64"],
)

consumer_archive(
    name = "hello_gcc_release",
    app = ":hello_gcc",
    min_runtime = "glibc-2.28",
    notice = "//deploy/tests/fixtures/consumer_archive:consumer_notice_files",
    platform = "//tools/platforms:linux_x86_64",
    runtime = ["//cc/private/toolchains:gcc_linux_glibc"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

cc_binary(
    name = "hello_cxx",
    srcs = ["hello_cxx.cc"],
    linkstatic = False,
)

cc_toolchain_binary(
    name = "hello_cxx_gcc",
    binary = ":hello_cxx",
    compiler = "gcc",
    extra_features = ["dynamic_libstdcxx"],
    platforms = ["//tools/platforms:linux_x86_64"],
)

consumer_archive(
    name = "hello_cxx_release",
    app = ":hello_cxx_gcc",
    min_runtime = "glibc-2.28",
    notice = "//deploy/tests/fixtures/consumer_archive:consumer_notice_files",
    platform = "//tools/platforms:linux_x86_64",
    runtime = [
        "//cc/private/toolchains:gcc_linux_glibc",
        "//cc/private/toolchains:gcc_linux_libstdcxx",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

rust_test(
    name = "libstdcxx_archive_test",
    testonly = True,
    srcs = ["libstdcxx_archive_test.rs"],
    aliases = aliases(
        package_name = "cc/tests/cc_tests_gcc_linux_x86_64",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "libstdcxx_archive_test",
    crate_root = "libstdcxx_archive_test.rs",
    data = [":hello_cxx_release"],
    env = {"ARCHIVE": "$(rootpath :hello_cxx_release)"},
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//deploy/private:dx_deploy_tools",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "imports_test",
    testonly = True,
    srcs = ["imports_test.rs"],
    aliases = aliases(
        package_name = "cc/tests/cc_tests_gcc_linux_x86_64",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "imports_test",
    crate_root = "imports_test.rs",
    data = [
        ":hello_cxx_gcc",
        "//deploy/private:archiver",
    ],
    env = {
        "APP": "$(rootpath :hello_cxx_gcc)",
        "ARCHIVER": "$(rootpath //deploy/private:archiver)",
    },
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "archive_test",
    testonly = True,
    srcs = ["archive_test.rs"],
    aliases = aliases(
        package_name = "cc/tests/cc_tests_gcc_linux_x86_64",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "archive_test",
    crate_root = "archive_test.rs",
    data = [":hello_gcc_release"],
    env = {"ARCHIVE": "$(rootpath :hello_gcc_release)"},
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//deploy/private:dx_deploy_tools",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "artifacts_test",
    testonly = True,
    srcs = ["artifacts_test.rs"],
    aliases = aliases(
        package_name = "cc/tests/cc_tests_gcc_linux_x86_64",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "artifacts_test",
    crate_root = "artifacts_test.rs",
    data = [
        ":gcc_x86_64",
        "//cc/private/toolchains:pins.bzl",
    ],
    env = {
        "GCC_VERSION": GCC_VERSION,
        "GCC_X86_64": "$(rootpaths :gcc_x86_64)",
        "PINS": "$(rootpath //cc/private/toolchains:pins.bzl)",
    },
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = ["//tools/testing:dx_testing"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    testonly = True,
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

test_suite(
    name = "all",
    tests = [
        ":archive_test",
        ":artifacts_test",
        ":libstdcxx_archive_test",
    ],
)
