load("//cc/rules:defs.bzl", "cc_binary")
load("//cc/toolchains:select.bzl", "cc_toolchain_binary", "cc_toolchain_files")
load("//deploy/rules:archive.bzl", "consumer_archive")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")

package(default_testonly = True)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

cc_binary(
    name = "hello_c",
    srcs = ["hello_c.c"],
)

cc_toolchain_files(
    name = "gcc_x86_64",
    srcs = [
        ":hello_c",
        "//cc/tests/fixtures/gcc_shared:greet_shared",
        "//cc/tests/fixtures/hello:hello",
    ],
    compiler = "gcc",
    platforms = ["//cc/tests/gcc_linux_x86_64:linux_x86_64"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

cc_toolchain_binary(
    name = "hello_gcc",
    binary = ":hello_c",
    compiler = "gcc",
    platforms = ["//cc/tests/gcc_linux_x86_64:linux_x86_64"],
)

consumer_archive(
    name = "hello_gcc_release",
    app = ":hello_gcc",
    arch = "x86_64",
    min_runtime = "glibc-2.28",
    notice = "//deploy/tests/fixtures/consumer_archive:consumer_notice_files",
    os = "linux",
    runtime = ["//cc/toolchains:gcc_linux_glibc"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

cc_binary(
    name = "hello_cxx",
    srcs = ["hello_cxx.cc"],
    linkstatic = False,
)

cc_toolchain_binary(
    name = "hello_cxx_gcc",
    binary = ":hello_cxx",
    compiler = "gcc",
    extra_features = ["dynamic_libstdcxx"],
    platforms = ["//cc/tests/gcc_linux_x86_64:linux_x86_64"],
)

consumer_archive(
    name = "hello_cxx_release",
    app = ":hello_cxx_gcc",
    arch = "x86_64",
    min_runtime = "glibc-2.28",
    notice = "//deploy/tests/fixtures/consumer_archive:consumer_notice_files",
    os = "linux",
    runtime = [
        "//cc/toolchains:gcc_linux_glibc",
        "//cc/toolchains:gcc_linux_libstdcxx",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

rust_test(
    name = "libstdcxx_archive_test",
    srcs = ["libstdcxx_archive_test.rs"],
    data = [":hello_cxx_release_archive"],
    env = {"ARCHIVE": "$(rootpath :hello_cxx_release_archive)"},
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [
        "//deploy/rules:dx_deploy_tools",
        "//tools/testing:dx_testing",
    ],
)

rustfmt_test(
    name = "libstdcxx_archive_fmt_test",
    targets = [":libstdcxx_archive_test"],
)

rust_clippy_test(
    name = "libstdcxx_archive_clippy_test",
    targets = [":libstdcxx_archive_test"],
)

rust_test(
    name = "imports_test",
    srcs = ["imports_test.rs"],
    data = [
        ":hello_cxx_gcc",
        "//deploy/rules:archiver",
    ],
    env = {
        "APP": "$(rootpath :hello_cxx_gcc)",
        "ARCHIVER": "$(rootpath //deploy/rules:archiver)",
    },
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = ["//tools/testing:dx_testing"],
)

rustfmt_test(
    name = "imports_fmt_test",
    targets = [":imports_test"],
)

rust_clippy_test(
    name = "imports_clippy_test",
    targets = [":imports_test"],
)

rust_test(
    name = "archive_test",
    srcs = ["archive_test.rs"],
    data = [":hello_gcc_release_archive"],
    env = {"ARCHIVE": "$(rootpath :hello_gcc_release_archive)"},
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [
        "//deploy/rules:dx_deploy_tools",
        "//tools/testing:dx_testing",
    ],
)

rustfmt_test(
    name = "archive_fmt_test",
    targets = [":archive_test"],
)

rust_clippy_test(
    name = "archive_clippy_test",
    targets = [":archive_test"],
)

rust_test(
    name = "artifacts_test",
    srcs = ["artifacts_test.rs"],
    data = [
        ":gcc_x86_64",
        "//cc/toolchains:pins.bzl",
    ],
    env = {
        "GCC_X86_64": "$(rootpaths :gcc_x86_64)",
        "PINS": "$(rootpath //cc/toolchains:pins.bzl)",
    },
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = ["//tools/testing:dx_testing"],
)

rustfmt_test(
    name = "artifacts_fmt_test",
    targets = [":artifacts_test"],
)

rust_clippy_test(
    name = "artifacts_clippy_test",
    targets = [":artifacts_test"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

test_suite(
    name = "all",
    tests = [
        ":archive_clippy_test",
        ":archive_fmt_test",
        ":archive_test",
        ":artifacts_clippy_test",
        ":artifacts_fmt_test",
        ":artifacts_test",
        ":libstdcxx_archive_clippy_test",
        ":libstdcxx_archive_fmt_test",
        ":libstdcxx_archive_test",
    ],
)
