load("@rules_cc//cc:defs.bzl", "cc_shared_library")
load("//cc/rules:defs.bzl", "cc_binary", "cc_library")
load("//cc/toolchains:action_tests.bzl", "cc_msvc_arm64_action_tests")
load("//cc/toolchains:select.bzl", "cc_toolchain_files")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")

package(default_testonly = True)

_WINDOWS = ["@platforms//os:windows"]

platform(
    name = "windows_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:windows",
    ],
)

platform(
    name = "windows_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

cc_library(
    name = "greet_api",
    hdrs = ["//cc/tests/fixtures/msvc_shared:greet.h"],
    includes = ["../fixtures/msvc_shared"],
    tags = ["manual"],
    target_compatible_with = _WINDOWS,
)

cc_library(
    name = "add_c",
    srcs = ["//cc/tests/fixtures/msvc_shared:add.c"],
    hdrs = ["//cc/tests/fixtures/msvc_shared:add.h"],
    includes = ["../fixtures/msvc_shared"],
    tags = ["manual"],
    target_compatible_with = _WINDOWS,
)

cc_library(
    name = "greet_static",
    srcs = [
        "//cc/tests/fixtures/msvc_shared:greet_static.cc",
        "//cc/tests/fixtures/msvc_shared:greet_static_suffix.cc",
    ],
    tags = ["manual"],
    target_compatible_with = _WINDOWS,
    deps = [":greet_api"],
)

cc_library(
    name = "greet_dll_lib",
    srcs = ["//cc/tests/fixtures/msvc_shared:greet_dll.cc"],
    tags = ["manual"],
    target_compatible_with = _WINDOWS,
    deps = [":greet_api"],
)

cc_shared_library(
    name = "greet_dll",
    tags = ["manual"],
    target_compatible_with = _WINDOWS,
    deps = [":greet_dll_lib"],
)

cc_binary(
    name = "app",
    srcs = ["//cc/tests/fixtures/msvc_shared:shared_test.cc"],
    dynamic_deps = [":greet_dll"],
    tags = ["manual"],
    target_compatible_with = _WINDOWS,
    deps = [
        ":add_c",
        ":greet_api",
        ":greet_static",
    ],
)

filegroup(
    name = "objects",
    srcs = [
        ":add_c",
        ":greet_static",
    ],
    output_group = "compilation_outputs",
    tags = ["manual"],
    target_compatible_with = _WINDOWS,
)

_ARTIFACTS = [
    ":add_c",
    ":app",
    ":greet_dll",
    ":greet_static",
    ":objects",
]

cc_toolchain_files(
    name = "arm64",
    srcs = _ARTIFACTS,
    compiler = "msvc",
    platforms = ["//cc/tests/msvc_cross:windows_arm64"],
    target_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

cc_toolchain_files(
    name = "x64",
    srcs = _ARTIFACTS,
    compiler = "msvc",
    platforms = ["//cc/tests/msvc_cross:windows_x64"],
    target_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

cc_msvc_arm64_action_tests(
    name = "msvc_arm64_action_test",
    compile_target = ":greet_static",
    link_target = ":app",
)

rust_test(
    name = "cross_arm64_test",
    srcs = [
        "check.rs",
        "cross_arm64_test.rs",
    ],
    data = [":arm64"],
    env = {"MSVC_ARM64": "$(rootpaths :arm64)"},
    target_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
    deps = ["//tools/testing:dx_testing"],
)

rust_test(
    name = "cross_x64_test",
    srcs = [
        "check.rs",
        "cross_x64_test.rs",
    ],
    data = [":x64"],
    env = {"MSVC_X64": "$(rootpaths :x64)"},
    target_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
    deps = ["//tools/testing:dx_testing"],
)

rustfmt_test(
    name = "cross_arm64_fmt_test",
    targets = [":cross_arm64_test", ":cross_x64_test"],
)

rust_clippy_test(
    name = "cross_arm64_clippy_test",
    targets = [":cross_arm64_test", ":cross_x64_test"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
