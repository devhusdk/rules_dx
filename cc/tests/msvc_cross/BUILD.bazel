load("@rules_cc//cc:defs.bzl", "cc_shared_library")
load("//cc:defs.bzl", "cc_binary", "cc_library")
load("//cc/private/toolchain:select.bzl", "cc_toolchain_files")
load("//cc/tests:action_tests.bzl", "cc_msvc_arm64_action_tests")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")

package(default_testonly = True)

_WINDOWS = ["@platforms//os:windows"]

_WINDOWS_X86_64 = [
    "@platforms//os:windows",
    "@platforms//cpu:x86_64",
]

_CROSS = [
    "app",
    "greet_dll",
]

cc_library(
    name = "greet_api",
    hdrs = ["//cc/tests/fixtures/msvc_shared:greet.h"],
    includes = ["../fixtures/msvc_shared"],
    tags = ["manual"],
    target_compatible_with = _WINDOWS,
)

cc_library(
    name = "add_c",
    srcs = ["//cc/tests/fixtures/msvc_shared:add.c"],
    hdrs = ["//cc/tests/fixtures/msvc_shared:add.h"],
    includes = ["../fixtures/msvc_shared"],
    tags = ["manual"],
    target_compatible_with = _WINDOWS,
)

cc_library(
    name = "greet_static",
    srcs = [
        "//cc/tests/fixtures/msvc_shared:greet_static.cc",
        "//cc/tests/fixtures/msvc_shared:greet_static_suffix.cc",
    ],
    tags = ["manual"],
    target_compatible_with = _WINDOWS,
    deps = [":greet_api"],
)

cc_library(
    name = "greet_dll_lib",
    srcs = ["//cc/tests/fixtures/msvc_shared:greet_dll.cc"],
    tags = ["manual"],
    target_compatible_with = _WINDOWS,
    deps = [":greet_api"],
)

cc_shared_library(
    name = "greet_dll",
    tags = ["manual"],
    target_compatible_with = _WINDOWS,
    deps = [":greet_dll_lib"],
)

cc_binary(
    name = "app",
    srcs = ["//cc/tests/fixtures/msvc_shared:shared_test.cc"],
    dynamic_deps = [":greet_dll"],
    tags = ["manual"],
    target_compatible_with = _WINDOWS,
    deps = [
        ":add_c",
        ":greet_api",
        ":greet_static",
    ],
)

[
    cc_toolchain_files(
        name = name + "_arm64",
        srcs = [":" + name],
        compiler = "msvc",
        platforms = ["//tools/platforms:windows_arm64"],
        target_compatible_with = _WINDOWS_X86_64,
    )
    for name in _CROSS
]

[
    rust_test(
        name = name + "_arm64_test",
        size = "small",
        srcs = ["//tools/testing/conformance:runner_test.rs"],
        data = [":%s_arm64" % name],
        env = {
            "DX_CONFORMANCE_MODE": "cross",
            "DX_CONFORMANCE_SUBJECT": "$(rlocationpaths :%s_arm64)" % name,
            "DX_CONFORMANCE_TEXT": "windows_arm64",
        },
        target_compatible_with = _WINDOWS_X86_64,
        deps = [
            "//tools/testing:dx_testing",
            "//tools/testing/conformance:conformance_quality",
        ],
    )
    for name in _CROSS
]

cc_msvc_arm64_action_tests(
    name = "msvc_arm64_action_test",
    compile_target = ":greet_static_upstream",
    link_target = ":app_upstream",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
