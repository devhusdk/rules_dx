load("@rules_cc//cc:defs.bzl", "cc_shared_library")
load("//cc:defs.bzl", "cc_binary", "cc_library")
load("//cc/private/toolchain:action_tests.bzl", "cc_msvc_arm64_action_tests")
load("//core/quality:fixtures.bzl", "real_source_target")

package(default_testonly = True)

_WINDOWS = ["@platforms//os:windows"]

cc_library(
    name = "greet_api",
    hdrs = ["//cc/tests/fixtures/msvc_shared:greet.h"],
    includes = ["../fixtures/msvc_shared"],
    tags = ["manual"],
    target_compatible_with = _WINDOWS,
)

cc_library(
    name = "add_c",
    srcs = ["//cc/tests/fixtures/msvc_shared:add.c"],
    hdrs = ["//cc/tests/fixtures/msvc_shared:add.h"],
    includes = ["../fixtures/msvc_shared"],
    tags = ["manual"],
    target_compatible_with = _WINDOWS,
)

cc_library(
    name = "greet_static",
    srcs = [
        "//cc/tests/fixtures/msvc_shared:greet_static.cc",
        "//cc/tests/fixtures/msvc_shared:greet_static_suffix.cc",
    ],
    tags = ["manual"],
    target_compatible_with = _WINDOWS,
    deps = [":greet_api"],
)

cc_library(
    name = "greet_dll_lib",
    srcs = ["//cc/tests/fixtures/msvc_shared:greet_dll.cc"],
    tags = ["manual"],
    target_compatible_with = _WINDOWS,
    deps = [":greet_api"],
)

cc_shared_library(
    name = "greet_dll",
    tags = ["manual"],
    target_compatible_with = _WINDOWS,
    deps = [":greet_dll_lib"],
)

cc_binary(
    name = "app",
    srcs = ["//cc/tests/fixtures/msvc_shared:shared_test.cc"],
    dynamic_deps = [":greet_dll"],
    tags = ["manual"],
    target_compatible_with = _WINDOWS,
    deps = [
        ":add_c",
        ":greet_api",
        ":greet_static",
    ],
)

cc_msvc_arm64_action_tests(
    name = "msvc_arm64_action_test",
    compile_target = ":greet_static",
    link_target = ":app",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
