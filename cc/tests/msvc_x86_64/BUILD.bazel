load("//cc/rules:defs.bzl", "cc_binary")
load("//cc/toolchains:pins.bzl", "MSVC_CL_BUILD")
load("//cc/toolchains:select.bzl", "cc_toolchain_binary")
load("//deploy/rules:archive.bzl", "consumer_archive")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_test")

package(default_testonly = True)

_WINDOWS_X64 = [
    "@platforms//os:windows",
    "@platforms//cpu:x86_64",
]

platform(
    name = "windows_x86_64",
    constraint_values = _WINDOWS_X64,
)

cc_binary(
    name = "hello_cxx",
    srcs = ["hello_cxx.cc"],
    tags = ["manual"],
    target_compatible_with = _WINDOWS_X64,
)

cc_toolchain_binary(
    name = "hello_msvc",
    binary = ":hello_cxx",
    compiler = "msvc",
    platforms = ["//cc/tests/msvc_x86_64:windows_x86_64"],
    tags = ["manual"],
    target_compatible_with = _WINDOWS_X64,
)

consumer_archive(
    name = "hello_msvc_release",
    app = ":hello_msvc",
    format = "zip",
    min_runtime = "windows-10",
    notice = "//deploy/tests/fixtures/consumer_archive:consumer_notice_files",
    platform = ":windows_x86_64",
    runtime = [
        "//cc/toolchains:msvc_vcruntime",
        "//cc/toolchains:windows_ucrt",
    ],
    tags = ["manual"],
    target_compatible_with = _WINDOWS_X64,
)

rust_test(
    name = "archive_test",
    srcs = ["archive_test.rs"],
    data = [":hello_msvc_release"],
    env = {"ARCHIVE": "$(rootpath :hello_msvc_release)"},
    tags = ["manual"],
    target_compatible_with = _WINDOWS_X64,
    deps = [
        "//deploy/rules:dx_deploy_tools",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "imports_test",
    srcs = ["imports_test.rs"],
    data = [
        ":hello_msvc",
        "//deploy/rules:archiver",
    ],
    env = {
        "APP": "$(rootpath :hello_msvc)",
        "ARCHIVER": "$(rootpath //deploy/rules:archiver)",
    },
    tags = ["manual"],
    target_compatible_with = _WINDOWS_X64,
    deps = ["//tools/testing:dx_testing"],
)

rust_test(
    name = "producer_test",
    srcs = ["producer_test.rs"],
    data = [":hello_msvc"],
    env = {
        "APP": "$(rootpath :hello_msvc)",
        "PRODUCER": "msvc 261." + MSVC_CL_BUILD,
    },
    tags = ["manual"],
    target_compatible_with = _WINDOWS_X64,
    deps = [
        "//libs/binfmt:dx_binfmt",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

test_suite(
    name = "all",
    tests = [
        ":archive_test",
        ":imports_test",
        ":producer_test",
    ],
)
