load("@crates//:crates.bzl", "aliases")
load("//cc:defs.bzl", "cc_binary")
load("//cc/private/toolchain:pins.bzl", "MSVC_CL_BUILD")
load("//cc/private/toolchain:select.bzl", "cc_toolchain_binary")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//deploy:defs.bzl", "consumer_archive")
load("//rust:defs.bzl", "rust_test")

package(default_testonly = True)

_WINDOWS_X64 = [
    "@platforms//os:windows",
    "@platforms//cpu:x86_64",
]

cc_binary(
    name = "hello_cxx",
    srcs = ["hello_cxx.cc"],
    tags = ["manual"],
    target_compatible_with = _WINDOWS_X64,
)

cc_toolchain_binary(
    name = "hello_msvc",
    binary = ":hello_cxx",
    compiler = "msvc",
    platforms = ["//tools/platforms:windows_x86_64"],
    tags = ["manual"],
    target_compatible_with = _WINDOWS_X64,
)

consumer_archive(
    name = "hello_msvc_release",
    app = ":hello_msvc",
    format = "zip",
    min_runtime = "windows-10",
    notice = "//deploy/tests/fixtures/consumer_archive:consumer_notice_files",
    platform = "//tools/platforms:windows_x86_64",
    runtime = [
        "//cc/private/toolchain:msvc_vcruntime",
        "//cc/private/toolchain:windows_ucrt",
    ],
    tags = ["manual"],
    target_compatible_with = _WINDOWS_X64,
)

rust_test(
    name = "archive_test",
    testonly = True,
    srcs = ["archive_test.rs"],
    aliases = aliases(
        package_name = "cc/tests/cc_tests_msvc_x86_64",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "archive_test",
    crate_root = "archive_test.rs",
    data = [":hello_msvc_release"],
    env = {"ARCHIVE": "$(rootpath :hello_msvc_release)"},
    target_compatible_with = _WINDOWS_X64,
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//deploy/private:dx_deploy_tools",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "imports_test",
    testonly = True,
    srcs = ["imports_test.rs"],
    aliases = aliases(
        package_name = "cc/tests/cc_tests_msvc_x86_64",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "imports_test",
    crate_root = "imports_test.rs",
    data = [
        ":hello_msvc",
        "//deploy/private:archiver",
    ],
    env = {
        "APP": "$(rootpath :hello_msvc)",
        "ARCHIVER": "$(rootpath //deploy/private:archiver)",
    },
    target_compatible_with = _WINDOWS_X64,
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "producer_test",
    testonly = True,
    srcs = ["producer_test.rs"],
    aliases = aliases(
        package_name = "cc/tests/cc_tests_msvc_x86_64",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "producer_test",
    crate_root = "producer_test.rs",
    data = [":hello_msvc"],
    env = {
        "APP": "$(rootpath :hello_msvc)",
        "PRODUCER": "msvc 261." + MSVC_CL_BUILD,
    },
    target_compatible_with = _WINDOWS_X64,
    deps = [
        "//cli/binfmt:dx_binfmt",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    testonly = True,
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

test_suite(
    name = "all",
    tests = [
        ":archive_test",
        ":imports_test",
        ":producer_test",
    ],
)
