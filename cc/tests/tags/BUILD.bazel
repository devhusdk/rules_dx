load("//cc/rules:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//libs/starlark:defs.bzl", "starlark_test")
load("//libs/starlark:tag_probe.bzl", "tag_subject")
load("//quality:fixtures.bzl", "real_source_target")

cc_library(
    name = "lib",
    srcs = ["main.c"],
    tags = [
        "manual",
        "no-lint",
        "no-remote-exec",
    ],
)

cc_binary(
    name = "bin_auto",
    srcs = ["main.c"],
    tags = [
        "no-lint",
        "no-remote-exec",
    ],
)

cc_binary(
    name = "bin",
    srcs = ["main.c"],
    tags = [
        "manual",
        "no-lint",
        "no-remote-exec",
    ],
)

cc_test(
    name = "unit",
    srcs = ["main.c"],
    tags = [
        "manual",
        "no-lint",
        "no-remote-exec",
    ],
)

tag_subject(
    name = "tags_subject",
    testonly = True,
    targets = [
        ":bin",
        ":bin_auto",
        ":bin_auto_upstream",
        ":bin_upstream",
        ":lib",
        ":lib_upstream",
        ":unit",
        ":unit_upstream",
    ],
)

starlark_test(
    name = "tags_test",
    expected_observations = """subject //cc/tests/tags:tags_subject
field bin=manual,no-lint,no-remote-exec
field bin_auto=no-lint,no-remote-exec
field bin_auto_upstream=dx:no-lint,manual,no-remote-exec
field bin_upstream=dx:no-lint,manual,no-remote-exec
field lib=manual,no-lint,no-remote-exec
field lib_upstream=dx:no-lint,manual,no-remote-exec
field unit=manual,no-lint,no-remote-exec
field unit_upstream=dx:no-lint,manual,no-remote-exec
aspect_field aspect_seen=True
aspect_field field_count=8
aspect_field has_subject=True
aspect_field subject_label=//cc/tests/tags:tags_subject
aspect_field transitive_count=0
""",
    mode = "analysis",
    subjects = [":tags_subject"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
