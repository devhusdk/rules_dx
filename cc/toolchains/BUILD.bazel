load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("//cc/rules:wrapper_tests.bzl", "cc_gcov_coverage_env_test")
load("//deploy/rules:native_runtime.bzl", "native_runtime")
load("//quality:fixtures.bzl", "real_source_target")
load(":gcc_unsupported_tests.bzl", "gcc_unsupported_tests")
load(":identity_subject.bzl", "cc_toolchain_identity_subject")
load(":identity_tests.bzl", "cc_toolchain_identity_tests")
load(":pins.bzl", "GCC_GLIBC", "GCC_VERSION")
load(":select.bzl", "cc_toolchain_test")
load(":unavailable.bzl", "GCC_UNSUPPORTED", "cc_toolchain_unavailable")

package(default_visibility = ["//:__subpackages__"])

cc_toolchain_identity_subject(
    name = "identity_under_test",
)

cc_toolchain_identity_subject(
    name = "identity_under_test_gcc",
    compiler = "gcc",
)

cc_toolchain_identity_tests(name = "identity")

string_flag(
    name = "compiler",
    build_setting_default = "llvm",
    values = [
        "llvm",
        "gcc",
        "msvc",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "gcc_selected",
    flag_values = {":compiler": "gcc"},
)

config_setting(
    name = "msvc_selected",
    flag_values = {":compiler": "msvc"},
)

toolchain(
    name = "gcc_linux_x86_64",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_settings = [":gcc_selected"],
    toolchain = "@dx_gcc_linux_x86_64//:_cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

toolchain(
    name = "gcc_linux_x86_64_to_arm64",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    target_settings = [":gcc_selected"],
    toolchain = "@dx_gcc_linux_aarch64_cross//:_cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

toolchain(
    name = "gcc_linux_arm64",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    target_settings = [":gcc_selected"],
    toolchain = "@dx_gcc_linux_aarch64//:_cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

toolchain(
    name = "msvc_windows_x86_64",
    exec_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
    target_settings = [":msvc_selected"],
    toolchain = "@dx_msvc//:cc_toolchain_x64_x64",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

toolchain(
    name = "msvc_unsupported",
    target_settings = [":msvc_selected"],
    toolchain = "//cc/toolchains/msvc:unsupported",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

cc_toolchain_unavailable(
    name = "gcc_unsupported_impl",
    error = GCC_UNSUPPORTED,
    tags = ["manual"],
)

toolchain(
    name = "gcc_unsupported",
    target_settings = [":gcc_selected"],
    toolchain = ":gcc_unsupported_impl",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

gcc_unsupported_tests(name = "gcc_unsupported_test")

cc_toolchain_test(
    name = "gcc_hello_test",
    compiler = "gcc",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    test = "//cc/tests/fixtures/hello:hello_private_header_test",
)

cc_toolchain_test(
    name = "gcc_hello_lib_test",
    compiler = "gcc",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    test = "//cc/tests/fixtures/hello:hello_test",
)

cc_toolchain_test(
    name = "gcc_hello_c_test",
    compiler = "gcc",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    test = "//cc/tests/fixtures/hello:hello_c_test",
)

cc_toolchain_test(
    name = "gcc_shared_test",
    compiler = "gcc",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    test = "//cc/tests/fixtures/gcc_shared:shared_test",
)

cc_toolchain_test(
    name = "gcc_dynamic_libstdcxx_test",
    compiler = "gcc",
    extra_features = ["dynamic_libstdcxx"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    test = "//cc/tests/fixtures/gcc_shared:shared_dynamic_test",
)

cc_toolchain_test(
    name = "gcc_c_test",
    compiler = "gcc",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    test = "//cc/tests/fixtures/gcc_shared:c_test",
)

cc_toolchain_test(
    name = "gcc_asan_test",
    compiler = "gcc",
    extra_features = ["asan"],
    tags = ["no-coverage"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    test = "//cc/tests/fixtures/gcc_sanitize:asan_test",
)

cc_toolchain_test(
    name = "gcc_ubsan_test",
    compiler = "gcc",
    extra_features = ["ubsan"],
    tags = ["no-coverage"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    test = "//cc/tests/fixtures/gcc_sanitize:ubsan_test",
)

cc_toolchain_test(
    name = "gcc_arm64_hello_test",
    compiler = "gcc",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    test = "//cc/tests/fixtures/hello:hello_private_header_test",
)

cc_toolchain_test(
    name = "gcc_arm64_hello_c_test",
    compiler = "gcc",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    test = "//cc/tests/fixtures/hello:hello_c_test",
)

cc_toolchain_test(
    name = "gcc_arm64_shared_test",
    compiler = "gcc",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    test = "//cc/tests/fixtures/gcc_shared:shared_test",
)

cc_gcov_coverage_env_test(
    name = "gcc_coverage_env_test",
    target = "//cc/tests/fixtures/hello:hello_c_test",
)

test_suite(
    name = "all",
    tests = [
        ":gcc_arm64_hello_c_test",
        ":gcc_arm64_hello_test",
        ":gcc_arm64_shared_test",
        ":gcc_asan_test",
        ":gcc_c_test",
        ":gcc_coverage_env_test",
        ":gcc_dynamic_libstdcxx_test",
        ":gcc_hello_c_test",
        ":gcc_hello_lib_test",
        ":gcc_hello_test",
        ":gcc_shared_test",
        ":gcc_ubsan_test",
        ":identity",
        ":identity_contract",
        ":identity_gcc",
        "//cc/tests/fixtures/hello:toolchain_action_tests",
        "//cc/tests/gcc_cross:cross_arm64_test",
        "//cc/tests/gcc_linux_x86_64:all",
        "//cc/toolchains/msvc:msvc_arm64_arm64_toolchain",
        "//cc/toolchains/msvc:msvc_layout",
        "//cc/toolchains/msvc:msvc_layout_arm64",
        "//cc/toolchains/msvc:msvc_repos",
        "//cc/toolchains/msvc:msvc_unavailable",
        "//cc/toolchains/msvc:msvc_unsupported",
        "//cc/toolchains/msvc:msvc_x64_arm64_toolchain",
        "//cc/toolchains/msvc:msvc_x64_x64_toolchain",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "action_tests.bzl",
        "bindings.bzl",
        "identity_subject.bzl",
        "identity_tests.bzl",
        "pins.bzl",
        "repos.bzl",
        "select.bzl",
        "unavailable.bzl",
        "gcc_unsupported_tests.bzl",
    ],
    tags = ["corpus"],
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//tools/docs/support_matrix:__pkg__"],
)

exports_files(
    ["pins.bzl"],
    visibility = ["//cc/tests/gcc_linux_x86_64:__pkg__"],
)

# The glibc and libgcc of the pinned GCC sysroot come from the host OS, and
# libstdc++ is linked statically, so nothing ships with the app.
native_runtime(
    name = "gcc_linux_glibc",
    redistribution = "os_supplied",
    source = "gcc " + GCC_VERSION + " sysroot",
    version = GCC_GLIBC.removeprefix("glibc_"),
    visibility = ["//visibility:public"],
)
