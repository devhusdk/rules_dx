load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("//cc/rules:wrapper_tests.bzl", "cc_gcov_coverage_env_test")
load("//quality:fixtures.bzl", "real_source_target")
load(":identity_subject.bzl", "cc_toolchain_identity_subject")
load(":identity_tests.bzl", "cc_toolchain_identity_tests")
load(":select.bzl", "cc_toolchain_test")

package(default_visibility = ["//:__subpackages__"])

cc_toolchain_identity_subject(
    name = "identity_under_test",
)

cc_toolchain_identity_subject(
    name = "identity_under_test_gcc",
    compiler = "gcc",
)

cc_toolchain_identity_tests(name = "identity")

string_flag(
    name = "compiler",
    build_setting_default = "llvm",
    values = [
        "llvm",
        "gcc",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "gcc_selected",
    flag_values = {":compiler": "gcc"},
)

toolchain(
    name = "gcc_linux_x86_64",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_settings = [":gcc_selected"],
    toolchain = "@dx_gcc_linux_x86_64//:_cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

toolchain(
    name = "gcc_linux_x86_64_to_arm64",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    target_settings = [":gcc_selected"],
    toolchain = "@dx_gcc_linux_aarch64_cross//:_cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

cc_toolchain_test(
    name = "gcc_hello_test",
    compiler = "gcc",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    test = "//cc/tests/fixtures/hello:hello_private_header_test",
)

cc_toolchain_test(
    name = "gcc_hello_lib_test",
    compiler = "gcc",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    test = "//cc/tests/fixtures/hello:hello_test",
)

cc_toolchain_test(
    name = "gcc_hello_c_test",
    compiler = "gcc",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    test = "//cc/tests/fixtures/hello:hello_c_test",
)

cc_toolchain_test(
    name = "gcc_shared_test",
    compiler = "gcc",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    test = "//cc/tests/fixtures/gcc_shared:shared_test",
)

cc_toolchain_test(
    name = "gcc_dynamic_libstdcxx_test",
    compiler = "gcc",
    extra_features = ["dynamic_libstdcxx"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    test = "//cc/tests/fixtures/gcc_shared:shared_dynamic_test",
)

cc_toolchain_test(
    name = "gcc_c_test",
    compiler = "gcc",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    test = "//cc/tests/fixtures/gcc_shared:c_test",
)

cc_toolchain_test(
    name = "gcc_asan_test",
    compiler = "gcc",
    extra_features = ["asan"],
    tags = ["no-coverage"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    test = "//cc/tests/fixtures/gcc_sanitize:asan_test",
)

cc_toolchain_test(
    name = "gcc_ubsan_test",
    compiler = "gcc",
    extra_features = ["ubsan"],
    tags = ["no-coverage"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    test = "//cc/tests/fixtures/gcc_sanitize:ubsan_test",
)

cc_gcov_coverage_env_test(
    name = "gcc_coverage_env_test",
    target = "//cc/tests/fixtures/hello:hello_c_test",
)

test_suite(
    name = "all",
    tests = [
        ":gcc_asan_test",
        ":gcc_c_test",
        ":gcc_coverage_env_test",
        ":gcc_dynamic_libstdcxx_test",
        ":gcc_hello_c_test",
        ":gcc_hello_lib_test",
        ":gcc_hello_test",
        ":gcc_shared_test",
        ":gcc_ubsan_test",
        ":identity",
        ":identity_contract",
        ":identity_gcc",
        "//cc/tests/gcc_cross:all",
        "//cc/toolchains/msvc:msvc_layout",
        "//cc/toolchains/msvc:msvc_toolchain",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "bindings.bzl",
        "identity_subject.bzl",
        "identity_tests.bzl",
        "pins.bzl",
        "repos.bzl",
        "select.bzl",
    ],
    tags = ["corpus"],
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//tools/docs/support_matrix:__pkg__"],
)
