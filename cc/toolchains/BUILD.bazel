load("//quality:fixtures.bzl", "real_source_target")
load(":identity_subject.bzl", "cc_toolchain_identity_subject")
load(":identity_tests.bzl", "cc_toolchain_identity_tests")
load(":select.bzl", "cc_toolchain_test")

package(default_visibility = ["//:__subpackages__"])

cc_toolchain_identity_subject(
    name = "identity_under_test",
)

cc_toolchain_identity_subject(
    name = "identity_under_test_gcc",
    extra_toolchain = "//cc/toolchains:gcc_linux_x86_64",
)

cc_toolchain_identity_tests(name = "identity")

toolchain(
    name = "gcc_linux_x86_64",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = "@dx_gcc_linux_x86_64//:_cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

cc_toolchain_test(
    name = "gcc_hello_test",
    extra_toolchain = "//cc/toolchains:gcc_linux_x86_64",
    tags = ["no-coverage"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    test = "//cc/tests/fixtures/hello:hello_private_header_test",
)

cc_toolchain_test(
    name = "gcc_hello_lib_test",
    extra_toolchain = "//cc/toolchains:gcc_linux_x86_64",
    tags = ["no-coverage"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    test = "//cc/tests/fixtures/hello:hello_test",
)

cc_toolchain_test(
    name = "gcc_hello_c_test",
    extra_toolchain = "//cc/toolchains:gcc_linux_x86_64",
    tags = ["no-coverage"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    test = "//cc/tests/fixtures/hello:hello_c_test",
)

cc_toolchain_test(
    name = "gcc_shared_test",
    extra_toolchain = "//cc/toolchains:gcc_linux_x86_64",
    tags = ["no-coverage"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    test = "//cc/tests/fixtures/gcc_shared:shared_test",
)

cc_toolchain_test(
    name = "gcc_c_test",
    extra_toolchain = "//cc/toolchains:gcc_linux_x86_64",
    tags = ["no-coverage"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    test = "//cc/tests/fixtures/gcc_shared:c_test",
)

test_suite(
    name = "all",
    tests = [
        ":gcc_c_test",
        ":gcc_hello_c_test",
        ":gcc_hello_lib_test",
        ":gcc_hello_test",
        ":gcc_shared_test",
        ":identity",
        ":identity_contract",
        ":identity_gcc",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "bindings.bzl",
        "identity_subject.bzl",
        "identity_tests.bzl",
        "pins.bzl",
        "repos.bzl",
        "select.bzl",
    ],
    tags = ["corpus"],
)
