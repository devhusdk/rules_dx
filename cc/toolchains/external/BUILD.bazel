load("@rules_cc//cc:defs.bzl", "cc_toolchain")
load("@rules_dx//cc/rules:wrapper_tests.bzl", "cc_external_asan_env_tests", "cc_external_coverage_tests")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//cc/toolchains:identity_subject.bzl", "cc_toolchain_identity_subject")
load("//cc/toolchains:select.bzl", "cc_toolchain_test")
load(":custom_gcc_tests.bzl", "custom_gcc_identity_test")
load(":fake_config.bzl", "fake_cc_toolchain_config")
load(":tests.bzl", "external_toolchain_tests")

package(default_visibility = ["//:__subpackages__"])

filegroup(name = "empty")

fake_cc_toolchain_config(
    name = "gcc_config",
    compiler = "gcc",
    target = "fake-gcc-linux-gnu",
)

fake_cc_toolchain_config(
    name = "icx_config",
    compiler = "icx",
    target = "fake-icx-linux-gnu",
)

fake_cc_toolchain_config(
    name = "msvc_cl_config",
    compiler = "msvc-cl",
    target = "x86_64-pc-windows-msvc",
)

fake_cc_toolchain_config(
    name = "clang_cl_config",
    compiler = "clang-cl",
    target = "x86_64-pc-windows-msvc",
)

fake_cc_toolchain_config(
    name = "clang_msvc_config",
    compiler = "clang",
    target = "x86_64-pc-windows-msvc",
)

[
    (
        cc_toolchain(
            name = name + "_cc_toolchain",
            all_files = ":empty",
            ar_files = ":empty",
            compiler_files = ":empty",
            dwp_files = ":empty",
            linker_files = ":empty",
            objcopy_files = ":empty",
            strip_files = ":empty",
            supports_param_files = False,
            toolchain_config = ":" + name + "_config",
        ),
        toolchain(
            name = name + "_toolchain",
            toolchain = ":" + name + "_cc_toolchain",
            toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
        ),
    )
    for name in [
        "clang_cl",
        "clang_msvc",
        "gcc",
        "icx",
        "msvc_cl",
    ]
]

cc_toolchain_identity_subject(
    name = "gcc_subject",
    extra_toolchains = ["//cc/toolchains/external:gcc_toolchain"],
)

cc_toolchain_identity_subject(
    name = "gcc_flag_subject",
    compiler = "gcc",
    extra_toolchains = ["//cc/toolchains/external:gcc_toolchain"],
)

cc_toolchain_identity_subject(
    name = "icx_subject",
    extra_toolchains = ["//cc/toolchains/external:icx_toolchain"],
)

external_toolchain_tests(name = "external")

cc_external_asan_env_tests(
    name = "asan_env_tests",
    target = "//cc/tests/fixtures/prebuilt_interop:interop_test",
)

cc_external_coverage_tests(
    name = "coverage_tests",
    target = "//cc/tests/fixtures/prebuilt_interop:interop_test",
)

_LINUX_X86_64 = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

toolchain(
    name = "custom_gcc_x86_64",
    exec_compatible_with = _LINUX_X86_64,
    target_compatible_with = _LINUX_X86_64,
    toolchain = "@custom_gcc_x86_64//:_cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

cc_toolchain_identity_subject(
    name = "custom_gcc_subject",
    extra_toolchains = ["//cc/toolchains/external:custom_gcc_x86_64"],
)

custom_gcc_identity_test(name = "custom_gcc_identity")

cc_toolchain_test(
    name = "custom_gcc_hello_test",
    compiler = "gcc",
    extra_toolchains = ["//cc/toolchains/external:custom_gcc_x86_64"],
    target_compatible_with = _LINUX_X86_64,
    test = "//cc/tests/fixtures/hello:hello_private_header_test",
)

test_suite(
    name = "custom_gcc",
    tests = [
        ":custom_gcc_hello_test",
        ":custom_gcc_identity",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "custom_gcc_tests.bzl",
        "fake_config.bzl",
        "tests.bzl",
    ],
    tags = ["corpus"],
)
