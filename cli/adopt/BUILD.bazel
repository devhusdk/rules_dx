load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:crate.bzl", "dx_rust_crate")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

dx_rust_crate(
    name = "dx_adopt",
    package_name = "cli/dx_adopt",
    srcs = [
        "src/build_output.rs",
        "src/cuda_stanza.rs",
        "src/defaults.rs",
        "src/dependency_sets.rs",
        "src/error.rs",
        "src/git_changes.rs",
        "src/init_dir.rs",
        "src/init_parts.rs",
        "src/launcher.rs",
        "src/lib.rs",
        "src/load_graph.rs",
        "src/migrate.rs",
        "src/overrides.rs",
        "src/preflight.rs",
        "src/preset.rs",
        "src/preset_fragment.rs",
        "src/scaffold.rs",
        "src/status.rs",
        "src/upgrade.rs",
        "src/version.rs",
        "src/watch.rs",
    ],
    # Patches dx copies into consumers through `include_str!` in src/overrides.rs.
    compile_data = [
        "//patches/aspect_rules_jest:windows_v8_coverage.patch",
        "//patches/aspect_rules_py:windows_venv.patch",
        "//patches/aspect_rules_ts:typecheck_root_dir.patch",
        "//patches/rules_cuda:dlink_includes.patch",
        "//patches/rules_dotnet:reproducible.patch",
        "//patches/rules_dotnet:fsharp_signature.patch",
        "//patches/rules_dotnet:sdk_versions.patch",
        "//patches/rules_ruby:reproducible.patch",
        "//patches/rules_ruby:coverage.patch",
        "//patches/rules_rust:lld_link.patch",
        "//patches/rules_rust:msvc_stdlib_linkflags.patch",
    ],
    dev_deps = [
        "insta",
    ],
    extra_deps = [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/identity:dx_identity",
        "//cli/path:dx_path",
        "//libs/gomod:dx_gomod",
        "//libs/module_bazel:dx_module_bazel",
        "//tools/bazelrc:dx_preset",
    ],
    extra_test_deps = [
        "//cli/test_scratch:dx_test_scratch",
    ],
    test_data = [
        ":python_files",
        ":python_interpreter",
        "//:.bazelversion",
        "//:MODULE.bazel",
        "//:package.json",
        "//examples:consumer-ci/caller.yml",
        "//modules:cuda.bzl",
        "//modules:ruby.bzl",
        "//modules:versions.bzl",
    ],
    test_env = {"DX_PYTHON": "$(rootpath :python_interpreter)"},
    visibility = VIS_CLI + ["//tools/docs/support_matrix:__pkg__"],
    deps = [
        "notify",
        "notify-debouncer-mini",
        "semver",
        "serde",
        "serde_json",
        "thiserror",
        "toml",
    ],
)

alias(
    name = "python_interpreter",
    actual = "@python_3_12//:python3",
)

alias(
    name = "python_files",
    actual = "@python_3_12//:files",
)

exports_files([
    "src/launcher.rs",
    "src/lib.rs",
    "src/version.rs",
])

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
