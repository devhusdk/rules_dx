load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:crate.bzl", "dx_rust_crate")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

dx_rust_crate(
    name = "dx_adopt",
    package_name = "cli/dx_adopt",
    srcs = [
        "src/defaults.rs",
        "src/dependency_sets.rs",
        "src/error.rs",
        "src/hooks.rs",
        "src/inspect.rs",
        "src/lib.rs",
        "src/migrate.rs",
        "src/new.rs",
        "src/policy.rs",
        "src/preset_fragment.rs",
        "src/scaffold.rs",
        "src/status.rs",
        "src/upgrade.rs",
        "src/verify.rs",
        "src/version.rs",
        "src/watch.rs",
    ],
    dev_deps = [
        "insta",
        "serde_json",
    ],
    extra_deps = [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/fingerprint:dx_fingerprint",
        "//cli/identity:dx_identity",
        "//tools/bazelrc:dx_preset",
    ],
    extra_test_deps = ["//cli/test_scratch:dx_test_scratch"],
    deps = [
        "notify",
        "notify-debouncer-mini",
        "semver",
        "serde",
        "thiserror",
        "toml",
    ],
)

exports_files([
    "src/lib.rs",
    "src/version.rs",
])

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
