load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//quality:tools_gen.bzl", "adopt_tools_gen")
load("//rust/rules:crate.bzl", "dx_rust_crate")
load("//tools/visibility:visibility.bzl", "VIS_CLI", "VIS_QUALITY")

package(default_visibility = VIS_CLI)

adopt_tools_gen(
    name = "update_tools",
    visibility = VIS_QUALITY,
)

dx_rust_crate(
    name = "dx_adopt",
    package_name = "cli/dx_adopt",
    srcs = [
        "src/build_output.rs",
        "src/defaults.rs",
        "src/dependency_sets.rs",
        "src/error.rs",
        "src/families.rs",
        "src/git_changes.rs",
        "src/init_dir.rs",
        "src/launcher.rs",
        "src/lib.rs",
        "src/load_graph.rs",
        "src/local_paths_tests.rs",
        "src/lock_hubs.rs",
        "src/module_pin.rs",
        "src/overrides.rs",
        "src/ownership.rs",
        "src/preflight.rs",
        "src/preset.rs",
        "src/preset_fragment.rs",
        "src/profiles.rs",
        "src/scaffold.rs",
        "src/status.rs",
        "src/tools_gen.rs",
        "src/upgrade.rs",
        "src/version.rs",
        "src/watch.rs",
    ],
    # Patches dx copies into consumers through `include_str!` in src/overrides.rs.
    compile_data = [
        "//quality/tiers:all",
        "//.github:workflows/dx-update.yml",
        "//cli/prebuilt:pins.bzl",
        "//modules:consumer_graph.json",
        "//patches/rules_dart:coverage.patch",
        "//patches/rules_python:single_import_lib.patch",
        "//patches/rules_py:py_cc_toolchain_platform.patch",
        "//patches/rules_py:native_sdist_toolchain_flags.patch",
        "//patches/rules_py:pep517_msvc.patch",
        "//patches/rules_py:venv_bin_files.patch",
        "//patches/aspect_rules_ts:typecheck_root_dir.patch",
        "//patches/avro-cpp:iterator.patch",
        "//patches/gcc_toolchain:runtime_libs.patch",
        "//patches/gcc_toolchain:sanitizer_spec.patch",
        "//patches/gcc_toolchain:target_identity_config.patch",
        "//patches/gcc_toolchain:target_identity_defs.patch",
        "//patches/gcc_toolchain:target_identity_extension.patch",
        "//patches/gcc_toolchain:native_include_layout.patch",
        "//patches/protobuf:no_crate_universe.patch",
        "//patches/rules_android:bundle_keystore_properties.patch",
        "//patches/hermetic_launcher:windows_arm64_toolchains.patch",
        "//patches/rules_cuda:msvc_dlink_crt.patch",
        "//patches/rules_cuda:redist_cccl_key.patch",
        "//patches/rules_flutter:missing_font.patch",
        "//patches/rules_julia:package_annotation_version.patch",
        "//patches/rules_julia:package_name.patch",
        "//patches/rules_julia:portable_cpu_target.patch",
        "//patches/rules_rust:clippy_metadata_inputs.patch",
        "//patches/rules_rust:pipelined_rmeta_path.patch",
        "//patches/rules_rust:crate_universe_root_lookup.patch",
        "//patches/rules_rust:exec_cc_toolchain_env.patch",
        "//patches/rules_rust:msvc_pdb_output.patch",
        "//patches/rules_rust:rust_lld_msvc_libpath.patch",
        "//patches/rules_rust:crate_universe_lazy_host_tools.patch",
        "//patches/llvm:libunwind_copy.patch",
        "//patches/llvm:clang_cl_crt_default_lib.patch",
        "//patches/windows_support:host_tools.patch",
        "//patches/windows_support:rules_dx_hosts.patch",
        "//patches/windows_support:hostarm64_packages.patch",
    ],
    dev_deps = [
        "insta",
    ],
    extra_deps = [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/ide:dx_ide",
        "//cli/merge:dx_merge",
        "//cli/path:dx_path",
        "//libs/families:dx_families",
        "//libs/gomod:dx_gomod",
        "//libs/module_bazel:dx_module_bazel",
        "//modules:dx_versions",
        "//tools/bazelrc:dx_preset",
    ],
    extra_test_deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing:dx_testing",
    ],
    test_data = glob(["src/*.rs"]) + [
        ":python_files",
        ":python_interpreter",
        "//:.bazelversion",
        "//:MODULE.bazel",
        "//:package.json",
        "//examples:consumer-ci/caller.yml",
        "//modules:cuda.bzl",
        "@dx_tools//:shellcheck",
    ],
    test_env = {
        "DX_PYTHON": "$(rootpath :python_interpreter)",
        "DX_SHELLCHECK": "$(rootpath @dx_tools//:shellcheck)",
    },
    visibility = VIS_CLI + [
        "//modules:__pkg__",
        "//tools/ci:__pkg__",
        "//tools/docs/support_matrix:__pkg__",
    ],
    deps = [
        "notify",
        "notify-debouncer-mini",
        "semver",
        "serde",
        "serde_json",
        "thiserror",
        "toml",
    ],
)

alias(
    name = "python_interpreter",
    actual = "@python_3_12//:python3",
)

alias(
    name = "python_files",
    actual = "@python_3_12//:files",
)

exports_files([
    "src/launcher.rs",
    "src/lib.rs",
    "src/version.rs",
])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
