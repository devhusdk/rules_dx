load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

rust_library(
    name = "dx_adopt",
    srcs = [
        "src/avro_cpp.rs",
        "src/build_output.rs",
        "src/defaults.rs",
        "src/dependency_sets.rs",
        "src/error.rs",
        "src/families.rs",
        "src/git_changes.rs",
        "src/init_dir.rs",
        "src/launcher.rs",
        "src/lib.rs",
        "src/load_graph.rs",
        "src/lock_hubs.rs",
        "src/module_deps.rs",
        "src/module_pin.rs",
        "src/ownership.rs",
        "src/preflight.rs",
        "src/preset.rs",
        "src/preset_fragment.rs",
        "src/rule_keys.rs",
        "src/scaffold.rs",
        "src/status.rs",
        "src/upgrade.rs",
        "src/version.rs",
        "src/watch.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_adopt",
        normal = True,
    ),
    compile_data = [
        "//core/quality/tiers:all",
        "//core/quality/tiers/gopls:gopls_standard.json",
        "//core/quality/tiers/gopls:gopls_strict.json",
        "//.github:workflows/dx-update.yml",
        "//cli/prebuilt:pins.bzl",
        "//patches/avro-cpp:iterator.patch",
    ],
    crate_name = "dx_adopt",
    crate_root = "src/lib.rs",
    visibility = VIS_CLI + [
        "//core/modules:__pkg__",
        "//core/quality:__pkg__",
        "//core/quality/tests:__pkg__",
        "//tools/ci/fill_pins:__pkg__",
        "//tools/docs/support_matrix:__pkg__",
        "//tools/testing:__pkg__",
    ],
    deps = all_crate_deps(
        package_name = "cli/dx_adopt",
        normal = True,
    ) + [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/dx_config",
        "//cli/ecosystems:dx_ecosystems",
        "//cli/error:dx_error",
        "//cli/families:dx_families",
        "//cli/generate:dx_generate",
        "//cli/gomod:dx_gomod",
        "//cli/ide:dx_ide",
        "//cli/merge:dx_merge",
        "//cli/module_bazel:dx_module_bazel",
        "//cli/path:dx_path",
        "//cli/process:dx_process",
        "//core/modules:dx_versions",
        "//tools/bazelrc:dx_preset",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "dx_adopt_test",
    size = "small",
    srcs = [
        "src/avro_cpp.rs",
        "src/build_output.rs",
        "src/defaults.rs",
        "src/dependency_sets.rs",
        "src/dependency_sets_tests.rs",
        "src/error.rs",
        "src/families.rs",
        "src/git_changes.rs",
        "src/init_dir.rs",
        "src/launcher.rs",
        "src/lib.rs",
        "src/load_graph.rs",
        "src/local_paths_tests.rs",
        "src/lock_hubs.rs",
        "src/module_deps.rs",
        "src/module_pin.rs",
        "src/ownership.rs",
        "src/preflight.rs",
        "src/preset.rs",
        "src/preset_fragment.rs",
        "src/rule_keys.rs",
        "src/scaffold.rs",
        "src/status.rs",
        "src/upgrade.rs",
        "src/version.rs",
        "src/watch.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_adopt",
        normal = True,
        normal_dev = True,
    ),
    compile_data = [
        "//core/quality/tiers:all",
        "//core/quality/tiers/gopls:gopls_standard.json",
        "//core/quality/tiers/gopls:gopls_strict.json",
        "//.github:workflows/dx-update.yml",
        "//cli/prebuilt:pins.bzl",
        "//patches/avro-cpp:iterator.patch",
    ],
    coverage_lib = ":dx_adopt",
    crate_name = "dx_adopt",
    crate_root = "src/lib.rs",
    data = glob(["src/*.rs"]) + [
        ":python_files",
        ":python_interpreter",
        "//:.bazelversion",
        "//:MODULE.bazel",
        "//:package.json",
        "//core/coreutils:applets",
        "//deploy/private/release:consumer/consumer.BUILD.bazel",
        "//deploy/private/release:consumer/lib.rs",
        "@dx_gazelle//:gazelle",
        "@dx_tools//:shellcheck",
    ],
    env = {
        "DX_CONSUMER_LIB": "$(rootpath //deploy/private/release:consumer/lib.rs)",
        "DX_CONSUMER_TEMPLATE": "$(rootpath //deploy/private/release:consumer/consumer.BUILD.bazel)",
        "DX_COREUTILS": "$(rootpaths //core/coreutils:applets)",
        "DX_GAZELLE": "$(rootpath @dx_gazelle//:gazelle)",
        "DX_PYTHON": "$(rootpath :python_interpreter)",
        "DX_SHELLCHECK": "$(rootpath @dx_tools//:shellcheck)",
    },
    visibility = VIS_CLI + [
        "//core/modules:__pkg__",
        "//tools/ci:__pkg__",
        "//tools/docs/support_matrix:__pkg__",
    ],
    deps = all_crate_deps(
        package_name = "cli/dx_adopt",
        normal = True,
        normal_dev = True,
    ) + [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/digest:dx_digest",
        "//cli/dx_config",
        "//cli/ecosystems:dx_ecosystems",
        "//cli/error:dx_error",
        "//cli/families:dx_families",
        "//cli/generate:dx_generate",
        "//cli/gomod:dx_gomod",
        "//cli/ide:dx_ide",
        "//cli/merge:dx_merge",
        "//cli/module_bazel:dx_module_bazel",
        "//cli/path:dx_path",
        "//cli/process:dx_process",
        "//cli/test_scratch:dx_test_scratch",
        "//core/modules:dx_versions",
        "//tools/bazelrc:dx_preset",
        "//tools/testing:dx_testing",
        "@crates//:serde_json",
    ],
)

alias(
    name = "python_interpreter",
    actual = "@python_3_12//:python3",
)

alias(
    name = "python_files",
    actual = "@python_3_12//:files",
)

exports_files([
    "src/launcher.rs",
    "src/lib.rs",
    "src/version.rs",
])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)
