load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:crate.bzl", "dx_rust_crate")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

dx_rust_crate(
    name = "dx_adopt",
    package_name = "cli/dx_adopt",
    srcs = [
        "src/build_output.rs",
        "src/defaults.rs",
        "src/dependency_sets.rs",
        "src/error.rs",
        "src/git_changes.rs",
        "src/lib.rs",
        "src/migrate.rs",
        "src/new.rs",
        "src/new_locks.rs",
        "src/policy.rs",
        "src/preset_fragment.rs",
        "src/scaffold.rs",
        "src/status.rs",
        "src/upgrade.rs",
        "src/version.rs",
        "src/watch.rs",
    ],
    dev_deps = [
        "insta",
        "serde_json",
    ],
    extra_deps = [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/fingerprint:dx_fingerprint",
        "//cli/identity:dx_identity",
        "//cli/path:dx_path",
        "//libs/module_bazel:dx_module_bazel",
        "//tools/bazelrc:dx_preset",
    ],
    extra_test_deps = ["//cli/test_scratch:dx_test_scratch"],
    test_data = [
        "//examples:consumer-ci/caller.yml",
        "//:MODULE.bazel",
        "//:package.json",
        "//modules:versions.bzl",
        ":python_interpreter",
    ],
    test_env = {"DX_PYTHON": "$(rootpath :python_interpreter)"},
    deps = [
        "notify",
        "notify-debouncer-mini",
        "semver",
        "serde",
        "thiserror",
        "toml",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = ["@platforms//os:linux", "@platforms//cpu:arm64"],
)

config_setting(
    name = "macos_arm64",
    constraint_values = ["@platforms//os:macos", "@platforms//cpu:arm64"],
)

config_setting(
    name = "macos_x86_64",
    constraint_values = ["@platforms//os:macos", "@platforms//cpu:x86_64"],
)

alias(
    name = "python_interpreter",
    actual = select({
        ":linux_arm64": "@@aspect_rules_py++python_interpreters+python_3_12_aarch64_unknown_linux_gnu//:bin/python3",
        ":macos_arm64": "@@aspect_rules_py++python_interpreters+python_3_12_aarch64_apple_darwin//:bin/python3",
        ":macos_x86_64": "@@aspect_rules_py++python_interpreters+python_3_12_x86_64_apple_darwin//:bin/python3",
        "//conditions:default": "@@aspect_rules_py++python_interpreters+python_3_12_x86_64_unknown_linux_gnu//:bin/python3",
    }),
)

exports_files([
    "src/lib.rs",
    "src/version.rs",
])

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
