load("@rules_dx//quality:fixtures.bzl", "real_source_target")

# gazelle:exclude eslint
_VISIBILITY = [
    "//cli/adopt:__subpackages__",
    "//quality/runner:__subpackages__",
    "//go/tests:__subpackages__",
    "//go/tools/analysis:__subpackages__",
    "//quality/testdata:__subpackages__",
    "//typescript/tests:__subpackages__",
    "//tools/testing/hermetic:__subpackages__",
]

exports_files(
    glob(["**/*"]),
    visibility = _VISIBILITY,
)

filegroup(
    name = "all",
    srcs = glob(["**/*"]),
    visibility = _VISIBILITY,
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = [
        "ruff/standard.toml",
        "ruff/strict.toml",
    ],
)
