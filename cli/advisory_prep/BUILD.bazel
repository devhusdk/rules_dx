load("@crates//:crates.bzl", "aliases")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_PUBLIC")

package(default_visibility = VIS_PUBLIC)

exports_files([
    "Cargo.toml",
    "src/archive.rs",
    "src/lib.rs",
    "src/lib_tests.rs",
    "src/main.rs",
    "src/main_tests.rs",
    "src/trivy.rs",
    "src/trivy_tests.rs",
    "src/yanked.rs",
])

rust_binary(
    name = "advisory_prep",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "cli/dx_advisory_prep",
        normal = True,
    ),
    crate_name = "advisory_prep",
    crate_root = "src/main.rs",
    data = [
        ":trivy",
        "//perl/private/tools:cpansa_dump",
    ],
    env = {
        "DX_CPANSA_DUMP": "$(rlocationpath //perl/private/tools:cpansa_dump)",
        "DX_TRIVY": "$(rlocationpath :trivy)",
    },
    # keep
    deps = [
        ":dx_advisory_prep",
        "//cli/audit:dx_audit",
        "//cli/error:dx_error",
        "@crates//:chrono",
        "@crates//:clap",
    ],
)

alias(
    name = "trivy",
    actual = "@dx_tools//:trivy",
)

rust_test(
    name = "dx_advisory_prep_test",
    srcs = [
        "src/archive.rs",
        "src/lib.rs",
        "src/lib_tests.rs",
        "src/trivy.rs",
        "src/trivy_tests.rs",
        "src/yanked.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_advisory_prep",
        normal = True,
        normal_dev = True,
    ),
    coverage_lib = ":dx_advisory_prep",
    crate_name = "dx_advisory_prep",
    crate_root = "src/lib.rs",
    # keep
    deps = [
        "//cli/adopt:dx_adopt",
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/audit:dx_audit",
        "//cli/digest:dx_digest",
        "//cli/families:dx_families",
        "//cli/update:dx_update",
        "@crates//:crc32fast",
        "@crates//:flate2",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tar",
        "@crates//:tempfile",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "advisory_prep_bin_test",
    srcs = [
        "src/main.rs",
        "src/main_tests.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_advisory_prep",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "advisory_prep",
    crate_root = "src/main.rs",
    # keep
    deps = [
        ":dx_advisory_prep",
        "//cli/audit:dx_audit",
        "//cli/error:dx_error",
        "@crates//:chrono",
        "@crates//:clap",
        "@crates//:tempfile",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

rust_library(
    name = "dx_advisory_prep",
    srcs = [
        "src/archive.rs",
        "src/lib.rs",
        "src/trivy.rs",
        "src/yanked.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_advisory_prep",
        normal = True,
    ),
    crate_name = "dx_advisory_prep",
    crate_root = "src/lib.rs",
    # keep
    deps = [
        "//cli/adopt:dx_adopt",
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/audit:dx_audit",
        "//cli/digest:dx_digest",
        "//cli/update:dx_update",
        "@crates//:crc32fast",
        "@crates//:flate2",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tar",
        "@crates//:tempfile",
        "@crates//:thiserror",
    ],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
