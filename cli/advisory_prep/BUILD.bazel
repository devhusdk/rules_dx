load("@crates//:crates.bzl", "aliases")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_PUBLIC")

package(default_visibility = VIS_PUBLIC)

exports_files([
    "Cargo.toml",
    "src/archive.rs",
    "src/lib.rs",
    "src/lib_tests.rs",
    "src/trivy.rs",
    "src/trivy_tests.rs",
    "src/yanked.rs",
])

rust_test(
    name = "dx_advisory_prep_test",
    size = "small",
    srcs = [
        "src/archive.rs",
        "src/lib.rs",
        "src/lib_tests.rs",
        "src/trivy.rs",
        "src/trivy_tests.rs",
        "src/yanked.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_advisory_prep",
        normal = True,
        normal_dev = True,
    ),
    coverage_lib = ":dx_advisory_prep",
    crate_name = "dx_advisory_prep",
    crate_root = "src/lib.rs",
    # keep
    deps = [
        "//cli/adopt:dx_adopt",
        "//cli/archive:dx_archive",
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/audit:dx_audit",
        "//cli/digest:dx_digest",
        "//cli/ecosystems:dx_ecosystems",
        "//cli/families:dx_families",
        "//cli/update:dx_update",
        "@crates//:crc32fast",
        "@crates//:flate2",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:thiserror",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

rust_library(
    name = "dx_advisory_prep",
    srcs = [
        "src/archive.rs",
        "src/lib.rs",
        "src/trivy.rs",
        "src/yanked.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_advisory_prep",
        normal = True,
    ),
    crate_name = "dx_advisory_prep",
    crate_root = "src/lib.rs",
    # keep
    deps = [
        "//cli/adopt:dx_adopt",
        "//cli/archive:dx_archive",
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/audit:dx_audit",
        "//cli/digest:dx_digest",
        "//cli/ecosystems:dx_ecosystems",
        "//cli/update:dx_update",
        "@crates//:crc32fast",
        "@crates//:flate2",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:thiserror",
    ],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
