load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

rust_library(
    name = "dx_apply",
    srcs = [
        "src/applier.rs",
        "src/consensus.rs",
        "src/envelope.rs",
        "src/lib.rs",
        "src/validators.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_apply",
        normal = True,
    ),
    crate_name = "dx_apply",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_apply",
        normal = True,
    ) + [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/digest:dx_digest",
        "//cli/path:dx_path",
        "@crates//:serde",
    ],
)

rust_test(
    name = "dx_apply_test",
    size = "small",
    aliases = aliases(
        package_name = "cli/dx_apply",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_apply",
    deps = all_crate_deps(
        package_name = "cli/dx_apply",
        normal = True,
        normal_dev = True,
    ) + [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/digest:dx_digest",
        "//cli/path:dx_path",
        "//cli/test_scratch:dx_test_scratch",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files([
    "src/lib.rs",
])

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)
