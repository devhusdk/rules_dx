load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI_DEPLOY_ENV_GENERATION_QUALITY")

package(default_visibility = VIS_CLI_DEPLOY_ENV_GENERATION_QUALITY + [
    "//android/private/packaging/ops:__pkg__",
    "//appimage/private/tools/packer:__pkg__",
    "//apple/private/tools/ops:__pkg__",
    "//tools/ci/producers:__pkg__",
    "//tools/coverage/sancov:__pkg__",
    "//tools/docs/ir/ir:__pkg__",
    "//tools/docs/site/browser:__pkg__",
    "//tools/docs/site/build:__pkg__",
    "//tools/docs/support_matrix:__pkg__",
    "//tools/docs/tiers:__pkg__",
    "//tools/testing:__pkg__",
    "//tools/testing/hermetic:__pkg__",
    "//tools/testing/nested:__pkg__",
])

exports_files([
    "src/commit.rs",
    "src/lease.rs",
    "src/lib.rs",
    "src/managed.rs",
    "src/path_io.rs",
])

rust_library(
    name = "dx_atomic_fs",
    srcs = [
        "src/commit.rs",
        "src/lease.rs",
        "src/lib.rs",
        "src/managed.rs",
        "src/path_io.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_atomic_fs",
        normal = True,
    ),
    crate_name = "dx_atomic_fs",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_atomic_fs",
        normal = True,
    ) + ["//cli/path:dx_path"],
)

rust_test(
    name = "dx_atomic_fs_test",
    size = "small",
    aliases = aliases(
        package_name = "cli/dx_atomic_fs",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_atomic_fs",
    deps = all_crate_deps(
        package_name = "cli/dx_atomic_fs",
        normal = True,
        normal_dev = True,
    ) + [
        "//cli/path:dx_path",
        "//cli/test_scratch:dx_test_scratch",
        "//cli/test_wait:dx_test_wait",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
