load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:crate.bzl", "dx_rust_crate")
load("//rust/rules:defs.bzl", "rust_binary")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

exports_files([
    "schema/licenses.schema.json",
    "schema/security.schema.json",
    "src/lib.rs",
], visibility = ["//visibility:public"])

dx_rust_crate(
    name = "dx_audit",
    package_name = "cli/dx_audit",
    srcs = [
        "src/advisory.rs",
        "src/advisory_prep.rs",
        "src/backend.rs",
        "src/config_schema.rs",
        "src/curator.rs",
        "src/exception.rs",
        "src/exception_apply.rs",
        "src/exception_npm.rs",
        "src/lib.rs",
        "src/license_expr.rs",
        "src/license_notice.rs",
        "src/license_policy.rs",
        "src/locks.rs",
        "src/locks_bazel.rs",
        "src/locks_cargo.rs",
        "src/locks_licenses.rs",
        "src/locks_npm.rs",
        "src/locks_paket.rs",
        "src/locks_pnpm.rs",
        "src/locks_conan.rs",
        "src/locks_cpan.rs",
        "src/locks_pub.rs",
        "src/locks_ruby.rs",
        "src/locks_uv.rs",
        "src/notice_manifest.rs",
        "src/outcome.rs",
        "src/secrets.rs",
        "src/vuln.rs",
        "src/vuln_go.rs",
        "src/vuln_match.rs",
        "src/vuln_maven.rs",
        "src/vuln_nuget.rs",
        "src/vuln_pypi.rs",
        "src/vuln_ruby.rs",
        "src/vuln_snapshot.rs",
        "src/vuln_types.rs",
        "src/vuln_versions.rs",
    ],
    compile_data = [
        "schema/licenses.schema.json",
        "schema/security.schema.json",
        "//:licenses.toml",
        "//:security.toml",
        "//docs:cli/commands/config.md",
    ],
    dev_deps = [
        "jsonschema",
        "tempfile",
    ],
    extra_deps = [
        "//cli/digest:dx_digest",
        "//cli/sbom:dx_sbom",
        "//libs/gomod:dx_gomod",
        "//libs/module_bazel:dx_module_bazel",
    ],
    extra_test_deps = ["//cli/sbom/schema:dx_sbom_schema"],
    test_srcs = [
        "src/advisory_prep_tests.rs",
        "src/config_schema_tests.rs",
        "src/exception_tests.rs",
        "src/license_policy_tests.rs",
        "src/locks_bazel_tests.rs",
        "src/locks_tests.rs",
        "src/vuln_tests.rs",
    ],
    visibility = VIS_CLI + ["//deploy/release:__pkg__"],
    deps = [
        "cargo-lock",
        "chrono",
        "mvn_version",
        "nodejs-semver",
        "osv",
        "packageurl",
        "pep440_rs",
        "regex",
        "schemars",
        "semver",
        "serde",
        "serde-sarif",
        "serde_json",
        "spdx",
        "thiserror",
        "toml",
        "url",
        "yaml_serde",
        "yarn-lock-parser",
    ],
)

rust_binary(
    name = "config_schemas",
    srcs = ["src/bin_config_schemas.rs"],
    crate_name = "config_schemas",
    crate_root = "src/bin_config_schemas.rs",
    edition = "2021",
    deps = [":dx_audit"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
