{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Distribution": {
      "additionalProperties": false,
      "properties": {
        "internal": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "type": "object"
    },
    "LicenseException": {
      "additionalProperties": false,
      "properties": {
        "expires": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "set": {
          "type": "string"
        },
        "versions": {
          "type": "string"
        }
      },
      "required": [
        "package",
        "set",
        "license",
        "versions",
        "reason",
        "expires"
      ],
      "type": "object"
    },
    "LicenseInventory": {
      "additionalProperties": false,
      "properties": {
        "license": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "set": {
          "type": "string"
        },
        "text": {
          "default": null,
          "description": "Workspace-relative path of the vendored license words; implies\n`text_present`.",
          "type": [
            "string",
            "null"
          ]
        },
        "text_present": {
          "default": false,
          "type": "boolean"
        },
        "versions": {
          "type": "string"
        }
      },
      "required": [
        "package",
        "set",
        "license",
        "versions"
      ],
      "type": "object"
    },
    "PolicyFile": {
      "additionalProperties": false,
      "properties": {
        "blocked": {
          "default": null,
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "distributed": {
          "$ref": "#/definitions/PolicyLists"
        },
        "sets": {
          "additionalProperties": {
            "$ref": "#/definitions/SetReview"
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "PolicyLists": {
      "additionalProperties": false,
      "properties": {
        "allow": {
          "default": null,
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "deny": {
          "default": null,
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "review": {
          "default": null,
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "SetReview": {
      "additionalProperties": false,
      "properties": {
        "review": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  },
  "properties": {
    "distribution": {
      "anyOf": [
        {
          "$ref": "#/definitions/Distribution"
        },
        {
          "type": "null"
        }
      ]
    },
    "exception": {
      "items": {
        "$ref": "#/definitions/LicenseException"
      },
      "type": "array"
    },
    "inventory": {
      "items": {
        "$ref": "#/definitions/LicenseInventory"
      },
      "type": "array"
    },
    "policy": {
      "$ref": "#/definitions/PolicyFile"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "licenses.toml",
  "type": "object"
}
