load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

exports_files([
    "src/lib.rs",
])

rust_library(
    name = "dx_bep",
    srcs = [
        "src/cache_errors.rs",
        "src/failures.rs",
        "src/ledger.rs",
        "src/lib.rs",
        "src/metrics.rs",
        "src/outputs.rs",
        "src/test_outputs.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_bep",
        normal = True,
    ),
    crate_name = "dx_bep",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_bep",
        normal = True,
    ) + [
        "//cli/path:dx_path",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "dx_bep_test",
    size = "small",
    aliases = aliases(
        package_name = "cli/dx_bep",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_bep",
    deps = all_crate_deps(
        package_name = "cli/dx_bep",
        normal = True,
        normal_dev = True,
    ) + ["//cli/path:dx_path"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)
