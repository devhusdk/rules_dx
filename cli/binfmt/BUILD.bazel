load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI_DEPLOY_QUALITY_TOOLS")

package(default_visibility = VIS_CLI_DEPLOY_QUALITY_TOOLS)

exports_files([
    "src/lib.rs",
])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

rust_library(
    name = "dx_binfmt",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "cli/dx_binfmt",
        normal = True,
    ),
    crate_name = "dx_binfmt",
    crate_root = "src/lib.rs",
    visibility = VIS_CLI_DEPLOY_QUALITY_TOOLS + ["//cc/tests/msvc_x86_64:__pkg__"],
    deps = all_crate_deps(
        package_name = "cli/dx_binfmt",
        normal = True,
    ),
)

rust_test(
    name = "dx_binfmt_test",
    size = "small",
    srcs = [
        "src/lib.rs",
        "src/tests.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_binfmt",
        normal = True,
        normal_dev = True,
    ),
    coverage_lib = ":dx_binfmt",
    crate_name = "dx_binfmt",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_binfmt",
        normal = True,
        normal_dev = True,
    ),
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)
