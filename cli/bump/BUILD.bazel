load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:crate.bzl", "dx_rust_crate")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

exports_files([
    "src/lib.rs",
])

filegroup(
    name = "sets_source",
    srcs = [
        "src/gha.rs",
        "src/sets.rs",
    ],
    visibility = ["//tools/ci:__pkg__"],
)

dx_rust_crate(
    name = "dx_bump",
    package_name = "cli/dx_bump",
    srcs = [
        "src/gha.rs",
        "src/lib.rs",
        "src/request.rs",
        "src/request_cargo.rs",
        "src/request_plans.rs",
        "src/request_tests.rs",
        "src/sets.rs",
        "src/version.rs",
    ],
    dev_deps = ["toml"],
    extra_deps = [
        "//cli/digest:dx_digest",
        "//cli/identity:dx_identity",
    ],
    deps = [
        "regex",
        "semver",
        "serde_json",
        "thiserror",
        "toml_edit",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
