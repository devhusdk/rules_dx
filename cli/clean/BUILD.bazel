    name = "dx_clean",
    package_name = "cli/dx_clean",
    srcs = [
        "src/bytes.rs",
        "src/lib.rs",
    ],
    extra_deps = [
        "//cli/path:dx_path",
        "//cli/setup:dx_setup",
    ],
    extra_test_deps = [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/test_scratch:dx_test_scratch",
    ],
    test_srcs = ["src/fixtures.rs"],
    deps = ["walkdir"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
