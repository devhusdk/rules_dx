# MSVC opt links keep the PDB, remapped against X:\dx so it matches across checkouts (#8410).
filegroup(
    name = "dx_pdb",
    srcs = [":dx"],
    output_group = "pdb_file",
    visibility = ["//visibility:public"],
)

dx_msvc_opt_pdb_tests(
    name = "dx_opt_pdb_test",
    expected = "dx_upstream.pdb",
    target = ":dx",
)

github_deploy(
    name = "github_draft",
    artifacts = [],
)

rust_binary(
    name = "dx_man",
    srcs = ["src/bin_man.rs"],
    aliases = aliases(
        package_name = "cli/dx_cli",
        normal = True,
    ),
    crate_name = "dx_man",
    crate_root = "src/bin_man.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_cli",
        normal = True,
    ) + [
        ":dx_cli",
        "//cli/error:dx_error",
        "//cli/output:dx_output",
        "//cli/plan:dx_plan",
    ],
)

genrule(
    name = "man_pages",
    outs = ["man/dx.1"],
    cmd = "$(location :dx_man) $(OUTS)",
    tools = [":dx_man"],
    visibility = ["//visibility:public"],
)

