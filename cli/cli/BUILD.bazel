# MSVC opt links keep the PDB, remapped against X:\dx so it matches across checkouts.
filegroup(
    name = "dx_pdb",
    srcs = [":dx"],
    output_group = "pdb_file",
    visibility = ["//visibility:public"],
)

rust_msvc_opt_pdb_tests(
    name = "dx_opt_pdb_test",
    expected = "dx_upstream.pdb",
    target = ":dx",
)

