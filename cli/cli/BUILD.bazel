rust_binary(
    name = "dx",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "cli/dx_cli",
        normal = True,
    ),
    crate_name = "dx",
    crate_root = "src/main.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = crate_deps(
        [
            "base64",
            "chrono",
            "clap",
            "clap_complete",
            "clap_mangen",
            "libc",
            "line-index",
            "quick-junit",
            "quick-xml",
            "serde",
            "serde-sarif",
            "serde_json",
            "strsim",
            "tempfile",
            "thiserror",
            "tracing",
        ],
        package_name = "cli/dx_cli",
    ) + [
        ":dx_cli",
        "//cli/output:dx_output",
        "//cli/process:dx_process",
    ],
)

github_deploy(
    name = "github_draft",
    artifacts = [
        ":dx",
        ":man_pages",
    ],
)

archive_deploy(
    name = "dx_standalone",
    app = ":dx",
)

