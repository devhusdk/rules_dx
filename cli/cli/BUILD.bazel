rust_binary(
    name = "dx",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "cli/dx_cli",
        normal = True,
    ),
    crate_name = "dx",
    crate_root = "src/main.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        package_name = "cli/dx_cli",
        normal = True,
    ) + [
        ":dx_cli",
        "//cli/output:dx_output",
        "//cli/process:dx_process",
    ],
)

github_deploy(
    name = "github_draft",
    artifacts = [
        ":dx",
        ":man_pages",
    ],
)

archive_deploy(
    name = "dx_standalone",
    app = ":dx",
)

rust_binary(
    name = "dx_man",
    srcs = ["src/bin_man.rs"],
    aliases = aliases(
        package_name = "cli/dx_cli",
        normal = True,
    ),
    crate_name = "dx_man",
    crate_root = "src/bin_man.rs",
    edition = "2021",
    deps = all_crate_deps(
        package_name = "cli/dx_cli",
        normal = True,
    ) + [
        ":dx_cli",
        "//cli/output:dx_output",
    ],
)

genrule(
    name = "man_pages",
    outs = ["man/dx.1"],
    cmd = "$(location :dx_man) $(OUTS)",
    tools = [":dx_man"],
    visibility = ["//visibility:public"],
)

