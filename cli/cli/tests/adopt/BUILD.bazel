load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust:defs.bzl", "rust_test")

package(default_testonly = True)

rust_test(
    name = "adopt_test",
    testonly = True,
    srcs = ["tests/adopt.rs"],
    crate_name = "adopt",
    crate_root = "tests/adopt.rs",
    data = [
        "golden/fresh_init_dx.txt",
        "//cli/cli:dx",
        "//examples/adopt-polyglot:Cargo.lock",
        "//examples/adopt-polyglot:Cargo.toml",
        "//examples/adopt-polyglot:package.json",
        "//examples/adopt-polyglot:pnpm-lock.yaml",
        "//examples/adopt-polyglot:pyproject.toml",
        "//examples/adopt-polyglot:uv.lock",
    ],
    env = {
        "DX_BIN": "$(rootpath //cli/cli:dx)",
        "DX_FRESH_INIT_GOLDEN": "$(rootpath golden/fresh_init_dx.txt)",
        "DX_POLYGLOT_CARGO_LOCK": "$(rootpath //examples/adopt-polyglot:Cargo.lock)",
        "DX_POLYGLOT_CARGO_TOML": "$(rootpath //examples/adopt-polyglot:Cargo.toml)",
        "DX_POLYGLOT_PACKAGE_JSON": "$(rootpath //examples/adopt-polyglot:package.json)",
        "DX_POLYGLOT_PNPM_LOCK_YAML": "$(rootpath //examples/adopt-polyglot:pnpm-lock.yaml)",
        "DX_POLYGLOT_PYPROJECT_TOML": "$(rootpath //examples/adopt-polyglot:pyproject.toml)",
        "DX_POLYGLOT_UV_LOCK": "$(rootpath //examples/adopt-polyglot:uv.lock)",
        "RUST_TEST_THREADS": "1",
    },
    env_inherit = ["PATH"],
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)
