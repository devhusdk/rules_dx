load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")
load("//tools/testing:nested_bazel.bzl", "NESTED_BAZEL_TAGS")

package(default_testonly = True)

rust_test(
    name = "affected_test",
    testonly = True,
    srcs = [
        "tests/affected.rs",
        "tests/support/mod.rs",
    ],
    crate_name = "affected",
    crate_root = "tests/affected.rs",
    data = ["//cli/cli:dx"],
    env = {
        "DX_BIN": "$(rootpath //cli/cli:dx)",
        "RUST_TEST_THREADS": "1",
    },
    env_inherit = [
        "HOME",
        "PATH",
    ],
    tags = NESTED_BAZEL_TAGS,
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing:dx_nested",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "affected_incompatible_test",
    testonly = True,
    srcs = [
        "tests/incompatible.rs",
        "tests/support/mod.rs",
    ],
    crate_name = "incompatible",
    crate_root = "tests/incompatible.rs",
    data = ["//cli/cli:dx"],
    env = {
        "DX_BIN": "$(rootpath //cli/cli:dx)",
        "RUST_TEST_THREADS": "1",
    },
    env_inherit = [
        "HOME",
        "PATH",
    ],
    tags = NESTED_BAZEL_TAGS,
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing:dx_nested",
        "//tools/testing:dx_testing",
    ],
)

rustfmt_test(
    name = "affected_fmt_test",
    size = "small",
    targets = [
        ":affected_incompatible_test",
        ":affected_test",
    ],
)

rust_clippy_test(
    name = "affected_clippy_test",
    size = "small",
    targets = [
        ":affected_incompatible_test",
        ":affected_test",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)
