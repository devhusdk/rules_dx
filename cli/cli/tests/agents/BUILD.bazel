load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust/rules:defs.bzl", "rust_test")

package(default_testonly = True)

rust_test(
    name = "agents_test",
    testonly = True,
    srcs = ["tests/agents.rs"],
    crate_name = "agents",
    crate_root = "tests/agents.rs",
    data = [
        "//:MODULE.bazel",
        "//cli/cli:dx",
    ],
    env = {
        "DX_BIN": "$(rootpath //cli/cli:dx)",
        "DX_MODULE": "$(rootpath //:MODULE.bazel)",
        "RUST_TEST_THREADS": "1",
    },
    env_inherit = [
        "PATH",
    ],
    tags = [
        "local",
        "no-sandbox",
    ],
    deps = [
        "//cli/process:dx_process",
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "dev_launcher_test",
    testonly = True,
    srcs = ["tests/dev_launcher.rs"],
    crate_name = "dev_launcher",
    crate_root = "tests/dev_launcher.rs",
    data = [
        "//:MODULE.bazel",
        "//tools:dx",
        "//tools:dx.cmd",
        "//tools/testing/process_probe",
    ],
    env = {
        "DX_LAUNCHER_CMD": "$(rootpath //tools:dx.cmd)",
        "DX_LAUNCHER_SH": "$(rootpath //tools:dx)",
        "DX_MODULE": "$(rootpath //:MODULE.bazel)",
        "DX_PROCESS_PROBE": "$(rootpath //tools/testing/process_probe)",
    },
    deps = [
        "//cli/path:dx_path",
        "//cli/process:dx_process",
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)
