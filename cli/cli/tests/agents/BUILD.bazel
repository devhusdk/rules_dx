load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust:defs.bzl", "rust_test")

package(default_testonly = True)

rust_test(
    name = "agents_test",
    size = "small",
    testonly = True,
    srcs = ["tests/agents.rs"],
    crate_name = "agents",
    crate_root = "tests/agents.rs",
    data = [
        "//:.claude/settings.json",
        "//:AGENTS.md",
        "//:MODULE.bazel",
        "//cli/cli:dx",
        "//cli/cli/tests/fake_generate",
    ],
    env = {
        "DX_AGENTS_MD": "$(rootpath //:AGENTS.md)",
        "DX_BIN": "$(rootpath //cli/cli:dx)",
        "DX_CLAUDE_SETTINGS": "$(rootpath //:.claude/settings.json)",
        "DX_FAKE_GENERATE": "$(rootpath //cli/cli/tests/fake_generate)",
        "RUST_TEST_THREADS": "1",
    },
    # keep
    deps = select({
        "@platforms//os:windows": [],
        "//conditions:default": [
            "//cli/test_scratch:dx_test_scratch",
            "//tools/testing:dx_testing",
        ],
    }),
)

rust_test(
    name = "dev_launcher_test",
    size = "small",
    testonly = True,
    srcs = ["tests/dev_launcher.rs"],
    crate_name = "dev_launcher",
    crate_root = "tests/dev_launcher.rs",
    data = [
        "//:MODULE.bazel",
        "//core/coreutils:applets",
        "//tools:bazel",
        "//tools:dx",
        "//tools:dx.cmd",
        "//tools/testing/process_probe",
    ],
    env = {
        "DX_BAZEL_WRAPPER": "$(rootpath //tools:bazel)",
        "DX_COREUTILS": "$(rootpaths //core/coreutils:applets)",
        "DX_LAUNCHER_CMD": "$(rootpath //tools:dx.cmd)",
        "DX_LAUNCHER_SH": "$(rootpath //tools:dx)",
        "DX_MODULE": "$(rootpath //:MODULE.bazel)",
        "DX_PROCESS_PROBE": "$(rootpath //tools/testing/process_probe)",
    },
    deps = [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/path:dx_path",
        "//cli/process:dx_process",
        "//cli/test_scratch:dx_test_scratch",
        "//cli/test_wait:dx_test_wait",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
