load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")

package(default_testonly = True)

rust_test(
    name = "agents_test",
    testonly = True,
    srcs = ["tests/agents.rs"],
    crate_name = "agents",
    crate_root = "tests/agents.rs",
    data = [
        "//:MODULE.bazel",
        "//cli/cli:dx",
    ],
    env = {
        "DX_BIN": "$(rootpath //cli/cli:dx)",
        "DX_MODULE": "$(rootpath //:MODULE.bazel)",
        "RUST_TEST_THREADS": "1",
    },
    env_inherit = [
        "PATH",
    ],
    tags = [
        "local",
        "no-sandbox",
    ],
    deps = ["//tools/testing:dx_testing"],
)

rustfmt_test(
    name = "agents_fmt_test",
    size = "small",
    targets = [":agents_test"],
)

rust_clippy_test(
    name = "agents_clippy_test",
    size = "small",
    targets = [":agents_test"],
)

rust_test(
    name = "dev_launcher_test",
    testonly = True,
    srcs = ["tests/dev_launcher.rs"],
    crate_name = "dev_launcher",
    crate_root = "tests/dev_launcher.rs",
    data = [
        "//:MODULE.bazel",
        "//tools:dx",
        "//tools:dx.cmd",
        "//tools/testing/process_probe",
    ],
    env = {
        "DX_LAUNCHER_CMD": "$(rootpath //tools:dx.cmd)",
        "DX_LAUNCHER_SH": "$(rootpath //tools:dx)",
        "DX_MODULE": "$(rootpath //:MODULE.bazel)",
        "DX_PROCESS_PROBE": "$(rootpath //tools/testing/process_probe)",
    },
    deps = [
        "//cli/process:dx_process",
        "//tools/testing:dx_testing",
    ],
)

rustfmt_test(
    name = "dev_launcher_fmt_test",
    size = "small",
    targets = [":dev_launcher_test"],
)

rust_clippy_test(
    name = "dev_launcher_clippy_test",
    size = "small",
    targets = [":dev_launcher_test"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)
