load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust/rules:defs.bzl", "rust_test")
load("//tools/testing:nested_bazel.bzl", "NESTED_BAZEL_TAGS")

package(default_testonly = True)

rust_test(
    name = "cli_argv_e2e_test",
    timeout = "moderate",
    testonly = True,
    srcs = [
        "tests/cli_argv_e2e.rs",
        "tests/support/mod.rs",
    ],
    crate_name = "cli_argv_e2e",
    crate_root = "tests/cli_argv_e2e.rs",
    data = ["//cli/cli:dx"],
    env = {
        "DX_BIN": "$(rootpath //cli/cli:dx)",
        "RUST_TEST_THREADS": "1",
    },
    env_inherit = [
        "HOME",
        "PATH",
    ],
    tags = NESTED_BAZEL_TAGS,
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing:dx_testing",
        "//tools/testing/nested:dx_nested",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)
