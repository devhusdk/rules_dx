load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")

package(default_testonly = True)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

rust_test(
    name = "configured_discovery_test",
    testonly = True,
    srcs = ["tests/configured_discovery.rs"],
    crate_name = "configured_discovery",
    crate_root = "tests/configured_discovery.rs",
    data = ["//cli/cli:dx"],
    env = {
        "DX_BIN": "$(rootpath //cli/cli:dx)",
        "RUST_TEST_THREADS": "1",
    },
    env_inherit = [
        "HOME",
        "PATH",
    ],
    tags = [
        "exclusive",
        "local",
        "no-sandbox",
    ],
    deps = ["//tools/testing:dx_testing"],
)

rustfmt_test(
    name = "configured_discovery_fmt_test",
    size = "small",
    targets = [":configured_discovery_test"],
)

rust_clippy_test(
    name = "configured_discovery_clippy_test",
    size = "small",
    targets = [":configured_discovery_test"],
)
