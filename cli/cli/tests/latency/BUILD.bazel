load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")

package(default_testonly = True)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

rust_test(
    name = "latency_test",
    testonly = True,
    srcs = ["tests/latency.rs"],
    crate_name = "latency",
    crate_root = "tests/latency.rs",
    data = ["//cli/cli:dx"],
    env = {
        "DX_BIN": "$(rootpath //cli/cli:dx)",
    },
    tags = [
        "local",
        "no-sandbox",
    ],
    deps = ["//tools/testing:dx_testing"],
)

rustfmt_test(
    name = "latency_fmt_test",
    size = "small",
    targets = [":latency_test"],
)

rust_clippy_test(
    name = "latency_clippy_test",
    size = "small",
    targets = [":latency_test"],
)
