load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")
load("@rules_dx//tools/testing:nested_bazel.bzl", "NESTED_BAZEL_COMPATIBLE_WITH", "NESTED_BAZEL_DATA", "NESTED_BAZEL_NETWORK_ENV", "NESTED_BAZEL_NETWORK_TAGS")

package(default_testonly = True)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

rust_test(
    name = "nuget_sets_test",
    testonly = True,
    srcs = ["tests/nuget_sets.rs"],
    crate_name = "nuget_sets",
    crate_root = "tests/nuget_sets.rs",
    data = [
        "tests/nuget_sets.rs",
        "//cli/cli:dx",
    ] + NESTED_BAZEL_DATA,
    env = {
        "DX_BIN": "$(rootpath //cli/cli:dx)",
        "RUST_TEST_THREADS": "1",
    } | NESTED_BAZEL_NETWORK_ENV,
    env_inherit = [
        "HOME",
        "PATH",
    ],
    tags = NESTED_BAZEL_NETWORK_TAGS,
    target_compatible_with = NESTED_BAZEL_COMPATIBLE_WITH,
    deps = [
        "//tools/testing:dx_nested",
        "//tools/testing:dx_testing",
    ],
)

rustfmt_test(
    name = "nuget_sets_fmt_test",
    size = "small",
    targets = [":nuget_sets_test"],
)

rust_clippy_test(
    name = "nuget_sets_clippy_test",
    size = "small",
    targets = [":nuget_sets_test"],
)

exports_files(
    ["tests/nuget_sets.rs"],
    visibility = ["//modules:__pkg__"],
)
