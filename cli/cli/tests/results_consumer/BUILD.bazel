load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")
load("@rules_dx//tools/testing:nested_bazel.bzl", "NESTED_BAZEL_COMPATIBLE_WITH", "NESTED_BAZEL_DATA", "NESTED_BAZEL_NETWORK_ENV", "NESTED_BAZEL_NETWORK_TAGS")

package(default_testonly = True)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

# keep
rust_test(
    name = "test_results_consumer_test",
    size = "enormous",
    testonly = True,
    srcs = [
        "tests/common/mod.rs",
        "tests/test_results.rs",
    ],
    crate_name = "test_results_consumer",
    crate_root = "tests/test_results.rs",
    data = [
        "tests/common/mod.rs",
        "//cli/cli:dx",
    ] + NESTED_BAZEL_DATA,
    env = {
        "DX_BIN": "$(rootpath //cli/cli:dx)",
        "RUST_TEST_THREADS": "1",
    } | NESTED_BAZEL_NETWORK_ENV,
    env_inherit = [
        "HOME",
        "PATH",
    ],
    tags = NESTED_BAZEL_NETWORK_TAGS,
    target_compatible_with = NESTED_BAZEL_COMPATIBLE_WITH,
    deps = ["//tools/testing:dx_testing"],
)

rustfmt_test(
    name = "results_consumer_fmt_test",
    size = "small",
    targets = [":test_results_consumer_test"],
)

rust_clippy_test(
    name = "results_consumer_clippy_test",
    size = "small",
    targets = [":test_results_consumer_test"],
)
