load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI_GENERATION")

# gazelle:resolve rust proto //core/codegen/proto:codegen_proto_rs
# gazelle:resolve rust codegen_proto //core/codegen/proto:codegen_proto_rs

package(default_visibility = VIS_CLI_GENERATION)

rust_library(
    name = "codegen_shard",
    srcs = [
        "src/lib.rs",
        "src/writer.rs",
    ],
    aliases = aliases(
        package_name = "cli/codegen_shard",
        normal = True,
    ),
    crate_name = "codegen_shard",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/codegen_shard",
        normal = True,
    ) + [
        "//cli/path:dx_path",
        "//core/codegen/proto:codegen_proto_rs",
        "//libs/shard_writer:dx_shard_writer",
        "@rules_rust_prost//private/3rdparty/crates:prost",
    ],
)

rust_binary(
    name = "codegen_shard_writer",
    srcs = ["src/main.rs"],
    crate_name = "codegen_shard_writer",
    crate_root = "src/main.rs",
    visibility = ["//visibility:public"],
    deps = [":codegen_shard"],
)

rust_test(
    name = "codegen_shard_test",
    aliases = aliases(
        package_name = "cli/codegen_shard",
        normal = True,
        normal_dev = True,
    ),
    crate = ":codegen_shard",
    deps = all_crate_deps(
        package_name = "cli/codegen_shard",
        normal = True,
        normal_dev = True,
    ) + [
        "//core/codegen/proto:codegen_proto_rs",
        "@rules_rust_prost//private/3rdparty/crates:prost",
    ],
)

exports_files([
    "Cargo.toml",
    "src/lib.rs",
    "src/main.rs",
])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
