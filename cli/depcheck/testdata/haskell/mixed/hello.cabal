cabal-version: 2.4
name:          hello
version:       0.1.0.0

library
  hs-source-dirs:   src
  exposed-modules:  Hello
  build-depends:
      base        >=4.14 && <5
    , aeson       ^>=2.1
    , containers  >=0.6 && <0.7
    , text        ==2.0.*

test-suite spec
  type:           exitcode-stdio-1.0
  main-is:        Spec.hs
  hs-source-dirs: test
  build-depends:  base, hello, hspec ^>=2.10
