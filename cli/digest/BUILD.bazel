load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI_DEPLOY_GENERATION_QUALITY")

package(default_visibility = VIS_CLI_DEPLOY_GENERATION_QUALITY)

exports_files([
    "src/lib.rs",
])

rust_library(
    name = "dx_digest",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "cli/dx_digest",
        normal = True,
    ),
    crate_name = "dx_digest",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_digest",
        normal = True,
    ),
)

rust_test(
    name = "dx_digest_test",
    size = "small",
    aliases = aliases(
        package_name = "cli/dx_digest",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_digest",
    deps = all_crate_deps(
        package_name = "cli/dx_digest",
        normal = True,
        normal_dev = True,
    ),
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)
