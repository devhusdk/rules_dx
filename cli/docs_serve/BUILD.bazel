load("@crates//:crates.bzl", "aliases")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI_WIDE")

package(default_visibility = VIS_CLI_WIDE)

exports_files(["src/lib.rs"])

rust_library(
    name = "dx_docs_serve",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "cli/dx_docs_serve",
        normal = True,
    ),
    crate_name = "dx_docs_serve",
    crate_root = "src/lib.rs",
    deps = [],
)

rust_test(
    name = "dx_docs_serve_test",
    size = "small",
    aliases = aliases(
        package_name = "cli/dx_docs_serve",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_docs_serve",
    deps = ["//cli/test_scratch:dx_test_scratch"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)
