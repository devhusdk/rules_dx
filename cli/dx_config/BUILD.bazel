load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//quality:dx_config_gen.bzl", "dx_config_gen")
load("//rust/rules:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

exports_files(
    [
        "Cargo.toml",
        "schema/dx.schema.json",
        "src/lib.rs",
    ],
    visibility = ["//visibility:public"],
)

dx_config_gen(name = "update_curated_defaults")

rust_library(
    name = "dx_config",
    srcs = [
        "src/config.rs",
        "src/conventions.rs",
        "src/curated_defaults_gen.rs",
        "src/lib.rs",
        "src/schema.rs",
        "src/select.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_config",
        normal = True,
    ),
    compile_data = ["schema/dx.schema.json"],
    crate_name = "dx_config",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_config",
        normal = True,
    ) + ["@crates//:serde"],
)

rust_test(
    name = "dx_config_test",
    size = "small",
    srcs = [
        "src/config.rs",
        "src/config_tests.rs",
        "src/conventions.rs",
        "src/conventions_tests.rs",
        "src/curated_defaults_gen.rs",
        "src/lib.rs",
        "src/schema.rs",
        "src/schema_tests.rs",
        "src/select.rs",
        "src/select_tests.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_config",
        normal = True,
        normal_dev = True,
    ),
    compile_data = ["schema/dx.schema.json"],
    coverage_lib = ":dx_config",
    crate_name = "dx_config",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_config",
        normal = True,
        normal_dev = True,
    ) + ["@crates//:serde"],
)

# keep: not in Cargo.toml; Gazelle would delete it
rust_binary(
    name = "update_schema",
    srcs = ["src/bin_schema.rs"],
    crate_name = "update_schema",
    crate_root = "src/bin_schema.rs",
    deps = [":dx_config"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
