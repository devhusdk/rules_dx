load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//quality:dx_config_gen.bzl", "dx_config_gen")
load("//rust/rules:crate.bzl", "dx_rust_crate")
load("//rust/rules:defs.bzl", "rust_binary")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

exports_files(
    [
        "schema/dx.schema.json",
        "src/lib.rs",
    ],
    visibility = ["//visibility:public"],
)

dx_config_gen(name = "update_curated_defaults")

dx_rust_crate(
    name = "dx_config",
    package_name = "cli/dx_config",
    srcs = [
        "src/config.rs",
        "src/conventions.rs",
        "src/curated_defaults_gen.rs",
        "src/lib.rs",
        "src/schema.rs",
        "src/select.rs",
    ],
    compile_data = ["schema/dx.schema.json"],
    dev_deps = [
        "jsonschema",
        "serde_json",
    ],
    test_srcs = [
        "src/config_tests.rs",
        "src/conventions_tests.rs",
        "src/schema_tests.rs",
        "src/select_tests.rs",
    ],
    deps = [
        "chrono",
        "schemars",
        "serde",
        "thiserror",
        "toml",
    ],
)

# keep
rust_binary(
    name = "update_schema",
    srcs = ["src/bin_schema.rs"],
    crate_name = "update_schema",
    crate_root = "src/bin_schema.rs",
    deps = [":dx_config"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
