{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "CheckConfig": {
      "additionalProperties": false,
      "description": "What `dx check --affected` runs besides the quality phases.",
      "properties": {
        "commits": {
          "anyOf": [
            {
              "$ref": "#/definitions/CommitsPolicy"
            },
            {
              "type": "null"
            }
          ],
          "description": "Lint the commit subjects since the merge base. Off when left out."
        }
      },
      "type": "object"
    },
    "CommitsPolicy": {
      "oneOf": [
        {
          "const": "conventional",
          "description": "Every subject must be a conventional commit.",
          "type": "string"
        }
      ]
    },
    "FamilyConfig": {
      "additionalProperties": false,
      "description": "Replaces the curated tools of one family. A capability left out keeps the curated tools.",
      "properties": {
        "audit": {
          "default": null,
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "disabled": {
          "default": false,
          "description": "Turns the whole family off.",
          "type": "boolean"
        },
        "format": {
          "default": null,
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "lint": {
          "default": null,
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "tier": {
          "anyOf": [
            {
              "$ref": "#/definitions/Profile"
            },
            {
              "type": "null"
            }
          ]
        },
        "typecheck": {
          "default": null,
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "LargeFiles": {
      "additionalProperties": false,
      "description": "Oversized files a change may keep. Lock files are always allowed.",
      "properties": {
        "allow": {
          "default": [],
          "description": "Paths, or `dir/` prefixes, that the large-file check skips.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Profile": {
      "enum": [
        "standard",
        "strict"
      ],
      "type": "string"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "exclude": {
          "default": [],
          "description": "Bazel label patterns that dx leaves out.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  },
  "description": "The optional root file for tier, tool selection and scope.",
  "properties": {
    "check": {
      "$ref": "#/definitions/CheckConfig"
    },
    "families": {
      "additionalProperties": {
        "$ref": "#/definitions/FamilyConfig"
      },
      "description": "Per-family overrides, keyed by family id.",
      "type": "object"
    },
    "large_files": {
      "$ref": "#/definitions/LargeFiles"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "scope": {
      "$ref": "#/definitions/Scope"
    },
    "tier": {
      "anyOf": [
        {
          "$ref": "#/definitions/Profile"
        },
        {
          "type": "null"
        }
      ],
      "description": "The tier for every family that does not set its own."
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "dx.toml",
  "type": "object"
}
