load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI_DEPLOY_QUALITY_TOOLS")

package(default_visibility = VIS_CLI_DEPLOY_QUALITY_TOOLS)

rust_library(
    name = "dx_ecosystems",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "cli/dx_ecosystems",
        normal = True,
    ),
    compile_data = [
        "ecosystems.json",
        "languages.json",
    ],
    crate_name = "dx_ecosystems",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_ecosystems",
        normal = True,
    ) + [
        "//cli/families:dx_families",
        "@crates//:serde",
    ],
)

rust_test(
    name = "dx_ecosystems_test",
    size = "small",
    srcs = [
        "src/lib.rs",
        "src/tests.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_ecosystems",
        normal = True,
        normal_dev = True,
    ),
    compile_data = [
        "ecosystems.json",
        "languages.json",
    ],
    coverage_lib = ":dx_ecosystems",
    crate_name = "dx_ecosystems",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_ecosystems",
        normal = True,
        normal_dev = True,
    ) + [
        "//cli/families:dx_families",
        "@crates//:serde",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    [
        "Cargo.toml",
        "ecosystems.json",
        "languages.json",
    ],
    visibility = ["//visibility:public"],
)

exports_files(
    [
        "src/lib.rs",
    ],
    visibility = ["//core/quality:__pkg__"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
