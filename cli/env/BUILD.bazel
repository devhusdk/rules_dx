load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

rust_library(
    name = "dx_env",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "cli/dx_env",
        normal = True,
    ),
    crate_name = "dx_env",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_env",
        normal = True,
    ) + [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/digest:dx_digest",
        "//cli/error:dx_error",
        "//cli/path:dx_path",
        "//env/proto:marker_proto_rs",
        "@crates//:serde",
        "@rules_rust_prost//private/3rdparty/crates:prost",
    ],
)

rust_binary(
    name = "env",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "cli/dx_env",
        normal = True,
    ),
    crate_name = "env",
    crate_root = "src/main.rs",
    data = ["//env:default_tree"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        package_name = "cli/dx_env",
        normal = True,
    ) + [
        ":dx_env",
        "//cli/error:dx_error",
        "//cli/output:dx_output",
        "//cli/process:dx_process",
        "@rules_rust//rust/runfiles",
    ],
)

rust_test(
    name = "dx_env_test",
    srcs = [
        "src/lib.rs",
        "src/lib_tests.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_env",
        normal = True,
        normal_dev = True,
    ),
    coverage_lib = ":dx_env",
    crate_name = "dx_env",
    crate_root = "src/lib.rs",
    data = [
        "//env:posix_metadata",
        "//env:windows_metadata",
    ],
    env = {
        "DX_POSIX_METADATA": "$(rootpath //env:posix_metadata)",
        "DX_WINDOWS_METADATA": "$(rootpath //env:windows_metadata)",
    },
    deps = all_crate_deps(
        package_name = "cli/dx_env",
        normal = True,
        normal_dev = True,
    ) + [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/digest:dx_digest",
        "//cli/error:dx_error",
        "//cli/path:dx_path",
        "//cli/test_scratch:dx_test_scratch",
        "//env/proto:marker_proto_rs",
        "//tools/testing:dx_testing",
        "@crates//:serde",
        "@rules_rust_prost//private/3rdparty/crates:prost",
    ],
)

# keep: tests the :env binary; Gazelle would add the dx_env crate deps
rust_test(
    name = "env_bin_test",
    crate = ":env",
    deps = [
        ":dx_env",
        "//cli/error:dx_error",
        "@rules_rust//rust/runfiles",
    ],
)

exports_files(
    [
        "Cargo.toml",
        "src/lib.rs",
        "src/main.rs",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "bootstrap_test",
    srcs = ["bootstrap_test.rs"],
    data = [
        ":env",
        "//env:default_tree",
    ],
    env = {
        "DX_ENV_BIN": "$(rootpath :env)",
        "DX_STAGED_METADATA": "env/default_tree.metadata.json",
    },
    tags = [
        "no-coverage",
        "no-remote-exec",
    ],
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
