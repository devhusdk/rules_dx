load("@crates//:crates.bzl", "aliases", "crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

rust_library(
    name = "dx_env",
    srcs = [
        "src/lib.rs",
        "src/lib_tests.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_env",
        normal = True,
    ),
    crate_name = "dx_env",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = crate_deps(
        [
            "clap",
            "serde",
            "serde_json",
            "thiserror",
            "tracing",
        ],
        package_name = "cli/dx_env",
    ) + [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/digest:dx_digest",
        "//env:marker_proto_rs",
        "@rules_rust_prost//private/3rdparty/crates:prost",
    ],
)

rust_binary(
    name = "env",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "cli/dx_env",
        normal = True,
    ),
    crate_name = "env",
    crate_root = "src/main.rs",
    data = ["//env:default_tree"],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = crate_deps(
        [
            "clap",
            "serde",
            "serde_json",
            "thiserror",
            "tracing",
        ],
        package_name = "cli/dx_env",
    ) + [
        ":dx_env",
        "//cli/output:dx_output",
        "//cli/process:dx_process",
        "@rules_rust//rust/runfiles",
    ],
)

rust_test(
    name = "dx_env_test",
    size = "small",
    aliases = aliases(
        package_name = "cli/dx_env",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_env",
    deps = crate_deps(
        [
            "clap",
            "serde",
            "serde_json",
            "thiserror",
            "tracing",
        ],
        package_name = "cli/dx_env",
    ) + ["//cli/test_scratch:dx_test_scratch"],
)

# keep
rust_test(
    name = "env_bin_test",
    size = "small",
    crate = ":env",
    deps = [
        ":dx_env",
        "@rules_rust//rust/runfiles",
    ],
)

rustfmt_test(
    name = "dx_env_fmt_test",
    size = "small",
    targets = [
        ":dx_env",
        ":env",
    ],
)

rust_clippy_test(
    name = "dx_env_clippy_test",
    size = "small",
    targets = [
        ":dx_env",
        ":env",
    ],
)

exports_files(
    [
        "Cargo.toml",
        "src/lib.rs",
        "src/main.rs",
    ],
    visibility = ["//visibility:public"],
)

# keep
rust_test(
    name = "bootstrap_test",
    srcs = ["bootstrap_test.rs"],
    data = [
        ":env",
        "//env:default_tree",
    ],
    env = {
        "DX_ENV_BIN": "$(rootpath :env)",
        "DX_STAGED_METADATA": "env/default_tree.metadata.json",
    },
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["//tools/testing:dx_testing"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
