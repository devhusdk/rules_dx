load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

# gazelle:resolve rust env_shard //env/env_shard

package(default_visibility = VIS_CLI)

rust_library(
    name = "dx_env_plan",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "cli/dx_env_plan",
        normal = True,
    ),
    crate_name = "dx_env_plan",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_env_plan",
        normal = True,
    ) + [
        "//cli/bep:dx_bep",
        "//cli/digest:dx_digest",
        "//cli/fingerprint:dx_fingerprint",
        "//cli/roots:dx_roots",
        "//env/env_shard",
        "@crates//:serde",
    ],
)

rust_test(
    name = "dx_env_plan_test",
    size = "small",
    srcs = [
        "src/lib.rs",
        "src/lib_tests.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_env_plan",
        normal = True,
        normal_dev = True,
    ),
    coverage_lib = ":dx_env_plan",
    crate_name = "dx_env_plan",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_env_plan",
        normal = True,
        normal_dev = True,
    ) + [
        "//cli/bep:dx_bep",
        "//cli/digest:dx_digest",
        "//cli/fingerprint:dx_fingerprint",
        "//cli/roots:dx_roots",
        "//env/env_shard",
        "@crates//:serde",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files([
    "src/lib.rs",
])

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)
