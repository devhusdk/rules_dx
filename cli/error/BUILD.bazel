load("@crates//:crates.bzl", "aliases")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI_PLATFORM")

package(default_visibility = VIS_CLI_PLATFORM)

rust_library(
    name = "dx_error",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "cli/dx_error",
        normal = True,
    ),
    crate_name = "dx_error",
    crate_root = "src/lib.rs",
    deps = [],
)

rust_test(
    name = "dx_error_test",
    size = "small",
    aliases = aliases(
        package_name = "cli/dx_error",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_error",
    deps = [],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

exports_files(
    [
        "src/lib.rs",
    ],
    visibility = ["//core/quality:__pkg__"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
