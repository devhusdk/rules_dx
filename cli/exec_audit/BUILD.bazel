        "//docs:support-matrix.md",
        "//haskell/tests/fixtures/stack:stack.yaml.lock",
    ],
    coverage_lib = ":dx_exec_audit",
    crate_name = "dx_exec_audit",
    crate_root = "src/lib.rs",
    # keep
    deps = [
        "//cli/adopt:dx_adopt",
