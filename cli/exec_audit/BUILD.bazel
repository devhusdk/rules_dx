        "src/audit_cyclonedx.rs",
        "src/audit_images.rs",
        "src/audit_license.rs",
        "src/audit_spdx.rs",
        "src/audit_uncovered.rs",
        "src/lib.rs",
    ],
    aliases = {},  # keep
    crate_name = "dx_exec_audit",
    crate_root = "src/lib.rs",
    # keep
    deps = [
        "//cli/adopt:dx_adopt",
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/audit:dx_audit",
        "//cli/digest:dx_digest",
        "//cli/dx_config",
        "//cli/ecosystems:dx_ecosystems",
        "//cli/error:dx_error",
        "//cli/exec_core:dx_exec_core",
        "//cli/exec_reports:dx_exec_reports",
        "//cli/module_bazel:dx_module_bazel",
        "//cli/output:dx_output",
        "//cli/path:dx_path",
        "//cli/plan:dx_plan",
        "//cli/process:dx_process",
        "//cli/sbom:dx_sbom",
        "//cli/tool_resolve:dx_tool_resolve",
        "//cli/update:dx_update",
        "@crates//:chrono",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:thiserror",
        "@crates//:tracing",
    ],
)

