load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

rust_library(
    name = "dx_exec_bench",
    srcs = ["src/lib.rs"],
    aliases = {},  # keep
    compile_data = ["clippy.toml"],
    crate_name = "dx_exec_bench",
    crate_root = "src/lib.rs",
    # keep
    deps = [
        "//cli/archive:dx_archive",
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/bep:dx_bep",
        "//cli/error:dx_error",
        "//cli/exec_core:dx_exec_core",
        "//cli/exec_test_reports:dx_exec_test_reports",
        "//cli/output:dx_output",
        "//cli/path:dx_path",
        "//cli/plan:dx_plan",
        "//cli/process:dx_process",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)

rust_test(
    name = "dx_exec_bench_test",
    size = "small",
    aliases = {},  # keep
    compile_data = ["clippy.toml"],
    crate = ":dx_exec_bench",
    # keep
    deps = [
        "//cli/archive:dx_archive",
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/bep:dx_bep",
        "//cli/error:dx_error",
        "//cli/exec_core:dx_exec_core",
        "//cli/exec_test_reports:dx_exec_test_reports",
        "//cli/output:dx_output",
        "//cli/path:dx_path",
        "//cli/plan:dx_plan",
        "//cli/process:dx_process",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)

filegroup(
    name = "rust_srcs",
    srcs = glob(["src/**/*.rs"]),
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = [
        "Cargo.toml",
        "clippy.toml",
    ],
)

exports_files(
    [
        "Cargo.toml",
        "clippy.toml",
    ],
    visibility = ["//visibility:public"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
