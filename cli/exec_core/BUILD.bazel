load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

rust_library(
    name = "dx_exec_core",
    srcs = [
        "src/audit_policy.rs",
        "src/bazel_hint.rs",
        "src/bazel_restart.rs",
        "src/common.rs",
        "src/failure.rs",
        "src/guidance.rs",
        "src/lib.rs",
        "src/notice_codes.rs",
    ],
    aliases = {},  # keep
    # Clippy reads this config for dx_exec_core instead of the workspace one.
    compile_data = ["clippy.toml"],
    crate_name = "dx_exec_core",
    crate_root = "src/lib.rs",
    # keep
    deps = [
        "//cli/apply:dx_apply",
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/audit:dx_audit",
        "//cli/bep:dx_bep",
        "//cli/digest:dx_digest",
        "//cli/dx_config",
        "//cli/error:dx_error",
        "//cli/output:dx_output",
        "//cli/path:dx_path",
        "//cli/plan:dx_plan",
        "//cli/process:dx_process",
        "@crates//:chrono",
        "@crates//:serde_json",
        "@crates//:thiserror",
        "@crates//:tracing",
    ],
)

rust_test(
    name = "dx_exec_core_test",
    size = "small",
    srcs = [
        "src/audit_policy.rs",
        "src/audit_policy_tests.rs",
        "src/bazel_hint.rs",
        "src/bazel_restart.rs",
        "src/common.rs",
        "src/common_tests.rs",
        "src/failure.rs",
        "src/guidance.rs",
        "src/lib.rs",
        "src/notice_codes.rs",
    ],
    aliases = {},  # keep
    compile_data = ["clippy.toml"],
    coverage_lib = ":dx_exec_core",
    crate_name = "dx_exec_core",
    crate_root = "src/lib.rs",
    # keep
    deps = [
        "//cli/apply:dx_apply",
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/audit:dx_audit",
        "//cli/bep:dx_bep",
        "//cli/digest:dx_digest",
        "//cli/dx_config",
        "//cli/error:dx_error",
        "//cli/output:dx_output",
        "//cli/path:dx_path",
        "//cli/plan:dx_plan",
        "//cli/process:dx_process",
        "//tools/testing:dx_testing",
        "@crates//:chrono",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:thiserror",
        "@crates//:tracing",
    ],
)

# Read by the dx_cli source guards, which scan every production CLI file.
filegroup(
    name = "rust_srcs",
    srcs = glob(["src/**/*.rs"]),
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = [
        "Cargo.toml",
        "clippy.toml",
    ],
)

exports_files(
    [
        "Cargo.toml",
        "clippy.toml",
    ],
    visibility = ["//visibility:public"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
