load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

rust_library(
    name = "dx_exec_quality",
    srcs = [
        "src/breaking_base.rs",
        "src/check_build.rs",
        "src/generated_drift.rs",
        "src/lib.rs",
        "src/link_check.rs",
        "src/quality_apply.rs",
        "src/quality_emit.rs",
        "src/quality_patch.rs",
        "src/quality_reconcile.rs",
        "src/quality_reports.rs",
        "src/quality_security.rs",
        "src/results.rs",
    ],
    aliases = {},  # keep
    # Clippy reads this config for dx_exec_quality instead of the workspace one.
    compile_data = ["clippy.toml"],
    crate_name = "dx_exec_quality",
    crate_root = "src/lib.rs",
    # keep
    deps = [
        "//cli/adopt:dx_adopt",
        "//cli/apply:dx_apply",
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/audit:dx_audit",
        "//cli/bep:dx_bep",
        "//cli/diff:dx_diff",
        "//cli/digest:dx_digest",
        "//cli/error:dx_error",
        "//cli/exec_core:dx_exec_core",
        "//cli/exec_reports:dx_exec_reports",
        "//cli/generate:dx_generate",
        "//cli/output:dx_output",
        "//cli/path:dx_path",
        "//cli/plan:dx_plan",
        "//cli/process:dx_process",
        "//cli/tool_resolve:dx_tool_resolve",
        "//core/quality/result:quality_result",
        "//core/quality/runner:quality_runner_lib",
        "@crates//:serde_json",
        "@crates//:thiserror",
        "@crates//:tracing",
    ],
)

rust_library(
    name = "dx_exec_quality_testing",
    testonly = True,
    srcs = ["src/testing.rs"],
    crate_name = "dx_exec_quality_testing",
    crate_root = "src/testing.rs",
    # keep
    deps = [
        "//cli/apply:dx_apply",
        "//cli/digest:dx_digest",
        "//cli/test_scratch:dx_test_scratch",
        "//core/quality/result:quality_result",
        "//tools/testing:dx_testing",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "dx_exec_quality_test",
    size = "small",
    srcs = [
        "src/breaking_base.rs",
        "src/check_build.rs",
        "src/check_build_tests.rs",
        "src/generated_drift.rs",
        "src/lib.rs",
        "src/link_check.rs",
        "src/link_check_tests.rs",
        "src/quality_apply.rs",
        "src/quality_apply_tests.rs",
        "src/quality_emit.rs",
        "src/quality_patch.rs",
        "src/quality_reconcile.rs",
        "src/quality_reports.rs",
        "src/quality_security.rs",
        "src/quality_skip_notes_tests.rs",
        "src/results.rs",
        "src/results_tests.rs",
    ],
    aliases = {},  # keep
    compile_data = ["clippy.toml"],
    coverage_lib = ":dx_exec_quality",
    crate_name = "dx_exec_quality",
    crate_root = "src/lib.rs",
    data = ["@dx_tools//:lychee"],
    env = {"DX_TEST_LYCHEE": "$(rootpath @dx_tools//:lychee)"},
    # keep
    deps = [
        ":dx_exec_quality_testing",
        "//cli/adopt:dx_adopt",
        "//cli/apply:dx_apply",
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/audit:dx_audit",
        "//cli/bep:dx_bep",
        "//cli/diff:dx_diff",
        "//cli/digest:dx_digest",
        "//cli/error:dx_error",
        "//cli/exec_core:dx_exec_core",
        "//cli/exec_reports:dx_exec_reports",
        "//cli/generate:dx_generate",
        "//cli/output:dx_output",
        "//cli/path:dx_path",
        "//cli/plan:dx_plan",
        "//cli/process:dx_process",
        "//cli/test_scratch:dx_test_scratch",
        "//cli/tool_resolve:dx_tool_resolve",
        "//core/quality/result:quality_result",
        "//core/quality/runner:quality_runner_lib",
        "//tools/testing:dx_testing",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:thiserror",
        "@crates//:tracing",
    ],
)

# Read by the dx_cli source guards, which scan every production CLI file.
filegroup(
    name = "rust_srcs",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/testing.rs"],
    ),
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = [
        "Cargo.toml",
        "clippy.toml",
    ],
)

exports_files(
    [
        "Cargo.toml",
        "clippy.toml",
    ],
    visibility = ["//visibility:public"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
