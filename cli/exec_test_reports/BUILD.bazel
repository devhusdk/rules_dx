load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

rust_library(
    name = "dx_exec_test_reports",
    srcs = [
        "src/account.rs",
        "src/changed_coverage.rs",
        "src/collect.rs",
        "src/coverage_candidate.rs",
        "src/lib.rs",
        "src/report.rs",
    ],
    aliases = {},  # keep
    compile_data = ["clippy.toml"],
    crate_name = "dx_exec_test_reports",
    crate_root = "src/lib.rs",
    # keep
    deps = [
        "//cli/adopt:dx_adopt",
        "//cli/bep:dx_bep",
        "//cli/error:dx_error",
        "//cli/exec_core:dx_exec_core",
        "//cli/exec_reports:dx_exec_reports",
        "//cli/lcov:dx_lcov",
        "//cli/output:dx_output",
        "//cli/path:dx_path",
        "//cli/plan:dx_plan",
        "//cli/process:dx_process",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "dx_exec_test_reports_test",
    size = "small",
    srcs = [
        "src/account.rs",
        "src/changed_coverage.rs",
        "src/collect.rs",
        "src/coverage_candidate.rs",
        "src/lib.rs",
        "src/report.rs",
        "src/test_reports_tests.rs",
    ],
    aliases = {},  # keep
    compile_data = ["clippy.toml"],
    coverage_lib = ":dx_exec_test_reports",
    crate_name = "dx_exec_test_reports",
    crate_root = "src/lib.rs",
    # keep
    deps = [
        "//cli/adopt:dx_adopt",
        "//cli/bep:dx_bep",
        "//cli/error:dx_error",
        "//cli/exec_core:dx_exec_core",
        "//cli/exec_reports:dx_exec_reports",
        "//cli/lcov:dx_lcov",
        "//cli/output:dx_output",
        "//cli/path:dx_path",
        "//cli/plan:dx_plan",
        "//cli/process:dx_process",
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing:dx_testing",
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)

filegroup(
    name = "rust_srcs",
    srcs = glob(["src/**/*.rs"]),
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = [
        "Cargo.toml",
        "clippy.toml",
    ],
)

exports_files(
    [
        "Cargo.toml",
        "clippy.toml",
    ],
    visibility = ["//visibility:public"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
