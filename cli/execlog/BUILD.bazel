load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("@rules_rust_prost//:defs.bzl", "rust_prost_library")
load("//rust/rules:crate.bzl", "dx_rust_crate")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

exports_files([
    "src/lib.rs",
])

proto_library(
    name = "spawn_proto",
    srcs = ["spawn.proto"],
)

rust_prost_library(
    name = "spawn_proto_rs",
    proto = ":spawn_proto",
)

dx_rust_crate(
    name = "dx_execlog",
    package_name = "cli/dx_execlog",
    srcs = [
        "src/diff.rs",
        "src/lib.rs",
    ],
    extra_deps = [
        ":spawn_proto_rs",
        "@rules_rust_prost//private/3rdparty/crates:prost",
    ],
    test_srcs = [
        "src/diff_tests.rs",
        "src/tests.rs",
    ],
    deps = [
        "ruzstd",
        "thiserror",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
