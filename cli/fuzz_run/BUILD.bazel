load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "dx_fuzz_run",
    srcs = [
        "src/lib.rs",
        "src/run.rs",
    ],
    deps = [
        "//cli/error:dx_error",
        "@crates//:tempfile",
        "@rules_rust//rust/runfiles",
    ],
)

rust_test(
    name = "dx_fuzz_run_test",
    size = "small",
    srcs = ["src/run_tests.rs"],
    crate = ":dx_fuzz_run",
    deps = ["//cli/test_scratch:dx_test_scratch"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)

exports_files(
    [
        "src/lib.rs",
    ],
    visibility = ["//core/quality:__pkg__"],
)
