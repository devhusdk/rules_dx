load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//core/quality:tools_gen.bzl", "config_tools_gen")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI", "VIS_QUALITY")

package(default_visibility = VIS_CLI)

exports_files(
    ["src/tools_gen.rs"],
    visibility = [
        "//core/quality/adapter:__pkg__",
        "//core/quality/tiers:__pkg__",
    ],
)

config_tools_gen(
    name = "update_tools",
    visibility = VIS_QUALITY,
)

rust_library(
    name = "dx_generate",
    srcs = [
        "src/lib.rs",
        "src/references.rs",
        "src/root_block.rs",
        "src/sync.rs",
        "src/tools_gen.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_generate",
        normal = True,
    ),
    compile_data = ["//core/quality/tiers:all"],
    crate_name = "dx_generate",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_generate",
        normal = True,
    ) + [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/digest:dx_digest",
        "//cli/dx_config",
        "//cli/error:dx_error",
        "//cli/merge:dx_merge",
        "//cli/path:dx_path",
        "//cli/module_bazel:dx_module_bazel",
        "//tools/bazelrc:dx_preset",
    ],
)

rust_test(
    name = "dx_generate_test",
    size = "small",
    srcs = [
        "src/lib.rs",
        "src/references.rs",
        "src/render_tests.rs",
        "src/root_block.rs",
        "src/sync.rs",
        "src/sync_tests.rs",
        "src/tools_gen.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_generate",
        normal = True,
        normal_dev = True,
    ),
    compile_data = ["//core/quality/tiers:all"],
    coverage_lib = ":dx_generate",
    crate_name = "dx_generate",
    crate_root = "src/lib.rs",
    data = [
        "//gazelle/python:dx_generate_fixpoint_testdata",
        "//gazelle/python:testdata/dx_generate_existing_exports/WORKSPACE",
        "//gazelle/python:testdata/dx_generate_standard/WORKSPACE",
        "//core/quality/tests/fixtures/generated_policy:BUILD.bazel",
        "@dx_tools//:buildifier",
    ],
    env = {
        "DX_BUILDIFIER": "$(rootpath @dx_tools//:buildifier)",
        "DX_FIXPOINT_EXISTING_EXPORTS": "$(rootpath //gazelle/python:testdata/dx_generate_existing_exports/WORKSPACE)",
        "DX_FIXPOINT_STANDARD": "$(rootpath //gazelle/python:testdata/dx_generate_standard/WORKSPACE)",
        "DX_GENERATED_POLICY": "$(rootpath //core/quality/tests/fixtures/generated_policy:BUILD.bazel)",
    },
    deps = all_crate_deps(
        package_name = "cli/dx_generate",
        normal = True,
        normal_dev = True,
    ) + [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/digest:dx_digest",
        "//cli/dx_config",
        "//cli/error:dx_error",
        "//cli/merge:dx_merge",
        "//cli/path:dx_path",
        "//cli/test_scratch:dx_test_scratch",
        "//cli/module_bazel:dx_module_bazel",
        "//tools/bazelrc:dx_preset",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

exports_files(
    [
        "src/lib.rs",
    ],
    visibility = ["//core/quality:__pkg__"],
)
