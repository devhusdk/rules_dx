load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//quality:tools_gen.bzl", "config_tools_gen")
load("//rust/rules:crate.bzl", "dx_rust_crate")
load("//tools/visibility:visibility.bzl", "VIS_CLI", "VIS_QUALITY")

package(default_visibility = VIS_CLI)

config_tools_gen(
    name = "update_tools",
    visibility = VIS_QUALITY,
)

dx_rust_crate(
    name = "dx_generate",
    package_name = "cli/dx_generate",
    srcs = [
        "src/lib.rs",
        "src/references.rs",
        "src/root_block.rs",
        "src/tools_gen.rs",
    ],
    compile_data = ["//quality/tiers:all"],
    dev_deps = ["insta"],
    extra_deps = [
        "//cli/dx_config",
        "//cli/merge:dx_merge",
        "//tools/bazelrc:dx_preset",
    ],
    test_data = [
        "//gazelle/python:dx_generate_fixpoint_testdata",
        "//gazelle/python:testdata/dx_generate_existing_exports/WORKSPACE",
        "//gazelle/python:testdata/dx_generate_standard/WORKSPACE",
        "//quality/tests/fixtures/generated_policy:BUILD.bazel",
        "@dx_tools//:buildifier",
    ],
    test_env = {
        "DX_BUILDIFIER": "$(rootpath @dx_tools//:buildifier)",
        "DX_FIXPOINT_EXISTING_EXPORTS": "$(rootpath //gazelle/python:testdata/dx_generate_existing_exports/WORKSPACE)",
        "DX_FIXPOINT_STANDARD": "$(rootpath //gazelle/python:testdata/dx_generate_standard/WORKSPACE)",
        "DX_GENERATED_POLICY": "$(rootpath //quality/tests/fixtures/generated_policy:BUILD.bazel)",
    },
    test_srcs = ["src/render_tests.rs"],
    deps = ["thiserror"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
