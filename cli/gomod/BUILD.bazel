load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI_TOOLS")

package(default_visibility = VIS_CLI_TOOLS)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files([
    "src/lib.rs",
])

rust_library(
    name = "dx_gomod",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "cli/dx_gomod",
        normal = True,
    ),
    crate_name = "dx_gomod",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_gomod",
        normal = True,
    ),
)

rust_test(
    name = "dx_gomod_test",
    size = "small",
    srcs = [
        "src/lib.rs",
        "src/tests.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_gomod",
        normal = True,
        normal_dev = True,
    ),
    coverage_lib = ":dx_gomod",
    crate_name = "dx_gomod",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_gomod",
        normal = True,
        normal_dev = True,
    ),
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)
