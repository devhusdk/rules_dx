load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

rust_library(
    name = "dx_ide",
    srcs = [
        "src/cc.rs",
        "src/dotnet.rs",
        "src/go.rs",
        "src/jdk.rs",
        "src/lib.rs",
        "src/link.rs",
        "src/python.rs",
        "src/rust_analyzer.rs",
        "src/typescript.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_ide",
        normal = True,
    ),
    crate_name = "dx_ide",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_ide",
        normal = True,
    ) + [
        "//cc/context:cc_context",
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/digest:dx_digest",
        "//cli/error:dx_error",
        "//cli/path:dx_path",
    ],
)

rust_test(
    name = "dx_ide_test",
    size = "small",
    aliases = aliases(
        package_name = "cli/dx_ide",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_ide",
    deps = all_crate_deps(
        package_name = "cli/dx_ide",
        normal = True,
        normal_dev = True,
    ) + [
        "//cc/context:cc_context",
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/digest:dx_digest",
        "//cli/error:dx_error",
        "//cli/path:dx_path",
        "//cli/test_scratch:dx_test_scratch",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)
