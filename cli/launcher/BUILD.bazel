load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_test")
load(":defs.bzl", "dx_subcommand")
load(":defs_tests.bzl", "dx_subcommand_test")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "exec_launcher",
    srcs = [
        "src/launch.rs",
        "src/main.rs",
    ],
    crate_name = "launcher",
    crate_root = "src/main.rs",
    deps = [
        "//cli/error:dx_error",
        "//cli/path:dx_path",
    ],
)

rust_test(
    name = "exec_launcher_test",
    size = "small",
    srcs = [
        "src/launch.rs",
        "src/launch_tests.rs",
        "src/main.rs",
    ],
    crate_name = "launcher",
    crate_root = "src/main.rs",
    data = [":exec_launcher"],
    env = {"DX_EXEC_LAUNCHER": "$(rlocationpath :exec_launcher)"},
    deps = [
        "//cli/error:dx_error",
        "//cli/path:dx_path",
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing:dx_testing",
    ],
)

dx_subcommand(
    name = "toy_lock",
    dx = "@dx_prebuilt//:dx",
    subcommand = "toy_lock",
)

dx_subcommand_test(
    name = "toy_lock_test",
    size = "small",
    subcommand = "toy_lock",
    target_under_test = ":toy_lock",
)

dx_subcommand(
    name = "toy_lock_paths",
    dx = "@dx_prebuilt//:dx",
    path_args = {"--tool": "defs.bzl"},
    subcommand = "toy_lock",
)

dx_subcommand_test(
    name = "toy_lock_paths_test",
    size = "small",
    extra_lines = ["prefixed=--tool=\t_main/cli/launcher/defs.bzl"],
    subcommand = "toy_lock",
    target_under_test = ":toy_lock_paths",
)

dx_subcommand(
    name = "toy_lock_args",
    dx = "@dx_prebuilt//:dx",
    subcommand = "toy_lock",
    subcommand_args = ["--check"],
)

dx_subcommand_test(
    name = "toy_lock_args_test",
    size = "small",
    extra_lines = ["arg=--check"],
    subcommand = "toy_lock",
    target_under_test = ":toy_lock_args",
)

dx_subcommand_test(
    name = "lua_lock_test",
    size = "small",
    program = "lua_lock",
    subcommand = "lua_lock",
    target_under_test = "//lua/private/tools/lock",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "defs_tests.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)

exports_files(
    [
        "src/main.rs",
    ],
    visibility = ["//core/quality:__pkg__"],
)
