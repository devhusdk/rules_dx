load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_CLI_TOOLS)

exports_files([
    "src/lib.rs",
])

rust_library(
    name = "dx_lcov",
    srcs = [
        "src/accounting.rs",
        "src/changed.rs",
        "src/clover.rs",
        "src/cobertura.rs",
        "src/ignores.rs",
        "src/ignores_find.rs",
        "src/ignores_policy.rs",
        "src/ignores_scan.rs",
        "src/lang.rs",
        "src/lib.rs",
        "src/parse.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_lcov",
        normal = True,
    ),
    crate_name = "dx_lcov",
    crate_root = "src/lib.rs",
    visibility = VIS_CLI_TOOLS + ["//php/private/coverage:__pkg__"],
    deps = all_crate_deps(
        package_name = "cli/dx_lcov",
        normal = True,
    ) + [
        "//cli/error:dx_error",
        "//cli/output:dx_output",
        "//cli/path:dx_path",
    ],
)

rust_test(
    name = "dx_lcov_test",
    size = "small",
    srcs = [
        "src/accounting.rs",
        "src/accounting_tests.rs",
        "src/changed.rs",
        "src/changed_tests.rs",
        "src/clover.rs",
        "src/clover_tests.rs",
        "src/cobertura.rs",
        "src/cobertura_tests.rs",
        "src/ignores.rs",
        "src/ignores_find.rs",
        "src/ignores_policy.rs",
        "src/ignores_scan.rs",
        "src/ignores_tests.rs",
        "src/lang.rs",
        "src/lang_tests.rs",
        "src/lib.rs",
        "src/parse.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_lcov",
        normal = True,
        normal_dev = True,
    ),
    coverage_lib = ":dx_lcov",
    crate_name = "dx_lcov",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_lcov",
        normal = True,
        normal_dev = True,
    ) + [
        "//cli/error:dx_error",
        "//cli/output:dx_output",
        "//cli/path:dx_path",
    ],
)

rust_binary(
    name = "to_lcov",
    srcs = ["src/to_lcov.rs"],
    aliases = aliases(
        package_name = "cli/dx_lcov",
        normal = True,
    ),
    crate_name = "to_lcov",
    crate_root = "src/to_lcov.rs",
    visibility = VIS_TOOLS_PUBLIC,
    deps = all_crate_deps(
        package_name = "cli/dx_lcov",
        normal = True,
    ) + [
        ":dx_lcov",
        "//cli/error:dx_error",
    ],
)

rust_test(
    name = "to_lcov_test",
    aliases = aliases(
        package_name = "cli/dx_lcov",
        normal = True,
        normal_dev = True,
    ),
    crate = ":to_lcov",
    deps = all_crate_deps(
        package_name = "cli/dx_lcov",
        normal = True,
        normal_dev = True,
    ) + ["//cli/error:dx_error"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)
