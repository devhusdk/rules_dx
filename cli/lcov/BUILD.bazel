load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:crate.bzl", "dx_rust_crate")
load("//tools/visibility:visibility.bzl", "VIS_CLI_TOOLS")

package(default_visibility = VIS_CLI_TOOLS)

exports_files([
    "src/lib.rs",
])

dx_rust_crate(
    name = "dx_lcov",
    package_name = "cli/dx_lcov",
    srcs = [
        "src/ignores.rs",
        "src/ignores_find.rs",
        "src/ignores_policy.rs",
        "src/ignores_scan.rs",
        "src/ignores_tests.rs",
        "src/inventory.rs",
        "src/lib.rs",
        "src/parse.rs",
        "src/run.rs",
        "src/verdict.rs",
        "src/verdict_eval.rs",
        "src/verdict_lang.rs",
        "src/verdict_render.rs",
        "src/verdict_tests.rs",
    ],
    extra_deps = ["//cli/output:dx_output"],
    deps = [
        "clap",
        "lcov",
        "regex",
        "thiserror",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
