load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:crate.bzl", "dx_rust_crate")
load("//rust/rules:defs.bzl", "rust_binary", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_CLI_TOOLS)

exports_files([
    "src/lib.rs",
])

dx_rust_crate(
    name = "dx_lcov",
    package_name = "cli/dx_lcov",
    srcs = [
        "src/accounting.rs",
        "src/changed.rs",
        "src/clover.rs",
        "src/cobertura.rs",
        "src/ignores.rs",
        "src/ignores_find.rs",
        "src/ignores_policy.rs",
        "src/ignores_scan.rs",
        "src/lang.rs",
        "src/lib.rs",
        "src/parse.rs",
    ],
    extra_deps = [
        "//cli/output:dx_output",
        "//cli/path:dx_path",
    ],
    test_srcs = [
        "src/accounting_tests.rs",
        "src/changed_tests.rs",
        "src/clover_tests.rs",
        "src/cobertura_tests.rs",
        "src/ignores_tests.rs",
        "src/lang_tests.rs",
    ],
    deps = [
        "lcov",
        "regex",
        "thiserror",
    ],
)

# keep
rust_binary(
    name = "to_lcov",
    srcs = ["src/to_lcov.rs"],
    crate_root = "src/to_lcov.rs",
    visibility = VIS_TOOLS_PUBLIC,
    deps = [":dx_lcov"],
)

# keep
rust_test(
    name = "to_lcov_test",
    crate = ":to_lcov",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
