load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

exports_files([
    "src/block.rs",
    "src/jsonc.rs",
    "src/lib.rs",
    "src/merge3.rs",
    "src/yaml_scalar.rs",
])

rust_library(
    name = "dx_merge",
    srcs = [
        "src/block.rs",
        "src/jsonc.rs",
        "src/lib.rs",
        "src/merge3.rs",
        "src/yaml_scalar.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_merge",
        normal = True,
    ),
    crate_name = "dx_merge",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_merge",
        normal = True,
    ) + ["@crates//:serde_json"],
)

rust_test(
    name = "dx_merge_test",
    size = "small",
    aliases = aliases(
        package_name = "cli/dx_merge",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_merge",
    deps = all_crate_deps(
        package_name = "cli/dx_merge",
        normal = True,
        normal_dev = True,
    ) + ["@crates//:serde_json"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)
