load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "ocaml_cc_driver",
    srcs = [
        "src/driver.rs",
        "src/driver_tests.rs",
        "src/dune.rs",
        "src/dune_tests.rs",
        "src/lib.rs",
        "src/lib_tests.rs",
    ],
    crate_name = "ocaml_cc_driver",
    crate_root = "src/lib.rs",
    visibility = ["//cli/cli:__pkg__"],
    deps = [
        "@crates//:tempfile",
    ],
)

rust_test(
    name = "ocaml_cc_driver_test",
    size = "small",
    crate = ":ocaml_cc_driver",
    deps = [
        "//cli/test_scratch:dx_test_scratch",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
