load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//rust/tests:defs_tests.bzl", "rust_test_srcs_split_tests")
load("//rust/tests:lint_test.bzl", "lint_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI_DEPLOY_QUALITY_TOOLS")

package(default_visibility = VIS_CLI_DEPLOY_QUALITY_TOOLS)

rust_library(
    name = "dx_os_sys",
    srcs = [
        "src/console.rs",
        "src/errno.rs",
        "src/fd.rs",
        "src/fs.rs",
        "src/job.rs",
        "src/job_object.rs",
        "src/lib.rs",
        "src/macos.rs",
        "src/nt.rs",
        "src/process.rs",
        "src/signals.rs",
        "src/spawn.rs",
        "src/tty.rs",
        "src/win32.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_os_sys",
        normal = True,
    ),
    crate_name = "dx_os_sys",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_os_sys",
        normal = True,
    ),
)

rust_test(
    name = "dx_os_sys_test",
    size = "small",
    srcs = [
        "src/console.rs",
        "src/console_tests.rs",
        "src/errno.rs",
        "src/fd.rs",
        "src/fs.rs",
        "src/job.rs",
        "src/job_object.rs",
        "src/job_object_tests.rs",
        "src/job_tests.rs",
        "src/lib.rs",
        "src/lib_tests.rs",
        "src/macos.rs",
        "src/nt.rs",
        "src/nt_tests.rs",
        "src/process.rs",
        "src/process_tests.rs",
        "src/signals.rs",
        "src/signals_tests.rs",
        "src/spawn.rs",
        "src/spawn_tests.rs",
        "src/tty.rs",
        "src/win32.rs",
        "src/win32_tests.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_os_sys",
        normal = True,
        normal_dev = True,
    ),
    coverage_lib = ":dx_os_sys",
    crate_name = "dx_os_sys",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_os_sys",
        normal = True,
        normal_dev = True,
    ) + ["//cli/test_scratch:dx_test_scratch"],
)

lint_test(
    name = "lint_test",
    size = "small",
    targets = [
        ":dx_os_sys",
        ":dx_os_sys_test",
    ],
)

rust_test_srcs_split_tests(
    name = "test_srcs_split_test",
    size = "small",
    lib = ":dx_os_sys",
    test = ":dx_os_sys_test",
    test_src = "cli/os_sys/src/lib_tests.rs",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
