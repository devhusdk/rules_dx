load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI_ENV_GENERATION_QUALITY")

package(default_visibility = VIS_CLI_ENV_GENERATION_QUALITY)

exports_files([
    "schema/events.schema.json",
    "src/clap_errors.rs",
    "src/lib.rs",
])

rust_library(
    name = "dx_output",
    srcs = [
        "src/changes.rs",
        "src/clap_errors.rs",
        "src/diagnostics.rs",
        "src/findings.rs",
        "src/lib.rs",
        "src/lifecycle.rs",
        "src/modes.rs",
        "src/severity.rs",
        "src/validation.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_output",
        normal = True,
    ),
    compile_data = ["schema/events.schema.json"],
    crate_name = "dx_output",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_output",
        normal = True,
    ) + [
        "//cli/digest:dx_digest",
        "//cli/path:dx_path",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "dx_output_test",
    size = "small",
    srcs = [
        "src/changes.rs",
        "src/clap_errors.rs",
        "src/diagnostics.rs",
        "src/findings.rs",
        "src/lib.rs",
        "src/lifecycle.rs",
        "src/modes.rs",
        "src/schema_tests.rs",
        "src/severity.rs",
        "src/validation.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_output",
        normal = True,
        normal_dev = True,
    ),
    compile_data = ["schema/events.schema.json"],
    coverage_lib = ":dx_output",
    crate_name = "dx_output",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_output",
        normal = True,
        normal_dev = True,
    ) + [
        "//cli/digest:dx_digest",
        "//cli/path:dx_path",
        "@crates//:serde_json",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)
