load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:crate.bzl", "dx_rust_crate")
load("//tools/visibility:visibility.bzl", "VIS_CLI_ENV_GENERATION_QUALITY")

package(default_visibility = VIS_CLI_ENV_GENERATION_QUALITY)

exports_files([
    "schema/events.schema.json",
    "src/clap_errors.rs",
    "src/lib.rs",
])

dx_rust_crate(
    name = "dx_output",
    package_name = "cli/dx_output",
    srcs = [
        "src/changes.rs",
        "src/clap_errors.rs",
        "src/diagnostics.rs",
        "src/findings.rs",
        "src/lib.rs",
        "src/lifecycle.rs",
        "src/modes.rs",
        "src/severity.rs",
        "src/validation.rs",
    ],
    compile_data = ["schema/events.schema.json"],
    dev_deps = ["jsonschema"],
    extra_deps = [
        "//cli/digest:dx_digest",
        "//cli/path:dx_path",
    ],
    test_srcs = ["src/schema_tests.rs"],
    deps = [
        "clap",
        "console",
        "serde_json",
        "thiserror",
        "tracing",
        "tracing-subscriber",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
