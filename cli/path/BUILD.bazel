load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI_PLATFORM")

package(default_visibility = VIS_CLI_PLATFORM)

exports_files([
    "src/bazel_package.rs",
    "src/host.rs",
    "src/lib.rs",
    "src/nested_bazel.rs",
    "src/proto_validate.rs",
    "src/runfiles.rs",
    "src/spelling.rs",
    "src/state.rs",
    "src/uri.rs",
    "src/workspace.rs",
])

rust_library(
    name = "dx_path",
    srcs = [
        "src/bazel_package.rs",
        "src/host.rs",
        "src/lib.rs",
        "src/nested_bazel.rs",
        "src/proto_validate.rs",
        "src/runfiles.rs",
        "src/spelling.rs",
        "src/state.rs",
        "src/uri.rs",
        "src/workspace.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_path",
        normal = True,
    ),
    crate_name = "dx_path",
    crate_root = "src/lib.rs",
    visibility = VIS_CLI_PLATFORM + [
        "//javascript/private/quality/launcher:__pkg__",
        "//libs/launcher:__pkg__",
        "//rego:__subpackages__",
    ],
    deps = all_crate_deps(
        package_name = "cli/dx_path",
        normal = True,
    ) + [
        "@rules_rust//rust/runfiles",
        "@rules_rust_prost//private/3rdparty/crates:prost",
    ],
)

rust_test(
    name = "dx_path_test",
    size = "small",
    aliases = aliases(
        package_name = "cli/dx_path",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_path",
    visibility = VIS_CLI_PLATFORM + [
        "//javascript/private/quality/launcher:__pkg__",
        "//libs/launcher:__pkg__",
        "//rego:__subpackages__",
    ],
    deps = all_crate_deps(
        package_name = "cli/dx_path",
        normal = True,
        normal_dev = True,
    ) + [
        "@rules_rust//rust/runfiles",
        "@rules_rust_prost//private/3rdparty/crates:prost",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)
