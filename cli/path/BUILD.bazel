load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:crate.bzl", "dx_rust_crate")
load("//tools/visibility:visibility.bzl", "VIS_CLI_PLATFORM")

package(default_visibility = VIS_CLI_PLATFORM)

exports_files([
    "src/bazel_package.rs",
    "src/host.rs",
    "src/lib.rs",
    "src/nested_bazel.rs",
    "src/runfiles.rs",
    "src/spelling.rs",
    "src/uri.rs",
    "src/workspace.rs",
])

dx_rust_crate(
    name = "dx_path",
    package_name = "cli/dx_path",
    srcs = [
        "src/bazel_package.rs",
        "src/host.rs",
        "src/lib.rs",
        "src/nested_bazel.rs",
        "src/runfiles.rs",
        "src/spelling.rs",
        "src/uri.rs",
        "src/workspace.rs",
    ],
    dev_deps = ["tempfile"],
    extra_deps = ["@rules_rust//rust/runfiles"],
    visibility = VIS_CLI_PLATFORM + [
        "//libs/launcher:__pkg__",
        "//rego:__subpackages__",
    ],
    deps = [
        "thiserror",
        "url",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
