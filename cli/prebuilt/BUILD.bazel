load("//libs/starlark:failure_test.bzl", "failure_test")
load("//quality:fixtures.bzl", "real_source_target")
load(":fail.bzl", "dx_unavailable")
load(":hub.bzl", "unsupported_message")
load(":hub_tests.bzl", "dx_prebuilt_hub_tests")

exports_files(
    [
        "extension.bzl",
        "fail.bzl",
        "hub.bzl",
        "pins.bzl",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "module_srcs",
    srcs = [
        "BUILD.bazel",
        "extension.bzl",
        "fail.bzl",
        "hub.bzl",
        "pins.bzl",
    ],
    visibility = ["//:__subpackages__"],
)

dx_prebuilt_hub_tests(name = "hub_test")

dx_unavailable(
    name = "unavailable",
    testonly = True,
    cpu = "riscv64",
    message = unsupported_message([]),
    os = "linux",
    tags = ["manual"],
)

failure_test(
    name = "unavailable_fails_test",
    expected_failure_substring = "no prebuilt binary for linux riscv64",
    target = ":unavailable",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "extension.bzl",
        "fail.bzl",
        "hub.bzl",
        "hub_tests.bzl",
        "pins.bzl",
    ],
    tags = ["corpus"],
)
