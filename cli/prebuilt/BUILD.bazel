load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//core:failure_test.bzl", "failure_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load(":fail.bzl", "dx_unavailable")
load(":gazelle_hub_tests.bzl", "dx_gazelle_hub_tests")
load(":hub.bzl", "unsupported_message")
load(":hub_tests.bzl", "dx_prebuilt_hub_tests")
load(":tools.bzl", "registry_lines")

exports_files(
    [
        "extension.bzl",
        "fail.bzl",
        "hub.bzl",
        "pins.bzl",
        "tools.bzl",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "module_srcs",
    srcs = [
        "BUILD.bazel",
        "extension.bzl",
        "fail.bzl",
        "gazelle.bzl",
        "gazelle_hub.bzl",
        "gazelle_hub_tests.bzl",
        "hub.bzl",
        "hub_tests.bzl",
        "pins.bzl",
        "tools.bzl",
    ],
    visibility = ["//:__subpackages__"],
)

dx_prebuilt_hub_tests(name = "hub_test")

dx_gazelle_hub_tests(name = "gazelle_hub_test")

# tools.bzl as "<tool> <platform key> <asset>" lines, the registry fill_pins checks manifests against.
write_file(
    name = "registry",
    out = "registry.txt",
    content = registry_lines() + [""],
    visibility = ["//tools/ci/fill_pins:__pkg__"],
)

dx_unavailable(
    name = "unavailable",
    testonly = True,
    cpu = "riscv64",
    message = unsupported_message([]),
    os = "linux",
    tags = ["manual"],
)

failure_test(
    name = "unavailable_fails_test",
    expected_failure_substring = "no prebuilt binary for linux riscv64",
    target = ":unavailable",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "extension.bzl",
        "fail.bzl",
        "gazelle.bzl",
        "gazelle_hub.bzl",
        "gazelle_hub_tests.bzl",
        "hub.bzl",
        "hub_tests.bzl",
        "pins.bzl",
        "tools.bzl",
    ],
    tags = ["corpus"],
)
