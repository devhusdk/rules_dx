load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:crate.bzl", "dx_rust_crate")
load("//tools/visibility:visibility.bzl", "VIS_CLI_DEPLOY")

package(default_visibility = VIS_CLI_DEPLOY)

dx_rust_crate(
    name = "dx_process",
    package_name = "cli/dx_process",
    srcs = [
        "src/lib.rs",
        "src/lib_tests.rs",
    ],
    extra_deps = ["//cli/path:dx_path"],
    extra_test_deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing:dx_testing",
    ],
    test_data = ["//tools/testing/process_probe"],
    test_env = {
        "DX_PROCESS_PROBE": "$(rootpath //tools/testing/process_probe:process_probe)",
    },
    deps = [
        "thiserror",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files([
    "src/lib.rs",
])
