load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//rust/private:wrapper_tests.bzl", "dx_test_srcs_split_tests")
load("//tools/visibility:visibility.bzl", "VIS_CLI_DEPLOY_QUALITY_TOOLS")

package(default_visibility = VIS_CLI_DEPLOY_QUALITY_TOOLS)

rust_library(
    name = "dx_process",
    srcs = [
        "src/bazel_sh.rs",
        "src/capture.rs",
        "src/groups.rs",
        "src/lib.rs",
        "src/lifecycle.rs",
        "src/rc.rs",
        "src/rc_sections.rs",
        "src/runner.rs",
        "src/slot_pool.rs",
        "src/stderr_tail.rs",
    ] + select({
        "@platforms//os:windows": [
            "src/lifecycle_windows.rs",
            "src/procs_windows.rs",
        ],
        "//conditions:default": [
            "src/lifecycle_unix.rs",
            "src/procs.rs",
            "src/terminal.rs",
        ],
    }),  # keep: Gazelle cannot express the per-OS srcs
    aliases = aliases(
        package_name = "cli/dx_process",
        normal = True,
    ),
    crate_name = "dx_process",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_process",
        normal = True,
    ) + [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/error:dx_error",
    ],
)

rust_test(
    name = "dx_process_test",
    size = "small",
    srcs = [
        "src/bazel_sh.rs",
        "src/bazel_sh_tests.rs",
        "src/capture.rs",
        "src/capture_tests.rs",
        "src/groups.rs",
        "src/groups_tests.rs",
        "src/lib.rs",
        "src/lib_tests.rs",
        "src/lifecycle.rs",
        "src/lifecycle_tests.rs",
        "src/procs_tests.rs",
        "src/rc.rs",
        "src/rc_sections.rs",
        "src/rc_sections_tests.rs",
        "src/rc_tests.rs",
        "src/runner.rs",
        "src/runner_tests.rs",
        "src/slot_pool.rs",
        "src/slot_pool_tests.rs",
        "src/stderr_tail.rs",
        "src/terminal_tests.rs",
    ] + select({
        "@platforms//os:windows": [
            "src/lifecycle_windows.rs",
            "src/procs_windows.rs",
        ],
        "//conditions:default": [
            "src/lifecycle_unix.rs",
            "src/procs.rs",
            "src/terminal.rs",
        ],
    }),  # keep: Gazelle cannot express the per-OS srcs
    aliases = aliases(
        package_name = "cli/dx_process",
        normal = True,
        normal_dev = True,
    ),
    coverage_lib = ":dx_process",
    crate_name = "dx_process",
    crate_root = "src/lib.rs",
    data = [
        "//tools/testing/process_probe",
    ],
    env = {
        "DX_PROCESS_PROBE": "$(rootpath //tools/testing/process_probe:process_probe)",
    },
    deps = all_crate_deps(
        package_name = "cli/dx_process",
        normal = True,
        normal_dev = True,
    ) + [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/error:dx_error",
        "//cli/test_scratch:dx_test_scratch",
        "//tools/bazelrc:dx_preset",
        "//tools/testing:dx_testing",
    ],
)

dx_test_srcs_split_tests(
    name = "test_srcs_split_test",
    lib = ":dx_process",
    test = ":dx_process_test",
    test_src = "cli/process/src/lib_tests.rs",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files([
    "src/lib.rs",
])

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)
