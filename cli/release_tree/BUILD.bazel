load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "release_tree",
    srcs = [
        "src/lib.rs",
        "src/tree.rs",
    ],
    crate_name = "release_tree",
    crate_root = "src/lib.rs",
    visibility = ["//cli/cli:__pkg__"],
    deps = ["//cli/error:dx_error"],
)

rust_test(
    name = "release_tree_test",
    size = "small",
    srcs = [
        "src/lib.rs",
        "src/tree.rs",
        "src/tree_tests.rs",
    ],
    coverage_lib = ":release_tree",
    crate_name = "release_tree",
    crate_root = "src/lib.rs",
    deps = [
        "//cli/error:dx_error",
        "//cli/test_scratch:dx_test_scratch",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)

exports_files(
    ["src/lib.rs"],
    visibility = ["//core/quality:__pkg__"],
)
