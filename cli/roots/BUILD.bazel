load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@crates//:crates.bzl", "aliases")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI")
load(":roots.bzl", "repository_roots_file", "roots_aggregate")

package(default_visibility = VIS_CLI)

rust_library(
    name = "dx_roots",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "cli/dx_roots",
        normal = True,
    ),
    crate_name = "dx_roots",
    crate_root = "src/lib.rs",
    deps = [],
)

rust_test(
    name = "dx_roots_test",
    size = "small",
    aliases = aliases(
        package_name = "cli/dx_roots",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_roots",
    deps = [],
)

exports_files([
    "roots.bzl",
    "src/lib.rs",
])

repository_roots_file(
    name = "roots_pattern_fixture",
    out = "roots_pattern_fixture.txt",
    roots = ["//..."],
)

roots_aggregate(
    name = "roots_monolith_fixture",
    deps = [
        "//dx:codegen",
        "//dx:env",
    ],
)

genquery(
    name = "sync_roots_rust",
    expression = "kind('rust_', deps(//dx:env) + deps(//dx:codegen))",
    scope = [
        "//dx:codegen",
        "//dx:env",
    ],
)

write_file(
    name = "no_rust",
    out = "no_rust.txt",
    content = [],
)

# dx sync builds these roots in every consumer, so they must not compile Rust.
diff_test(
    name = "sync_roots_build_no_rust_test",
    file1 = ":sync_roots_rust",
    file2 = ":no_rust",
)

filegroup(
    name = "cli_reaches_tools_probe",
    srcs = ["//tools/visibility:layer_sentinel"],
    tags = ["manual"],
    visibility = ["//tools/visibility:__pkg__"],
)

filegroup(
    name = "cli_reaches_tools_file_probe",
    srcs = ["//cli/depcheck:Cargo.toml"],
    tags = ["manual"],
    visibility = ["//tools/visibility:__pkg__"],
)

filegroup(
    name = "cli_reaches_dx_commands_probe",
    srcs = ["//dx:generate"],
    tags = ["manual"],
    visibility = ["//tools/visibility:__pkg__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "roots.bzl",
    ],
    tags = ["corpus"],
    visibility = VIS_CLI + ["//tools/ci:__pkg__"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)
