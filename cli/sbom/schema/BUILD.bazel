load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI_DEPLOY_QUALITY")

package(default_visibility = VIS_CLI_DEPLOY_QUALITY)

exports_files([
    "src/lib.rs",
])

# Test-only schemas, vendored verbatim from spdx-spec v2.3 and CycloneDX specification 1.6.
rust_library(
    name = "dx_sbom_schema",
    testonly = True,
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "cli/sbom/dx_sbom_schema",
        normal = True,
    ),
    compile_data = [
        "bom-1.6.schema.json",
        "jsf-0.82.schema.json",
        "spdx-schema.json",
        "spdx.schema.json",
    ],
    crate_name = "dx_sbom_schema",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/sbom/dx_sbom_schema",
        normal = True,
    ) + [
        "//cli/sbom:dx_sbom",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "dx_sbom_schema_test",
    size = "small",
    testonly = True,
    srcs = [
        "src/lib.rs",
        "src/tests.rs",
    ],
    aliases = aliases(
        package_name = "cli/sbom/dx_sbom_schema",
        normal = True,
        normal_dev = True,
    ),
    compile_data = [
        "bom-1.6.schema.json",
        "jsf-0.82.schema.json",
        "spdx-schema.json",
        "spdx.schema.json",
    ],
    coverage_lib = ":dx_sbom_schema",
    crate_name = "dx_sbom_schema",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/sbom/dx_sbom_schema",
        normal = True,
        normal_dev = True,
    ) + [
        "//cli/sbom:dx_sbom",
        "@crates//:serde_json",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
