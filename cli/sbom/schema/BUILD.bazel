load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI_DEPLOY_QUALITY")

package(default_visibility = VIS_CLI_DEPLOY_QUALITY)

exports_files([
    "src/lib.rs",
])

# spdx-schema.json is vendored verbatim from
# https://raw.githubusercontent.com/spdx/spdx-spec/v2.3/schemas/spdx-schema.json
# sha256 239208b7ac287b3cf5d9a9af23f9d69863971102a5e1587a27a398b43490b89b
# bom-1.6.schema.json, spdx.schema.json and jsf-0.82.schema.json are vendored verbatim from
# https://raw.githubusercontent.com/CycloneDX/specification/1.6/schema/<file>
# sha256 3e92dddbc30cf7f6a02b80f0942b1a4cfd4fb1c26f1dfc4310afa9d613cafb93 bom-1.6.schema.json
# sha256 baa9d3bd1ed57b6751b0887edead6b5063ff53ff7429cf85d476c6c94af0166e spdx.schema.json
# sha256 8bae002c25e723db7ee1f26afde680ae1a2b1a8f6b4b4b0fd65dc3becb090aae jsf-0.82.schema.json
# Test-only: the validator must never ship inside dx or release_tool.
rust_library(
    name = "dx_sbom_schema",
    testonly = True,
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "cli/sbom/dx_sbom_schema",
        normal = True,
    ),
    compile_data = [
        "bom-1.6.schema.json",
        "jsf-0.82.schema.json",
        "spdx-schema.json",
        "spdx.schema.json",
    ],
    crate_name = "dx_sbom_schema",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/sbom/dx_sbom_schema",
        normal = True,
    ) + [
        "//cli/sbom:dx_sbom",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "dx_sbom_schema_test",
    size = "small",
    testonly = True,
    srcs = [
        "src/lib.rs",
        "src/tests.rs",
    ],
    aliases = aliases(
        package_name = "cli/sbom/dx_sbom_schema",
        normal = True,
        normal_dev = True,
    ),
    compile_data = [
        "bom-1.6.schema.json",
        "jsf-0.82.schema.json",
        "spdx-schema.json",
        "spdx.schema.json",
    ],
    coverage_lib = ":dx_sbom_schema",
    crate_name = "dx_sbom_schema",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/sbom/dx_sbom_schema",
        normal = True,
        normal_dev = True,
    ) + [
        "//cli/sbom:dx_sbom",
        "@crates//:serde_json",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)
