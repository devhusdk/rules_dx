load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

rust_library(
    name = "dx_shim",
    srcs = [
        "src/fetch.rs",
        "src/lib.rs",
        "src/protocol.rs",
        "src/run.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_shim",
        normal = True,
    ),
    crate_name = "dx_shim",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_shim",
        normal = True,
    ) + [
        "//cli/error:dx_error",
    ],
)

rust_binary(
    name = "dx_shim_bin",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "cli/dx_shim",
        normal = True,
    ),
    crate_name = "dx",
    crate_root = "src/main.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_shim",
        normal = True,
    ) + [":dx_shim"],
)

rust_test(
    name = "dx_shim_test",
    srcs = [
        "src/fetch.rs",
        "src/lib.rs",
        "src/protocol.rs",
        "src/protocol_tests.rs",
        "src/run.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_shim",
        normal = True,
        normal_dev = True,
    ),
    coverage_lib = ":dx_shim",
    crate_name = "dx_shim",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_shim",
        normal = True,
        normal_dev = True,
    ) + [
        "//cli/adopt:dx_adopt",
        "//cli/error:dx_error",
    ],
)

rust_test(
    name = "fetch_test",
    srcs = [
        "tests/fetch.rs",
        "tests/support/mod.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_shim",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "fetch_test",
    crate_root = "tests/fetch.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_shim",
        normal = True,
        normal_dev = True,
    ) + [":dx_shim"],
)

rust_test(
    name = "e2e_test",
    srcs = [
        "tests/e2e.rs",
        "tests/support/mod.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_shim",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "e2e_test",
    crate_root = "tests/e2e.rs",
    data = [
        ":dx_shim_bin",
        ":fake_dx",
    ],
    env = {
        "DX_FAKE_BIN": "$(rootpath :fake_dx)",
        "DX_SHIM_BIN": "$(rootpath :dx_shim_bin)",
    },
    deps = all_crate_deps(
        package_name = "cli/dx_shim",
        normal = True,
        normal_dev = True,
    ) + [
        ":dx_shim",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "interop_test",
    srcs = [
        "tests/interop.rs",
        "tests/support/mod.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_shim",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "interop_test",
    crate_root = "tests/interop.rs",
    data = [
        ":dx_shim_bin",
        ":fake_dx",
    ],
    env = {
        "DX_FAKE_BIN": "$(rootpath :fake_dx)",
        "DX_SHIM_BIN": "$(rootpath :dx_shim_bin)",
    },
    deps = all_crate_deps(
        package_name = "cli/dx_shim",
        normal = True,
        normal_dev = True,
    ) + [
        ":dx_shim",
        "//cli/adopt:dx_adopt",
    ],
)

exports_files(["Cargo.toml"])

test_suite(
    name = "all",
    tests = [
        ":dx_shim_test",
        ":e2e_test",
        ":fetch_test",
        ":interop_test",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

rust_binary(
    name = "fake_dx",
    srcs = ["fake/fake_dx.rs"],
    aliases = aliases(
        package_name = "cli/dx_shim",
        normal = True,
    ),
    crate_name = "fake_dx",
    crate_root = "fake/fake_dx.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_shim",
        normal = True,
    ) + [":dx_shim"],
)

exports_files(
    [
        "src/lib.rs",
        "src/main.rs",
    ],
    visibility = ["//core/quality:__pkg__"],
)
