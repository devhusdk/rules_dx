load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust/rules:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_library(
    name = "dx_tool_resolve",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "cli/dx_tool_resolve",
        normal = True,
    ),
    crate_name = "dx_tool_resolve",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_tool_resolve",
        normal = True,
    ) + ["//cli/process:dx_process"],
)

rust_test(
    name = "dx_tool_resolve_test",
    srcs = [
        "src/lib.rs",
        "src/lib_tests.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_tool_resolve",
        normal = True,
        normal_dev = True,
    ),
    coverage_lib = ":dx_tool_resolve",
    crate_name = "dx_tool_resolve",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_tool_resolve",
        normal = True,
        normal_dev = True,
    ) + ["//cli/process:dx_process"],
)

rust_binary(
    name = "tool_resolve",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "cli/dx_tool_resolve",
        normal = True,
    ),
    crate_name = "tool_resolve",
    crate_root = "src/main.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_tool_resolve",
        normal = True,
    ) + [
        ":dx_tool_resolve",
        "//cli/process:dx_process",
    ],
)

rust_test(
    name = "tool_resolve_bin_test",
    srcs = [
        "src/main.rs",
        "src/main_tests.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_tool_resolve",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "tool_resolve",
    crate_root = "src/main.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_tool_resolve",
        normal = True,
        normal_dev = True,
    ) + [
        ":dx_tool_resolve",
        "//cli/process:dx_process",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
