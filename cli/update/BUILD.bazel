        "src/discover/npm.rs",
        "src/discover/nuget.rs",
        "src/discover/opam.rs",
        "src/discover/pub_dev.rs",
        "src/discover/pypi.rs",
        "src/discover/ruby.rs",
        "src/discover/swiftpm.rs",
        "src/edit/add.rs",
