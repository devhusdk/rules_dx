load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:crate.bzl", "dx_rust_crate")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

exports_files([
    "src/lib.rs",
])

dx_rust_crate(
    name = "dx_update",
    package_name = "cli/dx_update",
    srcs = [
        "src/backend.rs",
        "src/bump/add.rs",
        "src/bump/add_plans.rs",
        "src/bump/gha.rs",
        "src/bump/mod.rs",
        "src/bump/request.rs",
        "src/bump/request_cargo.rs",
        "src/bump/request_plans.rs",
        "src/bump/request_pyproject.rs",
        "src/bump/sets.rs",
        "src/bump/version.rs",
        "src/lib.rs",
        "src/outcome.rs",
        "src/recovery.rs",
        "src/report.rs",
        "src/root_sets_tests.rs",
        "src/selector.rs",
        "src/sets.rs",
    ],
    # Root files read through `include_str!` by src/root_sets_tests.rs.
    compile_data = [
        "//:MODULE.bazel",
        "//third_party/dotnet:extension.bzl",
        "//third_party/dotnet:paket.dependencies",
    ],
    dev_deps = ["toml"],
    extra_deps = [
        "//cli/adopt:dx_adopt",
        "//cli/digest:dx_digest",
        "//libs/gomod:dx_gomod",
        "//cli/process:dx_process",
        "//libs/module_bazel:dx_module_bazel",
    ],
    extra_test_deps = [
        "//cli/test_scratch:dx_test_scratch",
    ],
    test_srcs = [
        "src/bump/add_tests.rs",
        "src/bump/request_tests.rs",
    ],
    deps = [
        "saphyr-parser",
        "semver",
        "serde_json",
        "thiserror",
        "toml_edit",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

alias(
    name = "python_interpreter",
    actual = "@python_3_12//:python3",
    visibility = ["//visibility:public"],
)

alias(
    name = "python_files",
    actual = "@python_3_12//:files",
    visibility = ["//visibility:public"],
)
