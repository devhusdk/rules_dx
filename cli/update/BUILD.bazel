load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:crate.bzl", "dx_rust_crate")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

exports_files([
    "src/lib.rs",
])

dx_rust_crate(
    name = "dx_update",
    package_name = "cli/dx_update",
    srcs = [
        "src/backend.rs",
        "src/lib.rs",
        "src/manifest.rs",
        "src/outcome.rs",
        "src/recovery.rs",
        "src/report.rs",
        "src/selector.rs",
        "src/sets.rs",
    ],
    extra_deps = [
        "//cli/adopt:dx_adopt",
        "//cli/identity:dx_identity",
        "//cli/path:dx_path",
        "//cli/process:dx_process",
    ],
    deps = [
        "thiserror",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

alias(
    name = "python_interpreter",
    actual = "@python_3_12//:python3",
    visibility = ["//visibility:public"],
)

alias(
    name = "python_files",
    actual = "@python_3_12//:files",
    visibility = ["//visibility:public"],
)
