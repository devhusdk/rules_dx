load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

exports_files([
    "src/lib.rs",
])

rust_library(
    name = "dx_worktree",
    srcs = [
        "src/cache.rs",
        "src/disk.rs",
        "src/git.rs",
        "src/hook.rs",
        "src/host.rs",
        "src/lib.rs",
        "src/ops.rs",
        "src/pool.rs",
        "src/reap.rs",
        "src/setup.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_worktree",
        normal = True,
    ),
    crate_name = "dx_worktree",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_worktree",
        normal = True,
    ) + [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/error:dx_error",
        "//cli/merge:dx_merge",
        "//cli/path:dx_path",
        "//cli/process:dx_process",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "dx_worktree_test",
    size = "small",
    srcs = [
        "src/cache.rs",
        "src/disk.rs",
        "src/git.rs",
        "src/hook.rs",
        "src/host.rs",
        "src/lib.rs",
        "src/ops.rs",
        "src/pool.rs",
        "src/reap.rs",
        "src/setup.rs",
        "src/tests.rs",
    ],
    aliases = aliases(
        package_name = "cli/dx_worktree",
        normal = True,
        normal_dev = True,
    ),
    coverage_lib = ":dx_worktree",
    crate_name = "dx_worktree",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "cli/dx_worktree",
        normal = True,
        normal_dev = True,
    ) + [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/error:dx_error",
        "//cli/merge:dx_merge",
        "//cli/path:dx_path",
        "//cli/process:dx_process",
        "//cli/test_scratch:dx_test_scratch",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)
