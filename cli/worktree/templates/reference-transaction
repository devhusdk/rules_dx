#!/bin/sh
[ "$1" = prepared ] || exit 0
main=$(git worktree list --porcelain) || exit 0
main=${main%%"
"*}
dx=${main#worktree }/tools/dx
[ -x "$dx" ] || exit 0
out=$("$dx" worktree hook git 2>&1) && exit 0
case $out in
*"dx: refused: no git update of "*)
  printf '%s\n' "$out" >&2
  exit 1
  ;;
esac
exit 0
