#!/bin/sh
# Written by dx worktree add, which rewrites it.
main=@MAIN@
[ "$1" = prepared ] || exit 0
here=$(git worktree list --porcelain) || exit 0
here=${here%%"
"*}
[ "$here" = "worktree $main" ] || exit 0
dx=$main/tools/dx
[ -x "$dx" ] || exit 0
out=$("$dx" worktree hook git 2>&1) && exit 0
case $out in
*"dx: refused: no git update of "*)
  printf '%s\n' "$out" >&2
  exit 1
  ;;
esac
exit 0
