load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")
load("//quality:fixtures.bzl", "real_source_target")
load("//quality:policy_subject.bzl", "policy_subject")
load(":settings_tests.bzl", "settings_tests", "workspace_policy_tests")
load(":subject.bzl", "settings_subject")

package(default_visibility = ["//visibility:public"])

label_flag(
    name = "workspace",
    build_setting_default = "//quality:default_workspace_policy",
)

label_flag(
    name = "tool_ruff",
    build_setting_default = "@dx_tools//:ruff",
)

bool_flag(
    name = "validate",
    build_setting_default = False,
)

string_flag(
    name = "fail_on",
    build_setting_default = "warning",
    values = [
        "error",
        "info",
        "warning",
    ],
)

settings_subject(name = "settings_under_test")

settings_tests(name = "settings")

policy_subject(
    name = "workspace_policy_under_test",
    policy = "//config:workspace",
)

workspace_policy_tests(name = "workspace_policy")

test_suite(
    name = "all",
    tests = [
        ":settings",
        ":workspace_policy",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "settings_tests.bzl",
        "subject.bzl",
    ],
    tags = ["corpus"],
)
