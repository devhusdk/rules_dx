alias(
    name = "clippy_output_diagnostics",
    actual = "@rules_rust//rust/settings:clippy_output_diagnostics",
)

alias(
    name = "rustc_output_diagnostics",
    actual = "@rules_rust//rust/settings:rustc_output_diagnostics",
)

settings_subject(name = "settings_under_test")

settings_tests(name = "settings")

policy_subject(
    name = "workspace_policy_under_test",
    policy = "//config:workspace",
)

workspace_policy_tests(name = "workspace_policy")

test_suite(
    name = "all",
    tests = [
        ":settings",
        ":workspace_policy",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "settings_tests.bzl",
        "subject.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
