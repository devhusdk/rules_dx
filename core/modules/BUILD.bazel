    crate_name = "consumer_deps_test",
    crate_root = "consumer_deps_test.rs",
    data = [
        "bazel_dep_allowlist.txt",
        "bcr_newest.json",
        ":consumer_deps_json",
        "//:MODULE.bazel",
        "//third_party/go:go.sum",
        "//tools/testing/hermetic:module_fragments",
    ],
    deps = all_crate_deps(
        package_name = "core/modules_tests",
        normal = True,
        normal_dev = True,
    ) + [
        "//cli/module_bazel:dx_module_bazel",
        "//tools/testing:dx_testing",
        "@crates//:serde_json",
    ],
)

