load("@bazel_lib//lib:run_binary.bzl", "run_binary")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load(":consumer_deps.bzl", "consumer_deps_json")
load(":versions_rs.bzl", "versions_rs")
load(":versions_tests.bzl", "versions_contract_tests")

package(default_visibility = ["//:__subpackages__"])

versions_contract_tests(name = "versions_contract")

consumer_deps_json(name = "consumer_deps_json")

versions_rs(name = "versions_rs")

# keep: sources generated by versions_rs
rust_library(
    name = "dx_versions",
    srcs = [":versions_rs"],
    crate_name = "dx_versions",
    crate_root = ":versions_rs",
    visibility = ["//cli/adopt:__pkg__"],
)

rust_test(
    name = "consumer_deps_test",
    size = "small",
    srcs = ["consumer_deps_test.rs"],
    aliases = aliases(
        package_name = "core/modules_tests",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "consumer_deps_test",
    crate_root = "consumer_deps_test.rs",
    data = [
        ":consumer_deps_json",
        "//:MODULE.bazel",
        "//:MODULE.bazel.lock",
        "//third_party/go:go.sum",
        "//tools/testing/hermetic:module_fragments",
        "//tools/testing/nested_cache:all_locks",
    ],
    env = {"DX_NESTED_LOCKS": "$(rlocationpaths //tools/testing/nested_cache:all_locks)"},
    deps = all_crate_deps(
        package_name = "core/modules_tests",
        normal = True,
        normal_dev = True,
    ) + [
        "//cli/module_bazel:dx_module_bazel",
        "//tools/testing:dx_testing",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "lang_json_test",
    size = "small",
    srcs = ["lang_json_test.rs"],
    aliases = aliases(
        package_name = "core/modules_tests",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "lang_json_test",
    crate_root = "lang_json_test.rs",
    data = [
        "lang.schema.json",
        "//:MODULE.bazel",
        "//cli/ecosystems:ecosystems.json",
        "//docs:support-matrix.md",
        "//tools/quality:family_tools.bzl",
    ],
    deps = all_crate_deps(
        package_name = "core/modules_tests",
        normal = True,
        normal_dev = True,
    ) + [
        "//tools/testing:dx_testing",
        "@crates//:serde_json",
    ],
)

rust_binary(
    name = "lang_projections",
    srcs = ["lang_projections.rs"],
    visibility = ["//visibility:private"],
    deps = ["@crates//:serde_json"],
)

# keep
rust_test(
    name = "lang_projections_test",
    size = "small",
    crate = ":lang_projections",
)

run_binary(
    name = "lang_projections_generated",
    srcs = [
        "//:lang_json",
        "//core/quality:core_aspects.json",
        "//core/quality:families/core_probe.bzl",
        "//core/quality/testdata:all_languages.bzl",
    ],
    outs = [
        "generated/all_languages.bzl",
        "generated/conformance_quality.bzl",
        "generated/core_probe.bzl",
        "generated/ecosystems_languages.json",
        "generated/families_languages.json",
        "generated/langs.bzl",
        "generated/lock_registry.bzl",
        "generated/lock_registry.json",
        "generated/merged_probe.bzl",
    ],
    args = [
        "all_languages.bzl=$(execpath generated/all_languages.bzl)",
        "all_languages_src=$(execpath //core/quality/testdata:all_languages.bzl)",
        "conformance_quality.bzl=$(execpath generated/conformance_quality.bzl)",
        "core_aspects=$(execpath //core/quality:core_aspects.json)",
        "core_probe.bzl=$(execpath generated/core_probe.bzl)",
        "core_probe_src=$(execpath //core/quality:families/core_probe.bzl)",
        "ecosystems_languages.json=$(execpath generated/ecosystems_languages.json)",
        "families_languages.json=$(execpath generated/families_languages.json)",
        "langs.bzl=$(execpath generated/langs.bzl)",
        "lock_registry.bzl=$(execpath generated/lock_registry.bzl)",
        "lock_registry.json=$(execpath generated/lock_registry.json)",
        "merged_probe.bzl=$(execpath generated/merged_probe.bzl)",
        "--",
        "$(execpaths //:lang_json)",
    ],
    tool = ":lang_projections",
)

write_source_files(
    name = "update_lang_projections",
    additional_update_targets = [
        "//cli/ecosystems:update_languages",
        "//cli/families:update_languages",
        "//core/quality:update_core_probe",
        "//core/quality:update_merged_probe",
        "//core/quality/testdata:update_all_languages",
        "//gazelle/common:update_lock_registry",
        "//tools/testing/conformance:update_quality",
    ],
    files = {
        "langs.bzl": "generated/langs.bzl",
        "lock_registry.bzl": "generated/lock_registry.bzl",
    },
    visibility = ["//visibility:private"],
)

test_suite(
    name = "all",
    tests = [
        ":consumer_deps_test",
        ":lang_json_test",
        ":lang_projections_test",
        ":versions_contract",
    ],
)

exports_files([
    "consumer_deps.bzl",
    "core_budget.json",
    "cuda.bzl",
    "rust.bzl",
    "python.bzl",
    "langs.bzl",
    "lock.schema.json",
    "lock_registry.bzl",
    "python_consumer_budget.json",
    "versions.bzl",
])

# keep
real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "consumer_deps.bzl",
        "cuda.bzl",
        "langs.bzl",
        "lock_registry.bzl",
        "//core/quality/testdata:all_languages.bzl",
        "python.bzl",
        "rust.bzl",
        "versions.bzl",
        "versions_rs.bzl",
        "versions_tests.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
