{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rules_dx language manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "title", "family", "ecosystems", "manifests", "lockfiles", "tools", "platforms", "pins", "entry_points"],
  "properties": {
    "$schema": {"type": "string"},
    "name": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "family": {"type": "string"},
    "ecosystems": {"$ref": "#/$defs/strings"},
    "depcheck": {"type": "string", "minLength": 1},
    "semver": {"type": "boolean"},
    "manifests": {"$ref": "#/$defs/strings"},
    "lockfiles": {"$ref": "#/$defs/strings"},
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "licenses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "platforms"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "platforms": {"$ref": "#/$defs/strings"}
            }
          }
        },
        "flags": {"$ref": "#/$defs/strings"},
        "hubs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ecosystem", "manifest", "lock", "state", "extension", "tag", "hub", "resolver", "imports"],
            "properties": {
              "ecosystem": {"type": "string", "minLength": 1},
              "manifest": {"type": "string", "minLength": 1},
              "lock": {"type": ["string", "null"], "minLength": 1},
              "state": {"type": ["string", "null"], "minLength": 1},
              "extension": {"type": "string", "minLength": 1},
              "tag": {"type": ["string", "null"], "minLength": 1},
              "hub": {"type": "string", "minLength": 1},
              "resolver": {"type": ["string", "null"], "minLength": 1},
              "imports": {"enum": ["name", "provides"]}
            }
          }
        }
      }
    },
    "tools": {"$ref": "#/$defs/strings"},
    "platforms": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["linux_arm64", "linux_x86_64", "macos_arm64", "windows_arm64", "windows_x86_64"]}
    },
    "pins": {"$ref": "#/$defs/strings"},
    "entry_points": {"$ref": "#/$defs/strings"},
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bzl", "file_extensions"],
      "properties": {
        "bzl": {"type": "string", "minLength": 1},
        "every_workspace": {"type": "boolean"},
        "file_extensions": {"$ref": "#/$defs/strings"},
        "file_names": {"$ref": "#/$defs/strings"},
        "aspects": {"$ref": "#/$defs/commands"},
        "probes": {"$ref": "#/$defs/commands"}
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bzl", "file_extensions", "aspects"],
      "properties": {
        "bzl": {"type": "string", "minLength": 1},
        "file_extensions": {"$ref": "#/$defs/strings"},
        "aspects": {"$ref": "#/$defs/strings"}
      }
    }
  },
  "$defs": {
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {"$ref": "#/$defs/strings"},
        "lint": {"$ref": "#/$defs/strings"},
        "typecheck": {"$ref": "#/$defs/strings"}
      }
    },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
