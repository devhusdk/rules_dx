{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dx lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ecosystem", "inputs", "packages"],
  "properties": {
    "schema": {"const": 1},
    "ecosystem": {"type": "string", "pattern": "^[a-z][a-z0-9]*$"},
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[^/\\\\]+$"},
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "packages": {
      "type": "array",
      "items": {"$ref": "#/$defs/package"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "names": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/name"}
    },
    "name": {"type": "string", "pattern": "^[A-Za-z0-9@_+.-]+(/[A-Za-z0-9@_+.-]+)*$"},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "archives", "deps", "provides"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "version": {"type": "string", "minLength": 1},
        "archives": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/archive"}
        },
        "deps": {"$ref": "#/$defs/names"},
        "provides": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "dev": {"const": true},
        "extra": {"$ref": "#/$defs/extra"}
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["urls", "sha256"],
      "properties": {
        "urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^https://[^\\s]+$"}
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "strip_prefix": {"type": "string", "minLength": 1},
        "type": {"enum": ["zip", "tar", "tar.gz"]},
        "platform": {
          "enum": ["linux_arm64", "linux_x86_64", "macos_arm64", "macos_x86_64", "windows_arm64", "windows_x86_64"]
        }
      }
    },
    "extra": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "bicep_manifest": {"$ref": "#/$defs/archive"},
        "cabal_components": {"$ref": "#/$defs/strings"},
        "cabal_revision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "sha256"],
          "properties": {
            "number": {"type": "integer", "minimum": 0},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "cabal_tools": {"$ref": "#/$defs/strings"},
        "zig_main": {"type": "string", "minLength": 1},
        "d_library": {
          "type": "object",
          "additionalProperties": false,
          "required": ["imports", "srcs"],
          "properties": {
            "imports": {"$ref": "#/$defs/strings"},
            "srcs": {"$ref": "#/$defs/strings"},
            "string_imports": {"$ref": "#/$defs/strings"}
          }
        },
        "lua_modules": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "swift_products": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "swift_targets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["deps", "module", "path", "product_deps", "srcs"],
            "properties": {
              "defines": {"$ref": "#/$defs/strings"},
              "deps": {"$ref": "#/$defs/strings"},
              "header_paths": {"$ref": "#/$defs/strings"},
              "include": {"type": "string", "minLength": 1},
              "kind": {"enum": ["clang"]},
              "module": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "product_deps": {"$ref": "#/$defs/strings"},
              "srcs": {"$ref": "#/$defs/strings"}
            }
          }
        }
      }
    }
  }
}
