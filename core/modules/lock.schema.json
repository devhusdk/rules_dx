{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dx lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ecosystem", "inputs", "packages"],
  "properties": {
    "schema": {"const": 1},
    "ecosystem": {"type": "string", "pattern": "^[a-z][a-z0-9]*$"},
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[^/\\\\]+$"},
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "packages": {
      "type": "array",
      "items": {"$ref": "#/$defs/package"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "names": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/name"}
    },
    "name": {"type": "string", "pattern": "^[A-Za-z0-9@_+.-]+(/[A-Za-z0-9@_+.-]+)*$"},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "archives", "deps", "provides"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "version": {"type": "string", "minLength": 1},
        "archives": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/archive"}
        },
        "deps": {"$ref": "#/$defs/names"},
        "provides": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "dev": {"const": true},
        "extra": {"$ref": "#/$defs/extra"}
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["urls", "sha256"],
      "properties": {
        "urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^https://[^\\s]+$"}
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "strip_prefix": {"type": "string", "minLength": 1},
        "platform": {
          "enum": ["linux_arm64", "linux_x86_64", "macos_arm64", "macos_x86_64", "windows_arm64", "windows_x86_64"]
        }
      }
    },
    "extra": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {}
    }
  }
}
