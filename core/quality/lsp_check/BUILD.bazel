load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_QUALITY")

package(default_visibility = VIS_QUALITY + ["//cli/cli:__pkg__"])

rust_library(
    name = "lsp_check_lib",
    srcs = [
        "src/entry.rs",
        "src/lib.rs",
    ],
    crate_name = "lsp_check",
    crate_root = "src/lib.rs",
    deps = ["@crates//:serde_json"],
)

rust_binary(
    name = "lsp_check",
    srcs = ["src/main.rs"],
    crate_name = "lsp_check",
    crate_root = "src/main.rs",
    visibility = ["//visibility:public"],
    deps = [":lsp_check_lib"],
)

rust_test(
    name = "lsp_check_test",
    srcs = [
        "src/entry.rs",
        "src/lib.rs",
        "src/tests.rs",
    ],
    coverage_lib = ":lsp_check_lib",
    crate_name = "lsp_check",
    crate_root = "src/lib.rs",
    deps = ["@crates//:serde_json"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
