load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_QUALITY_ENV")

package(default_visibility = VIS_QUALITY_ENV)

rust_library(
    name = "quality_markdown_lib",
    srcs = [
        "src/check.rs",
        "src/entry.rs",
        "src/frontmatter.rs",
        "src/lib.rs",
    ],
    aliases = aliases(
        package_name = "core/quality/quality_markdown",
        normal = True,
    ),
    crate_name = "quality_markdown",
    crate_root = "src/lib.rs",
    visibility = VIS_QUALITY_ENV + ["//cli/cli:__pkg__"],
    deps = all_crate_deps(
        package_name = "core/quality/quality_markdown",
        normal = True,
    ) + [
        "//cli/fingerprint:dx_fingerprint",
        "//cli/output:dx_output",
        "@crates//:serde",
    ],
)

rust_binary(
    name = "quality_markdown",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "core/quality/quality_markdown",
        normal = True,
    ),
    crate_name = "quality_markdown",
    crate_root = "src/main.rs",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        package_name = "core/quality/quality_markdown",
        normal = True,
    ) + [
        ":quality_markdown_lib",
        "//cli/output:dx_output",
    ],
)

exports_files([
    "Cargo.toml",
    "src/lib.rs",
    "src/main.rs",
])

rust_test(
    name = "quality_markdown_test",
    srcs = [
        "src/check.rs",
        "src/entry.rs",
        "src/frontmatter.rs",
        "src/lib.rs",
        "src/lib_tests.rs",
    ],
    aliases = aliases(
        package_name = "core/quality/quality_markdown",
        normal = True,
        normal_dev = True,
    ),
    coverage_lib = ":quality_markdown_lib",
    crate_name = "quality_markdown",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "core/quality/quality_markdown",
        normal = True,
        normal_dev = True,
    ) + [
        "//cli/fingerprint:dx_fingerprint",
        "//cli/output:dx_output",
        "@crates//:serde",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
    ],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
