load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load(":sh_toolchain.bzl", "dx_sh_toolchain")

toolchain_type(
    name = "compile_check_sh_toolchain_type",
    visibility = ["//visibility:public"],
)

dx_sh_toolchain(
    name = "busybox_sh",
    executable = "@dx_busybox_sh//file",
    launcher = "@bazel_tools//tools/launcher:launcher",
    launcher_maker = "@bazel_tools//tools/launcher:launcher_maker",
)

toolchain(
    name = "busybox_sh_linux_x86_64",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":busybox_sh",
    toolchain_type = ":compile_check_sh_toolchain_type",
)

dx_sh_toolchain(
    name = "busybox_sh_windows",
    executable = "@dx_busybox_sh_windows//file",
    launcher = "@bazel_tools//tools/launcher:launcher",
    launcher_maker = "@bazel_tools//tools/launcher:launcher_maker",
)

toolchain(
    name = "busybox_sh_windows_x86_64",
    exec_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":busybox_sh_windows",
    toolchain_type = ":compile_check_sh_toolchain_type",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "sh_toolchain.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
