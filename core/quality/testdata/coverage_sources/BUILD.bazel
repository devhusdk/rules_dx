load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//d:defs.bzl", "D_COMPATIBLE_WITH", "d_test")
load("//haskell:defs.bzl", "HASKELL_COMPATIBLE_WITH", "haskell_test")
load("//fortran:defs.bzl", "fortran_library", "fortran_test")
load("//ocaml:defs.bzl", "ocaml_module", "ocaml_test")
load("//perl:defs.bzl", "perl_test")
load("//powershell:defs.bzl", "powershell_test")
load("//rust:defs.bzl", dx_rust_library = "rust_library", dx_rust_test = "rust_test")
load("//core/quality:coverage_sources_tests.bzl", "coverage_fixture")
load("//zig:defs.bzl", "zig_library", "zig_test")

package(default_visibility = ["//core/quality:__subpackages__"])

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

rust_library(
    name = "split_lib",
    srcs = [
        "lib.rs",
        "split.rs",
    ],
    crate_root = "lib.rs",
    tags = ["manual"],
)

rust_test(
    name = "split_lib_test",
    crate = ":split_lib",
    tags = ["manual"],
)

cc_library(
    name = "header_lib",
    srcs = ["header.cc"],
    hdrs = ["header.h"],
    tags = ["manual"],
)

cc_library(
    name = "helper_lib",
    testonly = True,
    srcs = ["helper.cc"],
    tags = ["manual"],
)

genrule(
    name = "gen",
    outs = ["gen.cc"],
    cmd = "echo 'int gen_value(void) { return 5; }' > $@",
    tags = ["manual"],
)

coverage_fixture(
    name = "dep_lib",
    srcs = ["dep.cc"],
    tags = ["manual"],
)

coverage_fixture(
    name = "dep_test",
    testonly = True,
    srcs = ["dep_test.cc"],
    tags = ["manual"],
    deps = [
        ":dep_lib",
        ":helper_lib",
    ],
)

coverage_fixture(
    name = "generated_lib",
    srcs = [":gen"],
    tags = ["manual"],
)

coverage_fixture(
    name = "arm_only_lib",
    srcs = ["common.cc"] + select({
        "@platforms//cpu:arm64": ["arm.cc"],
        "//conditions:default": [],
    }),
    tags = ["manual"],
)

perl_test(
    name = "perl_probe_test",
    srcs = ["perl_probe.t"],
    tags = ["manual"],
)

zig_library(
    name = "calc_lib",
    import_name = "calc",
    main = "calc.zig",
    tags = ["manual"],
)

zig_test(
    name = "calc_test",
    main = "calc_test.zig",
    tags = ["manual"],
    deps = [":calc_lib"],
)

haskell_test(
    name = "haskell_probe_test",
    srcs = ["haskell_probe.hs"],
    tags = ["manual"],
    target_compatible_with = HASKELL_COMPATIBLE_WITH,
    deps = ["@dx_haskell_toolchains//:base"],
)

powershell_test(
    name = "pwsh_probe_test",
    srcs = ["pwsh_probe.ps1"],
    tags = ["manual"],
)

d_test(
    name = "d_probe_test",
    srcs = ["d_probe.d"],
    tags = ["manual"],
    target_compatible_with = D_COMPATIBLE_WITH,
)

fortran_library(
    name = "fcalc_lib",
    srcs = ["calc.f90"],
    tags = ["manual"],
)

fortran_test(
    name = "fcalc_test",
    srcs = ["calc_test.f90"],
    tags = ["manual"],
    deps = [":fcalc_lib"],
)

ocaml_module(
    name = "ocaml_probe_main",
    testonly = True,
    struct = "ocaml_probe.ml",
    tags = ["manual"],
)

ocaml_test(
    name = "ocaml_probe_test",
    main = ":ocaml_probe_main",
    tags = ["manual"],
)

dx_rust_library(
    name = "self_contained",
    srcs = ["lib.rs"],
    crate_root = "lib.rs",
    visibility = ["//core/quality:__pkg__"],
)

dx_rust_test(
    name = "self_contained_test",
    size = "small",
    srcs = [
        "lib.rs",
        "unit.rs",
    ],
    coverage_lib = ":self_contained",
    crate_root = "lib.rs",
    visibility = ["//core/quality:__pkg__"],
)
