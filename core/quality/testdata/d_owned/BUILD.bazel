load("//core/quality:policy.bzl", "quality_family")
load("//d:defs.bzl", "d_library")
load("//d/private:defs.bzl", "D_COMPATIBLE_WITH")

package(default_visibility = [
    "//core/quality:__pkg__",
    "//core/quality/testdata:__pkg__",
    "//core/quality/tests/fixtures/consumer_policy:__pkg__",
])

quality_family(
    name = "d_family",
    disabled = [
        "audit",
        "format",
        "lint",
    ],
    family_id = "d",
    typecheck = ["ldc"],
)

d_library(
    name = "clean",
    srcs = ["clean.d"],
    target_compatible_with = D_COMPATIBLE_WITH,
)

d_library(
    name = "dirty",
    srcs = ["dirty.d"],
    tags = ["manual"],
    target_compatible_with = D_COMPATIBLE_WITH,
)
