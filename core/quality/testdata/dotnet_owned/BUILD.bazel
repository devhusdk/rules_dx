load("@rules_dx//csharp:defs.bzl", "csharp_library")
load("//core/quality:policy.bzl", "quality_family")

package(default_visibility = [
    "//core/quality/testdata:__pkg__",
    "//core/quality/tests/fixtures/consumer_policy:__pkg__",
])

quality_family(
    name = "csharp_family",
    disabled = [
        "audit",
        "format",
    ],
    family_id = "csharp",
    lint = ["roslyn"],
)

csharp_library(
    name = "dep",
    testonly = True,
    srcs = ["Dep.cs"],
)

csharp_library(
    name = "unused_dep",
    testonly = True,
    srcs = ["UnusedDep.cs"],
    deps = [":dep"],
)

csharp_library(
    name = "clean",
    testonly = True,
    srcs = ["Clean.cs"],
    out = "Clean",
)
