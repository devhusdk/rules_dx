load("@rules_dx//csharp:defs.bzl", "csharp_library")
load("//core/quality:policy.bzl", "quality_family", "workspace_policy")

package(default_visibility = ["//core/quality/testdata:__pkg__"])

quality_family(
    name = "csharp_family",
    disabled = [
        "audit",
        "format",
    ],
    family_id = "csharp",
    lint = ["roslyn"],
)

workspace_policy(
    name = "policy",
    bases = select({
        "//config:config_profile_strict": ["//core/quality/tiers/roslyn:strict"],
        "//conditions:default": ["//core/quality/tiers/roslyn:standard"],
    }),
    families = [":csharp_family"],
)

csharp_library(
    name = "dep",
    testonly = True,
    srcs = ["Dep.cs"],
)

csharp_library(
    name = "unused_dep",
    testonly = True,
    srcs = ["UnusedDep.cs"],
    deps = [":dep"],
)

csharp_library(
    name = "clean",
    testonly = True,
    srcs = ["Clean.cs"],
    out = "Clean",
)
