load("//core/quality:policy.bzl", "quality_family")
load("//fsharp:defs.bzl", "fsharp_library")

package(default_visibility = [
    "//core/quality:__pkg__",
    "//core/quality/testdata:__pkg__",
    "//core/quality/tests/fixtures/consumer_policy:__pkg__",
])

quality_family(
    name = "fsharp_family",
    disabled = ["audit"],
    family_id = "fsharp",
    format = ["fantomas"],
    lint = ["fsharplint"],
    typecheck = ["fsc"],
)

fsharp_library(
    name = "clean",
    testonly = True,
    srcs = ["Clean.fs"],
    deps = ["@nuget//fsharp.core"],
)

fsharp_library(
    name = "dirty",
    testonly = True,
    srcs = ["Dirty.fs"],
    tags = [
        "manual",
        "no-lint",
    ],
    deps = ["@nuget//fsharp.core"],
)
