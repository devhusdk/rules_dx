load("//core/quality:policy.bzl", "quality_family", "workspace_policy")

package(default_visibility = ["//core/quality/testdata:__pkg__"])

quality_family(
    name = "go_family",
    disabled = [
        "audit",
        "format",
    ],
    family_id = "go",
    lint = [
        "errcheck",
        "govet",
        "staticcheck",
    ],
    typecheck = ["gotype"],
)

workspace_policy(
    name = "policy",
    families = [":go_family"],
)
