load("//haskell:defs.bzl", "HASKELL_COMPATIBLE_WITH", "haskell_library")
load("//core/quality:policy.bzl", "quality_family")

package(default_visibility = [
    "//core/quality:__pkg__",
    "//core/quality/testdata:__pkg__",
    "//core/quality/tests/fixtures/consumer_policy:__pkg__",
])

quality_family(
    name = "haskell_family",
    disabled = ["audit"],
    family_id = "haskell",
    format = ["ormolu"],
    lint = [
        "hlint",
        "weeder",
    ],
    typecheck = ["ghc"],
)

haskell_library(
    name = "clean",
    srcs = ["Clean.hs"],
    ghcopts = ["-Wall"],
    target_compatible_with = HASKELL_COMPATIBLE_WITH,
    deps = ["@dx_haskell_toolchains//:base"],
)

haskell_library(
    name = "dirty",
    srcs = ["Dirty.hs"],
    ghcopts = ["-Wall"],
    target_compatible_with = HASKELL_COMPATIBLE_WITH,
    deps = ["@dx_haskell_toolchains//:base"],
)

haskell_library(
    name = "redundant",
    srcs = ["Redundant.hs"],
    target_compatible_with = HASKELL_COMPATIBLE_WITH,
    deps = ["@dx_haskell_toolchains//:base"],
)

haskell_library(
    name = "weeds",
    srcs = ["Weeds.hs"],
    target_compatible_with = HASKELL_COMPATIBLE_WITH,
    deps = ["@dx_haskell_toolchains//:base"],
)

haskell_library(
    name = "rooted",
    srcs = ["Rooted.hs"],
    target_compatible_with = HASKELL_COMPATIBLE_WITH,
    deps = ["@dx_haskell_toolchains//:base"],
)
