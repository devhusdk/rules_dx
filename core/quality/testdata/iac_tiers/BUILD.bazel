load("//core/quality:policy.bzl", "quality_family", "workspace_policy")

package(default_visibility = ["//core/quality/testdata:__pkg__"])

[
    quality_family(
        name = "%s_family" % family,
        disabled = [
            "audit",
            "format",
            "typecheck",
        ],
        family_id = family,
        lint = [tool],
    )
    for family, tool in [
        ("ansible", "ansible_lint"),
        ("bicep", "bicep"),
        ("cmake", "cmakelint"),
        ("make", "checkmake"),
        ("terraform", "tflint"),
    ]
]

workspace_policy(
    name = "policy",
    configs = [
        "//core/quality/tiers/ansible_lint:standard",
        "//core/quality/tiers/bicep:standard",
        "//core/quality/tiers/tflint:standard",
        "//core/quality/tiers/cmakelint:standard",
        "//core/quality/tiers/checkmake:standard",
    ],
    families = [
        ":ansible_family",
        ":bicep_family",
        ":terraform_family",
        ":cmake_family",
        ":make_family",
    ],
)
