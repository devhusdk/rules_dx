load("//java:defs.bzl", "java_library")
load("//kotlin:defs.bzl", "kotlin_library")
load("//scala:defs.bzl", "scala_library")
load("//core/quality:policy.bzl", "quality_family", "workspace_policy")

package(default_visibility = ["//core/quality/testdata:__pkg__"])

quality_family(
    name = "java_family",
    disabled = [
        "audit",
        "format",
        "lint",
    ],
    family_id = "java",
    typecheck = ["javac"],
)

quality_family(
    name = "kotlin_family",
    disabled = [
        "audit",
        "format",
        "lint",
    ],
    family_id = "kotlin",
    typecheck = ["kotlinc"],
)

quality_family(
    name = "scala_family",
    disabled = [
        "audit",
        "format",
        "lint",
    ],
    family_id = "scala",
    typecheck = ["scalac"],
)

java_library(
    name = "kept_helper",
    srcs = ["KeptHelper.java"],
)

java_library(
    name = "dropped_helper",
    srcs = ["DroppedHelper.java"],
)

java_library(
    name = "java_unused_dep",
    srcs = ["JavaUnusedDep.java"],
    deps = [
        ":kept_helper",
        "//core/quality/testdata/jvm_owned:dropped_helper",
    ],
)

kotlin_library(
    name = "kt_kept_helper",
    srcs = ["KtKeptHelper.kt"],
)

kotlin_library(
    name = "kt_dropped_helper",
    srcs = ["KtDroppedHelper.kt"],
)

kotlin_library(
    name = "kotlin_unused_dep",
    srcs = ["KotlinUnusedDep.kt"],
    deps = [
        ":kt_kept_helper",
        ":kt_dropped_helper",
    ],
)

kotlin_library(
    name = "kt_wrapper",
    srcs = ["KtWrapper.kt"],
    deps = [":kt_kept_helper"],
)

kotlin_library(
    name = "kotlin_missing_dep",
    srcs = ["KotlinMissingDep.kt"],
    deps = [":kt_wrapper"],
)

workspace_policy(
    name = "policy",
    families = [
        ":java_family",
        ":kotlin_family",
        ":scala_family",
    ],
)

scala_library(
    name = "sc_kept_helper",
    srcs = ["ScKeptHelper.scala"],
)

scala_library(
    name = "sc_dropped_helper",
    srcs = ["ScDroppedHelper.scala"],
)

scala_library(
    name = "scala_unused_dep",
    srcs = ["ScalaUnusedDep.scala"],
    unused_dependency_checker_mode = "off",
    deps = [
        ":sc_kept_helper",
        ":sc_dropped_helper",
    ],
)

scala_library(
    name = "sc_wrapper",
    srcs = ["ScWrapper.scala"],
    unused_dependency_checker_mode = "off",
    deps = [":sc_kept_helper"],
)

scala_library(
    name = "scala_missing_dep",
    srcs = ["ScalaMissingDep.scala"],
    unused_dependency_checker_mode = "off",
    deps = [":sc_wrapper"],
)
