load("//ocaml:defs.bzl", "ocaml_module")
load("//core/quality:policy.bzl", "quality_family", "workspace_policy")

package(default_visibility = [
    "//core/quality:__pkg__",
    "//core/quality/testdata:__pkg__",
])

quality_family(
    name = "ocaml_family",
    disabled = [
        "audit",
        "format",
    ],
    family_id = "ocaml",
    lint = ["zanuda"],
    typecheck = ["ocaml"],
)

workspace_policy(
    name = "policy",
    families = [":ocaml_family"],
)

ocaml_module(
    name = "clean",
    struct = "clean.ml",
)

ocaml_module(
    name = "dirty",
    struct = "dirty.ml",
)

ocaml_module(
    name = "shadow",
    struct = "shadow.ml",
)
