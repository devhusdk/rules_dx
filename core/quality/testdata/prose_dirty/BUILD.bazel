load("//asciidoc:defs.bzl", "asciidoc_library")
load("//rst:defs.bzl", "rst_library")

package(default_visibility = ["//core/quality/testdata:__pkg__"])

exports_files(
    glob(["dirty.*"]),
    visibility = ["//visibility:public"],
)

asciidoc_library(
    name = "asciidoc",
    srcs = ["dirty.adoc"],
    aspect_hints = ["//core/quality/testdata:vale_cfg"],
    tags = ["manual"],
)

rst_library(
    name = "rst",
    srcs = ["dirty.rst"],
    aspect_hints = ["//core/quality/testdata:vale_cfg"],
    tags = ["manual"],
)
