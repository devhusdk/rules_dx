load("@rules_rust//rust:defs.bzl", "rust_library")
load("//core/quality:policy.bzl", "quality_family")

package(default_visibility = [
    "//core/quality/testdata:__pkg__",
    "//core/quality/tests/fixtures/consumer_policy:__pkg__",
])

quality_family(
    name = "rust_family",
    disabled = [
        "audit",
        "format",
    ],
    family_id = "rust",
    lint = ["clippy"],
    typecheck = ["rustc"],
)

rust_library(
    name = "clean",
    srcs = ["clean.rs"],
    edition = "2021",
)

rust_library(
    name = "dirty",
    srcs = ["dirty.rs"],
    edition = "2021",
)

rust_library(
    name = "pedantic",
    srcs = ["pedantic.rs"],
    edition = "2021",
)

rust_library(
    name = "unused_dep",
    srcs = ["unused_dep.rs"],
    edition = "2021",
    deps = [":clean"],
)
