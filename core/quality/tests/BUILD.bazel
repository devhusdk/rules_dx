load("@crates//:crates.bzl", "aliases")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")

_LINUX = select({
    "@platforms//cpu:arm64": ["@platforms//os:linux"],
    "@platforms//cpu:x86_64": ["@platforms//os:linux"],
    "//conditions:default": ["@platforms//:incompatible"],
})

_LINUX_X86_64 = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

rust_test(
    name = "qt_adapter_test",
    size = "small",
    testonly = True,
    srcs = ["qt_adapter_test.rs"],
    aliases = aliases(
        package_name = "core/quality/quality_tests",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "qt_adapter_test",
    crate_root = "qt_adapter_test.rs",
    data = [
        "//core/quality/tests/fixtures/qmlformat:Sample.qml",
        "//core/quality/tests/fixtures/qmllint:Sample.qml",
        "//core/quality/tests/fixtures/qmllint:check_dirty.json",
        "@dx_qt//:qmlformat",
        "@dx_qt//:qmllint",
    ],
    env = {
        "DX_QMLFORMAT": "$(rootpath @dx_qt//:qmlformat)",
        "DX_QMLFORMAT_FIXTURE": "$(rootpath //core/quality/tests/fixtures/qmlformat:Sample.qml)",
        "DX_QMLLINT": "$(rootpath @dx_qt//:qmllint)",
        "DX_QMLLINT_FIXTURE": "$(rootpath //core/quality/tests/fixtures/qmllint:Sample.qml)",
        "DX_QMLLINT_FIXTURE_DIRTY": "$(rootpath //core/quality/tests/fixtures/qmllint:check_dirty.json)",
    },
    tags = ["block-network"],
    target_compatible_with = _LINUX,
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//core/quality/adapter:quality_adapter",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "column_units_test",
    testonly = True,
    srcs = ["column_units_test.rs"],
    aliases = aliases(
        package_name = "core/quality/quality_tests",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "column_units_test",
    crate_root = "column_units_test.rs",
    data = [
        "//core/quality/tools/jvm:pmd",
        "//javascript/private/quality/bin:eslint",
    ],
    env = {
        "DX_ESLINT": "$(rootpath //javascript/private/quality/bin:eslint)",
        "DX_PMD": "$(rootpath //core/quality/tools/jvm:pmd)",
    },
    tags = ["block-network"],
    target_compatible_with = _LINUX_X86_64,
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//core/quality/adapter:quality_adapter",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
