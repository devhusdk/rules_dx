[{config, [
    #{
        files => ["**/*.erl"],
        ruleset => erl_files,
        allow_no_files => true,
        rules => [
            {elvis_text_style, max_line_length, disable},
            {elvis_text_style, no_tabs, disable},
            {elvis_text_style, no_trailing_whitespace, disable},
            {elvis_text_style, no_redundant_blank_lines, disable},
            {elvis_style, no_space, disable},
            {elvis_style, no_space_after_pound, disable},
            {elvis_style, no_dollar_space, disable},
            {elvis_style, operator_spaces, disable}
        ]
    },
    #{
        files => ["**/*.hrl"],
        ruleset => hrl_files,
        allow_no_files => true,
        rules => [
            {elvis_text_style, max_line_length, disable},
            {elvis_text_style, no_tabs, disable},
            {elvis_text_style, no_trailing_whitespace, disable},
            {elvis_text_style, no_redundant_blank_lines, disable},
            {elvis_style, no_space, disable},
            {elvis_style, no_space_after_pound, disable},
            {elvis_style, no_dollar_space, disable},
            {elvis_style, operator_spaces, disable}
        ]
    }
]}].
