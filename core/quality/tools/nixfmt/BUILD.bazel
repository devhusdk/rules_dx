load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust:defs.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

_PROJECT = ["cabal.project"]

exports_files(_PROJECT + ["cabal.lock.json"])

filegroup(
    name = "nixfmt",
    srcs = ["@haskell_nixfmt_hackage//:nixfmt-exe-nixfmt"],
    target_compatible_with = select({
        "//haskell/private/toolchain:cell_linux_arm64": [],
        "//haskell/private/toolchain:cell_macos_arm64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

rust_test(
    name = "static_test",
    size = "small",
    srcs = ["static_test.rs"],
    data = [":nixfmt"],
    env = {"NIXFMT": "$(rlocationpath :nixfmt)"},
    target_compatible_with = [
        "@llvm//constraints/libc:musl",
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
    deps = [
        "//cli/binfmt:dx_binfmt",
        "//tools/testing:dx_testing",
    ],
)

build_test(
    name = "nixfmt_build_test",
    target_compatible_with = select({
        "//haskell/private/toolchain:cell_linux_arm64": [],
        "//haskell/private/toolchain:cell_macos_arm64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    targets = ["@haskell_nixfmt_hackage//:nixfmt-exe-nixfmt"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
