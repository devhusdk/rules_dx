load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

alias(
    name = "nixfmt",
    actual = "@dx_prebuilt//:nixfmt",
)

# Upstream prebuilt on linux_x86_64. The release ships linux_arm64 and macos_arm64; this alias is the source fallback when the hub has no pin.
alias(
    name = "nixfmt_source",
    actual = select({
        "//haskell/private/toolchain:cell_linux_arm64": "@haskell_nixfmt_hackage//:nixfmt-exe-nixfmt",
        "//haskell/private/toolchain:cell_macos_arm64": "@haskell_nixfmt_hackage//:nixfmt-exe-nixfmt",
        "//conditions:default": "@dx_tools//:nixfmt",
    }),
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
