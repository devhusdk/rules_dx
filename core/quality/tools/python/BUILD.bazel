config_setting(
    name = "windows_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:windows",
    ],
)

# cryptography has no win_arm64 wheel and its sdist needs maturin, Rust and
# OpenSSL. Remove this alias once a wheel ships or an OpenSSL-backed sdist
# override exists.
alias(
    name = "ansible_lint_tool",
    actual = select({
        ":windows_arm64": ":ansible_lint_unsupported",
        "//conditions:default": ":ansible_lint",
    }),
)

dx_unavailable_tool(
    name = "ansible_lint_unsupported",
    tool = "ansible_lint",
)

