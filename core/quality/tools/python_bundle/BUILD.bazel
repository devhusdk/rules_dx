load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load(":bundle.bzl", "python_tools_bundle")

package(default_visibility = ["//core/quality:__subpackages__"])

sh_binary(
    name = "build_bundle",
    srcs = ["build_bundle.sh"],
)

_PLATFORMS = {
    "linux_arm64": ("aarch64-unknown-linux-gnu", "python_3_12_aarch64_unknown_linux_gnu", False, []),
    "linux_x86_64": ("x86_64-unknown-linux-gnu", "python_3_12_x86_64_unknown_linux_gnu", False, []),
    "macos_arm64": ("aarch64-apple-darwin", "python_3_12_aarch64_apple_darwin", False, []),
    "windows_arm64": ("aarch64-pc-windows-msvc", "python_3_12_aarch64_pc_windows_msvc", True, ["ansible-lint", "ansible-core", "cryptography"]),
    "windows_x86_64": ("x86_64-pc-windows-msvc", "python_3_12_x86_64_pc_windows_msvc", True, []),
}

[
    python_tools_bundle(
        name = "dx_python_tools_" + platform,
        lock_files = [
            "//core/quality/tools/python:uv.lock",
            "//core/quality/tools/python/docstrfmt:uv.lock",
            "//core/quality/tools/python/sqlfluff:uv.lock",
        ],
        projects = {
            "//core/quality/tools/python:pyproject.toml": "python-tools:ansible_lint,cfn_lint,cmakelint,djlint,mbake,yamllint",
            "//core/quality/tools/python/docstrfmt:pyproject.toml": "docstrfmt:docstrfmt",
            "//core/quality/tools/python/sqlfluff:pyproject.toml": "sqlfluff:sqlfluff",
        },
        python_files = "@{}//:files".format(repo),
        python_marker = "@{}//:BUILD.bazel".format(repo),
        skip_packages = skip,
        tags = ["manual"],
        tool_bootstrap = "//core/quality/tools/python:tool_bootstrap.py",
        tool_sources = [
            "//core/quality/tools/python:{}_main.py".format(tool)
            for tool in ["ansible_lint", "cfn_lint", "cmakelint", "djlint", "docstrfmt", "mbake", "sqlfluff", "yamllint"]
        ],
        uv_platform = uv_platform,
        windows = windows,
    )
    for platform, (uv_platform, repo, windows, skip) in _PLATFORMS.items()
]
