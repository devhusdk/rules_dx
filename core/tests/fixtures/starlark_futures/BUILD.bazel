load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("//quality:fixtures.bzl", "real_source_target")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

exports_files([
    "aspect_subjects.bzl",
    "config_subjects.bzl",
])

string_flag(
    name = "config_value",
    build_setting_default = "plain",
    values = [
        "flipped",
        "plain",
    ],
)

config_setting(
    name = "is_flipped",
    flag_values = {":config_value": "flipped"},
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "aspect_subjects.bzl",
        "config_subjects.bzl",
    ],
    tags = ["corpus"],
)
