load("//core/quality:fixtures.bzl", "real_source_target")
load("//core/tests:subject.bzl", "example_subject")
load("//rust:defs.bzl", "rust_test")
load(":negative_tests.bzl", "empty_file_blocks_demo", "red_failing_checks", "red_missing_fragment", "red_missing_observation", "wrong_phase_demo")

exports_files(["negative_tests.bzl"])

example_subject(
    name = "negative_subject",
)

red_failing_checks(name = "red_failing_checks")

red_missing_observation(name = "red_missing_observation")

red_missing_fragment(name = "red_missing_fragment")

rust_test(
    name = "negative_proof_test",
    srcs = ["negative_proof_test.rs"],
    data = [
        ":red_failing_checks",
        ":red_failing_checks_manifest",
        ":red_missing_fragment",
        ":red_missing_fragment_manifest",
        ":red_missing_observation",
        ":red_missing_observation_manifest",
    ],
    env = {
        "DX_FAILING_CHECK_BIN": "$(rootpath :red_failing_checks)",
        "DX_FAILING_CHECK_MANIFEST": "$(rlocationpath :red_failing_checks_manifest)",
        "DX_MISSING_FRAGMENT_BIN": "$(rootpath :red_missing_fragment)",
        "DX_MISSING_FRAGMENT_MANIFEST": "$(rlocationpath :red_missing_fragment_manifest)",
        "DX_MISSING_OBSERVATION_BIN": "$(rootpath :red_missing_observation)",
        "DX_MISSING_OBSERVATION_MANIFEST": "$(rlocationpath :red_missing_observation_manifest)",
    },
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["//tools/testing:dx_testing"],
)

wrong_phase_demo(name = "wrong_phase_demo")

empty_file_blocks_demo(name = "empty_file_blocks_demo")

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "negative_tests.bzl",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    testonly = True,
