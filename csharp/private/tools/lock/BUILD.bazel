load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:private"])

rust_library(
    name = "nuget_lock_lib",
    srcs = ["src/resolve.rs"],
    aliases = aliases(
        package_name = "csharp/private/tools/nuget_lock",
        normal = True,
    ),
    crate_name = "nuget_lock",
    crate_root = "src/resolve.rs",
    deps = all_crate_deps(
        package_name = "csharp/private/tools/nuget_lock",
        normal = True,
    ) + [
        "//cli/digest:dx_digest",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
        "@crates//:serde_json",
    ],
)

rust_binary(
    name = "lock",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "csharp/private/tools/nuget_lock",
        normal = True,
    ),
    crate_name = "nuget_lock_bin",
    crate_root = "src/main.rs",
    visibility = ["//:__subpackages__"],
    deps = [
        ":nuget_lock_lib",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
    ],
)

rust_test(
    name = "resolve_test",
    size = "small",
    srcs = ["resolve_test.rs"],
    aliases = aliases(
        package_name = "csharp/private/tools/nuget_lock",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "resolve_test",
    crate_root = "resolve_test.rs",
    data = [
        "testdata/alpha.core.1.2.0.nupkg",
        "testdata/beta.2.0.0.nupkg",
        "testdata/golden.lock.json",
    ],
    env = {
        "ALPHA": "$(rootpath testdata/alpha.core.1.2.0.nupkg)",
        "BETA": "$(rootpath testdata/beta.2.0.0.nupkg)",
        "GOLDEN": "$(rootpath testdata/golden.lock.json)",
    },
    tags = ["block-network"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":nuget_lock_lib",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
        "//tools/testing:dx_testing",
        "@crates//:tempfile",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//:__subpackages__"],
)

exports_files(
    [
        "src/main.rs",
    ],
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
