_PACKAGE = {
    "archives": [{
        "sha256": "a" * 64,
        "type": "zip",
        "urls": ["https://api.nuget.org/v3-flatcontainer/alpha.core/1.2.0/alpha.core.1.2.0.nupkg"],
    }],
    "deps": ["Beta"],
    "extra": {
        "nuget_frameworks": ["net10.0"],
        "nuget_sha512": "sha512-AA==",
        "nuget_tools": {"net10.0": [{
            "entrypoint": "a.dll",
            "name": "a",
            "runner": "dotnet",
        }]},
    },
    "name": "Alpha.Core",
    "provides": ["Alpha.Core"],
    "version": "1.2.0",
}

_BETA = dict(
    _PACKAGE,
    name = "Beta",
    archives = [dict(
        _PACKAGE["archives"][0],
        urls = ["https://api.nuget.org/v3-flatcontainer/beta/2.0.0/beta.2.0.0.nupkg"],
    )],
    extra = {
        "nuget_frameworks": ["net10.0"],
        "nuget_sha512": "sha512-BB==",
    },
    provides = ["Beta"],
    version = "2.0.0",
    deps = [],
)

_LOCK = {
    "ecosystem": "nuget",
    "groups": {
        "docs": [],
        "main": [
            _PACKAGE,
            _BETA,
        ],
        "tools": [
            _PACKAGE,
            _BETA,
        ],
    },
    "packages": [],
    "schema": 1,
}

starlark_test(
    name = "lock_hub_test",
    size = "small",
    checks = [
        expect_equal(
            "main is the hub",
            hub_name("nuget", "main"),
            "nuget",
        ),
        expect_equal(
            "another group is a dotted hub",
            hub_name("nuget", "tools"),
            "nuget.tools",
        ),
        expect_equal(
            "every group with packages is a hub",
            sorted(lock_hubs("nuget", _LOCK).keys()),
            [
                "nuget",
                "nuget.tools",
            ],
        ),
        expect_equal(
            "a package becomes a rules_dotnet nuget package",
            lock_hubs("nuget", _LOCK)["nuget"],
            [
                {
                    "id": "Alpha.Core",
                    "name": "Alpha.Core",
                    "sha512": "sha512-AA==",
                    "sources": ["https://api.nuget.org/v3/index.json"],
                    "version": "1.2.0",
                },
                {
                    "id": "Beta",
                    "name": "Beta",
                    "sha512": "sha512-BB==",
                    "sources": ["https://api.nuget.org/v3/index.json"],
                    "version": "2.0.0",
                },
            ],
        ),
    ],
    mode = "unit",
)

dx_wrapper_contract_tests(
    name = "wrapper_contract_tests",
    size = "small",
    extra_checks = [
        expect_equal(
            "proto file names are Pascal case",
            [
                pascal_case("user"),
                pascal_case("user_profile"),
                pascal_case("v2beta"),
            ],
            [
                "User",
                "UserProfile",
                "V2Beta",
            ],
        ),
        expect_equal(
            "separators other than underscore are dropped",
            [
                pascal_case("foo-bar"),
                pascal_case("user.v1"),
                pascal_case("foo_2fa"),
                pascal_case("v1_2beta"),
            ],
            [
                "FooBar",
                "UserV1",
                "Foo2Fa",
                "V12Beta",
            ],
        ),
        expect_equal(
            "edge cases follow protoc",
            [
                pascal_case("_1foo"),
                pascal_case("FOO_bar"),
                pascal_case("a#"),
            ],
            [
                "_1Foo",
                "FOOBar",
                "A_",
            ],
        ),
        expect_equal(
            "a letter after a digit is capitalised",
            pascal_case("a1b_c"),
            "A1BC",
        ),
        expect_equal(
            "empty gains net10 tfm",
            csharp_tfm_with_defaults({})["target_frameworks"],
            ["net10.0"],
        ),
        expect_equal(
            "empty follows the warnings flag",
            type(csharp_tfm_with_defaults({})["treat_warnings_as_errors"]),
            "select",
        ),
        expect_equal(
            "explicit tfm wins",
            csharp_tfm_with_defaults({"target_frameworks": ["net9.0"]})["target_frameworks"],
            ["net9.0"],
        ),
        expect_equal(
            "explicit tfm matrix wins",
            csharp_tfm_with_defaults({"target_frameworks": [
                "net8.0",
                "net10.0",
            ]})["target_frameworks"],
            [
                "net8.0",
                "net10.0",
            ],
        ),
        expect_equal(
            "explicit warnings setting wins",
            csharp_tfm_with_defaults({"warnings_as_errors": False})["treat_warnings_as_errors"],
            False,
        ),
        expect_equal(
            "other kwargs survive",
            csharp_tfm_with_defaults({"deps": [":hello_lib"]})["deps"],
            [":hello_lib"],
        ),
        expect_equal(
            "one tfm adds no fan-out edge",
            csharp_tfm_forward_kwargs(
                "lib",
                csharp_tfm_with_defaults({}),
            ),
            {},
        ),
        expect_equal(
            "tfm matrix fans out over the upstream",
            csharp_tfm_forward_kwargs(
                "lib",
                {"target_frameworks": [
                    "net8.0",
                    "net10.0",
                ]},
            ),
            {
                "dx_target_frameworks": [
                    "net8.0",
                    "net10.0",
                ],
                "dx_tfm_variants": ":lib_upstream",
            },
        ),
        expect_equal(
            "non-list tfm adds no fan-out edge",
            csharp_tfm_forward_kwargs(
                "lib",
                {"target_frameworks": "net8.0"},
            ),
            {},
        ),
    ],
    file_classes = ["csharp"],
)

