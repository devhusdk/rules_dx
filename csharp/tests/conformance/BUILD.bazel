load("//core/quality:fixtures.bzl", "real_source_target")
load("//csharp:defs.bzl", "csharp_binary", "csharp_library", "csharp_test")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "subject_compatible_with")
load("//tools/testing/conformance:quality.bzl", "dotnet_format_subject", "dotnet_lint_subject")

# gazelle:exclude Greet.cs

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

# keep
csharp_library(
    name = "greet",
    srcs = ["Greet.cs"],
)

csharp_library(
    name = "lint_dirty",
    srcs = ["quality/LintDirty.cs"],
    out = "LintDirty",
    tags = ["manual"],
)

csharp_library(
    name = "format_dirty",
    srcs = ["quality/FormatDirty.cs"],
    out = "FormatDirty",
    tags = ["manual"],
)

csharp_binary(
    name = "hello",
    srcs = ["Hello.cs"],
    deps = [":greet"],
)

csharp_test(
    name = "pass_subject_test",
    size = "small",
    srcs = ["PassTest.cs"],
    target_compatible_with = subject_compatible_with(),
    deps = [":greet"],
)

csharp_test(
    name = "fail_subject_test",
    size = "small",
    srcs = ["FailTest.cs"],
    target_compatible_with = subject_compatible_with(),
    deps = [":greet"],
)

csharp_binary(
    name = "runfiles_hello",
    srcs = ["RunfilesMain.cs"],
    data = ["data.txt"],
    deps = ["@rules_dotnet//tools/runfiles"],
)

csharp_binary(
    name = "lock_hello",
    srcs = ["LockMain.cs"],
    deps = ["@nuget//google.protobuf"],
)

dx_conformance_suite(
    name = "",
    size = "small",
    binary = ":hello",
    covered_source = "Greet.cs",
    expected = "hello world",
    failing_case = "failing_case",
    failing_pattern = "{case}",
    failing_test = ":fail_subject_test",
    lang = "csharp",
    lock = {
        "binary": ":lock_hello",
        "ecosystem": "csharp",
        "expected": "hello lock",
        "lockfile": "//third_party/dotnet:paket.lock",
        "manifest": "paket.dependencies",
        "package": "Google.Protobuf",
        "stale": "paket.stale.lock",
    },
    passing_test = ":pass_subject_test",
    quality = {
        "clean": ":greet",
        "format_dirty": ":format_dirty",
        "format_source": "quality/FormatDirty.cs",
        "format_subject": dotnet_format_subject,
        "lint_dirty": ":lint_dirty",
        "lint_line": 5,
        "lint_rule": "CA1822",
        "lint_source": "quality/LintDirty.cs",
        "lint_subject": dotnet_lint_subject,
    },
    runfiles = {
        "binary": ":runfiles_hello",
        "data": "data.txt",
        "expected": "hello runfiles",
    },
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
