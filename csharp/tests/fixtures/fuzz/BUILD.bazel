load("@rules_dx//core:fuzz_bench_tests.bzl", "dx_runner_attr_test")
load("@rules_dx//dotnet/fuzz:labels.bzl", "LIBFUZZER_DOTNET")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//csharp:defs.bzl", "csharp_fuzz_test", "csharp_library")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

csharp_library(
    name = "parser",
    srcs = ["Parser.cs"],
)

csharp_fuzz_test(
    name = "parse_fuzz",
    srcs = ["Harness.cs"],
    deps = [":parser"],
)

sh_test(
    name = "parse_fuzz_run_test",
    srcs = ["run_test.sh"],
    args = [
        "$(rootpath @rules_dx//dotnet/fuzz:libfuzzer_dotnet)",
        "$(rootpath :parse_fuzz)",
        "$(rootpath @rules_dx//cli/fuzz_run:fuzz_run)",
    ],
    data = [
        ":parse_fuzz",
        "@rules_dx//dotnet/fuzz:libfuzzer_dotnet",
        "@rules_dx//cli/fuzz_run:fuzz_run",
    ],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    timeout = "short",
)

csharp_library(
    name = "wrapper",
    srcs = ["Wrapper.cs"],
    deps = [":parser"],
)

csharp_fuzz_test(
    name = "transitive_fuzz",
    srcs = ["TransitiveHarness.cs"],
    deps = [":wrapper"],
)

sh_test(
    name = "transitive_fuzz_run_test",
    srcs = ["run_test.sh"],
    args = [
        "$(rootpath @rules_dx//dotnet/fuzz:libfuzzer_dotnet)",
        "$(rootpath :transitive_fuzz)",
        "$(rootpath @rules_dx//cli/fuzz_run:fuzz_run)",
    ],
    data = [
        ":transitive_fuzz",
        "@rules_dx//dotnet/fuzz:libfuzzer_dotnet",
        "@rules_dx//cli/fuzz_run:fuzz_run",
    ],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    timeout = "short",
)

csharp_fuzz_test(
    name = "args_fuzz",
    srcs = ["Harness.cs"],
    args = ["-max_total_time=1"],
    deps = [":parser"],
)

dx_runner_attr_test(
    name = "args_fuzz_attrs",
    expected = {
        "args": ["-max_total_time=1"],
        "tags": ["dx-fuzz", "manual"],
    },
    runner = "args_fuzz",
)

dx_runner_attr_test(
    name = "parse_fuzz_run_attrs",
    expected = {"args": [
        "dotnet",
        "$(rootpath %s)" % LIBFUZZER_DOTNET,
        "$(rootpath :parse_fuzz)",
    ]},
    runner = "parse_fuzz_run",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
