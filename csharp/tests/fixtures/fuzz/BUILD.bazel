# gazelle:ignore
load("@rules_dx//core:fuzz_bench_tests.bzl", "dx_runner_attr_test")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//dotnet/private:sharpfuzz_check.bzl", "dx_sharpfuzz_transitive_test")
load("//csharp:defs.bzl", "csharp_fuzz_test", "csharp_library")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

csharp_library(
    name = "parser",
    srcs = ["Parser.cs"],
)

csharp_fuzz_test(
    name = "parse_fuzz",
    srcs = ["Harness.cs"],
    deps = [":parser"],
)

sh_test(
    name = "parse_fuzz_run_test",
    env = {"DX_RUNTIME_TOOL": "fuzz_run"},
    srcs = ["run_test.sh"],
    args = [
        "$(rootpath @rules_dx//dotnet/private/fuzz:libfuzzer_dotnet)",
        "$(rootpath :parse_fuzz)",
        "$(rootpath @rules_dx//cli/runtime:dx_runtime)",
    ],
    data = [
        ":parse_fuzz",
        "@rules_dx//dotnet/private/fuzz:libfuzzer_dotnet",
        "@rules_dx//cli/runtime:dx_runtime",
    ],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    timeout = "moderate",
)

csharp_library(
    name = "wrapper",
    srcs = ["Wrapper.cs"],
    deps = [":parser"],
)

csharp_fuzz_test(
    name = "transitive_fuzz",
    srcs = ["TransitiveHarness.cs"],
    deps = [":wrapper"],
)

sh_test(
    name = "transitive_fuzz_run_test",
    env = {"DX_RUNTIME_TOOL": "fuzz_run"},
    srcs = ["run_test.sh"],
    args = [
        "$(rootpath @rules_dx//dotnet/private/fuzz:libfuzzer_dotnet)",
        "$(rootpath :transitive_fuzz)",
        "$(rootpath @rules_dx//cli/runtime:dx_runtime)",
    ],
    data = [
        ":transitive_fuzz",
        "@rules_dx//dotnet/private/fuzz:libfuzzer_dotnet",
        "@rules_dx//cli/runtime:dx_runtime",
    ],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    timeout = "moderate",
)

dx_sharpfuzz_transitive_test(
    name = "transitive_fuzz_instrumented",
    chain = [
        "wrapper.dll",
        "parser.dll",
    ],
    harness = ":transitive_fuzz",
)

csharp_fuzz_test(
    name = "args_fuzz",
    srcs = ["Harness.cs"],
    args = ["-max_total_time=1"],
    deps = [":parser"],
)

dx_runner_attr_test(
    name = "args_fuzz_attrs",
    expected = {
        "args": ["-max_total_time=1"],
        "tags": ["dx-fuzz"],
    },
    runner = "args_fuzz",
)

dx_runner_attr_test(
    name = "parse_fuzz_run_attrs",
    expected = {"args": [
        "dotnet",
        "$(rootpath :parse_fuzz_libfuzzer_dotnet)",
        "$(rootpath :parse_fuzz)",
    ]},
    runner = "parse_fuzz_run",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
