load("//csharp/rules:defs.bzl", "csharp_binary", "csharp_library", "csharp_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//tools/sh:harness.bzl", "dx_shell_harness")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

csharp_library(
    name = "hello_lib",
    srcs = ["Hello.cs"],
)

csharp_binary(
    name = "hello",
    srcs = ["Program.cs"],
    deps = [":hello_lib"],
)

csharp_test(
    name = "hello_test",
    srcs = ["HelloTest.cs"],
    deps = [":hello_lib"],
)

dx_shell_harness(
    name = "hello_output_test",
    srcs = ["hello_output_test.sh"],
    args = ["$(rootpath :hello)"],
    data = [
        ":hello",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
