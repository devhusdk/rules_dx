# gazelle:ignore
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//csharp:defs.bzl", "csharp_proto_library", "csharp_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

proto_library(
    name = "order_proto",
    srcs = [
        "a.proto",
        "auth_2fa.proto",
        "b.proto",
        "user-v1.proto",
    ],
    deps = ["@protobuf//:timestamp_proto"],
)

csharp_proto_library(
    name = "order_cs_proto",
    proto = ":order_proto",
    deps = ["@nuget//google.protobuf"],
)

csharp_test(
    name = "proto_test",
    srcs = [
        "ProtoTest.cs",
        "SelfRegisteredExtensions.cs",
        "XunitEntryPoint.cs",
    ],
    deps = [
        ":order_cs_proto",
        "@nuget//google.protobuf",
        "@nuget//microsoft.testing.extensions.telemetry",
        "@nuget//microsoft.testing.extensions.trxreport.abstractions",
        "@nuget//microsoft.testing.platform",
        "@nuget//microsoft.testing.platform.msbuild",
        "@nuget//xunit.analyzers",
        "@nuget//xunit.v3",
        "@nuget//xunit.v3.assert",
        "@nuget//xunit.v3.common",
        "@nuget//xunit.v3.core.mtp-v2",
        "@nuget//xunit.v3.extensibility.core",
        "@nuget//xunit.v3.mtp-v2",
        "@nuget//xunit.v3.runner.common",
        "@nuget//xunit.v3.runner.inproc.console",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
