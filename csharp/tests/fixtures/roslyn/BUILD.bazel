load("@rules_dx//csharp/rules:defs.bzl", "csharp_library")
load("//quality:fixtures.bzl", "real_source_target")
load("//tools/sh:harness.bzl", "dx_shell_harness")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

exports_files([
    "pins.bzl",
    "Sample.cs",
    "net8.sarif",
    "net10.sarif",
    "aggregated.sarif",
])

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "pins.bzl",
    ],
    tags = ["corpus"],
)

csharp_library(
    name = "roslyn",
    testonly = True,
    srcs = ["Sample.cs"],
)

csharp_library(
    name = "roslyn_net8",
    testonly = True,
    srcs = ["Sample.cs"],
    target_frameworks = ["net8.0"],
)

csharp_library(
    name = "roslyn_net10",
    testonly = True,
    srcs = ["Sample.cs"],
    target_frameworks = ["net10.0"],
)

dx_shell_harness(
    name = "roslyn_aggregation_test",
    srcs = ["roslyn_aggregation_test.sh"],
    args = [
        "$(rootpath :net8.sarif)",
        "$(rootpath :net10.sarif)",
        "$(rootpath :aggregated.sarif)",
    ],
    data = [
        ":aggregated.sarif",
        ":net10.sarif",
        ":net8.sarif",
        ":roslyn_net10",
        ":roslyn_net8",
    ],
)
