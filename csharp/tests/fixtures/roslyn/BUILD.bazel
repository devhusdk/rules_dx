load("@crates//:crates.bzl", "aliases")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust:defs.bzl", "rust_test")
load("//csharp:defs.bzl", "csharp_library")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

exports_files([
    "Sample.cs",
    "net8.sarif",
    "net10.sarif",
    "aggregated.sarif",
])

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
    ],
    tags = ["corpus"],
)

csharp_library(
    name = "roslyn",
    testonly = True,
    srcs = ["Sample.cs"],
    target_frameworks = [
        "net8.0",
        "net10.0",
    ],
)

rust_test(
    name = "roslyn_aggregation_test",
    testonly = True,
    srcs = ["roslyn_aggregation_test.rs"],
    aliases = aliases(
        package_name = "csharp/tests/fixtures/csharp_roslyn_fixture",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "roslyn_aggregation_test",
    crate_root = "roslyn_aggregation_test.rs",
    data = [
        ":aggregated.sarif",
        ":net10.sarif",
        ":net8.sarif",
        ":roslyn",
    ],
    env = {
        "DX_AGG_SARIF": "$(rootpath :aggregated.sarif)",
        "DX_NET8_SARIF": "$(rootpath :net8.sarif)",
        "DX_NET10_SARIF": "$(rootpath :net10.sarif)",
    },
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["@rules_dx//tools/testing:dx_testing"],
)

real_source_target(
    name = "corpus_toml",
    testonly = True,
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
