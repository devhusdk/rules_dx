load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")

exports_files([
    "README.md",
    "defs.bzl",
    "extensions.bzl",
    "lang.json",
    "pins.json",
])

filegroup(
    name = "module_srcs",
    srcs = glob(["*.bzl"]) + [
        "BUILD.bazel",
        "pins.json",
        "//cuda/private:module_srcs",
        "//cuda/private/toolchain:module_srcs",
    ],
    visibility = ["//:__subpackages__"],
)

string_flag(
    name = "gpu_compute_capability",
    build_setting_default = "",
    visibility = ["//visibility:public"],
)

string_flag(
    name = "gpu_driver",
    build_setting_default = "",
    visibility = ["//visibility:public"],
)

config_setting(
    name = "gpu_undeclared",
    flag_values = {":gpu_compute_capability": ""},
    visibility = ["//visibility:public"],
)

# Public so users can register their own CUDA toolchain. Declared here, not in rules_cuda,
# so toolchain resolution never loads a rules_cuda .bzl file.
toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

alias(
    name = "cublas",
    actual = "//cuda/private:cublas",
    visibility = ["//visibility:public"],
)

alias(
    name = "cufft",
    actual = "//cuda/private:cufft",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

alias(
    name = "curand",
    actual = "//cuda/private:curand",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# clang's CUDA runtime wrapper includes curand_mtgp32_kernel.h, so clang-tidy needs the cuRAND headers.
# Only CUDA compiles run under the static runtime setting, so other C/C++ targets never fetch cuRAND.
alias(
    name = "clang_tidy_headers",
    actual = select({
        "//cuda/private/toolchain:static_runtime_enabled": "@cuda//:curand_headers",
        "//conditions:default": ":no_clang_tidy_headers",
    }),
    visibility = ["//cc:__subpackages__"],
)

filegroup(
    name = "no_clang_tidy_headers",
    srcs = [],
)

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "extensions.bzl",
    ],
    tags = ["corpus"],
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//tools/api:__pkg__"],
)
