load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//cuda/private:defs.bzl", "CUDA_TARGET", "cuda_component_library")

exports_files([
    "README.md",
    "defs.bzl",
    "extensions.bzl",
])

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
    ]) + [
        "//cuda/private:module_srcs",
        "//cuda/private/toolchain:module_srcs",
    ],
    visibility = ["//:__subpackages__"],
)

string_flag(
    name = "gpu_compute_capability",
    build_setting_default = "",
    visibility = ["//visibility:public"],
)

string_flag(
    name = "gpu_driver",
    build_setting_default = "",
    visibility = ["//visibility:public"],
)

config_setting(
    name = "gpu_undeclared",
    flag_values = {":gpu_compute_capability": ""},
    visibility = ["//visibility:public"],
)

cuda_component_library(
    name = "cublas",
    component = "@cuda//:cublas",
    component_name = "cublas",
    target_compatible_with = CUDA_TARGET,
    visibility = ["//visibility:public"],
)

cuda_component_library(
    name = "cufft",
    component = "@cuda//:cufft",
    component_name = "cufft",
    tags = ["manual"],
    target_compatible_with = CUDA_TARGET,
    visibility = ["//visibility:public"],
)

cuda_component_library(
    name = "curand",
    component = "@cuda//:curand",
    component_name = "curand",
    tags = ["manual"],
    target_compatible_with = CUDA_TARGET,
    visibility = ["//visibility:public"],
)

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "extensions.bzl",
    ],
    tags = ["corpus"],
)
