load("@bazel_skylib//rules:common_settings.bzl", "string_flag")

exports_files([
    "README.md",
    "defs.bzl",
    "extensions.bzl",
])

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
    ]) + [
        "//cuda/private:module_srcs",
        "//cuda/private/toolchain:module_srcs",
    ],
    visibility = ["//:__subpackages__"],
)

string_flag(
    name = "gpu_compute_capability",
    build_setting_default = "",
    visibility = ["//visibility:public"],
)

string_flag(
    name = "gpu_driver",
    build_setting_default = "",
    visibility = ["//visibility:public"],
)

config_setting(
    name = "gpu_undeclared",
    flag_values = {":gpu_compute_capability": ""},
    visibility = ["//visibility:public"],
)
