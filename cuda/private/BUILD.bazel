load("//core/quality:fixtures.bzl", "real_source_target")
load(":defs.bzl", "CUDA_COMPATIBLE_WITH", "cuda_component_library")

package(default_visibility = [
    "//:__pkg__",
    "//cuda:__subpackages__",
    "//tools/ci:__pkg__",
])

exports_files([
    "components.bzl",
    "defs.bzl",
    "license.bzl",
])

cuda_component_library(
    name = "cublas",
    component = "@cuda//:cublas",
    component_name = "cublas",
    target_compatible_with = CUDA_COMPATIBLE_WITH,
)

cuda_component_library(
    name = "cufft",
    component = "@cuda//:cufft",
    component_name = "cufft",
    tags = ["manual"],
    target_compatible_with = CUDA_COMPATIBLE_WITH,
)

cuda_component_library(
    name = "curand",
    component = "@cuda//:curand",
    component_name = "curand",
    tags = ["manual"],
    target_compatible_with = CUDA_COMPATIBLE_WITH,
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "components.bzl",
        "defs.bzl",
        "license.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["*.bzl"]) + ["BUILD.bazel"],
    visibility = ["//:__subpackages__"],
)
