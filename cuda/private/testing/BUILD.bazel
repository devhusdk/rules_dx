# gazelle:dx_rust_corpus false

load("//cc:defs.bzl", "cc_library", "cc_test")
load("//cuda/private:defs.bzl", "CUDA_TARGET", "cuda_library")
load("//cuda/private/toolchain:check.bzl", "cuda_gpu_device")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "gpu_facts",
    srcs = ["gpu_facts.cc"],
    hdrs = ["gpu_facts.h"],
    copts = ["-std=c++17"],
    target_compatible_with = CUDA_TARGET,
)

cuda_gpu_device(
    name = "gpu_device_src",
    target_compatible_with = CUDA_TARGET,
)

cc_library(
    name = "gpu_device",
    srcs = [":gpu_device_src"],
    hdrs = ["gpu_device.h"],
    target_compatible_with = CUDA_TARGET,
)

cuda_library(
    name = "gpu_main",
    testonly = True,
    srcs = ["gpu_main.cu"],
    hdrs = ["gpu_test.h"],
    cuda_archs = ["compute_75"],
    deps = [
        ":gpu_device",
        ":gpu_facts",
    ],
)

cc_test(
    name = "gpu_facts_test",
    srcs = ["gpu_facts_test.cc"],
    copts = ["-std=c++17"],
    target_compatible_with = CUDA_TARGET,
    deps = [
        ":gpu_facts",
        "@googletest//:gtest_main",
    ],
)
