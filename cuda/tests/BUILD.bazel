[
    gpu_test_declared_test(
        name = name + "_declared_test",
        size = "small",
        min_compute_capability = min_compute_capability,
        min_driver = "13.0",
        target_compatible_with = CUDA_COMPATIBLE_WITH,
        target_under_test = target,
    )
    for name, target, min_compute_capability in [
        ("saxpy_gpu", ":saxpy_gpu_test", "8.9"),
        ("rdc_gpu", ":rdc_gpu_test", "8.9"),
        ("cublas_gpu", ":cublas_gpu_test", "8.9"),
        ("cuda_app_gpu", "//cuda/tests/fixtures/cuda-app/gpu:gpu_test", "8.0"),
    ]
]

