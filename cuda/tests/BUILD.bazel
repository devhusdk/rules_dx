# gazelle:lang rust,dx_dispatch

package(default_visibility = ["//visibility:private"])

rust_test(
    name = "saxpy_device_code_test",
    size = "small",
    testonly = True,
    srcs = ["saxpy_device_code_test.rs"],
    aliases = aliases(
        package_name = "cuda/cuda_tests",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "saxpy_device_code_test",
    crate_root = "saxpy_device_code_test.rs",
    data = [
        "//cuda/tests/fixtures/saxpy",
        "//cuda/tests/fixtures/saxpy:saxpy_app",
    ],
    env = {
        "DX_CUDA_ARCHIVES": "$(rootpaths //cuda/tests/fixtures/saxpy)",
        "DX_CUDA_BINARY": "$(rootpath //cuda/tests/fixtures/saxpy:saxpy_app)",
    },
    target_compatible_with = CUDA_COMPATIBLE_WITH,
    deps = ["//tools/testing:dx_testing"],
)

cuda_test(
    name = "saxpy_gpu_test",
    srcs = ["saxpy_gpu_test.cu"],
    cuda_archs = [
        "compute_89:compute_89,sm_89",
        "sm_120",
    ],
    min_compute_capability = "8.9",
    min_driver = "13.0",
    deps = ["//cuda/tests/fixtures/saxpy"],
)

