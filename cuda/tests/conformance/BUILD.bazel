load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//cuda:defs.bzl", "cuda_binary", "cuda_library", "cuda_test")
load("//cuda/private:defs.bzl", "CUDA_COMPATIBLE_WITH")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "subject_compatible_with")
load("//tools/testing/conformance:quality.bzl", "cc_format_subject", "cc_lint_subject")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

_ARCHS = [
    "sm_89",
    "sm_120",
]

cuda_library(
    name = "greet",
    srcs = ["greet.cu"],
    hdrs = ["greet.h"],
    cuda_archs = _ARCHS,
)

cuda_library(
    name = "format_dirty",
    srcs = ["format_dirty.cu"],
    cuda_archs = _ARCHS,
)

cuda_library(
    name = "lint_dirty",
    srcs = ["lint_dirty.cu"],
    cuda_archs = _ARCHS,
)

cuda_binary(
    name = "hello",
    srcs = ["main.cc"],
    cuda_archs = _ARCHS,
    deps = [":greet"],
)

cuda_test(
    name = "pass_subject_test",
    size = "small",
    srcs = ["pass_test.cc"],
    cuda_archs = _ARCHS,
    target_compatible_with = subject_compatible_with() + CUDA_COMPATIBLE_WITH,
    deps = [":greet"],
)

cuda_test(
    name = "fail_subject_test",
    size = "small",
    srcs = ["fail_test.cc"],
    cuda_archs = _ARCHS,
    target_compatible_with = subject_compatible_with() + CUDA_COMPATIBLE_WITH,
    deps = [":greet"],
)

cuda_binary(
    name = "runfiles_hello",
    srcs = ["runfiles_main.cc"],
    cuda_archs = _ARCHS,
    data = ["data.txt"],
    deps = ["@rules_cc//cc/runfiles"],
)

dx_conformance_suite(
    name = "",
    size = "small",
    binary = ":hello",
    covered_source = "greet.cu",
    expected = "hello world",
    failing_case = "failing_case",
    failing_pattern = "{case}",
    failing_test = ":fail_subject_test",
    lang = "cuda",
    not_applicable = {
        "lint_error_test:windows_arm64": "clang-tidy does not lint CUDA compiled with an MSVC host compiler",
        "lint_error_test:windows_x86_64": "clang-tidy does not lint CUDA compiled with an MSVC host compiler",
        "lint_test:windows_arm64": "clang-tidy does not lint CUDA compiled with an MSVC host compiler",
        "lint_test:windows_x86_64": "clang-tidy does not lint CUDA compiled with an MSVC host compiler",
        "lock_test": "cuda has no package manager",
    },
    passing_test = ":pass_subject_test",
    quality = {
        "clean": ":greet",
        "format_dirty": ":format_dirty",
        "format_source": "format_dirty.cu",
        "format_subject": cc_format_subject,
        "lint_dirty": ":lint_dirty",
        "lint_line": 6,
        "lint_rule": "readability-else-after-return",
        "lint_source": "lint_dirty.cu",
        "lint_subject": cc_lint_subject,
    },
    runfiles = {
        "binary": ":runfiles_hello",
        "data": "data.txt",
        "expected": "hello runfiles",
    },
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
