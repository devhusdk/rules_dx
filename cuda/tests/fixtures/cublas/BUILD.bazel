load("//cuda:defs.bzl", "cuda_binary", "cuda_library")

package(default_visibility = ["//cuda/tests:__subpackages__"])

cuda_library(
    name = "cublas",
    srcs = ["cublas_saxpy.cu"],
    hdrs = ["cublas_saxpy.h"],
    cuda_archs = [
        "compute_89:compute_89,sm_89",
        "sm_120",
    ],
    # The license-gated pinned component, never @cuda//:cublas.
    deps = ["//cuda:cublas"],
)

cuda_binary(
    name = "cublas_app",
    srcs = ["main.cc"],
    cuda_archs = [
        "compute_89:compute_89,sm_89",
        "sm_120",
    ],
    deps = [":cublas"],
)
