load("//core/quality:fixtures.bzl", "real_source_target")
load("//cuda:defs.bzl", "CUDA_TARGET")
load("//rust:defs.bzl", "rust_test")
load("//tools/testing:test_macros.bzl", "CLANG_FORMAT_ARGS", "dx_format_test")

package(default_visibility = ["//visibility:private"])

rust_test(
    name = "device_code_test",
    srcs = ["device_code_test.rs"],
    data = [
        "//cuda/tests/fixtures/cuda-app/app:cuda_app",
        "//cuda/tests/fixtures/cuda-app/kernels",
    ],
    env = {
        "DX_CUDA_ARCHIVES": "$(rootpaths //cuda/tests/fixtures/cuda-app/kernels)",
        "DX_CUDA_BINARY": "$(rootpath //cuda/tests/fixtures/cuda-app/app:cuda_app)",
    },
    target_compatible_with = CUDA_TARGET,
    deps = ["//tools/testing:dx_testing"],
)

dx_format_test(
    name = "format_test",
    srcs = [
        "//cuda/tests/fixtures/cuda-app/app:format_srcs",
        "//cuda/tests/fixtures/cuda-app/gpu:format_srcs",
        "//cuda/tests/fixtures/cuda-app/kernels:format_srcs",
    ],
    args = CLANG_FORMAT_ARGS,
    config = "//:.clang-format",
    tool = "@llvm//tools:clang-format",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//cuda:__pkg__"],
)
