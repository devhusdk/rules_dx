load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//cuda:defs.bzl", "cuda_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

_PUBLIC = ["//visibility:public"]

package(default_visibility = _PUBLIC)

exports_files([
    "BUILD.bazel",
    "main.cc",
    "output_test.sh",
])

cuda_binary(
    name = "cuda_app",
    srcs = ["main.cc"],
    cuda_archs = [
        "compute_80:compute_80,sm_80",
        "sm_90",
    ],
    deps = ["//cuda/tests/fixtures/cuda_app/kernels"],
)

sh_test(
    name = "output_test",
    size = "small",
    srcs = ["output_test.sh"],
    args = ["$(rootpath :cuda_app)"],
    data = [":cuda_app"],
)

filegroup(
    name = "format_srcs",
    srcs = ["main.cc"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
