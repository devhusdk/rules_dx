load("//cc:defs.bzl", "cc_binary")
load("//cuda:defs.bzl", "cuda_library")
load("//cuda/private:defs.bzl", "CUDA_COMPATIBLE_WITH")

package(default_visibility = ["//cuda/tests:__subpackages__"])

cuda_library(
    name = "saxpy",
    srcs = ["saxpy.cu"],
    hdrs = [
        "saxpy.cuh",
        "saxpy.h",
    ],
    cuda_archs = [
        "compute_89:compute_89,sm_89",
        "sm_120",
    ],
)

cc_binary(
    name = "saxpy_app",
    srcs = ["main.cc"],
    target_compatible_with = CUDA_COMPATIBLE_WITH,
    deps = [":saxpy"],
)
