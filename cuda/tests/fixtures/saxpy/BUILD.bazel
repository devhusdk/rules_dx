load("//cuda:defs.bzl", "cuda_binary", "cuda_library")

package(default_visibility = ["//cuda/tests:__subpackages__"])

cuda_library(
    name = "saxpy",
    srcs = ["saxpy.cu"],
    hdrs = [
        "saxpy.cuh",
        "saxpy.h",
    ],
    cuda_archs = [
        "compute_89:compute_89,sm_89",
        "sm_120",
    ],
)

cuda_binary(
    name = "saxpy_app",
    srcs = ["main.cc"],
    cuda_archs = [
        "compute_89:compute_89,sm_89",
        "sm_120",
    ],
    deps = [":saxpy"],
)
