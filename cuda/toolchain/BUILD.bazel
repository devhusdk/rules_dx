load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("//libs/starlark:cells.bzl", "cell_settings")
load("//modules:cuda.bzl", "CUDA_CELLS")
load("//quality:fixtures.bzl", "real_source_target")
load(":check.bzl", "cuda_toolkit_check")

package(default_visibility = ["//visibility:public"])

cell_settings(
    name = "cell",
    cells = CUDA_CELLS,
)

exports_files([
    "check.bzl",
    "repos.bzl",
    "transition.bzl",
])

bool_flag(
    name = "static_runtime",
    build_setting_default = False,
)

config_setting(
    name = "static_runtime_enabled",
    flag_values = {":static_runtime": "True"},
)

cuda_toolkit_check(
    name = "toolkit_check",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "check.bzl",
        "repos.bzl",
        "transition.bzl",
    ],
    tags = ["corpus"],
)
