load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("//libs/starlark:cells.bzl", "cell_settings", "cells_compatible_with")
load("//modules:cuda.bzl", "CUDA_CELLS", "cuda_qualified_cells")
load("//quality:fixtures.bzl", "real_source_target")
load(":check.bzl", "cuda_toolkit_check")
load(":settings.bzl", "CUDA_CELL_SETTINGS")

package(default_visibility = ["//visibility:public"])

cell_settings(
    name = "cell",
    cells = CUDA_CELLS,
)

selects.config_setting_group(
    name = "cell_windows_x86_64_msvc",
    match_all = [
        ":cell_windows_x86_64",
        "//cc/toolchains:msvc_selected",
    ],
)

exports_files([
    "check.bzl",
    "repos.bzl",
    "settings.bzl",
    "transition.bzl",
])

bool_flag(
    name = "static_runtime",
    build_setting_default = False,
)

config_setting(
    name = "static_runtime_enabled",
    flag_values = {":static_runtime": "True"},
)

# rules_cuda ships a static cudart for Linux only; Windows links the import library.
alias(
    name = "runtime",
    actual = select({
        "@platforms//os:windows": "@cuda//:cuda_runtime",
        "//conditions:default": "@cuda//:cuda_runtime_static",
    }),
    tags = ["manual"],
)

cuda_toolkit_check(
    name = "toolkit_check",
    target_compatible_with = cells_compatible_with(
        CUDA_CELLS,
        "//cuda/toolchain",
        cuda_qualified_cells(),
        settings = CUDA_CELL_SETTINGS,
    ),
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "check.bzl",
        "repos.bzl",
        "settings.bzl",
        "transition.bzl",
    ],
    tags = ["corpus"],
)
