{
  "$schema": "../core/modules/lang.schema.json",
  "name": "d",
  "title": "D",
  "family": "core",
  "ecosystems": [
    "dub"
  ],
  "depcheck": "d",
  "semver": false,
  "manifests": [
    "dub.json"
  ],
  "lockfiles": [
    "dub.selections.json"
  ],
  "setup": {
    "hubs": [
      {
        "ecosystem": "dub",
        "manifest": "dub.json",
        "lock": "dub.lock.json",
        "state": "dub.selections.json",
        "extension": "@rules_dx//d:extensions.bzl",
        "tag": "lock",
        "hub": "dub",
        "resolver": "@rules_dx//d/private/tools/lock",
        "imports": "provides"
      }
    ]
  },
  "tools": [
    "ldc"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_arm64",
    "windows_x86_64"
  ],
  "pins": [
    "pins.json"
  ],
  "entry_points": [
    "d_library",
    "d_binary",
    "d_test",
    "d_fuzz_test",
    "d_bench"
  ],
  "quality": {
    "bzl": "d/private/quality:d.bzl",
    "file_extensions": [
      ".d"
    ],
    "aspects": {
      "format": [
        "real_d_format_aspect"
      ],
      "lint": [
        "real_d_lint_aspect"
      ],
      "typecheck": [
        "real_d_typecheck_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_d_format_probe_aspect"
      ],
      "lint": [
        "real_d_lint_probe_aspect"
      ],
      "typecheck": [
        "real_d_typecheck_probe_aspect"
      ]
    }
  },
  "docs": {
    "bzl": "tools/docs/d:aspect.bzl",
    "file_extensions": [
      ".d"
    ],
    "aspects": [
      "real_d_docs_aspect"
    ]
  }
}
