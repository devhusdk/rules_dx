load("//cc:defs.bzl", "cc_library")
load("//core:cells.bzl", "cell_settings")
load("//core/quality:fixtures.bzl", "real_source_target")
load(":pins.bzl", "LDC_CELLS")

package(default_visibility = ["//visibility:public"])

exports_files([
    "ldmd2.bzl",
    "pins.bzl",
    "repos.bzl",
    "extensions.bzl",
])

toolchain_type(name = "toolchain_type")

cell_settings(
    name = "cell",
    cells = LDC_CELLS,
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "ldmd2.bzl",
        "pins.bzl",
        "repos.bzl",
        "extensions.bzl",
    ],
    tags = ["corpus"],
)

cc_library(
    name = "msvc_iso_stdio",
    srcs = ["msvc_iso_stdio.c"],
    target_compatible_with = ["@platforms//os:windows"],
    alwayslink = True,
)

filegroup(
    name = "module_srcs",
    srcs = glob(["*.bzl"]) + [
        "BUILD.bazel",
        "msvc_iso_stdio.c",
    ],
    visibility = ["//:__subpackages__"],
)
