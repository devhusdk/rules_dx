load("//d/toolchain:pins.bzl", "LDC_CELLS")
load("//libs/starlark:conformance.bzl", "dx_wrapper_contract_tests")
load("//libs/starlark:defs.bzl", "expect_equal")
load("//quality:fixtures.bzl", "real_source_target")
load(":defs.bzl", "D_CELLS", "D_COVERAGE_COLLECTOR", "D_QUALITY_TOOLS", "d_quality_srcs")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
])

dx_wrapper_contract_tests(
    name = "wrapper_contract_tests",
    extra_checks = [
        expect_equal(
            "d tests have no coverage collector yet",
            D_COVERAGE_COLLECTOR,
            False,
        ),
        expect_equal(
            "wrappers carry dfmt and dscanner",
            sorted(D_QUALITY_TOOLS.keys()),
            [
                "dfmt",
                "dscanner",
            ],
        ),
        expect_equal(
            "modules and interface files are owned in order",
            d_quality_srcs([
                "app.d",
                "api.di",
            ]),
            [
                "app.d",
                "api.di",
            ],
        ),
        expect_equal(
            "string import files are not owned",
            d_quality_srcs(
                [
                    "app.d",
                    "banner.txt",
                ],
                ["banner.txt"],
            ),
            ["app.d"],
        ),
        expect_equal(
            "no sources own nothing",
            d_quality_srcs(None),
            [],
        ),
        expect_equal(
            "D targets build on every pinned LDC cell",
            D_CELLS,
            sorted(LDC_CELLS.keys()),
        ),
    ],
    file_classes = ["d"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
    ],
    tags = ["corpus"],
)
