# gazelle:ignore

load("//core:conformance.bzl", "dx_wrapper_contract_tests")
load("//core/private/testing:defs.bzl", "expect_equal")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//d/private:defs.bzl", "D_CELLS", "D_COVERAGE_COLLECTOR", "d_quality_srcs")
load("//d/private:kwargs.bzl", "d_kwargs", "d_unchecked_dopts")
load("//d/private/toolchain:pins.bzl", "LDC_CELLS")
load(":hub_tests.bzl", "dub_hub_tests")
load(":toolchain_tests.bzl", "d_metadata_tests")

dx_wrapper_contract_tests(
    name = "wrapper_contract_tests",
    size = "small",
    extra_checks = [
        expect_equal(
            "d guard is a select by default",
            type(d_kwargs({})["target_compatible_with"]),
            "select",
        ),
        expect_equal(
            "d guard stays with a user list",
            type(d_kwargs({"target_compatible_with": ["//x:y"]})["target_compatible_with"]),
            "select",
        ),
        expect_equal(
            "d keeps user tags",
            d_kwargs({"tags": ["t"]})["tags"],
            ["t"],
        ),
        expect_equal(
            "release and bounds-check-off dopts are unchecked",
            d_unchecked_dopts([
                "-O",
                "-release",
                "--boundscheck=off",
                "-boundscheck=off",
            ]),
            [
                "-release",
                "--boundscheck=off",
                "-boundscheck=off",
            ],
        ),
        expect_equal(
            "safe dopts are not unchecked",
            d_unchecked_dopts([
                "-O",
                "-boundscheck=safeonly",
                "-g",
            ]),
            [],
        ),
        expect_equal(
            "a select of dopts is not checked",
            d_unchecked_dopts(select({"//conditions:default": ["-release"]})),
            [],
        ),
        expect_equal(
            "the unchecked_dopts opt-in does not reach rules_d",
            "unchecked_dopts" in d_kwargs({
                "dopts": ["-release"],
                "unchecked_dopts": True,
            }),
            False,
        ),
        expect_equal(
            "an opted-in target passes its dopts on",
            type(d_kwargs({
                "dopts": ["-release"],
                "unchecked_dopts": True,
            })["dopts"]),
            "select",
        ),
        expect_equal(
            "d tests have a coverage collector",
            D_COVERAGE_COLLECTOR,
            True,
        ),
        expect_equal(
            "modules and interface files are owned in order",
            d_quality_srcs([
                "app.d",
                "api.di",
            ]),
            [
                "app.d",
                "api.di",
            ],
        ),
        expect_equal(
            "string import files are not owned",
            d_quality_srcs(
                [
                    "app.d",
                    "banner.txt",
                ],
                ["banner.txt"],
            ),
            ["app.d"],
        ),
        expect_equal(
            "no sources own nothing",
            d_quality_srcs(None),
            [],
        ),
        expect_equal(
            "D targets build on every pinned LDC cell",
            D_CELLS,
            sorted(LDC_CELLS.keys()),
        ),
    ],
    file_classes = ["d"],
)

test_suite(
    name = "fixture_tests",
    testonly = True,
    tests = ["//d/tests/fixtures/cc_interop:cc_interop_output_test"],
)

dub_hub_tests(
    name = "hub",
    size = "small",
)

d_metadata_tests(
    name = "metadata",
    size = "small",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "hub_tests.bzl",
        "toolchain_tests.bzl",
    ],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)
