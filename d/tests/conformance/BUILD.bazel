# gazelle:ignore
# Why: gazelle merges pass_test.d and fail_test.d into one d_test; the suite needs two subjects.
load("//d:defs.bzl", "d_binary", "d_library", "d_test")
load("//d/private:defs.bzl", "D_COMPATIBLE_WITH")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "subject_compatible_with")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

d_library(
    name = "conformance",
    srcs = ["greet.d"],
    target_compatible_with = D_COMPATIBLE_WITH,
)

d_library(
    name = "lint_dirty",
    srcs = ["lint_dirty.d"],
    target_compatible_with = D_COMPATIBLE_WITH,
)

d_binary(
    name = "hello",
    srcs = ["main.d"],
    target_compatible_with = D_COMPATIBLE_WITH,
    deps = [":conformance"],
)

d_binary(
    name = "lock_hello",
    srcs = ["lock_main.d"],
    target_compatible_with = D_COMPATIBLE_WITH,
    deps = ["@dub_d.tests.fixtures.d_app//semver"],
)

d_binary(
    name = "runfiles_hello",
    srcs = ["runfiles_main.d"],
    data = ["data.txt"],
    target_compatible_with = D_COMPATIBLE_WITH,
)

d_test(
    name = "pass_subject_test",
    size = "small",
    srcs = ["pass_test.d"],
    target_compatible_with = subject_compatible_with() + D_COMPATIBLE_WITH,
    deps = [":conformance"],
)

d_test(
    name = "fail_subject_test",
    size = "small",
    srcs = ["fail_test.d"],
    target_compatible_with = subject_compatible_with() + D_COMPATIBLE_WITH,
    deps = [":conformance"],
)

dx_conformance_suite(
    name = "",
    binary = ":hello",
    covered_source = "greet.d",
    expected = "hello world",
    failing_case = "failing_case",
    failing_pattern = "): {case}",
    failing_test = ":fail_subject_test",
    lang = "d",
    lock = {
        "binary": ":lock_hello",
        "ecosystem": "d",
        "expected": "hello lock",
        "lockfile": "//d/tests/fixtures/d_app:dub.selections.json",
        "manifest": "//d/tests/fixtures/d_app:dub.json",
        "package": "semver",
        "stale": "dub.selections.stale.json",
    },
    passing_test = ":pass_subject_test",
    quality = {
        "clean": ":conformance",
        "lint_dirty": ":lint_dirty",
        "lint_line": 4,
        "lint_rule": "unused_variable_check",
        "lint_source": "lint_dirty.d",
    },
    runfiles = {
        "binary": ":runfiles_hello",
        "data": "data.txt",
        "expected": "hello runfiles",
    },
    size = "small",
)
