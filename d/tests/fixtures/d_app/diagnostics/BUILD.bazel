# gazelle:exclude *.d

load("//core:cells.bzl", "cell_setting")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//d/private:defs.bzl", "D_CELLS", "D_COMPATIBLE_WITH")
load("//rust:defs.bzl", "rust_test")

package(default_visibility = ["//d/tests/fixtures/d_app:__subpackages__"])

alias(
    name = "ldc",
    testonly = True,
    actual = select({cell_setting("//d/private/toolchain", cell): "@dx_d_toolchains__%s//:dmd" % cell for cell in D_CELLS}),
    target_compatible_with = D_COMPATIBLE_WITH,
)

rust_test(
    name = "diagnostics_test",
    srcs = ["diagnostics_test.rs"],
    data = [
        "compile_error.d",
        "failing_unittest.d",
        "missing_dep.d",
        ":ldc",
    ],
    env = {
        "DX_COMPILE_ERROR": "$(rootpath compile_error.d)",
        "DX_FAILING_UNITTEST": "$(rootpath failing_unittest.d)",
        "DX_LDC": "$(rootpath :ldc)",
        "DX_MISSING_DEP": "$(rootpath missing_dep.d)",
    },
    target_compatible_with = D_COMPATIBLE_WITH,
    deps = ["//tools/testing:dx_testing"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
