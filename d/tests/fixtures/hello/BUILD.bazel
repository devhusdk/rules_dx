load("//d:defs.bzl", "d_binary", "d_library", "d_test")
load("//d/private:defs.bzl", "D_COMPATIBLE_WITH")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//tools/testing:hello_output.bzl", "dx_hello_output_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

d_library(
    name = "greet",
    srcs = ["greet.d"],
    target_compatible_with = D_COMPATIBLE_WITH,
)

d_binary(
    name = "hello",
    srcs = ["main.d"],
    target_compatible_with = D_COMPATIBLE_WITH,
    deps = [":greet"],
)

d_test(
    name = "greet_test",
    srcs = ["greet.d"],
    target_compatible_with = D_COMPATIBLE_WITH,
)

dx_hello_output_test(
    name = "hello_output_test",
    binary = ":hello",
    expected = "Hello, d!",
    target_compatible_with = D_COMPATIBLE_WITH,
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
