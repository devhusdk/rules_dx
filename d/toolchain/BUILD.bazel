load("//cc/rules:defs.bzl", "cc_library")
load("//libs/starlark:cells.bzl", "cell_settings", "unsupported_value")
load("//quality:fixtures.bzl", "real_source_target")
load(":metadata_tests.bzl", "d_metadata_tests")
load(":pins.bzl", "LDC_CELLS")

package(default_visibility = ["//visibility:public"])

exports_files([
    "metadata_tests.bzl",
    "pins.bzl",
    "repos.bzl",
])

unsupported_value("unsupported")

cell_settings(
    name = "cell",
    cells = LDC_CELLS,
)

d_metadata_tests(name = "metadata")

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "metadata_tests.bzl",
        "pins.bzl",
        "repos.bzl",
    ],
    tags = ["corpus"],
)

# D's runtime calls printf, fprintf, vfprintf, vsnprintf and sscanf, which the UCRT headers only
# define inline. Defining them out of line keeps D off legacy_stdio_definitions.lib (#6948).
cc_library(
    name = "msvc_iso_stdio",
    srcs = ["msvc_iso_stdio.c"],
    target_compatible_with = ["@platforms//os:windows"],
    alwayslink = True,
)
