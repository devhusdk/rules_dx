{
  "$schema": "../core/modules/lang.schema.json",
  "name": "dart",
  "title": "Dart",
  "family": "core",
  "ecosystems": [
    "pub"
  ],
  "depcheck": "dart",
  "semver": true,
  "manifests": [
    "pubspec.yaml"
  ],
  "lockfiles": [
    "pubspec.lock"
  ],
  "tools": [
    "dart"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_x86_64"
  ],
  "pins": [],
  "entry_points": [
    "dart_codegen",
    "dart_root_package_name",
    "dart_library",
    "dart_binary",
    "dart_js_binary",
    "dart_wasm_binary",
    "dart_test",
    "dart_bench"
  ],
  "quality": {
    "bzl": "core/quality:families/dart.bzl",
    "file_extensions": [
      ".dart"
    ],
    "aspects": {
      "format": [
        "real_dart_format_aspect"
      ],
      "lint": [
        "real_dart_lint_aspect"
      ],
      "typecheck": [
        "real_dart_typecheck_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_dart_format_probe_aspect"
      ],
      "lint": [
        "real_dart_lint_probe_aspect"
      ],
      "typecheck": [
        "real_dart_typecheck_probe_aspect"
      ]
    }
  },
  "docs": {
    "bzl": "tools/docs/dart:aspect.bzl",
    "file_extensions": [
      ".dart"
    ],
    "aspects": [
      "real_dart_docs_aspect"
    ]
  }
}
