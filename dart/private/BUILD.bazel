load("@bazel_skylib//lib:selects.bzl", "selects")
load("//core:cells.bzl", "unsupported_value")
load("//core/quality:fixtures.bzl", "real_source_target")
load(":platforms.bzl", "DART_PLATFORMS")

package(default_visibility = [
    "//:__pkg__",
    "//dart:__subpackages__",
    "//tools/ci:__pkg__",
])

unsupported_value("unsupported")

exports_files([
    "dart_config.bzl",
    "defs.bzl",
    "platforms.bzl",
    "providers.bzl",
])

[
    config_setting(
        name = name,
        constraint_values = [
            "@platforms//os:" + os,
            "@platforms//cpu:" + cpu,
        ],
    )
    for name, (os, cpu) in DART_PLATFORMS.items()
]

selects.config_setting_group(
    name = "rules_dart_platform",
    match_any = [":" + name for name in DART_PLATFORMS],
    visibility = ["//visibility:public"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "platforms.bzl",
        "providers.bzl",
        "dart_config.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
