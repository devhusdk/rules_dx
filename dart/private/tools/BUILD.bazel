load("//dart:defs.bzl", "DART_COMPATIBLE_WITH")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")
load(":dart_tool.bzl", "dart_tool")

package(default_visibility = ["//visibility:public"])

dart_tool(
    name = "dart",
    target_compatible_with = DART_COMPATIBLE_WITH,
)

rust_test(
    name = "format_cli_test",
    srcs = ["format_cli_test.rs"],
    data = [":dart"],
    env = {"DART": "$(rootpath :dart)"},
    target_compatible_with = DART_COMPATIBLE_WITH,
    deps = ["//tools/testing:dx_testing"],
)

rust_test(
    name = "analyze_cli_test",
    srcs = ["analyze_cli_test.rs"],
    data = [":dart"],
    env = {"DART": "$(rootpath :dart)"},
    target_compatible_with = DART_COMPATIBLE_WITH,
    deps = [
        "//tools/testing:dx_testing",
        "@crates//:serde_json",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "dart_tool.bzl",
    ],
    tags = ["corpus"],
)
