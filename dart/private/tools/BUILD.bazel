load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//dart/private:defs.bzl", "DART_COMPATIBLE_WITH")
load("//rust:defs.bzl", "rust_test")
load(":dart_tool.bzl", "dart_tool")

package(default_visibility = ["//visibility:public"])

dart_tool(
    name = "dart",
    target_compatible_with = DART_COMPATIBLE_WITH,
)

rust_test(
    name = "format_cli_test",
    srcs = ["format_cli_test.rs"],
    aliases = aliases(
        package_name = "dart/private/dart_tools",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "format_cli_test",
    crate_root = "format_cli_test.rs",
    data = [":dart"],
    env = {"DART": "$(rootpath :dart)"},
    target_compatible_with = DART_COMPATIBLE_WITH,
    deps = all_crate_deps(
        package_name = "dart/private/dart_tools",
        normal = True,
        normal_dev = True,
    ) + [
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "analyze_cli_test",
    srcs = ["analyze_cli_test.rs"],
    aliases = aliases(
        package_name = "dart/private/dart_tools",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "analyze_cli_test",
    crate_root = "analyze_cli_test.rs",
    data = [":dart"],
    env = {"DART": "$(rootpath :dart)"},
    target_compatible_with = DART_COMPATIBLE_WITH,
    deps = all_crate_deps(
        package_name = "dart/private/dart_tools",
        normal = True,
        normal_dev = True,
    ) + ["//tools/testing:dx_testing"],
)

rust_test(
    name = "windows_diag_test",
    srcs = ["windows_diag_test.rs"],
    crate_name = "windows_diag_test",
    crate_root = "windows_diag_test.rs",
    data = [":dart"],
    env = {"DART": "$(rootpath :dart)"},
    target_compatible_with = DART_COMPATIBLE_WITH,
    deps = ["//tools/testing:dx_testing"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "dart_tool.bzl",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
