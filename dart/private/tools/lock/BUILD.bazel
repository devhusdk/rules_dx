load("@crates//:crates.bzl", "aliases")
load("//cli/launcher:defs.bzl", "dx_subcommand")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//dart/private:defs.bzl", "DART_COMPATIBLE_WITH")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//:__subpackages__"])

rust_library(
    name = "pub_lock_lib",
    srcs = ["src/resolve.rs"],
    aliases = aliases(
        package_name = "dart/private/tools/pub_lock",
        normal = True,
    ),
    crate_name = "pub_lock",
    crate_root = "src/resolve.rs",
    deps = [
        "//cli/digest:dx_digest",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
    ],
)

rust_binary(
    name = "dart_lock",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "dart/private/tools/pub_lock",
        normal = True,
    ),
    crate_name = "pub_lock",
    crate_root = "src/main.rs",
    visibility = ["//visibility:public"],
    deps = [":pub_lock_lib"],
)

dx_subcommand(
    name = "lock",
    path_args = {
        "--chmod": "//core/coreutils:chmod",
        "--dart": "//dart/private/tools:dart",
    },
    subcommand = "dart_lock",
    target_compatible_with = DART_COMPATIBLE_WITH,
    visibility = ["//:__subpackages__"],
)

rust_test(
    name = "resolve_test",
    size = "small",
    srcs = ["resolve_test.rs"],
    aliases = aliases(
        package_name = "dart/private/tools/pub_lock",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "resolve_test",
    crate_root = "resolve_test.rs",
    data = ["//dart/private/tools:dart"],
    env = {"DX_DART": "$(rlocationpath //dart/private/tools:dart)"},
    tags = ["block-network"],
    target_compatible_with = DART_COMPATIBLE_WITH,
    deps = [
        ":pub_lock_lib",
        "//cli/digest:dx_digest",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
