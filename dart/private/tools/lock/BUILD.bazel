load("//core/quality:fixtures.bzl", "real_source_target")
load("//dart/private:defs.bzl", "DART_COMPATIBLE_WITH")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//:__subpackages__"])

rust_library(
    name = "pub_lock_lib",
    srcs = ["src/resolve.rs"],
    crate_name = "pub_lock",
    crate_root = "src/resolve.rs",
    deps = ["//cli/lock:dx_lock"],
)

rust_binary(
    name = "lock",
    srcs = ["src/main.rs"],
    crate_name = "pub_lock_bin",
    crate_root = "src/main.rs",
    data = ["//dart/private/tools:dart"],
    env = {"DX_DART": "$(rlocationpath //dart/private/tools:dart)"},
    target_compatible_with = DART_COMPATIBLE_WITH,
    visibility = ["//visibility:public"],
    deps = [
        ":pub_lock_lib",
        "//cli/families:dx_families",
        "@rules_rust//rust/runfiles",
    ],
)

rust_test(
    name = "resolve_test",
    size = "small",
    srcs = ["resolve_test.rs"],
    crate_name = "resolve_test",
    crate_root = "resolve_test.rs",
    data = ["//dart/private/tools:dart"],
    env = {"DX_DART": "$(rlocationpath //dart/private/tools:dart)"},
    tags = ["block-network"],
    target_compatible_with = DART_COMPATIBLE_WITH,
    deps = [
        ":pub_lock_lib",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

exports_files(
    ["src/main.rs"],
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
