load("@bazel_skylib//lib:selects.bzl", "selects")
load("//quality:fixtures.bzl", "real_source_target")
load(":defs.bzl", "dart_native_target")
load(":platforms.bzl", "RULES_DART_PLATFORMS")
load(":wrapper_tests.bzl", "dart_wrapper_contract_tests")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
    "platforms.bzl",
    "wrapper_tests.bzl",
])

dart_native_target(name = "native_target")

dart_wrapper_contract_tests(name = "wrapper_contract_tests")

[
    config_setting(
        name = name,
        constraint_values = [
            "@platforms//os:" + os,
            "@platforms//cpu:" + cpu,
        ],
    )
    for name, (os, cpu) in RULES_DART_PLATFORMS.items()
]

selects.config_setting_group(
    name = "rules_dart_platform",
    match_any = [":" + name for name in RULES_DART_PLATFORMS],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "platforms.bzl",
        "wrapper_tests.bzl",
    ],
    tags = ["corpus"],
)
