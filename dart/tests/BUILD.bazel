load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//core:conformance.bzl", "dx_wrapper_contract_tests")
load("//core:defs.bzl", "expect_equal")
load("//core:entry.bzl", "dx_entry_quality_srcs", "dx_main_candidates")
load("//dart/private:defs.bzl", "DART_SOURCE_SPECS", "dart_root_package_name")
load("//dart/private:platforms.bzl", "DART_PLATFORMS")

exports_files(["padded_archive.pubspec.lock"])

# nested@1.0.0 has bytes after its gzip stream, which only the pinned bsdtar extracts.
build_test(
    name = "padded_pub_archive_test",
    targets = ["@dx_dart_padded_archive//:nested"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
    ],
    tags = ["corpus"],
    visibility = ["//:__pkg__"],
)

dx_wrapper_contract_tests(
    name = "wrapper_contract_tests",
    size = "small",
    extra_checks = [
        expect_equal(
            "dart rules own dart sources",
            DART_SOURCE_SPECS,
            [("dart", "dart")],
        ),
        expect_equal(
            "entrypoint comes first",
            dx_entry_quality_srcs(
                "bin/main.dart",
                ["bin/flags.dart"],
            ),
            [
                "bin/main.dart",
                "bin/flags.dart",
            ],
        ),
        expect_equal(
            "binary main candidates",
            dx_main_candidates(
                "tool",
                ".dart",
                ["bin"],
            ),
            [
                "tool.dart",
                "bin/tool.dart",
            ],
        ),
        expect_equal(
            "test main candidates",
            dx_main_candidates(
                "x/greet_test",
                ".dart",
                ["test"],
            ),
            [
                "greet_test.dart",
                "test/greet_test.dart",
            ],
        ),
        expect_equal(
            "missing srcs keep the entrypoint",
            dx_entry_quality_srcs("bin/main.dart", None),
            ["bin/main.dart"],
        ),
        expect_equal(
            "entrypoint listed twice is owned once",
            dx_entry_quality_srcs(
                "bin/main.dart",
                ["bin/main.dart"],
            ),
            ["bin/main.dart"],
        ),
        expect_equal(
            "no rules_dart sdk for windows arm64",
            "windows_arm64" in DART_PLATFORMS,
            False,
        ),
        expect_equal(
            "root library takes its own name",
            dart_root_package_name("", "tally", {}),
            "tally",
        ),
        expect_equal(
            "nested library keeps the directory name",
            dart_root_package_name("pkgs/tally", "lib", {}),
            None,
        ),
        expect_equal(
            "explicit root package name wins",
            dart_root_package_name(
                "",
                "lib",
                {"package_name": "tally"},
            ),
            None,
        ),
        expect_equal(
            "root package metadata wins",
            dart_root_package_name(
                "",
                "lib",
                {"package": ":meta"},
            ),
            None,
        ),
    ],
    file_classes = [file_class for file_class, _ in DART_SOURCE_SPECS],
)
