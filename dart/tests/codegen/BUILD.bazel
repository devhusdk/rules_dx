load("@rules_dart//dart/ext:defs.bzl", "builder_shim_library")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//dart:defs.bzl", "dart_binary", "dart_codegen", "dart_library", "dart_package_metadata", "dart_test")
load("//dart/private:defs.bzl", "DART_COMPATIBLE_WITH")

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "codegen",
)

builder_shim_library(
    name = "shim_runner",
    pub_hub = "@dx_dart_deps",
)

dart_binary(
    name = "generator",
    main = "generator.dart",
    target_compatible_with = DART_COMPATIBLE_WITH,
    deps = [
        ":shim_runner",
        "@dx_dart_deps//:build",
    ],
)

dart_codegen(
    name = "model_gen",
    src = "lib/model.dart",
    generator = ":generator",
    output_suffixes = [".g.dart"],
    package = ":pubspec-metadata",
    target_compatible_with = DART_COMPATIBLE_WITH,
)

# keep
dart_library(
    name = "codegen",
    srcs = [":model_gen"],
    package = ":pubspec-metadata",
)

dart_test(
    name = "codegen_test",
    deps = [
        ":codegen",
        "@dx_dart_deps//:test",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
