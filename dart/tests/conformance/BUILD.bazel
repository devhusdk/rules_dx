# gazelle:ignore
load("//dart/private:defs.bzl", "DART_COMPATIBLE_WITH")
load("//dart:defs.bzl", "dart_binary", "dart_library", "dart_test")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "subject_compatible_with")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

dart_library(
    name = "conformance",
    package_name = "conformance",
    srcs = ["lib/greet.dart"],
)

dart_library(
    name = "lint_dirty",
    package_name = "conformance_lint_dirty",
    srcs = ["lib/lint_dirty.dart"],
    tags = ["manual"],
)

dart_library(
    name = "format_dirty",
    package_name = "conformance_format_dirty",
    srcs = ["lib/format_dirty.dart"],
    tags = ["manual"],
)

dart_binary(
    name = "hello",
    main = "main.dart",
    deps = [":conformance"],
)

dart_binary(
    name = "lock_hello",
    main = "lock_main.dart",
    deps = ["@dx_dart_deps//:collection"],
)

dart_test(
    name = "pass_subject_test",
    size = "small",
    main = "pass_test.dart",
    target_compatible_with = subject_compatible_with() + DART_COMPATIBLE_WITH,
    deps = [
        ":conformance",
        "@dx_dart_deps//:test",
    ],
)

dart_test(
    name = "fail_subject_test",
    size = "small",
    main = "fail_test.dart",
    target_compatible_with = subject_compatible_with() + DART_COMPATIBLE_WITH,
    deps = [
        ":conformance",
        "@dx_dart_deps//:test",
    ],
)

dx_conformance_suite(
    name = "",
    binary = ":hello",
    covered_source = "greet.dart",
    expected = "hello world",
    failing_case = "failing_case",
    failing_pattern = "{case} [E]",
    failing_test = ":fail_subject_test",
    lang = "dart",
    lock = {
        "binary": ":lock_hello",
        "ecosystem": "dart",
        "expected": "hello lock",
        "lockfile": "//third_party/dart:pubspec.lock",
        "manifest": "//third_party/dart:pubspec.yaml",
        "package": "collection",
        "stale": "pubspec.stale.lock",
    },
    not_applicable = {"cross_test:windows_x86_64": "dart supports no other windows platform"},
    passing_test = ":pass_subject_test",
    quality = {
        "clean": ":conformance",
        "format_dirty": ":format_dirty",
        "format_source": "lib/format_dirty.dart",
        "lint_dirty": ":lint_dirty",
        "lint_line": 2,
        "lint_rule": "unused_local_variable",
        "lint_source": "lib/lint_dirty.dart",
    },
    size = "small",
)
