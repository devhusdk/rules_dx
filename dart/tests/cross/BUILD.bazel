load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_dx//dart:defs.bzl", "DART_COMPATIBLE_WITH")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust/rules:defs.bzl", "rust_test")

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

platform_transition_filegroup(
    name = "greet_arm64",
    srcs = ["//dart/tests/runtime:greet_bin"],
    target_compatible_with = DART_COMPATIBLE_WITH,
    target_platform = ":linux_arm64",
)

rust_test(
    name = "cross_arm64_test",
    srcs = ["cross_arm64_test.rs"],
    data = [":greet_arm64"],
    env = {"GREET_ARM64": "$(rootpath :greet_arm64)"},
    target_compatible_with = DART_COMPATIBLE_WITH,
    deps = ["@rules_dx//tools/testing:dx_testing"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],    visibility = ["//:__pkg__"],
)
