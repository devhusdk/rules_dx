load("@rules_dx//dart/rules:defs.bzl", "dart_library", "dart_test")
load("//quality:fixtures.bzl", "real_source_target")

_PUBLIC = ["//visibility:public"]

package(default_visibility = ["//dart/tests/fixtures/dart-app:__subpackages__"])

exports_files(
    glob([
        "data/**",
        "lib/**",
        "test/**",
    ]) + ["BUILD.bazel"],
    visibility = ["//tools/testing/hermetic:__pkg__"],
)

filegroup(
    name = "items",
    srcs = ["data/items.csv"],
    visibility = _PUBLIC,
)

dart_library(
    name = "ledger",
    package_name = "ledger",
    srcs = ["lib/ledger.dart"],
    aspect_hints = ["//dart/tests/fixtures/dart-app:dart_config"],
    visibility = _PUBLIC,
    deps = [
        "//dart/tests/fixtures/dart-app/model",
        "@dx_dart_deps//:collection",
    ],
)

dart_test(
    name = "ledger_test",
    aspect_hints = ["//dart/tests/fixtures/dart-app:dart_config"],
    data = ["data/items.csv"],
    main = "test/ledger_test.dart",
    deps = [
        ":ledger",
        "//dart/tests/fixtures/dart-app/model",
        "@dx_dart_deps//:test",
        "@rules_dart//dart/runfiles",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
