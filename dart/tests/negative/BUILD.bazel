load("@rules_dx//dart:defs.bzl", "dart_binary", "dart_library")
load("@rules_dx//core:failure_test.bzl", "failure_test")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load(":negative_tests.bzl", "dart_kernel_input_test")

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "negative_tests.bzl",
    ],
    tags = ["corpus"],
    visibility = ["@rules_dx//tools/ci:__pkg__", "//:__pkg__"],
)

filegroup(
    name = "not_dart",
    srcs = ["wrong_dep.dart"],
)

dart_library(
    name = "wrong_dep",
    package_name = "wrong_dep",
    testonly = True,
    srcs = ["wrong_dep.dart"],
    tags = ["manual"],
    deps = [":not_dart"],  # keep
)

failure_test(
    name = "dependency_without_dart_info_fails_test",
    expected_failure_substring = "does not have mandatory providers: 'DartInfo'",
    target = ":wrong_dep",
)

dart_library(
    name = "base",
    package_name = "base",
    testonly = True,
    srcs = ["lib/base.dart"],
    tags = ["manual"],
)

dart_library(
    name = "other",
    package_name = "other",
    testonly = True,
    srcs = ["lib/other.dart"],
    tags = ["manual"],
)

dart_binary(
    name = "uses_other",
    testonly = True,
    main = "test/uses_other_test.dart",
    deps = [":other"],
)

dart_kernel_input_test(
    name = "declared_dep_is_an_input_test",
    file = "lib/other.dart",
    present = True,
    target = ":uses_other_upstream",
)

dart_kernel_input_test(
    name = "undeclared_dep_is_not_an_input_test",
    file = "lib/base.dart",
    present = False,
    target = ":uses_other_upstream",
)
