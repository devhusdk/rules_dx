# gazelle:ignore

load("@rules_dx//dart:defs.bzl", "dart_binary", "dart_library", "dart_test")
load("@rules_dx//core:defs.bzl", "starlark_test")
load("@rules_dx//core:tag_probe.bzl", "tag_subject")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")

dart_library(
    name = "lib",
    package_name = "tags_lib",
    srcs = ["lib/tags_lib.dart"],
    tags = [
        "manual",
        "no-lint",
        "no-remote-exec",
    ],
)

dart_binary(
    name = "bin",
    main = "main.dart",
    tags = [
        "manual",
        "no-lint",
        "no-remote-exec",
    ],
)

dart_test(
    name = "unit",
    main = "main.dart",
    tags = [
        "manual",
        "no-lint",
        "no-remote-exec",
    ],
)

tag_subject(
    name = "tags_subject",
    testonly = True,
    targets = [
        ":bin",
        ":bin_upstream",
        ":lib",
        ":lib_upstream",
        ":unit",
        ":unit_upstream",
    ],
)

starlark_test(
    name = "tags_test",
    expected_observations = """subject //dart/tests/tags:tags_subject
field bin=manual,no-lint,no-remote-exec
field bin_upstream=dx:no-lint,manual,no-remote-exec
field lib=manual,no-lint,no-remote-exec
field lib_upstream=dx:no-lint,manual,no-remote-exec
field unit=manual,no-lint,no-remote-exec
field unit_upstream=dx:no-lint,manual,no-remote-exec
aspect_field aspect_seen=True
aspect_field field_count=6
aspect_field has_subject=True
aspect_field subject_label=//dart/tests/tags:tags_subject
aspect_field transitive_count=0
""",
    mode = "analysis",
    subjects = [":tags_subject"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],    visibility = ["//:__pkg__"],
)
