# gazelle:ignore

load("//dart/rules:defs.bzl", "dart_binary")
load("//javascript/rules:defs.bzl", "javascript_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

dart_binary(
    name = "hello_js",
    main = "main.dart",
    target = "js",
)

dart_binary(
    name = "hello_wasm",
    main = "main.dart",
    target = "wasm",
)

javascript_test(
    name = "js_run_test",
    srcs = ["js_test.mjs"],
    args = ["$(rootpath :hello_js)"],
    data = [":hello_js"],
    entry_point = "js_test.mjs",
    package_json = "//:package_json",
    runner = "node",
)

javascript_test(
    name = "wasm_run_test",
    srcs = ["wasm_test.mjs"],
    args = ["$(rootpaths :hello_wasm)"],
    data = [":hello_wasm"],
    entry_point = "wasm_test.mjs",
    package_json = "//:package_json",
    runner = "node",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
