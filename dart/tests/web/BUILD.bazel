# gazelle:ignore

load("@rules_dx//dart:defs.bzl", "dart_js_binary", "dart_wasm_binary")
load("@rules_dx//javascript:defs.bzl", "javascript_test")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load(":web_tests.bzl", "web_owns_main_test")

package(default_visibility = ["//visibility:public"])

dart_js_binary(
    name = "hello_js",
    main = "main.dart",
)

dart_wasm_binary(
    name = "hello_wasm",
    main = "main.dart",
)

javascript_test(
    name = "js_run_test",
    srcs = ["js_test.mjs"],
    args = ["$(rootpath :hello_js)"],
    data = [":hello_js"],
    main = "js_test.mjs",
    package_json = "@rules_dx//:package_json",
    runner = "node",
)

javascript_test(
    name = "wasm_run_test",
    srcs = ["wasm_test.mjs"],
    args = ["$(rootpaths :hello_wasm)"],
    data = [":hello_wasm"],
    main = "wasm_test.mjs",
    package_json = "@rules_dx//:package_json",
    runner = "node",
)

web_owns_main_test(
    name = "js_owns_main_test",
    size = "small",
    target_under_test = ":hello_js",
)

web_owns_main_test(
    name = "wasm_owns_main_test",
    size = "small",
    target_under_test = ":hello_wasm",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel", "web_tests.bzl"],
    tags = ["corpus"],
)
