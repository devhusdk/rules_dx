)

filegroup(
    name = "module_srcs",
    srcs = [
        "//:module_srcs",
        "//deploy/private:module_srcs",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
