load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

exports_files([
    "README.md",
    "defs.bzl",
])

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
)

alias(
    name = "bootstrap_offline",
    actual = "//deploy/private/offline/bootstrap:bootstrap_offline",
