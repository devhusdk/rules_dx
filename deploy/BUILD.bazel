load("@crates//:crates.bzl", "aliases")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary")

package(default_visibility = ["//:__subpackages__"])

exports_files([
    "Cargo.toml",
    "README.md",
    "defs.bzl",
    "verify_test.rs",
])

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "bootstrap_offline",
    srcs = ["bootstrap_offline.rs"],
    aliases = aliases(
        package_name = "deploy_bootstrap_offline",
        normal = True,
    ),
    crate_name = "bootstrap_offline",
    crate_root = "bootstrap_offline.rs",
    visibility = ["//visibility:public"],
    deps = ["//deploy/private/offline/bootstrap:dx_bootstrap"],
)

filegroup(
    name = "module_srcs",
    srcs = [
        "//:module_srcs",
        "//deploy/private:module_srcs",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
