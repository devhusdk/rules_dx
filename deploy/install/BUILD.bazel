load("@crates//:crates.bzl", "aliases", "all_crate_deps", "crate_deps")
load("//deploy/release:cosign_pins.bzl", "COSIGN_VERSION")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")

package(default_visibility = ["//:__subpackages__"])

rust_library(
    name = "dx_install_tools",
    srcs = [
        "src/install.rs",
        "src/install_tests.rs",
        "src/lib.rs",
        "src/trust.rs",
    ],
    aliases = aliases(
        package_name = "deploy/dx_install_tools",
        normal = True,
    ),
    compile_data = ["//deploy/release:matrix.bzl"],
    crate_name = "dx_install_tools",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = crate_deps(
        ["serde_json"],
        package_name = "deploy/dx_install_tools",
    ) + [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/digest:dx_digest",
        "//cli/path:dx_path",
        "//deploy/release:dx_release_tools",
        "//libs/archive:dx_archive",
    ],
)

rust_binary(
    name = "dx_verify",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "deploy/dx_install_tools",
        normal = True,
    ),
    crate_name = "dx_verify",
    crate_root = "src/main.rs",
    edition = "2021",
    deps = crate_deps(
        [],
        package_name = "deploy/dx_install_tools",
    ) + [":dx_install_tools"],
)

rust_test(
    name = "dx_install_tools_test",
    size = "small",
    aliases = aliases(
        package_name = "deploy/dx_install_tools",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_install_tools",
    deps = all_crate_deps(
        package_name = "deploy/dx_install_tools",
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "cosign_real_test",
    size = "small",
    srcs = ["tests/cosign_real.rs"],
    aliases = aliases(
        package_name = "deploy/dx_install_tools",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "cosign_real_test",
    crate_root = "tests/cosign_real.rs",
    data = [
        "tests/fixtures/artifact.bin",
        "tests/fixtures/artifact.bundle",
        "tests/fixtures/ca.pem",
        ":dx_verify",
        "//deploy/release:cosign",
    ],
    edition = "2021",
    env = {
        "DX_COSIGN_BIN": "$(rootpath //deploy/release:cosign)",
        "DX_COSIGN_VERSION": COSIGN_VERSION,
        "DX_VERIFY_BIN": "$(rootpath :dx_verify)",
        "DX_COSIGN_FIXTURES": "$(rootpath tests/fixtures/ca.pem)",
    },
    tags = ["no-coverage"],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = all_crate_deps(
        package_name = "deploy/dx_install_tools",
        normal = True,
        normal_dev = True,
    ) + [
        ":dx_install_tools",
        "//deploy/release:dx_release_tools",
        "//tools/testing:dx_testing",
    ],
)

rustfmt_test(
    name = "dx_install_tools_fmt_test",
    size = "small",
    targets = [
        ":dx_install_tools",
        ":dx_verify",
        ":cosign_real_test",
    ],
)

rust_clippy_test(
    name = "dx_install_tools_clippy_test",
    size = "small",
    targets = [
        ":dx_install_tools",
        ":dx_verify",
        ":cosign_real_test",
    ],
)

exports_files(["Cargo.toml"])

test_suite(
    name = "all",
    tests = [
        ":cosign_real_test",
        ":dx_install_tools_test",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
