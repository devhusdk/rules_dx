load("@crates//:crates.bzl", "aliases", "crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")

package(default_visibility = ["//:__subpackages__"])

rust_library(
    name = "dx_install_tools",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "deploy/dx_install_tools",
        normal = True,
    ),
    crate_name = "dx_install_tools",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = crate_deps(
        [],
        package_name = "deploy/dx_install_tools",
    ) + [
        "//cli/digest:dx_digest",
        "//cli/process:dx_process",
    ],
)

rust_binary(
    name = "dx_verify",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "deploy/dx_install_tools",
        normal = True,
    ),
    crate_name = "dx_verify",
    crate_root = "src/main.rs",
    edition = "2021",
    deps = crate_deps(
        [],
        package_name = "deploy/dx_install_tools",
    ) + [":dx_install_tools"],
)

rust_test(
    name = "dx_install_tools_test",
    size = "small",
    aliases = aliases(
        package_name = "deploy/dx_install_tools",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_install_tools",
    deps = crate_deps(
        ["tempfile"],
        package_name = "deploy/dx_install_tools",
    ),
)

rustfmt_test(
    name = "dx_install_tools_fmt_test",
    size = "small",
    targets = [
        ":dx_install_tools",
        ":dx_verify",
    ],
)

rust_clippy_test(
    name = "dx_install_tools_clippy_test",
    size = "small",
    targets = [
        ":dx_install_tools",
        ":dx_verify",
    ],
)

exports_files(["Cargo.toml"])

test_suite(
    name = "all",
    tests = [":dx_install_tools_test"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
