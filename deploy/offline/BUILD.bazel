load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_test", "rustfmt_test")
load(":offline.bzl", "offline_bundle")
load(":offline_tests.bzl", "offline_file_tests", "offline_unit_tests")

package(default_visibility = ["//visibility:public"])

exports_files([
    "offline.bzl",
    "offline_tests.bzl",
])

exports_files(
    [
        "demo/bazelisk-darwin-amd64",
        "demo/bazelisk-darwin-arm64",
        "demo/bazelisk-linux-amd64",
        "demo/bazelisk-linux-arm64",
        "demo/bazelisk-windows-amd64.exe",
        "demo/cargo.json",
        "demo/cargo.meta.json",
    ],
    visibility = ["//visibility:private"],
)

alias(
    name = "bootstrap_offline",
    actual = "//deploy/offline/bootstrap:bootstrap_offline",
)

offline_bundle(
    name = "offline_demo",
    advisory = {"cargo": ":demo/cargo.json"},
    advisory_meta = {"cargo": ":demo/cargo.meta.json"},
    launchers = [
        ":demo/bazelisk-darwin-amd64",
        ":demo/bazelisk-darwin-arm64",
        ":demo/bazelisk-linux-amd64",
        ":demo/bazelisk-linux-arm64",
        ":demo/bazelisk-windows-amd64.exe",
    ],
)

offline_unit_tests(name = "offline_unit")

offline_file_tests(
    name = "offline_files",
    advisory = ":offline_demo/advisory/SHA256SUMS",
    bazelisk = ":offline_demo/bazelisk/SHA256SUMS",
)

# keep
rust_test(
    name = "bootstrap_test",
    size = "small",
    srcs = ["bootstrap_test.rs"],
    data = [
        ":bootstrap_offline",
        ":offline.bzl",
        ":offline_demo",
        ":offline_demo/advisory/SHA256SUMS",
        ":offline_demo/bazelisk/SHA256SUMS",
        "//deploy/offline/bootstrap:src/lib.rs",
    ],
    env = {
        "DX_BOOTSTRAP": "$(rootpath :bootstrap_offline)",
        "DX_OFFLINE_BZL": "$(rootpath :offline.bzl)",
        "DX_OFFLINE_DEMO": "$(rootpath :offline_demo/bazelisk/SHA256SUMS)",
        "DX_BOOTSTRAP_SRC": "$(rootpath //deploy/offline/bootstrap:src/lib.rs)",
    },
    tags = ["no-coverage"],
    deps = [
        "//cli/digest:dx_digest",
        "//cli/path:dx_path",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "offline.bzl",
        "offline_tests.bzl",
    ],
    tags = ["corpus"],
)

rustfmt_test(
    name = "offline_fmt_test",
    size = "small",
    targets = [
        ":bootstrap_test",
    ],
)
