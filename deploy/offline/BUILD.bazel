load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_test")
load(":offline.bzl", "offline_bundle")
load(":offline_tests.bzl", "offline_file_tests", "offline_unit_tests")

package(default_visibility = ["//visibility:public"])

exports_files([
    "offline.bzl",
    "offline_tests.bzl",
])

exports_files(
    [
        "demo/demo-bazelisk-linux-amd64",
        "demo/demo-cargo.json",
    ],
    visibility = ["//visibility:private"],
)

alias(
    name = "bootstrap_offline",
    actual = "//deploy/offline/bootstrap:bootstrap_offline",
)

offline_bundle(
    name = "offline_demo",
    advisory = {"cargo": ":demo/demo-cargo.json"},
    launchers = [":demo/demo-bazelisk-linux-amd64"],
)

offline_unit_tests(name = "offline_unit")

offline_file_tests(
    name = "offline_files",
    manifest = ":offline_demo_manifest",
)

# keep
rust_test(
    name = "bootstrap_test",
    size = "small",
    srcs = ["bootstrap_test.rs"],
    data = [
        ":bootstrap_offline",
        "//deploy/offline/bootstrap:src/lib.rs",
    ],
    env = {
        "DX_BOOTSTRAP": "$(rootpath :bootstrap_offline)",
        "DX_BOOTSTRAP_SRC": "$(rootpath //deploy/offline/bootstrap:src/lib.rs)",
    },
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//cli/digest:dx_digest",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "offline.bzl",
        "offline_tests.bzl",
    ],
    tags = ["corpus"],
)
