load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//quality:fixtures.bzl", "real_source_target")
load(":offline.bzl", "offline_bundle")
load(":offline_tests.bzl", "offline_file_tests", "offline_unit_tests")

package(default_visibility = ["//visibility:public"])

exports_files([
    "bootstrap-offline.sh",
    "offline.bzl",
    "offline_tests.bzl",
])

exports_files(
    [
        "demo/demo-bazelisk-linux-amd64",
        "demo/demo-cargo.json",
    ],
    visibility = ["//visibility:private"],
)

sh_binary(
    name = "bootstrap_offline",
    srcs = ["bootstrap-offline.sh"],
)

offline_bundle(
    name = "offline_demo",
    advisory = {"cargo": ":demo/demo-cargo.json"},
    launchers = [":demo/demo-bazelisk-linux-amd64"],
)

offline_unit_tests(name = "offline_unit")

offline_file_tests(
    name = "offline_files",
    manifest = ":offline_demo_manifest",
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "offline.bzl",
        "offline_tests.bzl",
    ],
    tags = ["corpus"],
)
