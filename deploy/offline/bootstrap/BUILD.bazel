load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_PUBLIC")

package(default_visibility = VIS_PUBLIC)

exports_files([
    "Cargo.toml",
    "src/lib.rs",
    "src/main.rs",
])

rust_binary(
    name = "bootstrap_offline",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "deploy/offline/dx_bootstrap",
        normal = True,
    ),
    crate_name = "bootstrap_offline",
    crate_root = "src/main.rs",
    deps = all_crate_deps(
        package_name = "deploy/offline/dx_bootstrap",
        normal = True,
    ) + [":dx_bootstrap"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

rust_library(
    name = "dx_bootstrap",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "deploy/offline/dx_bootstrap",
        normal = True,
    ),
    crate_name = "dx_bootstrap",
    crate_root = "src/lib.rs",
    deps = [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/digest:dx_digest",
        "//cli/path:dx_path",
    ],
)

rust_test(
    name = "dx_bootstrap_test",
    size = "small",
    srcs = [
        "src/lib.rs",
        "src/lib_tests.rs",
    ],
    aliases = aliases(
        package_name = "deploy/offline/dx_bootstrap",
        normal = True,
        normal_dev = True,
    ),
    coverage_lib = ":dx_bootstrap",
    crate_name = "dx_bootstrap",
    crate_root = "src/lib.rs",
    deps = [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/digest:dx_digest",
        "//cli/path:dx_path",
        "//tools/testing:dx_testing",
    ],
)
