load("@crates//:crates.bzl", "aliases", "crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:crate.bzl", "dx_rust_crate")
load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rustfmt_test")
load("//tools/visibility:visibility.bzl", "VIS_PUBLIC")

package(default_visibility = VIS_PUBLIC)

exports_files([
    "Cargo.toml",
    "src/lib.rs",
    "src/main.rs",
])

dx_rust_crate(
    name = "dx_bootstrap",
    package_name = "deploy/dx_bootstrap",
    srcs = ["src/lib.rs"],
    extra_deps = [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/digest:dx_digest",
        "//cli/path:dx_path",
    ],
    extra_test_deps = ["//tools/testing:dx_testing"],
    test_srcs = ["src/lib_tests.rs"],
    deps = [],
)

rust_binary(
    name = "bootstrap_offline",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "deploy/offline/dx_bootstrap",
        normal = True,
    ),
    crate_name = "bootstrap_offline",
    crate_root = "src/main.rs",
    edition = "2021",
    deps = crate_deps(
        [],
        package_name = "deploy/offline/dx_bootstrap",
    ) + [":dx_bootstrap"],
)

rustfmt_test(
    name = "bootstrap_offline_fmt_test",
    size = "small",
    targets = [":bootstrap_offline"],
)

rust_clippy_test(
    name = "bootstrap_offline_clippy_test",
    size = "small",
    targets = [":bootstrap_offline"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
