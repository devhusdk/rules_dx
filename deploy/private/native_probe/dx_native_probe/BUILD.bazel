load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("//deploy/private:native_runtime.bzl", "dx_native_runtime")
load("@rules_python//python/cc:py_extension.bzl", "py_extension")
load("//deploy/private:native_probe.bzl", "NATIVE_PROBE_COMPATIBLE", "dx_native_probe_runtime_files")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//deploy/private:__pkg__"])

py_extension(
    name = "_core",
    srcs = ["_core.cc"],
    target_compatible_with = NATIVE_PROBE_COMPATIBLE,
)

cc_library(
    name = "helper",
    srcs = ["_helper.cc"],
    target_compatible_with = ["@platforms//os:linux"],
)

cc_shared_library(
    name = "dx_probe_helper",
    deps = [":helper"],
    target_compatible_with = ["@platforms//os:linux"],
)

dx_native_runtime(
    name = "dx_probe_helper_runtime",
    srcs = [":dx_probe_helper"],
    notice = "dx_probe_helper_NOTICE.txt",
    redistribution = "app_local",
    source = "rules_dx native probe fixture",
    target_compatible_with = ["@platforms//os:linux"],
    version = "1.0",
)

filegroup(
    name = "dx_probe_helper_notice",
    srcs = [":dx_probe_helper_runtime"],
    output_group = "notice",
    target_compatible_with = ["@platforms//os:linux"],
)

py_extension(
    name = "_linked",
    srcs = ["_linked.cc"],
    dynamic_deps = [":dx_probe_helper"],
    linkopts = ["-Wl,-rpath,$$ORIGIN"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

filegroup(
    name = "linked_srcs",
    srcs = [
        ":_linked",
        ":dx_probe_helper_runtime",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

filegroup(
    name = "nocore_srcs",
    srcs = [
        "__init__.py",
        "__init__.pyi",
        "__main__.py",
        "py.typed",
    ],
)

filegroup(
    name = "srcs",
    srcs = [
        ":_core",
        ":nocore_srcs",
    ],
)

dx_native_probe_runtime_files(
    name = "msvc_runtime_files",
    runtime = "//cc/toolchains:msvc_vcruntime",
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

filegroup(
    name = "msvc_vcruntime_notice",
    srcs = ["//cc/toolchains:msvc_vcruntime"],
    output_group = "notice",
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

filegroup(
    name = "msvc_srcs",
    srcs = [
        ":msvc_runtime_files",
        ":srcs",
    ],
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

real_source_target(
    name = "corpus_cpp",
    testonly = True,
    cpp_srcs = [
        "_core.cc",
        "_helper.cc",
        "_linked.cc",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_python",
    testonly = True,
    python_srcs = [
        "__init__.py",
        "__main__.py",
    ],
    tags = ["corpus"],
)
