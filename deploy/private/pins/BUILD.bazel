load("@dx_pins_data//:pins.bzl", "DATA")
load("//deploy/private:go_sdk.bzl", "dx_go_binary_file")

_ARCHIVES = DATA["dx_deploy"]["archives"]

SEMVER_CHECKS_PLATFORMS = {name[len("semver_checks_"):]: pin for name, pin in _ARCHIVES.items() if name.startswith("semver_checks_")}

OPAM_PLATFORMS = {name[len("opam_"):]: pin for name, pin in _ARCHIVES.items() if name.startswith("opam_")}

package(default_visibility = ["//visibility:public"])

exports_files([
    "extensions.bzl",
    "pins.json",
    "repos.bzl",
])

[
    config_setting(
        name = "semver_checks_" + key,
        constraint_values = [
            "@platforms//os:" + pin["os"],
            "@platforms//cpu:" + pin["cpu"],
        ],
    )
    for key, pin in SEMVER_CHECKS_PLATFORMS.items()
]

[
    alias(
        name = "semver_checks_" + key + "_bin",
        actual = "@cargo_semver_checks_" + key + "//:" + pin["exe"],
    )
    for key, pin in SEMVER_CHECKS_PLATFORMS.items()
]

filegroup(
    name = "semver_checks_none",
    srcs = [],
)

alias(
    name = "cargo_semver_checks",
    actual = select({
        ":semver_checks_" + key: ":semver_checks_" + key + "_bin"
        for key in SEMVER_CHECKS_PLATFORMS
    } | {"//conditions:default": ":semver_checks_none"}),
)

[
    config_setting(
        name = "opam_" + key,
        constraint_values = [
            "@platforms//os:" + pin["os"],
            "@platforms//cpu:" + pin["cpu"],
        ],
    )
    for key, pin in OPAM_PLATFORMS.items()
]

filegroup(
    name = "opam_none",
    srcs = [],
)

alias(
    name = "opam",
    actual = select({
        ":opam_" + key: "@opam_" + key + "//file"
        for key in OPAM_PLATFORMS
    } | {"//conditions:default": ":opam_none"}),
)

alias(
    name = "apicompat",
    actual = "@apicompat_tool//:files",
)

alias(
    name = "japicmp",
    actual = "@japicmp_jar//file",
)

alias(
    name = "apidiff",
    actual = "@org_golang_x_exp//cmd/apidiff",
)

dx_go_binary_file(name = "go")
