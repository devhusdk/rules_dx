load("@crates//:crates.bzl", "aliases")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")
load("//tools/testing:nested_bazel.bzl", "NESTED_BAZEL_DATA", "NESTED_BAZEL_NETWORK_ENV", "NESTED_BAZEL_NETWORK_TAGS")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

rust_test(
    name = "release_consumer_smoke_test",
    size = "small",
    timeout = "moderate",
    testonly = True,
    srcs = [
        "candidate_consumer_test.rs",
        "quickstart_consumer_test.rs",
        "release_consumer_test.rs",
    ],
    aliases = aliases(
        package_name = "deploy/private/release/deploy_release_tests",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "release_consumer_smoke_test",
    crate_root = "release_consumer_test.rs",
    data = [
        "//:README.md",
        "//.bcr:presubmit.yml",
        "//:module_srcs",
        "//bcr_test_module:files",
        "//bcr_test_module/main_in_dep:files",
        "//bcr_test_module/qt_hello:files",
        "//cli/cli:dx",
        "//core/coreutils:applets",
        "//core/modules:core_budget.json",
        "//deploy:module_srcs",
        "//patches/gomod-parser:glued_comment.patch",
        "//patches/llvm:aarch64_outline_atomics.patch",
        "//patches/llvm:clang_cl_crt_default_lib.patch",
        "//patches/llvm:clang_cl_profile_no_mingw.patch",
        "//patches/llvm:libunwind_copy.patch",
        "//patches/llvm:lse_atomic_sources.patch",
        "//patches/llvm:macos_sdk_resolve_symlinks.patch",
        "//patches/llvm:msvc_link_lib_env.patch",
        "//patches/llvm:msvc_source_directories.patch",
        "//patches/llvm:stage0_runtime_features.patch",
        "//patches/llvm:toolchains_gate.patch",
        "//patches/llvm:unwatched_overlay_inputs.patch",
        "//patches/ring:clang_cl_aarch64_windows.patch",
        "//patches/ring:msvc_fiat_include_path.patch",
        "//patches/rules_flutter:flutter_3_47_9.patch",
        "//patches/rules_flutter:ios_target_compatible_with.patch",
        "//patches/rules_flutter:lock_extension.patch",
        "//patches/rules_flutter:registrant_javacopts.patch",
        "//patches/rules_flutter:required_checksums.patch",
        "//patches/rules_py:external_repo_pytest_paths.patch",
        "//patches/rules_py:host_interpreter_windows_arm64.patch",
        "//patches/rules_py:host_libc_glibc.patch",
        "//patches/rules_py:native_sdist_toolchain_flags.patch",
        "//patches/rules_py:pep517_msvc.patch",
        "//patches/rules_py:py_cc_toolchain_platform.patch",
        "//patches/rules_py:venv_bin_files.patch",
        "//patches/rules_py:win32_x86_32.patch",
        "//patches/rules_rust:cargo_build_script_no_coverage.patch",
        "//patches/rules_rust:cargo_toml_env_vars_flag.patch",
        "//patches/rules_rust:clippy_metadata_inputs.patch",
        "//patches/rules_rust:crate_universe_lazy_host_tools.patch",
        "//patches/rules_rust:crate_universe_module_labels.patch",
        "//patches/rules_rust:crate_universe_root_lookup.patch",
        "//patches/rules_rust:exec_scope_universal.patch",
        "//patches/rules_rust:msvc_pdb_output.patch",
        "//patches/rules_rust:pipelined_rmeta_path.patch",
        "//patches/rules_rust:static_archive_link_arg.patch",
        "//patches/rules_rust:windows_exec_foreign_target_cc_linker.patch",
        "//swift/tests:consumer_srcs",
    ] + NESTED_BAZEL_DATA,
    env = {
        "DX_COREUTILS": "$(rootpaths //core/coreutils:applets)",
        "DX_BIN": "$(rootpath //cli/cli:dx)",
        "DX_CORE_BUDGET": "$(rootpath //core/modules:core_budget.json)",
        "RUST_TEST_THREADS": "1",
    } | NESTED_BAZEL_NETWORK_ENV,
    # The consumers fetch the rust and GCC toolchains and bcr modules.
    tags = NESTED_BAZEL_NETWORK_TAGS,
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//deploy/private:dx_deploy_tools",
        "//deploy/private/release:dx_release_tools",
        "//tools/testing:dx_testing",
        "//tools/testing/nested:dx_nested",
        "@crates//:serde_json",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    testonly = True,
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

filegroup(
    name = "module_srcs",
    testonly = False,
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
