load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//core:defs.bzl", "starlark_test")
load("//deploy/private:github.bzl", "github_deploy")
load("//deploy/private:oci.bzl", "oci_deploy")
load("//deploy/private:pypi.bzl", "pypi_deploy")
load("//deploy/private:sbom.bzl", "dx_sbom")
load(":sbom_tests.bzl", "plain_file_sbom_tests")
load("//rust:defs.bzl", "rust_binary", "rust_library")

package(default_visibility = ["//deploy/private:__pkg__"])

rust_library(
    name = "greeter",
    srcs = ["greeter.rs"],
)

rust_binary(
    name = "app",
    srcs = ["app.rs"],
    deps = [":greeter"],
)

dx_sbom(
    name = "app_sbom",
    artifact = ":app",
    package_name = "app",
)

github_deploy(
    name = "app_release",
    artifacts = [":app"],
    sbom = ":app_sbom",
)

starlark_test(
    name = "sbom_test",
    size = "small",
    file_checks = {
        ":app_sbom": """"downloadLocation"
"name": "greeter"
""",
    },
    mode = "execution",
)

oci_deploy(
    name = "app_image",
    image_tar = "image.tar",
    platform = "//deploy:linux_amd64",
    sbom = ":app_sbom",
)

starlark_test(
    name = "oci_sbom_test",
    size = "small",
    file_checks = {
        ":app_image_config": """"sbom_rloc"
app.spdx.json
""",
    },
    mode = "execution",
)

dx_sbom(
    name = "locked_sbom",
    artifact = ":app",
    go_mod = "go.mod",
    maven_lock = "maven_install.json",
    npm_lock = "package-lock.json",
    package_name = "locked",
    pip_lock = "uv.lock",
)

starlark_test(
    name = "locks_test",
    size = "small",
    file_checks = {
        ":locked_sbom": """pkg:npm/left-pad@1.3.0
pkg:npm/is-odd@3.0.1
pkg:golang/github.com/google/uuid@v1.6.0
pkg:maven/com.google.guava:guava@33.0.0-jre
pkg:pypi/requests@2.32.3
""",
    },
    mode = "execution",
)

pypi_deploy(
    name = "app_wheel",
    sbom = ":app_sbom",
    wheel = "app-1.0.0-py3-none-any.whl",
)

sh_test(
    name = "deployment_sbom_test",
    size = "small",
    srcs = ["deployment_check.sh"],
    data = [":app_wheel"],
)

plain_file_sbom_tests(name = "plain_file_sbom_test")
