load("//cc:defs.bzl", "cc_binary")
load("//deploy/private:debug_info.bzl", "dx_dsym", "dx_pdb", "dx_split_debug_info")

package(default_visibility = ["//deploy/private/symbols:__subpackages__"])

exports_files(["known.c"])

cc_binary(
    name = "known",
    srcs = ["known.c"],
    copts = [
        "-O2",
        "-g",
    ],
    features = ["-strip_debug_symbols"],
    target_compatible_with = ["@platforms//os:linux"],
)

cc_binary(
    name = "other",
    srcs = ["other.c"],
    copts = [
        "-O2",
        "-g",
    ],
    features = ["-strip_debug_symbols"],
    target_compatible_with = ["@platforms//os:linux"],
)

cc_binary(
    name = "no_build_id",
    srcs = ["known.c"],
    linkopts = ["-Wl,--build-id=none"],
    target_compatible_with = ["@platforms//os:linux"],
)

dx_split_debug_info(
    name = "known_split",
    binary = ":known",
)

filegroup(
    name = "known_symbols",
    srcs = [":known_split"],
    output_group = "symbols",
)

dx_split_debug_info(
    name = "other_split",
    binary = ":other",
)

filegroup(
    name = "other_symbols",
    srcs = [":other_split"],
    output_group = "symbols",
)

cc_binary(
    name = "known_macos",
    srcs = ["known.c"],
    copts = [
        "-O2",
        "-g",
    ],
    features = ["-strip_debug_symbols"],
    target_compatible_with = ["@platforms//os:macos"],
)

dx_dsym(
    name = "known_dsym",
    binary = ":known_macos",
)

filegroup(
    name = "known_dsym_symbols",
    srcs = [":known_dsym"],
    output_group = "symbols",
    target_compatible_with = ["@platforms//os:macos"],
)

cc_binary(
    name = "known_windows",
    srcs = ["known.c"],
    copts = ["/O2"],
    local_defines = ["DX_PRINT_RVA"],
    target_compatible_with = ["@platforms//os:windows"],
)

cc_binary(
    name = "other_windows",
    srcs = ["other.c"],
    copts = ["/O2"],
    target_compatible_with = ["@platforms//os:windows"],
)

dx_pdb(
    name = "known_pdb",
    binary = ":known_windows",
)

filegroup(
    name = "known_pdb_symbols",
    srcs = [":known_pdb"],
    output_group = "symbols",
    target_compatible_with = ["@platforms//os:windows"],
)

dx_pdb(
    name = "other_pdb",
    binary = ":other_windows",
)

filegroup(
    name = "other_pdb_symbols",
    srcs = [":other_pdb"],
    output_group = "symbols",
    target_compatible_with = ["@platforms//os:windows"],
)
