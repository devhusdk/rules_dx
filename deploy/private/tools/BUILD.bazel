load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

alias(
    name = "nfpm",
    actual = select({
        "@platforms//os:macos": "@nfpm_macos_arm64//:nfpm",
        "@platforms//os:windows": "@nfpm_windows_x86_64//:nfpm.exe",
        ":linux_arm64": "@nfpm_linux_arm64//:nfpm",
        "//conditions:default": "@nfpm_linux_x86_64//:nfpm",
    }),
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "nfpm.BUILD.bazel",
        "nfpm_windows.BUILD.bazel",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
