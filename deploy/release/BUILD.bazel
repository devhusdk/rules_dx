)

notice_bundle(
    name = "notice_demo",
    inventory = ":notice_demo_inventory.txt",
    root = "//deploy/release:notice_demo",
    texts = [
        ":notice_demo_a.txt",
        ":notice_demo_b.txt",
    ],
)

[
    config_setting(
        name = "cosign_" + key,
        constraint_values = [
            "@platforms//os:" + pin["os"],
            "@platforms//cpu:" + pin["cpu"],
        ],
    )
    for key, pin in COSIGN_PLATFORMS.items()
]

[
    cosign_binary(
        name = "cosign_" + key + "_bin",
        binary = "@cosign_" + key + "//file",
        sha256 = pin["sha256"],
        visibility = ["//visibility:public"],
    )
    for key, pin in COSIGN_PLATFORMS.items()
]

filegroup(
    name = "cosign_unsupported",
    target_compatible_with = ["@platforms//:incompatible"],
    visibility = ["//visibility:public"],
)

alias(
    name = "cosign",
    actual = select({
        ":cosign_linux_arm64": ":cosign_linux_arm64_bin",
        ":cosign_linux_x86_64": ":cosign_linux_x86_64_bin",
        ":cosign_macos_arm64": ":cosign_macos_arm64_bin",
        ":cosign_windows_x86_64": ":cosign_windows_x86_64_bin",
        "//conditions:default": ":cosign_unsupported",
    }),
    visibility = ["//visibility:public"],
)

signed_release(
    name = "signing_demo",
    artifacts = [
        ":sbom_demo_spdx",
        ":sbom_demo_provenance",
        ":notice_demo_notice",
    ],
    identity = "https://github.com/devhusdk/rules_dx/.github/workflows/release.yml@refs/tags/v0.0.0-dryrun",
)

