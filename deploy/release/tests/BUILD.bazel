load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")
load("//tools/testing:nested_bazel.bzl", "NESTED_BAZEL_DATA", "NESTED_BAZEL_ENV_INHERIT", "NESTED_BAZEL_NETWORK_ENV", "NESTED_BAZEL_NETWORK_TAGS")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

# keep
rust_test(
    name = "release_candidate_smoke_test",
    timeout = "moderate",
    srcs = ["candidate_consumer_test.rs"],
    data = [
        "//cli/cli:dx",
        "//deploy:module_srcs",
    ] + NESTED_BAZEL_DATA,
    env = {
        "DX_BIN": "$(rootpath //cli/cli:dx)",
        "RUST_TEST_THREADS": "1",
    } | NESTED_BAZEL_NETWORK_ENV,
    env_inherit = NESTED_BAZEL_ENV_INHERIT,
    # The consumer fetches the rust and GCC toolchains and bcr modules.
    tags = NESTED_BAZEL_NETWORK_TAGS,
    deps = [
        "//deploy/release:dx_release_tools",
        "//deploy/rules:dx_deploy_tools",
        "//tools/testing:dx_nested",
        "//tools/testing:dx_testing",
    ],
)

# keep
rust_test(
    name = "readme_quickstart_smoke_test",
    timeout = "moderate",
    srcs = ["quickstart_consumer_test.rs"],
    data = [
        "//:README.md",
        "//.bcr:presubmit.yml",
        "//:module_srcs",
        "//bcr_test_module:files",
        "//modules:consumer_graph.json",
        "//modules:core_budget.json",
    ] + NESTED_BAZEL_DATA,
    env = {
        "DX_CORE_BUDGET": "$(rootpath //modules:core_budget.json)",
        "RUST_TEST_THREADS": "1",
    } | NESTED_BAZEL_NETWORK_ENV,
    env_inherit = NESTED_BAZEL_ENV_INHERIT,
    # The consumer fetches the rust and GCC toolchains and bcr modules.
    tags = NESTED_BAZEL_NETWORK_TAGS,
    deps = [
        "//tools/testing:dx_nested",
        "//tools/testing:dx_testing",
        "//tools/testing/floor:dx_floor",
        "@crates//:serde_json",
    ],
)

rustfmt_test(
    name = "quickstart_consumer_fmt_test",
    targets = [":readme_quickstart_smoke_test"],
)

rust_clippy_test(
    name = "quickstart_consumer_clippy_test",
    targets = [":readme_quickstart_smoke_test"],
)

rustfmt_test(
    name = "candidate_consumer_fmt_test",
    targets = [":release_candidate_smoke_test"],
)

rust_clippy_test(
    name = "candidate_consumer_clippy_test",
    targets = [":release_candidate_smoke_test"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
