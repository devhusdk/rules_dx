load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_test")
load("//tools/testing:nested_bazel.bzl", "NESTED_BAZEL_DATA", "NESTED_BAZEL_ENV_INHERIT", "NESTED_BAZEL_NETWORK_ENV", "NESTED_BAZEL_NETWORK_TAGS")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

rust_test(
    name = "release_candidate_smoke_test",
    timeout = "moderate",
    srcs = ["candidate_consumer_test.rs"],
    data = [
        "//cli/cli:dx",
        "//deploy:module_srcs",
    ] + NESTED_BAZEL_DATA,
    env = {
        "DX_BIN": "$(rootpath //cli/cli:dx)",
        "RUST_TEST_THREADS": "1",
    } | NESTED_BAZEL_NETWORK_ENV,
    env_inherit = NESTED_BAZEL_ENV_INHERIT,
    # The consumer fetches the rust and GCC toolchains and bcr modules.
    tags = NESTED_BAZEL_NETWORK_TAGS,
    deps = [
        "//deploy/release:dx_release_tools",
        "//deploy/rules:dx_deploy_tools",
        "//tools/testing:dx_testing",
        "//tools/testing/nested:dx_nested",
    ],
)

rust_test(
    name = "readme_quickstart_smoke_test",
    timeout = "moderate",
    srcs = ["quickstart_consumer_test.rs"],
    data = [
        "//:README.md",
        "//.bcr:presubmit.yml",
        "//:module_srcs",
        "//bcr_test_module:files",
        "//modules:core_budget.json",
        "//patches/gomod-parser:glued_comment.patch",
        "//patches/ring:clang_cl_aarch64_windows.patch",
        "//patches/ring:msvc_fiat_include_path.patch",
        "//patches/rules_py:external_repo_pytest_paths.patch",
        "//patches/rules_py:host_interpreter_windows_arm64.patch",
        "//patches/rules_py:native_sdist_toolchain_flags.patch",
        "//patches/rules_py:pep517_msvc.patch",
        "//patches/rules_py:py_cc_toolchain_platform.patch",
        "//patches/rules_py:venv_bin_files.patch",
    ] + NESTED_BAZEL_DATA,
    env = {
        "DX_CORE_BUDGET": "$(rootpath //modules:core_budget.json)",
        "RUST_TEST_THREADS": "1",
    } | NESTED_BAZEL_NETWORK_ENV,
    env_inherit = NESTED_BAZEL_ENV_INHERIT,
    # The consumer fetches the rust and GCC toolchains and bcr modules.
    tags = NESTED_BAZEL_NETWORK_TAGS,
    deps = [
        "//tools/testing:dx_testing",
        "//tools/testing/nested:dx_nested",
        "@crates//:serde_json",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
