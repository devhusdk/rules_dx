genrule(
    name = "oci_demo_files",
    outs = [
        "oci_demo_root/hello.txt",
        "oci_demo_root/demo.conf",
    ],
    cmd = "printf 'hello from the oci demo\\n' > $(location oci_demo_root/hello.txt) && printf 'demo=1\\n' > $(location oci_demo_root/demo.conf)",
)

genrule(
    name = "oci_demo_app_layer",
    srcs = ["oci_demo_root/hello.txt"],
    outs = ["oci_demo_app_layer.tar.gz"],
    cmd = "$(execpath :archiver) --members $@ app/hello.txt=$(location oci_demo_root/hello.txt)",
    tools = [":archiver"],
)

genrule(
    name = "oci_demo_etc_layer",
    srcs = ["oci_demo_root/demo.conf"],
    outs = ["oci_demo_etc_layer.tar.gz"],
    cmd = "$(execpath :archiver) --members $@ etc/demo.conf=$(location oci_demo_root/demo.conf)",
    tools = [":archiver"],
)

genrule(
    name = "oci_demo_tar",
    srcs = [
        ":oci_demo_app_layer",
        ":oci_demo_etc_layer",
    ],
    outs = ["oci_demo.tar"],
    cmd = "$(execpath :archiver) --image $@ linux/amd64 /app/hello $(location :oci_demo_app_layer) $(location :oci_demo_etc_layer)",
    tools = [":archiver"],
)

