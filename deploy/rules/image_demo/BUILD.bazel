load("//cc/rules:defs.bzl", "cc_binary")
load("//deploy/rules:image.bzl", "oci_image_from_binary")
load("//deploy/rules:oci.bzl", "oci_deploy")
load("//go/rules:defs.bzl", "go_binary")
load("//rust/rules:defs.bzl", "rust_binary")
load("//zig/rules:defs.bzl", "zig_binary")

rust_binary(
    name = "hello",
    srcs = ["hello.rs"],
    tags = ["manual"],
)

oci_image_from_binary(
    name = "image",
    binary = ":hello",
)

oci_deploy(
    name = "publish",
    image_tar = ":image",
    platform = "linux/amd64",
)

oci_image_from_binary(
    name = "image_multi",
    binary = ":hello",
    platforms = [
        "linux/amd64",
        "linux/arm64",
    ],
)

go_binary(
    name = "hello_go",
    srcs = ["hello.go"],
    tags = ["manual"],
)

oci_image_from_binary(
    name = "image_go",
    binary = ":hello_go",
)

cc_binary(
    name = "hello_cc",
    srcs = ["hello.c"],
    tags = ["manual"],
)

oci_image_from_binary(
    name = "image_cc",
    base = "cc",
    binary = ":hello_cc",
    tags = ["manual"],
)

zig_binary(
    name = "hello_zig",
    srcs = ["hello.zig"],
    main = "hello.zig",
    tags = ["manual"],
)

oci_image_from_binary(
    name = "image_zig",
    binary = ":hello_zig",
)
