load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("//deploy/rules:native_runtime.bzl", "native_runtime")
load("@rules_python//python/cc:py_extension.bzl", "py_extension")
load("//deploy/rules:native_probe.bzl", "NATIVE_PROBE_COMPATIBLE")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//deploy/rules:__pkg__"])

py_extension(
    name = "_core_linux",
    module_name = "_core",
    srcs = ["_core.cc"],
    target_compatible_with = ["@platforms//os:linux"],
)

# py_extension passes both CPython import libraries as one linker argument on
# Windows, so the module is linked directly there.
cc_library(
    name = "_core_windows_impl",
    srcs = ["_core.cc"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        "@rules_python//python/cc:current_py_cc_headers",
        "@rules_python//python/cc:current_py_cc_libs",
    ],
)

cc_shared_library(
    name = "_core_windows_dll",
    shared_lib_name = "_core.dll",
    target_compatible_with = ["@platforms//os:windows"],
    deps = [":_core_windows_impl"],
)

copy_file(
    name = "_core_windows",
    src = ":_core_windows_dll",
    out = "_core.cp312-win_amd64.pyd",
    target_compatible_with = ["@platforms//os:windows"],
)

filegroup(
    name = "_core",
    srcs = select({
        "@platforms//os:windows": [":_core_windows"],
        "//conditions:default": [":_core_linux"],
    }),
    target_compatible_with = NATIVE_PROBE_COMPATIBLE,
)

cc_library(
    name = "helper",
    srcs = ["_helper.cc"],
    target_compatible_with = ["@platforms//os:linux"],
)

cc_shared_library(
    name = "dx_probe_helper",
    deps = [":helper"],
    target_compatible_with = ["@platforms//os:linux"],
)

native_runtime(
    name = "dx_probe_helper_runtime",
    srcs = [":dx_probe_helper"],
    notice = "dx_probe_helper_NOTICE.txt",
    redistribution = "app_local",
    source = "rules_dx native probe fixture",
    target_compatible_with = ["@platforms//os:linux"],
    version = "1.0",
)

filegroup(
    name = "dx_probe_helper_notice",
    srcs = [":dx_probe_helper_runtime"],
    output_group = "notice",
    target_compatible_with = ["@platforms//os:linux"],
)

py_extension(
    name = "_linked",
    srcs = ["_linked.cc"],
    dynamic_deps = [":dx_probe_helper"],
    linkopts = ["-Wl,-rpath,$$ORIGIN"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

filegroup(
    name = "linked_srcs",
    srcs = [
        ":_linked",
        ":dx_probe_helper_runtime",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

filegroup(
    name = "nocore_srcs",
    srcs = [
        "__init__.py",
        "__init__.pyi",
        "__main__.py",
        "py.typed",
    ],
)

filegroup(
    name = "srcs",
    srcs = [
        ":_core",
        ":nocore_srcs",
    ],
)

real_source_target(
    name = "corpus_cpp",
    testonly = True,
    cpp_srcs = [
        "_core.cc",
        "_helper.cc",
        "_linked.cc",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_python",
    testonly = True,
    python_srcs = [
        "__init__.py",
        "__main__.py",
    ],
    tags = ["corpus"],
)
