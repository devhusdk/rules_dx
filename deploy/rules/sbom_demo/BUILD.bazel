load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//deploy/rules:github.bzl", "github_deploy")
load("//deploy/rules:oci.bzl", "oci_deploy")
load("//deploy/rules:sbom.bzl", "dx_sbom")
load("//rust/rules:defs.bzl", "rust_binary", "rust_library")

package(default_visibility = ["//deploy/rules:__pkg__"])

rust_library(
    name = "greeter",
    srcs = ["greeter.rs"],
)

rust_binary(
    name = "app",
    srcs = ["app.rs"],
    deps = [":greeter"],
)

dx_sbom(
    name = "app_sbom",
    artifact = ":app",
    package_name = "app",
)

github_deploy(
    name = "app_release",
    artifacts = [":app"],
    sbom = ":app_sbom",
)

sh_test(
    name = "sbom_test",
    size = "small",
    srcs = ["check.sh"],
    args = ["$(rootpath :app_sbom)"],
    data = [":app_sbom"],
)

oci_deploy(
    name = "app_image",
    image_tar = "image.tar",
    platform = "linux/amd64",
    sbom = ":app_sbom",
)

sh_test(
    name = "oci_sbom_test",
    size = "small",
    srcs = ["oci_check.sh"],
    args = ["$(rootpath :app_image_config)"],
    data = [":app_image_config"],
)

dx_sbom(
    name = "locked_sbom",
    artifact = ":app",
    go_mod = "go.mod",
    npm_lock = "package-lock.json",
    package_name = "locked",
)

sh_test(
    name = "locks_test",
    size = "small",
    srcs = ["locks_check.sh"],
    args = ["$(rootpath :locked_sbom)"],
    data = [":locked_sbom"],
)
