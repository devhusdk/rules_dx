load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:crate.bzl", "dx_rust_crate")
load("//rust/rules:defs.bzl", "rust_binary")

package(default_visibility = ["//:__subpackages__"])

dx_rust_crate(
    name = "dx_symbols",
    package_name = "deploy/dx_symbols",
    srcs = ["src/lib.rs"],
    test_srcs = ["src/tests.rs"],
    deps = [
        "object",
        "serde_json",
        "sha2",
    ],
)

rust_binary(
    name = "split",
    srcs = ["src/bin_split.rs"],
    aliases = aliases(
        package_name = "deploy/dx_symbols",
        normal = True,
    ),
    crate_name = "split",
    crate_root = "src/bin_split.rs",
    edition = "2021",
    deps = all_crate_deps(
        package_name = "deploy/dx_symbols",
        normal = True,
    ) + [":dx_symbols"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
