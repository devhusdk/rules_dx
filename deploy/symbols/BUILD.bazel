load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:crate.bzl", "dx_rust_crate")
load("//rust/rules:defs.bzl", "rust_binary", "rust_test")

package(default_visibility = ["//:__subpackages__"])

dx_rust_crate(
    name = "dx_symbols",
    package_name = "deploy/dx_symbols",
    srcs = ["src/lib.rs"],
    test_srcs = ["src/tests.rs"],
    deps = [
        "object",
        "serde_json",
        "sha2",
    ],
)

rust_binary(
    name = "split",
    srcs = ["src/bin_split.rs"],
    aliases = aliases(
        package_name = "deploy/dx_symbols",
        normal = True,
    ),
    crate_name = "split",
    crate_root = "src/bin_split.rs",
    deps = all_crate_deps(
        package_name = "deploy/dx_symbols",
        normal = True,
    ) + [":dx_symbols"],
)

rust_binary(
    name = "dsym",
    srcs = ["src/bin_dsym.rs"],
    aliases = aliases(
        package_name = "deploy/dx_symbols",
        normal = True,
    ),
    crate_name = "dsym",
    crate_root = "src/bin_dsym.rs",
    deps = all_crate_deps(
        package_name = "deploy/dx_symbols",
        normal = True,
    ) + [":dx_symbols"],
)

rust_binary(
    name = "pdb",
    srcs = ["src/bin_pdb.rs"],
    aliases = aliases(
        package_name = "deploy/dx_symbols",
        normal = True,
    ),
    crate_name = "pdb",
    crate_root = "src/bin_pdb.rs",
    deps = all_crate_deps(
        package_name = "deploy/dx_symbols",
        normal = True,
    ) + [":dx_symbols"],
)

rust_test(
    name = "dsym_test",
    srcs = ["dsym_test.rs"],
    data = [
        ":dsym",
        "//deploy/symbols/fixture:known.c",
        "//deploy/symbols/fixture:known_dsym",
        "//deploy/symbols/fixture:known_dsym_symbols",
        "@llvm//tools:dsymutil",
        "@llvm//tools:llvm-nm",
        "@llvm//tools:llvm-symbolizer",
    ],
    env = {
        "DX_DSYM": "$(rootpath :dsym)",
        "DX_DSYMUTIL": "$(rootpath @llvm//tools:dsymutil)",
        "DX_KNOWN_BINARY": "$(rootpath //deploy/symbols/fixture:known_dsym)",
        "DX_KNOWN_DSYM_SYMBOLS": "$(rootpaths //deploy/symbols/fixture:known_dsym_symbols)",
        "DX_KNOWN_SOURCE": "$(rootpath //deploy/symbols/fixture:known.c)",
        "DX_LLVM_NM": "$(rootpath @llvm//tools:llvm-nm)",
        "DX_LLVM_SYMBOLIZER": "$(rootpath @llvm//tools:llvm-symbolizer)",
    },
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":dx_symbols",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "pdb_test",
    srcs = ["pdb_test.rs"],
    data = [
        ":pdb",
        "//deploy/symbols/fixture:known.c",
        "//deploy/symbols/fixture:known_pdb",
        "//deploy/symbols/fixture:known_pdb_symbols",
        "//deploy/symbols/fixture:other_pdb_symbols",
        "@llvm//tools:llvm-symbolizer",
    ],
    env = {
        "DX_KNOWN_BINARY": "$(rootpath //deploy/symbols/fixture:known_pdb)",
        "DX_KNOWN_PDB_SYMBOLS": "$(rootpaths //deploy/symbols/fixture:known_pdb_symbols)",
        "DX_KNOWN_SOURCE": "$(rootpath //deploy/symbols/fixture:known.c)",
        "DX_LLVM_SYMBOLIZER": "$(rootpath @llvm//tools:llvm-symbolizer)",
        "DX_OTHER_PDB_SYMBOLS": "$(rootpaths //deploy/symbols/fixture:other_pdb_symbols)",
        "DX_PDB": "$(rootpath :pdb)",
    },
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        ":dx_symbols",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "symbols_test",
    srcs = ["symbols_test.rs"],
    data = [
        ":split",
        "//deploy/symbols/fixture:known",
        "//deploy/symbols/fixture:known.c",
        "//deploy/symbols/fixture:known_split",
        "//deploy/symbols/fixture:known_symbols",
        "//deploy/symbols/fixture:no_build_id",
        "//deploy/symbols/fixture:other_symbols",
        "@llvm//tools:llvm-nm",
        "@llvm//tools:llvm-objcopy",
        "@llvm//tools:llvm-symbolizer",
    ],
    env = {
        "DX_KNOWN_BINARY": "$(rootpath //deploy/symbols/fixture:known)",
        "DX_KNOWN_SYMBOLS": "$(rootpaths //deploy/symbols/fixture:known_symbols)",
        "DX_KNOWN_SOURCE": "$(rootpath //deploy/symbols/fixture:known.c)",
        "DX_KNOWN_STRIPPED": "$(rootpath //deploy/symbols/fixture:known_split)",
        "DX_LLVM_NM": "$(rootpath @llvm//tools:llvm-nm)",
        "DX_LLVM_OBJCOPY": "$(rootpath @llvm//tools:llvm-objcopy)",
        "DX_LLVM_SYMBOLIZER": "$(rootpath @llvm//tools:llvm-symbolizer)",
        "DX_NO_BUILD_ID": "$(rootpath //deploy/symbols/fixture:no_build_id)",
        "DX_OTHER_SYMBOLS": "$(rootpaths //deploy/symbols/fixture:other_symbols)",
        "DX_SPLIT": "$(rootpath :split)",
    },
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":dx_symbols",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
