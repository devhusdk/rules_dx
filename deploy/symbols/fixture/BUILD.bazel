load("//cc/rules:defs.bzl", "cc_binary")
load("//deploy/rules:debug_info.bzl", "dx_split_debug_info")

package(default_visibility = ["//deploy/symbols:__subpackages__"])

exports_files(["known.c"])

cc_binary(
    name = "known",
    srcs = ["known.c"],
    copts = [
        "-O2",
        "-g",
    ],
    features = ["-strip_debug_symbols"],
    target_compatible_with = ["@platforms//os:linux"],
)

cc_binary(
    name = "other",
    srcs = ["other.c"],
    copts = [
        "-O2",
        "-g",
    ],
    features = ["-strip_debug_symbols"],
    target_compatible_with = ["@platforms//os:linux"],
)

cc_binary(
    name = "no_build_id",
    srcs = ["known.c"],
    linkopts = ["-Wl,--build-id=none"],
    target_compatible_with = ["@platforms//os:linux"],
)

dx_split_debug_info(
    name = "known_split",
    binary = ":known",
)

filegroup(
    name = "known_symbols",
    srcs = [":known_split"],
    output_group = "symbols",
)

dx_split_debug_info(
    name = "other_split",
    binary = ":other",
)

filegroup(
    name = "other_symbols",
    srcs = [":other_split"],
    output_group = "symbols",
)
