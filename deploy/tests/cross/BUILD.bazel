load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//deploy/rules:archive.bzl", "archive_deploy")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")
load(":cell_test.bzl", "aarch64_link_test")
load(":defs.bzl", "cross_deployment")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

cc_binary(
    name = "cross_app",
    srcs = ["cross_app.c"],
    target_compatible_with = ["@platforms//os:linux"],
)

aarch64_link_test(
    name = "cross_app_link_test",
    target_under_test = ":cross_app",
)

archive_deploy(
    name = "cross_release",
    app = ":cross_app",
)

cross_deployment(
    name = "aarch64_release",
    deployment = ":cross_release",
    platform = "//appimage/platforms:linux_arm64",
)

# keep
rust_test(
    name = "cross_archive_test",
    size = "small",
    srcs = ["cross_archive_test.rs"],
    data = [":aarch64_release"],
    env = {"DX_RELEASE_FILES": "$(rootpaths :aarch64_release)"},
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = ["//tools/testing:dx_testing"],
)

rustfmt_test(
    name = "cross_archive_fmt_test",
    size = "small",
    targets = [":cross_archive_test"],
)

rust_clippy_test(
    name = "cross_archive_clippy_test",
    size = "small",
    targets = [":cross_archive_test"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "cell_test.bzl",
        "defs.bzl",
    ],
    tags = ["corpus"],
)
