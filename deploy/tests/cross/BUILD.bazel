load("//deploy/rules:archive.bzl", "archive_deploy")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")
load(":defs.bzl", "cross_deployment")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

platform(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

genrule(
    name = "app",
    outs = ["cross_app"],
    cmd = "echo '#!/bin/sh' > $@ && echo 'target-cpu=" + select({
        "@platforms//cpu:aarch64": "aarch64",
        "@platforms//cpu:x86_64": "x86_64",
        "//conditions:default": "other",
    }) + "' >> $@",
    executable = True,
)

archive_deploy(
    name = "cross_release",
    app = ":app",
)

cross_deployment(
    name = "aarch64_release",
    deployment = ":cross_release",
    platform = ":linux_aarch64",
)

# keep
rust_test(
    name = "cross_archive_test",
    size = "small",
    srcs = ["cross_archive_test.rs"],
    data = [":aarch64_release"],
    env = {"DX_RELEASE_FILES": "$(rootpaths :aarch64_release)"},
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = ["//tools/testing:dx_testing"],
)

rustfmt_test(
    name = "cross_archive_fmt_test",
    size = "small",
    targets = [":cross_archive_test"],
)

rust_clippy_test(
    name = "cross_archive_clippy_test",
    size = "small",
    targets = [":cross_archive_test"],
)
