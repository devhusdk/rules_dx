load("@crates//:crates.bzl", "aliases")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//deploy/private:archive.bzl", "archive_deploy")
load("//rust:defs.bzl", "rust_test")
load(":cell_test.bzl", "aarch64_link_test")
load(":defs.bzl", "cross_deployment")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

cc_binary(
    name = "cross_app",
    srcs = ["cross_app.c"],
    target_compatible_with = ["@platforms//os:linux"],
)

aarch64_link_test(
    name = "cross_app_link_test",
    target_under_test = ":cross_app",
)

archive_deploy(
    name = "cross_release",
    testonly = True,
    app = ":cross_app",
)

cross_deployment(
    name = "aarch64_release",
    deployment = ":cross_release",
    platform = "//appimage:linux_arm64",
)

rust_test(
    name = "cross_archive_test",
    testonly = True,
    srcs = ["cross_archive_test.rs"],
    aliases = aliases(
        package_name = "deploy/tests/deploy_cross_tests",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "cross_archive_test",
    crate_root = "cross_archive_test.rs",
    data = [":aarch64_release"],
    env = {"DX_RELEASE_FILES": "$(rootpaths :aarch64_release)"},
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = ["//tools/testing:dx_testing"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "cell_test.bzl",
        "defs.bzl",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    testonly = True,
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
