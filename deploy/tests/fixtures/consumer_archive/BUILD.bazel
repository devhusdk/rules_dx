load("//cc/rules:defs.bzl", "cc_library")
load("//deploy/rules:archive.bzl", "consumer_archive")
load("//deploy/rules:resources.bzl", "dx_resources")
load("//libs/starlark:defs.bzl", "starlark_test")
load("//libs/starlark:failure_test.bzl", "failure_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_test", "rustfmt_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

cc_library(
    name = "greet",
    srcs = ["greet.cc"],
    hdrs = ["greet.h"],
    copts = ["-std=c++17"],
)

# keep
rust_binary(
    name = "consumer_app",
    srcs = ["app.rs"],
    crate_name = "consumer_app",
    edition = "2021",
    link_deps = [":greet"],
)

dx_resources(
    name = "consumer_res",
    mappings = {"@consumer_resources//:banner.txt": "banner.txt"},
)

filegroup(
    name = "consumer_notice_files",
    srcs = ["NOTICE.txt"],
)

filegroup(
    name = "consumer_empty_files",
    srcs = [],
    tags = ["manual"],
)

consumer_archive(
    name = "consumer_release",
    app = ":consumer_app",
    arch = select({
        "@platforms//cpu:arm64": "aarch64",
        "@platforms//cpu:x86_64": "x86_64",
    }),
    min_runtime = "glibc-2.17",
    notice = ":consumer_notice_files",
    os = "linux",
    resources = [":consumer_res"],
)

# keep
rust_test(
    name = "consumer_release_verify",
    srcs = ["verify.rs"],
    data = [
        ":consumer_release_archive",
        ":consumer_release_checksum",
    ],
    env = {
        "DX_ARCHIVE_APP": "consumer_app",
        "DX_ARCHIVE_BANNER": "dx-consumer-shared-marker",
        "DX_ARCHIVE_CHECKSUM": "$(rootpath :consumer_release_checksum)",
        "DX_ARCHIVE_GREETING": "Hello from the consumer native library, consumer",
        "DX_ARCHIVE_NOTICE": "consumer-release NOTICE",
        "DX_ARCHIVE_TARBALL": "$(rootpath :consumer_release_archive)",
    },
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["//tools/testing:dx_testing"],
)

consumer_archive(
    name = "consumer_release_zip",
    app = ":consumer_app",
    arch = select({
        "@platforms//cpu:arm64": "aarch64",
        "@platforms//cpu:x86_64": "x86_64",
    }),
    format = "zip",
    min_runtime = "glibc-2.17",
    notice = ":consumer_notice_files",
    os = "linux",
    resources = [":consumer_res"],
)

# keep
rust_test(
    name = "consumer_release_zip_verify",
    srcs = ["zip_verify.rs"],
    crate_name = "consumer_release_zip_verify",
    data = [
        ":consumer_release_zip_archive",
        ":consumer_release_zip_checksum",
    ],
    env = {
        "DX_ARCHIVE": "$(rootpath :consumer_release_zip_archive)",
        "DX_ARCHIVE_APP": "consumer_app",
        "DX_ARCHIVE_CHECKSUM": "$(rootpath :consumer_release_zip_checksum)",
        "DX_ARCHIVE_MEMBERS": "IDENTITY.txt,NOTICE,consumer_app,resources/banner.txt",
        "DX_ARCHIVE_RUNTIME": "",
        "DX_ARCHIVE_SUFFIX": "zip",
    },
    deps = [
        "//cli/digest:dx_digest",
        "//deploy/rules:dx_deploy_tools",
        "//tools/testing:dx_testing",
    ],
)

consumer_archive(
    name = "consumer_runtime_release",
    app = ":consumer_app",
    arch = select({
        "@platforms//cpu:arm64": "aarch64",
        "@platforms//cpu:x86_64": "x86_64",
    }),
    min_runtime = "glibc-2.17",
    notice = ":consumer_notice_files",
    os = "linux",
    runtime = ["consumer_runtime.txt"],
)

# keep
rust_test(
    name = "consumer_runtime_release_verify",
    srcs = ["zip_verify.rs"],
    crate_name = "consumer_runtime_release_verify",
    data = [
        ":consumer_runtime_release_archive",
        ":consumer_runtime_release_checksum",
    ],
    env = {
        "DX_ARCHIVE": "$(rootpath :consumer_runtime_release_archive)",
        "DX_ARCHIVE_APP": "consumer_app",
        "DX_ARCHIVE_CHECKSUM": "$(rootpath :consumer_runtime_release_checksum)",
        "DX_ARCHIVE_MEMBERS": "IDENTITY.txt,NOTICE,consumer_app,consumer_runtime.txt",
        "DX_ARCHIVE_RUNTIME": "consumer_runtime.txt",
        "DX_ARCHIVE_SUFFIX": "tar.gz",
    },
    deps = [
        "//cli/digest:dx_digest",
        "//deploy/rules:dx_deploy_tools",
        "//tools/testing:dx_testing",
    ],
)

starlark_test(
    name = "consumer_notice_reads",
    testonly = True,
    file_checks = {":consumer_notice_files": "consumer-release NOTICE"},
    mode = "execution",
)

dx_resources(
    name = "external_res",
    mappings = {"@consumer_archive_repo//:banner.txt": "banner.txt"},
)

filegroup(
    name = "external_notice_files",
    srcs = ["@consumer_archive_repo//:NOTICE.txt"],
)

consumer_archive(
    name = "external_release",
    app = "@consumer_archive_repo//:external_app",
    arch = select({
        "@platforms//cpu:arm64": "aarch64",
        "@platforms//cpu:x86_64": "x86_64",
    }),
    min_runtime = "glibc-2.17",
    notice = ":external_notice_files",
    os = "linux",
    resources = [":external_res"],
)

# keep
rust_test(
    name = "external_release_verify",
    srcs = ["verify.rs"],
    data = [
        ":external_release_archive",
        ":external_release_checksum",
    ],
    env = {
        "DX_ARCHIVE_APP": "external_app",
        "DX_ARCHIVE_BANNER": "dx-external-archive-marker",
        "DX_ARCHIVE_CHECKSUM": "$(rootpath :external_release_checksum)",
        "DX_ARCHIVE_GREETING": "Hello from the external native library, external",
        "DX_ARCHIVE_NOTICE": "external-release NOTICE",
        "DX_ARCHIVE_TARBALL": "$(rootpath :external_release_archive)",
    },
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["//tools/testing:dx_testing"],
