failure_test(
    name = "consumer_bad_arch_fails",
    expected_failure_substring = "unsupported arch",
    target = ":consumer_bad_arch_stage",
)

failure_test(
    name = "consumer_bad_os_fails",
    expected_failure_substring = "unsupported os",
    target = ":consumer_bad_os_stage",
)

failure_test(
    name = "consumer_bad_linkage_fails",
    expected_failure_substring = "unsupported linkage",
    target = ":consumer_bad_linkage_stage",
)

failure_test(
    name = "consumer_bad_format_fails",
    expected_failure_substring = "unsupported format 'rar'",
    target = ":consumer_bad_format_stage",
)

failure_test(
    name = "consumer_runtime_clash_fails",
    expected_failure_substring = "duplicate member 'consumer_app' from runtime",
    target = ":consumer_runtime_clash_stage",
)

failure_test(
    name = "consumer_no_notice_fails",
    expected_failure_substring = "need a license-words file",
    target = ":consumer_no_notice_stage",
)

failure_test(
    name = "consumer_empty_resources_fails",
    expected_failure_substring = "provides no files",
    target = ":consumer_empty_resources_stage",
)

failure_test(
    name = "consumer_stray_resources_fails",
    expected_failure_substring = "cannot map",
    target = ":consumer_stray_resources_stage",
)

failure_test(
    name = "consumer_two_notices_fails",
    expected_failure_substring = "must provide exactly one file",
    target = ":consumer_two_notices_stage",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "repos.bzl",
    ],
    tags = ["corpus"],
)

dx_resources(
    name = "long_path_res",
    mappings = {
        "@consumer_resources//:banner.txt": "textures/textures/textures/textures/textures/textures/textures/textures/textures/textures/icon.png",
    },
)

consumer_archive(
    name = "long_path_release",
    app = ":consumer_app",
    arch = select({
        "@platforms//cpu:arm64": "aarch64",
        "@platforms//cpu:x86_64": "x86_64",
    }),
    min_runtime = "glibc-2.17",
    notice = ":consumer_notice_files",
    os = "linux",
    resources = [":long_path_res"],
)

rust_test(
    name = "long_path_release_verify",
    srcs = ["long_path_verify.rs"],
    data = [":long_path_release_archive"],
    env = {
        "DX_LONG_TARBALL": "$(rootpath :long_path_release_archive)",
    },
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["//tools/testing:dx_testing"],
)

rustfmt_test(
    name = "consumer_archive_fmt_test",
    size = "small",
    targets = [
        ":consumer_app",
        ":consumer_release_zip_verify",
        ":consumer_runtime_release_verify",
    ],
)

rustfmt_test(
    name = "consumer_archive_linux_fmt_test",
    size = "small",
    targets = [
        ":consumer_release_verify",
        ":external_release_verify",
        ":long_path_release_verify",
        ":repo_release_verify",
    ],
)
