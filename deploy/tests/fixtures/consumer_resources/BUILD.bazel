load("@rules_dx//deploy:defs.bzl", "dx_resources")
load("@rules_dx//core:defs.bzl", "starlark_test")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

genrule(
    name = "consumer_generated",
    outs = ["consumer_sprite.bin"],
    cmd = "printf 'dx-consumer-shared-marker\\ngenerated-v1\\n' > $@",
)

dx_resources(
    name = "consumer_plain",
    mappings = {
        "@consumer_resources//:banner.txt": "banner.txt",
        ":consumer_generated": "generated/sprite.bin",
    },
)

dx_resources(
    name = "consumer_processed",
    mappings = {
        ":consumer_generated": "generated/sprite.bin",
    },
    processor = "@consumer_resources//:processor",
    processor_args = ["--consumer-stamp"],
    target_compatible_with = ["@platforms//os:linux"],
)

starlark_test(
    name = "consumer_analysis",
    mode = "analysis",
    subjects = [":consumer_plain"],
    expected_observations = """subject //deploy/tests/fixtures/consumer_resources:consumer_plain
file banner.txt
file sprite.bin
field count=2
field paths=banner.txt,generated/sprite.bin
field processor=
aspect_field aspect_seen=True
aspect_field field_count=3
aspect_field has_subject=True
aspect_field subject_label=//deploy/tests/fixtures/consumer_resources:consumer_plain
aspect_field transitive_count=0""",
)

starlark_test(
    name = "consumer_plain_reads",
    testonly = True,
    file_checks = {
        ":consumer_plain": "dx-consumer-shared-marker",
    },
    mode = "execution",
)

starlark_test(
    name = "consumer_processed_reads",
    file_checks = {
        ":consumer_processed": "FOOTER-dx-consumer-v1\ngenerated-v1",
    },
    mode = "execution",
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "repos.bzl",
    ],
    tags = ["corpus"],
)
