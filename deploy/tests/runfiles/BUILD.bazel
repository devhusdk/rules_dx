load("//deploy/rules:github.bzl", "github_deploy")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")
load("//tools/testing:child_runfiles.bzl", "child_runfiles")
load("//tools/testing:nested_bazel.bzl", "NESTED_BAZEL_COMPATIBLE_WITH", "NESTED_BAZEL_DATA", "NESTED_BAZEL_ENV", "NESTED_BAZEL_ENV_INHERIT", "NESTED_BAZEL_TAGS")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

filegroup(
    name = "external_notice",
    srcs = ["@consumer_archive_repo//:NOTICE.txt"],
)

github_deploy(
    name = "identity_github",
    artifacts = [
        ":external_notice",
        "//deploy/rules:release_demo_archive",
    ],
)

child_runfiles(
    name = "archive_child",
    binary = "//deploy/rules:release_demo",
)

child_runfiles(
    name = "github_child",
    binary = ":identity_github",
)

# keep
rust_test(
    name = "deploy_runfiles_test",
    size = "small",
    srcs = ["deploy_runfiles_test.rs"],
    data = [
        ":archive_child",
        ":github_child",
        ":identity_github",
        ":identity_github_config",
        "//deploy/rules:release_demo",
        "//deploy/rules:release_demo_app_name",
        "//deploy/rules:release_demo_archive",
        "//deploy/rules:release_demo_checksum",
        "//deploy/rules:release_demo_config",
        "@consumer_archive_repo//:NOTICE.txt",
    ],
    env = {
        "DX_APP": "$(rootpath //deploy/rules:release_demo_app_name)",
        "DX_ARCHIVE_CONFIG": "$(rootpath //deploy/rules:release_demo_config)",
        "DX_ARCHIVE_PROGRAM": "$(rootpath //deploy/rules:release_demo)",
        "DX_CHECKSUM": "$(rootpath //deploy/rules:release_demo_checksum)",
        "DX_GITHUB_CONFIG": "$(rootpath :identity_github_config)",
        "DX_GITHUB_PROGRAM": "$(rootpath :identity_github)",
        "DX_NOTICE": "$(rootpath @consumer_archive_repo//:NOTICE.txt)",
        "DX_TARBALL": "$(rootpath //deploy/rules:release_demo_archive)",
    },
    tags = ["no-remote-exec"],
    deps = [
        "//cli/path:dx_path",
        "//tools/testing:dx_testing",
    ],
)

rustfmt_test(
    name = "deploy_runfiles_fmt_test",
    size = "small",
    targets = [":deploy_runfiles_test"],
)

rust_clippy_test(
    name = "deploy_runfiles_clippy_test",
    size = "small",
    targets = [":deploy_runfiles_test"],
)

# keep
rust_test(
    name = "renamed_consumer_test",
    size = "enormous",
    srcs = ["renamed_consumer_test.rs"],
    data = [
        "//cli/cli:dx",
        "//deploy:module_srcs",
        "//tools/bazelrc:preset",
    ] + NESTED_BAZEL_DATA,
    env = {
        "DX_BIN": "$(rootpath //cli/cli:dx)",
        "RUST_TEST_THREADS": "1",
    } | NESTED_BAZEL_ENV,
    env_inherit = NESTED_BAZEL_ENV_INHERIT,
    tags = NESTED_BAZEL_TAGS,
    target_compatible_with = NESTED_BAZEL_COMPATIBLE_WITH,
    deps = [
        "//cli/digest:dx_digest",
        "//tools/testing:dx_nested",
        "//tools/testing:dx_testing",
    ],
)

rustfmt_test(
    name = "renamed_consumer_fmt_test",
    size = "small",
    targets = [":renamed_consumer_test"],
)

rust_clippy_test(
    name = "renamed_consumer_clippy_test",
    size = "small",
    targets = [":renamed_consumer_test"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
