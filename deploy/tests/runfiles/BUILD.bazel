load("@crates//:crates.bzl", "aliases")
load("//deploy/private:github.bzl", "github_deploy")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")
load("//tools/testing:child_runfiles.bzl", "child_runfiles")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

filegroup(
    name = "external_notice",
    srcs = ["@consumer_archive_repo//:NOTICE.txt"],
)

github_deploy(
    name = "identity_github",
    testonly = True,
    artifacts = [
        ":external_notice",
        "//deploy/private:release_demo_archive",
    ],
)

child_runfiles(
    name = "archive_child",
    binary = "//deploy/private:release_demo",
)

child_runfiles(
    name = "github_child",
    binary = ":identity_github",
)

rust_test(
    name = "deploy_runfiles_test",
    testonly = True,
    srcs = ["deploy_runfiles_test.rs"],
    aliases = aliases(
        package_name = "deploy/tests/deploy_runfiles_tests",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "deploy_runfiles_test",
    crate_root = "deploy_runfiles_test.rs",
    data = [
        ":archive_child",
        ":github_child",
        ":identity_github",
        ":identity_github_config",
        "//deploy/private:release_demo",
        "//deploy/private:release_demo_app_name",
        "//deploy/private:release_demo_archive",
        "//deploy/private:release_demo_checksum",
        "//deploy/private:release_demo_config",
        "@consumer_archive_repo//:NOTICE.txt",
    ],
    env = {
        "DX_APP": "$(rootpath //deploy/private:release_demo_app_name)",
        "DX_ARCHIVE_CONFIG": "$(rootpath //deploy/private:release_demo_config)",
        "DX_ARCHIVE_PROGRAM": "$(rootpath //deploy/private:release_demo)",
        "DX_CHECKSUM": "$(rootpath //deploy/private:release_demo_checksum)",
        "DX_GITHUB_CONFIG": "$(rootpath :identity_github_config)",
        "DX_GITHUB_PROGRAM": "$(rootpath :identity_github)",
        "DX_NOTICE": "$(rootpath @consumer_archive_repo//:NOTICE.txt)",
        "DX_TARBALL": "$(rootpath //deploy/private:release_demo_archive)",
    },
    tags = ["no-remote-exec"],
    deps = [
        "//cli/path:dx_path",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    testonly = True,
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
