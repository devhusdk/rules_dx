load("//deploy/rules:github.bzl", "github_deploy")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")
load("//tools/testing:child_runfiles.bzl", "child_runfiles")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

filegroup(
    name = "external_notice",
    srcs = ["@consumer_archive_repo//:NOTICE.txt"],
)

github_deploy(
    name = "identity_github",
    artifacts = [
        ":external_notice",
        "//deploy/rules:release_demo_archive",
    ],
)

child_runfiles(
    name = "archive_child",
    binary = "//deploy/rules:release_demo_program",
)

child_runfiles(
    name = "github_child",
    binary = ":identity_github_program",
)

rust_test(
    name = "deploy_runfiles_test",
    size = "small",
    srcs = ["deploy_runfiles_test.rs"],
    data = [
        ":archive_child",
        ":github_child",
        ":identity_github_program",
        "//deploy/rules:release_demo_archive",
        "//deploy/rules:release_demo_checksum",
        "//deploy/rules:release_demo_program",
        "//deploy/rules:release_demo_stage",
        "@consumer_archive_repo//:NOTICE.txt",
    ],
    env = {
        "DX_APP": "$(rootpath //deploy/rules:release_demo_stage)",
        "DX_ARCHIVE_PROGRAM": "$(rootpath //deploy/rules:release_demo_program)",
        "DX_CHECKSUM": "$(rootpath //deploy/rules:release_demo_checksum)",
        "DX_GITHUB_PROGRAM": "$(rootpath :identity_github_program)",
        "DX_NOTICE": "$(rootpath @consumer_archive_repo//:NOTICE.txt)",
        "DX_TARBALL": "$(rootpath //deploy/rules:release_demo_archive)",
    },
    deps = [
        "//cli/path:dx_path",
        "//tools/testing:dx_testing",
    ],
)

rustfmt_test(
    name = "deploy_runfiles_fmt_test",
    size = "small",
    targets = [":deploy_runfiles_test"],
)

rust_clippy_test(
    name = "deploy_runfiles_clippy_test",
    size = "small",
    targets = [":deploy_runfiles_test"],
)

rust_test(
    name = "renamed_consumer_test",
    size = "enormous",
    srcs = ["renamed_consumer_test.rs"],
    data = [
        "renamed_consumer_test.rs",
        "//cli/cli:dx",
    ],
    env = {
        "DX_BIN": "$(rootpath //cli/cli:dx)",
        "RUST_TEST_THREADS": "1",
    },
    env_inherit = [
        "HOME",
        "PATH",
    ],
    tags = [
        "exclusive",
        "local",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//cli/digest:dx_digest",
        "//tools/testing:dx_testing",
    ],
)

rustfmt_test(
    name = "renamed_consumer_fmt_test",
    size = "small",
    targets = [":renamed_consumer_test"],
)

rust_clippy_test(
    name = "renamed_consumer_clippy_test",
    size = "small",
    targets = [":renamed_consumer_test"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
