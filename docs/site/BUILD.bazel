load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_test")
load(":render.bzl", "mdbook_book", "mdbook_check")
load(":site.bzl", "docs_aggregate", "docs_extract", "docs_site")
load(":site_tests.bzl", "site_file_tests", "site_unit_tests", "site_user_file_tests")
load(":user/book.bzl", "USER_BOOK")

package(default_visibility = ["//:__subpackages__"])

exports_files(
    [
        "BUILD.bazel",
        "render.bzl",
        "site.bzl",
        "site_tests.bzl",
        "user/book.bzl",
    ],
)

exports_files(
    [
        "demo/demo.symbols.txt",
        "demo/demo_prose.md",
        "demo/book.toml",
        "demo/guide.md",
        "demo/guide_steps.txt",
    ],
    visibility = ["//visibility:private"],
)

docs_extract(
    name = "demo_extract",
    srcs = ["demo/demo.symbols.txt"],
    language = "python",
    package = "demo",
)

docs_aggregate(
    name = "demo_aggregate",
    book_toml = "demo/book.toml",
    prose = ["demo/demo_prose.md"],
    shards = [":demo_extract"],
)

docs_site(
    name = "demo_site",
    srcs = ["demo/demo.symbols.txt"],
    book_toml = "demo/book.toml",
    language = "python",
    package = "demo",
    prose = ["demo/demo_prose.md"],
)

mdbook_book(
    name = "user_site",
    book_toml = "user/book.toml",
    chapters = USER_BOOK,
)

mdbook_check(
    name = "user_site_check",
    chapters = USER_BOOK,
)

exports_files(
    [
        "browser_test.rs",
        "serve_test.rs",
    ],
)

# keep
rust_test(
    name = "browser_test",
    size = "large",
    srcs = ["browser_test.rs"],
    data = [
        ":user_site",
        "//docs/site/browser:firefox",
        "//docs/site/browser:firefox_tree",
    ],
    env = {
        "DX_FIREFOX": "$(rootpath //docs/site/browser:firefox)",
        "DX_USER_SITE": "$(rootpath :user_site)",
    },
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//docs/site/browser:dx_site_browser",
        "//tools/testing:dx_testing",
    ],
)

# keep
rust_test(
    name = "deploy_smoke_test",
    size = "large",
    srcs = ["deploy_smoke_test.rs"],
    data = [
        ":user_site",
        "//docs/site/browser:firefox",
        "//docs/site/browser:firefox_tree",
    ],
    env = {
        "DX_FIREFOX": "$(rootpath //docs/site/browser:firefox)",
        "DX_USER_SITE": "$(rootpath :user_site)",
    },
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//docs/site/browser:dx_site_browser",
        "//tools/testing:dx_testing",
    ],
)

# keep
rust_test(
    name = "serve_test",
    size = "small",
    srcs = ["serve_test.rs"],
    data = [":user_site"],
    env = {"DX_USER_SITE": "$(rootpath :user_site)"},
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["//tools/testing:dx_testing"],
)

# keep
rust_test(
    name = "rendered_site_test",
    size = "small",
    srcs = ["rendered_site_test.rs"],
    data = [
        ":demo_site",
        ":user_site",
        "//docs/site/check:site_check",
    ],
    env = {
        "DX_DEMO_SITE": "$(rootpath :demo_site)",
        "DX_SITE_CHECK": "$(rootpath //docs/site/check:site_check)",
        "DX_USER_SITE": "$(rootpath :user_site)",
    },
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["//tools/testing:dx_testing"],
)

# keep
rust_test(
    name = "site_check_test",
    size = "small",
    srcs = ["site_check_test.rs"],
    data = ["//docs/site/check:site_check"],
    env = {"DX_SITE_CHECK": "$(rootpath //docs/site/check:site_check)"},
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["//tools/testing:dx_testing"],
)

site_unit_tests(name = "site_unit")

site_file_tests(
    name = "site_files",
    api = ":demo_aggregate_api.md",
    records = ":demo_aggregate_search_records.json",
    shard = ":demo_extract.ir.textproto",
    summary = ":demo_aggregate_SUMMARY.md",
)

site_user_file_tests(
    name = "site_user_files",
    index = ":user_site_index.md",
    summary = ":user_site_SUMMARY.md",
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "render.bzl",
        "site.bzl",
        "site_tests.bzl",
        "user/book.bzl",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["//quality:corpus_vale_config"],
    markdown_srcs = [
        "demo/demo_prose.md",
        "demo/guide.md",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = [
        "demo/book.toml",
        "user/book.toml",
    ],
