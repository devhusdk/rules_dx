# keep
rust_test(
    name = "site_check_test",
    size = "small",
    srcs = ["site_check_test.rs"],
    data = ["//docs/site/check:site_check"],
    env = {"DX_SITE_CHECK": "$(rootpath //docs/site/check:site_check)"},
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["//tools/testing:dx_testing"],
)

