load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_test")
load(":site.bzl", "docs_aggregate", "docs_extract", "docs_render", "docs_site", "docs_user_site")
load(":site_tests.bzl", "site_file_tests", "site_unit_tests", "site_user_file_tests")

package(default_visibility = ["//:__subpackages__"])

exports_files(
    [
        "BUILD.bazel",
        "site.bzl",
        "site_tests.bzl",
    ],
)

exports_files(
    [
        "demo/demo.symbols.txt",
        "demo/demo_prose.md",
        "demo/book.toml",
        "demo/guide.md",
        "demo/guide_steps.txt",
        "user/book.toml",
    ],
    visibility = ["//visibility:private"],
)

docs_extract(
    name = "demo_extract",
    srcs = ["demo/demo.symbols.txt"],
    language = "python",
    package = "demo",
)

docs_aggregate(
    name = "demo_aggregate",
    book_toml = "demo/book.toml",
    prose = ["demo/demo_prose.md"],
    shards = [":demo_extract"],
)

docs_render(
    name = "demo_render",
    api = ":demo_aggregate_api.md",
    book_toml = "demo/book.toml",
    records = ":demo_aggregate_search_records.json",
    summary = ":demo_aggregate_SUMMARY.md",
)

docs_site(
    name = "demo_site",
    srcs = ["demo/demo.symbols.txt"],
    book_toml = "demo/book.toml",
    language = "python",
    package = "demo",
    prose = ["demo/demo_prose.md"],
)

