load("@crates//:crates.bzl", "aliases", "crate_deps")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust/rules:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("@rules_dx//tools/visibility:visibility.bzl", "VIS_PUBLIC")

package(default_visibility = VIS_PUBLIC)

exports_files([
    "Cargo.toml",
    "src/lib.rs",
    "src/lib_tests.rs",
    "src/main.rs",
])

rust_library(
    name = "dx_site_build",
    srcs = [
        "src/lib.rs",
        "src/lib_tests.rs",
    ],
    aliases = aliases(
        package_name = "docs/site/site_build",
        normal = True,
    ),
    crate_name = "dx_site_build",
    crate_root = "src/lib.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = crate_deps(
        [],
        package_name = "docs/site/site_build",
    ),
)

rust_test(
    name = "dx_site_build_test",
    aliases = aliases(
        package_name = "docs/site/site_build",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_site_build",
    deps = crate_deps(
        [],
        package_name = "docs/site/site_build",
    ),
)

rust_binary(
    name = "site_build",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "docs/site/site_build",
        normal = True,
    ),
    crate_name = "site_build",
    crate_root = "src/main.rs",
    edition = "2021",
    deps = crate_deps(
        [],
        package_name = "docs/site/site_build",
    ) + [":dx_site_build"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
