load("@crates//:crates.bzl", "aliases", "crate_deps")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_library")
load("//tools/visibility:visibility.bzl", "VIS_PUBLIC")

package(default_visibility = VIS_PUBLIC)

exports_files([
    "Cargo.toml",
    "src/lib.rs",
    "src/main.rs",
])

rust_library(
    name = "dx_site_check",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "docs/site/site_check",
        normal = True,
    ),
    crate_name = "dx_site_check",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = crate_deps(
        [],
        package_name = "docs/site/site_check",
    ),
)

rust_binary(
    name = "site_check",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "docs/site/site_check",
        normal = True,
    ),
    crate_name = "site_check",
    crate_root = "src/main.rs",
    edition = "2021",
    deps = crate_deps(
        [],
        package_name = "docs/site/site_check",
    ) + [":dx_site_check"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
