{
  "$schema": "../core/modules/lang.schema.json",
  "name": "dotnet",
  "title": "dotnet",
  "family": "core",
  "ecosystems": [
    "nuget"
  ],
  "manifests": [
    "paket.dependencies"
  ],
  "lockfiles": [
    "paket.lock"
  ],
  "tools": [],
  "platforms": [],
  "pins": [],
  "entry_points": [],
  "quality": {
    "bzl": "core/quality:families/dotnet.bzl",
    "file_extensions": [
      ".cs",
      ".csproj",
      ".fs",
      ".fsproj",
      ".fsx"
    ],
    "aspects": {
      "format": [
        "real_dotnet_format_aspect"
      ],
      "lint": [
        "real_dotnet_lint_aspect"
      ],
      "typecheck": [
        "real_dotnet_typecheck_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_dotnet_format_probe_aspect"
      ],
      "lint": [
        "real_dotnet_lint_probe_aspect"
      ],
      "typecheck": [
        "real_dotnet_typecheck_probe_aspect"
      ]
    }
  },
  "docs": {
    "bzl": "tools/docs/dotnet:aspect.bzl",
    "file_extensions": [
      ".cs",
      ".fs"
    ],
    "aspects": [
      "real_dotnet_docs_aspect"
    ]
  }
}
