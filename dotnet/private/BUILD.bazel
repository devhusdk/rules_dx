load("//core/quality:fixtures.bzl", "real_source_target")

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "benchmarkdotnet.bzl",
        "sharpfuzz.bzl",
        "sharpfuzz_check.bzl",
        "symbols.bzl",
        "libfuzzer_dotnet.BUILD.bazel",
    ],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

exports_files([
    "benchmarkdotnet.bzl",
    "libfuzzer_dotnet.BUILD.bazel",
    "sharpfuzz.bzl",
    "sharpfuzz_check.bzl",
    "symbols.bzl",
])

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
        "libfuzzer_dotnet.BUILD.bazel",
    ]),
    visibility = ["//:__subpackages__"],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "macos_x86_64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "windows_arm64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "windows_x86_64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

alias(
    name = "target_runtime",
    actual = select({
        ":linux_arm64": "@dx_dotnet_arm64-unknown-linux-gnu//:runtime",
        ":linux_x86_64": "@dx_dotnet_x86_64-unknown-linux-gnu//:runtime",
        ":macos_arm64": "@dx_dotnet_aarch64-apple-darwin//:runtime",
        ":macos_x86_64": "@dx_dotnet_x86_64-apple-darwin//:runtime",
        ":windows_arm64": "@dx_dotnet_arm64-pc-windows-msvc//:runtime",
        ":windows_x86_64": "@dx_dotnet_x86_64-pc-windows-msvc//:runtime",
    }),
    visibility = ["//visibility:public"],
)
