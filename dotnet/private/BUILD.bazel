load("//core/modules:versions.bzl", "DOTNET_VERSION")
load("//core/quality:fixtures.bzl", "real_source_target")

_SDK = "@dotnet_sdk." + DOTNET_VERSION + "_"

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "benchmarkdotnet.bzl",
        "sharpfuzz.bzl",
        "sharpfuzz_check.bzl",
        "symbols.bzl",
        "libfuzzer_dotnet.BUILD.bazel",
    ],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

exports_files([
    "benchmarkdotnet.bzl",
    "libfuzzer_dotnet.BUILD.bazel",
    "sharpfuzz.bzl",
    "sharpfuzz_check.bzl",
    "symbols.bzl",
])

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
        "libfuzzer_dotnet.BUILD.bazel",
    ]),
    visibility = ["//:__subpackages__"],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "macos_x86_64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "windows_arm64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "windows_x86_64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

alias(
    name = "target_runtime",
    actual = select({
        ":linux_arm64": _SDK + "arm64-unknown-linux-gnu//:runtime_host",
        ":linux_x86_64": _SDK + "x86_64-unknown-linux-gnu//:runtime_host",
        ":macos_arm64": _SDK + "aarch64-apple-darwin//:runtime_host",
        ":macos_x86_64": _SDK + "x86_64-apple-darwin//:runtime_host",
        ":windows_arm64": _SDK + "arm64-pc-windows-msvc//:runtime_host",
        ":windows_x86_64": _SDK + "x86_64-pc-windows-msvc//:runtime_host",
    }),
    visibility = [
        "//:__subpackages__",
        "@rules_dotnet//dotnet/private/rules:__subpackages__",
    ],
)
