load("@crates//:crates.bzl", "aliases")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")

package(default_visibility = VIS_TOOLS)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "coverage.bzl",
    ],
    tags = ["corpus"],
)

alias(
    name = "coverlet",
    actual = "@nuget//coverlet.console/tools:coverlet",
    visibility = ["//:__subpackages__"],
)

rust_library(
    name = "dx_coverlet",
    srcs = [
        "src/lcov.rs",
        "src/lib.rs",
        "src/plan.rs",
    ],
    aliases = aliases(
        package_name = "dotnet/private/coverlet_launcher",
        normal = True,
    ),
    crate_name = "dx_coverlet",
    crate_root = "src/lib.rs",
    visibility = [
        "//cli/runtime:__pkg__",
        "//dotnet/tests:__pkg__",
    ],
    deps = [],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    [
        "src/lib.rs",
    ],
    visibility = ["//core/quality:__pkg__"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
