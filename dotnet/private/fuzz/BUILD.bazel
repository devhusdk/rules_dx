load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_dx//core:fuzz.bzl", "dx_fuzz_binary")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust:defs.bzl", "rust_binary")

_SUPPORTED = select({
    "@platforms//os:linux": [],
    "@platforms//os:macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

rust_binary(
    name = "instrument",
    srcs = ["instrument/main.rs"],
    crate_name = "instrument",
    crate_root = "instrument/main.rs",
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "libfuzzer_dotnet_bin",
    srcs = ["@dx_libfuzzer_dotnet//:libfuzzer-dotnet.cc"],
    copts = ["-fsanitize=fuzzer"],
    linkopts = ["-fsanitize=fuzzer"],
    linkstatic = select({
        "@platforms//os:macos": False,
        "//conditions:default": True,
    }),
    target_compatible_with = _SUPPORTED,
    testonly = True,
    visibility = ["//visibility:private"],
)

dx_fuzz_binary(
    name = "libfuzzer_dotnet",
    binary = ":libfuzzer_dotnet_bin",
    target_compatible_with = _SUPPORTED,
    testonly = True,
    visibility = ["//visibility:public"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "labels.bzl",
    ],
    tags = ["corpus"],
)
