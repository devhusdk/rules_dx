# The dotnet package of the dx_toolchains hub. Labels resolve as in rules_dx.

toolchain(
    name = "aarch64-apple-darwin_bootstrap_toolchain",
    exec_compatible_with = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
    target_settings = ["@rules_dx//config:toolchains_on"],
    toolchain = "@dotnet_bootstrap_toolchains//:aarch64-apple-darwin",
    toolchain_type = "@rules_dotnet//dotnet/toolchain:bootstrap_toolchain_type",
)

