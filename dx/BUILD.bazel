load("@rules_go//go:def.bzl", "go_binary")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//tools/visibility:visibility.bzl", "VIS_DX_COMMANDS", "VIS_DX_ROOTS")
load(":generate.bzl", "dx_generate")

package(default_visibility = ["//visibility:private"])

dx_generate(
    name = "generate",
    visibility = VIS_DX_COMMANDS,
)

dx_generate(
    name = "generate_check",
    mode = "diff",
    visibility = VIS_DX_COMMANDS,
)

go_binary(
    name = "gazelle_launcher",
    srcs = ["gazelle_launcher.go"],
    pure = "on",
    deps = ["@rules_go//go/runfiles"],
)

filegroup(
    name = "env",
    srcs = [],
    visibility = VIS_DX_ROOTS,
)

filegroup(
    name = "codegen",
    srcs = [],
    visibility = VIS_DX_ROOTS,
)

filegroup(
    name = "module_srcs",
    srcs = [
        "BUILD.bazel",
        "gazelle_launcher.go",
        "generate.bzl",
    ],
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "dx_reaches_tools_probe",
    srcs = ["//tools/visibility:layer_sentinel"],
    tags = ["manual"],
    visibility = ["//tools/visibility:__pkg__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "generate.bzl",
    ],
    tags = ["corpus"],
)
