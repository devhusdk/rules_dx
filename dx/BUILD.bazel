load("//core/quality:fixtures.bzl", "real_source_target")
load("//tools/visibility:visibility.bzl", "VIS_DX_COMMANDS", "VIS_DX_ROOTS")
load(":generate.bzl", "dx_generate")
load(":generate_tests.bzl", "dx_generate_tests")

package(default_visibility = ["//visibility:private"])

exports_files(
    ["BUILD.bazel"],
    visibility = ["//tools/api:__pkg__"],
)

dx_generate(
    name = "generate",
    visibility = VIS_DX_COMMANDS,
)

dx_generate(
    name = "generate_check",
    mode = "diff",
    visibility = VIS_DX_COMMANDS,
)

dx_generate_tests(
    name = "generate_test",
    size = "small",
)

filegroup(
    name = "env",
    srcs = [],
    visibility = VIS_DX_ROOTS,
)

filegroup(
    name = "codegen",
    srcs = [],
    visibility = VIS_DX_ROOTS,
)

filegroup(
    name = "module_srcs",
    srcs = [
        "BUILD.bazel",
        "generate.bzl",
        "generate_tests.bzl",
    ],
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "dx_reaches_tools_probe",
    srcs = ["//tools/visibility:layer_sentinel"],
    tags = ["manual"],
    visibility = ["//tools/visibility:__pkg__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "generate.bzl",
        "generate_tests.bzl",
    ],
    tags = ["corpus"],
)
