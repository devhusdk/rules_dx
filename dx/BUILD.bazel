load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//tools/visibility:visibility.bzl", "VIS_DX_COMMANDS", "VIS_DX_ROOTS")
load(":generate.bzl", "GENERATE_EXCLUDES")

package(default_visibility = ["//visibility:private"])

native_binary(
    name = "generate",
    src = "@dx_gazelle//:gazelle",
    args = ["update"] + GENERATE_EXCLUDES,
    visibility = VIS_DX_COMMANDS,
)

native_binary(
    name = "generate_check",
    src = "@dx_gazelle//:gazelle",
    args = [
        "update",
        "-mode",
        "diff",
    ] + GENERATE_EXCLUDES,
    visibility = VIS_DX_COMMANDS,
)

filegroup(
    name = "env",
    srcs = [],
    visibility = VIS_DX_ROOTS,
)

filegroup(
    name = "codegen",
    srcs = [],
    visibility = VIS_DX_ROOTS,
)

filegroup(
    name = "dx_reaches_tools_probe",
    srcs = ["//tools/visibility:layer_sentinel"],
    tags = ["manual"],
    visibility = ["//tools/visibility:__pkg__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "generate.bzl",
    ],
    tags = ["corpus"],
)
