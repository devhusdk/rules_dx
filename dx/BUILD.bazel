load("@gazelle//:def.bzl", "gazelle")
load("//quality:fixtures.bzl", "real_source_target")
load("//tools/visibility:visibility.bzl", "VIS_DX_COMMANDS", "VIS_DX_ROOTS")

package(default_visibility = ["//visibility:private"])

# dx's own config tree and installed packages are never generated.
GENERATE_EXCLUDES = [
    "-exclude=.dx",
    "-exclude=**/node_modules",
]

gazelle(
    name = "generate",
    args = GENERATE_EXCLUDES,
    gazelle = "@dx_gazelle//:gazelle",
    visibility = VIS_DX_COMMANDS,
)

gazelle(
    name = "generate_check",
    args = GENERATE_EXCLUDES,
    gazelle = "@dx_gazelle//:gazelle",
    mode = "diff",
    visibility = VIS_DX_COMMANDS,
)

filegroup(
    name = "env",
    srcs = [],
    visibility = VIS_DX_ROOTS,
)

filegroup(
    name = "codegen",
    srcs = [],
    visibility = VIS_DX_ROOTS,
)

filegroup(
    name = "dx_reaches_tools_probe",
    srcs = ["//tools/visibility:layer_sentinel"],
    tags = ["manual"],
    visibility = ["//tools/visibility:__pkg__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
