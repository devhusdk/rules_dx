load("@crates//:crates.bzl", "aliases")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_test")

# Maintainer runnable: `bazel run @rules_dx//dx/advisory_prep`. It lives under
# dx/ so the public label set holds only what users build; the library stays
# in //cli/advisory_prep because the CLI links it.
package(default_visibility = ["//visibility:private"])

exports_files(
    ["BUILD.bazel"],
    visibility = ["//tools/api:__pkg__"],
)

rust_binary(
    name = "advisory_prep",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "dx/advisory_prep",
        normal = True,
    ),
    crate_name = "advisory_prep",
    crate_root = "src/main.rs",
    data = [
        ":trivy",
        "//perl/private/tools:cpansa_dump",
    ],
    env = {
        "DX_CPANSA_DUMP": "$(rlocationpath //perl/private/tools:cpansa_dump)",
        "DX_TRIVY": "$(rlocationpath :trivy)",
    },
    # keep
    deps = [
        "//cli/advisory_prep:dx_advisory_prep",
        "//cli/audit:dx_audit",
        "//cli/error:dx_error",
        "@crates//:chrono",
        "@crates//:clap",
    ],
)

alias(
    name = "trivy",
    actual = "@dx_tools//:trivy",
)

rust_test(
    name = "advisory_prep_bin_test",
    size = "small",
    srcs = [
        "src/main.rs",
        "src/main_tests.rs",
    ],
    aliases = aliases(
        package_name = "dx/advisory_prep",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "advisory_prep",
    crate_root = "src/main.rs",
    # keep
    deps = [
        "//cli/advisory_prep:dx_advisory_prep",
        "//cli/audit:dx_audit",
        "//cli/error:dx_error",
        "@crates//:chrono",
        "@crates//:clap",
        "@crates//:tempfile",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
