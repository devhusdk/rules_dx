{
  "$schema": "../core/modules/lang.schema.json",
  "name": "elixir",
  "title": "Elixir",
  "family": "core",
  "ecosystems": [
    "hex"
  ],
  "depcheck": "elixir",
  "semver": false,
  "manifests": [
    "mix.exs"
  ],
  "lockfiles": [
    "hex.lock.json"
  ],
  "setup": {
    "hubs": [
      {
        "ecosystem": "hex",
        "manifest": "mix.exs",
        "lock": "hex.lock.json",
        "state": "mix.lock",
        "extension": "@rules_dx//elixir:extensions.bzl",
        "tag": "lock",
        "hub": "hex",
        "resolver": "@rules_dx//elixir/private/tools/lock",
        "imports": "provides"
      }
    ]
  },
  "tools": [
    "credo",
    "dialyzer",
    "elixirc",
    "mix_format"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_arm64",
    "windows_x86_64"
  ],
  "pins": [
    "pins.json"
  ],
  "entry_points": [
    "elixir_app",
    "elixir_bench",
    "elixir_escript_archive",
    "elixir_escript_headers",
    "elixir_test"
  ],
  "quality": {
    "bzl": "erlang/private/quality:beam.bzl",
    "file_extensions": [
      ".ex",
      ".exs"
    ],
    "aspects": {
      "format": [
        "real_elixir_format_aspect"
      ],
      "lint": [
        "real_elixir_lint_aspect"
      ]
    }
  },
  "docs": {
    "bzl": "tools/docs/beam:aspect.bzl",
    "file_extensions": [
      ".ex",
      ".exs"
    ],
    "aspects": [
      "real_beam_docs_aspect"
    ]
  }
}
