{
  "$schema": "../core/modules/lang.schema.json",
  "name": "elixir",
  "title": "Elixir",
  "family": "core",
  "ecosystems": [
    "hex"
  ],
  "depcheck": "elixir",
  "semver": false,
  "manifests": [
    "mix.exs"
  ],
  "lockfiles": [
    "mix.lock"
  ],
  "tools": [
    "credo",
    "dialyzer",
    "elixirc",
    "mix_format"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_arm64",
    "windows_x86_64"
  ],
  "pins": [
    "private/toolchain/pins.json"
  ],
  "entry_points": [
    "escript_archive",
    "escript_headers",
    "cover_sources",
    "app_sources",
    "nif_priv",
    "elixir_app",
    "helper_first",
    "elixir_test",
    "elixir_bench"
  ],
  "quality": {
    "bzl": "quality:families/beam.bzl",
    "file_extensions": [
      ".ex",
      ".exs"
    ],
    "aspects": {
      "format": [
        "real_elixir_format_aspect"
      ],
      "lint": [
        "real_elixir_lint_aspect"
      ]
    }
  }
}
