load("@rules_dx//elixir:defs.bzl", "ELIXIR_COMPATIBLE_WITH", "elixir_app", "elixir_test")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")

exports_files(
    glob([
        "lib/**",
        "test/*",
    ]) + [
        "BUILD.bazel",
        "units.txt",
    ],
    visibility = ["//visibility:public"],
)

APPS = ["//elixir/tests/fixtures/elixir-app:__subpackages__"]

genrule(
    name = "units",
    srcs = ["units.txt"],
    outs = ["units.ex"],
    cmd = """
entries=""
while read -r unit size; do
  entries="$$entries, {\\"$$unit\\", $$size}"
done < $<
printf 'defmodule Catalog.Units do\\n  @moduledoc false\\n\\n  def all, do: [%s]\\nend\\n' "$${entries#, }" > $@
""",
)

elixir_app(
    name = "erlang_app",
    srcs = glob(["lib/**/*.ex"]) + [":units"],
    app_description = "Item parsing and JSON ledgers.",
    app_name = "catalog",
    app_version = "1.0.0",
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
    visibility = APPS,
    deps = ["@elixir_app_deps//:jason"],
)

elixir_test(
    name = "catalog_test",
    srcs = [
        "test/catalog_test.exs",
        "test/test_helper.exs",
    ],
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
    deps = [":erlang_app"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//visibility:public"],
)
