load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//elixir:defs.bzl", "elixir_app", "elixir_escript_archive", "elixir_escript_headers", "elixir_test")
load("@rules_dx//elixir/private:defs.bzl", "ELIXIR_COMPATIBLE_WITH")

exports_files(
    glob([
        "lib/**",
        "test/*",
    ]) + ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

elixir_app(
    name = "erlang_app",
    app_description = "Command-line client for the stock ledger.",
    app_name = "stockctl",
    app_version = "1.0.0",
    deps = ["//elixir/tests/fixtures/elixir_app/stock:erlang_app"],
)

elixir_escript_archive(
    name = "stockctl",
    app = ":erlang_app",
    headers = elixir_escript_headers("Stockctl"),
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
)

elixir_test(
    name = "stockctl_test",
    srcs = [
        "test/stockctl_test.exs",
        "test/test_helper.exs",
    ],
    tools = [":stockctl"],
    deps = [":erlang_app"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//visibility:public"],
)
