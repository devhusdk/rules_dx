# gazelle:dx_rust_corpus false

load("@rules_dx//elixir:defs.bzl", "ELIXIR_COMPATIBLE_WITH", "elixir_app")
load("//elixir/tests/negative:negative_tests.bzl", "elixir_compile_test")

elixir_app(
    name = "base_dep",
    srcs = ["lib/base_dep.ex"],
    app_name = "base_dep",
    app_version = "1.0.0",
    tags = ["manual"],
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
)

elixir_app(
    name = "missing_dep",
    srcs = ["lib/needs_dep.ex"],
    app_name = "missing_dep",
    app_version = "1.0.0",
    tags = ["manual"],
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
)

elixir_app(
    name = "declared_dep",
    srcs = ["lib/needs_dep.ex"],
    app_name = "declared_dep",
    app_version = "1.0.0",
    tags = ["manual"],
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
    deps = [":base_dep"],
)

elixir_app(
    name = "strict",
    srcs = ["lib/unused_variable.ex"],
    app_name = "strict",
    app_version = "1.0.0",
    tags = ["manual"],
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
    warnings_as_errors = True,
)

elixir_compile_test(
    name = "undeclared_dep_is_not_an_input_test",
    dep = "base_dep",
    dep_present = False,
    target = ":missing_dep_upstream_beam_files",
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
)

elixir_compile_test(
    name = "declared_dep_is_an_input_test",
    dep = "base_dep",
    dep_present = True,
    target = ":declared_dep_upstream_beam_files",
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
)

elixir_compile_test(
    name = "warnings_are_errors_test",
    flag = "--warnings-as-errors",
    target = ":strict_upstream_beam_files",
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
)
