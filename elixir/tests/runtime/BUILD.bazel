# gazelle:dx_rust_corpus false

load("@rules_dx//elixir:defs.bzl", "elixir_app", "elixir_test")
load("@rules_dx//elixir/private:defs.bzl", "ELIXIR_COMPATIBLE_WITH")
load("@rules_dx//elixir/private/toolchain:pins.bzl", "ELIXIR_VERSION")
load("@rules_dx//elixir/tests:defs_tests.bzl", "elixir_coverage_env_test")
load("@rules_dx//erlang/private/toolchain:pins.bzl", "OTP_RELEASE")
load("@rules_dx//erlang/tests:defs_tests.bzl", "erlang_beam_info_test")

elixir_app(
    name = "erlang_app",
    app_name = "dx_runtime_probe",
    app_version = "1.0.0",
    visibility = ["@rules_dx//core/quality/testdata:__pkg__"],
)

erlang_beam_info_test(
    name = "beam_info_test",
    app_name = "dx_runtime_probe",
    owned = ["ebin"],
    plts = ["elixir_plt.plt"],
    target = ":erlang_app",
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
)

elixir_app(
    name = "test_support",
    testonly = True,
    srcs = ["support/dx_test_support.ex"],
    app_name = "dx_test_support",
    app_version = "1.0.0",
)

elixir_test(
    name = "probe_test",
    srcs = [
        "test/probe_test.exs",
        "test/test_helper.exs",
    ],
    env = {
        "DX_ELIXIR_VERSION": ELIXIR_VERSION,
        "DX_OTP_RELEASE": OTP_RELEASE,
    },
    deps = [
        ":erlang_app",
        ":test_support",
    ],
)

elixir_coverage_env_test(
    name = "probe_coverage_env_test",
    apps = "dx_runtime_probe,dx_test_support",
    sources = "elixir/tests/runtime/lib/dx_runtime_probe.ex,elixir/tests/runtime/support/dx_test_support.ex",
    target = ":probe_test",
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)
