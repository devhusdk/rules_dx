load("//elixir/rules:defs.bzl", "ELIXIR_COMPATIBLE_WITH", "elixir_app", "ex_unit_test")
load("//elixir/rules:wrapper_tests.bzl", "elixir_coverage_env_test")
load("//elixir/toolchain:pins.bzl", "ELIXIR_VERSION")
load("//erlang/rules:wrapper_tests.bzl", "erlang_beam_info_test")
load("//erlang/toolchain:pins.bzl", "OTP_RELEASE")
load("//quality:fixtures.bzl", "real_source_target")

elixir_app(
    app_name = "dx_runtime_probe",
    app_version = "1.0.0",
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
    visibility = ["//quality/testdata:__pkg__"],
)

erlang_beam_info_test(
    name = "beam_info_test",
    app_name = "dx_runtime_probe",
    owned = ["ebin"],
    plts = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["elixir_plt.plt"],
    }),
    target = ":erlang_app",
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
)

elixir_app(
    name = "test_support",
    testonly = True,
    srcs = ["support/dx_test_support.ex"],
    app_name = "dx_test_support",
    app_version = "1.0.0",
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
)

ex_unit_test(
    name = "probe_test",
    srcs = [
        "test/probe_test.exs",
        "test/test_helper.exs",
    ],
    env = {
        "DX_ELIXIR_VERSION": ELIXIR_VERSION,
        "DX_OTP_RELEASE": OTP_RELEASE,
    },
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
    deps = [
        ":erlang_app",
        ":test_support",
    ],
)

elixir_coverage_env_test(
    name = "probe_coverage_env_test",
    apps = "dx_runtime_probe,dx_test_support",
    sources = "elixir/tests/runtime/lib/dx_runtime_probe.ex,elixir/tests/runtime/support/dx_test_support.ex",
    target = ":probe_test",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//tools/docs/support_matrix:__pkg__"],
)
