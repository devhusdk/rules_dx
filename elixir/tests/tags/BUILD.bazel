load("//elixir/rules:defs.bzl", "ELIXIR_COMPATIBLE_WITH", "elixir_app")
load("//libs/starlark:defs.bzl", "starlark_test")
load("//libs/starlark:tag_probe.bzl", "tag_subject")
load("//quality:fixtures.bzl", "real_source_target")

elixir_app(
    name = "tagged",
    app_name = "dx_tags_probe",
    tags = [
        "manual",
        "no-lint",
        "no-remote-exec",
    ],
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
)

elixir_app(
    name = "plain",
    app_name = "dx_plain_probe",
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
)

tag_subject(
    name = "tags_subject",
    targets = [
        ":plain",
        ":plain_upstream",
        ":plain_upstream_app_file",
        ":plain_upstream_beam_files",
        ":plain_upstream_ebin",
        ":plain_upstream_elixir_without_app_overlap",
        ":tagged",
        ":tagged_upstream",
        ":tagged_upstream_app_file",
        ":tagged_upstream_beam_files",
        ":tagged_upstream_ebin",
        ":tagged_upstream_elixir_without_app_overlap",
    ],
)

starlark_test(
    name = "tags_test",
    expected_observations = """subject //elixir/tests/tags:tags_subject
field plain=(none)
field plain_upstream=manual
field plain_upstream_app_file=manual
field plain_upstream_beam_files=manual
field plain_upstream_ebin=manual
field plain_upstream_elixir_without_app_overlap=manual
field tagged=manual,no-lint,no-remote-exec
field tagged_upstream=dx:no-lint,manual,no-remote-exec
field tagged_upstream_app_file=dx:no-lint,manual,no-remote-exec
field tagged_upstream_beam_files=dx:no-lint,manual,no-remote-exec
field tagged_upstream_ebin=dx:no-lint,manual,no-remote-exec
field tagged_upstream_elixir_without_app_overlap=dx:no-lint,manual,no-remote-exec
aspect_field aspect_seen=True
aspect_field field_count=12
aspect_field has_subject=True
aspect_field subject_label=//elixir/tests/tags:tags_subject
aspect_field transitive_count=0
""",
    mode = "analysis",
    subjects = [":tags_subject"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
