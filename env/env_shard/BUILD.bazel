load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_ENV_SHARD")

# gazelle:resolve rust proto //env/proto:plan_proto_rs
# gazelle:resolve rust plan_proto //env/proto:plan_proto_rs

package(default_visibility = VIS_ENV_SHARD)

rust_library(
    name = "env_shard",
    srcs = [
        "src/lib.rs",
        "src/writer.rs",
    ],
    aliases = aliases(
        package_name = "env/env_shard",
        normal = True,
    ),
    crate_name = "env_shard",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "env/env_shard",
        normal = True,
    ) + [
        "//cli/path:dx_path",
        "//env/proto:plan_proto_rs",
        "//libs/shard_writer:dx_shard_writer",
        "@rules_rust_prost//private/3rdparty/crates:prost",
    ],
)

rust_binary(
    name = "env_shard_writer",
    srcs = ["src/main.rs"],
    crate_name = "env_shard_writer",
    crate_root = "src/main.rs",
    visibility = ["//visibility:public"],
    deps = [":env_shard"],
)

rust_test(
    name = "env_shard_test",
    aliases = aliases(
        package_name = "env/env_shard",
        normal = True,
        normal_dev = True,
    ),
    crate = ":env_shard",
    deps = all_crate_deps(
        package_name = "env/env_shard",
        normal = True,
        normal_dev = True,
    ) + [
        "//env/proto:plan_proto_rs",
        "@rules_rust_prost//private/3rdparty/crates:prost",
    ],
)

exports_files([
    "Cargo.toml",
    "src/lib.rs",
    "src/main.rs",
])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
