load("@crates//:crates.bzl", "aliases", "crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")
load("//tools/visibility:visibility.bzl", "VIS_ENV_SHARD")

# gazelle:resolve rust proto //env:plan_proto_rs
# gazelle:resolve rust plan_proto //env:plan_proto_rs
# gazelle:resolve rust env_shard //env/env_shard:env_shard

package(default_visibility = VIS_ENV_SHARD)

rust_library(
    name = "env_shard",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "env/env_shard",
        normal = True,
    ),
    crate_name = "env_shard",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = crate_deps(
        [
            "clap",
            "thiserror",
            "tracing",
        ],
        package_name = "env/env_shard",
    ) + [
        "//cli/path:dx_path",
        "//cli/proto_validate:dx_proto_validate",
        "//env:plan_proto_rs",
        "@rules_rust_prost//private/3rdparty/crates:prost",
    ],
)

rust_binary(
    name = "env_shard_writer",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "env/env_shard",
        normal = True,
    ),
    crate_name = "env_shard_writer",
    crate_root = "src/main.rs",
    edition = "2021",
    deps = crate_deps(
        [
            "clap",
            "thiserror",
            "tracing",
        ],
        package_name = "env/env_shard",
    ) + [
        ":env_shard",
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/output:dx_output",
    ],
)

rust_test(
    name = "env_shard_test",
    size = "small",
    aliases = aliases(
        package_name = "env/env_shard",
        normal = True,
        normal_dev = True,
    ),
    crate = ":env_shard",
    deps = crate_deps(
        [
            "clap",
            "tempfile",
            "thiserror",
            "tracing",
        ],
        package_name = "env/env_shard",
    ) + [
        "//env:plan_proto_rs",
        "@rules_rust_prost//private/3rdparty/crates:prost",
    ],
)

rustfmt_test(
    name = "env_shard_fmt_test",
    size = "small",
    targets = [
        ":env_shard",
        ":env_shard_writer",
        ":env_shard_writer_bin_test",
    ],
)

rust_clippy_test(
    name = "env_shard_clippy_test",
    size = "small",
    targets = [
        ":env_shard",
        ":env_shard_writer",
    ],
)

# keep
rust_test(
    name = "env_shard_writer_bin_test",
    size = "small",
    aliases = aliases(
        package_name = "env/env_shard",
        normal = True,
        normal_dev = True,
    ),
    crate = ":env_shard_writer",
    deps = crate_deps(
        [
            "clap",
            "tempfile",
            "thiserror",
            "tracing",
        ],
        package_name = "env/env_shard",
    ) + [
        ":env_shard",
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/output:dx_output",
        "//env:plan_proto_rs",
    ],
)

exports_files([
    "Cargo.toml",
    "src/lib.rs",
    "src/main.rs",
])

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
