load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@crates//:crates.bzl", "aliases")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//rust:defs.bzl", "rust_binary")
load("//tools/visibility:visibility.bzl", "VIS_PUBLIC")

package(default_visibility = VIS_PUBLIC)

exports_files(["Cargo.toml"])

write_file(
    name = "doctor_sh",
    out = "doctor.sh",
    content = [
        "#!/bin/sh",
        "echo 'rules_dx managed environment tool: //env:doctor'",
        "",
    ],
    is_executable = True,
)

sh_binary(
    name = "doctor",
    testonly = False,
    srcs = [":doctor_sh"],
)

rust_binary(
    name = "tool_sh",
    testonly = False,
    srcs = ["src/bin_tool.rs"],
    aliases = aliases(
        package_name = "env/private/env_stubs",
        normal = True,
    ),
    crate_name = "tool_sh",
    crate_root = "src/bin_tool.rs",
    deps = [],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    testonly = True,
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
