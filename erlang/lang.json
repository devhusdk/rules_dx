{
  "$schema": "../core/modules/lang.schema.json",
  "name": "erlang",
  "title": "Erlang",
  "family": "core",
  "ecosystems": [
    "hex"
  ],
  "depcheck": "erlang",
  "semver": false,
  "manifests": [
    "mix.exs"
  ],
  "lockfiles": [
    "mix.lock"
  ],
  "tools": [
    "dialyzer",
    "elvis",
    "erlc",
    "erlfmt"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_arm64",
    "windows_x86_64"
  ],
  "pins": [
    "pins.json"
  ],
  "entry_points": [
    "erlang_app",
    "erlang_bench",
    "erlang_bytecode",
    "erlang_ct_suite_test",
    "erlang_erlc_opts",
    "erlang_escript_archive",
    "erlang_eunit_test",
    "erlang_nif",
    "erlang_release",
    "erlang_test_app",
    "erlang_xrl_yrl"
  ],
  "quality": {
    "bzl": "erlang/private/quality:beam.bzl",
    "file_extensions": [
      ".erl",
      ".hrl"
    ],
    "aspects": {
      "format": [
        "real_erlang_format_aspect"
      ],
      "lint": [
        "real_erlang_lint_aspect"
      ],
      "typecheck": [
        "real_erlang_typecheck_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_beam_format_probe_aspect"
      ],
      "lint": [
        "real_beam_lint_probe_aspect"
      ],
      "typecheck": [
        "real_beam_typecheck_probe_aspect"
      ]
    }
  },
  "docs": {
    "bzl": "tools/docs/beam:aspect.bzl",
    "file_extensions": [
      ".erl",
      ".hrl"
    ],
    "aspects": [
      "real_beam_docs_aspect"
    ]
  }
}
