load("//core/quality:fixtures.bzl", "real_source_target")
load(":dialyzer.bzl", "dialyzer_plt")
load(":wrapper_tests.bzl", "dialyzer_plt_needs_input_test", "erlang_wrapper_contract_tests")

package(default_visibility = [
    "//:__pkg__",
    "//erlang:__subpackages__",
    "//tools/ci:__pkg__",
])

exports_files([
    "defs.bzl",
    "beam.bzl",
    "dialyzer.bzl",
    "kwargs.bzl",
    "nif_exports.lds",
    "plt_build.escript",
    "providers.bzl",
    "rebar_lock.bzl",
    "wrapper_tests.bzl",
])

erlang_wrapper_contract_tests(name = "wrapper_contract_tests")

dialyzer_plt(
    name = "empty_plt",
    dialyzer = "//erlang/private/tools:dialyzer_bin",
    escript = "//erlang/private/tools:escript_bin",
    tags = ["manual"],
)

dialyzer_plt_needs_input_test(
    name = "plt_needs_input_test",
    target = ":empty_plt",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "beam.bzl",
        "dialyzer.bzl",
        "kwargs.bzl",
        "providers.bzl",
        "rebar_lock.bzl",
        "wrapper_tests.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)

platform(
    name = "windows_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
    parents = ["//tools/platforms:windows_msvc_host"],
    visibility = ["//visibility:public"],
)
