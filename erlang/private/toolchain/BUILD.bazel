load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//libs/starlark:cells.bzl", "unsupported_value")
load("//quality:fixtures.bzl", "real_source_target")
load(":cells.bzl", "otp_cell_settings", "otp_compatible_with")
load(":cells_tests.bzl", "erlang_cell_tests")
load(":metadata_tests.bzl", "erlang_metadata_tests")

package(default_visibility = ["//visibility:public"])

exports_files([
    "cells.bzl",
    "cells_tests.bzl",
    "metadata_tests.bzl",
    "otp.bzl",
    "pins.bzl",
    "repos.bzl",
    "extensions.bzl",
])

otp_cell_settings(name = "cell")

unsupported_value("unsupported")

erlang_cell_tests(name = "cells")

erlang_metadata_tests(name = "metadata")

build_test(
    name = "otp_windows_arm64",
    target_compatible_with = otp_compatible_with(["windows_arm64"]),
    targets = ["@dx_otp_windows_arm64//:otp"],
)

build_test(
    name = "otp_windows_x86_64",
    target_compatible_with = otp_compatible_with(["windows_x86_64"]),
    targets = ["@dx_otp_windows_x86_64//:otp"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "cells.bzl",
        "cells_tests.bzl",
        "metadata_tests.bzl",
        "otp.bzl",
        "pins.bzl",
        "repos.bzl",
        "extensions.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
