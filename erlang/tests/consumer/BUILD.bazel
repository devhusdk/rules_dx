load("@rules_dx//erlang:defs.bzl", "erlang_app", "erlang_bytecode", "erlang_eunit_test", "erlang_test_app", "erlc_opts")

# dx: written once, yours to edit

erlang_app(
    name = "erlang_app",
    srcs = ["src/consumer.erl"],
    app_description = "A consumer starter.",
    app_name = "my_project",
    app_version = "1.0.0",
    visibility = ["//visibility:public"],
)

erlang_test_app(
    name = "test_erlang_app",
    app_name = "my_project",
    app_version = "1.0.0",
)

erlc_opts(
    name = "test_erlc_opts",
    values = [
        "+deterministic",
        "+debug_info",
        "+warn_export_vars",
        "+warn_shadow_vars",
        "+warn_obsolete_guard",
        "-DTEST=1",
    ],
)

erlang_bytecode(
    name = "test_modules",
    testonly = True,
    srcs = ["test/consumer_tests.erl"],
    outs = ["test/consumer_tests.beam"],
    erlc_opts = ":test_erlc_opts",
    deps = [":test_erlang_app"],
)

erlang_eunit_test(
    name = "consumer_test",
    size = "small",
    compiled_suites = [":test_modules"],
    target = ":test_erlang_app",
)
