load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//erlang:defs.bzl", "erlang_app", "erlang_bytecode", "erlang_erlc_opts", "erlang_eunit_test", "erlang_test_app", "erlang_xrl_yrl")
load("@rules_dx//erlang/private:defs.bzl", "DEFAULT_TEST_ERLC_OPTS", "ERLANG_COMPATIBLE_WITH")

exports_files(
    glob(["src/*"]) + [
        "BUILD.bazel",
        "test/kv_proto_tests.erl",
    ],
    visibility = ["//visibility:public"],
)

APPS = ["//erlang/tests/fixtures/erlang_app:__subpackages__"]

GENERATED = [
    "src/kv_lexer.erl",
    "src/kv_parser.erl",
]

erlang_xrl_yrl(
    name = "grammar",
    srcs = [
        "src/kv_lexer.xrl",
        "src/kv_parser.yrl",
    ],
    outs = GENERATED,
    target_compatible_with = ERLANG_COMPATIBLE_WITH,
)

erlang_app(
    app_description = "Parses key-value store commands.",
    app_name = "kv_proto",
    app_version = "1.0.0",
    extra_srcs = GENERATED,
    visibility = APPS,
)

erlang_test_app(
    app_name = "kv_proto",
    app_version = "1.0.0",
    extra_srcs = GENERATED,
)

erlang_erlc_opts(
    name = "test_erlc_opts",
    values = DEFAULT_TEST_ERLC_OPTS,
)

erlang_bytecode(
    name = "test_modules",
    testonly = True,
    srcs = ["test/kv_proto_tests.erl"],
    outs = ["test/kv_proto_tests.beam"],
    erlc_opts = ":test_erlc_opts",
    deps = [":test_erlang_app"],
)

erlang_eunit_test(
    name = "eunit",
    compiled_suites = [":test_modules"],
    target = ":test_erlang_app",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//visibility:public"],
)
