# gazelle:dx_rust_corpus false

load("@rules_dx//erlang:defs.bzl", "erlang_app", "erlang_escript_archive", "erlang_nif")
load("@rules_dx//erlang/private:defs.bzl", "ERLANG_COMPATIBLE_WITH")
load("@rules_dx//erlang/tests:wrapper_tests.bzl", "erlang_escript_nif_refusal_test")

exports_files(
    glob([
        "probe_nif.c",
        "src/*",
    ]) + ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

erlang_nif(
    name = "probe_nif",
    srcs = ["probe_nif.c"],
)

erlang_app(
    app_name = "nif_escript",
    app_version = "1.0.0",
    nifs = [":probe_nif"],
)

erlang_escript_archive(
    name = "nif_cli",
    app = ":erlang_app",
    tags = ["manual"],
)

erlang_escript_nif_refusal_test(
    name = "refusal_test",
    message = "an escript archive cannot bundle NIFs",
    target = ":nif_cli",
    target_compatible_with = ERLANG_COMPATIBLE_WITH,
)
