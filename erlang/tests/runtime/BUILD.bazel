# gazelle:dx_rust_corpus false

load("@rules_dx//erlang:defs.bzl", "erlang_app", "erlang_bytecode", "erlang_ct_suite_test", "erlang_erlc_opts", "erlang_eunit_test", "erlang_test_app")
load("@rules_dx//erlang/private:defs.bzl", "DEFAULT_TEST_ERLC_OPTS")
load("@rules_dx//erlang/private/toolchain:pins.bzl", "OTP_VERSION")
load("@rules_dx//erlang/tests:defs_tests.bzl", "erlang_beam_info_test", "erlang_coverage_env_test")

exports_files(
    ["src/dx_runtime_probe.erl"],
    visibility = ["@rules_dx//core/quality/tests:__pkg__"],
)

erlang_app(
    app_name = "dx_runtime_probe",
    app_version = "1.0.0",
    visibility = ["@rules_dx//core/quality/testdata:__pkg__"],
)

erlang_test_app(
    app_name = "dx_runtime_probe",
    app_version = "1.0.0",
)

erlang_beam_info_test(
    name = "beam_info_test",
    app_name = "dx_runtime_probe",
    owned = ["dx_runtime_probe.beam"],
    target = ":erlang_app",
)

erlang_erlc_opts(
    name = "test_erlc_opts",
    values = DEFAULT_TEST_ERLC_OPTS,
)

erlang_bytecode(
    name = "test_modules",
    testonly = True,
    srcs = ["test/dx_runtime_probe_tests.erl"],
    outs = ["test/dx_runtime_probe_tests.beam"],
    erlc_opts = ":test_erlc_opts",
    deps = [":test_erlang_app"],
)

erlang_eunit_test(
    name = "eunit",
    compiled_suites = [":test_modules"],
    target = ":test_erlang_app",
    test_env = {"DX_OTP_VERSION": OTP_VERSION},
)

erlang_ct_suite_test(
    name = "diagnostics_SUITE",
    app_name = "dx_runtime_probe",
    test_env = {"DX_OTP_VERSION": OTP_VERSION},
)

[
    erlang_coverage_env_test(
        name = target + "_coverage_env_test",
        apps_dirs = "erlang/tests",
        source = "erlang/tests/runtime/src/dx_runtime_probe.erl",
        target = ":" + target,
    )
    for target in [
        "eunit",
        "diagnostics_SUITE",
    ]
]

erlang_coverage_env_test(
    name = "nif_coverage_env_test",
    apps_dirs = "erlang/tests/fixtures/erlang_app",
    native = True,
    source = "erlang/tests/fixtures/erlang_app/checksum/src/kv_checksum.erl",
    target = "//erlang/tests/fixtures/erlang_app/checksum:eunit",
)

erlang_coverage_env_test(
    name = "nif_cpp_coverage_env_test",
    apps_dirs = "erlang/tests",
    native = True,
    source = "erlang/tests/nif_cpp/src/dx_cpp_a.erl",
    target = "//erlang/tests/nif_cpp:eunit",
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)
