load("//erlang/rules:defs.bzl", "ERLANG_COMPATIBLE_WITH", "erlang_app", "test_erlang_app")
load("//libs/starlark:defs.bzl", "starlark_test")
load("//libs/starlark:tag_probe.bzl", "tag_subject")
load("//quality:fixtures.bzl", "real_source_target")

erlang_app(
    app_name = "dx_tags_probe",
    tags = [
        "manual",
        "no-lint",
        "no-remote-exec",
    ],
    target_compatible_with = ERLANG_COMPATIBLE_WITH,
)

test_erlang_app(
    app_name = "dx_tags_probe",
    tags = [
        "manual",
        "no-lint",
        "no-remote-exec",
    ],
    target_compatible_with = ERLANG_COMPATIBLE_WITH,
)

tag_subject(
    name = "tags_subject",
    testonly = True,
    targets = [
        ":app_file",
        ":beam_files",
        ":erlang_app",
        ":erlang_app_upstream",
        ":test_beam_files",
        ":test_erlang_app",
        ":test_erlang_app_upstream",
    ],
)

starlark_test(
    name = "tags_test",
    expected_observations = """subject //erlang/tests/tags:tags_subject
field app_file=dx:no-lint,manual,no-remote-exec
field beam_files=dx:no-lint,manual,no-remote-exec
field erlang_app=manual,no-lint,no-remote-exec
field erlang_app_upstream=dx:no-lint,manual,no-remote-exec
field test_beam_files=dx:no-lint,manual,no-remote-exec
field test_erlang_app=manual,no-lint,no-remote-exec
field test_erlang_app_upstream=dx:no-lint,manual,no-remote-exec
aspect_field aspect_seen=True
aspect_field field_count=7
aspect_field has_subject=True
aspect_field subject_label=//erlang/tests/tags:tags_subject
aspect_field transitive_count=0
""",
    mode = "analysis",
    subjects = [":tags_subject"],
)

real_source_target(
