# subpackages() only reports the outermost packages, so nested packages stay a
# hand-kept list; a new top-level example workspace missing above fails loading.
[
    fail("//examples:example_starlark must list //examples/%s:corpus_starlark" % package)
    for package in subpackages(include = ["**"])
    if not [
        src
        for src in _EXAMPLE_STARLARK
        if src == "//examples/%s:corpus_starlark" % package or src.startswith("//examples/%s/" % package)
    ]
]

filegroup(
    name = "example_starlark",
    testonly = True,
    srcs = _EXAMPLE_STARLARK,
)

