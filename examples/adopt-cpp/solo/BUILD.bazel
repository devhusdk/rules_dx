load("@rules_dx//cc/rules:defs.bzl", "cc_library", "cc_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

filegroup(
    name = "cpp_sources",
    srcs = [
        "pure.cc",
        "pure.h",
    ],
)

exports_files([
    "pure.cc",
    "pure.h",
])

cc_test(
    name = "pure_test",
    srcs = ["pure_test.cc"],
    copts = ["-std=c++17"],
    deps = [
        ":solo",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "solo",
    srcs = ["pure.cc"],
    hdrs = ["pure.h"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
