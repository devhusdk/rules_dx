load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")
load("//tools/testing:nested_bazel.bzl", "NESTED_BAZEL_DATA", "NESTED_BAZEL_ENV_INHERIT", "NESTED_BAZEL_NETWORK_ENV", "NESTED_BAZEL_NETWORK_TAGS")

package(default_visibility = ["//:__subpackages__"])

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = [
        "Cargo.toml",
        "pyproject.toml",
    ],
)

real_source_target(
    name = "corpus_json",
    json_srcs = ["package.json"],
    tags = ["corpus"],
)

exports_files([
    "Cargo.lock",
    "Cargo.toml",
    "package.json",
    "pnpm-lock.yaml",
    "pyproject.toml",
    "uv.lock",
])

filegroup(
    name = "sources",
    testonly = True,
    srcs = glob(
        ["*"],
        exclude = [
            "BUILD.bazel",
            "README.md",
        ],
    ) + [
        "//examples/adopt-polyglot/frontend:sources",
        "//examples/adopt-polyglot/native:sources",
        "//examples/adopt-polyglot/native_cpp:sources",
        "//examples/adopt-polyglot/native_cpp/main:sources",
        "//examples/adopt-polyglot/pytools:sources",
        "//examples/adopt-polyglot/widgets:sources",
    ],
)

# keep
rust_test(
    name = "consumer_test",
    timeout = "moderate",
    srcs = ["consumer_test.rs"],
    data = [
        ":sources",
        "//:module_srcs",
        "//cli/cli:dx",
    ] + NESTED_BAZEL_DATA,
    env = {
        "DX_BIN": "$(rootpath //cli/cli:dx)",
        "RUST_TEST_THREADS": "1",
    } | NESTED_BAZEL_NETWORK_ENV,
    env_inherit = NESTED_BAZEL_ENV_INHERIT,
    # The consumer fetches toolchains and registry modules.
    tags = NESTED_BAZEL_NETWORK_TAGS,
    deps = [
        "//tools/testing:dx_nested",
        "//tools/testing:dx_testing",
    ],
)

rustfmt_test(
    name = "consumer_fmt_test",
    targets = [":consumer_test"],
)

rust_clippy_test(
    name = "consumer_clippy_test",
    targets = [":consumer_test"],
)
