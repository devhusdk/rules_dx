load("//core/quality:fixtures.bzl", "real_source_target")
load("//tools/testing/hermetic:defs.bzl", "nested_bazel_test")

package(default_visibility = ["//:__subpackages__"])

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = [
        "Cargo.toml",
        "pyproject.toml",
    ],
)

real_source_target(
    name = "corpus_json",
    json_srcs = ["package.json"],
    tags = ["corpus"],
)

exports_files([
    "Cargo.lock",
    "Cargo.toml",
    "package.json",
    "pnpm-lock.yaml",
    "pyproject.toml",
    "uv.lock",
])

filegroup(
    name = "sources",
    testonly = True,
    srcs = glob(
        ["*"],
        exclude = [
            "BUILD.bazel",
            "README.md",
        ],
    ) + [
        "//examples/adopt-polyglot/frontend:sources",
        "//examples/adopt-polyglot/native:sources",
        "//examples/adopt-polyglot/native_cpp:sources",
        "//examples/adopt-polyglot/native_cpp/main:sources",
        "//examples/adopt-polyglot/pytools:sources",
        "//examples/adopt-polyglot/widgets:sources",
    ],
)

# keep
nested_bazel_test(
    name = "consumer_test",
    timeout = "moderate",
    srcs = ["consumer_test.rs"],
    cache = "adopt_polyglot",
    cache_locks = "//tools/testing/nested_cache:adopt_polyglot_locks",
    data = [
        ":sources",
        "//:module_srcs",
        "//cli/cli:dx",
        "//core/coreutils:applets",
        "//patches/rules_py:external_repo_pytest_paths.patch",
        "//patches/rules_py:host_interpreter_windows_arm64.patch",
        "//patches/rules_py:host_libc_glibc.patch",
        "//patches/rules_py:native_sdist_toolchain_flags.patch",
        "//patches/rules_py:pep517_msvc.patch",
        "//patches/rules_py:py_cc_toolchain_platform.patch",
        "//patches/rules_py:venv_bin_files.patch",
        "//patches/rules_py:win32_x86_32.patch",
    ],
    env = {
        "DX_COREUTILS": "$(rootpaths //core/coreutils:applets)",
        "DX_BIN": "$(rootpath //cli/cli:dx)",
    },
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing:dx_testing",
        "//tools/testing/nested:dx_nested",
    ],
)
