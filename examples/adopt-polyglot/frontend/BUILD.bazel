load("@rules_dx//javascript/rules:defs.bzl", "javascript_library")
load("@rules_dx//typescript/rules:defs.bzl", "typescript_project", "typescript_test")
load("//quality:fixtures.bzl", "real_source_target")

typescript_project(
    name = "sums",
    srcs = ["sums.ts"],
    declaration = True,
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
)

typescript_project(
    name = "totals",
    srcs = ["totals.ts"],
    declaration = True,
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
    deps = [":sums"],
)

typescript_test(
    name = "totals_test",
    srcs = ["totals_test.ts"],
    config = "jest.config.cjs",
    declaration = True,
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
    package_json = "//:package_json",
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
    deps = [":totals"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

javascript_library(
    name = "jest_config",
    srcs = ["jest.config.cjs"],
)

filegroup(
    name = "sources",
    testonly = True,
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//examples/adopt-polyglot:__pkg__"],
)
