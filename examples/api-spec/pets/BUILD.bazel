load("//api_spec/rules:codegen.bzl", "openapi_codegen_shard", "openapi_typescript_client")
load("//api_spec/rules:defs.bzl", "api_spec_library")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

api_spec_library(
    name = "pets",
    srcs = ["openapi.yaml"],
    refs = ["schemas/pet.yaml"],
    deps = ["//examples/api-spec/shared"],
)

openapi_typescript_client(
    name = "client",
    spec = ":pets",
)

openapi_codegen_shard(
    name = "client_shard",
    client = ":client",
    entries = ["gen/pets/client.ts|gen|pets|examples/api-spec/pets/client.ts"],
    language = "typescript",
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
