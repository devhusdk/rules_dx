load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//quality:fixtures.bzl", "real_source_target")

_PUBLIC = ["//visibility:public"]

package(default_visibility = _PUBLIC)

exports_files([
    "BUILD.bazel",
    "greet.c",
    "greet.h",
])

cc_library(
    name = "greet",
    srcs = ["greet.c"],
    hdrs = ["greet.h"],
    copts = ["-fPIC"],
    includes = ["."],
    target_compatible_with = ["@platforms//os:linux"],
)

cc_shared_library(
    name = "greet_shared",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [":greet"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
