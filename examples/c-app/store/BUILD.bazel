load("@rules_dx//cc/rules:defs.bzl", "cc_library", "cc_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_test", "rustfmt_test")

package(default_visibility = ["//examples/c-app:__subpackages__"])

exports_files(
    [
        "VERSION",
        "linkage_test.cc",
        "not_json.txt",
        "store.c",
        "store.h",
        "store_test.c",
        "stock.json",
    ] + glob(["malformed/*.json"]),
    visibility = ["//visibility:public"],
)

genrule(
    name = "store_build_h",
    srcs = ["VERSION"],
    outs = ["store_build.h"],
    cmd = "printf '#define STORE_SCHEMA %s\\n' \"$$(cat $<)\" > $@",
)

cc_library(
    name = "store",
    srcs = ["store.c"],
    hdrs = [
        "store.h",
        ":store_build_h",
    ],
    aspect_hints = ["//:clang_format_config"],
    copts = ["-std=c11"],
    data = ["stock.json"],
    deps = ["@c_app_cjson//:cjson"],
)

cc_test(
    name = "store_test",
    srcs = ["store_test.c"],
    aspect_hints = ["//:clang_format_config"],
    copts = ["-std=c11"],
    data = [
        "VERSION",
        "not_json.txt",
        "stock.json",
    ] + glob(["malformed/*.json"]),
    deps = [":store"],
)

cc_test(
    name = "linkage_test",
    srcs = ["linkage_test.cc"],
    aspect_hints = ["//:clang_format_config"],
    copts = ["-std=c++17"],
    data = ["stock.json"],
    deps = [":store"],
)

rust_test(
    name = "format_test",
    srcs = ["//tools/testing:clang_format_test.rs"],
    data = [
        "linkage_test.cc",
        "store.c",
        "store.h",
        "store_test.c",
        "//:.clang-format",
        "@llvm//tools:clang-format",
    ],
    env = {
        "DX_CLANG_FORMAT": "$(rootpath @llvm//tools:clang-format)",
        "DX_CLANG_FORMAT_STYLE": "$(rootpath //:.clang-format)",
        "DX_FORMAT_SRCS": "$(rootpath linkage_test.cc) $(rootpath store.c) $(rootpath store.h) $(rootpath store_test.c)",
    },
    deps = ["//tools/testing:dx_testing"],
)

filegroup(
    name = "consumer_srcs",
    srcs = glob([
        "*.c",
        "*.h",
        "*.cc",
        "*.json",
        "*.txt",
        "malformed/*.json",
    ]) + [
        "BUILD.bazel",
        "VERSION",
    ],
    visibility = ["//examples/c-app:__pkg__"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = [
        "//examples:__pkg__",
        "//tools/ci:__pkg__",
    ],
)

rustfmt_test(
    name = "store_fmt_test",
    size = "small",
    targets = [
        ":format_test",
    ],
)
