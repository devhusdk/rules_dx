load("@rules_dx//cc/rules:defs.bzl", "cc_library", "cc_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//examples/c-app:__subpackages__"])

exports_files([
    "bad_stock.json",
    "stock.json",
])

genrule(
    name = "store_build_h",
    srcs = ["VERSION"],
    outs = ["store_build.h"],
    cmd = "printf '#define STORE_SCHEMA %s\\n' \"$$(cat $<)\" > $@",
)

cc_library(
    name = "store",
    srcs = ["store.c"],
    hdrs = [
        "store.h",
        ":store_build_h",
    ],
    copts = ["-std=c11"],
    data = ["stock.json"],
    deps = ["@c_app_cjson//:cjson"],
)

cc_test(
    name = "store_test",
    srcs = ["store_test.c"],
    copts = ["-std=c11"],
    data = [
        "VERSION",
        "not_json.txt",
        "stock.json",
    ],
    deps = [":store"],
)

cc_test(
    name = "linkage_test",
    srcs = ["linkage_test.cc"],
    copts = ["-std=c++17"],
    data = ["stock.json"],
    deps = [":store"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
