load("@rules_dx//cc/rules:defs.bzl", "cc_library", "cc_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//examples/cpp-app:__subpackages__"])

exports_files(["menu.csv"])

genrule(
    name = "build_config_h",
    srcs = ["VERSION"],
    outs = ["build_config.h"],
    cmd = "printf 'inline constexpr int kMenuVersion = %s;\\n' \"$$(cat $<)\" > $@",
)

cc_library(
    name = "core",
    srcs = ["menu.cc"],
    hdrs = [
        "group.h",
        "menu.h",
        ":build_config_h",
    ],
    copts = ["-std=c++17"],
    data = ["menu.csv"],
)

cc_test(
    name = "menu_test",
    srcs = ["menu_test.cc"],
    copts = ["-std=c++17"],
    data = ["menu.csv"],
    deps = [
        ":core",
        "@googletest//:gtest_main",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
