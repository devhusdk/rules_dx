load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "fmt",
    srcs = ["src/format.cc"],
    hdrs = glob(["include/fmt/*.h"]),
    copts = [
        "-std=c++17",
        "-include",
        "stdlib.h",
    ],
    features = ["-treat_warnings_as_errors"],
    includes = ["include"],
    visibility = ["//visibility:public"],
)
