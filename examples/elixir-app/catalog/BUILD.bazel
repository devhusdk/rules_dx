load("@rules_dx//elixir/rules:defs.bzl", "ELIXIR_COMPATIBLE_WITH", "elixir_app", "ex_unit_test")
load("//quality:fixtures.bzl", "real_source_target")

exports_files(
    glob([
        "lib/**",
        "test/*",
    ]) + [
        "BUILD.bazel",
        "units.txt",
    ],
    visibility = ["//tools/testing/hermetic:__pkg__"],
)

APPS = ["//examples/elixir-app:__subpackages__"]

genrule(
    name = "units",
    srcs = ["units.txt"],
    outs = ["units.ex"],
    cmd = """
entries=""
while read -r unit size; do
  entries="$$entries, {\\"$$unit\\", $$size}"
done < $<
printf 'defmodule Catalog.Units do\\n  @moduledoc false\\n\\n  def all, do: [%s]\\nend\\n' "$${entries#, }" > $@
""",
)

elixir_app(
    srcs = glob(["lib/**/*.ex"]) + [":units"],
    app_description = "Item parsing and JSON ledgers.",
    app_name = "catalog",
    app_version = "1.0.0",
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
    visibility = APPS,
    deps = ["@elixir_app_jason//:erlang_app"],
)

ex_unit_test(
    name = "catalog_test",
    size = "small",
    srcs = [
        "test/catalog_test.exs",
        "test/test_helper.exs",
    ],
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
    deps = [":erlang_app"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//examples:__pkg__"],
)
