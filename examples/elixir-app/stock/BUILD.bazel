load("@rules_dx//elixir/rules:defs.bzl", "ELIXIR_COMPATIBLE_WITH", "elixir_app", "ex_unit_test")
load("//quality:fixtures.bzl", "real_source_target")

exports_files(
    glob([
        "lib/**",
        "test/*",
    ]) + ["BUILD.bazel"],
    visibility = ["//tools/testing/hermetic:__pkg__"],
)

APPS = ["//examples/elixir-app:__subpackages__"]

elixir_app(
    app_description = "Supervised stock ledger.",
    app_env = "[{max_units, 60}]",
    app_module = "Stock.Application",
    app_name = "stock",
    app_version = "1.0.0",
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
    visibility = APPS,
    deps = ["//examples/elixir-app/catalog:erlang_app"],
)

ex_unit_test(
    name = "ledger_test",
    size = "small",
    srcs = [
        "test/ledger_test.exs",
        "test/test_helper.exs",
    ],
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
    deps = [":erlang_app"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
