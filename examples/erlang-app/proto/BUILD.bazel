load("@rules_dx//erlang/rules:defs.bzl", "DEFAULT_TEST_ERLC_OPTS", "ERLANG_COMPATIBLE_WITH", "erlang_app", "erlang_bytecode", "erlang_xrl_yrl", "erlc_opts", "eunit", "test_erlang_app")
load("//quality:fixtures.bzl", "real_source_target")

exports_files(
    glob(["src/*"]) + [
        "BUILD.bazel",
        "test/kv_proto_tests.erl",
    ],
    visibility = ["//tools/testing/hermetic:__pkg__"],
)

APPS = ["//examples/erlang-app:__subpackages__"]

GENERATED = [
    "src/kv_lexer.erl",
    "src/kv_parser.erl",
]

erlang_xrl_yrl(
    name = "grammar",
    srcs = [
        "src/kv_lexer.xrl",
        "src/kv_parser.yrl",
    ],
    outs = GENERATED,
    target_compatible_with = ERLANG_COMPATIBLE_WITH,
)

erlang_app(
    app_description = "Parses key-value store commands.",
    app_name = "kv_proto",
    app_version = "1.0.0",
    extra_srcs = GENERATED,
    target_compatible_with = ERLANG_COMPATIBLE_WITH,
    visibility = APPS,
)

test_erlang_app(
    app_name = "kv_proto",
    app_version = "1.0.0",
    extra_srcs = GENERATED,
    target_compatible_with = ERLANG_COMPATIBLE_WITH,
)

erlc_opts(
    name = "test_erlc_opts",
    values = DEFAULT_TEST_ERLC_OPTS,
)

erlang_bytecode(
    name = "test_modules",
    testonly = True,
    srcs = ["test/kv_proto_tests.erl"],
    outs = ["test/kv_proto_tests.beam"],
    erlc_opts = ":test_erlc_opts",
    target_compatible_with = ERLANG_COMPATIBLE_WITH,
    deps = [":test_erlang_app"],
)

eunit(
    name = "eunit",
    size = "small",
    compiled_suites = [":test_modules"],
    target = ":test_erlang_app",
    target_compatible_with = ERLANG_COMPATIBLE_WITH,
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//examples:__pkg__"],
)
