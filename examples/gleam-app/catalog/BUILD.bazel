load("@rules_dx//gleam/rules:defs.bzl", "GLEAM_COMPATIBLE_WITH", "gleam_js_library", "gleam_js_test", "gleam_library", "gleam_test")
load("//quality:fixtures.bzl", "real_source_target")

exports_files(
    glob([
        "src/**",
        "test/*",
    ]) + [
        "BUILD.bazel",
        "units.txt",
    ],
    visibility = ["//tools/testing/hermetic:__pkg__"],
)

APPS = ["//examples/gleam-app:__subpackages__"]

genrule(
    name = "units",
    srcs = ["units.txt"],
    outs = ["src/catalog/units.gleam"],
    cmd = """
entries=""
while read -r unit size; do
  entries="$$entries, #(\\"$$unit\\", $$size)"
done < $<
printf 'pub const all = [%s]\\n' "$${entries#, }" > $@
""",
)

gleam_library(
    name = "catalog",
    srcs = glob(["src/**/*.gleam"]) + [":units"],
    target_compatible_with = GLEAM_COMPATIBLE_WITH,
    visibility = APPS,
    deps = [
        "@gleam_app_json//:gleam_json",
        "@rules_dx//gleam/lib:gleam_stdlib",
    ],
)

gleam_js_library(
    name = "catalog_js",
    srcs = glob(["src/**/*.gleam"]) + [":units"],
    target_compatible_with = GLEAM_COMPATIBLE_WITH,
    visibility = APPS,
    deps = [
        "@gleam_app_json//:gleam_json_js",
        "@rules_dx//gleam/lib:gleam_stdlib_js",
    ],
)

gleam_test(
    name = "catalog_test",
    size = "small",
    srcs = ["test/catalog_test.gleam"],
    target_compatible_with = GLEAM_COMPATIBLE_WITH,
    deps = [":catalog"],
)

gleam_js_test(
    name = "catalog_js_test",
    size = "small",
    srcs = ["test/catalog_test.gleam"],
    target_compatible_with = GLEAM_COMPATIBLE_WITH,
    deps = [":catalog_js"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
