load("@rules_dx//gleam/rules:defs.bzl", "GLEAM_COMPATIBLE_WITH", "gleam_binary", "gleam_erl_library", "gleam_js_binary", "gleam_js_library", "gleam_js_test", "gleam_library", "gleam_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//quality:fixtures.bzl", "real_source_target")

exports_files(
    glob([
        "src/**",
        "test/*",
    ]) + [
        "BUILD.bazel",
        "launchers_test.sh",
    ],
    visibility = ["//tools/testing/hermetic:__pkg__"],
)

gleam_erl_library(
    name = "ffi",
    srcs = ["src/stockctl_ffi.erl"],
    target_compatible_with = GLEAM_COMPATIBLE_WITH,
)

gleam_library(
    name = "commands",
    srcs = ["src/stockctl/commands.gleam"],
    target_compatible_with = GLEAM_COMPATIBLE_WITH,
    deps = [
        "//examples/gleam-app/catalog",
        "//examples/gleam-app/stock",
        "@rules_dx//gleam/lib:gleam_stdlib",
    ],
)

gleam_js_library(
    name = "commands_js",
    srcs = ["src/stockctl/commands.gleam"],
    target_compatible_with = GLEAM_COMPATIBLE_WITH,
    deps = [
        "//examples/gleam-app/catalog:catalog_js",
        "//examples/gleam-app/stock:stock_js",
        "@rules_dx//gleam/lib:gleam_stdlib_js",
    ],
)

gleam_binary(
    name = "stockctl",
    srcs = ["src/stockctl.gleam"],
    target_compatible_with = GLEAM_COMPATIBLE_WITH,
    deps = [
        ":commands",
        ":ffi",
        "//examples/gleam-app/catalog",
        "//examples/gleam-app/stock",
        "@rules_dx//gleam/lib:gleam_stdlib",
    ],
)

gleam_js_binary(
    name = "stockctl_js",
    srcs = [
        "src/stockctl.gleam",
        "src/stockctl_ffi.mjs",
    ],
    main_module = "stockctl",
    target_compatible_with = GLEAM_COMPATIBLE_WITH,
    deps = [
        ":commands_js",
        "//examples/gleam-app/catalog:catalog_js",
        "//examples/gleam-app/stock:stock_js",
        "@rules_dx//gleam/lib:gleam_stdlib_js",
    ],
)

gleam_test(
    name = "stockctl_test",
    size = "small",
    srcs = ["test/stockctl_test.gleam"],
    target_compatible_with = GLEAM_COMPATIBLE_WITH,
    deps = [
        ":commands",
        "//examples/gleam-app/catalog",
        "//examples/gleam-app/stock",
    ],
)

gleam_js_test(
    name = "stockctl_js_test",
    size = "small",
    srcs = ["test/stockctl_test.gleam"],
    target_compatible_with = GLEAM_COMPATIBLE_WITH,
    deps = [
        ":commands_js",
        "//examples/gleam-app/catalog:catalog_js",
        "//examples/gleam-app/stock:stock_js",
    ],
)

sh_test(
    name = "launchers_test",
    size = "small",
    srcs = ["launchers_test.sh"],
    args = [
        "$(rootpath :stockctl)",
        "$(rootpath :stockctl_js)",
    ],
    data = [
        ":stockctl",
        ":stockctl_js",
    ],
    target_compatible_with = GLEAM_COMPATIBLE_WITH,
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//examples:__pkg__"],
)
