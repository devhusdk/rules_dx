load("@rules_dx//gleam/rules:defs.bzl", "GLEAM_COMPATIBLE_WITH", "gleam_js_library", "gleam_js_test", "gleam_library", "gleam_test")
load("//quality:fixtures.bzl", "real_source_target")

exports_files(
    glob([
        "lib/**",
        "test/*",
    ]) + ["BUILD.bazel"],
    visibility = ["//tools/testing/hermetic:__pkg__"],
)

APPS = ["//examples/gleam-app:__subpackages__"]

gleam_library(
    name = "stock",
    srcs = glob(["lib/**/*.gleam"]),
    strip_src_prefix = "examples/gleam-app/stock/lib",
    target_compatible_with = GLEAM_COMPATIBLE_WITH,
    visibility = APPS,
    deps = [
        "//examples/gleam-app/catalog",
        "@rules_dx//gleam/lib:gleam_stdlib",
    ],
)

gleam_js_library(
    name = "stock_js",
    srcs = glob(["lib/**/*.gleam"]),
    package = "stock_ledger",
    strip_src_prefix = "examples/gleam-app/stock/lib",
    target_compatible_with = GLEAM_COMPATIBLE_WITH,
    visibility = APPS,
    deps = [
        "//examples/gleam-app/catalog:catalog_js",
        "@rules_dx//gleam/lib:gleam_stdlib_js",
    ],
)

gleam_test(
    name = "ledger_test",
    size = "small",
    srcs = ["test/ledger_test.gleam"],
    target_compatible_with = GLEAM_COMPATIBLE_WITH,
    deps = [
        ":stock",
        "//examples/gleam-app/catalog",
    ],
)

gleam_js_test(
    name = "ledger_js_test",
    size = "small",
    srcs = ["test/ledger_test.gleam"],
    target_compatible_with = GLEAM_COMPATIBLE_WITH,
    deps = [
        ":stock_js",
        "//examples/gleam-app/catalog:catalog_js",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
