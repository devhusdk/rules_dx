load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_dx//lua/rules:defs.bzl", "lua_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//quality:fixtures.bzl", "real_source_target")

APPS = ["//examples/lua-app:__subpackages__"]

exports_files(
    [
        "BUILD.bazel",
        "exit_codes.sh",
        "main.lua",
    ],
    visibility = ["//tools/testing/hermetic:__pkg__"] + APPS,
)

string_flag(
    name = "order",
    build_setting_default = "file",
    values = [
        "file",
        "name",
    ],
)

config_setting(
    name = "by_name",
    flag_values = {":order": "name"},
)

lua_binary(
    name = "units",
    data = ["//examples/lua-app/catalog:units"],
    env = select({
        ":by_name": {
            "UNITS": "$(rlocationpath //examples/lua-app/catalog:units)",
            "UNITS_ORDER": "name",
        },
        "//conditions:default": {
            "UNITS": "$(rlocationpath //examples/lua-app/catalog:units)",
            "UNITS_ORDER": "file",
        },
    }),
    main = "main.lua",
    deps = [
        "//examples/lua-app/catalog",
        "//examples/lua-app/report",
    ],
)

sh_test(
    name = "exit_codes_test",
    size = "small",
    srcs = ["exit_codes.sh"],
    args = ["$(rootpath :units)"],
    data = [
        ":units",
        "//examples/lua-app/catalog:units",
    ],
    env = select({
        ":by_name": {
            "UNITS": "$(rlocationpath //examples/lua-app/catalog:units)",
            "UNITS_ORDER": "name",
            "WANT_ORDER": "name",
        },
        "//conditions:default": {
            "UNITS": "$(rlocationpath //examples/lua-app/catalog:units)",
            "UNITS_ORDER": "file",
            "WANT_ORDER": "file",
        },
    }),
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//examples:__pkg__"],
)
