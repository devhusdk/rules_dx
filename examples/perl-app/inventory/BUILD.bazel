load("@rules_dx//perl/rules:defs.bzl", "perl_library", "perl_test")
load("//quality:fixtures.bzl", "real_source_target")

exports_files(
    glob([
        "lib/**",
        "t/*",
    ]) + ["BUILD.bazel"],
    visibility = ["//tools/testing/hermetic:__pkg__"],
)

APPS = ["//examples/perl-app:__subpackages__"]

perl_library(
    name = "inventory",
    srcs = [
        "lib/Inventory/Item.pm",
        "lib/Inventory/Ledger.pm",
    ],
    visibility = APPS,
)

perl_test(
    name = "item_test",
    size = "small",
    srcs = ["t/item.t"],
    deps = [":inventory"],
)

perl_test(
    name = "ledger_test",
    size = "small",
    srcs = ["t/ledger.t"],
    deps = [":inventory"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//examples:__pkg__"],
)
