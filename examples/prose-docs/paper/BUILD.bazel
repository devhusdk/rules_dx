load("@rules_dx//latex/rules:defs.bzl", "latex_library")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//typst/rules:defs.bzl", "typst_library")

_PUBLIC = ["//visibility:public"]

package(default_visibility = _PUBLIC)

exports_files(
    glob(["*"]),
    visibility = ["//tools/testing/hermetic:__pkg__"],
)

filegroup(
    name = "files",
    srcs = glob(["*"]),
    visibility = [
        "//examples/prose-docs:__pkg__",
        "//quality/tests:__pkg__",
    ],
)

typst_library(
    name = "typst",
    srcs = [
        "common.typ",
        "main.typ",
    ],
)

latex_library(
    name = "latex",
    srcs = [
        "body.tex",
        "main.tex",
    ],
    aspect_hints = ["//examples/prose-docs:docs_latexindent"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
