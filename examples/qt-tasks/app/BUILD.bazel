load("@rules_dx//deploy/rules:archive.bzl", "consumer_archive")
load("@rules_dx//qt/rules:defs.bzl", "qt_bundle", "qt_cc_binary", "qt_cc_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

_COMPATIBLE = [
    "@platforms//cpu:x86_64",
    "@platforms//os:linux",
]

qt_cc_binary(
    name = "tasks",
    srcs = ["main.cc"],
    modules = ["qml"],
    target_compatible_with = _COMPATIBLE,
    deps = [
        "//examples/qt-tasks/browser",
        "//examples/qt-tasks/catalog",
        "//examples/qt-tasks/store",
        "@cpp_app_fmt//:fmt",
    ],
)

qt_cc_test(
    name = "browser_test",
    size = "small",
    srcs = ["browser_test.cc"],
    moc_hdrs = ["browser_test.h"],
    modules = [
        "qml",
        "test",
    ],
    target_compatible_with = _COMPATIBLE,
    deps = [
        "//examples/qt-tasks/browser",
        "//examples/qt-tasks/catalog",
        "//examples/qt-tasks/store",
    ],
)

qt_cc_binary(
    name = "board",
    srcs = ["board.cc"],
    modules = ["quick"],
    target_compatible_with = _COMPATIBLE,
    deps = [
        "//examples/qt-tasks/board",
        "//examples/qt-tasks/store",
    ],
)

qt_cc_test(
    name = "board_quick_test",
    size = "small",
    srcs = ["board_quick_test.cc"],
    data = ["tst_board.qml"],
    moc_hdrs = ["board_quick_test.h"],
    modules = ["quick_test"],
    target_compatible_with = _COMPATIBLE,
    deps = [
        "//examples/qt-tasks/board",
        "//examples/qt-tasks/store",
    ],
)

qt_bundle(
    name = "runtime",
    binary = ":tasks",
    licenses = [
        "licenses/fmt/LICENSE",
        "licenses/llvm/LICENSE.TXT",
    ],
    qml_modules = [
        "QML",
        "QtQml",
    ],
    target_compatible_with = _COMPATIBLE,
)

consumer_archive(
    name = "tasks_release",
    app = ":tasks",
    arch = "x86_64",
    min_runtime = "glibc-2.34",
    notice = "NOTICE",
    os = "linux",
    resources = [":runtime"],
)

qt_bundle(
    name = "board_runtime",
    binary = ":board",
    licenses = ["licenses/llvm/LICENSE.TXT"],
    qml_modules = [
        "QML",
        "QtQml",
        "QtQuick",
    ],
    target_compatible_with = _COMPATIBLE,
)

consumer_archive(
    name = "board_release",
    app = ":board",
    arch = "x86_64",
    min_runtime = "glibc-2.34",
    notice = "BOARD_NOTICE",
    os = "linux",
    resources = [":board_runtime"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
