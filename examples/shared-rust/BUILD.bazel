load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//android/packaging:defs.bzl", "android_adb_install", "android_adb_log", "android_adb_start", "rust_android_apk")
load("//cc/rules:defs.bzl", "cc_library", "cc_test")
load("//deploy/rules:archive.bzl", "archive_deploy")
load("//javascript/rules:web.bzl", "javascript_web_app", "javascript_web_server")
load("//libs/starlark:failure_test.bzl", "failure_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_library", "rust_static_library", "rust_test", "rust_wasi_module", "rust_wasi_test", "rust_wasm_bindgen")
load(":release.bzl", "release_artifact")

package(default_visibility = ["//:__subpackages__"])

exports_files([
    "README.md",
    "assets/board.txt",
    "assets/notes.txt",
])

rust_library(
    name = "tasks_model",
    srcs = ["model/lib.rs"],
    aspect_hints = ["//:rustfmt_config"],
    crate_name = "shared_tasks_model",
    crate_root = "model/lib.rs",
)

rust_test(
    name = "tasks_model_test",
    aspect_hints = ["//:rustfmt_config"],
    crate = ":tasks_model",
)

rust_library(
    name = "tasks_core",
    srcs = ["core/lib.rs"],
    aspect_hints = ["//:rustfmt_config"],
    crate_name = "shared_tasks",
    crate_root = "core/lib.rs",
    visibility = ["//visibility:public"],
    deps = [
        ":tasks_model",
        "@shared_tasks_adler2//:adler2",
    ],
)

filegroup(
    name = "core_srcs",
    srcs = [
        "BUILD.bazel",
        "adler2.BUILD.bazel",
        "core/lib.rs",
        "model/lib.rs",
    ],
)

rust_test(
    name = "tasks_core_test",
    aspect_hints = ["//:rustfmt_config"],
    crate = ":tasks_core",
)

rust_binary(
    name = "tasks",
    srcs = ["cli/main.rs"],
    aspect_hints = ["//:rustfmt_config"],
    crate_name = "shared_tasks_cli",
    crate_root = "cli/main.rs",
    visibility = ["//visibility:public"],
    deps = [":tasks_core"],
)

rust_library(
    name = "tasks_web_lib",
    srcs = ["web/lib.rs"],
    aspect_hints = ["//:rustfmt_config"],
    crate_name = "shared_tasks_web",
    crate_root = "web/lib.rs",
    deps = [
        ":tasks_core",
        "@rules_rust_wasm_bindgen//3rdparty:wasm_bindgen",
    ],
)

rust_binary(
    name = "tasks_web",
    srcs = ["web/main.rs"],
    aspect_hints = ["//:rustfmt_config"],
    crate_name = "shared_tasks_web_bin",
    crate_root = "web/main.rs",
    deps = [":tasks_web_lib"],
)

rust_wasm_bindgen(
    name = "shared_tasks",
    target = "web",
    visibility = ["//visibility:public"],
    wasm_file = ":tasks_web_upstream",
)

rust_static_library(
    name = "tasks_ffi",
    srcs = ["ffi/lib.rs"],
    aspect_hints = ["//:rustfmt_config"],
    crate_name = "shared_tasks_ffi",
    crate_root = "ffi/lib.rs",
    deps = [":tasks_core"],
)

rust_test(
    name = "tasks_ffi_test",
    aspect_hints = ["//:rustfmt_config"],
    crate = ":tasks_ffi",
)

cc_library(
    name = "tasks_interface",
    hdrs = ["ffi/tasks.h"],
    strip_include_prefix = "ffi",
    visibility = ["//visibility:public"],
    deps = [":tasks_ffi"],
)

config_setting(
    name = "macos_coverage",
    constraint_values = ["@platforms//os:macos"],
    values = {"collect_code_coverage": "true"},
)

cc_test(
    name = "interface_test",
    srcs = ["ffi/ffi_test.c"],
    data = [
        "assets/board.txt",
        "assets/notes.txt",
    ],
    env = {
        "DX_TASKS_BOARD": "$(rootpath assets/board.txt)",
        "DX_TASKS_NOTES": "$(rootpath assets/notes.txt)",
    },
    target_compatible_with = select({
        ":macos_coverage": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [":tasks_interface"],
)

cc_library(
    name = "tasks_activity",
    srcs = ["android/activity.c"],
    linkopts = [
        "-landroid",
        "-llog",
    ],
    target_compatible_with = ["@platforms//os:android"],
    visibility = ["//visibility:public"],
    deps = [":tasks_interface"],
    alwayslink = True,
)

rust_android_apk(
    name = "tasks_apk",
    app_id = "com.example.dxsharedtasks",
    assets = [
        "assets/board.txt",
        "assets/notes.txt",
    ],
    assets_dir = "assets",
    resource_files = glob(["res/**"]),
    version_name = "2.0",
    deps = [":tasks_activity"],
)

android_adb_install(
    name = "install",
    apk = ":tasks_apk_file",
    serial = "emulator-5554",
)

android_adb_start(
    name = "start",
    app_id = "com.example.dxsharedtasks",
    serial = "emulator-5554",
)

android_adb_log(
    name = "log",
    serial = "emulator-5554",
)

sh_test(
    name = "inspect_apk_test",
    srcs = ["inspect_apk.sh"],
    args = [
        "$(location :tasks_apk_file)",
        "com.example.dxsharedtasks",
        "tasks_apk_bin",
        "arm64-v8a,x86_64",
        "$(location @android_ndk_toolchain//:llvm_readelf)",
        "31",
        "'DX Shared Tasks'",
        "$(location assets/board.txt)",
        "$(location assets/notes.txt)",
    ],
    data = [
        "assets/board.txt",
        "assets/notes.txt",
        ":tasks_apk_file",
        "@android_ndk_toolchain//:llvm_readelf",
    ],
    tags = ["manual"],
)

sh_test(
    name = "inspect_consumer_apk_test",
    srcs = ["inspect_apk.sh"],
    args = [
        "$(location @shared_consumer//:consumer_apk_file)",
        "org.example.consumer.tasks",
        "consumer_apk_bin",
        "x86_64",
        "$(location @android_ndk_toolchain//:llvm_readelf)",
        "33",
        "'Consumer Tasks'",
        "$(location @shared_consumer//:assets/board.txt)",
        "$(location @shared_consumer//:assets/notes.txt)",
    ],
    data = [
        "@android_ndk_toolchain//:llvm_readelf",
        "@shared_consumer//:assets/board.txt",
        "@shared_consumer//:assets/notes.txt",
        "@shared_consumer//:consumer_apk_file",
    ],
    tags = ["manual"],
)

rust_wasi_module(
    name = "tasks_wasi",
    binary = ":tasks",
    visibility = ["//visibility:public"],
)

rust_wasi_test(
    name = "wasi_test",
    args = [
        "--asset=/assets/notes.txt",
        "/board/board.txt",
        "add Ship the WASI build",
        "done 2",
    ],
    binary = ":tasks",
    expected_stdout = "\n".join([
        "ok:added 5",
        "ok:done 2",
        "[x] 1 Pin the Rust toolchain",
        "[x] 2 Draft release notes @notes.txt",
        "[ ] 3 Record emulator evidence",
        "[ ] 4 Ship the browser build",
        "[ ] 5 Ship the WASI build",
        "summary tasks=5 done=2 open=3 assets=1",
        "asset notes.txt bytes=41 adler32:3d6a0e9d",
    ]),
    preopens = {
        "/assets": "assets/notes.txt",
        "/board": "assets/board.txt",
    },
    tags = ["block-network"],
)

rust_wasi_test(
    name = "wasi_error_test",
    args = [
        "/board/board.txt",
        "done 9",
    ],
    binary = ":tasks",
    expected_code = 1,
    expected_stderr_substring = "err:no_such_task: no task 9",
    preopens = {"/board": "assets/board.txt"},
    tags = ["block-network"],
)

rust_wasi_test(
    name = "wasi_capability_test",
    args = ["/board/board.txt"],
    binary = ":tasks",
    expected_code = 2,
    expected_stderr_substring = "err:unreadable: /board/board.txt",
    tags = ["block-network"],
)

javascript_web_app(
    name = "app",
    assets = {
        "assets/board.txt": "assets/board.txt",
        "assets/notes.txt": "assets/notes.txt",
    },
    bindgen = ":shared_tasks",
    html = ":index.html",
)

javascript_web_server(
    name = "serve",
    app = ":app",
    aspect_hints = ["//:ruff_config"],
    headers = {"X-App": "shared-tasks"},
)

release_artifact(
    name = "tasks_release",
    target = ":tasks",
)

release_artifact(
    name = "tasks_wasi_release",
    target = ":tasks_wasi",
)

release_artifact(
    name = "app_release",
    target = ":app",
)

archive_deploy(
    name = "tasks_deploy",
    app = ":tasks",
)

