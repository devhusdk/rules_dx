load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

exports_files(["README.md"])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["@rules_dx//quality:corpus_vale_config"],
    markdown_siblings = ["//tests/fixtures/adopt-android:README.md"],
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

sh_test(
    name = "starlark_docs_test",
    srcs = ["starlark_docs_test.sh"],
    args = ["$(rootpath @rules_dx//tools/ci:starlark_docs_family_test)"],
    data = [
        "//packaging:corpus_starlark",
        "//platforms:corpus_starlark",
        "//rules:corpus_starlark",
        "//sdk:corpus_starlark",
        "//toolchain:corpus_starlark",
        "@rules_dx//tools/ci:starlark_docs_family_test",
    ],
    env = {"STARLARK_DOCS_PACKAGES": "packaging,platforms,rules,sdk,toolchain"},
)

filegroup(
    name = "module_srcs",
    srcs = glob(
        ["**"],
        exclude = ["**/tests/**"],
    ) + [
        "//packaging:module_srcs",
        "//platforms:module_srcs",
        "//rules:module_srcs",
        "//sdk:module_srcs",
        "//toolchain:module_srcs",
    ],
    visibility = ["//visibility:public"],
)

# dx:begin exports
exports_files(
    [".buildifier.json"],
    visibility = ["//.dx:__pkg__"],
)
# dx:end exports
