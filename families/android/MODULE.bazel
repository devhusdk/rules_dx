module(
    name = "rules_dx_android",
    version = "0.0.0",
    bazel_compatibility = [">=9.2.0"],
)

bazel_dep(name = "rules_dx", version = "0.0.0")
include("//third_party/rules_dx:rules_dx.MODULE.bazel")
local_path_override(
    module_name = "rules_dx",
    path = "../..",
)

# floor: equals tested
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_kotlin", version = "2.4.21")
bazel_dep(name = "rules_rust", version = "0.75.0", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_android", version = "0.8.0")

_android_ndk_toolchain_repo = use_repo_rule("//toolchain:repos.bzl", "android_ndk_toolchain_repo")

_android_ndk_toolchain_repo(
    name = "android_ndk_toolchain",
    api_level = 31,
    cxx_runtime = "static",
    dev_dependency = True,
)

register_toolchains(
    "@android_ndk_toolchain//:ndk_cc_toolchain_device",
    "@android_ndk_toolchain//:ndk_cc_toolchain_emulator",
    dev_dependency = True,
)

_android_sdk_extension = use_extension("@rules_android//rules/android_sdk_repository:rule.bzl", "android_sdk_repository_extension")

android_sdk = use_extension("//sdk:repos.bzl", "android_sdk")
use_repo(android_sdk, "dx_android_ndk_linux_x86_64", "dx_android_sdk", "dx_androidsdk")
override_repo(_android_sdk_extension, androidsdk = "dx_androidsdk")

android_sdk_dev = use_extension("//sdk:repos.bzl", "android_sdk", dev_dependency = True)
android_sdk_dev.configure(accept_licenses = ["android-sdk-license"])

rules_java_toolchains = use_extension("@rules_java//java:extensions.bzl", "toolchains")
use_repo(rules_java_toolchains, "remote_java_tools")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust", dev_dependency = True)
rust.toolchain(
    edition = "2024",
    extra_target_triples = [
        "aarch64-linux-android",
        "x86_64-linux-android",
    ],
    rustfmt_version = "1.99.1",
    versions = ["1.99.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains(
    "@rust_toolchains//:all",
    dev_dependency = True,
)
