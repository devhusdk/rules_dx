load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load(":metadata_tests.bzl", "android_metadata_tests")

package(default_visibility = ["//visibility:public"])

exports_files([
    "metadata_tests.bzl",
    "repos.bzl",
])

android_metadata_tests(name = "metadata")

