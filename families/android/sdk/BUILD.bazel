build_test(
    name = "androidsdk_build_test",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    targets = [
        "@dx_androidsdk//:sdk",
        "@dx_androidsdk//:sdk-toolchain",
        "@dx_androidsdk//:aapt2_binary",
        "@dx_androidsdk//:d8_jar_import",
        "@dx_androidsdk//:files",
    ],
)
