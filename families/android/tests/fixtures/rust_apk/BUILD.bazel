# gazelle:ignore

load("@rules_dx//cc/rules:defs.bzl", "cc_library")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust/rules:defs.bzl", "rust_static_library", "rust_test")
load("@rules_java//java:java_binary.bzl", "java_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//packaging:defs.bzl", "android_adb_install", "android_adb_log", "android_adb_start", "android_apk_set", "android_check", "android_sign", "rust_android_apk")
load(":starlark_platforms.bzl", "starlark_platforms")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

rust_static_library(
    name = "app_rust",
    srcs = ["src/lib.rs"],
    crate_name = "rust_apk",
)

rust_test(
    name = "app_rust_test",
    crate = ":app_rust",
)

cc_library(
    name = "app_jni",
    srcs = ["activity.c"],
    linkopts = [
        "-landroid",
        "-llog",
    ],
    target_compatible_with = ["@platforms//os:android"],
    deps = [":app_rust"],
    alwayslink = True,
)

rust_android_apk(
    name = "app_apk",
    testonly = True,
    app_id = "com.example.dxrustapk",
    assets = glob(["assets/**"]),
    assets_dir = "assets",
    permissions = ["android.permission.INTERNET"],
    resource_files = glob(["res/**"]),
    visibility = ["//visibility:public"],
    deps = [":app_jni"],
)

rust_android_apk(
    name = "arm_apk",
    testonly = True,
    app_id = "com.example.dxrustapk",
    assets = glob(["assets/**"]),
    assets_dir = "assets",
    permissions = ["android.permission.INTERNET"],
    platforms = ["arm64-v8a"],
    resource_files = glob(["res/**"]),
    deps = [":app_jni"],
)

android_adb_install(
    name = "install",
    apk = ":app_apk_file",
    serial = "emulator-5554",
)

android_adb_install(
    name = "install_probe",
    apk = ":dummy.apk",
    serial = "emulator-5554",
)

java_binary(
    name = "test_bundle_module",
    srcs = ["TestBundleModule.java"],
    main_class = "TestBundleModule",
    deps = ["//packaging:bundletool_jar"],
)

genrule(
    name = "test_bundle",
    outs = ["test_bundle.aab"],
    cmd = "work=$$(mktemp -d) && " +
          "$(execpath :test_bundle_module) $$work/base.zip com.example.dxbundle 31 x86_64 && " +
          "$(execpath //packaging:bundletool) build-bundle --modules=$$work/base.zip --output=$@ && " +
          "rm -rf $$work",
    tools = [
        ":test_bundle_module",
        "//packaging:bundletool",
    ],
)

android_check(
    name = "check_test_bundle_test",
    package = ":test_bundle.aab",
    platforms = ["x86_64"],
)

android_apk_set(
    name = "test_bundle_set",
    aab = ":test_bundle.aab",
    device_spec = ":device_x86_64.json",
)

android_adb_install(
    name = "install_set_probe",
    apk_set = ":test_bundle_set",
    serial = "emulator-5554",
)

android_apk_set(
    name = "app_apk_set",
    aab = ":app_apk_aab_file",
    device_spec = ":device_x86_64.json",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

android_adb_install(
    name = "install_set",
    apk_set = ":app_apk_set",
    serial = "emulator-5554",
)

android_adb_start(
    name = "start",
    app_id = "com.example.dxrustapk",
    serial = "emulator-5554",
)

android_adb_log(
    name = "log",
    serial = "emulator-5554",
)

rust_android_apk(
    name = "custom_apk",
    testonly = True,
    api_level = 33,
    app_id = "org.example.custom.dxrustapk",
    assets = glob(["assets/**"]),
    assets_dir = "assets",
    permissions = [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE",
    ],
    platforms = ["x86_64"],
    resource_files = glob(["res/**"]),
    version_code = 7,
    version_name = "2.3",
    visibility = ["//visibility:public"],
    deps = [":app_jni"],
)

android_adb_install(
    name = "install_custom",
    apk = ":custom_apk_file",
    serial = "emulator-5554",
)

android_adb_start(
    name = "start_custom",
    app_id = "org.example.custom.dxrustapk",
    serial = "emulator-5554",
)

