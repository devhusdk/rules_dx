+def _repo_sysroot_root(rustc, bins, trees):
+    """Find the repository directory that already is the sysroot.
+
+    Args:
+        rustc (File): The `rustc` executable.
+        bins (list[File]): The other executables of the sysroot.
+        trees (list[depset]): The files that are copied into the sysroot.
+
+    Returns:
+        str: The directory holding `bin/rustc` when every file lives under it,
+            else None.
+    """
+    suffix = "/bin/" + rustc.basename
+    if not rustc.path.endswith(suffix):
+        return None
+    root = rustc.path[:-len(suffix)] + "/"
+    for file in bins:
+        if not file.path.startswith(root):
+            return None
+    for tree in trees:
+        for file in tree.to_list():
+            if not file.path.startswith(root):
+                return None
+    return root[:-1]
+
