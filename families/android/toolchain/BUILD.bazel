load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load(":cc_toolchain_config.bzl", "ndk_cc_toolchain_config")
load(":metadata_tests.bzl", "android_toolchain_tests")

package(default_visibility = ["//visibility:public"])

exports_files([
    "cc_toolchain_config.bzl",
    "metadata_tests.bzl",
    "repos.bzl",
])

android_toolchain_tests(name = "metadata")

ndk_cc_toolchain_config(
    name = "fake_config",
    api_level = 31,
    ar = ":cc_toolchain_config.bzl",
    clang = ":cc_toolchain_config.bzl",
    clang_resource_dir = "/fake/clang",
    clang_target = "aarch64-linux-android31",
    cpu = "aarch64",
    cxx_include_dir = "/fake/c++",
    cxx_runtime = "shared",
    ndk_sysroot = "/fake/sysroot",
    rust_triple = "aarch64-linux-android",
    strip = ":cc_toolchain_config.bzl",
    tags = ["manual"],
    tuple = "device",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "cc_toolchain_config.bzl",
        "metadata_tests.bzl",
        "repos.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(
        ["**"],
        exclude = ["**/tests/**"],
    ),
    visibility = ["//visibility:public"],
)
