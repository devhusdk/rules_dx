load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

exports_files(["README.md"])

filegroup(
    name = "module_srcs",
    srcs = [
        ".bazelversion",
        "BUILD.bazel",
        "MODULE.bazel",
        "MODULE.bazel.lock",
        "//bundle:module_srcs",
        "//ios:module_srcs",
        "//macos:module_srcs",
        "//provisioning:module_srcs",
        "//signing:module_srcs",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["@rules_dx//quality:corpus_vale_config"],
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

sh_test(
    name = "starlark_docs_test",
    srcs = ["starlark_docs_test.sh"],
    args = ["$(rootpath @rules_dx//tools/ci:starlark_docs_family_test)"],
    data = [
        "//bundle:corpus_starlark",
        "//ios:corpus_starlark",
        "//macos:corpus_starlark",
        "//provisioning:corpus_starlark",
        "//signing:corpus_starlark",
        "//tests:corpus_starlark",
        "@rules_dx//tools/ci:starlark_docs_family_test",
    ],
    env = {"STARLARK_DOCS_PACKAGES": "bundle,ios,macos,provisioning,signing,tests"},
)

# dx:begin exports
exports_files(
    [".buildifier.json"],
    visibility = ["//.dx:__pkg__"],
)
# dx:end exports
