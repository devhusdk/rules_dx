# keep
# size: large, nested Bazel consumer build, see #5689
rust_test(
    name = "macos_app_sign_smoke_test",
    size = "large",
    srcs = [
        "consumer.rs",
        "macos.rs",
        "macos_app_consumer_test.rs",
        "signing.rs",
    ],
    crate_root = "macos_app_consumer_test.rs",
    data = ["//:module_srcs", "@rules_dx//:module_srcs"] + NESTED_BAZEL_DATA,
    env = {"RUST_TEST_THREADS": "1"} | NESTED_BAZEL_NETWORK_ENV,
    env_inherit = [
        "HOME",
        "PATH",
    ],
    # Fetches the Apple toolchain archives.
    tags = NESTED_BAZEL_NETWORK_TAGS + ["manual"],
    target_compatible_with = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
    deps = [
        "@rules_dx//tools/testing:dx_nested",
        "@rules_dx//tools/testing:dx_testing",
    ],
)

