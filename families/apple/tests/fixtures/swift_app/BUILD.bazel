# gazelle:ignore
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_swift//swift:swift_interop_hint.bzl", "swift_interop_hint")
load("//ios:app.bzl", "apple_ios_app", "apple_ios_app_test")
load("//ios:cell.bzl", "APPLE_HOSTS")
load("@rules_dx//cc/rules:defs.bzl", "cc_library")
load("@rules_dx//rust/rules:defs.bzl", "rust_static_library")
load("@rules_dx//swift/rules:defs.bzl", "swift_library")

_MACOS_ARM64 = [
    "@platforms//os:macos",
    "@platforms//cpu:arm64",
]

rust_static_library(
    name = "ledger_rust",
    tags = ["manual"],
    srcs = ["ledger.rs"],
    edition = "2021",
    target_compatible_with = APPLE_HOSTS,
)

swift_interop_hint(
    name = "ledger_core_hint",
    tags = ["manual"],
    module_name = "LedgerCore",
    target_compatible_with = APPLE_HOSTS,
)

cc_library(
    name = "ledger_core",
    tags = ["manual"],
    visibility = ["//tests/fixtures/swift_app/main:__pkg__"],
    hdrs = ["ledger.h"],
    aspect_hints = [":ledger_core_hint"],
    target_compatible_with = APPLE_HOSTS,
)

swift_library(
    name = "ledger_kit",
    tags = ["manual"],
    visibility = ["//tests/fixtures/swift_app/main:__pkg__"],
    srcs = ["LedgerKit.swift"],
    module_name = "LedgerKit",
    target_compatible_with = APPLE_HOSTS,
)

swift_library(
    name = "ledger_xctests",
    tags = ["manual"],
    testonly = True,
    srcs = ["LedgerAppTests.swift"],
    module_name = "LedgerAppTests",
    target_compatible_with = APPLE_HOSTS,
    deps = [
        ":ledger_core",
        ":ledger_kit",
    ],
)

apple_ios_app(
    name = "ledger_app",
    bundle_id = "com.example.ledger",
    deployment = "17.0",
    entry = "//tests/fixtures/swift_app/main:ledger_main",
    library = ":ledger_rust",
    platform = "@apple_support//platforms:ios_sim_arm64",
    resources = ["entries.txt"],
    tags = ["manual"],
    version = "1.4",
    visibility = ["//ios:__pkg__"],
)

apple_ios_app(
    name = "ledger_device",
    bundle_id = "com.example.ledger.device",
    deployment = "17.0",
    entry = "//tests/fixtures/swift_app/main:ledger_main",
    library = ":ledger_rust",
    platform = "@apple_support//platforms:ios_arm64",
    provisioning_profile = "ledger_device.mobileprovision",
    resources = ["entries.txt"],
    tags = ["manual"],
    version = "1.4",
)

apple_ios_app_test(
    name = "ledger_app_test",
    size = "large",
    app = ":ledger_app",
    deployment = "17.0",
    device_type = "iPhone 16",
    os_version = "18.5",
    deps = [":ledger_xctests"],
)

sh_test(
    name = "ledger_device_ipa_test",
    srcs = ["check_ipa.sh"],
    args = [
        "$(rootpaths :ledger_device)",
        "com.example.ledger.device",
        "iphoneos",
        "2",
    ],
    data = [":ledger_device"],
    target_compatible_with = _MACOS_ARM64,
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)
