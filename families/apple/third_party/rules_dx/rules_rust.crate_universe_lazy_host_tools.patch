+def _trust_lockfile(module_ctx, cfg, is_root):
+    """Whether to render from `cfg.lockfile` without its digest check, so cargo and rustc are not fetched.
+
+    A repin or `CARGO_BAZEL_DIGEST_CHECK=1` still checks the digest. Without the check a stale
+    lockfile shows up as missing crates rather than as an "out of date" error.
+    """
+    if not cfg.lockfile:
+        return False
+    if not is_root:
+        return True
+    if module_ctx.getenv(CARGO_BAZEL_DIGEST_CHECK):
+        return False
+    for var in REPIN_ENV_VARS:
+        value = module_ctx.getenv(var)
+        if value != None and value.lower() not in ["false", "no", "0", "off"]:
+            allowlist = module_ctx.getenv(REPIN_ALLOWLIST_ENV_VAR)
+            if allowlist == None or cfg.name in allowlist.split(","):
+                return False
+    return True
+
