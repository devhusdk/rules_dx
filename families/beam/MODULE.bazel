module(
    name = "rules_dx_beam",
    version = "0.0.0",
    bazel_compatibility = [">=9.2.0"],
)

bazel_dep(name = "rules_dx", version = "0.0.0")
include("//third_party/rules_dx:rules_dx.MODULE.bazel")
local_path_override(
    module_name = "rules_dx",
    path = "../..",
)

# floor: equals tested
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "rules_rust", version = "0.75.0", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.8.0")

erlang = use_extension("@rules_dx//erlang/toolchain:repos.bzl", "erlang")
use_repo(erlang, "dx_erlang_toolchains")

elixir = use_extension("@rules_dx//elixir/toolchain:repos.bzl", "elixir")
elixir.mix(
    name = "elixir_app_deps",
    lock = "//elixir/tests/fixtures/elixir-app:mix.lock",
)
use_repo(elixir, "dx_elixir_toolchains", "elixir_app_deps")

_http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

_http_archive(
    name = "erlang_app_thoas",
    build_file = "//erlang/tests/fixtures/erlang-app:thoas.BUILD.bazel",
    sha256 = "9187a4a283a4cdb0640d9ab84575e2cbe47fe68366fd47ea4a8a983def415207",
    strip_prefix = "thoas-1.2.1",
    urls = ["https://github.com/lpil/thoas/archive/refs/tags/v1.2.1.tar.gz"],
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust", dev_dependency = True)
rust.toolchain(
    edition = "2024",
    rustfmt_version = "1.99.1",
    versions = ["1.99.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains(
    "@rust_toolchains//:all",
    dev_dependency = True,
)

register_toolchains(
    "@dx_elixir_toolchains//:all",
    "@dx_erlang_toolchains//:all",
)
