load("@rules_dx//elixir/rules:defs.bzl", "ELIXIR_COMPATIBLE_WITH", "elixir_app", "elixir_test", "escript_archive", "escript_headers")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")

exports_files(
    glob([
        "lib/**",
        "test/*",
    ]) + ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

elixir_app(
    name = "erlang_app",
    app_description = "Command-line client for the stock ledger.",
    app_name = "stockctl",
    app_version = "1.0.0",
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
    deps = ["//elixir/tests/fixtures/elixir-app/stock:erlang_app"],
)

escript_archive(
    name = "stockctl",
    app = ":erlang_app",
    headers = escript_headers("Stockctl"),
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
)

elixir_test(
    name = "stockctl_test",
    srcs = [
        "test/stockctl_test.exs",
        "test/test_helper.exs",
    ],
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
    tools = [":stockctl"],
    deps = [":erlang_app"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//visibility:public"],
)
