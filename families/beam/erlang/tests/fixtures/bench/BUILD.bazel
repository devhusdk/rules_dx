load("@rules_dx//erlang/rules:defs.bzl", "ERLANG_COMPATIBLE_WITH", "erlang_app", "erlang_bench", "test_erlang_app")
load("@rules_dx//libs/starlark:fuzz_bench_tests.bzl", "dx_runner_attr_test")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")

exports_files(
    glob([
        "src/*",
        "test/*",
    ]) + ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

erlang_app(
    app_description = "Sums a list two ways.",
    app_name = "sum",
