    target_compatible_with = ERLANG_COMPATIBLE_WITH,
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

dx_runner_attr_test(
    name = "sum_bench_SUITE_default_size",
