)

test_erlang_app(
    app_description = "Sums a list two ways.",
    app_name = "sum",
    app_version = "1.0.0",
    target_compatible_with = ERLANG_COMPATIBLE_WITH,
)

erlang_bench(
    name = "sum_bench_SUITE",
