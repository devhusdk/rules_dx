load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# gazelle:exclude testing
# gazelle:exclude tests

package(default_visibility = ["//visibility:public"])

exports_files(["README.md"])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["@rules_dx//quality:corpus_vale_config"],
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

sh_test(
    name = "starlark_docs_test",
    srcs = ["starlark_docs_test.sh"],
    args = ["$(rootpath @rules_dx//tools/ci:starlark_docs_family_test)"],
    data = [
        "//rules:corpus_starlark",
        "//toolchain:corpus_starlark",
        "@rules_dx//tools/ci:starlark_docs_family_test",
    ],
    env = {"STARLARK_DOCS_PACKAGES": "rules,toolchain"},
)

sh_test(
    name = "rustfmt_coverage_test",
    srcs = ["starlark_docs_test.sh"],
    args = ["$(rootpath @rules_dx//tools/ci:rustfmt_coverage_family_test)"],
    data = [
        "//tests:corpus_starlark",
        "//tests/fixtures/cuda-app/checks:corpus_starlark",
        "@rules_dx//tools/ci:rustfmt_coverage_family_test",
    ],
    env = {"RUSTFMT_COVERAGE_PACKAGES": "tests,tests/fixtures/cuda-app/checks"},
)

# dx:begin exports
exports_files(
    [".buildifier.json"],
    visibility = ["//.dx:__pkg__"],
)
