module(
    name = "rules_dx_cuda",
    version = "0.0.0",
    bazel_compatibility = [">=9.2.0"],
)

bazel_dep(name = "rules_dx", version = "0.0.0")
include("//third_party/rules_dx:rules_dx.MODULE.bazel")
local_path_override(
    module_name = "rules_dx",
    path = "../..",
)

# floor: equals tested
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "googletest", version = "1.18.0.bcr.1", dev_dependency = True)
bazel_dep(name = "llvm", version = "0.8.26")
bazel_dep(name = "rules_rust", version = "0.75.0", dev_dependency = True)

# floor: equals tested; 0.4.0-beta1 carries the device link include fix; patched, consumers are pinned by the dx include (#5975, #4704)
bazel_dep(name = "rules_cuda", version = "0.4.0-beta1")

cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
use_repo(cuda, "cuda")

cuda_dev = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain", dev_dependency = True)
cuda_dev.redist_json(
    name = "cuda_redist",
    components = ["cccl", "crt", "cublas", "cudart", "cufft", "curand", "nvcc", "nvvm"],
    platforms = ["linux-x86_64", "linux-sbsa", "windows-x86_64", "windows-arm64"],
    sha256 = "015b97aa3977d4d0bade1631b226b6d4cbe48751cc841aad9193295df7f9047a",
    version = "13.4.2",
)
cuda_dev.toolkit(
    name = "cuda",
    nvcc_version = "13.4",
)

cuda_license = use_extension("//toolchain:repos.bzl", "cuda_license")
use_repo(cuda_license, "dx_cuda_license")

cuda_license_dev = use_extension("//toolchain:repos.bzl", "cuda_license", dev_dependency = True)
cuda_license_dev.license(accept = ["cuda-eula"])

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust", dev_dependency = True)
rust.toolchain(
    edition = "2024",
    rustfmt_version = "1.99.1",
    versions = ["1.99.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains(
    "@rust_toolchains//:all",
    dev_dependency = True,
)
