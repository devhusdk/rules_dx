# keep
rust_test(
    name = "saxpy_device_code_test",
    srcs = ["saxpy_device_code_test.rs"],
    data = [
        "//tests/fixtures/saxpy",
        "//tests/fixtures/saxpy:saxpy_app",
    ],
    env = {
        "DX_CUDA_ARCHIVES": "$(rootpaths //tests/fixtures/saxpy)",
        "DX_CUDA_BINARY": "$(rootpath //tests/fixtures/saxpy:saxpy_app)",
    },
    target_compatible_with = CUDA_TARGET,
    deps = ["@rules_dx//tools/testing:dx_testing"],
)

cuda_test(
    name = "saxpy_gpu_test",
    srcs = ["saxpy_gpu_test.cu"],
    platforms = [
        "compute_89:compute_89,sm_89",
        "sm_120",
    ],
    min_compute_capability = "8.9",
    min_driver = "13.0",
    tags = ["manual"],
    deps = ["//tests/fixtures/saxpy"],
)

