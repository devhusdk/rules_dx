real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "cell_tests.bzl",
        "defs.bzl",
    ],
    tags = ["corpus"],
    visibility = ["//:__pkg__"],
)

platform(
    name = "windows_x86_64_platform",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

