load("//rules:defs.bzl", "cuda_test")

package(default_visibility = ["//tests:__subpackages__"])

# Run under `bazel coverage`: the host code in clamp.cu is instrumented with llvm-cov and
# its lines reach the LCOV report. Device code is not covered.
cuda_test(
    name = "clamp_test",
    srcs = [
        "clamp.cu",
        "main.cc",
    ],
    hdrs = ["clamp.h"],
    cuda_archs = [
        "sm_89",
        "sm_120",
    ],
)
