load("@rules_dx//cc/rules:defs.bzl", "cc_binary")
load("//rules:defs.bzl", "CUDA_TARGET", "cuda_library")

package(default_visibility = ["//tests:__subpackages__"])

cuda_library(
    name = "cublas",
    srcs = ["cublas_saxpy.cu"],
    hdrs = ["cublas_saxpy.h"],
    platforms = [
        "compute_89:compute_89,sm_89",
        "sm_120",
    ],
    # The license-gated pinned component, never @cuda//:cublas.
    deps = ["//components:cublas"],
)

cc_binary(
    name = "cublas_app",
    srcs = ["main.cc"],
    target_compatible_with = CUDA_TARGET,
    deps = [":cublas"],
)
