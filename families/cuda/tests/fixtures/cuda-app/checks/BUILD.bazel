load("//rules:defs.bzl", "CUDA_TARGET")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust:defs.bzl", "rust_test")

package(default_visibility = ["//visibility:private"])

rust_test(
    name = "device_code_test",
    srcs = ["device_code_test.rs"],
    data = [
        "//tests/fixtures/cuda-app/app:cuda_app",
        "//tests/fixtures/cuda-app/kernels",
    ],
    env = {
        "DX_CUDA_ARCHIVES": "$(rootpaths //tests/fixtures/cuda-app/kernels)",
        "DX_CUDA_BINARY": "$(rootpath //tests/fixtures/cuda-app/app:cuda_app)",
    },
    target_compatible_with = CUDA_TARGET,
    deps = ["@rules_dx//tools/testing:dx_testing"],
)

rust_test(
    name = "format_test",
    srcs = ["@rules_dx//tools/testing:clang_format_test.rs"],
    data = [
        "@rules_dx//:.clang-format",
        "//tests/fixtures/cuda-app/app:format_srcs",
        "//tests/fixtures/cuda-app/gpu:format_srcs",
        "//tests/fixtures/cuda-app/kernels:format_srcs",
        "@llvm//tools:clang-format",
    ],
    env = {
        "DX_CLANG_FORMAT": "$(rootpath @llvm//tools:clang-format)",
        "DX_CLANG_FORMAT_STYLE": "$(rootpath @rules_dx//:.clang-format)",
        "DX_FORMAT_SRCS": "$(rootpaths //tests/fixtures/cuda-app/app:format_srcs) $(rootpaths //tests/fixtures/cuda-app/gpu:format_srcs) $(rootpaths //tests/fixtures/cuda-app/kernels:format_srcs)",
    },
    deps = ["@rules_dx//tools/testing:dx_testing"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//:__pkg__"],
)
