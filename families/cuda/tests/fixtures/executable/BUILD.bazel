load("//rules:defs.bzl", "cuda_binary", "cuda_test")

package(default_visibility = ["//tests:__subpackages__"])

_ARCHS = [
    "sm_89",
    "sm_120",
]

cuda_binary(
    name = "binary",
    srcs = [
        "add.cu",
        "main.cc",
    ],
    hdrs = ["add.h"],
    platforms = _ARCHS,
)

cuda_binary(
    name = "rdc_binary",
    srcs = [
        "add.cu",
        "rdc_main.cc",
    ],
    hdrs = ["add.h"],
    platforms = _ARCHS,
    rdc = True,
    deps = ["//tests/fixtures/rdc:axpy"],
)

cuda_test(
    name = "test",
    srcs = [
        "add.cu",
        "main.cc",
    ],
    hdrs = ["add.h"],
    platforms = _ARCHS,
)

cuda_test(
    name = "rdc_test",
    srcs = [
        "add.cu",
        "rdc_main.cc",
    ],
    hdrs = ["add.h"],
    platforms = _ARCHS,
    rdc = True,
    deps = ["//tests/fixtures/rdc:axpy"],
)

cuda_binary(
    name = "defines_binary",
    srcs = [
        "defines.cu",
        "defines_main.cc",
    ],
    cuda_copts = ["-DDX_EXEC_NVCC"],
    defines = ["DX_EXEC_PUBLIC"],
    local_defines = ["DX_EXEC_N=1024"],
    platforms = _ARCHS,
)

cuda_test(
    name = "defines_test",
    srcs = [
        "defines.cu",
        "defines_main.cc",
    ],
    cuda_copts = ["-DDX_EXEC_NVCC"],
    defines = ["DX_EXEC_PUBLIC"],
    local_defines = ["DX_EXEC_N=1024"],
    platforms = _ARCHS,
)
