module(
    name = "rules_dx_dart",
    version = "0.0.0",
    bazel_compatibility = [">=9.2.0"],
)

bazel_dep(name = "rules_dx", version = "0.0.0")

include("//third_party/rules_dx:rules_dx.MODULE.bazel")

local_path_override(
    module_name = "rules_dx",
    path = "../..",
)

# floor: equals tested
bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_rust", version = "0.75.0", dev_dependency = True)

# floor: equals tested; forced by rules_dart 0.8.1 MVS (#1783)
bazel_dep(name = "rules_dart", version = "0.8.1")

# floor: equals tested
bazel_dep(name = "rules_flutter", version = "0.0.8")

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.7")

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.toolchain(flutter_version = "3.47.8")
flutter.pub(
    name = "dx_flutter_deps",
    lock = "//flutter/tests/runtime:pubspec.lock",
)
use_repo(flutter, "dx_flutter_deps")

pub = use_extension("@rules_dx//dart:extensions.bzl", "pub")
pub.from_lock(
    name = "dx_dart_deps",
    lock = "@rules_dx//third_party/dart:pubspec.lock",
    on_version_conflict = "upgrade",
)

# Fetching a padded archive guards the pinned bsdtar in @rules_dx//dart:repos.bzl.
pub.from_lock(
    name = "dx_dart_padded_archive",
    lock = "//dart/tests:padded_archive.pubspec.lock",
)
use_repo(pub, "dx_dart_deps", "dx_dart_padded_archive")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust", dev_dependency = True)
rust.toolchain(
    edition = "2024",
    rustfmt_version = "1.99.1",
    versions = ["1.99.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains(
    "@rust_toolchains//:all",
    dev_dependency = True,
)
