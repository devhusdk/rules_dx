module(
    name = "rules_dx_dotnet",
    version = "0.0.0",
    bazel_compatibility = [">=9.2.0"],
)

bazel_dep(name = "rules_dx", version = "0.0.0")
include("//third_party/rules_dx:rules_dx.MODULE.bazel")
local_path_override(
    module_name = "rules_dx",
    path = "../..",
)

# floor: equals tested
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "36.2")
bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "rules_rust", version = "0.75.0", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.8.0")

dotnet_tools = use_extension("@rules_dx//dotnet:repos.bzl", "dotnet_tools")
use_repo(dotnet_tools, "rules_dotnet")

paket = use_extension("@rules_dx//third_party/dotnet:extension.bzl", "paket")
use_repo(paket, "paket.main")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust", dev_dependency = True)
rust.toolchain(
    edition = "2021",
    rustfmt_version = "1.99.1",
    versions = ["1.99.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains(
    "@rust_toolchains//:all",
    dev_dependency = True,
)
