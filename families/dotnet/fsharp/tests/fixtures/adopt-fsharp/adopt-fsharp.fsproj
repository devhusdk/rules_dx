<!-- Foreign SDK-style project marker: one pinned module dep (FSharp.Core
     10.1.201, matching third_party/dotnet/paket.lock plus @paket.main hub).
     The F# Gazelle extension reads only `.fs` sources; generation never
     writes this file. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.201" />
  </ItemGroup>
</Project>
