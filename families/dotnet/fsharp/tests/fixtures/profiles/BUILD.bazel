load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust/rules:defs.bzl", "rust_test", "rustfmt_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

[
    genrule(
        name = "lint_" + name,
        testonly = True,
        srcs = ["Short.fs"] + configs,
        outs = ["lint_" + name + ".jsonl"],
        cmd = "$(location @rules_dx//quality/tools/dotnet/fsharplint:runner) %s --compile $$PWD/$(location Short.fs) $$PWD/$(location Short.fs) > $@ || test $$? -le 1" % (
            "--config $$PWD/$(location %s)" % configs[0] if configs else ""
        ),
        tools = ["@rules_dx//quality/tools/dotnet/fsharplint:runner"],
    )
    for name, configs in {
        "default": [],
        "standard": ["@rules_dx//quality/tiers/fsharplint:standard.json"],
        "strict": ["@rules_dx//quality/tiers/fsharplint:strict.json"],
    }.items()
]

rust_test(
    name = "profiles_test",
    srcs = ["profiles_test.rs"],
    data = [
        ":lint_default",
        ":lint_standard",
        ":lint_strict",
    ],
    env = {
        "DX_DEFAULT_LINT": "$(rootpath :lint_default)",
        "DX_STANDARD_LINT": "$(rootpath :lint_standard)",
        "DX_STRICT_LINT": "$(rootpath :lint_strict)",
    },
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["@rules_dx//tools/testing:dx_testing"],
)

rustfmt_test(
    name = "profiles_fmt_test",
    targets = [":profiles_test"],
)
