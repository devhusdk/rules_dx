module(
    name = "rules_dx_fortran",
    version = "0.0.0",
    bazel_compatibility = [">=9.2.0"],
)

bazel_dep(name = "rules_dx", version = "0.0.0")
include("//third_party/rules_dx:rules_dx.MODULE.bazel")
local_path_override(
    module_name = "rules_dx",
    path = "../..",
)

fortran = use_extension("@rules_dx//fortran/toolchain:repos.bzl", "fortran")
use_repo(fortran, "dx_fortran_toolchains")

register_toolchains("@dx_fortran_toolchains//:all")
