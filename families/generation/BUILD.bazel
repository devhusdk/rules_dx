load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["@rules_dx//quality:corpus_vale_config"],
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

sh_test(
    name = "starlark_docs_test",
    srcs = ["starlark_docs_test.sh"],
    args = ["$(rootpath @rules_dx//tools/ci:starlark_docs_family_test)"],
    data = [
        "//api_spec/tests:corpus_starlark",
        "//api_spec/tests/shared:corpus_starlark",
        "//avro/tests:corpus_starlark",
        "//capnproto/tests:corpus_starlark",
        "//capnproto/tests/api:corpus_starlark",
        "//capnproto/tests/base:corpus_starlark",
        "//capnproto/tests/dup:corpus_starlark",
        "//flatbuffers/tests:corpus_starlark",
        "//flatbuffers/tests/api:corpus_starlark",
        "//flatbuffers/tests/base:corpus_starlark",
        "//flatbuffers/tests/conform/bad:corpus_starlark",
        "//flatbuffers/tests/conform/v1:corpus_starlark",
        "//flatbuffers/tests/conform/v2:corpus_starlark",
        "//flatbuffers/tests/lost:corpus_starlark",
        "//flatbuffers/tests/multi:corpus_starlark",
        "//thrift/tests:corpus_starlark",
        "//thrift/tests/api:corpus_starlark",
        "//thrift/tests/base:corpus_starlark",
        "@rules_dx//tools/ci:starlark_docs_family_test",
    ],
    env = {"STARLARK_DOCS_PACKAGES": "api_spec/tests,api_spec/tests/shared,avro/tests,capnproto/tests,capnproto/tests/api,capnproto/tests/base,capnproto/tests/dup,flatbuffers/tests,flatbuffers/tests/api,flatbuffers/tests/base,flatbuffers/tests/conform/bad,flatbuffers/tests/conform/v1,flatbuffers/tests/conform/v2,flatbuffers/tests/lost,flatbuffers/tests/multi,thrift/tests,thrift/tests/api,thrift/tests/base"},
)

filegroup(
    name = "module_srcs",
    srcs = glob(
        ["**"],
        exclude = ["**/tests/**"],
    ),
    visibility = ["//visibility:public"],
)

# dx:begin exports
exports_files(
    [".buildifier.json"],
    visibility = ["//.dx:__pkg__"],
)
# dx:end exports
