module(
    name = "rules_dx_haskell",
    version = "0.0.0",
    bazel_compatibility = [">=9.2.0"],
)

bazel_dep(name = "rules_dx", version = "0.0.0")
include("//third_party/rules_dx:rules_dx.MODULE.bazel")
local_path_override(
    module_name = "rules_dx",
    path = "../..",
)

haskell = use_extension("@rules_dx//haskell/toolchain:extensions.bzl", "haskell")
use_repo(haskell, "dx_haskell_toolchains")

register_toolchains("@dx_haskell_toolchains//toolchains:all")
