load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@dx_js_npm//:defs.bzl", "npm_link_all_packages")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# gazelle:exclude javascript/tests/fixtures
# gazelle:exclude astro/tests/app
# gazelle:exclude astro/tests/app_config/configs
