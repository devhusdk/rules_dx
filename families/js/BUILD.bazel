package(default_visibility = ["//visibility:public"])

exports_files([
    "README.md",
    "biome.json",
    "package.json",
    "pnpm-lock.yaml",
])

js_library(
    name = "package_json",
    srcs = ["package.json"],
)

npm_link_all_packages(name = "node_modules")

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["@rules_dx//quality:corpus_vale_config"],
    markdown_srcs = [
        "README.md",
        "javascript/README.md",
        "typescript/README.md",
    ],
    tags = ["corpus"],
)

sh_test(
    name = "starlark_docs_test",
    srcs = ["starlark_docs_test.sh"],
    args = ["$(rootpath @rules_dx//tools/ci:starlark_docs_family_test)"],
    data = [
        "//astro/tests/app:corpus_starlark",
        "//astro/tests/app_config:corpus_starlark",
        "//astro/tests/typecheck:corpus_starlark",
        "//javascript/tests/typecheck:corpus_starlark",
        "//mdx/tests/app:corpus_starlark",
        "//mdx/tests/typecheck:corpus_starlark",
        "//svelte/tests/app:corpus_starlark",
        "//svelte/tests/app_errors:corpus_starlark",
        "//svelte/tests/app_errors/throwing:corpus_starlark",
        "//svelte/tests/typecheck:corpus_starlark",
        "//typescript/tests/tags:corpus_starlark",
        "//typescript/tests/typecheck_profiles:corpus_starlark",
        "//vue/tests/app:corpus_starlark",
        "//vue/tests/typecheck:corpus_starlark",
        "@rules_dx//tools/ci:starlark_docs_family_test",
    ],
    env = {"STARLARK_DOCS_PACKAGES": "astro/tests/app,astro/tests/app_config,astro/tests/typecheck,javascript/tests/typecheck,mdx/tests/app,mdx/tests/typecheck,svelte/tests/app,svelte/tests/app_errors,svelte/tests/app_errors/throwing,svelte/tests/typecheck,typescript/tests/tags,typescript/tests/typecheck_profiles,vue/tests/app,vue/tests/typecheck"},
)

# dx:begin exports
exports_files(
    [".buildifier.json"],
    visibility = ["//.dx:__pkg__"],
)
# dx:end exports
