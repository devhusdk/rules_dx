load("@rules_dx//libs/starlark:fuzz_bench_tests.bzl", "dx_runner_attr_test")
load("@rules_dx//javascript:defs.bzl", "javascript_fuzz_test")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

javascript_fuzz_test(
    name = "parse_fuzz",
    srcs = ["parse_fuzz.cjs"],
    node_modules = "//:node_modules",
)

sh_test(
    name = "parse_fuzz_run_test",
    srcs = ["run_test.sh"],
    args = [
        "$(rlocationpath @rules_dx//libs/fuzz_run:fuzz_run)",
        "$(rootpath :parse_fuzz)",
    ],
    data = [
        ":parse_fuzz",
        "@rules_dx//libs/fuzz_run:fuzz_run",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    timeout = "short",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

dx_runner_attr_test(
    name = "parse_fuzz_attrs",
    expected = {"tags": ["dx-fuzz", "manual"]},
    runner = "parse_fuzz",
)

dx_runner_attr_test(
    name = "parse_fuzz_run_attrs",
    expected = {"args": [
        "libfuzzer",
        "$(rootpath :parse_fuzz)",
    ]},
    runner = "parse_fuzz_run",
)
