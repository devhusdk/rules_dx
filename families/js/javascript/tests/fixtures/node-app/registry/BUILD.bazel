load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@npm_node_app//:defs.bzl", "npm_link_all_packages")
load("@rules_dx//typescript/rules:defs.bzl", "typescript_library", "typescript_test")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//javascript/tests/fixtures/node-app:__subpackages__"])

exports_files(
    [
        "VERSION",
        "jest.config.cjs",
        "package.json",
        "packages.json",
        "plain_test.ts",
        "registry.ts",
        "registry_test.ts",
        "tsconfig.json",
    ] + glob(["malformed/*"]),
    visibility = ["//visibility:public"],
)

npm_link_all_packages(name = "node_modules")

genrule(
    name = "build_info",
    srcs = ["VERSION"],
    outs = ["build_info.ts"],
    cmd = "printf 'export const SCHEMA = %s;\\n' \"$$(cat $<)\" > $@",
)

typescript_library(
    name = "registry",
    srcs = [
        "registry.ts",
        ":build_info",
    ],
    data = ["packages.json"],
    declaration = True,
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
    visibility = ["//javascript/tests/fixtures/node-app:__subpackages__"],
    deps = [
        "//javascript/tests/fixtures/node-app:node_modules/@types/semver",
        ":node_modules/semver",
    ],
)

npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        ":registry",
    ],
    visibility = ["//javascript/tests/fixtures/node-app:__subpackages__"],
)

typescript_test(
    name = "registry_test",
    srcs = ["registry_test.ts"],
    config = "jest.config.cjs",
    declaration = True,
    node_modules = "//javascript/tests/fixtures/node-app:node_modules",
    node_options = ["--experimental-vm-modules"],
    package_json = "//javascript/tests/fixtures/node-app:package_json",
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
    deps = [":registry"],
)

typescript_test(
    name = "plain_test",
    srcs = ["plain_test.ts"],
    data = [
        "VERSION",
        "packages.json",
    ],
    declaration = True,
    main = "plain_test.js",
    package_json = "//javascript/tests/fixtures/node-app:package_json",
    runner = "node",
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
    deps = [
        ":registry",
        "//javascript/tests/fixtures/node-app:node_modules/@types/node",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_json",
    json_srcs = [
        "package.json",
        "packages.json",
        "tsconfig.json",
    ],
    tags = ["corpus"],
)
