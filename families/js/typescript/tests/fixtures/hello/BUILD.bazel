load("@rules_dx//javascript/rules:defs.bzl", "javascript_binary")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//tools/testing:hello_output.bzl", "dx_hello_output_test")
load("@rules_dx//typescript/rules:defs.bzl", "typescript_project", "typescript_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

typescript_project(
    name = "hello_lib",
    srcs = [
        "hello.ts",
        "main.ts",
    ],
    declaration = True,
    tsconfig = "tsconfig.json",
)

javascript_binary(
    name = "hello",
    data = [":hello_lib"],
    main = "main.js",
)

typescript_test(
    name = "hello_test",
    srcs = ["hello_test.ts"],
    config = "jest.config.cjs",
    declaration = True,
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
    package_json = "//:package_json",
    tsconfig = "tsconfig.json",
    deps = [":hello_lib"],
)

dx_hello_output_test(
    name = "hello_output_test",
    binary = ":hello",
    expected = "hello world",
)

typescript_test(
    name = "plain_test",
    srcs = ["plain_test.ts"],
    declaration = True,
    main = "plain_test.js",
    package_json = "//:package_json",
    runner = "node",
    tsconfig = "tsconfig.json",
    deps = [":hello_lib"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["@rules_dx//tools/docs/support_matrix:__pkg__"],
)
