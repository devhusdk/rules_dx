# gazelle:ignore
load("@rules_dx//javascript/rules:defs.bzl", "javascript_binary")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//typescript/rules:defs.bzl", "playwright_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

javascript_binary(
    name = "server",
    entry_point = "server.cjs",
)

playwright_test(
    name = "hello_test",
    srcs = ["hello.spec.ts"],
    app = ":server",
    config = "playwright.config.ts",
    node_modules = "//:node_modules",
    package_json = "//:package_json",
    tags = ["no-remote"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
