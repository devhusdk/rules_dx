module(
    name = "rules_dx_julia",
    version = "0.0.0",
    bazel_compatibility = [">=9.2.0"],
)

bazel_dep(name = "rules_dx", version = "0.0.0")

include("//third_party/rules_dx:rules_dx.MODULE.bazel")

local_path_override(
    module_name = "rules_dx",
    path = "../..",
)

# floor: equals tested
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_rust", version = "0.75.0", dev_dependency = True)

# floor: equals tested; patched, consumers are pinned by the dx include (#5006)
bazel_dep(name = "rules_julia", version = "0.8.0")

julia = use_extension("@rules_julia//julia:extensions.bzl", "julia")
julia.toolchain(version = "1.12.5")

julia_pkg = use_extension("@rules_julia//julia/pkg:extensions.bzl", "pkg")
julia_pkg.from_manifest(
    name = "julia_app_pkgs",
    lockfile = "//julia/tests/fixtures/julia-app/third_party:Manifest.bazel.json",
)
use_repo(julia_pkg, julia_app_deps = "julia_app_pkgs")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust", dev_dependency = True)
rust.toolchain(
    edition = "2024",
    rustfmt_version = "1.99.1",
    versions = ["1.99.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains(
    "@rust_toolchains//:all",
    dev_dependency = True,
)
