module(
    name = "rules_dx_jvm",
    version = "0.0.0",
    bazel_compatibility = [">=9.2.0"],
)

bazel_dep(name = "rules_dx", version = "0.0.0")
include("//third_party/rules_dx:rules_dx.MODULE.bazel")
local_path_override(
    module_name = "rules_dx",
    path = "../..",
)

# floor: equals tested
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.2")
bazel_dep(name = "rules_kotlin", version = "2.4.21")
bazel_dep(name = "rules_rust", version = "0.75.0", dev_dependency = True)
bazel_dep(name = "rules_scala", version = "7.4.1")
bazel_dep(name = "rules_shell", version = "0.8.0")

scala_config = use_extension("@rules_scala//scala/extensions:config.bzl", "scala_config")
scala_config.settings(
    scala_version = "2.13.18",
    scala_versions = [
        "2.13.18",
        "3.3.9",
    ],
)
use_repo(scala_config, "rules_scala_config")

scala_deps = use_extension("@rules_scala//scala/extensions:deps.bzl", "scala_deps")
scala_deps.scala()
scala_deps.scalatest()

rules_kotlin_extensions = use_extension("@rules_kotlin//src/main/starlark/core/repositories:bzlmod_setup.bzl", "rules_kotlin_extensions")
use_repo(rules_kotlin_extensions, "com_github_jetbrains_kotlin")

register_toolchains(
    "@rules_dx//kotlin/toolchain:unused_deps",
    "@rules_dx//scala/toolchain:semanticdb",
    "@rules_dx//scala/toolchain:semanticdb_scala3",
    dev_dependency = True,
)

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "junit:junit:4.13.2",
        "org.junit.jupiter:junit-jupiter-api:6.1.3",
        "org.junit.jupiter:junit-jupiter-engine:6.1.3",
        "org.junit.jupiter:junit-jupiter-params:6.1.3",
        "org.junit.platform:junit-platform-commons:6.1.3",
        "org.junit.platform:junit-platform-engine:6.1.3",
        "org.junit.platform:junit-platform-launcher:6.1.3",
        "org.junit.platform:junit-platform-console:6.1.3",
        "org.junit.vintage:junit-vintage-engine:6.1.3",
        "org.openjdk.jmh:jmh-core:1.37",
        "org.openjdk.jmh:jmh-generator-annprocess:1.37",
        "org.scalactic:scalactic_2.13:3.2.20",
        "org.scalatest:scalatest_2.13:3.2.20",
        "org.scalatest:scalatest-compatible:3.2.20",
        "org.scalatest:scalatest-core_2.13:3.2.20",
        "org.scalatest:scalatest-diagrams_2.13:3.2.20",
        "org.scalatest:scalatest-featurespec_2.13:3.2.20",
        "org.scalatest:scalatest-flatspec_2.13:3.2.20",
        "org.scalatest:scalatest-freespec_2.13:3.2.20",
        "org.scalatest:scalatest-funspec_2.13:3.2.20",
        "org.scalatest:scalatest-funsuite_2.13:3.2.20",
        "org.scalatest:scalatest-matchers-core_2.13:3.2.20",
        "org.scalatest:scalatest-mustmatchers_2.13:3.2.20",
        "org.scalatest:scalatest-propspec_2.13:3.2.20",
        "org.scalatest:scalatest-refspec_2.13:3.2.20",
        "org.scalatest:scalatest-shouldmatchers_2.13:3.2.20",
        "org.scalatest:scalatest-wordspec_2.13:3.2.20",],
    fail_if_repin_required = True,
    known_contributing_modules = [
        "grpc-java",
        "protobuf",
    ],
    lock_file = "@rules_dx//third_party/jvm:maven_install.json",
    repositories = [
        "https://maven-central.storage-download.googleapis.com/maven2",
        "https://repo1.maven.org/maven2",
    ],
)
use_repo(maven, "maven")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust", dev_dependency = True)
rust.toolchain(
    edition = "2024",
    rustfmt_version = "1.99.1",
    versions = ["1.99.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains(
    "@rust_toolchains//:all",
    dev_dependency = True,
)
