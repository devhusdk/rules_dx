load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_dx//java/rules:defs.bzl", "java_fuzz_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

java_fuzz_test(
    name = "parse_fuzz",
    srcs = ["ParseFuzz.java"],
    target_class = "tests.fixtures.fuzz.ParseFuzz",
)

sh_test(
    name = "parse_fuzz_run_test",
    srcs = ["run_test.sh"],
    args = [
        "$(rlocationpath @rules_dx//java/rules:fuzz_run.sh)",
        "$(rootpath :parse_fuzz)",
    ],
    data = [
        ":parse_fuzz",
        "@rules_dx//java/rules:fuzz_run.sh",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    timeout = "short",
)
