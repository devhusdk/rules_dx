load("@rules_dx//java/rules:defs.bzl", "java_binary", "java_library", "java_test")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust/rules:defs.bzl", "rust_test")

# gazelle:resolve java billing.BuildInfo //java/tests/fixtures/java-app/billing

package(default_visibility = ["//java/tests/fixtures/java-app:__subpackages__"])

exports_files(
    [
        "Cli.java",
        "CliTest.java",
        "Main.java",
    ],
    visibility = ["//visibility:public"],
)

java_library(
    name = "cli",
    testonly = True,
    srcs = ["Cli.java"],
    aspect_hints = ["@rules_dx//quality:corpus_checkstyle_config"],
    deps = ["//java/tests/fixtures/java-app/billing"],
)

java_binary(
    name = "invoice",
    testonly = True,
    srcs = ["Main.java"],
    aspect_hints = ["@rules_dx//quality:corpus_checkstyle_config"],
    main_class = "cli.Main",
    visibility = ["//visibility:public"],
    deps = [":cli"],
)

java_test(
    name = "cli_test",
    srcs = ["CliTest.java"],
    aspect_hints = ["@rules_dx//quality:corpus_checkstyle_config"],
    test_class = "cli.CliTest",
    deps = [":cli"],
)

# keep
rust_test(
    name = "exit_codes_test",
    srcs = ["exit_codes_test.rs"],
    data = [
        ":invoice",
        "//java/tests/fixtures/java-app/billing:invoices.json",
        "//java/tests/fixtures/java-app/billing:malformed/fractional.json",
        "//java/tests/fixtures/java-app/billing:malformed/negative.json",
        "//java/tests/fixtures/java-app/billing:malformed/not_array.json",
        "//java/tests/fixtures/java-app/billing:malformed/not_json.txt",
        "//java/tests/fixtures/java-app/billing:malformed/wrong_type.json",
    ],
    env = {
        "INVOICE_BIN": "$(rootpath :invoice)",
        "INVOICE_FRACTIONAL": "$(rootpath //java/tests/fixtures/java-app/billing:malformed/fractional.json)",
        "INVOICE_JSON": "$(rootpath //java/tests/fixtures/java-app/billing:invoices.json)",
        "INVOICE_NEGATIVE": "$(rootpath //java/tests/fixtures/java-app/billing:malformed/negative.json)",
        "INVOICE_NOT_ARRAY": "$(rootpath //java/tests/fixtures/java-app/billing:malformed/not_array.json)",
        "INVOICE_NOT_JSON": "$(rootpath //java/tests/fixtures/java-app/billing:malformed/not_json.txt)",
        "INVOICE_WRONG_TYPE": "$(rootpath //java/tests/fixtures/java-app/billing:malformed/wrong_type.json)",
    },
    deps = ["@rules_dx//tools/testing:dx_testing"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = [
        "//:__pkg__",
    ],
)
