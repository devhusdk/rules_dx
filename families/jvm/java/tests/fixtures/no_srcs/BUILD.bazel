load("@rules_dx//java/rules:defs.bzl", "java_library", "java_test")
load("@rules_dx//libs/starlark/tests:direct_sources.bzl", "dx_direct_sources_test")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

java_library(
    name = "impl",
    srcs = ["Impl.java"],
)

java_library(
    name = "api",
    exports = [":impl"],
)

dx_direct_sources_test(
    name = "api_sources_test",
    expected = {},
    target_under_test = ":api",
)

java_library(
    name = "tests",
    srcs = ["AllTests.java"],
    deps = [
        ":impl",
        "@maven//:junit_junit",
    ],
)

java_test(
    name = "AllTests",
    test_class = "nosrcs.AllTests",
    runtime_deps = [":tests"],
)

dx_direct_sources_test(
    name = "all_tests_sources_test",
    expected = {},
    target_under_test = ":AllTests",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
