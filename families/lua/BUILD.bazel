load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# gazelle:exclude lua

package(default_visibility = ["//visibility:public"])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["@rules_dx//quality:corpus_vale_config"],
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

sh_test(
    name = "starlark_docs_test",
    srcs = ["starlark_docs_test.sh"],
    args = ["$(rootpath @rules_dx//tools/ci:starlark_docs_family_test)"],
    data = [
        "//lua/tests/analysis:corpus_starlark",
        "//lua/tests/fixtures/lua-app:corpus_starlark",
        "//lua/tests/fixtures/lua-app/catalog:corpus_starlark",
        "//lua/tests/fixtures/lua-app/cli:corpus_starlark",
        "//lua/tests/fixtures/lua-app/diagnostics:corpus_starlark",
        "//lua/tests/fixtures/lua-app/report:corpus_starlark",
        "//lua/tests/negative:corpus_starlark",
        "//lua/tests/runtime:corpus_starlark",
        "@rules_dx//tools/ci:starlark_docs_family_test",
    ],
    env = {"STARLARK_DOCS_PACKAGES": "lua/tests/analysis,lua/tests/fixtures/lua-app,lua/tests/fixtures/lua-app/catalog,lua/tests/fixtures/lua-app/cli,lua/tests/fixtures/lua-app/diagnostics,lua/tests/fixtures/lua-app/report,lua/tests/negative,lua/tests/runtime"},
)

filegroup(
    name = "module_srcs",
    srcs = glob(
        ["**"],
        exclude = ["**/tests/**"],
    ),
    visibility = ["//visibility:public"],
)

# dx:begin exports
exports_files(
    [".buildifier.json"],
    visibility = ["//.dx:__pkg__"],
)
# dx:end exports
