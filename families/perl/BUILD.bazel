load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# gazelle:exclude perl

package(default_visibility = ["//visibility:public"])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["@rules_dx//quality:corpus_vale_config"],
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

sh_test(
    name = "starlark_docs_test",
    srcs = ["starlark_docs_test.sh"],
    args = ["$(rootpath @rules_dx//tools/ci:starlark_docs_family_test)"],
    data = [
        "//perl/tests/bench:corpus_starlark",
        "//perl/tests/coverage:corpus_starlark",
        "//perl/tests/fixtures/perl-app:corpus_starlark",
        "//perl/tests/fixtures/perl-app/cli:corpus_starlark",
        "//perl/tests/fixtures/perl-app/inventory:corpus_starlark",
        "//perl/tests/fixtures/perl-app/report:corpus_starlark",
        "//perl/tests/fixtures/perl-app/third_party:corpus_starlark",
        "//perl/tests/negative:corpus_starlark",
        "//perl/tests/runtime:corpus_starlark",
        "@rules_dx//tools/ci:starlark_docs_family_test",
    ],
    env = {"STARLARK_DOCS_PACKAGES": "perl/tests/bench,perl/tests/coverage,perl/tests/fixtures/perl-app,perl/tests/fixtures/perl-app/cli,perl/tests/fixtures/perl-app/inventory,perl/tests/fixtures/perl-app/report,perl/tests/fixtures/perl-app/third_party,perl/tests/negative,perl/tests/runtime"},
)

filegroup(
    name = "module_srcs",
    srcs = glob(
        ["**"],
        exclude = ["**/tests/**"],
    ),
    visibility = ["//visibility:public"],
)

# dx:begin exports
exports_files(
    [
        ".buildifier.json",
        ".editorconfig",
    ],
    visibility = ["//.dx:__pkg__"],
)
# dx:end exports
