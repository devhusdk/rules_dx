load("@rules_dx//powershell/rules:defs.bzl", "powershell_binary", "powershell_library", "powershell_test")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")

# gazelle:dx_ignore_import powershell Pester

package(default_visibility = ["//:__subpackages__"])

powershell_library(
    name = "greet",
    srcs = [
        "Greet.psd1",
        "Greet.psm1",
    ],
)

powershell_binary(
    name = "hello",
    srcs = ["Hello.ps1"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [":greet"],
)

powershell_test(
    name = "greet_test",
    srcs = ["Greet.Tests.ps1"],
    data = ["Greet.Describe.ps1"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [":greet"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
