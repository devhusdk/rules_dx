pwsh_coverage_env_test(
    name = "greeter_test_coverage_env_test",
    target = ":greeter_test",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
    ],
    tags = ["corpus"],
)
