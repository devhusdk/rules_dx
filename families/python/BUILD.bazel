load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# gazelle:exclude python

package(default_visibility = ["//visibility:public"])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["@rules_dx//quality:corpus_vale_config"],
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

sh_test(
    name = "starlark_docs_test",
    srcs = ["starlark_docs_test.sh"],
    args = ["$(rootpath @rules_dx//tools/ci:starlark_docs_family_test)"],
    data = [
        "//python/tests:corpus_starlark",
        "//python/tests/analysis:corpus_starlark",
        "//python/tests/consumer:corpus_starlark",
        "//python/tests/fixtures/adopt-python:corpus_starlark",
        "//python/tests/fixtures/adopt-python/app:corpus_starlark",
        "//python/tests/fixtures/adopt-python/solo:corpus_starlark",
        "//python/tests/fixtures/adopt-python/tests:corpus_starlark",
        "//python/tests/fixtures/entries:corpus_starlark",
        "//python/tests/fixtures/hello:corpus_starlark",
        "//python/tests/fixtures/native_ext:corpus_starlark",
        "//python/tests/fixtures/no_srcs:corpus_starlark",
        "//python/tests/fixtures/python_audit:corpus_starlark",
        "//python/tests/fixtures/python-service:corpus_starlark",
        "//python/tests/fixtures/python-service/ledger/cli:corpus_starlark",
        "//python/tests/fixtures/python-service/ledger/core:corpus_starlark",
        "//python/tests/fixtures/python-service/ledger/service:corpus_starlark",
        "//python/tests/fixtures/rust_sdist:corpus_starlark",
        "//python/tests/sdist_native:corpus_starlark",
        "//python/tests/sdist_native/msvc:corpus_starlark",
        "//python/tests/sdist_native/nodeps:corpus_starlark",
        "@rules_dx//tools/ci:starlark_docs_family_test",
    ],
    env = {"STARLARK_DOCS_PACKAGES": "python/tests,python/tests/analysis,python/tests/consumer,python/tests/fixtures/adopt-python,python/tests/fixtures/adopt-python/app,python/tests/fixtures/adopt-python/solo,python/tests/fixtures/adopt-python/tests,python/tests/fixtures/entries,python/tests/fixtures/hello,python/tests/fixtures/native_ext,python/tests/fixtures/no_srcs,python/tests/fixtures/python_audit,python/tests/fixtures/python-service,python/tests/fixtures/python-service/ledger/cli,python/tests/fixtures/python-service/ledger/core,python/tests/fixtures/python-service/ledger/service,python/tests/fixtures/rust_sdist,python/tests/sdist_native,python/tests/sdist_native/msvc,python/tests/sdist_native/nodeps"},
)

filegroup(
    name = "module_srcs",
    srcs = glob(
        ["**"],
        exclude = ["**/tests/**"],
    ),
    visibility = ["//visibility:public"],
)

# dx:begin exports
exports_files(
    [
        ".buildifier.json",
        ".editorconfig",
    ],
    visibility = ["//.dx:__pkg__"],
)
