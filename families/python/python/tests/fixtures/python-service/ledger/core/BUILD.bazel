load("@rules_dx//python/rules:defs.bzl", "python_binary", "python_library", "python_test")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")

package(default_visibility = [
    "//python/tests/analysis:__pkg__",
    "//python/tests/fixtures/python-service:__subpackages__",
])

python_binary(
    name = "gen_build_info",
    srcs = ["gen_build_info.py"],
    imports = ["../.."],
    main = "gen_build_info.py",
)

genrule(
    name = "build_info_py",
    srcs = ["items.json"],
    outs = ["build_info.py"],
    cmd = select({
        "@platforms//os:windows": "RUNFILES_MANIFEST_FILE=$(execpath :gen_build_info).runfiles_manifest $(execpath :gen_build_info) $(execpath items.json) $@",
        "//conditions:default": "$(execpath :gen_build_info) $(execpath items.json) $@",
    }),
    tools = [":gen_build_info"],
)

python_library(
    name = "core",
    srcs = [
        "__init__.py",
        "catalog.py",
        "config.py",
        ":build_info_py",
    ],
    data = ["items.json"],
    imports = ["../.."],
)

python_library(
    name = "gen_lib",
    srcs = ["gen_build_info.py"],
    imports = ["../.."],
)

python_test(
    name = "catalog_test",
    srcs = ["catalog_test.py"],
    dep_group = "ledger",
    imports = ["../.."],
    deps = [
        ":core",
        "@pypi//coverage",
        "@pypi//pytest",
    ],
)

python_test(
    runner = "plain",
    name = "build_info_test",
    srcs = ["build_info_test.py"],
    dep_group = "ledger",
    env = {
        "PIP_NO_INDEX": "1",
        "UV_OFFLINE": "1",
    },
    imports = ["../.."],
    deps = [
        ":core",
        ":gen_lib",
        "@pypi//click",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//:__pkg__"],
)

exports_files([
    "BUILD.bazel",
    "__init__.py",
    "build_info_test.py",
    "catalog.py",
    "catalog_test.py",
    "config.py",
    "gen_build_info.py",
    "items.json",
])
