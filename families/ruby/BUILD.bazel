load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# gazelle:exclude ruby

package(default_visibility = ["//visibility:public"])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["@rules_dx//quality:corpus_vale_config"],
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

sh_test(
    name = "starlark_docs_test",
    srcs = ["starlark_docs_test.sh"],
    args = ["$(rootpath @rules_dx//tools/ci:starlark_docs_family_test)"],
    data = [
        "//ruby/tests/fixtures/adopt-ruby:corpus_starlark",
        "//ruby/tests/fixtures/adopt-ruby/greet:corpus_starlark",
        "//ruby/tests/fixtures/adopt-ruby/solo:corpus_starlark",
        "//ruby/tests/fixtures/hello:corpus_starlark",
        "//ruby/tests/fixtures/rspec:corpus_starlark",
        "@rules_dx//tools/ci:starlark_docs_family_test",
    ],
    env = {"STARLARK_DOCS_PACKAGES": "ruby/tests/fixtures/adopt-ruby,ruby/tests/fixtures/adopt-ruby/greet,ruby/tests/fixtures/adopt-ruby/solo,ruby/tests/fixtures/hello,ruby/tests/fixtures/rspec"},
)

filegroup(
    name = "module_srcs",
    srcs = glob(
        ["**"],
        exclude = ["**/tests/**"],
    ),
    visibility = ["//visibility:public"],
)

# dx:begin exports
exports_files(
    [".buildifier.json"],
    visibility = ["//.dx:__pkg__"],
)
# dx:end exports
