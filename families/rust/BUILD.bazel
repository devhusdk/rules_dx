load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# gazelle:exclude rust

package(default_visibility = ["//visibility:public"])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["@rules_dx//quality:corpus_vale_config"],
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

sh_test(
    name = "starlark_docs_test",
    srcs = ["starlark_docs_test.sh"],
    args = ["$(rootpath @rules_dx//tools/ci:starlark_docs_family_test)"],
    data = [
        "//rust/tests/fixtures/bindgen:corpus_starlark",
        "//rust/tests/fixtures/cargo_metadata:corpus_starlark",
        "//rust/tests/fixtures/consumer_abi:corpus_starlark",
        "//rust/tests/fixtures/consumer_hub:corpus_starlark",
        "//rust/tests/fixtures/consumer_native:corpus_starlark",
        "//rust/tests/fixtures/consumer_std:corpus_starlark",
        "//rust/tests/fixtures/consumer_wasi:corpus_starlark",
        "//rust/tests/fixtures/consumer_wasm:corpus_starlark",
        "//rust/tests/tonic:corpus_starlark",
        "@rules_dx//tools/ci:starlark_docs_family_test",
    ],
    env = {"STARLARK_DOCS_PACKAGES": "rust/tests/fixtures/bindgen,rust/tests/fixtures/cargo_metadata,rust/tests/fixtures/consumer_abi,rust/tests/fixtures/consumer_hub,rust/tests/fixtures/consumer_native,rust/tests/fixtures/consumer_std,rust/tests/fixtures/consumer_wasi,rust/tests/fixtures/consumer_wasm,rust/tests/tonic"},
)

filegroup(
    name = "module_srcs",
    srcs = glob(
        ["**"],
        exclude = ["**/tests/**"],
    ),
    visibility = ["//visibility:public"],
)

# dx:begin exports
exports_files(
    [
        ".buildifier.json",
        ".editorconfig",
    ],
    visibility = ["//.dx:__pkg__"],
)
# dx:end exports
