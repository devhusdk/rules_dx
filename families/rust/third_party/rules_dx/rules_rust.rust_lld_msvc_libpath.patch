+def _msvc_libpath_dir(arg):
+    """Returns the directory of a `/LIBPATH:`, `-LIBPATH:` or clang-cl `/clang:/LIBPATH:` arg, else None."""
+    if arg[:7].lower() == "/clang:":
+        arg = arg[7:]
+    if arg[:9].lower() in ("/libpath:", "-libpath:"):
+        return arg[9:]
+    return None
+
+# rustc picks the CRT itself from crt-static.
+_MSVC_CRT_LIBS = ["libcmt", "libcmtd", "msvcrt", "msvcrtd", "libucrt", "libucrtd", "ucrt", "ucrtd", "libvcruntime", "libvcruntimed", "vcruntime", "vcruntimed"]
+
+def _msvc_default_lib(arg):
+    """Returns the library of a non-CRT `/DEFAULTLIB:`, `-DEFAULTLIB:` or clang-cl `/clang:/DEFAULTLIB:` arg, else None."""
+    if arg[:7].lower() == "/clang:":
+        arg = arg[7:]
+    if arg[:12].lower() not in ("/defaultlib:", "-defaultlib:"):
+        return None
+    lib = arg[12:]
+    if lib.lower().removesuffix(".lib") in _MSVC_CRT_LIBS:
+        return None
+    return lib
+
