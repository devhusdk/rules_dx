+def _keep_only_children_ignoring_case(repository_ctx, directory, child_names):
+    # Payloads spell one directory both Hostx64 and HostX64; a case-insensitive extract keeps whichever came first.
+    entries = {_basename(entry): entry for entry in directory.readdir()}
+    keep = {}
+    for name in child_names:
+        for actual in entries:
+            if actual == name or (actual.lower() == name.lower() and name not in entries):
+                keep[actual] = True
+    for actual, entry in entries.items():
+        if not keep.get(actual, False):
+            repository_ctx.delete(entry)
