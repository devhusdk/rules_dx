load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//zig/rules:defs.bzl", "zig_library", "zig_test")
load("@rules_dx//tools/coverage/kcov:kcov_tests.bzl", "dx_kcov_env_test")

package(default_visibility = ["//visibility:public"])

zig_library(
    name = "calc",
    testonly = True,
    main = "calc.zig",
)

zig_test(
    name = "calc_test",
    main = "calc_test.zig",
    deps = [":calc"],
)

dx_kcov_env_test(
    name = "calc_test_kcov_test",
    instrumented = ["zig/tests/fixtures/calc/calc.zig"],
    linux_platform = "//zig/rules:kcov_linux_x86_64",
    other_platforms = ["//zig/rules:kcov_macos_arm64"],
    target = ":calc_test",
    upstream = "calc_test_upstream",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
