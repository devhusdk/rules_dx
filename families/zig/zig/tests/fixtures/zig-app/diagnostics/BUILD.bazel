load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust/rules:defs.bzl", "rust_test")

package(default_visibility = ["//zig/tests/fixtures/zig-app:__subpackages__"])

rust_test(
    name = "diagnostics_test",
    srcs = ["diagnostics_test.rs"],
    data = [
        "clean.zig",
        "syntax_error.zig",
        "type_error.zig",
        "unformatted.zig",
        "unused_error.zig",
        "//zig/tests/fixtures/zig-app/catalog:catalog.zig",
        "//zig/tests/fixtures/zig-app/catalog:catalog_test.zig",
        "//zig/tests/fixtures/zig-app/cli:main.zig",
        "//zig/tests/fixtures/zig-app/cli:report.zig",
        "//zig/tests/fixtures/zig-app/cli:report_test.zig",
        "//zig/tests/fixtures/zig-app/digest:digest.zig",
        "//zig/tests/fixtures/zig-app/digest:digest_test.zig",
        "@rules_dx//zig/tools:zig",
        "@rules_dx//zig/tools:zig_lib_marker",
    ],
    env = {
        "DX_CLEAN": "$(rootpath clean.zig)",
        "DX_FORMAT_SRCS": " ".join([
            "$(rootpath clean.zig)",
            "$(rootpath //zig/tests/fixtures/zig-app/catalog:catalog.zig)",
            "$(rootpath //zig/tests/fixtures/zig-app/catalog:catalog_test.zig)",
            "$(rootpath //zig/tests/fixtures/zig-app/cli:main.zig)",
            "$(rootpath //zig/tests/fixtures/zig-app/cli:report.zig)",
            "$(rootpath //zig/tests/fixtures/zig-app/cli:report_test.zig)",
            "$(rootpath //zig/tests/fixtures/zig-app/digest:digest.zig)",
            "$(rootpath //zig/tests/fixtures/zig-app/digest:digest_test.zig)",
        ]),
        "DX_SYNTAX": "$(rootpath syntax_error.zig)",
        "DX_TYPE": "$(rootpath type_error.zig)",
        "DX_UNFORMATTED": "$(rootpath unformatted.zig)",
        "DX_UNUSED": "$(rootpath unused_error.zig)",
        "DX_ZIG": "$(rootpath @rules_dx//zig/tools:zig)",
        "DX_ZIG_STD": "$(rootpath @rules_dx//zig/tools:zig_lib_marker)",
    },
    deps = ["@rules_dx//tools/testing:dx_testing"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = [
        "//:__pkg__",
        "@rules_dx//tools/ci:__pkg__",
    ],
)
