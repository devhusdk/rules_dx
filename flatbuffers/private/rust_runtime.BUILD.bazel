load("@rules_rust//rust:defs.bzl", "rust_library")

# build.rs only sets cfg(nightly), so it is skipped.
rust_library(
    name = "flatbuffers",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["std"],
    crate_root = "src/lib.rs",
    edition = "2018",
    rustc_flags = ["--cap-lints=allow"],
    visibility = ["//visibility:public"],
    deps = ["@dx_flatbuffers_bitflags//:bitflags"],
)
