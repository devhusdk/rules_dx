real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "failure_tests.bzl",
    ],
    tags = ["corpus"],
    visibility = ["//:__pkg__"],
)

rust_test(
    name = "rust_roundtrip_test",
    srcs = ["rs_roundtrip_test.rs"],
    deps = [
        ":shapes_rs",
        "//flatbuffers:runtime_rust",
    ],
)

rust_test(
    name = "conform_deleted_field_test",
    srcs = ["conform_deleted_field_test.rs"],
    data = [
        "//flatbuffers/tests/conform/bad:shape.fbs",
        "//flatbuffers/tests/conform/v2:shape.fbs",
        "@dx_flatbuffers//:flatc",
    ],
    env = {
        "BASELINE": "$(rootpath //flatbuffers/tests/conform/v2:shape.fbs)",
