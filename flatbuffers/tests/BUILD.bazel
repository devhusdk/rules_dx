load("//cc/rules:defs.bzl", "cc_test")
load("//flatbuffers/rules:codegen.bzl", "flatbuffers_cc_library", "flatbuffers_codegen_shard", "flatbuffers_java_library", "flatbuffers_rust_library")
load("//flatbuffers/rules:conform.bzl", "flatbuffers_conform_test")
load("//generation:codegen_tests.bzl", "codegen_shard_argv_test")
load("//java/rules:defs.bzl", "java_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_test")
load(":failure_tests.bzl", "flatbuffers_codegen_failure_test")

package(default_visibility = ["//visibility:private"])

# C++ headers for both libraries; the schema in api/ includes the one in base/.
flatbuffers_cc_library(
    name = "shapes_cc",
    deps = [
        "//flatbuffers/tests/api",
        "//flatbuffers/tests/base",
    ],
)

cc_test(
    name = "cc_roundtrip_test",
    size = "small",
    srcs = ["cc_roundtrip_test.cc"],
    copts = ["-std=c++17"],
    deps = [":shapes_cc"],
)

# The same libraries with the object API: both variants over one shared library
# must not declare conflicting actions, even in one binary.
flatbuffers_cc_library(
    name = "shapes_cc_obj",
    gen_object_api = True,
    deps = [
        "//flatbuffers/tests/api",
        "//flatbuffers/tests/base",
    ],
)

cc_test(
    name = "cc_both_variants_test",
    size = "small",
    srcs = ["cc_roundtrip_test.cc"],
    copts = ["-std=c++17"],
    deps = [
        ":shapes_cc",
        ":shapes_cc_obj",
    ],
)

flatbuffers_codegen_shard(
    name = "shapes_cc_shard",
    entries = [
        "gen/base/common_generated.h|gen|dx.base|flatbuffers/tests/base/common_generated.h",
        "gen/api/shape_generated.h|gen|dx.api|flatbuffers/tests/api/shape_generated.h",
    ],
    language = "cpp",
    library = ":shapes_cc",
)

codegen_shard_argv_test(
    name = "shapes_cc_shard_argv_test",
    expected = [
        "--producer",
        "//flatbuffers/tests:shapes_cc_shard",
        "--language",
        "cpp",
        "--entry",
        "gen/base/common_generated.h|gen|dx.base|flatbuffers/tests/base/common_generated.h",
        "--entry",
        "gen/api/shape_generated.h|gen|dx.api|flatbuffers/tests/api/shape_generated.h",
        "--output",
    ],
    output = "flatbuffers/tests/shapes_cc_shard.dxcodegen.pb",
    target_under_test = ":shapes_cc_shard",
)

# Rust: one crate per root schema; flatc --rust --gen-all inlines the base schema.
flatbuffers_rust_library(
    name = "shapes_rs",
    library = "//flatbuffers/tests/api",
)

rust_test(
    name = "rs_roundtrip_test",
    size = "small",
    srcs = ["rs_roundtrip_test.rs"],
    deps = [
        ":shapes_rs",
        "//flatbuffers:runtime_rust",
    ],
)

flatbuffers_codegen_shard(
    name = "shapes_rs_shard",
    entries = ["gen/api/shape_generated.rs|gen|dx.api|flatbuffers/tests/shapes_rs_generated_fbs_rs/shape_generated.rs"],
    language = "rust",
    library = ":shapes_rs_generated",
)

codegen_shard_argv_test(
    name = "shapes_rs_shard_argv_test",
    expected = [
        "--producer",
        "//flatbuffers/tests:shapes_rs_shard",
        "--language",
        "rust",
        "--entry",
        "gen/api/shape_generated.rs|gen|dx.api|flatbuffers/tests/shapes_rs_generated_fbs_rs/shape_generated.rs",
        "--output",
    ],
    output = "flatbuffers/tests/shapes_rs_shard.dxcodegen.pb",
    target_under_test = ":shapes_rs_shard",
)

# Java: one compile per flatbuffers_library, against the runtime from the pinned archive.
flatbuffers_java_library(
    name = "shapes_java",
    deps = [
        "//flatbuffers/tests/api",
        "//flatbuffers/tests/base",
    ],
)

java_test(
    name = "JavaRoundtripTest",
    size = "small",
    srcs = ["JavaRoundtripTest.java"],
    main_class = "JavaRoundtripTest",
    tags = ["no-lint"],  # no checkstyle config in this fixture package
    test_class = "JavaRoundtripTest",
    use_testrunner = False,
    deps = [":shapes_java"],
)

flatbuffers_codegen_shard(
    name = "shapes_java_shard",
    entries = [
        "gen/base/common.srcjar|gen|dx.base|flatbuffers/tests/base/_fbs_java/base.srcjar",
        "gen/api/shape.srcjar|gen|dx.api|flatbuffers/tests/api/_fbs_java/api.srcjar",
    ],
    language = "java",
    library = ":shapes_java",
)

codegen_shard_argv_test(
    name = "shapes_java_shard_argv_test",
    expected = [
        "--producer",
        "//flatbuffers/tests:shapes_java_shard",
        "--language",
        "java",
        "--entry",
        "gen/base/common.srcjar|gen|dx.base|flatbuffers/tests/base/_fbs_java/base.srcjar",
        "--entry",
        "gen/api/shape.srcjar|gen|dx.api|flatbuffers/tests/api/_fbs_java/api.srcjar",
        "--output",
    ],
    output = "flatbuffers/tests/shapes_java_shard.dxcodegen.pb",
    target_under_test = ":shapes_java_shard",
)

# Breaking-change check: adding a trailing field conforms.
flatbuffers_conform_test(
    name = "conform_added_field_test",
    baseline = "//flatbuffers/tests/conform/v1:shape",
    library = "//flatbuffers/tests/conform/v2:shape",
)

# Failing fixtures: only built by the analysis tests below.
flatbuffers_codegen_shard(
    name = "unclaimed_shard",
    entries = ["gen/base/common_generated.h|gen|dx.base|flatbuffers/tests/base/common_generated.h"],
    language = "cpp",
    library = ":shapes_cc",
    tags = ["manual"],
)

flatbuffers_codegen_shard(
    name = "python_shard",
    entries = ["gen/a.py|gen|a|common_generated.h"],
    language = "python",
    library = ":shapes_cc",
    tags = ["manual"],
)

flatbuffers_rust_library(
    name = "no_root_rs",
    library = "//flatbuffers/tests/multi",
    tags = ["manual"],
)

flatbuffers_rust_library(
    name = "foreign_root_rs",
    library = "//flatbuffers/tests/api",
    root = "//flatbuffers/tests/base:common.fbs",
    tags = ["manual"],
)

flatbuffers_codegen_shard(
    name = "cpp_shard_on_rust",
    entries = ["gen/api/shape_generated.rs|gen|dx.api|flatbuffers/tests/shapes_rs_generated_fbs_rs/shape_generated.rs"],
    language = "cpp",
    library = ":shapes_rs_generated",
    tags = ["manual"],
)

flatbuffers_codegen_shard(
    name = "stray_rs_shard",
    entries = ["gen/api/other.rs|gen|dx.api|flatbuffers/tests/other.rs"],
    language = "rust",
    library = ":shapes_rs_generated",
    tags = ["manual"],
)

flatbuffers_codegen_shard(
    name = "java_shard_on_cc",
    entries = ["gen/base/common_generated.h|gen|dx.base|flatbuffers/tests/base/common_generated.h"],
    language = "java",
    library = ":shapes_cc",
    tags = ["manual"],
)

flatbuffers_conform_test(
    name = "foreign_root_conform",
    baseline = "//flatbuffers/tests/conform/v1:shape",
    library = "//flatbuffers/tests/api",
    root = "//flatbuffers/tests/base:common.fbs",
    tags = ["manual"],
)

flatbuffers_conform_test(
    name = "multi_baseline_conform",
    baseline = "//flatbuffers/tests/multi",
    library = "//flatbuffers/tests/conform/v1:shape",
    tags = ["manual"],
)

flatbuffers_conform_test(
    name = "deleted_field_conform",
    baseline = "//flatbuffers/tests/conform/v2:shape",
    library = "//flatbuffers/tests/conform/bad:shape",
    tags = ["manual"],
)

flatbuffers_codegen_failure_test(
    name = "java_language_mismatch_test",
    message = "does not match",
    target_under_test = ":java_shard_on_cc",
)

flatbuffers_codegen_failure_test(
    name = "conform_foreign_root_test",
    message = "is not owned by",
    target_under_test = ":foreign_root_conform_conform",
)

flatbuffers_codegen_failure_test(
    name = "conform_multi_baseline_test",
    message = "root is required because",
    target_under_test = ":multi_baseline_conform_conform",
)

flatbuffers_codegen_failure_test(
    name = "rust_missing_root_test",
    message = "root is required because",
    target_under_test = ":no_root_rs_generated",
)

flatbuffers_codegen_failure_test(
    name = "rust_foreign_root_test",
    message = "is not owned by",
    target_under_test = ":foreign_root_rs_generated",
)

flatbuffers_codegen_failure_test(
    name = "rust_language_mismatch_test",
    message = "does not match",
    target_under_test = ":cpp_shard_on_rust",
)

flatbuffers_codegen_failure_test(
    name = "rust_stray_entry_test",
    message = "matches no flatbuffers_generated_srcs artifact",
    target_under_test = ":stray_rs_shard",
)

flatbuffers_codegen_failure_test(
    name = "unclaimed_artifact_test",
    message = "unreported flatbuffers_generated_srcs artifact",
    target_under_test = ":unclaimed_shard",
)

flatbuffers_codegen_failure_test(
    name = "non_admitted_pair_test",
    message = "unsupported codegen pair ('flatbuffers', 'python')",
    target_under_test = ":python_shard",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "failure_tests.bzl",
    ],
    tags = ["corpus"],
)
