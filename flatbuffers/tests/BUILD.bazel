# gazelle:ignore
load("//cc:defs.bzl", "cc_test")
load("//flatbuffers/private:conform.bzl", "flatbuffers_conform")
load("//flatbuffers:defs.bzl", "flatbuffers_cc_library", "flatbuffers_conform_test", "flatbuffers_java_library", "flatbuffers_library", "flatbuffers_rust_library")
load("//core/codegen:codegen_tests.bzl", "codegen_shard_argv_test")
load("//java:defs.bzl", "java_test")
load("//rust:defs.bzl", "rust_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//core:failure_test.bzl", "failure_test")
load(":failure_tests.bzl", "flatbuffers_cc_stage_test", "flatbuffers_java_stage_test", "flatbuffers_stage_args_test", "flatbuffers_undeclared_java_test", "flatbuffers_undeclared_rust_test")

package(default_visibility = ["//visibility:private"])

# C++ headers for both libraries; the schema in api/ includes the one in base/.
flatbuffers_cc_library(
    name = "shapes_cc",
    deps = [
        "//flatbuffers/tests/api",
        "//flatbuffers/tests/base",
    ],
)

cc_test(
    name = "cc_roundtrip_test",
    srcs = ["cc_roundtrip_test.cc"],
    copts = ["-std=c++17"],
    deps = [":shapes_cc"],
)

# Both variants over one shared library must not declare conflicting actions.
flatbuffers_cc_library(
    name = "shapes_cc_obj",
    gen_object_api = True,
    deps = [
        "//flatbuffers/tests/api",
        "//flatbuffers/tests/base",
    ],
)

cc_test(
    name = "cc_both_variants_test",
    srcs = ["cc_roundtrip_test.cc"],
    copts = ["-std=c++17"],
    deps = [
        ":shapes_cc",
        ":shapes_cc_obj",
    ],
)

codegen_shard_argv_test(
    name = "shapes_cc_shard_argv_test",
    expected = [
        "--producer",
        "//flatbuffers/tests:shapes_cc",
        "--language",
        "cpp",
        "--entry",
        "gen/flatbuffers/tests/api/shape_generated.h|gen||flatbuffers/tests/api/_fbs/flatbuffers/tests/api/shape_generated.h",
        "--entry",
        "gen/flatbuffers/tests/base/common_generated.h|gen||flatbuffers/tests/base/_fbs/flatbuffers/tests/base/common_generated.h",
        "--output",
    ],
    output = "flatbuffers/tests/shapes_cc.dxcodegen.pb",
    target_under_test = ":shapes_cc",
)

# Rust: one crate per root schema; flatc --rust --gen-all inlines the base schema.
flatbuffers_rust_library(
    name = "shapes_rs",
    library = "//flatbuffers/tests/api",
)

codegen_shard_argv_test(
    name = "shapes_rs_shard_argv_test",
    expected = [
        "--producer",
        "//flatbuffers/tests:shapes_rs_generated",
        "--language",
        "rust",
        "--entry",
        "gen/shape_generated.rs|gen||flatbuffers/tests/shapes_rs_generated_fbs_rs/shape_generated.rs",
        "--output",
    ],
    output = "flatbuffers/tests/shapes_rs_generated.dxcodegen.pb",
    target_under_test = ":shapes_rs_generated",
)

# Java: one compile per flatbuffers_library, against the runtime from the pinned archive.
flatbuffers_java_library(
    name = "shapes_java",
    deps = [
        "//flatbuffers/tests/api",
        "//flatbuffers/tests/base",
    ],
)

java_test(
    name = "JavaRoundtripTest",
    srcs = ["JavaRoundtripTest.java"],
    main_class = "JavaRoundtripTest",
    tags = ["no-lint"],  # no lint config in this fixture package
    test_class = "JavaRoundtripTest",
    use_testrunner = False,
    deps = [":shapes_java"],
)

codegen_shard_argv_test(
    name = "shapes_java_shard_argv_test",
    expected = [
        "--producer",
        "//flatbuffers/tests:shapes_java",
        "--language",
        "java",
        "--entry",
        "gen/flatbuffers/tests/api/api.srcjar|gen||flatbuffers/tests/api/_fbs_java/api.srcjar",
        "--entry",
        "gen/flatbuffers/tests/base/base.srcjar|gen||flatbuffers/tests/base/_fbs_java/base.srcjar",
        "--output",
    ],
    output = "flatbuffers/tests/shapes_java.dxcodegen.pb",
    target_under_test = ":shapes_java",
)

# Breaking-change check: adding a trailing field conforms.
flatbuffers_conform_test(
    name = "conform_added_field_test",
    baseline = "//flatbuffers/tests/conform/v1:shape",
    library = "//flatbuffers/tests/conform/v2:shape",
)

