)

flatbuffers_stage_args_test(
    name = "stage_args_test",
    target_under_test = ":shapes_rs_generated",
)

flatbuffers_undeclared_rust_test(
    name = "undeclared_rs_test",
    target_under_test = "//flatbuffers/tests/lost:lost_rs_generated",
)

flatbuffers_undeclared_java_test(
    name = "undeclared_java_test",
    target_under_test = "//flatbuffers/tests/lost:lost_java",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "failure_tests.bzl",
    ],
    tags = ["corpus"],
    visibility = ["//:__pkg__"],
)

rust_test(
    name = "rust_roundtrip_test",
    srcs = ["rs_roundtrip_test.rs"],
    deps = [
        ":shapes_rs",
