load("//core/quality:fixtures.bzl", "real_source_target")
load("//flatbuffers:defs.bzl", "flatbuffers_cc_library", "flatbuffers_java_library", "flatbuffers_library", "flatbuffers_rust_library")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite")

# The dirty fixtures stay in their own manual targets; gazelle would merge them
# into the clean library.
# gazelle:exclude lint_dirty.fbs

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

flatbuffers_library(
    name = "conformance",
    testonly = True,
    srcs = ["clean.fbs"],
)

# keep
flatbuffers_library(
    name = "lint_dirty",
    srcs = ["lint_dirty.fbs"],
    tags = ["manual"],
)

dx_conformance_suite(
    name = "",
    size = "small",
    binary = ":conformance",
    covered_source = "",
    expected = "",
    failing_case = "",
    failing_test = ":conformance",
    lang = "flatbuffers",
    not_applicable = {
        "build_test": "flatbuffers has no binary rule",
        "coverage_test": "flatbuffers has no test rule",
        "cross_test": "flatbuffers has no binary rule",
        "fail_test": "flatbuffers has no test rule",
        "format_error_test": "no maintained .fbs formatter exists",
        "format_test": "no maintained .fbs formatter exists",
        "lock_test": "flatbuffers has no package manager",
        "pass_test": "flatbuffers has no test rule",
        "runfiles_test": "flatbuffers has no binary rule",
    },
    passing_test = ":conformance",
    quality = {
        "clean": ":conformance",
        "lint_dirty": ":lint_dirty",
        "lint_line": 4,
        "lint_rule": "error",
        "lint_source": "lint_dirty.fbs",
    },
)

flatbuffers_cc_library(
    name = "conformance_cc",
    testonly = True,
    visibility = ["//visibility:public"],
    deps = [":conformance"],
)

flatbuffers_java_library(
    name = "conformance_java",
    testonly = True,
    visibility = ["//visibility:public"],
    deps = [":conformance"],
)

flatbuffers_rust_library(
    name = "conformance_rust",
    testonly = True,
    library = ":conformance",
    visibility = ["//visibility:public"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
