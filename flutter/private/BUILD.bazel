load("@bazel_skylib//lib:selects.bzl", "selects")
load("//core:cells.bzl", "unsupported_value")
load("//core/quality:fixtures.bzl", "real_source_target")
load(":platforms.bzl", "FLUTTER_PLATFORMS")

package(default_visibility = ["//flutter:__subpackages__", "//tools/ci:__pkg__", "//:__pkg__"])

unsupported_value("unsupported")

exports_files([
    "defs.bzl",
    "platforms.bzl",
])

[
    config_setting(
        name = name,
        constraint_values = [
            "@platforms//os:" + os,
            "@platforms//cpu:" + cpu,
        ],
    )
    for name, (os, cpu) in FLUTTER_PLATFORMS.items()
]

selects.config_setting_group(
    name = "rules_flutter_platform",
    visibility = ["//visibility:public"],
    match_any = [":" + name for name in FLUTTER_PLATFORMS],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "platforms.bzl",
    ],
    tags = ["corpus"],
)
