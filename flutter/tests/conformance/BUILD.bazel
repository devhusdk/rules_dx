load("//core/quality:fixtures.bzl", "real_source_target")
load("//flutter:defs.bzl", "flutter_library", "flutter_test")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "subject_compatible_with")
load(":quality.bzl", "flutter_format_subject", "flutter_lint_subject")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

flutter_library(
    name = "conformance",
    package_name = "conformance",
    srcs = ["lib/greet.dart"],
    deps = ["@dx_flutter_deps//:flutter"],
)

flutter_library(
    name = "lint_dirty",
    package_name = "conformance_lint_dirty",
    srcs = ["lib/lint_dirty.dart"],
    tags = ["manual"],
)

flutter_library(
    name = "format_dirty",
    package_name = "conformance_format_dirty",
    srcs = ["lib/format_dirty.dart"],
    tags = ["manual"],
)

flutter_test(
    name = "pass_subject_test",
    package_name = "conformance",
    size = "small",
    main = "test/pass_test.dart",
    target_compatible_with = subject_compatible_with(),
    deps = [
        ":conformance",
        "@dx_flutter_deps//:flutter_test",
    ],
)

flutter_test(
    name = "fail_subject_test",
    package_name = "conformance",
    size = "small",
    main = "test/fail_test.dart",
    target_compatible_with = subject_compatible_with(),
    deps = [
        ":conformance",
        "@dx_flutter_deps//:flutter_test",
    ],
)

dx_conformance_suite(
    name = "",
    size = "small",
    binary = ":conformance",
    covered_source = "greet.dart",
    expected = "",
    failing_case = "failing_case",
    failing_pattern = "FAIL  {case}",
    failing_test = ":fail_subject_test",
    lang = "flutter",
    not_applicable = {
        "build_test": "flutter has no binary rule that prints to stdout",
        "cross_test": "flutter has no binary rule that prints to stdout",
        "lock_test": "flutter has no binary rule that prints to stdout",
    },
    passing_test = ":pass_subject_test",
    quality = {
        "clean": ":conformance",
        "format_dirty": ":format_dirty",
        "format_source": "lib/format_dirty.dart",
        "format_subject": flutter_format_subject,
        "lint_dirty": ":lint_dirty",
        "lint_line": 2,
        "lint_rule": "unused_local_variable",
        "lint_source": "lib/lint_dirty.dart",
        "lint_subject": flutter_lint_subject,
    },
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "quality.bzl",
    ],
    tags = ["corpus"],
)
