load("@rules_dx//apple:defs.bzl", "apple_simulator_boot", "apple_simulator_install", "apple_simulator_launch")
load("@rules_dx//flutter:defs.bzl", "flutter_ios_app")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")

package(default_visibility = ["//:__subpackages__"])

exports_files(
    [
        "BUILD.bazel",
        "assets/fonts/DxSquare.ttf",
        "assets/items.json",
        "l10n.yaml",
        "profile.bzl",
        "pubspec.lock",
        "pubspec.yaml",
    ] + glob([".dart_tool/*"]),
    visibility = [
        "//flutter/tests/fixtures/flutter-app:__subpackages__",
        "//tools/testing/hermetic:__pkg__",
    ],
)

flutter_ios_app(
    name = "ios_app",
    application = "//flutter/tests/fixtures/flutter-app/app:native",
    bundle_id = "dk.devhus.flutterapp",
    visibility = ["//visibility:private"],
)

apple_simulator_boot(
    name = "ios_boot",
    simulator = "iPhone 16",
)

apple_simulator_install(
    name = "ios_install",
    app = ":ios_app",
    simulator = "iPhone 16",
)

apple_simulator_launch(
    name = "ios_launch",
    bundle_id = "dk.devhus.flutterapp",
    simulator = "iPhone 16",
)

rust_test(
    name = "inspect_ios_app_test",
    size = "small",
    srcs = ["ios/inspect_app_test.rs"],
    crate_root = "ios/inspect_app_test.rs",
    data = [":ios_install_app"],
    env = {
        "DX_IOS_APP": "$(rootpath :ios_install_app)",
        "DX_IOS_BUNDLE_ID": "dk.devhus.flutterapp",
    },
    tags = ["block-network"],
    target_compatible_with = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
    deps = ["@crates//:zip"],
)

rust_test(
    name = "ios_simulator_smoke_test",
    size = "medium",
    srcs = ["ios/simulator_smoke_test.rs"],
    crate_root = "ios/simulator_smoke_test.rs",
    data = [
        ":ios_install_app",
        "//apple:declared_simulator",
    ],
    env = {
        "DX_IOS_SIMULATOR_FILE": "$(rootpath //apple:declared_simulator)",
        "DX_SIMCTL_APP": "$(rootpath :ios_install_app)",
        "DX_SIMCTL_BUNDLE_ID": "dk.devhus.flutterapp",
        "DX_SIMCTL_DEVICE_TYPE": "iPhone 16",
    },
    tags = ["resources:ios_simulator:1"],
    target_compatible_with = select({
        "//apple:simulator_undeclared": ["@platforms//:incompatible"],
        "//conditions:default": [
            "@platforms//cpu:arm64",
            "@platforms//os:macos",
        ],
    }),
    deps = [
        "//apple/private/tools/ops",
        "@crates//:zip",
    ],
)

real_source_target(
    name = "corpus_markdown",
    testonly = True,
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "profile.bzl",
    ],
    tags = ["corpus"],
)
