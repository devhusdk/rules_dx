load("@rules_dx_apple//ios:simulator.bzl", "apple_simulator_boot", "apple_simulator_install", "apple_simulator_launch")
load("@rules_dx//flutter/rules:defs.bzl", "flutter_ios_app")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

exports_files(
    [
        "BUILD.bazel",
        "assets/fonts/DxSquare.ttf",
        "assets/items.json",
        "l10n.yaml",
        "profile.bzl",
        "pubspec.lock",
        "pubspec.yaml",
    ] + glob([".dart_tool/*"]),
    visibility = [
        "//flutter/tests/fixtures/flutter-app:__subpackages__",
        "//tools/testing/hermetic:__pkg__",
    ],
)

flutter_ios_app(
    name = "ios_app",
    application = "//flutter/tests/fixtures/flutter-app/app:native",
    bundle_id = "dk.devhus.flutterapp",
    visibility = ["//visibility:private"],
)

apple_simulator_boot(
    name = "ios_boot",
    simulator = "iPhone 16",
)

apple_simulator_install(
    name = "ios_install",
    app = ":ios_app",
    simulator = "iPhone 16",
)

apple_simulator_launch(
    name = "ios_launch",
    bundle_id = "dk.devhus.flutterapp",
    simulator = "iPhone 16",
)

sh_test(
    name = "ios_simulator_smoke_test",
    size = "small",
    srcs = ["ios/simulator_smoke.sh"],
    args = [
        "boot",
        "$(rootpath :ios_boot)",
        "install",
        "$(rootpath :ios_install)",
        "launch",
        "$(rootpath :ios_launch)",
    ],
    data = [
        ":ios_boot",
        ":ios_install",
        ":ios_install_app",
        ":ios_launch",
    ],
    env = {
        "DX_SIMCTL_APP": "$(rootpath :ios_install_app)",
        "DX_SIMCTL_BUNDLE_ID": "dk.devhus.flutterapp",
        "DX_SIMCTL_DEVICE": "iPhone 16",
    },
    tags = [
        "exclusive",
        "local",
        "macos-arm64",
        "manual",
    ],
)

real_source_target(
    name = "corpus_markdown",
    testonly = True,
    aspect_hints = ["//quality:corpus_vale_config"],
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "profile.bzl",
    ],
    tags = ["corpus"],
)
