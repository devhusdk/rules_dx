load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_dx_android//packaging:defs.bzl", "android_adb_install", "android_adb_log", "android_adb_start")
load("@rules_dx//flutter/rules:defs.bzl", "FLUTTER_COMPATIBLE_WITH", "flutter_android_app")
load("//quality:fixtures.bzl", "real_source_target")

exports_files(
    [
        "BUILD.bazel",
        "inspect_apk.sh",
        "interaction.sh",
    ],
    visibility = ["//tools/testing/hermetic:__pkg__"],
)

flutter_android_app(
    name = "apk",
    android_abi = "x64",
    application = "//flutter/tests/fixtures/flutter-app/app:native",
    package_name = "dk.devhus.flutterapp",
    pub_hub_name = "dx_flutter_app_deps",
    tags = ["manual"],
)

flutter_android_app(
    name = "apk_arm64",
    application = "//flutter/tests/fixtures/flutter-app/app:native",
    package_name = "dk.devhus.flutterapp",
    pub_hub_name = "dx_flutter_app_deps",
    tags = ["manual"],
)

android_adb_install(
    name = "install",
    apk = ":apk",
    serial = "emulator-5554",
)

android_adb_start(
    name = "start",
    activity = "io.flutter.embedding.android.FlutterActivity",
    app_id = "dk.devhus.flutterapp",
    serial = "emulator-5554",
)

android_adb_log(
    name = "log",
    serial = "emulator-5554",
)

sh_test(
    name = "interaction_test",
    size = "medium",
    srcs = ["interaction.sh"],
    args = [
        "emulator-5554",
        "dk.devhus.flutterapp",
        "io.flutter.embedding.android.FlutterActivity",
        "$(locations :apk)",
    ],
    data = [":apk"],
    tags = [
        "exclusive",
        "linux-kvm",
        "manual",
    ],
    target_compatible_with = FLUTTER_COMPATIBLE_WITH,
)

build_test(
    name = "apk_build_test",
    size = "small",
    tags = ["manual"],
    target_compatible_with = FLUTTER_COMPATIBLE_WITH,
    targets = [
        ":apk",
        ":apk_arm64",
    ],
)

sh_test(
    name = "inspect_apk_test",
    size = "small",
    srcs = ["inspect_apk.sh"],
    args = [
        "dk.devhus.flutterapp",
        "x86_64",
        "io.flutter.embedding.android.FlutterActivity",
        "$(locations :apk)",
    ],
    data = [":apk"],
    tags = [
        "block-network",
        "manual",
    ],
    target_compatible_with = FLUTTER_COMPATIBLE_WITH,
)

sh_test(
    name = "inspect_apk_arm64_test",
    size = "small",
    srcs = ["inspect_apk.sh"],
    args = [
        "dk.devhus.flutterapp",
        "arm64-v8a",
        "io.flutter.embedding.android.FlutterActivity",
        "$(locations :apk_arm64)",
    ],
    data = [":apk_arm64"],
    tags = [
        "block-network",
        "manual",
    ],
    target_compatible_with = FLUTTER_COMPATIBLE_WITH,
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
