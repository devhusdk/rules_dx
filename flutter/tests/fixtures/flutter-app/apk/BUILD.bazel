load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")

[
    rust_test(
        name = name,
        size = "small",
        srcs = ["inspect_apk_test.rs"],
        crate_root = "inspect_apk_test.rs",
        data = [apk],
        env = {
            "DX_APK": "$(rootpaths {})".format(apk),
            "DX_APK_ABI": abi,
            "DX_APK_ACTIVITY": "io.flutter.embedding.android.FlutterActivity",
            "DX_APK_APP_ID": "dk.devhus.flutterapp",
        },
        tags = ["block-network"],
        target_compatible_with = [
            "@platforms//cpu:x86_64",
            "@platforms//os:linux",
        ],
        deps = ["@crates//:zip"],
    )
    for name, apk, abi in [
        ("inspect_apk_test", "//flutter/tests/fixtures/flutter-app/android:apk", "x86_64"),
        ("inspect_apk_arm64_test", "//flutter/tests/fixtures/flutter-app/android:apk_arm64", "arm64-v8a"),
    ]
]

rust_test(
    name = "interaction_test",
    size = "small",
    srcs = ["interaction_test.rs"],
    crate_root = "interaction_test.rs",
    data = [
        "//android:declared_emulator",
        "//flutter/tests/fixtures/flutter-app/android:apk",
        "@dx_android_sdk//:adb",
    ],
    env = {
        "DX_ADB": "$(rootpaths @dx_android_sdk//:adb)",
        "DX_ANDROID_SERIAL_FILE": "$(rootpath //android:declared_emulator)",
        "DX_APK": "$(rootpaths //flutter/tests/fixtures/flutter-app/android:apk)",
        "DX_APK_ACTIVITY": "io.flutter.embedding.android.FlutterActivity",
        "DX_APK_APP_ID": "dk.devhus.flutterapp",
    },
    tags = ["resources:android_emulator:1"],
    target_compatible_with = select({
        "//android:emulator_undeclared": ["@platforms//:incompatible"],
        "//conditions:default": [
            "@platforms//cpu:x86_64",
            "@platforms//os:linux",
        ],
    }),
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
