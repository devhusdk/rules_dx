load("@rules_dx//flutter:defs.bzl", "flutter_android_app", "flutter_application", "flutter_library")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//flutter/tests/fixtures/flutter-app:__subpackages__"])

exports_files(
    glob(["lib/**"]) + ["BUILD.bazel"],
    visibility = ["//tools/testing/hermetic:__pkg__"],
)

# Each target fails on purpose. They are manual so //... never builds them.

flutter_application(
    name = "type_error",
    package_name = "flutter_app_failures",
    main = "lib/type_error.dart",
    tags = ["manual"],
    deps = ["@dx_flutter_app_deps//:flutter"],
)

flutter_application(
    name = "undeclared_dep",
    package_name = "flutter_app_failures",
    main = "lib/undeclared_dep.dart",
    tags = ["manual"],
    deps = ["@dx_flutter_app_deps//:flutter"],
)

flutter_application(
    name = "missing_asset",
    package_name = "flutter_app_failures",
    assets = ["assets/missing.json"],
    main = "lib/missing_asset.dart",
    tags = ["manual"],
    deps = ["@dx_flutter_app_deps//:flutter"],
)

flutter_library(
    name = "missing_font",
    package_name = "flutter_app_failures",
    fonts_json = json.encode([{
        "family": "Missing",
        "fonts": [{"asset": "assets/fonts/Missing.ttf"}],
    }]),
    tags = ["manual"],
)

flutter_android_app(
    name = "bad_abi",
    android_abi = "x86",
    application = "//flutter/tests/fixtures/flutter-app/app:native",
    package_name = "dk.devhus.flutterapp",
    tags = ["manual"],
    visibility = ["//flutter/tests/negative:__pkg__"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
