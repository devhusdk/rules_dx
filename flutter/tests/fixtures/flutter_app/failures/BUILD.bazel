load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//dart:defs.bzl", "dart_package_metadata")
load("@rules_dx//flutter:defs.bzl", "flutter_android_app", "flutter_application", "flutter_font_family", "flutter_library")

package(default_visibility = ["//flutter/tests/fixtures/flutter_app:__subpackages__"])

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "flutter_app_failures",
)

exports_files(
    glob(["lib/**"]) + ["BUILD.bazel"],
    visibility = ["//tools/testing/hermetic:__pkg__"],
)

# Each target fails on purpose. They are manual so //... never builds them.

flutter_application(
    name = "type_error",
    main = "lib/type_error.dart",
    package = ":pubspec-metadata",
    tags = ["manual"],
    deps = ["@dx_flutter_app_deps//:flutter"],
)

flutter_application(
    name = "undeclared_dep",
    main = "lib/undeclared_dep.dart",
    package = ":pubspec-metadata",
    tags = ["manual"],
    deps = ["@dx_flutter_app_deps//:flutter"],
)

flutter_application(
    name = "missing_asset",
    assets = ["assets/missing.json"],
    main = "lib/missing_asset.dart",
    package = ":pubspec-metadata",
    tags = ["manual"],
    deps = ["@dx_flutter_app_deps//:flutter"],
)

flutter_font_family(
    name = "foreign_font",
    family = "Missing",
    fonts = ["//flutter/tests/fixtures/flutter_app/app:assets/fonts/DxSquare.ttf"],
    tags = ["manual"],
)

flutter_library(
    name = "missing_font",
    fonts = [":foreign_font"],
    package = ":pubspec-metadata",
    tags = ["manual"],
    visibility = ["//flutter/tests/fixtures/negative:__pkg__"],
)

flutter_android_app(
    name = "bad_abi",
    android_abi = "x86",
    application = "//flutter/tests/fixtures/flutter_app/app:native",
    application_id = "dk.devhus.flutterapp",
    tags = ["manual"],
    visibility = ["//flutter/tests/fixtures/negative:__pkg__"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
