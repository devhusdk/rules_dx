# gazelle:ignore

load("//flutter:defs.bzl", "flutter_library")
load("//core:failure_test.bzl", "failure_test")
load("//core/quality/private:generated_policy.bzl", "dx_generated_policy")

flutter_library(
    name = "broken",
    testonly = True,
    srcs = ["lib/broken.dart"],
    package_name = "dx_flutter_negative",
    tags = ["manual"],
    visibility = ["//:__subpackages__"],
    deps = ["@dx_flutter_deps//:flutter"],
)

failure_test(
    name = "unknown_android_abi_fails_test",
    expected_failure_substring = "android_abi 'x86' is unknown",
    target = "//flutter/tests/fixtures/flutter-app/failures:bad_abi",
)

failure_test(
    name = "missing_font_fails_test",
    expected_failure_substring = "fonts_json names font asset 'assets/fonts/Missing.ttf' but font_files does not provide it",
    target = "//flutter/tests/fixtures/flutter-app/failures:missing_font",
)

dx_generated_policy(
    name = "policy",
    defaults = False,
    families = {
        "dart": {
            "format": ["dart"],
            "lint": ["dart"],
            "typecheck": ["dart"],
        },
    },
    tier = "standard",
)
