# gazelle:ignore

load("//flutter/rules:defs.bzl", "flutter_library")
load("//libs/starlark:failure_test.bzl", "failure_test")
load("//quality:policy.bzl", "quality_family", "workspace_policy")

flutter_library(
    name = "broken",
    testonly = True,
    srcs = ["lib/broken.dart"],
    package_name = "dx_flutter_negative",
    tags = ["manual"],
    visibility = ["//:__subpackages__"],
    deps = ["@dx_flutter_deps//:flutter"],
)

failure_test(
    name = "unknown_android_abi_fails_test",
    expected_failure_substring = "android_abi 'x86' is unknown",
    target = "//flutter/tests/fixtures/flutter-app/failures:bad_abi",
)

quality_family(
    name = "dart_family",
    family_id = "dart",
    format = ["dart"],
    lint = ["dart"],
    typecheck = ["dart"],
)

workspace_policy(
    name = "policy",
    families = [":dart_family"],
)
