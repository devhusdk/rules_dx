{
  "$schema": "../core/modules/lang.schema.json",
  "name": "fortran",
  "title": "Fortran",
  "family": "core",
  "ecosystems": [
    "fpm"
  ],
  "depcheck": "fortran",
  "semver": false,
  "manifests": [
    "fpm.toml"
  ],
  "lockfiles": [],
  "tools": [
    "ffmt",
    "fortitude"
  ],
  "platforms": [
    "linux_x86_64"
  ],
  "pins": [
    "private/toolchain/pins.json"
  ],
  "entry_points": [
    "fortran_library",
    "fortran_binary",
    "fortran_test"
  ],
  "quality": {
    "bzl": "fortran/private/quality:fortran.bzl",
    "file_extensions": [
      ".f",
      ".f03",
      ".f08",
      ".f90",
      ".f95"
    ],
    "aspects": {
      "format": [
        "real_fortran_format_aspect"
      ],
      "lint": [
        "real_fortran_lint_aspect"
      ],
      "typecheck": [
        "real_fortran_typecheck_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_fortran_format_probe_aspect"
      ],
      "lint": [
        "real_fortran_lint_probe_aspect"
      ],
      "typecheck": [
        "real_fortran_typecheck_probe_aspect"
      ]
    }
  },
  "docs": {
    "bzl": "tools/docs/fortran:aspect.bzl",
    "file_extensions": [
      ".f",
      ".f03",
      ".f08",
      ".f90",
      ".f95"
    ],
    "aspects": [
      "real_fortran_docs_aspect"
    ]
  }
}
