{
  "$schema": "../core/modules/lang.schema.json",
  "name": "fortran",
  "title": "Fortran",
  "family": "core",
  "ecosystems": [
    "fpm"
  ],
  "depcheck": "fortran",
  "semver": false,
  "manifests": [
    "fpm.toml"
  ],
  "lockfiles": [
    "fpm.lock.json"
  ],
  "setup": {
    "hubs": [
      {
        "ecosystem": "fpm",
        "manifest": "fpm.toml",
        "lock": "fpm.lock.json",
        "state": null,
        "extension": "@rules_dx//fortran:extensions.bzl",
        "tag": "lock",
        "hub": "fpm",
        "resolver": "@rules_dx//fortran/private/tools/lock",
        "imports": "provides"
      }
    ]
  },
  "tools": [
    "ffmt",
    "fortitude"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64"
  ],
  "unsupported": {
    "windows_arm64": "flang-releases v21.1.8 ships no Windows arm64 build"
  },
  "pins": [
    "pins.json"
  ],
  "entry_points": [
    "fortran_library",
    "fortran_binary",
    "fortran_test"
  ],
  "quality": {
    "bzl": "fortran/private/quality:fortran.bzl",
    "file_extensions": [
      ".f",
      ".f03",
      ".f08",
      ".f90",
      ".f95"
    ],
    "aspects": {
      "format": [
        "real_fortran_format_aspect"
      ],
      "lint": [
        "real_fortran_lint_aspect"
      ],
      "typecheck": [
        "real_fortran_typecheck_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_fortran_format_probe_aspect"
      ],
      "lint": [
        "real_fortran_lint_probe_aspect"
      ],
      "typecheck": [
        "real_fortran_typecheck_probe_aspect"
      ]
    }
  },
  "docs": {
    "bzl": "tools/docs/fortran:aspect.bzl",
    "file_extensions": [
      ".f",
      ".f03",
      ".f08",
      ".f90",
      ".f95"
    ],
    "aspects": [
      "real_fortran_docs_aspect"
    ]
  }
}
