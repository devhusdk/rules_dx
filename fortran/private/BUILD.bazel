load("//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = [
    "//:__pkg__",
    "//fortran:__subpackages__",
    "//tools/ci:__pkg__",
])

exports_files([
    "defs.bzl",
    "flang.BUILD.bazel",
    "flang_rt.BUILD.bazel",
    "kwargs.bzl",
])

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    visibility = ["//tools/coverage/kcov:__pkg__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "kwargs.bzl",
        "flang.BUILD.bazel",
        "flang_rt.BUILD.bazel",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = [
        "BUILD.bazel",
    ] + glob([
        "*.BUILD.bazel",
        "*.bzl",
    ]),
    visibility = ["//:__subpackages__"],
)
