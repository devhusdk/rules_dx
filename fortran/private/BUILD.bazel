load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = [
    "//:__pkg__",
    "//fortran:__subpackages__",
    "//tools/ci:__pkg__",
])

exports_files([
    "defs.bzl",
    "flang_rt.BUILD.bazel",
    "kwargs.bzl",
])

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    visibility = ["//tools/coverage/kcov:__pkg__"],
)

bool_flag(
    name = "kcov",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "kcov_build",
    flag_values = {":kcov": "true"},
    visibility = ["//visibility:public"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "kwargs.bzl",
        "flang_rt.BUILD.bazel",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
        "*.BUILD.bazel",
    ]),
    visibility = ["//:__subpackages__"],
)
