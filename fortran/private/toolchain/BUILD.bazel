load("//core/quality:fixtures.bzl", "real_source_target")
load(":pins.bzl", "FORTRAN_CELLS")

package(default_visibility = ["//visibility:public"])

exports_files([
    "pins.bzl",
    "repos.bzl",
    "extensions.bzl",
    "toolchain.bzl",
])

[
    config_setting(
        name = "cell_" + cell,
        constraint_values = FORTRAN_CELLS[cell].constraints,
    )
    for cell in sorted(FORTRAN_CELLS.keys())
]

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
            "pins.bzl",
        "repos.bzl",
        "extensions.bzl",
        "toolchain.bzl",
    ],
    tags = ["corpus"],
)
