load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS_PUBLIC)

rust_library(
    name = "fpm_lock_lib",
    srcs = ["src/resolve.rs"],
    aliases = aliases(
        package_name = "fortran/private/tools/fpm_lock",
        normal = True,
    ),
    crate_name = "fpm_lock",
    crate_root = "src/resolve.rs",
    deps = all_crate_deps(
        package_name = "fortran/private/tools/fpm_lock",
        normal = True,
    ) + [
        "//cli/digest:dx_digest",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
    ],
)

rust_binary(
    name = "lock",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "fortran/private/tools/fpm_lock",
        normal = True,
    ),
    crate_name = "fpm_lock_bin",
    crate_root = "src/main.rs",
    visibility = VIS_TOOLS_PUBLIC,
    deps = all_crate_deps(
        package_name = "fortran/private/tools/fpm_lock",
        normal = True,
    ) + [
        ":fpm_lock_lib",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
    ],
)

rust_test(
    name = "resolve_test",
    size = "small",
    srcs = ["resolve_test.rs"],
    aliases = aliases(
        package_name = "fortran/private/tools/fpm_lock",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "resolve_test",
    crate_root = "resolve_test.rs",
    data = [
        "testdata/fsparse.tar.gz",
        "testdata/golden.lock.json",
        "testdata/stdlib.tar.gz",
    ],
    env = {
        "FSPARSE": "$(rootpath testdata/fsparse.tar.gz)",
        "GOLDEN": "$(rootpath testdata/golden.lock.json)",
        "STDLIB": "$(rootpath testdata/stdlib.tar.gz)",
    },
    tags = ["block-network"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = all_crate_deps(
        package_name = "fortran/private/tools/fpm_lock",
        normal = True,
        normal_dev = True,
    ) + [
        ":fpm_lock_lib",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = VIS_TOOLS_PUBLIC,
)

exports_files(
    [
        "src/main.rs",
    ],
    visibility = VIS_TOOLS_PUBLIC,
)
