load("//core:conformance.bzl", "dx_wrapper_contract_tests")
load("//core:defs.bzl", "expect_equal")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//fortran/private:defs.bzl", "FORTRAN_COMPATIBLE_WITH", "FORTRAN_EXTENSIONS", "library_name")
load("//fortran/private:kwargs.bzl", "fortran_library_kwargs", "fortran_link_kwargs", "fortran_with_defaults")
load(":toolchain_tests.bzl", "fortran_metadata_tests")

package(default_visibility = ["//visibility:private"])

UPSTREAM_EXTENSIONS = [
    ".f",
    ".f90",
    ".f95",
    ".f03",
    ".f08",
    ".F",
    ".F90",
    ".F95",
    ".F03",
    ".F08",
]

_ALL = {
    "args": ["--x"],
    "copts": ["-O2"],
    "data": [":d"],
    "defines": ["X"],
    "deps": [":lib"],
    "env": {"K": "1"},
    "env_inherit": ["HOME"],
    "hdrs": ["a.inc"],
    "includes": ["inc"],
    "linkopts": ["-lm"],
    "size": "small",
    "srcs": ["main.f90"],
    "stamp": 0,
    "tags": ["t"],
    "timeout": "short",
}

dx_wrapper_contract_tests(
    name = "wrapper_contract_tests",
    size = "small",
    extra_checks = [
        expect_equal(
            "the extensions match rules_fortran",
            ["." + ext for ext in FORTRAN_EXTENSIONS],
            UPSTREAM_EXTENSIONS,
        ),
        expect_equal(
            "lint and format both run on Fortran",
            fortran_with_defaults({"tags": ["x"]})["tags"],
            ["x"],
        ),
        expect_equal(
            "the Fortran cell is the default",
            type(fortran_with_defaults({})["target_compatible_with"]),
            type(FORTRAN_COMPATIBLE_WITH),
        ),
        expect_equal(
            "the guard stays with a user list",
            type(fortran_with_defaults({"target_compatible_with": ["//x:y"]})["target_compatible_with"]),
            "select",
        ),
        expect_equal(
            "the guard stays with an empty list",
            type(fortran_with_defaults({"target_compatible_with": []})["target_compatible_with"]),
            "select",
        ),
        expect_equal(
            "compile attributes reach the library",
            sorted(fortran_library_kwargs(_ALL).keys()),
            [
                "copts",
                "defines",
                "deps",
                "hdrs",
                "includes",
                "srcs",
                "tags",
            ],
        ),
        expect_equal(
            "link and run attributes reach the C++ rule",
            sorted(fortran_link_kwargs(_ALL).keys()),
            [
                "args",
                "data",
                "env",
                "env_inherit",
                "linkopts",
                "size",
                "stamp",
                "tags",
                "timeout",
            ],
        ),
        expect_equal(
            "configurable copts stay a select",
            type(fortran_library_kwargs({"copts": select({"//conditions:default": ["-O2"]})})["copts"]),
            "select",
        ),
        expect_equal(
            "configurable linkopts stay a select",
            type(fortran_link_kwargs({"linkopts": select({"//conditions:default": ["-lm"]})})["linkopts"]),
            "select",
        ),
        expect_equal(
            "the private library is named after the executable",
            library_name("app_upstream"),
            "app_upstream_fortran",
        ),
    ],
    file_classes = ["fortran"],
)

fortran_metadata_tests(
    name = "metadata",
    size = "small",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "toolchain_tests.bzl",
    ],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)
