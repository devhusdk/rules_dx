load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//fortran:defs.bzl", "fortran_binary", "fortran_library", "fortran_test")
load("//fortran/private:defs.bzl", "FORTRAN_COMPATIBLE_WITH")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "subject_compatible_with")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

fortran_library(
    name = "greet",
    srcs = ["greet.f90"],
)

fortran_library(
    name = "lint_dirty",
    srcs = ["lint_dirty.f90"],
    tags = ["manual"],
)

fortran_library(
    name = "format_dirty",
    srcs = ["format_dirty.f90"],
    tags = ["manual"],
)

fortran_binary(
    name = "hello",
    srcs = ["hello.f90"],
    deps = [":greet"],
)

fortran_binary(
    name = "runfiles_hello",
    srcs = ["runfiles_main.f90"],
    data = ["data.txt"],
)

fortran_test(
    name = "pass_subject_test",
    size = "small",
    srcs = ["pass_test.f90"],
    target_compatible_with = subject_compatible_with() + FORTRAN_COMPATIBLE_WITH,
    deps = [":greet"],
)

fortran_test(
    name = "fail_subject_test",
    size = "small",
    srcs = ["fail_test.f90"],
    target_compatible_with = subject_compatible_with() + FORTRAN_COMPATIBLE_WITH,
    deps = [":greet"],
)

dx_conformance_suite(
    name = "",
    size = "small",
    binary = ":hello",
    covered_source = "greet.f90",
    expected = "hello world",
    failing_case = "failing_case",
    failing_pattern = "{case}",
    failing_test = ":fail_subject_test",
    lang = "fortran",
    passing_test = ":pass_subject_test",
    quality = {
        "clean": ":greet",
        "format_dirty": ":format_dirty",
        "format_source": "format_dirty.f90",
        "lint_dirty": ":lint_dirty",
        "lint_line": 1,
        "lint_rule": "C001",
        "lint_source": "lint_dirty.f90",
    },
    runfiles = {
        "binary": ":runfiles_hello",
        "data": "data.txt",
        "expected": "hello runfiles",
    },
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
