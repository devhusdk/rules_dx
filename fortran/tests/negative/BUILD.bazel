load("//fortran/rules:defs.bzl", "fortran_library")
load("//fortran/tests/negative:negative_tests.bzl", "fortran_module_input_test")
load("//quality:fixtures.bzl", "real_source_target")

fortran_library(
    name = "base_dep",
    srcs = ["base_dep.f90"],
    tags = ["manual"],
)

fortran_library(
    name = "missing_dep",
    srcs = ["needs_dep.f90"],
    tags = ["manual"],
)

fortran_library(
    name = "declared_dep",
    srcs = ["needs_dep.f90"],
    tags = ["manual"],
    deps = [":base_dep"],
)

fortran_library(
    name = "same_target",
    srcs = [
        "consumer.f90",
        "provider.f90",
    ],
    tags = ["manual"],
)

fortran_module_input_test(
    name = "undeclared_module_is_not_an_input_test",
    src = "needs_dep.f90",
    module_dir = "base_dep_upstream_modules",
    present = False,
    target = ":missing_dep_upstream",
)

fortran_module_input_test(
    name = "declared_module_is_an_input_test",
    src = "needs_dep.f90",
    module_dir = "base_dep_upstream_modules",
    present = True,
    target = ":declared_dep_upstream",
)

fortran_module_input_test(
    name = "sibling_module_is_not_an_input_test",
    src = "consumer.f90",
    module_dir = "same_target_upstream_modules/provider_f90",
    present = False,
    target = ":same_target_upstream",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "negative_tests.bzl",
    ],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)
