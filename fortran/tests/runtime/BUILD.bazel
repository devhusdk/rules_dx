load("@rules_dx//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_dx//fortran:defs.bzl", "FORTRAN_COMPATIBLE_WITH", "fortran_binary", "fortran_library", "fortran_test")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//tools/testing:hello_output.bzl", "dx_hello_output_test")

fortran_library(
    name = "greet",
    srcs = ["greet.f90"],
)

fortran_library(
    name = "stats",
    srcs = ["stats.f90"],
    deps = [":greet"],
)

fortran_binary(
    name = "hello",
    srcs = ["main.f90"],
    deps = [":greet"],
)

dx_hello_output_test(
    name = "hello_output_test",
    binary = ":hello",
    expected = "Hello, fortran!",
    target_compatible_with = FORTRAN_COMPATIBLE_WITH,
)

fortran_test(
    name = "stats_test",
    srcs = ["stats_test.f90"],
    deps = [":stats"],
)

cc_library(
    name = "c_add",
    srcs = ["c_add.c"],
    hdrs = ["c_add.h"],
)

fortran_test(
    name = "calls_c_test",
    srcs = ["calls_c_test.f90"],
    deps = [":c_add"],
)

fortran_library(
    name = "dot",
    srcs = ["dot.f90"],
)

cc_test(
    name = "dot_test",
    srcs = ["dot_test.c"],
    target_compatible_with = FORTRAN_COMPATIBLE_WITH,
    deps = [":dot"],
)

fortran_test(
    name = "io_test",
    srcs = ["io_test.F90"],
    copts = select({"//conditions:default": ["-DDX_FORTRAN_SELECT=7"]}),
    env = {"DX_FORTRAN_PROBE": "env"},
)

fortran_test(
    name = "same_basename_test",
    srcs = ["same_basename_test.f90"],
    deps = [
        "//fortran/tests/runtime/kinds_a",
        "//fortran/tests/runtime/kinds_b",
    ],
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["@rules_dx//tools/docs/support_matrix:__pkg__"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//:__pkg__"],
)
