  "entry_points": [
    "fsharp_library",
    "fsharp_binary",
    "fsharp_test",
    "fsharp_bench",
    "fsharp_fuzz_test",
    "fsharp_doc_shard"
  ],
  "quality": {
    "bzl": "dotnet/private/quality:dotnet.bzl",
    "classes": [
      "fsharp"
    ],
    "file_extensions": [
      ".fs",
      ".fsproj",
      ".fsx"
    ]
  }
