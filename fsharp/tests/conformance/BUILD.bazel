load("//core/quality:fixtures.bzl", "real_source_target")
load("//fsharp:defs.bzl", "fsharp_binary", "fsharp_library", "fsharp_test")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "subject_compatible_with")
load("//tools/testing/conformance:quality.bzl", "dotnet_format_subject", "dotnet_lint_subject")

# gazelle:exclude Greet.fs

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

# keep
fsharp_library(
    name = "greet",
    srcs = ["Greet.fs"],
    deps = ["@nuget//fsharp.core"],
)

fsharp_library(
    name = "lint_dirty",
    srcs = ["quality/LintDirty.fs"],
    tags = ["manual"],
    deps = ["@nuget//fsharp.core"],
)

fsharp_library(
    name = "format_dirty",
    srcs = ["quality/FormatDirty.fs"],
    tags = ["manual"],
    deps = ["@nuget//fsharp.core"],
)

fsharp_binary(
    name = "hello",
    srcs = ["Hello.fs"],
    deps = [
        ":greet",
        "@nuget//fsharp.core",
    ],
)

fsharp_test(
    name = "pass_subject_test",
    size = "small",
    srcs = ["PassTest.fs"],
    target_compatible_with = subject_compatible_with(),
    deps = [
        ":greet",
        "@nuget//fsharp.core",
    ],
)

fsharp_test(
    name = "fail_subject_test",
    size = "small",
    srcs = ["FailTest.fs"],
    target_compatible_with = subject_compatible_with(),
    deps = [
        ":greet",
        "@nuget//fsharp.core",
    ],
)

fsharp_binary(
    name = "runfiles_hello",
    srcs = ["RunfilesMain.fs"],
    data = ["data.txt"],
    deps = [
        "@nuget//fsharp.core",
        "@rules_dotnet//tools/runfiles",
    ],
)

fsharp_binary(
    name = "lock_hello",
    srcs = ["LockMain.fs"],
    deps = [
        "@nuget//fsharp.core",
        "@nuget//google.protobuf",
    ],
)

dx_conformance_suite(
    name = "",
    size = "small",
    binary = ":hello",
    covered_source = "Greet.fs",
    cross_runfile = "dotnet",
    expected = "hello world",
    failing_case = "failing_case",
    failing_pattern = "{case}",
    failing_test = ":fail_subject_test",
    lang = "fsharp",
    lock = {
        "binary": ":lock_hello",
        "ecosystem": "fsharp",
        "expected": "hello lock",
        "lockfile": "//third_party/dotnet:paket.lock",
        "manifest": "paket.dependencies",
        "package": "Google.Protobuf",
        "stale": "paket.stale.lock",
    },
    passing_test = ":pass_subject_test",
    quality = {
        "clean": ":greet",
        "format_dirty": ":format_dirty",
        "format_source": "quality/FormatDirty.fs",
        "format_subject": dotnet_format_subject,
        "lint_dirty": ":lint_dirty",
        "lint_line": 3,
        "lint_rule": "FL0036",
        "lint_source": "quality/LintDirty.fs",
        "lint_subject": dotnet_lint_subject,
    },
    runfiles = {
        "binary": ":runfiles_hello",
        "data": "data.txt",
        "expected": "hello runfiles",
    },
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
