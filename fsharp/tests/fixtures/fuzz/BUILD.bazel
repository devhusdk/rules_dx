# gazelle:ignore
load("@rules_dx//core:fuzz_bench_tests.bzl", "dx_runner_attr_test")
load("@rules_dx//dotnet/private/fuzz:labels.bzl", "LIBFUZZER_DOTNET")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//csharp/private:sharpfuzz_check.bzl", "dx_sharpfuzz_transitive_test")
load("//fsharp:defs.bzl", "fsharp_fuzz_test", "fsharp_library")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

fsharp_library(
    name = "parser",
    srcs = ["Parser.fs"],
    deps = ["@paket.main//fsharp.core"],
)

fsharp_fuzz_test(
    name = "parse_fuzz",
    srcs = ["Harness.fs"],
    deps = [
        ":parser",
        "@paket.main//fsharp.core",
    ],
)

sh_test(
    name = "parse_fuzz_run_test",
    srcs = ["run_test.sh"],
    args = [
        "$(rootpath @rules_dx//dotnet/private/fuzz:libfuzzer_dotnet)",
        "$(rootpath @rules_dx//cli/fuzz_run:fuzz_run)",
        "$(rootpath :parse_fuzz)",
        "$(rootpath :transitive_fuzz)",
    ],
    data = [
        ":parse_fuzz",
        ":transitive_fuzz",
        "@rules_dx//dotnet/private/fuzz:libfuzzer_dotnet",
        "@rules_dx//cli/fuzz_run:fuzz_run",
    ],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    timeout = "moderate",
)

fsharp_library(
    name = "wrapper",
    srcs = ["Wrapper.fs"],
    deps = [
        ":parser",
        "@paket.main//fsharp.core",
    ],
)

fsharp_fuzz_test(
    name = "transitive_fuzz",
    srcs = ["TransitiveHarness.fs"],
    deps = [
        ":wrapper",
        "@paket.main//fsharp.core",
    ],
)

dx_sharpfuzz_transitive_test(
    name = "transitive_fuzz_instrumented",
    chain = [
        "wrapper_upstream.dll",
        "parser_upstream.dll",
    ],
    harness = ":transitive_fuzz",
)

fsharp_fuzz_test(
    name = "args_fuzz",
    srcs = ["Harness.fs"],
    args = ["-max_total_time=1"],
    deps = [
        ":parser",
        "@paket.main//fsharp.core",
    ],
)

dx_runner_attr_test(
    name = "args_fuzz_attrs",
    expected = {
        "args": ["-max_total_time=1"],
        "tags": ["dx-fuzz"],
    },
    runner = "args_fuzz",
)

dx_runner_attr_test(
    name = "parse_fuzz_run_attrs",
    expected = {"args": [
        "dotnet",
        "$(rootpath %s)" % LIBFUZZER_DOTNET,
        "$(rootpath :parse_fuzz)",
    ]},
    runner = "parse_fuzz_run",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
