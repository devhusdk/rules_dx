load("//fsharp/rules:defs.bzl", "fsharp_binary", "fsharp_library", "fsharp_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//tools/sh:harness.bzl", "dx_shell_harness")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

fsharp_library(
    name = "hello_lib",
    srcs = ["Library.fs"],
    deps = ["@paket.main//fsharp.core"],
)

fsharp_binary(
    name = "hello",
    srcs = ["Program.fs"],
    deps = [
        ":hello_lib",
        "@paket.main//fsharp.core",
    ],
)

fsharp_test(
    name = "hello_test",
    srcs = ["HelloTest.fs"],
    deps = [
        ":hello_lib",
        "@paket.main//fsharp.core",
    ],
)

dx_shell_harness(
    name = "hello_output_test",
    srcs = ["hello_output_test.sh"],
    args = ["$(rootpath :hello)"],
    data = [
        ":hello",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
