load("//fsharp/rules:defs.bzl", "fsharp_binary", "fsharp_library", "fsharp_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//tools/testing:hello_output.bzl", "dx_hello_output_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

fsharp_library(
    name = "hello_lib",
    srcs = ["Library.fs"],
    deps = ["@paket.main//fsharp.core"],
)

fsharp_binary(
    name = "hello",
    srcs = ["Program.fs"],
    deps = [
        ":hello_lib",
        "@paket.main//fsharp.core",
    ],
)

fsharp_test(
    name = "hello_test",
    srcs = ["HelloTest.fs"],
    deps = [
        ":hello_lib",
        "@paket.main//fsharp.core",
    ],
)

dx_hello_output_test(
    name = "hello_output_test",
    binary = ":hello",
    expected = "hello world",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
