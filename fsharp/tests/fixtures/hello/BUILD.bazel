load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//tools/testing:hello_output.bzl", "dx_hello_output_test")
load("//fsharp:defs.bzl", "fsharp_binary", "fsharp_library", "fsharp_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

fsharp_library(
    name = "hello",
    testonly = True,
    srcs = ["Library.fs"],
)

fsharp_binary(
    name = "hello_bin",
    srcs = ["Program.fs"],
    deps = [
        ":hello",
        "@paket.main//fsharp.core",
    ],
)

fsharp_test(
    name = "hello_test",
    srcs = ["HelloTest.fs"],
    deps = [":hello"],
)

dx_hello_output_test(
    name = "hello_output_test",
    binary = ":hello_bin",
    expected = "hello world",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
