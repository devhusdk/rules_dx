load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")

exports_files(
    ["languages.bzl"],
    visibility = ["//gazelle:__subpackages__"],
)

write_file(
    name = "subpackages",
    out = "subpackages.txt",
    content = subpackages(include = ["**"]),
    visibility = ["//tools/ci:__pkg__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "languages.bzl",
    ],
    tags = ["corpus"],
)
