load("@rules_dx//astro:defs.bzl", "astro_library")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

astro_library(
    name = "helper",
    srcs = ["helper.astro"],
    visibility = ["//visibility:public"],
)

astro_library(
    name = "helper_test",
    srcs = ["helper_test.astro"],
    visibility = ["//visibility:public"],
    deps = [":helper"],
)

astro_library(
    name = "main",
    srcs = ["main.astro"],
    visibility = ["//visibility:public"],
    deps = [":helper"],
)
