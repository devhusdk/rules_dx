load("@rules_dx//avro:defs.bzl", "avro_cc_library", "avro_java_library", "avro_library")

avro_library(
    name = "api",
    srcs = ["point.avdl"],
    visibility = ["//visibility:public"],
)

avro_cc_library(
    name = "api_cc",
    visibility = ["//visibility:public"],
    deps = [":api"],
)

avro_java_library(
    name = "api_java",
    visibility = ["//visibility:public"],
    deps = [":api"],
)
