load("@rules_dx//capnproto:defs.bzl", "capnp_cc_library", "capnp_java_library", "capnp_library")

capnp_library(
    name = "api",
    srcs = ["point.capnp"],
    visibility = ["//visibility:public"],
)

capnp_cc_library(
    name = "api_cc",
    visibility = ["//visibility:public"],
    deps = [":api"],
)

capnp_java_library(
    name = "api_java",
    visibility = ["//visibility:public"],
    deps = [":api"],
)
