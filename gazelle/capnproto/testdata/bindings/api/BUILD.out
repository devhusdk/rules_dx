load("@rules_dx//capnproto:defs.bzl", "capnproto_cc_library", "capnproto_java_library", "capnproto_library")

capnproto_library(
    name = "api",
    srcs = ["point.capnp"],
    visibility = ["//visibility:public"],
)

capnproto_cc_library(
    name = "api_cc",
    visibility = ["//visibility:public"],
    deps = [":api"],
)

capnproto_java_library(
    name = "api_java",
    visibility = ["//visibility:public"],
    deps = [":api"],
)
