load("@gazelle//:def.bzl", "gazelle_generation_test")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "cc",
    srcs = [
        "cuda.go",
        "doc.go",
        "lang.go",
        "naming.go",
        "parser.go",
    ],
    importpath = "github.com/devhusdk/rules_dx/gazelle/cc",
    visibility = ["//gazelle/dispatch:__pkg__"],
    deps = [
        "//gazelle/common",
        "@gazelle//config",
        "@gazelle//language",
        "@gazelle//repo",
        "@gazelle//resolve",
        "@gazelle//rule",
        "@gazelle//v2/label",
        "@gazelle//v2/rule",
    ],
)

filegroup(
    name = "generation_testdata",
    srcs = glob(["testdata/**"]),
)

gazelle_generation_test(
    name = "generation_test",
    gazelle_binary = "//gazelle/dispatch:gazelle",
    pure = "on",
    tags = ["no-coverage"],
    test_data = [":generation_testdata"],
)

go_test(
    name = "cc_test",
    srcs = [
        "lang_test.go",
        "naming_test.go",
        "parser_test.go",
        "wrapper_exts_test.go",
    ],
    data = [
        "//cuda/rules:defs.bzl",
        "//quality:sources.bzl",
    ],
    embed = [":cc"],
    env = {
        "CUDA_DEFS_BZL": "$(rlocationpath //cuda/rules:defs.bzl)",
        "QUALITY_SOURCES_BZL": "$(rlocationpath //quality:sources.bzl)",
    },
    pure = "on",
)

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["//quality:corpus_vale_config"],
    markdown_srcs = [
        "testdata/cuda_generate/README.md",
        "testdata/cuda_keep/README.md",
        "testdata/entries/README.md",
        "testdata/merge/README.md",
        "testdata/source_only/README.md",
        "testdata/split_binary/README.md",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
