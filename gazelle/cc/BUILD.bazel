load("@gazelle//:def.bzl", "gazelle_binary", "gazelle_generation_test")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "cc",
    srcs = [
        "doc.go",
        "lang.go",
        "naming.go",
        "parser.go",
    ],
    importpath = "github.com/ralvik/rules_dx/gazelle/cc",
    visibility = ["//gazelle/dispatch:__pkg__"],
    deps = [
        "//gazelle/common",
        "@gazelle//config",
        "@gazelle//language",
        "@gazelle//repo",
        "@gazelle//resolve",
        "@gazelle//rule",
        "@gazelle//v2/label",
        "@gazelle//v2/rule",
    ],
)

gazelle_binary(
    name = "gazelle",
    languages = [":cc"],
    tags = ["no-coverage"],
    version = 1,
    visibility = ["//dx:__pkg__"],
)

filegroup(
    name = "generation_testdata",
    srcs = glob(["testdata/**"]),
)

gazelle_generation_test(
    name = "generation_test",
    gazelle_binary = ":gazelle",
    pure = "on",
    tags = ["no-coverage"],
    test_data = [":generation_testdata"],
)

go_test(
    name = "cc_test",
    srcs = [
        "lang_test.go",
        "naming_test.go",
        "parser_test.go",
    ],
    embed = [":cc"],
    pure = "on",
)

real_source_target(
    name = "corpus_markdown",
    markdown_siblings = [
        "testdata/entries/README.md",
        "testdata/merge/README.md",
        "testdata/source_only/README.md",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
