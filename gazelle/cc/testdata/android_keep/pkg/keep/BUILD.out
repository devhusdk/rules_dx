load("@rules_dx//cc:defs.bzl", "cc_library")

cc_library(
    name = "keep",
    srcs = ["activity.c"],
    linkopts = [
        "-landroid",
        "-llog",
        "-lm",
    ],
    target_compatible_with = select({
        "@platforms//os:android": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
    alwayslink = False,
)
