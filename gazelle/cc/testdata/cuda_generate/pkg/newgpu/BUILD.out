load("@rules_dx//cc:defs.bzl", "cc_library")
load("@rules_dx_cuda//rules:defs.bzl", "cuda_library")

cc_library(
    name = "newgpu",
    srcs = ["host.cc"],
    hdrs = ["host.h"],
    visibility = ["//visibility:public"],
    deps = [":newgpu_cuda"],
)

cuda_library(
    name = "newgpu_cuda",
    srcs = ["kernel.cu"],
    hdrs = ["kernel.cuh"],
    cuda_archs = ["sm_89"],
    visibility = ["//visibility:public"],
)
