load("@rules_dx//cc:defs.bzl", "cc_library")
load("@rules_dx//cuda:defs.bzl", "cuda_library")

# gazelle:resolve cc kernel.cuh //pkg/hostinc:kernel

cuda_library(
    name = "kernel",
    srcs = ["kernel.cu"],
    hdrs = ["kernel.cuh"],
    cuda_archs = ["sm_89"],
)

cc_library(
    name = "hostinc",
    srcs = ["app.cc"],
    visibility = ["//visibility:public"],
    deps = [":kernel"],
)
