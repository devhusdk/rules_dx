load("@rules_dx//cc/rules:defs.bzl", "cc_library", "cc_test")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

cc_library(
    name = "demo",
    srcs = [
        "helper.cc",
        "main.cc",
    ],
    hdrs = ["helper.h"],
)

cc_test(
    name = "helper_test",
    srcs = ["helper_test.cc"],
    deps = [":demo"],
)
