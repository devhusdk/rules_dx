load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")

proto_library(
    name = "api_proto",
    srcs = ["user.proto"],
    strip_import_prefix = "/",
    visibility = ["//visibility:public"],
)

cc_proto_library(
    name = "api_cc_proto",
    visibility = ["//visibility:public"],
    deps = [":api_proto"],
)
