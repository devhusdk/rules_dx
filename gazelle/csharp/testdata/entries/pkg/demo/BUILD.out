load("@rules_dx_dotnet//csharp/rules:defs.bzl", "csharp_library", "csharp_test")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

csharp_library(
    name = "demo",
    srcs = [
        "Helper.cs",
        "Main.cs",
    ],
    visibility = ["//visibility:public"],
)

csharp_test(
    name = "helper_test",
    srcs = ["HelperTest.cs"],
    deps = [":demo"],
)
