load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_dx_dotnet//csharp/rules:defs.bzl", "csharp_proto_library")

proto_library(
    name = "api_proto",
    srcs = ["user.proto"],
    strip_import_prefix = "/",
    visibility = ["//visibility:public"],
)

csharp_proto_library(
    name = "api_proto_cs",
    proto = ":api_proto",
    visibility = ["//visibility:public"],
    deps = ["@paket.main//google.protobuf"],
)
