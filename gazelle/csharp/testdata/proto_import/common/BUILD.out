load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_dx//csharp:defs.bzl", "csharp_proto_library")

proto_library(
    name = "common_proto",
    srcs = ["money.proto"],
    strip_import_prefix = "/",
    visibility = ["//visibility:public"],
)

csharp_proto_library(
    name = "common_proto_cs",
    proto = ":common_proto",
    visibility = ["//visibility:public"],
    deps = ["@paket.main//google.protobuf"],
)
