load("@rules_dx//csharp:defs.bzl", "csharp_library", "csharp_test")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

csharp_library(
    name = "demo",
    srcs = [
        "Demo.cs",
        "Helper.cs",
    ],
    visibility = ["//visibility:public"],
)

csharp_test(
    name = "demo_test",
    srcs = ["DemoTest.cs"],
    deps = [":demo"],
)
