load("@rules_dx//dart:defs.bzl", "dart_binary", "dart_library", "dart_package_metadata", "dart_test")

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "greet",
)

dart_library(
    name = "greet",
    srcs = [
        "lib/greet.dart",
        "lib/src/util.dart",
    ],
    package = ":pubspec-metadata",
    visibility = ["//visibility:public"],
    deps = ["@pub_deps//:collection"],
)

dart_binary(
    name = "greet_bin",
    main = "bin/greet.dart",
    deps = [":greet"],
)

dart_test(
    name = "greet_test",
    size = "small",
    srcs = ["test/helpers.dart"],
    main = "test/greet_test.dart",
    deps = [
        ":greet",
        "@pub_deps//:test",
    ],
)
