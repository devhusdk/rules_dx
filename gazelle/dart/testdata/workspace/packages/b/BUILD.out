load("@rules_dx//dart:defs.bzl", "dart_binary", "dart_library", "dart_package_metadata")

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "b",
)

dart_library(
    name = "b",
    srcs = ["lib/b.dart"],
    package = ":pubspec-metadata",
    visibility = ["//visibility:public"],
    deps = ["//packages/a"],
)

dart_binary(
    name = "tool",
    main = "bin/tool.dart",
    deps = [":b"],
)
