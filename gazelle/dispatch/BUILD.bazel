load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//gazelle:languages.bzl", "GAZELLE_LANGUAGES", "gazelle_languages_test_source")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "dispatch",
    srcs = [
        "android.go",
        "doc.go",
        "lang.go",
    ],
    importpath = "github.com/devhusdk/rules_dx/gazelle/dispatch",
    visibility = ["@dx_gazelle//:__pkg__"],
    deps = [
        "//gazelle/common",
        "@com_github_bazelbuild_buildtools//build",
        "@gazelle//config",
        "@gazelle//language",
        "@gazelle//rule",
    ],
)

gazelle_languages_test_source(name = "all_languages_test_go")

go_test(
    name = "dispatch_test",
    srcs = [
        "conformance_test.go",
        "lang_test.go",
        ":all_languages_test_go",
    ],
    data = ["lang.go"],
    embed = [":dispatch"],
    pure = "on",
    deps = ["//gazelle/%s" % name for name in GAZELLE_LANGUAGES] + [
        "//gazelle/common",
        "@gazelle//config",
        "@gazelle//language",
        "@gazelle//merger",
        "@gazelle//resolve",
        "@gazelle//rule",
        "@gazelle//v2/label",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
