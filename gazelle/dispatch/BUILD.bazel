load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//quality:fixtures.bzl", "real_source_target")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load(":hub_tests.bzl", "dx_gazelle_hub_tests")
load(":languages.bzl", "GAZELLE_LANGUAGES")

package(default_visibility = ["//visibility:private"])

exports_files(
    [
        "extension.bzl",
        "hub.bzl",
    ],
    visibility = ["//visibility:public"],
)

dx_gazelle_hub_tests(name = "hub_test")

write_file(
    name = "all_languages_test_go",
    out = "all_languages_test.go",
    content = (
        ["package dispatch", "", "import ("] +
        ["\t_ \"github.com/devhusdk/rules_dx/gazelle/%s\"" % lang for lang in GAZELLE_LANGUAGES] +
        [")", "", "var generatedLanguages = []string{"] +
        ["\t\"%s\"," % lang for lang in GAZELLE_LANGUAGES] +
        ["}", ""]
    ),
)

go_library(
    name = "dispatch",
    srcs = [
        "android.go",
        "doc.go",
        "lang.go",
    ],
    importpath = "github.com/devhusdk/rules_dx/gazelle/dispatch",
    visibility = ["@dx_gazelle//:__pkg__"],
    deps = [
        "//gazelle/common",
        "@com_github_bazelbuild_buildtools//build",
        "@gazelle//config",
        "@gazelle//language",
        "@gazelle//rule",
    ],
)

go_test(
    name = "dispatch_test",
    srcs = [
        "all_languages_test.go",
        "conformance_test.go",
        "lang_test.go",
        "languages_test.go",
    ],
    embed = [":dispatch"],
    pure = "on",
    deps = [
        "//gazelle/common",
        "@gazelle//config",
        "@gazelle//language",
        "@gazelle//merger",
        "@gazelle//resolve",
        "@gazelle//rule",
        "@gazelle//v2/label",
    ] + ["//gazelle/%s" % lang for lang in GAZELLE_LANGUAGES],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "extension.bzl",
        "hub.bzl",
        "hub_tests.bzl",
    ],
    tags = ["corpus"],
)
