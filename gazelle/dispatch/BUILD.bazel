load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//gazelle:languages.bzl", "GAZELLE_LANGUAGES", "gazelle_languages_test_source")
load("//quality:fixtures.bzl", "real_source_target")
load(":hub_tests.bzl", "dx_gazelle_hub_tests")

package(default_visibility = ["//visibility:private"])

exports_files(
    [
        "extension.bzl",
        "hub.bzl",
    ],
    visibility = ["//visibility:public"],
)

dx_gazelle_hub_tests(name = "hub_test")

go_library(
    name = "dispatch",
    srcs = [
        "android.go",
        "doc.go",
        "lang.go",
    ],
    importpath = "github.com/devhusdk/rules_dx/gazelle/dispatch",
    visibility = ["@dx_gazelle//:__pkg__"],
    deps = [
        "//gazelle/common",
        "@com_github_bazelbuild_buildtools//build",
        "@gazelle//config",
        "@gazelle//language",
        "@gazelle//rule",
    ],
)

gazelle_languages_test_source(name = "all_languages_test_go")

go_test(
    name = "dispatch_test",
    srcs = [
        ":all_languages_test_go",
        "conformance_test.go",
        "lang_test.go",
    ],
    embed = [":dispatch"],
    pure = "on",
    data = ["lang.go"],
    deps = ["//gazelle/%s" % name for name in GAZELLE_LANGUAGES] + [
        "//gazelle/common",
        "@gazelle//config",
        "@gazelle//language",
        "@gazelle//merger",
        "@gazelle//resolve",
        "@gazelle//rule",
        "@gazelle//v2/label",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "extension.bzl",
        "hub.bzl",
        "hub_tests.bzl",
    ],
    tags = ["corpus"],
)
