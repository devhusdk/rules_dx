load("@rules_dx//elixir/rules:defs.bzl", "elixir_app", "ex_unit_test")

elixir_app(
    name = "app",
    srcs = [
        "lib/app.ex",
        "lib/app/application.ex",
        "lib/app/worker.ex",
    ],
    app_module = "App.Application",
    app_name = "app",
    app_version = "0.2.0",
    deps = [
        "//apps/shared",
        "@jason//:erlang_app",
    ],
)

ex_unit_test(
    name = "app_test",
    srcs = [
        "test/app_test.exs",
        "test/test_helper.exs",
    ],
    deps = [":app"],
)
