load("@rules_dx//elixir/rules:defs.bzl", "elixir_app", "ex_unit_test")

elixir_app(
    name = "erlang_app",
    srcs = ["lib/legacy.ex"],
    app_env = "[{level, 1}]",
    app_name = "legacy",
    app_version = "9.9.9",
)

ex_unit_test(
    name = "legacy_test",
    srcs = [
        "test/a_test.exs",
        "test/b_test.exs",
        "test/test_helper.exs",
    ],
    deps = [":erlang_app"],
)
