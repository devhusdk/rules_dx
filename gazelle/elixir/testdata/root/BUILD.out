load("@rules_dx//elixir:defs.bzl", "elixir_app", "elixir_test")

elixir_app(
    name = "hello",
    srcs = ["lib/hello.ex"],
    app_name = "hello",
    app_version = "0.1.0",
    visibility = ["//visibility:public"],
)

elixir_test(
    name = "hello_test",
    srcs = [
        "test/hello_test.exs",
        "test/test_helper.exs",
    ],
    deps = [":hello"],
)
