load("@rules_dx//erlang:defs.bzl", "erlang_app", "erlang_bytecode", "erlang_erlc_opts", "erlang_eunit_test", "erlang_test_app")

erlang_app(
    name = "erlang_app",
    srcs = ["src/kv.erl"],
    app_description = "Key-value.",
    app_name = "kv",
    app_version = "0.2.0",
    visibility = ["//visibility:public"],
)

erlang_test_app(
    name = "test_erlang_app",
    app_name = "kv",
    app_version = "0.2.0",
)

erlang_erlc_opts(
    name = "test_erlc_opts",
    values = [
        "+deterministic",
        "+debug_info",
        "+warn_export_vars",
        "+warn_shadow_vars",
        "+warn_obsolete_guard",
        "-DTEST=1",
    ],
)

erlang_bytecode(
    name = "test_modules",
    testonly = True,
    srcs = ["test/kv_tests.erl"],
    outs = ["test/kv_tests.beam"],
    erlc_opts = ":test_erlc_opts",
    deps = [":test_erlang_app"],
)

erlang_eunit_test(
    name = "kv_test",
    size = "small",
    compiled_suites = [":test_modules"],
    target = ":test_erlang_app",
)
