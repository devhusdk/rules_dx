load("@rules_dx//erlang/rules:defs.bzl", "erlang_app")

APPS = ["//visibility:public"]

erlang_app(
    name = "erlang_app",
    srcs = [
        "src/kv.erl",
        "src/kv_extra.erl",
    ],
    app_env = "[{max_keys, 3}]",
    app_name = "kv",
    app_version = "1.0.0",
    visibility = APPS,
)
