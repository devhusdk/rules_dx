load("@rules_dx//flatbuffers/rules:codegen.bzl", "flatbuffers_cc_library", "flatbuffers_java_library", "flatbuffers_rust_library")
load("@rules_dx//flatbuffers/rules:defs.bzl", "flatbuffers_library")

flatbuffers_library(
    name = "api",
    srcs = ["point.fbs"],
    visibility = ["//visibility:public"],
)

flatbuffers_cc_library(
    name = "api_cc",
    visibility = ["//visibility:public"],
    deps = [":api"],
)

flatbuffers_java_library(
    name = "api_java",
    visibility = ["//visibility:public"],
    deps = [":api"],
)

flatbuffers_rust_library(
    name = "api_rust",
    library = ":api",
    visibility = ["//visibility:public"],
)
