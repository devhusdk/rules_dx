load("@rules_dx//flatbuffers:defs.bzl", "flatbuffers_cc_library", "flatbuffers_java_library", "flatbuffers_library")

flatbuffers_library(
    name = "multi",
    srcs = [
        "path.fbs",
        "point.fbs",
    ],
    visibility = ["//visibility:public"],
)

flatbuffers_cc_library(
    name = "multi_cc",
    visibility = ["//visibility:public"],
    deps = [":multi"],
)

flatbuffers_java_library(
    name = "multi_java",
    visibility = ["//visibility:public"],
    deps = [":multi"],
)
