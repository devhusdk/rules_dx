load("@rules_dx//fsharp/rules:defs.bzl", "fsharp_library", "fsharp_test")

filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

fsharp_library(
    name = "demo",
    # do not sort: F# compile order, dependencies first
    srcs = [
        "extra/Kept.fs",  # keep
        "Demo.fs",
        "Helper.fs",
    ],
    data = ["README.txt"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# keep
filegroup(
    name = "retained",
    srcs = ["removed.txt"],
)

fsharp_test(
    name = "demo_test",
    srcs = ["DemoTest.fs"],
    deps = [":demo"],
)
