load("@rules_dx//fsharp:defs.bzl", "fsharp_library")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

fsharp_library(
    name = "demo",
    # do not sort: F# compile order, dependencies first
    srcs = [
        "C.fs",
        "B.fs",
        "A.fs",
    ],
    visibility = ["//visibility:public"],
)
