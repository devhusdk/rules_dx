load("@rules_dx//fsharp/rules:defs.bzl", "fsharp_library", "fsharp_test")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

fsharp_library(
    name = "demo",
    # do not sort: F# compile order, dependencies first
    srcs = [
        "Helper.fs",
        "Demo.fs",
    ],
)

fsharp_test(
    name = "demo_test",
    srcs = ["DemoTest.fs"],
    deps = [":demo"],
)
