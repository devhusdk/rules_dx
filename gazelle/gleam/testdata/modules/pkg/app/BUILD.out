load("@rules_dx//gleam/rules:defs.bzl", "gleam_library", "gleam_test", "gleam_test_library")

# gazelle:resolve gleam gleam_stdlib //libs:gleam_stdlib

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["gleam.toml"],
)

gleam_library(
    name = "app",
    srcs = [
        "src/app.gleam",
        "src/app/core.gleam",
    ],
    deps = [
        "//libs:gleam_stdlib",
        "//pkg/shared",
    ],
)

gleam_test_library(
    name = "app_test_support",
    srcs = ["test/helper.gleam"],
)

gleam_test(
    name = "app_test",
    srcs = ["test/app_test.gleam"],
    deps = [
        ":app",
        ":app_test_support",
    ],
)
