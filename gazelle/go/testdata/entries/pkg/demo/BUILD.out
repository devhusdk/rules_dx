load("@rules_dx//go:defs.bzl", "go_library", "go_test")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

go_library(
    name = "demo",
    srcs = [
        "helper.go",
        "main.go",
    ],
    importpath = "example.com/entries/pkg/demo",
    visibility = ["//visibility:public"],
)

go_test(
    name = "demo_test",
    srcs = ["helper_test.go"],
    embed = [":demo"],
)
