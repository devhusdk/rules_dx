load("@gazelle//:def.bzl", "gazelle_generation_test")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_java//java:defs.bzl", "java_binary")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_test", "rustfmt_test")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "java",
    srcs = [
        "doc.go",
        "lang.go",
        "parser.go",
        "stdlib.go",
    ],
    importpath = "github.com/devhusdk/rules_dx/gazelle/java",
    visibility = ["//gazelle/dispatch:__pkg__"],
    deps = [
        "//gazelle/common",
        "@gazelle//language",
    ],
)

filegroup(
    name = "generation_testdata",
    srcs = glob(["testdata/**"]),
)

gazelle_generation_test(
    name = "generation_test",
    gazelle_binary = "//gazelle/dispatch:gazelle",
    pure = "on",
    tags = ["no-coverage"],
    test_data = [":generation_testdata"],
)

java_binary(
    name = "javac",
    testonly = True,
    main_class = "com.sun.tools.javac.Main",
    runtime_deps = [],
)

rust_test(
    name = "compile_test",
    srcs = ["//tools/testing:gazelle_compile_test.rs"],
    data = [
        "testdata/compile_external/WORKSPACE",
        ":generation_testdata",
        ":javac",
        "//gazelle/dispatch:gazelle",
        "@maven//:com_google_code_findbugs_jsr305",
    ],
    env = {
        "DX_CLASSPATH": "",
        "DX_COMPILER": "$(rootpath :javac)",
        "DX_DEPS": " ".join([
            "@maven//:com_google_code_findbugs_jsr305=$(rootpath @maven//:com_google_code_findbugs_jsr305)",
        ]),
        "DX_EXTENSION": "java",
        "DX_FIXTURE": "$(rootpath testdata/compile_external/WORKSPACE)",
        "DX_GAZELLE": "$(rootpath //gazelle/dispatch:gazelle)",
        "DX_LANGUAGE": "java",
        "DX_UNRESOLVED_HINT": "add a local library, a maven_install.json artifact, or a # gazelle:resolve mapping on the qualified import or its package",
    },
    tags = ["no-coverage"],
    deps = ["//tools/testing:dx_testing"],
)

go_test(
    name = "java_test",
    srcs = [
        "lang_test.go",
        "parser_test.go",
    ],
    embed = [":java"],
    pure = "on",
    deps = [
        "@gazelle//config",
        "@gazelle//resolve",
        "@gazelle//v2/label",
        "@gazelle//v2/rule",
    ],
)

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["//quality:corpus_vale_config"],
    markdown_srcs = [
        "testdata/compile_external/README.md",
        "testdata/entries/README.md",
        "testdata/merge/README.md",
        "testdata/qualified_import/README.md",
        "testdata/wildcard_import/README.md",
        "testdata/source_only/README.md",
        "testdata/static_import/README.md",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

rustfmt_test(
    name = "java_fmt_test",
    size = "small",
    targets = [
        ":compile_test",
    ],
)
