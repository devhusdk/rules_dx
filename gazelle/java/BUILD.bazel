load("@gazelle//:def.bzl", "gazelle_generation_test")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "java",
    srcs = [
        "doc.go",
        "lang.go",
        "parser.go",
        "stdlib.go",
    ],
    importpath = "github.com/devhusdk/rules_dx/gazelle/java",
    visibility = [
        "//gazelle/dispatch:__pkg__",
        "@dx_gazelle//:__pkg__",
    ],
    deps = [
        "//gazelle/common",
        "//gazelle/common/treesitter",
        "@com_github_odvcencio_gotreesitter//:gotreesitter",
        "@com_github_odvcencio_gotreesitter//grammars/java",
        "@gazelle//language",
        "@gazelle//v2/rule",
    ],
)

exports_files(
    ["testdata/compile_external/WORKSPACE"],
    visibility = ["//gazelle/java/tests:__pkg__"],
)

filegroup(
    name = "generation_testdata",
    srcs = glob(["testdata/**"]),
    visibility = ["//gazelle/java/tests:__pkg__"],
)

gazelle_generation_test(
    name = "generation_test",
    gazelle_binary = "@dx_gazelle//:gazelle",
    pure = "on",
    tags = ["no-coverage"],
    test_data = [":generation_testdata"],
)

go_test(
    name = "java_test",
    srcs = [
        "lang_test.go",
        "parser_test.go",
    ],
    embed = [":java"],
    pure = "on",
    deps = [
        "@gazelle//config",
        "@gazelle//resolve",
        "@gazelle//v2/label",
        "@gazelle//v2/rule",
    ],
)

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = [
        "testdata/android_bridge/README.md",
        "testdata/android_keep/README.md",
        "testdata/android_upstream/README.md",
        "testdata/compile_external/README.md",
        "testdata/entries/README.md",
        "testdata/merge/README.md",
        "testdata/proto_import/README.md",
        "testdata/qualified_import/README.md",
        "testdata/wildcard_import/README.md",
        "testdata/source_only/README.md",
        "testdata/static_import/README.md",
        "testdata/test_owner/README.md",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

