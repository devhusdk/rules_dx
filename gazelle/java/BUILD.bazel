load("@gazelle//:def.bzl", "gazelle_binary", "gazelle_generation_test")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_java//java:defs.bzl", "java_binary")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_test")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "java",
    srcs = [
        "doc.go",
        "lang.go",
        "naming.go",
        "parser.go",
        "stdlib.go",
    ],
    importpath = "github.com/devhusdk/rules_dx/gazelle/java",
    visibility = ["//gazelle/dispatch:__pkg__"],
    deps = [
        "//gazelle/common",
        "//gazelle/jvmsyntax",
        "@com_github_odvcencio_gotreesitter//:gotreesitter",
        "@com_github_odvcencio_gotreesitter//grammars/java",
        "@gazelle//config",
        "@gazelle//language",
        "@gazelle//repo",
        "@gazelle//resolve",
        "@gazelle//rule",
        "@gazelle//v2/label",
        "@gazelle//v2/rule",
    ],
)

gazelle_binary(
    name = "gazelle",
    languages = [":java"],
    tags = ["no-coverage"],
    version = 1,
    visibility = ["//dx:__pkg__"],
)

filegroup(
    name = "generation_testdata",
    srcs = glob(["testdata/**"]),
)

gazelle_generation_test(
    name = "generation_test",
    gazelle_binary = ":gazelle",
    pure = "on",
    tags = ["no-coverage"],
    test_data = [":generation_testdata"],
)

java_binary(
    name = "javac",
    testonly = True,
    main_class = "com.sun.tools.javac.Main",
    runtime_deps = [],
)

rust_test(
    name = "compile_test",
    srcs = ["//gazelle/jvmsyntax:compile_test.rs"],
    data = [
        "testdata/external_imports/WORKSPACE",
        ":gazelle",
        ":generation_testdata",
        ":javac",
        "@maven//:com_google_code_findbugs_jsr305",
    ],
    env = {
        "DX_CLASSPATH": "",
        "DX_COMPILER": "$(rootpath :javac)",
        "DX_DEPS": "@maven//:com_google_code_findbugs_jsr305=$(rootpath @maven//:com_google_code_findbugs_jsr305)",
        "DX_EXTENSION": "java",
        "DX_FIXTURE": "$(rootpath testdata/external_imports/WORKSPACE)",
        "DX_GAZELLE": "$(rootpath :gazelle)",
        "DX_LANGUAGE": "java",
    },
    tags = ["no-coverage"],
    deps = ["//tools/testing:dx_testing"],
)

go_test(
    name = "java_test",
    srcs = [
        "lang_test.go",
        "naming_test.go",
        "parser_test.go",
    ],
    embed = [":java"],
    pure = "on",
)

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["//quality:corpus_vale_config"],
    markdown_srcs = [
        "testdata/entries/README.md",
        "testdata/external_imports/README.md",
        "testdata/merge/README.md",
        "testdata/qualified_import/README.md",
        "testdata/source_only/README.md",
        "testdata/static_import/README.md",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
