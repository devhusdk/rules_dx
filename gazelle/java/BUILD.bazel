load("@gazelle//:def.bzl", "gazelle_generation_test")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "java",
    srcs = [
        "doc.go",
        "lang.go",
        "naming.go",
        "parser.go",
        "stdlib.go",
    ],
    importpath = "github.com/devhusdk/rules_dx/gazelle/java",
    visibility = ["//gazelle/dispatch:__pkg__"],
    deps = [
        "//gazelle/common",
        "@gazelle//language",
        "@gazelle//repo",
        "@gazelle//resolve",
        "@gazelle//rule",
        "@gazelle//v2/label",
        "@gazelle//v2/rule",
    ],
)

filegroup(
    name = "generation_testdata",
    srcs = glob(["testdata/**"]),
)

gazelle_generation_test(
    name = "generation_test",
    gazelle_binary = "//gazelle/dispatch:gazelle",
    pure = "on",
    tags = ["no-coverage"],
    test_data = [":generation_testdata"],
)

go_test(
    name = "java_test",
    srcs = [
        "lang_test.go",
        "naming_test.go",
        "parser_test.go",
    ],
    embed = [":java"],
    pure = "on",
    deps = ["@gazelle//config"],
)

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["//quality:corpus_vale_config"],
    markdown_srcs = [
        "testdata/entries/README.md",
        "testdata/merge/README.md",
        "testdata/qualified_import/README.md",
        "testdata/wildcard_import/README.md",
        "testdata/source_only/README.md",
        "testdata/static_import/README.md",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
