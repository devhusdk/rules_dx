load("@rules_dx//java/rules:defs.bzl", "java_library", "java_test")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

java_library(
    name = "demo",
    srcs = [
        "Helper.java",
        "Main.java",
    ],
)

java_test(
    name = "helper_test",
    srcs = ["HelperTest.java"],
    test_class = "demo.HelperTest",
    deps = [":demo"],
)
