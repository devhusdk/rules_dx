load("@rules_dx//java/rules:defs.bzl", "java_library", "java_test")

filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

java_library(
    name = "demo",
    srcs = [
        "Demo.java",
        "Helper.java",
        "extra/Kept.java",  # keep
    ],
    data = ["README.txt"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

java_test(
    name = "demo_test",
    size = "small",
    srcs = ["DemoTest.java"],
    test_class = "demo.DemoTest",
    deps = [":demo"],
)

# keep
filegroup(
    name = "retained",
    srcs = ["removed.txt"],
)
