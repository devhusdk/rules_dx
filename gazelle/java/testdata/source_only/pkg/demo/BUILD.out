load("@rules_dx//java/rules:defs.bzl", "java_library", "java_test")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

java_library(
    name = "demo",
    srcs = [
        "Demo.java",
        "Helper.java",
    ],
)

java_test(
    name = "demo_test",
    srcs = ["DemoTest.java"],
    test_class = "demo.DemoTest",
    deps = [":demo"],
)
