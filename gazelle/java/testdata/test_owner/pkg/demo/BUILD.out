load("@rules_dx//java/rules:defs.bzl", "java_library", "java_test")

# A handwritten suite owns both test sources, so none is generated.
java_test(
    name = "suite",
    srcs = [
        "ATest.java",
        "BTest.java",
    ],
    test_class = "demo.ATest",
)

java_library(
    name = "demo",
    srcs = ["Demo.java"],
)
