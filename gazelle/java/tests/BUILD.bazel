load("@rules_java//java:defs.bzl", "java_binary")
load("//rust:defs.bzl", "rust_test")

package(default_visibility = ["//visibility:private"])

java_binary(
    name = "javac",
    testonly = True,
    main_class = "com.sun.tools.javac.Main",
    runtime_deps = [],
)

rust_test(
    name = "compile_test",
    srcs = ["//tools/testing:gazelle_compile_test.rs"],
    data = [
        "//gazelle/java:testdata/compile_external/WORKSPACE",
        ":javac",
        "//gazelle/java:generation_testdata",
        "@dx_gazelle//:gazelle",
        "@maven//:com_google_code_findbugs_jsr305",
    ],
    env = {
        "DX_CLASSPATH": "",
        "DX_COMPILER": "$(rootpath :javac)",
        "DX_DEPS": " ".join([
            "@maven//:com_google_code_findbugs_jsr305=$(rootpath @maven//:com_google_code_findbugs_jsr305)",
        ]),
        "DX_EXTENSION": "java",
        "DX_FIXTURE": "$(rootpath //gazelle/java:testdata/compile_external/WORKSPACE)",
        "DX_GAZELLE": "$(rootpath @dx_gazelle//:gazelle)",
        "DX_LANGUAGE": "java",
        "DX_UNRESOLVED_HINT": "add a local library, a Maven lock artifact, or a # gazelle:resolve mapping on the qualified import or its package",
    },
    tags = ["no-coverage"],
    deps = ["//tools/testing:dx_testing"],
)
