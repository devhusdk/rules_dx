load("@rules_dx//javascript/rules:defs.bzl", "javascript_binary", "javascript_library", "javascript_test")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

# A hand-set nearest manifest must survive regeneration.
javascript_test(
    name = "widget_test",
    srcs = ["widget_test.js"],
    node_modules = "//:node_modules",
    package_json = "//pkg:package_json",
)

javascript_library(
    name = "helper",
    srcs = ["helper.js"],
)

javascript_test(
    name = "helper_test",
    srcs = ["helper_test.js"],
    data = [":helper"],
    node_modules = "//:node_modules",
    package_json = "//:package_json",
)

javascript_library(
    name = "main",
    srcs = ["main.js"],
    deps = [":helper"],
)

javascript_binary(
    name = "main_bin",
    data = [":main"],
    entry_point = "main.js",
)
