load("@rules_dx//javascript/rules:defs.bzl", "javascript_library", "javascript_test")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

javascript_library(
    name = "demo",
    srcs = ["demo.js"],
    deps = [":helper"],
)

javascript_test(
    name = "demo_test",
    srcs = ["demo.test.js"],
    data = [":demo"],
    node_modules = "//:node_modules",
)

javascript_library(
    name = "helper",
    srcs = ["helper.jsx"],
)

javascript_test(
    name = "helper_test",
    srcs = ["helper_test.mjs"],
    data = [":helper"],
    node_modules = "//:node_modules",
)
