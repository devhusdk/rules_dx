load("@rules_dx//javascript/rules:defs.bzl", "javascript_library")

javascript_library(
    name = "jest_config",
    srcs = ["jest.config.js"],
    deps = [
        ":setup",
        ":teardown",
    ],
)

javascript_library(
    name = "setup",
    srcs = ["setup.js"],
)

javascript_library(
    name = "teardown",
    srcs = ["teardown.js"],
)
