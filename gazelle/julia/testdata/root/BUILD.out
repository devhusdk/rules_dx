load("@rules_dx//julia:defs.bzl", "julia_library", "julia_test")

julia_library(
    name = "Demo",
    srcs = ["src/Demo.jl"],
    data = ["Project.toml"],
    visibility = ["//visibility:public"],
)

julia_test(
    name = "Demo_test",
    srcs = [
        "test/helpers.jl",
        "test/runtests.jl",
    ],
    main = "test/runtests.jl",
    deps = [":Demo"],
)
