load("@gazelle//:def.bzl", "gazelle_generation_test")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_java//java:defs.bzl", "java_binary", "java_import")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_test", "rustfmt_test")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "kotlin",
    srcs = [
        "doc.go",
        "lang.go",
        "parser.go",
        "stdlib.go",
    ],
    importpath = "github.com/devhusdk/rules_dx/gazelle/kotlin",
    visibility = ["//gazelle/dispatch:__pkg__"],
    deps = [
        "//gazelle/common",
        "//gazelle/common/treesitter",
        "@com_github_odvcencio_gotreesitter//:gotreesitter",
        "@com_github_odvcencio_gotreesitter//grammars/kotlin",
        "@gazelle//language",
    ],
)

filegroup(
    name = "generation_testdata",
    srcs = glob(["testdata/**"]),
)

gazelle_generation_test(
    name = "generation_test",
    gazelle_binary = "//gazelle/dispatch:gazelle",
    pure = "on",
    tags = ["no-coverage"],
    test_data = [":generation_testdata"],
)

java_import(
    name = "kotlinc_jars",
    testonly = True,
    jars = [
        "@com_github_jetbrains_kotlin//:annotations",
        "@com_github_jetbrains_kotlin//:kotlin-compiler",
        "@com_github_jetbrains_kotlin//:kotlin-daemon",
        "@com_github_jetbrains_kotlin//:kotlin-reflect",
        "@com_github_jetbrains_kotlin//:kotlin-script-runtime",
        "@com_github_jetbrains_kotlin//:kotlin-stdlib",
        "@com_github_jetbrains_kotlin//:kotlinx-coroutines-core-jvm",
    ],
)

java_binary(
    name = "kotlinc",
    testonly = True,
    main_class = "org.jetbrains.kotlin.cli.jvm.K2JVMCompiler",
    runtime_deps = [":kotlinc_jars"],
)

rust_test(
    name = "compile_test",
    srcs = ["//tools/testing:gazelle_compile_test.rs"],
    data = [
        "testdata/compile_external/WORKSPACE",
        ":generation_testdata",
        ":kotlinc",
        "//gazelle/dispatch:gazelle",
        "@com_github_jetbrains_kotlin//:annotations",
        "@com_github_jetbrains_kotlin//:kotlin-reflect",
        "@com_github_jetbrains_kotlin//:kotlin-stdlib",
        "@com_github_jetbrains_kotlin//:kotlinx-coroutines-core-jvm",
    ],
    env = {
        "DX_CLASSPATH": " ".join([
            "$(rootpath @com_github_jetbrains_kotlin//:annotations)",
            "$(rootpath @com_github_jetbrains_kotlin//:kotlin-stdlib)",
        ]),
        "DX_COMPILER": "$(rootpath :kotlinc)",
        "DX_DEPS": " ".join([
            "@com_github_jetbrains_kotlin//:kotlin-reflect=$(rootpath @com_github_jetbrains_kotlin//:kotlin-reflect)",
            "@com_github_jetbrains_kotlin//:kotlinx-coroutines-core-jvm=$(rootpath @com_github_jetbrains_kotlin//:kotlinx-coroutines-core-jvm)",
        ]),
        "DX_EXTENSION": "kt",
        "DX_FIXTURE": "$(rootpath testdata/compile_external/WORKSPACE)",
        "DX_GAZELLE": "$(rootpath //gazelle/dispatch:gazelle)",
        "DX_LANGUAGE": "kotlin",
        "DX_UNRESOLVED_HINT": "add a local library, a maven_install.json artifact, or a # gazelle:resolve mapping on the qualified import or its package",
    },
    tags = ["no-coverage"],
    deps = ["//tools/testing:dx_testing"],
)

go_test(
    name = "kotlin_test",
    srcs = [
        "lang_test.go",
        "parser_test.go",
    ],
    embed = [":kotlin"],
    pure = "on",
    deps = [
        "@gazelle//config",
        "@gazelle//resolve",
        "@gazelle//v2/label",
        "@gazelle//v2/rule",
    ],
)

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["//quality:corpus_vale_config"],
    markdown_srcs = [
        "testdata/compile_external/README.md",
        "testdata/entries/README.md",
        "testdata/merge/README.md",
        "testdata/source_only/README.md",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

rustfmt_test(
    name = "kotlin_fmt_test",
    size = "small",
    targets = [
        ":compile_test",
    ],
)
