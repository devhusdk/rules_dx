load("@gazelle//:def.bzl", "gazelle_binary", "gazelle_generation_test")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_java//java:defs.bzl", "java_binary", "java_import")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_test")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "kotlin",
    srcs = [
        "doc.go",
        "lang.go",
        "naming.go",
        "parser.go",
        "stdlib.go",
    ],
    importpath = "github.com/devhusdk/rules_dx/gazelle/kotlin",
    visibility = ["//gazelle/dispatch:__pkg__"],
    deps = [
        "//gazelle/common",
        "//gazelle/jvmsyntax",
        "@com_github_odvcencio_gotreesitter//:gotreesitter",
        "@com_github_odvcencio_gotreesitter//grammars/kotlin",
        "@gazelle//config",
        "@gazelle//language",
        "@gazelle//repo",
        "@gazelle//resolve",
        "@gazelle//rule",
        "@gazelle//v2/label",
        "@gazelle//v2/rule",
    ],
)

gazelle_binary(
    name = "gazelle",
    languages = [":kotlin"],
    tags = ["no-coverage"],
    version = 1,
    visibility = ["//dx:__pkg__"],
)

filegroup(
    name = "generation_testdata",
    srcs = glob(["testdata/**"]),
)

gazelle_generation_test(
    name = "generation_test",
    gazelle_binary = ":gazelle",
    pure = "on",
    tags = ["no-coverage"],
    test_data = [":generation_testdata"],
)

java_import(
    name = "kotlinc_jars",
    testonly = True,
    jars = [
        "@com_github_jetbrains_kotlin//:annotations",
        "@com_github_jetbrains_kotlin//:kotlin-compiler",
        "@com_github_jetbrains_kotlin//:kotlin-daemon",
        "@com_github_jetbrains_kotlin//:kotlin-reflect",
        "@com_github_jetbrains_kotlin//:kotlin-script-runtime",
        "@com_github_jetbrains_kotlin//:kotlin-stdlib",
        "@com_github_jetbrains_kotlin//:kotlinx-coroutines-core-jvm",
    ],
)

java_binary(
    name = "kotlinc",
    testonly = True,
    main_class = "org.jetbrains.kotlin.cli.jvm.K2JVMCompiler",
    runtime_deps = [":kotlinc_jars"],
)

rust_test(
    name = "compile_test",
    srcs = ["//gazelle/jvmsyntax:compile_test.rs"],
    data = [
        ":gazelle",
        ":generation_testdata",
        ":kotlinc",
        "testdata/external_imports/WORKSPACE",
        "@com_github_jetbrains_kotlin//:kotlin-stdlib",
        "@com_github_jetbrains_kotlin//:kotlinx-coroutines-core-jvm",
    ],
    env = {
        "DX_CLASSPATH": "$(rootpath @com_github_jetbrains_kotlin//:kotlin-stdlib)",
        "DX_COMPILER": "$(rootpath :kotlinc)",
        "DX_DEPS": "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core_jvm=$(rootpath @com_github_jetbrains_kotlin//:kotlinx-coroutines-core-jvm)",
        "DX_EXTENSION": "kt",
        "DX_FIXTURE": "$(rootpath testdata/external_imports/WORKSPACE)",
        "DX_GAZELLE": "$(rootpath :gazelle)",
        "DX_LANGUAGE": "kotlin",
    },
    tags = ["no-coverage"],
    deps = ["//tools/testing:dx_testing"],
)

go_test(
    name = "kotlin_test",
    srcs = [
        "lang_test.go",
        "naming_test.go",
        "parser_test.go",
    ],
    embed = [":kotlin"],
    pure = "on",
)

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["//quality:corpus_vale_config"],
    markdown_srcs = [
        "testdata/entries/README.md",
        "testdata/external_imports/README.md",
        "testdata/merge/README.md",
        "testdata/source_only/README.md",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
