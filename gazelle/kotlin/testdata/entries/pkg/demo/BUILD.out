load("@rules_dx//kotlin:defs.bzl", "kotlin_library", "kotlin_test")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

kotlin_library(
    name = "demo",
    srcs = [
        "Helper.kt",
        "Main.kt",
    ],
    visibility = ["//visibility:public"],
)

kotlin_test(
    name = "helper_test",
    srcs = ["HelperTest.kt"],
    test_class = "demo.HelperTest",
    deps = [":demo"],
)
