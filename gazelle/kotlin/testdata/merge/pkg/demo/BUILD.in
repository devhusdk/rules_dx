load("@rules_dx//kotlin/rules:defs.bzl", "kotlin_library", "kotlin_test")

filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

kotlin_library(
    name = "demo",
    srcs = [
        "Old.kt",
        "extra/Kept.kt",  # keep
    ],
    data = ["README.txt"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

kotlin_test(
    name = "demo_test",
    size = "small",
    srcs = ["DemoTest.kt"],
    test_class = "demo.Stale",
    deps = ["//stale:dep"],
)

kotlin_library(
    name = "gone",
    srcs = ["Gone.kt"],
)

# keep
filegroup(
    name = "retained",
    srcs = ["removed.txt"],
)
