load("@rules_dx//lua/rules:defs.bzl", "lua_binary", "lua_library", "lua_test")

lua_library(
    name = "app",
    srcs = ["hello.lua"],
)

lua_binary(
    name = "app_bin",
    srcs = ["main.lua"],
    main = "main.lua",
    deps = [":app"],
)

lua_test(
    name = "app_test",
    srcs = ["hello_test.lua"],
    main = "hello_test.lua",
    deps = [":app"],
)
