load("@rules_dx//javascript/rules:defs.bzl", "javascript_library")
load("@rules_dx//mdx/rules:defs.bzl", "mdx_library")
load("@rules_dx//typescript/rules:defs.bzl", "typescript_library")

javascript_library(
    name = "util",
    srcs = ["util.js"],
    visibility = ["//visibility:public"],
)

mdx_library(
    name = "main",
    srcs = ["main.mdx"],
    visibility = ["//visibility:public"],
    deps = [
        ":store",
        ":util",
        "//a:Button",
        "//b:Button",
    ],
)

typescript_library(
    name = "store",
    srcs = ["store.ts"],
    visibility = ["//visibility:public"],
)
