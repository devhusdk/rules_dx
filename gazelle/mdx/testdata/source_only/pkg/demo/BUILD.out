load("@rules_dx//mdx:defs.bzl", "mdx_library")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

mdx_library(
    name = "demo",
    srcs = ["demo.mdx"],
    visibility = ["//visibility:public"],
    deps = [":helper"],
)

mdx_library(
    name = "helper",
    srcs = ["helper.mdx"],
    visibility = ["//visibility:public"],
)
