load("@gazelle//:def.bzl", "gazelle_generation_test")
load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "ownership",
    srcs = [
        "doc.go",
        "lang.go",
    ],
    importpath = "github.com/devhusdk/rules_dx/gazelle/ownership",
    visibility = [
        "//gazelle/dispatch:__pkg__",
        "@dx_gazelle//:__pkg__",
    ],
    deps = [
        "//gazelle/common",
        "@gazelle//language",
        "@gazelle//v2/rule",
    ],
)

filegroup(
    name = "generation_testdata",
    srcs = glob(["testdata/**"]),
)

gazelle_generation_test(
    name = "generation_test",
    gazelle_binary = "@dx_gazelle//:gazelle",
    pure = "on",
    tags = ["no-coverage"],
    test_data = [":generation_testdata"],
)

go_test(
    name = "ownership_go_test",
    srcs = ["lang_test.go"],
    embed = [":ownership"],
    pure = "on",
)
