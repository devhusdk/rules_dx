load("@gazelle//:def.bzl", "gazelle_generation_test")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//perl/rules:defs.bzl", "perl_binary", "perl_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "perl",
    srcs = [
        "doc.go",
        "lang.go",
        "naming.go",
        "parser.go",
        "stdlib.go",
    ],
    embedsrcs = ["corelist.txt"],
    importpath = "github.com/devhusdk/rules_dx/gazelle/perl",
    visibility = ["//gazelle/dispatch:__pkg__"],
    deps = [
        "//gazelle/common",
        "//gazelle/common/treesitter",
        "@com_github_odvcencio_gotreesitter//:gotreesitter",
        "@com_github_odvcencio_gotreesitter//grammars/perl",
        "@gazelle//config",
        "@gazelle//language",
        "@gazelle//resolve",
        "@gazelle//v2/rule",
    ],
)

filegroup(
    name = "generation_testdata",
    srcs = glob(["testdata/**"]),
)

gazelle_generation_test(
    name = "generation_test",
    gazelle_binary = "//gazelle/dispatch:gazelle",
    pure = "on",
    tags = ["no-coverage"],
    test_data = [":generation_testdata"],
)

perl_binary(
    name = "corelist_dump",
    srcs = ["corelist_dump.pl"],
    main = "corelist_dump.pl",
)

perl_test(
    name = "corelist_test",
    srcs = ["corelist_dump.pl"],
    args = [
        "--check",
        "$(rootpath corelist.txt)",
    ],
    data = ["corelist.txt"],
    main = "corelist_dump.pl",
    target_compatible_with = ["@platforms//os:linux"],
)

go_test(
    name = "perl_go_test",
    srcs = [
        "lang_test.go",
        "naming_test.go",
        "parser_test.go",
    ],
    embed = [":perl"],
    pure = "on",
    deps = [
        "//gazelle/common",
        "@gazelle//config",
        "@gazelle//language",
        "@gazelle//resolve",
        "@gazelle//v2/label",
        "@gazelle//v2/rule",
    ],
)

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["//quality:corpus_vale_config"],
    markdown_srcs = glob(["testdata/*/README.md"]),
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
