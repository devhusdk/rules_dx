load("@gazelle//:def.bzl", "gazelle_generation_test")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//php:defs.bzl", "php_binary")
load("//rust:defs.bzl", "rust_test")
load("//tools/testing:child_runfiles.bzl", "child_runfiles")

go_library(
    name = "php",
    srcs = [
        "doc.go",
        "lang.go",
        "naming.go",
        "parser.go",
        "stdlib.go",
    ],
    embedsrcs = ["builtins.txt"],
    importpath = "github.com/devhusdk/rules_dx/gazelle/php",
    visibility = [
        "//gazelle/dispatch:__pkg__",
        "@dx_gazelle//:__pkg__",
    ],
    deps = [
        "//gazelle/common",
        "//gazelle/common/treesitter",
        "@com_github_odvcencio_gotreesitter//:gotreesitter",
        "@com_github_odvcencio_gotreesitter//grammars/php",
        "@gazelle//config",
        "@gazelle//language",
        "@gazelle//repo",
        "@gazelle//resolve",
        "@gazelle//v2/label",
        "@gazelle//v2/rule",
    ],
)

filegroup(
    name = "generation_testdata",
    srcs = glob(["testdata/**"]),
)

gazelle_generation_test(
    name = "generation_test",
    gazelle_binary = "@dx_gazelle//:gazelle",
    pure = "on",
    tags = ["no-coverage"],
    test_data = [":generation_testdata"],
)

go_test(
    name = "php_go_test",
    srcs = [
        "lang_test.go",
        "naming_test.go",
        "parser_test.go",
    ],
    embed = [":php"],
    pure = "on",
    deps = [
        "//gazelle/common",
        "@gazelle//config",
        "@gazelle//language",
        "@gazelle//resolve",
        "@gazelle//v2/label",
        "@gazelle//v2/rule",
    ],
)

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = glob(["testdata/*/README.md"]),
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

php_binary(
    name = "builtins_dump",
    srcs = ["builtins_dump.php"],
    main = "builtins_dump.php",
)

child_runfiles(
    name = "builtins_dump_child",
    testonly = True,
    binary = ":builtins_dump",
)

rust_test(
    name = "builtins_test",
    size = "small",
    srcs = ["builtins_test.rs"],
    data = [
        "builtins.txt",
        ":builtins_dump",
        ":builtins_dump_child",
    ],
    env = {
        "DX_PHP_BUILTINS_DUMP": "$(rootpath :builtins_dump)",
        "DX_PHP_BUILTINS_LIST": "$(rootpath builtins.txt)",
    },
    deps = ["//tools/testing:dx_testing"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
