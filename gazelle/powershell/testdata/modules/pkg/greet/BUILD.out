load("@rules_dx//powershell:defs.bzl", "powershell_binary", "powershell_library", "powershell_test")

# gazelle:dx_ignore_import powershell Pester

powershell_binary(
    name = "hello",
    srcs = ["Hello.ps1"],
    deps = [":greet"],
)

powershell_test(
    name = "greet_test",
    srcs = ["Greet.Tests.ps1"],
    data = ["Greet.Describe.ps1"],
    deps = [":greet"],
)

powershell_test(
    name = "pack_test",
    srcs = ["pack_test.ps1"],
    deps = [":greet"],
)

powershell_library(
    name = "greet",
    srcs = [
        "Greet.psd1",
        "Greet.psm1",
    ],
    visibility = ["//visibility:public"],
)
