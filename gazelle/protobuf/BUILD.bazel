load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@gazelle//:def.bzl", "gazelle_generation_test")
load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "protobuf",
    srcs = [
        "doc.go",
        "bindings.go",
        "lang.go",
        "naming.go",
        "parser.go",
    ],
    importpath = "github.com/devhusdk/rules_dx/gazelle/protobuf",
    visibility = [
        "//gazelle/dispatch:__pkg__",
        "@dx_gazelle//:__pkg__",
    ],
    deps = [
        "//gazelle/common",
        "@gazelle//config",
        "@gazelle//language",
        "@gazelle//repo",
        "@gazelle//resolve",
        "@gazelle//v2/label",
        "@gazelle//v2/rule",
    ],
)

filegroup(
    name = "generation_testdata",
    srcs = glob(["testdata/**"]),
)

gazelle_generation_test(
    name = "generation_test",
    gazelle_binary = "@dx_gazelle//:gazelle",
    pure = "on",
    tags = ["no-coverage"],
    test_data = [":generation_testdata"],
)

go_test(
    name = "protobuf_test",
    srcs = [
        "bindings_test.go",
        "naming_test.go",
        "parser_test.go",
    ],
    embed = [":protobuf"],
    pure = "on",
    deps = [
        "@gazelle//config",
        "@gazelle//v2/rule",
    ],
)

[
    diff_test(
        name = "roundtrip_%s_build_test" % pkg,
        file1 = "testdata/roundtrip/gazelle/protobuf/tests/roundtrip/%s/BUILD.out" % pkg,
        file2 = "//gazelle/protobuf/tests/roundtrip/%s:BUILD.bazel" % pkg,
    )
    for pkg in [
        "api",
        "java_app",
        "cc_app",
    ]
]

build_test(
    name = "roundtrip_build_test",
    targets = [
        "//gazelle/protobuf/tests/roundtrip/api:api_go_proto",
        "//gazelle/protobuf/tests/roundtrip/api:api_py_proto",
        "//gazelle/protobuf/tests/roundtrip/cc_app",
    ],
)
