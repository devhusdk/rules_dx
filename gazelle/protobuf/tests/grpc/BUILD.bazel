load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@rules_go//proto:def.bzl", "go_proto_library")
load("//go:defs.bzl", "go_binary")
load("//python:defs.bzl", "python_grpc_library", "python_test")
load(":package_tests.bzl", "proto_package_tests")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

proto_library(
    name = "greeter_proto",
    srcs = ["greeter.proto"],
    strip_import_prefix = "/",
)

go_proto_library(
    name = "greeter_go_proto",
    compilers = [
        "@rules_go//proto:go_proto",
        "@rules_go//proto:go_grpc_v2",
    ],
    importpath = "example.com/grpc_test",
    proto = ":greeter_proto",
)

py_proto_library(
    name = "greeter_py_proto",
    deps = [":greeter_proto"],
)

python_grpc_library(
    name = "greeter_py_grpc",
    dep_group = "grpc-tests",
    proto = ":greeter_proto",
    py_proto = ":greeter_py_proto",
    testonly = True,
)

go_binary(
    name = "server",
    srcs = ["server.go"],
    deps = [
        ":greeter_go_proto",
        "@org_golang_google_grpc//:grpc",
    ],
)

python_test(
    name = "client_test",
    srcs = ["client_test.py"],
    data = [":server"],
    dep_group = "grpc-tests",
    env = {"GREETER_SERVER": "$(rootpath :server)"},
    deps = [
        ":echo_py_grpc",
        ":echo_py_proto",
        ":greeter_py_grpc",
        ":greeter_py_proto",
        ":ping_py_grpc",
        ":ping_py_proto",
        "@pypi//coverage",
        "@pypi//grpcio",
        "@pypi//pytest",
    ],
)

proto_library(
    name = "echo_proto",
    srcs = ["v1/echo.proto"],
    strip_import_prefix = "/",
)

py_proto_library(
    name = "echo_py_proto",
    deps = [":echo_proto"],
)

python_grpc_library(
    name = "echo_py_grpc",
    dep_group = "grpc-tests",
    proto = ":echo_proto",
    py_proto = ":echo_py_proto",
    testonly = True,
)

proto_library(
    name = "ping_proto",
    srcs = ["stripped/ping.proto"],
    strip_import_prefix = "stripped",
)

py_proto_library(
    name = "ping_py_proto",
    deps = [":ping_proto"],
)

python_grpc_library(
    name = "ping_py_grpc",
    dep_group = "grpc-tests",
    proto = ":ping_proto",
    py_proto = ":ping_py_proto",
    testonly = True,
)

proto_package_tests(name = "other_package_tests")
