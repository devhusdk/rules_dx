load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@rules_go//proto:def.bzl", "go_proto_library")
load("//go/rules:defs.bzl", "go_binary")
load("//python/rules:defs.bzl", "python_test")
load("//python/rules:grpc.bzl", "py_grpc_library")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

proto_library(
    name = "greeter_proto",
    srcs = ["greeter.proto"],
    strip_import_prefix = "/",
)

go_proto_library(
    name = "greeter_go_proto",
    compilers = [
        "@rules_go//proto:go_proto",
        "@rules_go//proto:go_grpc_v2",
    ],
    importpath = "example.com/grpc_test",
    proto = ":greeter_proto",
)

py_proto_library(
    name = "greeter_py_proto",
    deps = [":greeter_proto"],
)

py_grpc_library(
    name = "greeter_py_grpc",
    dep_group = "grpc-tests",
    proto = ":greeter_proto",
    py_proto = ":greeter_py_proto",
    testonly = True,
)

go_binary(
    name = "server",
    srcs = ["server.go"],
    deps = [
        ":greeter_go_proto",
        "@org_golang_google_grpc//:grpc",
    ],
)

python_test(
    name = "client_test",
    srcs = ["client_test.py"],
    data = [":server"],
    dep_group = "grpc-tests",
    env = {"GREETER_SERVER": "$(rootpath :server)"},
    deps = [
        ":greeter_py_grpc",
        ":greeter_py_proto",
        "@pypi//coverage",
        "@pypi//grpcio",
        "@pypi//pytest",
    ],
)
