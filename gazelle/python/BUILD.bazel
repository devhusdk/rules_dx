load("@gazelle//:def.bzl", "gazelle_generation_test")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "python",
    srcs = [
        "doc.go",
        "lang.go",
        "naming.go",
        "parser.go",
        "ruff.go",
        "stdlib.go",
    ],
    importpath = "github.com/devhusdk/rules_dx/gazelle/python",
    visibility = [
        "//gazelle/dispatch:__pkg__",
        "@dx_gazelle//:__pkg__",
    ],
    deps = [
        "//gazelle/common",
        "//gazelle/common/treesitter",
        "@com_github_odvcencio_gotreesitter//:gotreesitter",
        "@com_github_odvcencio_gotreesitter//grammars/python",
        "@com_github_pelletier_go_toml_v2//:go-toml",
        "@gazelle//config",
        "@gazelle//language",
        "@gazelle//resolve",
        "@gazelle//v2/rule",
    ],
)

filegroup(
    name = "generation_testdata",
    srcs = glob(["testdata/**"]),
)

gazelle_generation_test(
    name = "generation_test",
    gazelle_binary = "@dx_gazelle//:gazelle",
    pure = "on",
    tags = ["no-coverage"],
    test_data = [":generation_testdata"],
)

go_test(
    name = "python_test",
    srcs = [
        "lang_test.go",
        "naming_test.go",
        "parser_test.go",
        "ruff_test.go",
    ],
    embed = [":python"],
    pure = "on",
    deps = [
        "//gazelle/common",
        "@gazelle//config",
        "@gazelle//language",
        "@gazelle//resolve",
        "@gazelle//v2/label",
        "@gazelle//v2/merger",
        "@gazelle//v2/rule",
    ],
)

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = [
        "testdata/entries/README.md",
        "testdata/proto_import/README.md",
        "testdata/pyproject_no_ruff/README.md",
        "testdata/pytest_plugins/README.md",
        "testdata/ruff_init_owned/README.md",
        "testdata/ruff_pyproject/README.md",
        "testdata/source_only/README.md",
        "testdata/src_layout/README.md",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
