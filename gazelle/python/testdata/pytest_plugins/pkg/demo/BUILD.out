    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [":database_fixtures"],
)

python_library(
    name = "database_fixtures",
    srcs = ["database_fixtures.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
)

python_library(
    name = "http_fixtures",
    srcs = ["http_fixtures.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
)

