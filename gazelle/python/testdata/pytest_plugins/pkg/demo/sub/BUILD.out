load("@rules_dx//python:defs.bzl", "python_library", "python_test")

python_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [":deep_fixtures"],
)

python_library(
    name = "deep_fixtures",
    srcs = ["deep_fixtures.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
)

python_test(
    name = "sub_test",
    srcs = ["sub_test.py"],
    imports = ["."],
    deps = [
        ":conftest",
        "//pkg/demo:conftest",
        "@pypi//pytest",
    ],
)
