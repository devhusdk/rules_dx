load("@rules_dx//python:defs.bzl", "python_library", "python_test")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

python_library(
    name = "demo",
    srcs = [
        "demo.py",
        "demo.pyi",
    ],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [":helper"],
)

python_library(
    name = "helper",
    srcs = ["helper.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
)

python_test(
    name = "helper_test",
    srcs = [
        "helper_test.py",
        "helper_test.pyi",
    ],
    imports = ["."],
    deps = [
        ":helper",
        "@pypi//pytest",
    ],
)
