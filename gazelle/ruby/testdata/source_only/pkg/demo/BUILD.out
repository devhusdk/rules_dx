load("@rules_dx//ruby/rules:defs.bzl", "ruby_library", "ruby_test")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

ruby_library(
    name = "demo",
    srcs = [
        "demo.rb",
        "helper.rb",
    ],
)

ruby_test(
    name = "demo_spec",
    srcs = ["demo_spec.rb"],
    deps = [":demo"],
)
