load("@crates//:crates.bzl", "aliases")
load("@gazelle//:def.bzl", "gazelle_generation_test")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "rust",
    srcs = [
        "cargo.go",
        "cargo_toml.go",
        "cargolock.go",
        "corpus.go",
        "doc.go",
        "lang.go",
        "lang_generate.go",
        "lang_resolve.go",
        "layout.go",
        "naming.go",
        "parser.go",
        "tsnode.go",
    ],
    importpath = "github.com/devhusdk/rules_dx/gazelle/rust",
    visibility = [
        "//gazelle/dispatch:__pkg__",
        "@dx_gazelle//:__pkg__",
    ],
    deps = [
        "//gazelle/common",
        "@com_github_bazelbuild_buildtools//build",
        "@com_github_odvcencio_gotreesitter//:gotreesitter",
        "@com_github_odvcencio_gotreesitter//grammars/rust",
        "@com_github_pelletier_go_toml_v2//:go-toml",
        "@gazelle//config",
        "@gazelle//language",
        "@gazelle//merger",
        "@gazelle//repo",
        "@gazelle//resolve",
        "@gazelle//rule",
        "@gazelle//v2/label",
        "@gazelle//v2/rule",
    ],
)

filegroup(
    name = "generation_testdata",
    srcs = glob(["testdata/**"]),
)

exports_files(
    [
        "testdata/consumer_root/BUILD.in",
        "testdata/consumer_root/BUILD.out",
        "testdata/consumer_root/src/lib.rs",
    ],
    visibility = ["//deploy/private/release:__pkg__"],
)

gazelle_generation_test(
    name = "generation_test",
    gazelle_binary = "@dx_gazelle//:gazelle",
    pure = "on",
    tags = ["no-coverage"],
    test_data = [":generation_testdata"],
)

rust_test(
    name = "harness_test",
    testonly = True,
    srcs = ["harness_test.rs"],
    aliases = aliases(
        package_name = "gazelle/gazelle_rust",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "harness_test",
    crate_root = "harness_test.rs",
    data = [
        "@dx_gazelle//:gazelle",
    ],
    env = {
        "DX_GAZELLE_BIN": "$(rootpath @dx_gazelle//:gazelle)",
    },
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing:dx_testing",
    ],
)

go_test(
    name = "rust_test",
    srcs = [
        "cargo_test.go",
        "lang_resolve_test.go",
        "lang_scopes_test.go",
        "lang_test.go",
        "layout_test.go",
        "naming_test.go",
        "parser_test.go",
    ],
    data = ["//core/modules:versions.bzl"],
    embed = [":rust"],
    pure = "on",
)

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = [
        "testdata/cargo/README.md",
        "testdata/cargo_workspace/README.md",
        "testdata/consumer_root/README.md",
        "testdata/corpus/README.md",
        "testdata/corpus/sub/notes.md",
        "testdata/merge/README.md",
        "testdata/merge/crates/stale_corpus/README.md",
        "testdata/source_only/README.md",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = [
        "Cargo.toml",
        "testdata/cargo/crates/app/Cargo.toml",
        "testdata/cargo/crates/cdylib/Cargo.toml",
        "testdata/cargo/crates/proc_macro/Cargo.toml",
        "testdata/cargo/crates/scripted/Cargo.toml",
        "testdata/cargo/crates/shapes/Cargo.toml",
        "testdata/cargo/crates/staticlib/Cargo.toml",
        "testdata/cargo/crates/suite/Cargo.toml",
        "testdata/cargo_hub/sub/Cargo.toml",
        "testdata/cargo_lib_name/Cargo.toml",
        "testdata/cargo_workspace/Cargo.toml",
        "testdata/cargo_workspace/crates/api/Cargo.toml",
        "testdata/cargo_workspace/crates/app/Cargo.toml",
        "testdata/corpus/config.toml",
        "testdata/merge/crates/cargo_trim/Cargo.toml",
    ],
)

