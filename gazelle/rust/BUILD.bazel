load("@gazelle//:def.bzl", "gazelle_binary", "gazelle_generation_test")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//tools/sh:harness.bzl", "dx_shell_harness")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "rust",
    srcs = [
        "cargo.go",
        "corpus.go",
        "doc.go",
        "lang.go",
        "lang_generate.go",
        "lang_resolve.go",
        "layout.go",
        "manifest.go",
        "naming.go",
        "native_config.go",
        "parser.go",
    ],
    importpath = "github.com/ralvik/rules_dx/gazelle/rust",
    visibility = ["//gazelle/dispatch:__pkg__"],
    deps = [
        "//gazelle/common",
        "@com_github_bazelbuild_buildtools//build",
        "@com_github_pmezard_go_difflib//difflib",
        "@gazelle//config",
        "@gazelle//language",
        "@gazelle//merger",
        "@gazelle//repo",
        "@gazelle//resolve",
        "@gazelle//rule",
        "@gazelle//v2/label",
        "@gazelle//v2/rule",
    ],
)

gazelle_binary(
    name = "gazelle",
    languages = [":rust"],
    tags = ["no-coverage"],
    version = 1,
    visibility = ["//dx:__pkg__"],
)

filegroup(
    name = "generation_testdata",
    srcs = glob(["testdata/**"]),
)

gazelle_generation_test(
    name = "generation_test",
    gazelle_binary = ":gazelle",
    pure = "on",
    tags = ["no-coverage"],
    test_data = [":generation_testdata"],
)

dx_shell_harness(
    name = "failure_test",
    srcs = ["failure_test.sh"],
    args = ["$(rootpath :gazelle)"],
    data = [
        ":gazelle",
    ],
)

dx_shell_harness(
    name = "idempotent_test",
    srcs = ["idempotent_test.sh"],
    args = ["$(rootpath :gazelle)"],
    data = [
        ":gazelle",
    ],
)

dx_shell_harness(
    name = "native_config_test",
    srcs = ["native_config_test.sh"],
    args = ["$(rootpath :gazelle)"],
    data = [
        ":gazelle",
    ],
)

go_test(
    name = "rust_test",
    srcs = [
        "cargo_test.go",
        "lang_resolve_test.go",
        "lang_scopes_test.go",
        "lang_test.go",
        "layout_test.go",
        "manifest_test.go",
        "naming_test.go",
        "native_config_test.go",
        "parser_test.go",
    ],
    embed = [":rust"],
    pure = "on",
)

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["//quality:corpus_vale_config"],
    markdown_srcs = [
        "testdata/cargo/README.md",
        "testdata/merge/README.md",
        "testdata/native_config/README.md",
        "testdata/source_only/README.md",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = [
        "testdata/cargo/crates/app/Cargo.toml",
        "testdata/cargo/crates/cdylib/Cargo.toml",
        "testdata/cargo/crates/proc_macro/Cargo.toml",
        "testdata/cargo/crates/scripted/Cargo.toml",
        "testdata/cargo/crates/shapes/Cargo.toml",
        "testdata/cargo/crates/staticlib/Cargo.toml",
        "testdata/merge/crates/cargo_trim/Cargo.toml",
        "testdata/native_config/crates/config_only/taplo.toml",
        "testdata/native_config/crates/full/rustfmt.toml",
        "testdata/native_config/crates/merge/custom.toml",
        "testdata/native_config/crates/merge/rustfmt.toml",
        "testdata/native_config/crates/skip/rustfmt.toml",
        "testdata/native_config/crates/skip/taplo.toml",
    ],
)
