load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//rust/rules:defs.bzl", "rust_binary", "rust_library", "rust_test")

rust_library(
    name = "cargo_core",
    srcs = ["source/core.rs"],
    aliases = aliases(
        package_name = "crates/cargo-app",
        normal = True,
    ),
    crate_name = "cargo_core",
    crate_root = "source/core.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        package_name = "crates/cargo-app",
        normal = True,
    ),
)

rust_test(
    name = "cargo_core_test",
    aliases = aliases(
        package_name = "crates/cargo-app",
        normal = True,
        normal_dev = True,
    ),
    crate = ":cargo_core",
    deps = all_crate_deps(
        package_name = "crates/cargo-app",
        normal = True,
        normal_dev = True,
    ),
)

rust_binary(
    name = "cargo_tool",
    srcs = ["source/main.rs"],
    aliases = aliases(
        package_name = "crates/cargo-app",
        normal = True,
    ),
    crate_name = "cargo_tool",
    crate_root = "source/main.rs",
    edition = "2024",
    deps = all_crate_deps(
        package_name = "crates/cargo-app",
        normal = True,
    ) + [":cargo_core"],
)

rust_test(
    name = "acceptance",
    srcs = ["spec/acceptance.rs"],
    aliases = aliases(
        package_name = "crates/cargo-app",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "acceptance",
    crate_root = "spec/acceptance.rs",
    edition = "2024",
    use_libtest_harness = False,
    deps = all_crate_deps(
        package_name = "crates/cargo-app",
        normal = True,
        normal_dev = True,
    ) + [":cargo_core"],
)
