load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//rust/rules:defs.bzl", "rust_shared_library", "rust_test")

rust_shared_library(
    name = "flavors_cdylib",
    srcs = ["source/cdylib.rs"],
    aliases = aliases(
        package_name = "crates/flavors-cdylib",
        normal = True,
    ),
    crate_name = "flavors_cdylib",
    crate_root = "source/cdylib.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        package_name = "crates/flavors-cdylib",
        normal = True,
    ),
)

rust_test(
    name = "flavors_cdylib_test",
    aliases = aliases(
        package_name = "crates/flavors-cdylib",
        normal = True,
        normal_dev = True,
    ),
    crate = ":flavors_cdylib",
    deps = all_crate_deps(
        package_name = "crates/flavors-cdylib",
        normal = True,
        normal_dev = True,
    ),
)
