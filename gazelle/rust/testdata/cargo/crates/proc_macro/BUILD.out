load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//rust/rules:defs.bzl", "rust_proc_macro", "rust_test")

rust_proc_macro(
    name = "flavors_derive",
    srcs = ["source/derive.rs"],
    aliases = aliases(
        package_name = "crates/flavors-derive",
        normal = True,
    ),
    crate_name = "flavors_derive",
    crate_root = "source/derive.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        package_name = "crates/flavors-derive",
        normal = True,
    ),
)

rust_test(
    name = "flavors_derive_test",
    aliases = aliases(
        package_name = "crates/flavors-derive",
        normal = True,
        normal_dev = True,
    ),
    crate = ":flavors_derive",
    deps = all_crate_deps(
        package_name = "crates/flavors-derive",
        normal = True,
        normal_dev = True,
    ),
)
