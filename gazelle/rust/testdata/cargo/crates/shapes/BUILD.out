load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//rust/rules:defs.bzl", "rust_binary", "rust_library", "rust_test")

rust_library(
    name = "shapes_lib",
    srcs = ["source/lib.rs"],
    aliases = aliases(
        package_name = "crates/shapes",
        normal = True,
    ),
    crate_name = "shapes_lib",
    crate_root = "source/lib.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        package_name = "crates/shapes",
        normal = True,
    ),
)

rust_test(
    name = "shapes_lib_test",
    aliases = aliases(
        package_name = "crates/shapes",
        normal = True,
        normal_dev = True,
    ),
    crate = ":shapes_lib",
    deps = all_crate_deps(
        package_name = "crates/shapes",
        normal = True,
        normal_dev = True,
    ),
)

rust_binary(
    name = "demo_example",
    srcs = ["examples/demo.rs"],
    aliases = aliases(
        package_name = "crates/shapes",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "demo",
    crate_root = "examples/demo.rs",
    edition = "2021",
    deps = all_crate_deps(
        package_name = "crates/shapes",
        normal = True,
        normal_dev = True,
    ) + [":shapes_lib"],
)

rust_test(
    name = "demo_example_test",
    aliases = aliases(
        package_name = "crates/shapes",
        normal = True,
        normal_dev = True,
    ),
    crate = ":demo_example",
    deps = all_crate_deps(
        package_name = "crates/shapes",
        normal = True,
        normal_dev = True,
    ),
)

rust_binary(
    name = "plain_example",
    srcs = ["examples/plain.rs"],
    aliases = aliases(
        package_name = "crates/shapes",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "plain",
    crate_root = "examples/plain.rs",
    edition = "2021",
    deps = all_crate_deps(
        package_name = "crates/shapes",
        normal = True,
        normal_dev = True,
    ) + [":shapes_lib"],
)

rust_binary(
    name = "criterion_bench",
    srcs = ["benches/criterion.rs"],
    aliases = aliases(
        package_name = "crates/shapes",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "criterion",
    crate_root = "benches/criterion.rs",
    edition = "2021",
    deps = all_crate_deps(
        package_name = "crates/shapes",
        normal = True,
        normal_dev = True,
    ) + [":shapes_lib"],
)
