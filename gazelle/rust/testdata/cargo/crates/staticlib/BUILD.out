load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//rust/rules:defs.bzl", "rust_static_library", "rust_test")

rust_static_library(
    name = "flavors_staticlib",
    srcs = ["source/staticlib.rs"],
    aliases = aliases(
        package_name = "crates/flavors-staticlib",
        normal = True,
    ),
    crate_name = "flavors_staticlib",
    crate_root = "source/staticlib.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        package_name = "crates/flavors-staticlib",
        normal = True,
    ),
)

rust_test(
    name = "flavors_staticlib_test",
    aliases = aliases(
        package_name = "crates/flavors-staticlib",
        normal = True,
        normal_dev = True,
    ),
    crate = ":flavors_staticlib",
    deps = all_crate_deps(
        package_name = "crates/flavors-staticlib",
        normal = True,
        normal_dev = True,
    ),
)
