load("@dx_quality_crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//rust:defs.bzl", "rust_binary")

rust_binary(
    name = "hub_tool",
    srcs = ["main.rs"],
    aliases = aliases(
        package_name = "hub_tool",
        normal = True,
    ),
    crate_name = "hub_tool",
    crate_root = "main.rs",
    edition = "2021",
    deps = all_crate_deps(
        package_name = "hub_tool",
        normal = True,
    ),
)
