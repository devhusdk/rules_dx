load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//rust/rules:defs.bzl", "rust_library")

rust_library(
    name = "app",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "crates/app",
        normal = True,
    ) | {"//crates/api": "apiv"},
    crate_name = "app",
    crate_root = "src/lib.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        package_name = "crates/app",
        normal = True,
    ) + ["//crates/api"],
)
