load("@rules_dx//rust:defs.bzl", "rust_binary", "rust_test")

rust_binary(
    name = "old_bin",
    srcs = ["old_main.rs"],
    crate_name = "old_bin",
    crate_root = "old_main.rs",
)

rust_test(
    name = "old_bin_test",
    crate = ":old_bin",
)

filegroup(
    name = "assets",
    srcs = ["asset.txt"],
)
