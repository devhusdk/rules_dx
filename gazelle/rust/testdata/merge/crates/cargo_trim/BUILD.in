load("@rules_dx//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "trim",
    srcs = ["old.rs"],
    crate_name = "old",
    crate_root = "old.rs",
)

rust_test(
    name = "removed_test",
    srcs = ["tests/removed.rs"],
    crate_name = "removed",
    crate_root = "tests/removed.rs",
)
