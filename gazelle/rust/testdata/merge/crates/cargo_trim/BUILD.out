load("@crates//:crates.bzl", "aliases")
load("@rules_dx//rust/rules:defs.bzl", "rust_library")

rust_library(
    name = "trim",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "crates/trim",
        normal = True,
    ),
    crate_name = "trim",
    crate_root = "src/lib.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [],
)
