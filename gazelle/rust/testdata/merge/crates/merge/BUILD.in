load("@rules_dx//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "merge",
    srcs = [
        "old.rs",
        "extra/kept.rs",  # keep
    ],
    crate_name = "legacy",  # keep
    crate_root = "old.rs",
    data = ["asset.txt"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "gone",
    srcs = ["gone.rs"],
    crate_name = "gone",
    crate_root = "gone.rs",
)

rust_test(
    name = "gone_test",
    crate = ":gone",
)

# keep
rust_library(
    name = "retained",
    srcs = ["removed.rs"],
)
