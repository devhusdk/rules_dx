load("@rules_dx//quality:native_config.bzl", "rustfmt_config", "vale_config")
load("@rules_dx//rust/rules:defs.bzl", "rust_library")

# Fresh package: sources plus tool configs generate together.

rust_library(
    name = "full",
    srcs = ["src/lib.rs"],
    aspect_hints = [":rustfmt_config"],
    crate_name = "full",
    crate_root = "src/lib.rs",
    visibility = ["//visibility:public"],
)

vale_config(
    name = "vale_config",
    src = ".vale.ini",
    data = ["styles/org/Example.yml"],
    visibility = ["//crates/full:__subpackages__"],
)

rustfmt_config(
    name = "rustfmt_config",
    src = "rustfmt.toml",
    visibility = ["//crates/full:__subpackages__"],
)
