load("@rules_dx//quality:native_config.bzl", "rustfmt_config")
load("@rules_dx//rust/rules:defs.bzl", "rust_library")

rustfmt_config(
    name = "rustfmt_cfg",
    src = "custom.toml",
)

rust_library(
    name = "merge",
    srcs = ["src/lib.rs"],
    aspect_hints = [
        ":hand_cfg",
        ":rustfmt_cfg",
    ],
    crate_name = "merge",
    crate_root = "src/lib.rs",
    visibility = ["//visibility:public"],
)
