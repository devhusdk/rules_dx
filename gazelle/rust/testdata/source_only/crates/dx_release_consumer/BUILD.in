load("@rules_dx//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "dx_release_consumer",
    srcs = ["src/lib.rs"],
    crate_name = "dx_release_consumer",
    crate_root = "src/lib.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
)

rust_test(
    name = "dx_release_consumer_test",
    crate = ":dx_release_consumer",
)
