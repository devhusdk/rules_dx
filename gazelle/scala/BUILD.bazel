load("@gazelle//:def.bzl", "gazelle_generation_test")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_java//java:defs.bzl", "java_binary")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_test")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "scala",
    srcs = [
        "doc.go",
        "lang.go",
        "parser.go",
        "stdlib.go",
    ],
    importpath = "github.com/devhusdk/rules_dx/gazelle/scala",
    visibility = ["//gazelle/dispatch:__pkg__"],
    deps = [
        "//gazelle/common",
        "@gazelle//language",
    ],
)

filegroup(
    name = "generation_testdata",
    srcs = glob(["testdata/**"]),
)

gazelle_generation_test(
    name = "generation_test",
    gazelle_binary = "//gazelle/dispatch:gazelle",
    pure = "on",
    tags = ["no-coverage"],
    test_data = [":generation_testdata"],
)

java_binary(
    name = "scalac",
    testonly = True,
    main_class = "scala.tools.nsc.Main",
    runtime_deps = ["@rules_scala//scala/private/toolchain_deps:scala_compile_classpath"],
)

rust_test(
    name = "compile_test",
    srcs = ["//tools/testing:gazelle_compile_test.rs"],
    data = [
        "testdata/compile_external/WORKSPACE",
        ":generation_testdata",
        ":scalac",
        "//gazelle/dispatch:gazelle",
        "@maven//:org_scala_lang_modules_scala_xml_2_13",
        "@maven//:org_scalactic_scalactic_2_13",
    ],
    env = {
        "DX_CLASSPATH": "",
        "DX_COMPILER": "$(rootpath :scalac)",
        "DX_DEPS": " ".join([
            "@maven//:org_scala_lang_modules_scala_xml_2_13=$(rootpath @maven//:org_scala_lang_modules_scala_xml_2_13)",
            "@maven//:org_scalactic_scalactic_2_13=$(rootpath @maven//:org_scalactic_scalactic_2_13)",
        ]),
        "DX_EXTENSION": "scala",
        "DX_FIXTURE": "$(rootpath testdata/compile_external/WORKSPACE)",
        "DX_GAZELLE": "$(rootpath //gazelle/dispatch:gazelle)",
        "DX_LANGUAGE": "scala",
        "DX_UNRESOLVED_HINT": "add a local library or a # gazelle:resolve mapping on the qualified import or its package",
    },
    tags = ["no-coverage"],
    deps = ["//tools/testing:dx_testing"],
)

go_test(
    name = "scala_test",
    srcs = [
        "lang_test.go",
        "parser_test.go",
    ],
    embed = [":scala"],
    pure = "on",
    deps = [
        "@gazelle//config",
        "@gazelle//resolve",
        "@gazelle//v2/label",
        "@gazelle//v2/rule",
    ],
)

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["//quality:corpus_vale_config"],
    markdown_srcs = [
        "testdata/compile_external/README.md",
        "testdata/entries/README.md",
        "testdata/merge/README.md",
        "testdata/scala_forms/README.md",
        "testdata/selector_imports/README.md",
        "testdata/source_only/README.md",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
