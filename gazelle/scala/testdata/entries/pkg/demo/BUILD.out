load("@rules_dx//scala/rules:defs.bzl", "scala_library", "scala_test")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

scala_library(
    name = "demo",
    srcs = [
        "Helper.scala",
        "Main.scala",
    ],
)

scala_test(
    name = "helper_test",
    srcs = ["HelperTest.scala"],
    deps = [":demo"],
)
