load("@rules_dx//scala/rules:defs.bzl", "scala_library", "scala_test")

filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

scala_library(
    name = "demo",
    srcs = [
        "Demo.scala",
        "Helper.scala",
        "extra/Kept.scala",  # keep
    ],
    data = ["README.txt"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# keep
filegroup(
    name = "retained",
    srcs = ["removed.txt"],
)

scala_test(
    name = "demo_test",
    srcs = ["DemoTest.scala"],
    deps = [":demo"],
)
