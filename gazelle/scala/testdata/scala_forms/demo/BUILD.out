load("@rules_dx//scala/rules:defs.bzl", "scala_library", "scala_test")

scala_library(
    name = "demo",
    srcs = [
        "Block.scala",
        "Chained.scala",
    ],
    deps = ["//widget"],
)

scala_test(
    name = "foo_spec",
    srcs = ["FooSpec.scala"],
    deps = [":demo"],
)

scala_test(
    name = "foo_suite",
    srcs = ["FooSuite.scala"],
    deps = [":demo"],
)
