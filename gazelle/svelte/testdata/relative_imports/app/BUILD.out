load("@rules_dx//javascript/rules:defs.bzl", "javascript_library")
load("@rules_dx//svelte/rules:defs.bzl", "svelte_library")
load("@rules_dx//typescript/rules:defs.bzl", "typescript_project")

javascript_library(
    name = "util",
    srcs = ["util.js"],
)

svelte_library(
    name = "main",
    srcs = ["main.svelte"],
    deps = [
        ":store",
        ":util",
        "//a:Button",
        "//b:Button",
    ],
)

typescript_project(
    name = "store",
    srcs = ["store.ts"],
)
