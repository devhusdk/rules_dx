load("@rules_dx//svelte:defs.bzl", "svelte_library")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

svelte_library(
    name = "demo",
    srcs = ["demo.svelte"],
    visibility = ["//visibility:public"],
    deps = [":helper"],
)

svelte_library(
    name = "helper",
    srcs = ["helper.svelte"],
    visibility = ["//visibility:public"],
)
