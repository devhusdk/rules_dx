load("@gazelle//:def.bzl", "gazelle_generation_test")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "swift",
    srcs = [
        "doc.go",
        "lang.go",
        "naming.go",
        "parser.go",
        "stdlib.go",
    ],
    importpath = "github.com/devhusdk/rules_dx/gazelle/swift",
    visibility = [
        "//gazelle/dispatch:__pkg__",
        "@dx_gazelle//:__pkg__",
    ],
    deps = [
        "//gazelle/common",
        "@gazelle//config",
        "@gazelle//language",
        "@gazelle//resolve",
        "@gazelle//v2/rule",
    ],
)

filegroup(
    name = "generation_testdata",
    srcs = glob(["testdata/**"]),
)

gazelle_generation_test(
    name = "generation_test",
    gazelle_binary = "@dx_gazelle//:gazelle",
    pure = "on",
    tags = ["no-coverage"],
    test_data = [":generation_testdata"],
)

go_test(
    name = "swift_go_test",
    srcs = [
        "lang_test.go",
        "parser_test.go",
    ],
    embed = [":swift"],
    pure = "on",
    deps = [
        "@gazelle//resolve",
        "@gazelle//v2/rule",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
