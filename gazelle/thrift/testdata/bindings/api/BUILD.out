load("@rules_dx//thrift:defs.bzl", "thrift_cc_library", "thrift_java_library", "thrift_library", "thrift_rust_library")

thrift_library(
    name = "api",
    srcs = ["point.thrift"],
    visibility = ["//visibility:public"],
)

thrift_cc_library(
    name = "api_cc",
    visibility = ["//visibility:public"],
    deps = [":api"],
)

thrift_java_library(
    name = "api_java",
    visibility = ["//visibility:public"],
    deps = [":api"],
)

thrift_rust_library(
    name = "api_rust",
    library = ":api",
    visibility = ["//visibility:public"],
)
