load("@rules_dx//thrift:defs.bzl", "thrift_cc_library", "thrift_java_library", "thrift_library", "thrift_rust_library")

thrift_library(
    name = "multi",
    srcs = [
        "path.thrift",
        "point.thrift",
    ],
    visibility = ["//visibility:public"],
)

thrift_cc_library(
    name = "multi_cc",
    visibility = ["//visibility:public"],
    deps = [":multi"],
)

thrift_java_library(
    name = "multi_java",
    visibility = ["//visibility:public"],
    deps = [":multi"],
)

thrift_rust_library(
    name = "multi_rust",
    library = ":multi",
    visibility = ["//visibility:public"],
)
