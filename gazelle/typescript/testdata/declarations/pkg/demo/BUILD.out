load("@rules_dx//typescript:defs.bzl", "typescript_library")

typescript_library(
    name = "widget",
    declaration = True,
    declaration_srcs = ["widget.d.ts"],
    tsconfig = "//:tsconfig",
    visibility = ["//visibility:public"],
)

typescript_library(
    name = "consumer",
    srcs = ["consumer.ts"],
    declaration = True,
    declaration_srcs = ["shared.d.ts"],
    tsconfig = "//:tsconfig",
    visibility = ["//visibility:public"],
)

typescript_library(
    name = "user",
    srcs = ["user.ts"],
    declaration = True,
    tsconfig = "//:tsconfig",
    visibility = ["//visibility:public"],
    deps = [":consumer"],
)
