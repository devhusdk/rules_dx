load("@rules_dx//typescript:defs.bzl", "typescript_binary", "typescript_library", "typescript_test")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

# A hand-set nearest manifest must survive regeneration.
typescript_test(
    name = "widget_test",
    srcs = ["widget_test.ts"],
    declaration = True,
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
    package_json = "//pkg:package_json",
    tsconfig = "//:tsconfig",
)

typescript_library(
    name = "helper",
    srcs = ["helper.ts"],
    declaration = True,
    tsconfig = "//:tsconfig",
    visibility = ["//visibility:public"],
)

typescript_test(
    name = "helper_test",
    srcs = ["helper_test.ts"],
    declaration = True,
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
    package_json = "//:package_json",
    tsconfig = "//:tsconfig",
    deps = [":helper"],
)

typescript_binary(
    name = "main_bin",
    srcs = ["main.ts"],
    main = "main.ts",
    tsconfig = "//:tsconfig",
    deps = [":helper"],
)
