load("@rules_dx//javascript/rules:defs.bzl", "javascript_binary")
load("@rules_dx//typescript/rules:defs.bzl", "typescript_project", "typescript_test")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

# A hand-set nearest manifest must survive regeneration.
typescript_test(
    name = "widget_test",
    srcs = ["widget_test.ts"],
    declaration = True,
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
    package_json = "//pkg:package_json",
    tsconfig = "//:tsconfig",
)

typescript_project(
    name = "helper",
    srcs = ["helper.ts"],
    declaration = True,
    tsconfig = "//:tsconfig",
    visibility = ["//visibility:public"],
)

typescript_test(
    name = "helper_test",
    srcs = ["helper_test.ts"],
    declaration = True,
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
    package_json = "//:package_json",
    tsconfig = "//:tsconfig",
    deps = [":helper"],
)

typescript_project(
    name = "main",
    srcs = ["main.ts"],
    declaration = True,
    tsconfig = "//:tsconfig",
    visibility = ["//visibility:public"],
    deps = [":helper"],
)

javascript_binary(
    name = "main_bin",
    data = [":main"],
    main = "main.js",
)
