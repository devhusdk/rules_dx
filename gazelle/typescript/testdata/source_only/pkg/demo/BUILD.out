load("@rules_dx//typescript/rules:defs.bzl", "typescript_project", "typescript_test")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

typescript_project(
    name = "demo",
    srcs = ["demo.ts"],
    deps = [
        ":helper",
        ":widget",
    ],
)

typescript_project(
    name = "helper",
    srcs = ["helper.tsx"],
)

typescript_test(
    name = "helper_test",
    srcs = ["helper_test.mts"],
    node_modules = "//:node_modules",
    deps = [":helper"],
)

typescript_project(
    name = "orphan",
    declaration_srcs = ["orphan.d.mts"],
)

typescript_project(
    name = "widget",
    declaration_srcs = ["widget.d.ts"],
)
