load("@rules_dx//typescript/rules:defs.bzl", "typescript_project")

# gazelle:dx_ignore_import typescript @testing-library/jest-dom

typescript_project(
    name = "global_setup",
    srcs = ["global_setup.ts"],
    visibility = ["//visibility:public"],
)

typescript_project(
    name = "setup",
    srcs = ["setup.ts"],
    visibility = ["//visibility:public"],
)

typescript_project(
    name = "vitest_config",
    srcs = ["vitest.config.ts"],
    visibility = ["//visibility:public"],
    deps = [
        ":global_setup",
        ":setup",
    ],
)
