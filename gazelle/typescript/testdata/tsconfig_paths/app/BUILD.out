load("@rules_dx//javascript/rules:defs.bzl", "javascript_binary")
load("@rules_dx//typescript/rules:defs.bzl", "typescript_project")

typescript_project(
    name = "main",
    srcs = ["main.ts"],
    deps = ["//lib:util"],
)

javascript_binary(
    name = "main_bin",
    data = [":main"],
    entry_point = "main.js",
)
