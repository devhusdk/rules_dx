load("@rules_dx//vue:defs.bzl", "vue_library")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

vue_library(
    name = "demo",
    srcs = ["demo.vue"],
    visibility = ["//visibility:public"],
    deps = [":helper"],
)

vue_library(
    name = "helper",
    srcs = ["helper.vue"],
    visibility = ["//visibility:public"],
)
