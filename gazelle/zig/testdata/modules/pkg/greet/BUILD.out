load("@rules_dx//zig:defs.bzl", "zig_library", "zig_test")

zig_library(
    name = "greet",
    srcs = ["util.zig"],
    extra_srcs = [
        "data.zon",
        "greeting.txt",
    ],
    main = "greet.zig",
    visibility = ["//visibility:public"],
)

zig_test(
    name = "greet_test",
    main = "greet_test.zig",
    deps = [":greet"],
)
