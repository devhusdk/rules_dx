load("@rules_dx//zig/rules:defs.bzl", "zig_library", "zig_test")

zig_library(
    name = "greet",
    srcs = ["util.zig"],
    extra_srcs = [
        "data.zon",
        "greeting.txt",
    ],
    main = "greet.zig",
)

zig_test(
    name = "greet_test",
    main = "greet_test.zig",
    deps = [":greet"],
)
