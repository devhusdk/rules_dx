# gazelle:ignore
load("@rules_proto//proto:defs.bzl", "proto_library")
load("@rules_rust_prost//:defs.bzl", "rust_prost_library")
load("//quality:fixtures.bzl", "real_source_target")
load(":codegen.bzl", "codegen_plan_subject", "dx_codegen_shard", "prost_codegen_shard")
load(":codegen_tests.bzl", "codegen_defs_unit_tests", "codegen_plan_analysis_tests", "codegen_shard_argv_test")

package(default_visibility = ["//visibility:public"])

exports_files(["result.proto"])

proto_library(
    name = "result_proto",
    srcs = ["result.proto"],
)

rust_prost_library(
    name = "result_proto_rs",
    proto = ":result_proto",
)

proto_library(
    name = "codegen_proto",
    srcs = ["codegen.proto"],
)

rust_prost_library(
    name = "codegen_proto_rs",
    proto = ":codegen_proto",
)

codegen_defs_unit_tests(name = "codegen_defs_unit")

dx_codegen_shard(
    name = "codegen_shard_alpha",
    testonly = True,
    entries = ["gen/alpha.rs|gen|alpha"],
    language = "rust",
    visibility = ["//visibility:private"],
)

dx_codegen_shard(
    name = "codegen_shard_beta",
    testonly = True,
    entries = ["gen/beta.rs|gen|beta"],
    language = "rust",
    visibility = ["//visibility:private"],
    deps = [":codegen_shard_alpha"],
)

prost_codegen_shard(
    name = "codegen_prost_fixture",
    testonly = True,
    entries = ["gen/prost_result.rs|gen|result|result_proto.lib.rs"],
    language = "rust",
    proto_rs = ":result_proto_rs",
    visibility = ["//visibility:private"],
)

codegen_plan_subject(
    name = "codegen_plan_chain_subject",
    testonly = True,
    target = ":codegen_shard_beta",
    visibility = ["//visibility:private"],
)

codegen_plan_subject(
    name = "codegen_plan_prost_subject",
    testonly = True,
    target = ":codegen_prost_fixture",
    visibility = ["//visibility:private"],
)

codegen_plan_analysis_tests(name = "codegen_plan_analysis")

codegen_shard_argv_test(
    name = "codegen_shard_alpha_argv_test",
    expected = [
        "--producer",
        "//generation:codegen_shard_alpha",
        "--language",
        "rust",
        "--entry",
        "gen/alpha.rs|gen|alpha",
        "--output",
    ],
    output = "generation/codegen_shard_alpha.dxcodegen.pb",
    target_under_test = ":codegen_shard_alpha",
)

codegen_shard_argv_test(
    name = "codegen_prost_fixture_argv_test",
    expected = [
        "--producer",
        "//generation:codegen_prost_fixture",
        "--language",
        "rust",
        "--entry",
        "gen/prost_result.rs|gen|result|result_proto.lib.rs",
        "--output",
    ],
    output = "generation/codegen_prost_fixture.dxcodegen.pb",
    target_under_test = ":codegen_prost_fixture",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "codegen.bzl",
        "codegen_tests.bzl",
    ],
    tags = ["corpus"],
)
