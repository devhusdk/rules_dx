load("@crates//:crates.bzl", "aliases", "all_crate_deps", "crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI_GENERATION")

# gazelle:resolve rust proto //generation:codegen_proto_rs
# gazelle:resolve rust codegen_proto //generation:codegen_proto_rs
# gazelle:resolve rust codegen_shard //generation/codegen_shard:codegen_shard

package(default_visibility = VIS_CLI_GENERATION)

rust_library(
    name = "codegen_shard",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "generation/codegen_shard",
        normal = True,
    ),
    crate_name = "codegen_shard",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = all_crate_deps(
        package_name = "generation/codegen_shard",
        normal = True,
    ) + [
        "//cli/path:dx_path",
        "//cli/proto_validate:dx_proto_validate",
        "//generation:codegen_proto_rs",
        "@rules_rust_prost//private/3rdparty/crates:prost",
    ],
)

rust_binary(
    name = "codegen_shard_writer",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "generation/codegen_shard",
        normal = True,
    ),
    crate_name = "codegen_shard_writer",
    crate_root = "src/main.rs",
    edition = "2021",
    deps = all_crate_deps(
        package_name = "generation/codegen_shard",
        normal = True,
    ) + [
        ":codegen_shard",
        "//cli/shard_writer:dx_shard_writer",
    ],
)

rust_test(
    name = "codegen_shard_test",
    size = "small",
    aliases = aliases(
        package_name = "generation/codegen_shard",
        normal = True,
        normal_dev = True,
    ),
    crate = ":codegen_shard",
    deps = all_crate_deps(
        package_name = "generation/codegen_shard",
        normal = True,
        normal_dev = True,
    ) + [
        "//generation:codegen_proto_rs",
        "@rules_rust_prost//private/3rdparty/crates:prost",
    ],
)

rustfmt_test(
    name = "codegen_shard_fmt_test",
    size = "small",
    targets = [
        ":codegen_shard",
        ":codegen_shard_writer",
        ":codegen_shard_writer_bin_test",
    ],
)

rust_clippy_test(
    name = "codegen_shard_clippy_test",
    size = "small",
    targets = [
        ":codegen_shard",
        ":codegen_shard_writer",
    ],
)

# keep
rust_test(
    name = "codegen_shard_writer_bin_test",
    size = "small",
    aliases = aliases(
        package_name = "generation/codegen_shard",
        normal = True,
        normal_dev = True,
    ),
    crate = ":codegen_shard_writer",
    deps = crate_deps(
        ["tempfile"],
        package_name = "generation/codegen_shard",
    ) + [
        ":codegen_shard",
        "//cli/shard_writer:dx_shard_writer",
        "//generation:codegen_proto_rs",
    ],
)

exports_files([
    "Cargo.toml",
    "src/lib.rs",
    "src/main.rs",
])

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
