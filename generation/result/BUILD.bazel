load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

# gazelle:resolve rust proto //generation/proto:result_proto_rs
# gazelle:resolve rust result_proto //generation/proto:result_proto_rs

package(default_visibility = VIS_CLI)

rust_library(
    name = "generation_result",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "generation/generation_result",
        normal = True,
    ),
    crate_name = "generation_result",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "generation/generation_result",
        normal = True,
    ) + [
        "//cli/digest:dx_digest",
        "//cli/path:dx_path",
        "//generation/proto:result_proto_rs",
        "@rules_rust_prost//private/3rdparty/crates:prost",
    ],
)

rust_test(
    name = "generation_result_test",
    aliases = aliases(
        package_name = "generation/generation_result",
        normal = True,
        normal_dev = True,
    ),
    crate = ":generation_result",
    deps = all_crate_deps(
        package_name = "generation/generation_result",
        normal = True,
        normal_dev = True,
    ) + ["//generation/proto:result_proto_rs"],
)

exports_files([
    "Cargo.toml",
    "src/lib.rs",
])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
