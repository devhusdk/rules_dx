load("@rules_nodejs//nodejs:repositories.bzl", "DEFAULT_NODE_VERSION")
load("//erlang/toolchain:pins.bzl", "OTP_RELEASE")
load("//gleam/rules:defs.bzl", "GLEAM_COMPATIBLE_WITH", "gleam_erl_library", "gleam_js_library", "gleam_js_test", "gleam_library", "gleam_test")
load("//quality:fixtures.bzl", "real_source_target")

exports_files(
    ["src/dx_runtime_probe.gleam"],
    visibility = ["//quality/tests:__pkg__"],
)

genrule(
    name = "pins",
    outs = ["src/dx_pins.gleam"],
    cmd = "printf 'pub const otp_release = \"%s\"\\npub const node_version = \"%s\"\\n' '{}' '{}' > $@".format(OTP_RELEASE, DEFAULT_NODE_VERSION),
)

gleam_erl_library(
    name = "ffi",
    target_compatible_with = GLEAM_COMPATIBLE_WITH,
)

gleam_library(
    name = "dx_runtime_probe",
    srcs = [
        "src/dx_runtime_probe.gleam",
        ":pins",
    ],
    target_compatible_with = GLEAM_COMPATIBLE_WITH,
    visibility = ["//quality/testdata:__pkg__"],
    deps = [":ffi"],
)

gleam_js_library(
    name = "dx_runtime_probe_js",
    srcs = [
        "src/dx_runtime_probe.gleam",
        "src/dx_runtime_probe_ffi.mjs",
        ":pins",
    ],
    target_compatible_with = GLEAM_COMPATIBLE_WITH,
)

gleam_test(
    name = "erlang_probe_test",
    size = "small",
    data = ["data.txt"],
    srcs = ["test/erlang_probe_test.gleam"],
    target_compatible_with = GLEAM_COMPATIBLE_WITH,
    deps = [
        ":dx_runtime_probe",
        "//gleam/lib:gleam_stdlib",
    ],
)

gleam_js_test(
    name = "javascript_probe_test",
    size = "small",
    data = ["data.txt"],
    srcs = ["test/javascript_probe_test.gleam"],
    target_compatible_with = GLEAM_COMPATIBLE_WITH,
    deps = [
        ":dx_runtime_probe_js",
        "//gleam/lib:gleam_stdlib_js",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
