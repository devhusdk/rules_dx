load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")
load("//tools/testing:nested_bazel.bzl", "NESTED_BAZEL_TAGS")

rust_test(
    name = "starter_test",
    size = "enormous",
    srcs = ["starter_test.rs"],
    data = [
        "starter_test.rs",
        "//cli/cli:dx",
    ],
    env = {
        "DX_BIN": "$(rootpath //cli/cli:dx)",
        "RUST_TEST_THREADS": "1",
    },
    env_inherit = [
        "HOME",
        "PATH",
    ],
    tags = NESTED_BAZEL_TAGS + ["requires-network"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = ["//tools/testing:dx_testing"],
)

rustfmt_test(
    name = "starter_fmt_test",
    size = "small",
    targets = [":starter_test"],
)

rust_clippy_test(
    name = "starter_clippy_test",
    size = "small",
    targets = [":starter_test"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
