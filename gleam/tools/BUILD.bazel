load("//gleam/rules:defs.bzl", "GLEAM_COMPATIBLE_WITH")
load("//quality:fixtures.bzl", "real_source_target")
load(":gleam_tool.bzl", "gleam_tool")

package(default_visibility = ["//visibility:public"])

exports_files(["gleam_tool.bzl"])

gleam_tool(
    name = "gleam",
    runtimes = True,
    target_compatible_with = GLEAM_COMPATIBLE_WITH,
)

gleam_tool(
    name = "gleam_format",
    command = ["format"],
    target_compatible_with = GLEAM_COMPATIBLE_WITH,
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "gleam_tool.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
