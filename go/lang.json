{
  "$schema": "../modules/lang.schema.json",
  "name": "go",
  "title": "Go",
  "family": "core",
  "ecosystems": [
    "go"
  ],
  "depcheck": "go",
  "semver": true,
  "manifests": [
    "go.mod"
  ],
  "lockfiles": [
    "go.sum"
  ],
  "tools": [
    "errcheck",
    "gofumpt",
    "gotype",
    "govet",
    "staticcheck"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_arm64",
    "windows_x86_64"
  ],
  "pins": [],
  "entry_points": [
    "go_library",
    "go_binary",
    "go_test",
    "go_fuzz_test",
    "go_bench"
  ],
  "quality": {
    "bzl": "quality:families/go.bzl",
    "file_extensions": [
      ".go"
    ],
    "aspects": {
      "format": [
        "real_go_format_aspect"
      ],
      "lint": [
        "real_go_lint_aspect"
      ],
      "typecheck": [
        "real_go_typecheck_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_go_format_probe_aspect"
      ],
      "lint": [
        "real_go_lint_probe_aspect"
      ],
      "typecheck": [
        "real_go_typecheck_probe_aspect"
      ]
    }
  }
}
