load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@rules_go//go:def.bzl", "go_cross_binary")
load("//go:defs.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "dx_go_lib",
    srcs = ["main.go"],
    importpath = "rules_dx/go/private/tools/analysis/dx_go",
    visibility = ["//visibility:private"],
    deps = [
        "//go/private/tools/analysis/errcheck",
        "//go/private/tools/analysis/gotype",
        "//go/private/tools/analysis/govet",
        "//go/private/tools/analysis/staticcheck",
        "//go/private/tools/modfmt",
    ],
)

go_binary(
    name = "dx_go",
    embed = [":dx_go_lib"],
    visibility = ["//:__subpackages__"],
)

# Release assets, one per host; .github/workflows/release-tools.yml builds them.
[
    go_cross_binary(
        name = "dx_go_" + host,
        platform = "@rules_go//go/toolchain:" + go_platform,
        tags = ["manual"],
        target = ":dx_go",
        visibility = ["//visibility:private"],
    )
    for host, go_platform in {
        "linux_arm64": "linux_arm64",
        "linux_x86_64": "linux_amd64",
        "macos_arm64": "darwin_arm64",
        "windows_arm64": "windows_arm64",
        "windows_x86_64": "windows_amd64",
    }.items()
]

go_test(
    name = "dx_go_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":dx_go_lib"],
    deps = ["//go/private/tools/analysis/unit"],
)

# dx_go picks the tool from the name it runs as.
[
    native_binary(
        name = tool,
        src = ":dx_go",
        out = select({
            "@platforms//os:windows": tool + ".exe",
            "//conditions:default": tool,
        }),
        visibility = [
            "//:__subpackages__",
            "@dx_prebuilt//:__pkg__",
        ],
    )
    for tool in [
        "dx_errcheck",
        "dx_gotype",
        "dx_govet",
        "dx_modfmt",
        "dx_staticcheck",
    ]
]
