# gazelle:ignore

load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("//core:conformance.bzl", "dx_wrapper_contract_tests")
load("//core/modules:versions.bzl", "GO_SDK_VERSION")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//tools/ide:ide_acquisition.bzl", "ide_acquisition_test")
load(":cgo_tests.bzl", "cgo_toolchain_tests")

dx_wrapper_contract_tests(
    name = "wrapper_contract_tests",
    file_classes = [
        "go",
        "c",
        "cpp",
    ],
)

cgo_toolchain_tests(name = "cgo_toolchain_test")

[
    diff_test(
        name = "gopls_%s_current_test" % tier,
        size = "small",
        failure_message = "gopls_%s.json is stale: run bazel build //go/private/quality/gopls_tier:gen_%s and copy bazel-bin/go/private/quality/gopls_tier/gen_%s.json over it" % (tier, tier, tier),
        file1 = "//core/quality/tiers/gopls:gopls_%s.json" % tier,
        file2 = "//go/private/quality/gopls_tier:gen_%s" % tier,
    )
    for tier in ["standard", "strict"]
]

ide_acquisition_test(
    name = "ide_acquisition_test",
    size = "small",
    binary = "//go/private/ide:go_tool",
    expected = "go" + GO_SDK_VERSION,
    version_args = ["version"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "cgo_tests.bzl",
    ],
    tags = ["corpus"],
)

test_suite(
    name = "fixture_tests",
    testonly = True,
    tests = [
        "//go/tests/fixtures/cgo:cgo_race_test",
        "//go/tests/fixtures/cgo:cgo_sources_test",
        "//go/tests/fixtures/cgo:cgo_test",
        "//go/tests/fixtures/cgo:cxx_test",
        "//go/tests/fixtures/godeps:godeps_test",
        "//go/tests/fixtures/hello:hello_test",
        "//go/tests/fixtures/hello:hello_thin_output_test",
        "//go/tests/fixtures/no_srcs:lib_test",
        "//go/tests/fixtures/no_srcs:lib_test_sources_test",
        "//go/tests/fixtures/testonly_binary:testonly_binary_build_test",
    ],
)
