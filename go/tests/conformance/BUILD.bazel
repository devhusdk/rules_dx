# gazelle:ignore
load("//go:defs.bzl", "go_binary", "go_library", "go_test")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "subject_compatible_with")
# gazelle:exclude main.go
# gazelle:exclude runfiles_main.go
# gazelle:exclude lock_main.go

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

go_library(
    name = "conformance",
    srcs = ["greet.go"],
    importpath = "rules_dx/go/tests/conformance",
)

go_binary(
    name = "hello",
    srcs = ["main.go"],
    importpath = "rules_dx/go/tests/conformance/main",
    deps = [":conformance"],
)

go_binary(
    name = "lock_hello",
    srcs = ["lock_main.go"],
    importpath = "rules_dx/go/tests/conformance/lock_main",
    deps = ["@com_github_google_go_cmp//cmp"],
)

go_test(
    name = "pass_subject_test",
    srcs = ["pass_test.go"],
    embed = [":conformance"],
    size = "small",
    target_compatible_with = subject_compatible_with(),
)

go_test(
    name = "fail_subject_test",
    srcs = ["fail_test.go"],
    embed = [":conformance"],
    size = "small",
    target_compatible_with = subject_compatible_with(),
)

go_binary(
    name = "runfiles_hello",
    srcs = ["runfiles_main.go"],
    data = ["data.txt"],
    importpath = "rules_dx/go/tests/conformance/runfiles_main",
    deps = ["@rules_go//go/runfiles"],
)

dx_conformance_suite(
    name = "",
    binary = ":hello",
    covered_source = "greet.go",
    expected = "hello world",
    failing_case = "TestFailingCase",
    failing_test = ":fail_subject_test",
    lang = "go",
    lock = {
        "binary": ":lock_hello",
        "ecosystem": "go",
        "expected": "hello lock",
        "lockfile": "//third_party/go:go.sum",
        "manifest": "//third_party/go:go.mod",
        "package": "github.com/google/go-cmp",
        "stale": "go.stale.sum",
    },
    passing_test = ":pass_subject_test",
    runfiles = {
        "binary": ":runfiles_hello",
        "data": "data.txt",
        "expected": "hello runfiles",
    },
    size = "small",
)
