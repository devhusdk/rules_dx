load("//go:defs.bzl", "go_binary", "go_library", "go_test")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "subject_compatible_with")
# gazelle:exclude main.go

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

go_library(
    name = "conformance",
    srcs = ["greet.go"],
    importpath = "rules_dx/go/tests/conformance",
)

go_binary(
    name = "hello",
    srcs = ["main.go"],
    importpath = "rules_dx/go/tests/conformance/main",
    deps = [":conformance"],
)

go_test(
    name = "pass_subject_test",
    srcs = ["pass_test.go"],
    embed = [":conformance"],
    size = "small",
    target_compatible_with = subject_compatible_with(),
)

go_test(
    name = "fail_subject_test",
    srcs = ["fail_test.go"],
    embed = [":conformance"],
    size = "small",
    target_compatible_with = subject_compatible_with(),
)

dx_conformance_suite(
    name = "",
    binary = ":hello",
    covered_source = "greet.go",
    expected = "hello world",
    failing_case = "TestFailingCase",
    failing_test = ":fail_subject_test",
    lang = "go",
    passing_test = ":pass_subject_test",
    size = "small",
)
