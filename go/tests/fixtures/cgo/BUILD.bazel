load("@rules_cc//cc:defs.bzl", "cc_library")
load("//cc/private/toolchains:select.bzl", "cc_toolchain_test")
load("//go:defs.bzl", "go_library", "go_test")
load("//core/tests:direct_sources.bzl", "dx_direct_sources_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load(":toolchain_test.bzl", "cgo_toolchain_tests")
load(":unsupported_tests.bzl", "cgo_unsupported_toolchain_tests")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

go_library(
    name = "cgo",
    srcs = [
        "add.c",
        "add.h",
        "cgo.go",
    ],
    cgo = True,
    importpath = "rules_dx/go/tests/fixtures/cgo",
)

dx_direct_sources_test(
    name = "cgo_sources_test",
    expected = {
        "c": [
            "add.c",
            "add.h",
        ],
        "go": ["cgo.go"],
    },
    target_under_test = ":cgo",
)

go_test(
    name = "cgo_test",
    srcs = ["cgo_test.go"],
    embed = [":cgo"],
    pure = "off",
    target_compatible_with = ["@platforms//os:linux"],
)

go_test(
    name = "cgo_race_test",
    srcs = ["cgo_test.go"],
    embed = [":cgo"],
    pure = "off",
    race = "on",
    target_compatible_with = ["@platforms//os:linux"],
)

cc_library(
    name = "cxx_adder",
    srcs = ["adder.cc"],
    hdrs = ["adder.h"],
    copts = ["-std=c++17"],
)

go_library(
    name = "cxx",
    srcs = [
        "adder.h",
        "cxx.go",
    ],
    cdeps = [":cxx_adder"],
    cgo = True,
    clinkopts = ["-Wl,-z,now"],
    copts = ["-DDX_CGO_COPT=1"],
    importpath = "rules_dx/go/tests/fixtures/cgo/cxx",
)

go_test(
    name = "cxx_test",
    srcs = ["cxx_test.go"],
    embed = [":cxx"],
    pure = "off",
    target_compatible_with = ["@platforms//os:linux"],
)

cgo_toolchain_tests(
    name = "toolchain_test",
    target_under_test = ":cxx_test",
)

cgo_unsupported_toolchain_tests(
    name = "unsupported_toolchain_test",
    target_under_test = ":cgo",
)

cc_toolchain_test(
    name = "gcc_cgo_test",
    compiler = "gcc",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    test = ":cgo_test",
)

cc_toolchain_test(
    name = "gcc_cxx_test",
    compiler = "gcc",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    test = ":cxx_test",
)

cc_toolchain_test(
    name = "gcc_cgo_race_test",
    compiler = "gcc",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    test = ":cgo_race_test",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
    ],
    tags = ["corpus"],
)
