load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//cc/private/toolchain:select.bzl", "cc_toolchain_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//core/tests:direct_sources.bzl", "dx_direct_sources_test")
load("//go:defs.bzl", "go_library", "go_test")
load(":toolchain_test.bzl", "cgo_toolchain_tests")
load(":unsupported_tests.bzl", "cgo_unsupported_toolchain_tests")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

_UNIX = select({
    "@platforms//os:linux": [],
    "@platforms//os:macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

_CGO_SUBJECT = selects.with_or({
    (
        "@platforms//os:linux",
        "@platforms//os:macos",
        ":unsupported_probe_on",
    ): [],
    "//conditions:default": ["@platforms//:incompatible"],
})

bool_flag(
    name = "unsupported_probe",
    build_setting_default = False,
)

config_setting(
    name = "unsupported_probe_on",
    flag_values = {":unsupported_probe": "true"},
)

platform(
    name = "windows_x86_64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

go_library(
    name = "cgo",
    srcs = [
        "add.c",
        "add.h",
        "cgo.go",
    ],
    cgo = True,
    importpath = "rules_dx/go/tests/fixtures/cgo",
    target_compatible_with = _CGO_SUBJECT,
)

dx_direct_sources_test(
    name = "cgo_sources_test",
    expected = {
        "c": [
            "add.c",
            "add.h",
        ],
        "go": ["cgo.go"],
    },
    target_under_test = ":cgo",
)

go_test(
    name = "cgo_test",
    srcs = ["cgo_test.go"],
    embed = [":cgo"],
    pure = "off",
    target_compatible_with = _UNIX,
)

go_test(
    name = "cgo_race_test",
    srcs = ["cgo_test.go"],
    embed = [":cgo"],
    pure = "off",
    race = "on",
    target_compatible_with = _UNIX,
)

cc_library(
    name = "cxx_adder",
    srcs = ["adder.cc"],
    hdrs = ["adder.h"],
    copts = ["-std=c++17"],
)

go_library(
    name = "cxx",
    srcs = [
        "adder.h",
        "cxx.go",
    ],
    cdeps = [":cxx_adder"],
    cgo = True,
    clinkopts = select({
        "@platforms//os:linux": ["-Wl,-z,now"],
        "//conditions:default": [],
    }),
    copts = ["-DDX_CGO_COPT=1"],
    importpath = "rules_dx/go/tests/fixtures/cgo/cxx",
    target_compatible_with = _CGO_SUBJECT,
)

go_test(
    name = "cxx_test",
    srcs = ["cxx_test.go"],
    embed = [":cxx"],
    pure = "off",
    target_compatible_with = _UNIX,
)

cgo_toolchain_tests(
    name = "toolchain_test",
    target_under_test = ":cxx_test",
)

cgo_unsupported_toolchain_tests(
    name = "unsupported_toolchain_test",
    target_under_test = ":cgo",
)

cc_toolchain_test(
    name = "gcc_cgo_test",
    size = "small",
    compiler = "gcc",
    target_compatible_with = ["@platforms//os:linux"],
    test = ":cgo_test",
)

cc_toolchain_test(
    name = "gcc_cxx_test",
    size = "small",
    compiler = "gcc",
    target_compatible_with = ["@platforms//os:linux"],
    test = ":cxx_test",
)

cc_toolchain_test(
    name = "gcc_cgo_race_test",
    size = "small",
    compiler = "gcc",
    target_compatible_with = ["@platforms//os:linux"],
    test = ":cgo_race_test",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
    ],
    tags = ["corpus"],
)
