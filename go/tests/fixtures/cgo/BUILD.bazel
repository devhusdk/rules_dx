load("//go/rules:defs.bzl", "go_library", "go_test")
load("//quality:fixtures.bzl", "real_source_target")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

go_library(
    name = "cgo",
    srcs = ["cgo.go"],
    cgo = True,
    importpath = "rules_dx/go/tests/fixtures/cgo",
)

go_test(
    name = "cgo_test",
    srcs = ["cgo_test.go"],
    embed = [":cgo"],
    pure = "off",
    race = "on",
    target_compatible_with = ["@platforms//os:linux"],
)

exports_files(["pins.bzl"])

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "pins.bzl",
    ],
    tags = ["corpus"],
)
