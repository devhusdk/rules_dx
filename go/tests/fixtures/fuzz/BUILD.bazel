load("//core:fuzz_bench_tests.bzl", "dx_runner_attr_test")
load("//go:defs.bzl", "go_fuzz_test", "go_library")
load("//tools/coverage:sh_test.bzl", "sh_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

go_library(
    name = "parse",
    srcs = ["parse.go"],
    importpath = "rules_dx/go/tests/fixtures/fuzz",
)

go_fuzz_test(
    name = "parse_fuzz",
    srcs = ["parse_test.go"],
    embed = [":parse"],
    target = "FuzzParse",
)

sh_test(
    name = "parse_fuzz_run_test",
    env = {"DX_RUNTIME_TOOL": "fuzz_run"},
    srcs = ["//core/tests/fixtures/fuzz:run_test.sh"],
    args = [
        "$(rlocationpath //cli/runtime:dx_runtime)",
        "go",
        "$(rootpath :parse_fuzz)",
        "FuzzParse",
    ],
    data = [
        ":parse_fuzz",
        "//cli/runtime:dx_runtime",
    ],
    timeout = "short",
)

dx_runner_attr_test(
    name = "parse_fuzz_run_attrs",
    expected = {"args": ["go", "$(rootpath :parse_fuzz)", "FuzzParse"]},
    runner = "parse_fuzz_run",
)
