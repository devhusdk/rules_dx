load("//go/rules:defs.bzl", "go_binary", "go_library", "go_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//tools/testing:hello_output.bzl", "dx_hello_output_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

go_library(
    name = "hello_lib",
    srcs = ["hello.go"],
    importpath = "rules_dx/go/tests/fixtures/hello",
)

go_binary(
    name = "hello",
    srcs = ["main.go"],
    importpath = "rules_dx/go/tests/fixtures/hello/main",
    deps = [":hello_lib"],
)

go_library(
    name = "hello_main_lib",
    srcs = ["main.go"],
    importpath = "rules_dx/go/tests/fixtures/hello/main",
    deps = [":hello_lib"],
)

go_binary(
    name = "hello_thin",
    embed = [":hello_main_lib"],
)

go_test(
    name = "hello_test",
    srcs = ["hello_test.go"],
    embed = [":hello_lib"],
)

dx_hello_output_test(
    name = "hello_output_test",
    binary = ":hello",
    expected = "hello world",
)

dx_hello_output_test(
    name = "hello_thin_output_test",
    binary = ":hello_thin",
    expected = "hello world",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
