load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//core/quality:native_config.bzl", "staticcheck_config")
load("//go:defs.bzl", "go_library")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

exports_files([
    "Sample.go",
    "check_findings.json",
])

filegroup(
    name = "sample_source",
    testonly = True,
    srcs = ["Sample.go"],
)

go_library(
    name = "clean",
    srcs = ["clean.go"],
    importpath = "rules_dx/go/tests/fixtures/staticcheck/clean",
    tags = ["manual"],
)

go_library(
    name = "dirty",
    srcs = ["Sample.go"],
    importpath = "rules_dx/go/tests/fixtures/staticcheck/dirty",
    tags = ["manual"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
    ],
    tags = ["corpus"],
)

copy_file(
    name = "standard_conf",
    src = "//core/quality/tiers/staticcheck:standard.conf",
    out = "standard/staticcheck.conf",
)

copy_file(
    name = "strict_conf",
    src = "//core/quality/tiers/staticcheck:strict.conf",
    out = "strict/staticcheck.conf",
)

staticcheck_config(
    name = "standard_config",
    src = ":standard_conf",
    allow_generated = True,
)

staticcheck_config(
    name = "strict_config",
    src = ":strict_conf",
    allow_generated = True,
)

go_library(
    name = "initialisms_standard",
    srcs = ["initialisms.go"],
    aspect_hints = [":standard_config"],
    importpath = "rules_dx/go/tests/fixtures/staticcheck/initialisms",
    tags = ["manual"],
)

go_library(
    name = "initialisms_strict",
    srcs = ["initialisms.go"],
    aspect_hints = [":strict_config"],
    importpath = "rules_dx/go/tests/fixtures/staticcheck/initialisms",
    tags = ["manual"],
)

staticcheck_config(
    name = "opt_in_config",
    src = "opt_in/staticcheck.conf",
)

go_library(
    name = "initialisms_opt_in",
    srcs = ["initialisms.go"],
    aspect_hints = [":opt_in_config"],
    importpath = "rules_dx/go/tests/fixtures/staticcheck/initialisms",
    tags = ["manual"],
)

staticcheck_config(
    name = "initialisms_config",
    src = "initialisms/staticcheck.conf",
)

go_library(
    name = "initialisms_custom",
    srcs = ["initialisms.go"],
    aspect_hints = [":initialisms_config"],
    importpath = "rules_dx/go/tests/fixtures/staticcheck/initialisms",
    tags = ["manual"],
)

go_library(
    name = "unused_value",
    srcs = ["unused_value.go"],
    importpath = "rules_dx/go/tests/fixtures/staticcheck/unusedvalue",
    tags = ["manual"],
)
