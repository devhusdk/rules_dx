load("//go/rules:defs.bzl", "go_library")
load("//quality:fixtures.bzl", "real_source_target")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

exports_files([
    "Sample.go",
    "check_findings.json",
])

filegroup(
    name = "sample_source",
    testonly = True,
    srcs = ["Sample.go"],
)

go_library(
    name = "clean",
    srcs = ["clean.go"],
    importpath = "rules_dx/go/tests/fixtures/staticcheck/clean",
    tags = ["manual"],
)

go_library(
    name = "dirty",
    srcs = ["Sample.go"],
    importpath = "rules_dx/go/tests/fixtures/staticcheck/dirty",
    tags = ["manual"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
    ],
    tags = ["corpus"],
)
