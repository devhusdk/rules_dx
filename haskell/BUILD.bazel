load("//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

exports_files([
    "README.md",
    "defs.bzl",
    "extensions.bzl",
    "lang.json",
    "pins.json",
])

# Public so users can register their own GHC toolchain.
toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "extension_srcs",
    srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "extensions.bzl",
        "pins.json",
        "//haskell/private:module_srcs",
        "//haskell/private/toolchain:module_srcs",
    ],
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "module_srcs",
    srcs = [
        ":extension_srcs",
        "//:module_srcs",
    ],
    visibility = ["//:__subpackages__"],
)

alias(
    name = "base",
    actual = "@dx_haskell_toolchains//lib:base",
)

[
    alias(
        name = name,
        actual = "@dx_haskell_toolchains//lib:" + name,
    )
    for name in [
        "array",
        "binary",
        "bytestring",
        "cabal",
        "containers",
        "deepseq",
        "directory",
        "exceptions",
        "filepath",
        "ghc-bignum",
        "ghc-internal",
        "ghc-prim",
        "ghc_exe",
        "ghc_files",
        "licenses",
        "mtl",
        "parsec",
        "pretty",
        "process",
        "stm",
        "template-haskell",
        "text",
        "time",
        "transformers",
        "unix",
        "Win32",
    ]
]

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "extensions.bzl",
    ],
    tags = ["corpus"],
    visibility = ["//:__subpackages__"],
)

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
    visibility = ["//:__subpackages__"],
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//tools/api:__pkg__"],
)
