{
  "$schema": "../core/modules/lang.schema.json",
  "name": "haskell",
  "title": "Haskell",
  "family": "core",
  "ecosystems": [
    "cabal"
  ],
  "depcheck": "haskell",
  "semver": false,
  "manifests": [
    "cabal.project"
  ],
  "lockfiles": [
    "cabal.project.freeze"
  ],
  "setup": {
    "hubs": [
      {
        "ecosystem": "cabal",
        "manifest": "cabal.project",
        "lock": "haskell_deps.json",
        "state": "cabal.project.freeze",
        "extension": "@rules_dx//haskell:extensions.bzl",
        "tag": "lock",
        "hub": "hackage",
        "resolver": null,
        "imports": "name"
      }
    ]
  },
  "tools": [
    "hlint",
    "ormolu",
    "weeder"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_x86_64"
  ],
  "pins": [
    "pins.json"
  ],
  "entry_points": [
    "haskell_library",
    "haskell_binary",
    "haskell_test",
    "haskell_bench",
    "haskell_deps_resolve",
    "haskell_deps_resolve_test"
  ],
  "quality": {
    "bzl": "haskell/private/quality:haskell.bzl",
    "file_extensions": [
      ".hs"
    ],
    "aspects": {
      "format": [
        "real_haskell_format_aspect"
      ],
      "lint": [
        "real_haskell_lint_aspect"
      ],
      "typecheck": [
        "real_haskell_typecheck_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_haskell_format_probe_aspect"
      ],
      "lint": [
        "real_haskell_lint_probe_aspect"
      ],
      "typecheck": [
        "real_haskell_typecheck_probe_aspect"
      ]
    }
  },
  "docs": {
    "bzl": "tools/docs/haskell:aspect.bzl",
    "file_extensions": [
      ".hs"
    ],
    "aspects": [
      "real_haskell_docs_aspect"
    ]
  }
}
