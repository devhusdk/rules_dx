{
  "$schema": "../modules/lang.schema.json",
  "name": "haskell",
  "title": "Haskell",
  "family": "core",
  "ecosystems": [
    "cabal"
  ],
  "depcheck": "haskell",
  "semver": false,
  "manifests": [
    "cabal.project"
  ],
  "lockfiles": [
    "cabal.project.freeze"
  ],
  "tools": [
    "hlint",
    "ormolu",
    "weeder"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64"
  ],
  "pins": [
    "toolchain/pins.bzl"
  ],
  "entry_points": [
    "with_gmp",
    "haskell_library",
    "haskell_binary",
    "haskell_test",
    "haskell_bench"
  ],
  "quality": {
    "bzl": "quality:families/haskell.bzl",
    "file_extensions": [
      ".hs"
    ],
    "aspects": {
      "format": [
        "real_haskell_format_aspect"
      ],
      "lint": [
        "real_haskell_lint_aspect"
      ],
      "typecheck": [
        "real_haskell_typecheck_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_haskell_format_probe_aspect"
      ],
      "lint": [
        "real_haskell_lint_probe_aspect"
      ],
      "typecheck": [
        "real_haskell_typecheck_probe_aspect"
      ]
    }
  }
}
