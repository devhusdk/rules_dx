load("//core/quality:fixtures.bzl", "real_source_target")
load("//haskell:defs.bzl", "haskell_binary")
load("//haskell/private:defs.bzl", "HASKELL_COMPATIBLE_WITH")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "coverage.bzl",
    ],
    tags = ["corpus"],
)

alias(
    name = "hpc_lcov",
    actual = "@dx_prebuilt//:hpc_lcov",
    target_compatible_with = HASKELL_COMPATIBLE_WITH,
    visibility = VIS_TOOLS_PUBLIC,
)

haskell_binary(
    name = "hpc_lcov_source",
    srcs = ["src/HpcLcov.hs"],
    target_compatible_with = HASKELL_COMPATIBLE_WITH,
    visibility = VIS_TOOLS + ["@dx_prebuilt//:__pkg__"],
    deps = [
        "@dx_haskell_toolchains//lib:base",
        "@dx_haskell_toolchains//lib:containers",
        "@dx_haskell_toolchains//lib:hpc",
    ],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
