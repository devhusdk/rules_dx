load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("//core:cells.bzl", "cell_settings", "unsupported_value")
load("//core/quality:fixtures.bzl", "real_source_target")
load(":pins.bzl", "CELLS")

package(default_visibility = ["//visibility:public"])

exports_files([
    "extensions.bzl",
    "packages.bzl",
    "pins.bzl",
    "repos.bzl",
    "transition.bzl",
])

unsupported_value("unsupported")

cell_settings(
    name = "cell",
    cells = CELLS,
)

bool_flag(
    name = "ghc_mingw",
    build_setting_default = False,
)

config_setting(
    name = "ghc_mingw_enabled",
    flag_values = {":ghc_mingw": "True"},
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "extensions.bzl",
        "packages.bzl",
        "pins.bzl",
        "repos.bzl",
        "transition.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
