load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

_PROJECT = ["cabal.project"]

exports_files(_PROJECT + ["cabal.lock.json"])

build_test(
    name = "hlint_build_test",
    target_compatible_with = select({
        "//haskell/private/toolchain:cell_linux_arm64": [],
        "//haskell/private/toolchain:cell_macos_arm64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    targets = ["@haskell_hlint_hackage//:hlint-exe-hlint"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

build_test(
    name = "hlint_clock_hsc2hs_build_test",
    target_compatible_with = select({
        "//haskell/private/toolchain:cell_linux_x86_64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    targets = ["@haskell_hlint_hackage//:clock"],
)

platform_transition_filegroup(
    name = "clock_musl",
    testonly = True,
    srcs = ["@haskell_hlint_hackage//:clock"],
    target_compatible_with = select({
        "//haskell/private/toolchain:cell_linux_x86_64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    target_platform = "//tools/platforms:linux_x86_64_musl",
)

build_test(
    name = "hlint_clock_hsc2hs_musl_build_test",
    size = "small",
    targets = [":clock_musl"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
