load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS_PUBLIC)

rust_library(
    name = "cabal_lock_lib",
    srcs = ["src/resolve.rs"],
    aliases = aliases(
        package_name = "haskell/private/tools/cabal_lock",
        normal = True,
    ),
    crate_name = "cabal_lock",
    crate_root = "src/resolve.rs",
    deps = all_crate_deps(
        package_name = "haskell/private/tools/cabal_lock",
        normal = True,
    ) + [
        "//cli/digest:dx_digest",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
        "@crates//:serde_json",
    ],
)

rust_binary(
    name = "lock",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "haskell/private/tools/cabal_lock",
        normal = True,
    ),
    crate_name = "cabal_lock_bin",
    crate_root = "src/main.rs",
    data = [
        "//haskell:cabal",
        "//haskell:ghc_exe",
        "//haskell:ghc_files",
    ],
    env = {
        "DX_CABAL": "$(rlocationpath //haskell:cabal)",
        "DX_GHC": "$(rlocationpath //haskell:ghc_exe)",
    },
    visibility = VIS_TOOLS_PUBLIC,
    deps = all_crate_deps(
        package_name = "haskell/private/tools/cabal_lock",
        normal = True,
    ) + [
        ":cabal_lock_lib",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
        "@crates//:serde_json",
        "@rules_rust//rust/runfiles",
    ],
)

rust_test(
    name = "resolve_test",
    size = "small",
    srcs = ["resolve_test.rs"],
    aliases = aliases(
        package_name = "haskell/private/tools/cabal_lock",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "resolve_test",
    crate_root = "resolve_test.rs",
    data = [
        "testdata/golden.lock.json",
        "testdata/plan.json",
    ],
    env = {
        "GOLDEN": "$(rootpath testdata/golden.lock.json)",
        "PLAN": "$(rootpath testdata/plan.json)",
    },
    tags = ["block-network"],
    deps = all_crate_deps(
        package_name = "haskell/private/tools/cabal_lock",
        normal = True,
        normal_dev = True,
    ) + [
        ":cabal_lock_lib",
        "//cli/digest:dx_digest",
        "//cli/lock:dx_lock",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = VIS_TOOLS_PUBLIC,
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
