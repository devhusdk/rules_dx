load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//cli/launcher:defs.bzl", "dx_subcommand")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//:__subpackages__"])

rust_library(
    name = "cabal_lock_lib",
    srcs = ["src/resolve.rs"],
    aliases = aliases(
        package_name = "haskell/private/tools/cabal_lock",
        normal = True,
    ),
    crate_name = "cabal_lock",
    crate_root = "src/resolve.rs",
    visibility = ["//cli/cli:__pkg__"],
    deps = all_crate_deps(
        package_name = "haskell/private/tools/cabal_lock",
        normal = True,
    ) + [
        "//cli/archive:dx_archive",
        "//cli/digest:dx_digest",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
        "@crates//:serde_json",
    ],
)

dx_subcommand(
    name = "lock",
    data = ["//haskell:ghc_files"],
    path_args = {
        "--cabal": "//haskell:cabal",
        "--ghc": "//haskell:ghc_exe",
    },
    subcommand = "haskell_lock",
    visibility = ["//:__subpackages__"],
)

rust_test(
    name = "resolve_test",
    size = "small",
    srcs = ["resolve_test.rs"],
    aliases = aliases(
        package_name = "haskell/private/tools/cabal_lock",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "resolve_test",
    crate_root = "resolve_test.rs",
    data = [
        "testdata/golden.lock.json",
        "testdata/plan.json",
    ],
    env = {
        "GOLDEN": "$(rootpath testdata/golden.lock.json)",
        "PLAN": "$(rootpath testdata/plan.json)",
    },
    tags = ["block-network"],
    deps = all_crate_deps(
        package_name = "haskell/private/tools/cabal_lock",
        normal = True,
        normal_dev = True,
    ) + [
        ":cabal_lock_lib",
        "//cli/archive:dx_archive",
        "//cli/archive:dx_archive_testing",
        "//cli/digest:dx_digest",
        "//cli/lock:dx_lock",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
