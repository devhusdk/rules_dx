load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//haskell/private:defs.bzl", "HASKELL_COMPATIBLE_WITH")

package(default_visibility = ["//visibility:public"])

_PROJECT = [
    "cabal.project",
    "weeder_tool.cabal",
]

exports_files(_PROJECT + ["cabal.lock.json"])

build_test(
    name = "weeder_build_test",
    target_compatible_with = HASKELL_COMPATIBLE_WITH,
    targets = ["@haskell_weeder_hackage//:weeder-exe-weeder"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
