load("//haskell:defs.bzl", "haskell_library", "haskell_test")
load("//haskell/private:defs.bzl", "HASKELL_COMPATIBLE_WITH")

package(default_visibility = ["//haskell/tests:__pkg__"])

# keep
haskell_library(
    name = "greeter",
    testonly = True,
    srcs = ["Greeter.hs"],
    target_compatible_with = HASKELL_COMPATIBLE_WITH,
    deps = ["@dx_haskell_toolchains//lib:base"],
)

haskell_test(
    name = "greeter_test",
    size = "small",
    srcs = ["GreeterTest.hs"],
    target_compatible_with = HASKELL_COMPATIBLE_WITH,
    deps = [
        ":greeter",
        "@dx_haskell_toolchains//lib:base",
    ],
)
