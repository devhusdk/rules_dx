load("@bazel_skylib//rules:build_test.bzl", "build_test")

# Keep these loads in sync with _MINGW_CC_LOADS in haskell/toolchain/repos.bzl.
# Only the Windows GHC repo uses them, so this package loads them on every host.
load("@rules_cc//cc/toolchains:cc_toolchain.bzl", "cc_toolchain")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_haskell//haskell:cc_toolchain_config.bzl", "cc_toolchain_config")

filegroup(name = "empty")

cc_toolchain_config(
    name = "config",
    is_clang = True,
)

cc_toolchain(
    name = "toolchain",
    all_files = ":empty",
    ar_files = ":empty",
    as_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    linker_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    supports_param_files = 0,
    toolchain_config = ":config",
    toolchain_identifier = "mingw_cc_test",
)

build_test(
    name = "mingw_cc_test",
    targets = [
        ":config",
        ":toolchain",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
