load("//quality:fixtures.bzl", "real_source_target")
load(":metadata_tests.bzl", "haskell_metadata_tests")

package(default_visibility = ["//visibility:public"])

exports_files([
    "metadata_tests.bzl",
    "pins.bzl",
    "repos.bzl",
])

haskell_metadata_tests(name = "metadata")

# Consumers cannot see @dx_haskell_toolchains, so they depend on this alias.
alias(
    name = "base",
    actual = "@dx_haskell_toolchains//:base",
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "metadata_tests.bzl",
        "pins.bzl",
        "repos.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
