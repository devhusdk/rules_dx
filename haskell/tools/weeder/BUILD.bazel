load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//haskell/rules:defs.bzl", "HASKELL_COMPATIBLE_WITH")
load("//haskell/rules:deps_resolve.bzl", "haskell_deps_resolve", "haskell_deps_resolve_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

_PROJECT = [
    "cabal.project",
    "weeder_tool.cabal",
]

exports_files(_PROJECT + ["haskell_deps.json"])

haskell_deps_resolve(
    name = "resolve",
    srcs = _PROJECT,
)

haskell_deps_resolve_test(
    name = "resolve_test",
    srcs = _PROJECT,
)

build_test(
    name = "weeder_build_test",
    targets = ["@haskell_weeder_hackage//:weeder-exe-weeder"],
    target_compatible_with = HASKELL_COMPATIBLE_WITH,
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
