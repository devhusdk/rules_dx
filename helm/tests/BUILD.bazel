load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//core:failure_test.bzl", "failure_test")
load(":defs_tests.bzl", "chart_provider_test", "external_chart_provider_test", "owns_helm_class_test")

owns_helm_class_test(
    name = "owns_helm_class_test",
    size = "small",
    target_under_test = "//helm/tests/fixtures/chart:app",
)

chart_provider_test(
    name = "chart_provider_test",
    size = "small",
    expected_release_name = "demo",
    target_under_test = "//helm/tests/fixtures/chart:app",
)

chart_provider_test(
    name = "dotted_release_provider_test",
    size = "small",
    expected_release_name = "my.app",
    target_under_test = "//helm/tests/fixtures/chart:dotted_release",
)

failure_test(
    name = "empty_label_release_fails",
    expected_failure_substring = "release_name 'a..b' must be dot-separated DNS-1123 labels",
    target = "//helm/tests/fixtures/chart:empty_label_release",
)

failure_test(
    name = "no_chart_yaml_fails",
    expected_failure_substring = "srcs must contain helm/tests/fixtures/chart/Chart.yaml",
    target = "//helm/tests/fixtures/chart:no_chart_yaml",
)

failure_test(
    name = "bad_release_fails",
    expected_failure_substring = "release_name 'Bad_Name' must be dot-separated DNS-1123 labels",
    target = "//helm/tests/fixtures/chart:bad_release",
)

failure_test(
    name = "long_release_fails",
    expected_failure_substring = "must be at most 53 characters (Helm limit)",
    target = "//helm/tests/fixtures/chart:long_release",
)

failure_test(
    name = "long_namespace_fails",
    expected_failure_substring = "must be at most 63 characters",
    target = "//helm/tests/fixtures/chart:long_namespace",
)

failure_test(
    name = "bad_namespace_fails",
    expected_failure_substring = "namespace '-lead' must be a DNS-1123 label",
    target = "//helm/tests/fixtures/chart:bad_namespace",
)

failure_test(
    name = "archive_in_srcs_fails",
    expected_failure_substring = "belongs in subcharts, not srcs",
    target = "//helm/tests/fixtures/chart:archive_in_srcs",
)

failure_test(
    name = "misplaced_dependency_fails",
    expected_failure_substring = "must be a .tgz under helm/tests/fixtures/chart/charts/",
    target = "//helm/tests/fixtures/chart:misplaced_dependency",
)

failure_test(
    name = "duplicate_file_fails",
    expected_failure_substring = "duplicate file 'helm/tests/fixtures/chart/values.yaml'",
    target = "//helm/tests/fixtures/chart:duplicate_file",
)

failure_test(
    name = "foreign_src_fails",
    size = "small",
    expected_failure_substring = "src 'helm/lang.json' must be under the chart package 'helm/tests/fixtures/chart'",
    target = "//helm/tests/fixtures/chart:foreign_src",
)

external_chart_provider_test(
    name = "external_chart_provider_test",
    size = "small",
    target_under_test = "@dx_api_fixtures//helm/tests/consumer:helm",
)

failure_test(
    name = "foreign_repo_src_fails",
    size = "small",
    expected_failure_substring = "dx_api_fixtures/helm/tests/consumer/Chart.yaml' is in another Bazel repository",
    target = "//helm/tests/fixtures/chart:foreign_repo_src",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "defs_tests.bzl",
    ],
    tags = ["corpus"],
)
