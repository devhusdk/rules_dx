{
  "$schema": "../modules/lang.schema.json",
  "name": "java",
  "title": "Java",
  "family": "core",
  "ecosystems": [
    "maven"
  ],
  "manifests": [
    "pom.xml"
  ],
  "lockfiles": [
    "maven_install.json"
  ],
  "tools": [
    "google_java_format",
    "javac",
    "pmd",
    "spotbugs"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_arm64",
    "windows_x86_64"
  ],
  "pins": [],
  "entry_points": [
    "java_library",
    "java_binary",
    "java_test",
    "java_jmh_test",
    "java_fuzz_test",
    "java_bench"
  ],
  "quality": {
    "bzl": "quality:families/jvm.bzl",
