{
  "$schema": "../core/modules/lang.schema.json",
  "name": "java",
  "title": "Java",
  "family": "core",
  "ecosystems": [
    "maven"
  ],
  "depcheck": "java",
  "semver": false,
  "manifests": [
    "MODULE.bazel"
  ],
  "lockfiles": [
    "maven_install.json"
  ],
  "setup": {
    "hubs": [
      {
        "ecosystem": "maven",
        "manifest": "libs.versions.toml",
        "lock": "maven_install.json",
        "state": null,
        "extension": "@rules_dx//java:extensions.bzl",
        "tag": "from_toml",
        "hub": "maven",
        "resolver": null,
        "imports": "provides"
      }
    ]
  },
  "tools": [
    "google_java_format",
    "javac",
    "pmd",
    "spotbugs"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_arm64",
    "windows_x86_64"
  ],
  "pins": [
    "pins.json"
  ],
  "entry_points": [
    "java_library",
    "java_binary",
    "java_test",
    "java_jmh_test",
    "java_fuzz_test",
    "java_bench"
  ],
  "quality": {
    "bzl": "core/quality:families/jvm.bzl",
    "file_extensions": [
      ".java"
    ],
    "aspects": {
      "format": [
        "real_jvm_format_aspect"
      ],
      "lint": [
        "real_jvm_lint_aspect",
        "real_pkl_lint_aspect"
      ],
      "typecheck": [
        "real_jvm_typecheck_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_jvm_format_probe_aspect"
      ],
      "lint": [
        "real_jvm_lint_probe_aspect"
      ],
      "typecheck": [
        "real_jvm_typecheck_probe_aspect"
      ]
    }
  },
  "docs": {
    "bzl": "tools/docs/jvm:aspect.bzl",
    "file_extensions": [
      ".java"
    ],
    "aspects": [
      "real_jvm_docs_aspect"
    ]
  }
}
