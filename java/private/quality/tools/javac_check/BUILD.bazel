load("//core/quality:fixtures.bzl", "real_source_target")
load("//java:defs.bzl", "java_binary", "java_library")

package(default_visibility = ["//:__subpackages__"])

java_library(
    name = "javac_check_lib",
    srcs = ["src/dx/quality/javac/JavacCheck.java"],
)

java_binary(
    name = "javac_check",
    srcs = ["src/dx/quality/javac/Main.java"],
    main_class = "dx.quality.javac.Main",
    # The @dx_prebuilt hub aliases this tool and its deploy jar on platforms with no pinned jar.
    visibility = [
        "//:__subpackages__",
        "@dx_prebuilt//:__pkg__",
    ],
    deps = [
        ":javac_check_lib",
        "//java/private/quality/tools/worker",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
