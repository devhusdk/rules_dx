load("//java:defs.bzl", "java_binary", "java_library")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS_PUBLIC)

java_library(
    name = "scalac_check_lib",
    srcs = [
        "src/dx/quality/scalac/Scala3Frontend.java",
        "src/dx/quality/scalac/ScalacCheck.java",
    ],
    deps = ["//java/private/quality/tools/worker"],
)

java_binary(
    name = "scalac_check",
    srcs = ["src/dx/quality/scalac/Main.java"],
    main_class = "dx.quality.scalac.Main",
    deps = [
        ":scalac_check_lib",
        "//java/private/quality/tools/worker",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
