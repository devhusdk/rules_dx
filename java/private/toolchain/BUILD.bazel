load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_java//java:defs.bzl", "java_package_configuration")
load("@rules_java//toolchains:default_java_toolchain.bzl", "default_java_toolchain")

# -Werror for rules_dx's own packages; external repos compile without it.
package_group(
    name = "own",
    packages = ["//..."],
)

java_package_configuration(
    name = "warnings_as_errors",
    javacopts = ["-Werror"],
    packages = [":own"],
)

[
    default_java_toolchain(
        name = "toolchain_jdk_%s" % version,
        package_configuration = [":warnings_as_errors"],
        source_version = version,
        target_version = version,
        toolchain_definition = False,
    )
    for version in [
        "11",
        "17",
        "21",
    ]
]

[
    config_setting(
        name = "version_%s" % version,
        values = {"java_language_version": version},
    )
    for version in [
        "11",
        "17",
        "21",
    ]
]

config_setting(
    name = "version_default",
    values = {"java_language_version": ""},
)

[
    toolchain(
        name = "toolchain_jdk_%s_definition" % version,
        target_settings = [
            "//config:toolchains_on",
            ":version_%s" % version,
        ],
        toolchain = ":toolchain_jdk_%s" % version,
        toolchain_type = "@bazel_tools//tools/jdk:toolchain_type",
    )
    for version in [
        "11",
        "17",
        "21",
    ]
]

toolchain(
    name = "toolchain_jdk_11_default_definition",
    target_settings = [
        "//config:toolchains_on",
        ":version_default",
    ],
    toolchain = ":toolchain_jdk_11",
    toolchain_type = "@bazel_tools//tools/jdk:toolchain_type",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
