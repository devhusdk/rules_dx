load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_java//java:java_binary.bzl", "java_binary")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:private"])

java_binary(
    name = "resolver",
    main_class = "com.github.bazelbuild.rules_jvm_external.resolver.maven.MavenMain",
    runtime_deps = ["@rules_jvm_external//private/tools/java/com/github/bazelbuild/rules_jvm_external/resolver/maven:maven-resolver-lib"],
)

TOOLS_DATA = [
    ":resolver_deploy.jar",
    "//java/private/quality/tools:jdk25",
]

TOOLS_ENV = {
    "DX_MAVEN_JAVA": "$(JAVA_ROOTPATH)",
    "DX_MAVEN_RESOLVER": "$(rlocationpath :resolver_deploy.jar)",
}

rust_library(
    name = "maven_lock_lib",
    srcs = ["src/resolve.rs"],
    aliases = aliases(
        package_name = "java/private/tools/maven_lock",
        normal = True,
    ),
    crate_name = "maven_lock",
    crate_root = "src/resolve.rs",
    deps = all_crate_deps(
        package_name = "java/private/tools/maven_lock",
        normal = True,
    ) + ["@crates//:serde_json"],
)

rust_binary(
    name = "lock",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "java/private/tools/maven_lock",
        normal = True,
    ),
    crate_name = "maven_lock_bin",
    crate_root = "src/main.rs",
    data = TOOLS_DATA,
    env = TOOLS_ENV,
    toolchains = ["//java/private/quality/tools:jdk25"],
    visibility = ["//:__subpackages__"],
    deps = all_crate_deps(
        package_name = "java/private/tools/maven_lock",
        normal = True,
    ) + [
        ":maven_lock_lib",
        "//cli/families:dx_families",
    ],
)

rust_test(
    name = "resolve_test",
    size = "medium",
    srcs = ["resolve_test.rs"],
    aliases = aliases(
        package_name = "java/private/tools/maven_lock",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "resolve_test",
    crate_root = "resolve_test.rs",
    data = TOOLS_DATA + [
        "//java/tests/fixtures/maven_lock:golden.json",
        "//java/tests/fixtures/maven_lock:repo",
        "//java/tests/fixtures/maven_lock:repo/com/example/lib/2.0/lib-2.0.pom",
    ],
    env = TOOLS_ENV | {
        "GOLDEN": "$(rootpath //java/tests/fixtures/maven_lock:golden.json)",
        "REPO": "$(rootpath //java/tests/fixtures/maven_lock:repo/com/example/lib/2.0/lib-2.0.pom)",
    },
    tags = ["block-network"],
    target_compatible_with = ["@platforms//os:linux"],
    toolchains = ["//java/private/quality/tools:jdk25"],
    deps = all_crate_deps(
        package_name = "java/private/tools/maven_lock",
        normal = True,
        normal_dev = True,
    ) + [
        ":maven_lock_lib",
        "//cli/families:dx_families",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    [
        "Cargo.toml",
        "src/main.rs",
    ],
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
