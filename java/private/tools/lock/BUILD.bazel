load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_java//java:java_binary.bzl", "java_binary")
load("//cli/launcher:defs.bzl", "dx_subcommand")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:private"])

java_binary(
    name = "resolver",
    main_class = "com.github.bazelbuild.rules_jvm_external.resolver.maven.MavenMain",
    visibility = [
        "//:__subpackages__",
        "@dx_prebuilt//:__pkg__",
    ],
    runtime_deps = ["@rules_jvm_external//private/tools/java/com/github/bazelbuild/rules_jvm_external/resolver/maven:maven-resolver-lib"],
)

rust_library(
    name = "maven_lock_lib",
    srcs = ["src/resolve.rs"],
    aliases = aliases(
        package_name = "java/private/tools/maven_lock",
        normal = True,
    ),
    crate_name = "maven_lock",
    crate_root = "src/resolve.rs",
    visibility = ["//cli/cli:__pkg__"],
    deps = all_crate_deps(
        package_name = "java/private/tools/maven_lock",
        normal = True,
    ) + [
        "//cli/digest:dx_digest",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
        "@crates//:serde_json",
    ],
)

dx_subcommand(
    name = "lock",
    data = ["//java/private/quality/tools:jdk25"],
    path_args = {
        "--java": "//java/private/quality/tools:jdk25_java",
        "--resolver-jar": "@dx_prebuilt//:maven_resolver_deploy.jar",
    },
    subcommand = "java_lock",
    visibility = ["//:__subpackages__"],
)

rust_test(
    name = "resolve_test",
    size = "small",
    srcs = ["resolve_test.rs"],
    aliases = aliases(
        package_name = "java/private/tools/maven_lock",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "resolve_test",
    crate_root = "resolve_test.rs",
    data = [
        ":resolver_deploy.jar",
        "//java/private/quality/tools:jdk25",
        "//java/private/quality/tools:jdk25_java",
        "//java/tests/fixtures/maven_lock:golden.json",
        "//java/tests/fixtures/maven_lock:repo",
        "//java/tests/fixtures/maven_lock:repo/com/example/lib/2.0/lib-2.0.pom",
    ],
    env = {
        "DX_MAVEN_JAVA": "$(rlocationpath //java/private/quality/tools:jdk25_java)",
        "DX_MAVEN_RESOLVER": "$(rlocationpath :resolver_deploy.jar)",
        "GOLDEN": "$(rootpath //java/tests/fixtures/maven_lock:golden.json)",
        "REPO": "$(rootpath //java/tests/fixtures/maven_lock:repo/com/example/lib/2.0/lib-2.0.pom)",
    },
    tags = ["block-network"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = all_crate_deps(
        package_name = "java/private/tools/maven_lock",
        normal = True,
        normal_dev = True,
    ) + [
        ":maven_lock_lib",
        "//cli/digest:dx_digest",
        "//cli/families:dx_families",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    [
        "Cargo.toml",
    ],
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
