load("//core/quality:fixtures.bzl", "real_source_target")
load("//java:defs.bzl", "java_test")
load("//rust:defs.bzl", "rust_test")

java_test(
    name = "javac_check_test",
    size = "small",
    srcs = ["JavacCheckTest.java"],
    main_class = "dx.quality.javac.JavacCheckTest",
    use_testrunner = False,
    deps = ["//java/private/quality/tools/javac_check:javac_check_lib"],
)

java_test(
    name = "kotlinc_check_test",
    size = "small",
    srcs = ["KotlincCheckTest.java"],
    args = ["$(rlocationpaths //java/private/quality/tools/kotlinc_check:compiler_jars)"],
    data = ["//java/private/quality/tools/kotlinc_check:compiler_jars"],
    main_class = "dx.quality.kotlinc.KotlincCheckTest",
    use_testrunner = False,
    deps = ["//java/private/quality/tools/kotlinc_check:kotlinc_check_lib"],
)

