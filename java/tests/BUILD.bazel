rust_test(
    name = "pkl_lsp_smoke_test",
    size = "small",
    srcs = ["pkl_lsp_smoke_test.rs"],
    crate_name = "pkl_lsp_smoke_test",
    crate_root = "pkl_lsp_smoke_test.rs",
    data = [
        "clean.pkl",
        "unused.pkl",
        "//core/quality/lsp_check",
        "//java/private/quality/tools:jdk25",
        "@jvm_pkl_lsp//file",
    ],
    env = {
        "LSP_CHECK": "$(rootpath //core/quality/lsp_check)",
        "PKL_LSP_JAR": "$(rootpath @jvm_pkl_lsp//file)",
        "PKL_LSP_JAVA": "$(JAVA_ROOTPATH)",
    },
    toolchains = ["//java/private/quality/tools:jdk25"],
    deps = ["//tools/testing:dx_testing"],
)

real_source_target(
