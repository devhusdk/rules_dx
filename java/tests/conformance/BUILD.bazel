load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//java:defs.bzl", "java_binary", "java_library", "java_test")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "subject_compatible_with")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

java_library(
    name = "conformance",
    testonly = True,
    srcs = ["Greet.java"],
)

java_binary(
    name = "hello",
    srcs = ["Main.java"],
    main_class = "conformance.Main",
    deps = [":conformance"],
)

java_test(
    name = "pass_subject_test",
    size = "small",
    srcs = ["PassTest.java"],
    target_compatible_with = subject_compatible_with(),
    test_class = "conformance.PassTest",
    deps = [
        ":conformance",
        "@maven//:junit_junit",
    ],
)

java_test(
    name = "fail_subject_test",
    size = "small",
    srcs = ["FailTest.java"],
    target_compatible_with = subject_compatible_with(),
    test_class = "conformance.FailTest",
    deps = [
        ":conformance",
        "@maven//:junit_junit",
    ],
)

java_binary(
    name = "runfiles_hello",
    srcs = ["RunfilesMain.java"],
    data = ["data.txt"],
    main_class = "conformance.RunfilesMain",
    deps = ["@rules_java//java/runfiles"],
)

java_binary(
    name = "lock_hello",
    srcs = ["LockMain.java"],
    main_class = "conformance.LockMain",
    deps = ["@maven//:junit_junit"],
)

dx_conformance_suite(
    name = "",
    size = "small",
    binary = ":hello",
    covered_source = "Greet.java",
    expected = "hello world",
    failing_case = "failingCase",
    failing_pattern = "{case}(conformance.FailTest)",
    failing_test = ":fail_subject_test",
    lang = "java",
    lock = {
        "binary": ":lock_hello",
        "ecosystem": "java",
        "expected": "hello lock",
        "lockfile": "//third_party/jvm:maven_install.json",
        "manifest": "jvm_deps.toml",
        "package": "junit:junit",
        "stale": "maven_install.stale.json",
    },
    passing_test = ":pass_subject_test",
    runfiles = {
        "binary": ":runfiles_hello",
        "data": "data.txt",
        "expected": "hello runfiles",
    },
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    testonly = True,
    tags = ["corpus"],
    toml_srcs = ["jvm_deps.toml"],
)
