load("@rules_dx//java:defs.bzl", "java_bench")
load("@rules_dx//libs/starlark:fuzz_bench_tests.bzl", "dx_runner_attr_test")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

java_bench(
    name = "sum_bench",
    srcs = ["Sum.java"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
    ],
    tags = ["corpus"],
)

java_bench(
    name = "sized_bench",
    srcs = ["Sum.java"],
    size = "large",
    timeout = "long",
)

dx_runner_attr_test(
    name = "sized_bench_attrs",
    expected = {
        "size": "large",
        "timeout": "long",
    },
    runner = "sized_bench",
)

java_bench(
    name = "env_bench",
    srcs = ["Sum.java"],
    env = {"BENCH_MODE": "fast"},
)

dx_runner_attr_test(
    name = "env_bench_attrs",
    expected = {
        "env": {"BENCH_MODE": "fast"},
        "tags": ["dx-bench", "manual"],
        "upstream": ":env_bench_upstream",
    },
    runner = "env_bench",
)
