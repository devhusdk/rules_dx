load("@rules_dx//java:defs.bzl", "java_fuzz_test")
load("@rules_dx//core:fuzz_bench_tests.bzl", "dx_runner_attr_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

java_fuzz_test(
    name = "parse_fuzz",
    srcs = ["ParseFuzz.java"],
    target_class = "tests.fixtures.fuzz.ParseFuzz",
)

sh_test(
    name = "parse_fuzz_run_test",
    srcs = ["run_test.sh"],
    args = [
        "$(rlocationpath @rules_dx//cli/fuzz_run:fuzz_run)",
        "$(rootpath :parse_fuzz)",
        "tests.fixtures.fuzz.ParseFuzz",
    ],
    data = [
        ":parse_fuzz",
        "@rules_dx//cli/fuzz_run:fuzz_run",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    timeout = "short",
)

java_fuzz_test(
    name = "args_fuzz",
    srcs = ["ParseFuzz.java"],
    args = ["-max_total_time=1"],
    target_class = "tests.fixtures.fuzz.ParseFuzz",
)

dx_runner_attr_test(
    name = "args_fuzz_attrs",
    expected = {"args": ["-max_total_time=1"]},
    runner = "args_fuzz",
)

dx_runner_attr_test(
    name = "parse_fuzz_attrs",
    expected = {"tags": ["dx-fuzz", "manual"]},
    runner = "parse_fuzz",
)

dx_runner_attr_test(
    name = "parse_fuzz_run_attrs",
    expected = {"args": [
        "jazzer",
        "$(rootpath :parse_fuzz)",
        "tests.fixtures.fuzz.ParseFuzz",
    ]},
    runner = "parse_fuzz_run",
)

exports_files(["run_test.sh"])
