load("//java/rules:defs.bzl", "java_binary", "java_library", "java_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//tools/testing:hello_output.bzl", "dx_hello_output_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

java_library(
    name = "hello_lib",
    srcs = ["Hello.java"],
    aspect_hints = ["//quality:corpus_checkstyle_config"],
)

java_binary(
    name = "hello",
    srcs = ["Main.java"],
    aspect_hints = ["//quality:corpus_checkstyle_config"],
    main_class = "hello.Main",
    deps = [":hello_lib"],
)

java_test(
    name = "hello_test",
    srcs = ["HelloTest.java"],
    aspect_hints = ["//quality:corpus_checkstyle_config"],
    test_class = "hello.HelloTest",
    deps = [":hello_lib"],
)

dx_hello_output_test(
    name = "hello_output_test",
    binary = ":hello",
    expected = "hello world",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
