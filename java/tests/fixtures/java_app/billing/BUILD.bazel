load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//java:defs.bzl", "java_library", "java_test")
load("@rules_dx//java/tests:jvm_compile_tests.bzl", "jvm_classpath_test")
load("@rules_dx//tools/testing/conformance:defs.bzl", "dx_coverage_test")

package(default_visibility = ["//java/tests/fixtures/java_app:__subpackages__"])

exports_files(
    [
        "invoices.json",
        "LineItem.java",
        "Invoice.java",
        "InvoiceException.java",
        "InvoiceReader.java",
        "Totals.java",
        "InvoiceReaderTest.java",
        "TotalsTest.java",
        "ClasspathTest.java",
        "VERSION",
    ] + glob(["malformed/*"]),
    visibility = ["//visibility:public"],
)

genrule(
    name = "build_info",
    srcs = ["VERSION"],
    outs = ["BuildInfo.java"],
    cmd = "printf 'package billing;\\n\\n/** Build constants. */\\npublic final class BuildInfo {\\n  /** Schema number. */\\n  public static final int SCHEMA = %s;\\n\\n  private BuildInfo() {}\\n}\\n' \"$$(cat $<)\" > $@",
)

java_library(
    name = "billing",
    testonly = True,
    srcs = [
        "Invoice.java",
        "InvoiceException.java",
        "InvoiceReader.java",
        "LineItem.java",
        "Totals.java",
        ":build_info",  # keep
    ],
    resource_strip_prefix = "java/tests/fixtures/java_app",
    resources = ["invoices.json"],
    visibility = ["//java/tests/fixtures/java_app:__subpackages__"],
    deps = [
        "@maven//:com_google_code_gson_gson",
        "@maven//:com_google_guava_guava",
    ],
)

# keep
java_library(
    name = "without_gson",
    testonly = True,
    srcs = [
        "Invoice.java",
        "InvoiceException.java",
        "InvoiceReader.java",
        "LineItem.java",
        "Totals.java",
        ":build_info",  # keep
    ],
    tags = ["manual"],
    deps = ["@maven//:com_google_guava_guava"],
)

jvm_classpath_test(
    name = "without_gson_classpath_test",
    size = "small",
    jar = "gson",
    library = "without_gson",
    mnemonic = "Javac",
    present = False,
)

jvm_classpath_test(
    name = "billing_gson_classpath_test",
    size = "small",
    jar = "gson",
    library = "billing",
    mnemonic = "Javac",
    present = True,
)

dx_coverage_test(
    name = "invoice_reader_coverage_test",
    size = "small",
    covered_source = "InvoiceReader.java",
    subject = ":invoice_reader_test",
)

java_test(
    name = "invoice_reader_test",
    size = "small",
    srcs = ["InvoiceReaderTest.java"],
    test_class = "billing.InvoiceReaderTest",
    deps = [":billing"],
)

java_test(
    name = "totals_test",
    size = "small",
    srcs = ["TotalsTest.java"],
    test_class = "billing.TotalsTest",
    deps = [
        ":billing",
        "@maven//:com_google_guava_guava",
    ],
)

java_test(
    name = "classpath_test",
    size = "small",
    srcs = ["ClasspathTest.java"],
    test_class = "billing.ClasspathTest",
    deps = [
        ":billing",
        "@maven//:com_google_code_gson_gson",
        "@maven//:com_google_guava_guava",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
