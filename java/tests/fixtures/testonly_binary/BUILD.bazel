load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//java:defs.bzl", "java_binary", "java_library")

package(default_visibility = ["//:__subpackages__"])

# keep
java_library(
    name = "lib",
    testonly = True,
    srcs = ["Lib.java"],
)

java_binary(
    name = "testonly_main",
    testonly = True,
    srcs = ["Main.java"],
    main_class = "testonly.Main",
    deps = [":lib"],
)

build_test(
    name = "testonly_binary_build_test",
    targets = [":testonly_main"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
