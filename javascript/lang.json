{
  "$schema": "../core/modules/lang.schema.json",
  "name": "javascript",
  "title": "JavaScript",
  "family": "core",
  "ecosystems": [
    "npm"
  ],
  "depcheck": "js",
  "semver": true,
  "manifests": [
    "package.json"
  ],
  "lockfiles": [
    "pnpm-lock.yaml"
  ],
  "setup": {
    "hubs": [
      {
        "ecosystem": "npm",
        "manifest": "package.json",
        "lock": "pnpm-lock.yaml",
        "state": null,
        "extension": "@rules_dx//javascript:extensions.bzl",
        "tag": "npm_translate_lock",
        "hub": "npm",
        "resolver": null,
        "imports": "name"
      },
      {
        "ecosystem": "pnpm",
        "manifest": "package.json",
        "lock": null,
        "state": null,
        "extension": "@rules_dx//javascript:extensions.bzl",
        "tag": null,
        "hub": "pnpm",
        "resolver": null,
        "imports": "name"
      }
    ]
  },
  "tools": [
    "biome",
    "eslint"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_arm64",
    "windows_x86_64"
  ],
  "pins": [],
  "entry_points": [
    "javascript_library",
    "javascript_wasm_bindgen_library",
    "javascript_binary",
    "javascript_test",
    "javascript_bench",
    "javascript_fuzz_test"
  ],
  "quality": {
    "bzl": "javascript/private/quality:js.bzl",
    "file_extensions": [
      ".cjs",
      ".js",
      ".jsx",
      ".mjs"
    ],
    "aspects": {
      "format": [
        "real_js_format_aspect"
      ],
      "lint": [
        "real_js_lint_aspect"
      ],
      "typecheck": [
        "real_js_typecheck_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_js_format_probe_aspect"
      ],
      "lint": [
        "real_js_lint_probe_aspect"
      ],
      "typecheck": [
        "real_js_typecheck_probe_aspect"
      ]
    }
  },
  "docs": {
    "bzl": "tools/docs/javascript:aspect.bzl",
    "file_extensions": [
      ".cjs",
      ".js",
      ".jsx",
      ".mjs"
    ],
    "aspects": [
      "real_javascript_docs_aspect"
    ]
  }
}
