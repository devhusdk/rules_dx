{
  "$schema": "../modules/lang.schema.json",
  "name": "javascript",
  "title": "JavaScript",
  "family": "js",
  "ecosystems": [
    "npm"
  ],
  "manifests": [
    "package.json"
  ],
  "lockfiles": [
    "pnpm-lock.yaml"
  ],
  "tools": [
    "biome",
    "eslint"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_arm64",
    "windows_x86_64"
  ],
  "pins": [],
  "entry_points": [
    "javascript_binary_upstream_data",
    "javascript_library",
    "javascript_wasm_bindgen_library",
    "javascript_binary",
    "javascript_test_rejection",
    "javascript_test",
    "javascript_bench",
    "javascript_fuzz_test"
  ],
  "quality": {
    "bzl": "javascript/private/quality:js.bzl",
    "file_extensions": [
      ".cjs",
      ".js",
      ".jsx",
      ".mjs"
    ],
    "aspects": {
      "format": [
        "real_js_format_aspect"
      ],
      "lint": [
        "real_js_lint_aspect"
      ],
      "typecheck": [
        "real_js_typecheck_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_js_format_probe_aspect"
      ],
      "lint": [
        "real_js_lint_probe_aspect"
      ],
      "typecheck": [
        "real_js_typecheck_probe_aspect"
      ]
    }
  }
}
