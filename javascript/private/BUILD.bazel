# gazelle:ignore
# gazelle:exclude *.cjs
# gazelle:exclude *.mjs

load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//javascript:defs.bzl", "javascript_library")

package(default_visibility = [
    "//:__pkg__",
    "//javascript:__subpackages__",
    "//tools/ci:__pkg__",
])

exports_files([
    "defs.bzl",
    "dev_hub.bzl",
    "framework_jest_config.cjs",
    "frameworks.bzl",
    "vite_tool.mjs",
    "web.bzl",
    "windows_tool.bzl",
])

javascript_library(
    name = "bench_driver",
    srcs = ["bench_driver.mjs"],
)

js_library(
    name = "fuzz_driver",
    srcs = ["fuzz_driver.cjs"],
)

copy_to_bin(
    name = "framework_jest_config",
    srcs = ["framework_jest_config.cjs"],
)

copy_to_bin(
    name = "vite_tool_entry",
    srcs = ["vite_tool.mjs"],
    visibility = ["//svelte:__subpackages__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "dev_hub.bzl",
        "drivers.bzl",
        "frameworks.bzl",
        "web.bzl",
        "windows_tool.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["*.bzl"]) + [
        "BUILD.bazel",
        "bench_driver.mjs",
        "framework_jest_config.cjs",
        "fuzz_driver.cjs",
        "vite_tool.mjs",
    ],
    visibility = ["//:__subpackages__"],
)
