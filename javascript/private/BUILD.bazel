# gazelle:ignore
# gazelle:exclude *.cjs
# gazelle:exclude *.mjs

load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library")
load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("//javascript:defs.bzl", "javascript_library")
load("//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//javascript:__subpackages__", "//tools/ci:__pkg__", "//:__pkg__"])

exports_files([
    "defs.bzl",
    "dev_hub.bzl",
    "framework_jest_config.cjs",
    "frameworks.bzl",
    "vite_tool.mjs",
    "web.bzl",
])

javascript_library(
    name = "bench_driver",
    visibility = ["//visibility:public"],
    srcs = ["bench_driver.mjs"],
)

js_library(
    name = "fuzz_driver",
    visibility = ["//visibility:public"],
    srcs = ["fuzz_driver.cjs"],
)

js_binary(
    name = "vite_tool",
    visibility = ["//visibility:public"],
    entry_point = "vite_tool.mjs",
)

copy_to_bin(
    name = "framework_jest_config",
    visibility = ["//visibility:public"],
    srcs = ["framework_jest_config.cjs"],
)

copy_to_bin(
    name = "vite_tool_entry",
    visibility = ["//svelte:__subpackages__"],
    srcs = ["vite_tool.mjs"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "dev_hub.bzl",
        "frameworks.bzl",
        "web.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
    ]),
    visibility = ["//:__subpackages__"],
)
