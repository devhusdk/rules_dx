load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_PUBLIC")

package(default_visibility = VIS_PUBLIC)

exports_files([
    "Cargo.toml",
    "src/lib.rs",
    "src/lib_tests.rs",
    "src/main.rs",
])

rust_library(
    name = "dx_js_launcher",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "javascript/private/quality/dx_js_launcher",
        normal = True,
    ),
    crate_name = "dx_js_launcher",
    crate_root = "src/lib.rs",
    deps = ["//cli/path:dx_path"],
)

rust_binary(
    name = "js_launcher",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "javascript/private/quality/dx_js_launcher",
        normal = True,
    ),
    crate_name = "js_launcher",
    crate_root = "src/main.rs",
    deps = all_crate_deps(
        package_name = "javascript/private/quality/dx_js_launcher",
        normal = True,
    ) + [":dx_js_launcher"],
)

rust_test(
    name = "dx_js_launcher_test",
    srcs = [
        "src/lib.rs",
        "src/lib_tests.rs",
    ],
    aliases = aliases(
        package_name = "javascript/private/quality/dx_js_launcher",
        normal = True,
        normal_dev = True,
    ),
    coverage_lib = ":dx_js_launcher",
    crate_name = "dx_js_launcher",
    crate_root = "src/lib.rs",
    data = [
        ":js_launcher",
    ],
    env = {
        "DX_JS_LAUNCHER": "$(rootpath :js_launcher)",
    },
    deps = ["//cli/path:dx_path"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
