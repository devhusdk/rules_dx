load("@aspect_rules_js//js:defs.bzl", "js_test")
load("//core/modules:versions.bzl", "NODE_VERSION_PREFIX")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")
load("//tools/ide:ide_acquisition.bzl", "ide_acquisition_test")
load(":defs_tests.bzl", "javascript_wrapper_contract_tests")
load(":dev_hub_tests.bzl", "dev_hub_tests")

# gazelle:exclude graphql_eslint_config_test.mjs
# gazelle:exclude mdx_tsc_test.mjs

package(default_visibility = ["//visibility:private"])

exports_files(["defs_tests.bzl"])

javascript_wrapper_contract_tests(name = "wrapper_contract_tests")

dev_hub_tests(
    name = "dev_hub_test",
    size = "small",
)

ide_acquisition_test(
    name = "ide_acquisition_test",
    size = "small",
    binary = "//javascript/private/ide:node_tool",
    expected = NODE_VERSION_PREFIX,
    version_args = ["--version"],
)

js_test(
    name = "graphql_eslint_config_test",
    size = "small",
    data = ["//javascript/private/quality/bin:graphql_eslint_mjs"],
    entry_point = "graphql_eslint_config_test.mjs",
)

js_test(
    name = "mdx_tsc_test",
    size = "small",
    data = [
        "//javascript/private/quality:node_modules/@mdx-js/language-service",
        "//javascript/private/quality:node_modules/@mdx-js/mdx",
        "//javascript/private/quality:node_modules/@volar/typescript",
        "//javascript/private/quality:node_modules/remark-frontmatter",
        "//javascript/private/quality:node_modules/remark-gfm",
        "//javascript/private/quality:node_modules/typescript",
        "//javascript/private/quality/bin:mdx_tsc_mjs",
    ],
    entry_point = "mdx_tsc_test.mjs",
)

rust_test(
    name = "js_launcher_test",
    size = "small",
    srcs = ["js_launcher_test.rs"],
    data = ["//javascript/private/quality/launcher:js_launcher"],
    env = {"DX_JS_LAUNCHER": "$(rootpath //javascript/private/quality/launcher:js_launcher)"},
    deps = ["//javascript/private/quality/launcher:dx_js_launcher"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "dev_hub_tests.bzl",
        "defs_tests.bzl",
    ],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)
