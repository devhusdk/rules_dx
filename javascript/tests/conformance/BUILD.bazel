# gazelle:ignore
# Why: gazelle replaces the pass/fail subject tests and fixtures with per-file targets.
load("//javascript:defs.bzl", "javascript_binary", "javascript_library", "javascript_test")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "subject_compatible_with")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

javascript_library(
    name = "conformance",
    srcs = ["greet.js"],
)

javascript_library(
    name = "lint_dirty",
    srcs = ["lint_dirty.js"],
)

javascript_library(
    name = "format_dirty",
    srcs = ["format_dirty.js"],
)

javascript_library(
    name = "jest_config",
    srcs = ["jest.config.cjs"],
)

javascript_binary(
    name = "hello",
    srcs = ["main.js"],
    data = [
        ":conformance",
        "//:package_json",
    ],
    main = "main.js",
)

javascript_binary(
    name = "lock_hello",
    srcs = ["lock_main.js"],
    data = [
        "//:node_modules/clsx",
        "//:package_json",
    ],
    main = "lock_main.js",
)

javascript_binary(
    name = "runfiles_hello",
    srcs = ["runfiles_main.js"],
    data = [
        "data.txt",
        "//:package_json",
    ],
    main = "runfiles_main.js",
)

javascript_test(
    name = "pass_subject_test",
    srcs = ["pass_test.js"],
    config = "jest.config.cjs",
    data = [
        ":conformance",
        ":jest_config",
    ],
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
    package_json = "//:package_json",
    size = "small",
    target_compatible_with = subject_compatible_with(),
)

javascript_test(
    name = "fail_subject_test",
    srcs = ["fail_test.js"],
    config = "jest.config.cjs",
    data = [
        ":conformance",
        ":jest_config",
    ],
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
    package_json = "//:package_json",
    size = "small",
    target_compatible_with = subject_compatible_with(),
)

dx_conformance_suite(
    name = "",
    binary = ":hello",
    covered_source = "greet.js",
    cross_runfile = "node",
    expected = "hello world",
    failing_case = "failing case",
    failing_pattern = "{case} (",
    failing_test = ":fail_subject_test",
    lang = "javascript",
    lock = {
        "binary": ":lock_hello",
        "ecosystem": "js",
        "expected": "hello lock",
        "lockfile": "//:pnpm-lock.yaml",
        "manifest": "//:package.json",
        "package": "clsx",
        "stale": "pnpm-lock.stale.yaml",
    },
    passing_test = ":pass_subject_test",
    quality = {
        "clean": ":conformance",
        "format_dirty": ":format_dirty",
        "format_source": "format_dirty.js",
        "lint_dirty": ":lint_dirty",
        "lint_line": 2,
        "lint_rule": "lint/correctness/noUnusedVariables",
        "lint_source": "lint_dirty.js",
    },
    runfiles = {
        "binary": ":runfiles_hello",
        "data": "data.txt",
        "expected": "hello runfiles",
    },
    size = "small",
)
