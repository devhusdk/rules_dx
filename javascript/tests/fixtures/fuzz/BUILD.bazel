load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//core:fuzz_bench_tests.bzl", "dx_runner_attr_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//javascript:defs.bzl", "javascript_fuzz_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

javascript_fuzz_test(
    name = "parse_fuzz",
    srcs = ["parse_fuzz.cjs"],
    node_modules = "//:node_modules",
)

sh_test(
    name = "parse_fuzz_run_test",
    timeout = "short",
    srcs = ["run_test.sh"],
    args = [
        "$(rlocationpath //cli/runtime:dx_runtime)",
        "$(rootpath :parse_fuzz)",
        "$(rootpath corpus/planted)",
    ],
    data = [
        "corpus/planted",
        ":parse_fuzz",
        "//cli/runtime:dx_runtime",
    ],
    env = {"DX_RUNTIME_TOOL": "fuzz_run"},
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

dx_runner_attr_test(
    name = "parse_fuzz_attrs",
    expected = {"tags": ["dx-fuzz"]},
    runner = "parse_fuzz",
)

dx_runner_attr_test(
    name = "parse_fuzz_run_attrs",
    expected = {"args": [
        "libfuzzer",
        "$(rootpath :parse_fuzz)",
    ]},
    runner = "parse_fuzz_run",
)
