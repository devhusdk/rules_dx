load("//javascript:defs.bzl", "javascript_library", "javascript_test")
load("//javascript/tests:defs_tests.bzl", "javascript_run_environment_tests")
load("//core/quality:fixtures.bzl", "real_source_target")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

javascript_library(
    name = "hello_lib",
    srcs = ["hello.js"],
)

javascript_test(
    name = "plain_test",
    runner = "node",
    srcs = ["plain_test.js"],
    data = [":hello_lib"],
    main = "plain_test.js",
)

javascript_test(
    name = "env_forward_test",
    runner = "node",
    srcs = ["plain_test.js"],
    main = "plain_test.js",
    data = [":hello_lib"],
    env = {"FOO": "1"},
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

javascript_run_environment_tests(
    name = "run_environment_forward_test",
    target_under_test = ":env_forward_test",
)
