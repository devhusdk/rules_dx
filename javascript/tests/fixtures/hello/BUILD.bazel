load("//javascript/rules:defs.bzl", "javascript_binary", "javascript_library", "javascript_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//tools/sh:harness.bzl", "dx_shell_harness")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

javascript_library(
    name = "hello_lib",
    srcs = ["hello.js"],
    aspect_hints = ["//:biome_config"],
)

javascript_binary(
    name = "hello",
    data = [":hello_lib"],
    entry_point = "main.js",
)

javascript_test(
    name = "hello_test",
    srcs = ["hello.test.js"],
    data = [":hello_lib"],
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
)

dx_shell_harness(
    name = "hello_output_test",
    srcs = ["hello_output_test.sh"],
    args = ["$(rootpath :hello)"],
    data = [
        ":hello",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
