load("//javascript/rules:defs.bzl", "javascript_binary", "javascript_js_test", "javascript_library", "javascript_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//tools/testing:hello_output.bzl", "dx_hello_output_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

javascript_library(
    name = "hello_lib",
    srcs = ["hello.js"],
    aspect_hints = ["//:biome_config"],
)

javascript_binary(
    name = "hello",
    data = [":hello_lib"],
    entry_point = "main.js",
)

javascript_test(
    name = "hello_test",
    srcs = ["hello.test.js"],
    aspect_hints = ["//:biome_config"],
    data = [":hello_lib"],
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
)

dx_hello_output_test(
    name = "hello_output_test",
    binary = ":hello",
    expected = "hello world",
)

javascript_js_test(
    name = "plain_test",
    srcs = ["plain_test.js"],
    aspect_hints = ["//:biome_config"],
    data = [":hello_lib"],
    entry_point = "plain_test.js",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
