load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//javascript/rules:defs.bzl", "javascript_binary", "javascript_js_test")
load("//libs/starlark:defs.bzl", "starlark_test")
load("//libs/starlark:tag_probe.bzl", "tag_subject")
load("//quality:fixtures.bzl", "real_source_target")
load("//typescript/rules:defs.bzl", "typescript_js_test", "typescript_project")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

javascript_binary(
    name = "tagged_bin",
    data = ["shared.js"],
    entry_point = "main.js",
    tags = ["no-typecheck"],
)

javascript_js_test(
    name = "plain_test",
    srcs = ["plain_test.js"],
    aspect_hints = ["//:biome_config"],
    data = ["shared.js"],
    entry_point = "plain_test.js",
)

typescript_project(
    name = "decls",
    testonly = True,
    declaration = True,
    declaration_srcs = ["shared.d.ts"],
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
)

typescript_js_test(
    name = "tagged_ts_test",
    srcs = ["user.ts"],
    aspect_hints = ["//:biome_config"],
    declaration = True,
    declaration_srcs = ["shared.d.ts"],
    entry_point = "user.js",
    tags = ["no-typecheck"],
    tsconfig = "tsconfig.json",
)

build_test(
    name = "skip_tags_build_test",
    targets = [
        ":decls",
        ":plain_test",
        ":tagged_bin",
        ":tagged_ts_test",
    ],
)

tag_subject(
    name = "tags_subject",
    testonly = True,
    targets = [
        ":tagged_bin",
        ":tagged_bin_upstream",
        ":tagged_ts_test_ts",
        ":tagged_ts_test_upstream",
    ],
)

starlark_test(
    name = "tags_test",
    expected_observations = """subject //javascript/tests/fixtures/skip_tags:tags_subject
field tagged_bin=no-typecheck
field tagged_bin_upstream=dx:no-typecheck
field tagged_ts_test_ts=dx:no-typecheck
field tagged_ts_test_upstream=dx:no-typecheck,manual
aspect_field aspect_seen=True
aspect_field field_count=4
aspect_field has_subject=True
aspect_field subject_label=//javascript/tests/fixtures/skip_tags:tags_subject
aspect_field transitive_count=0
""",
    mode = "analysis",
    subjects = [":tags_subject"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
