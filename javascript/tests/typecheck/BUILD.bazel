load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//javascript/private/quality:tsc_report.bzl", "tsc_report")

package(
    default_testonly = True,
    default_visibility = ["//visibility:private"],
)

js_library(
    name = "tier",
    srcs = ["implicit_any.js"],
)

js_library(
    name = "loose",
    srcs = [
        "implicit_any.js",
        "tsconfig.json",
    ],
)

js_library(
    name = "mixed",
    srcs = [
        "bad.vue",
        "lib.js",
        "page.mdx",
    ],
    deps = ["//:node_modules/vue"],
)

[
    tsc_report(
        name = "%s_%s_report" % (case, kind),
        kind = kind,
        target = ":" + case,
    )
    for case in ["tier", "loose", "mixed"]
    for kind in ["stdout", "exit"]
]

[
    diff_test(
        name = "%s_%s_test" % (case, kind),
        file1 = "%s.%s.expected" % (case, kind),
        file2 = ":%s_%s_report" % (case, kind),
    )
    for case in ["tier", "loose", "mixed"]
    for kind in ["stdout", "exit"]
]

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//:__pkg__"],
)
