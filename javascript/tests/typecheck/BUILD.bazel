# gazelle:ignore
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//typescript/private/quality:tsc_report.bzl", "tsc_report", "tsc_stdout_test")

package(
    default_testonly = True,
    default_visibility = ["//visibility:private"],
)

js_library(
    name = "tier",
    srcs = ["implicit_any.js"],
)

js_library(
    name = "loose",
    srcs = [
        "implicit_any.js",
        "tsconfig.json",
    ],
)

js_library(
    name = "mixed",
    srcs = [
        "bad.vue",
        "lib.js",
        "page.mdx",
    ],
    deps = ["//:node_modules/vue"],
)

[
    tsc_report(
        name = "%s_%s_report" % (case, kind),
        kind = kind,
        target = ":" + case,
    )
    for case in ["tier", "loose"]
    for kind in ["stdout", "exit"]
]

[
    tsc_report(
        name = "mixed_%s_%s_report" % (checker, kind),
        index = index,
        kind = kind,
        target = ":mixed",
    )
    for index, checker in enumerate(["vue", "mdx"])
    for kind in ["stdout", "exit"]
]

[
    diff_test(
        name = "%s_exit_test" % case,
        file1 = "%s.exit.expected" % case,
        file2 = ":%s_exit_report" % case,
        size = "small",
    )
    for case in ["tier", "loose"]
]

[
    diff_test(
        name = "mixed_%s_exit_test" % checker,
        file1 = "mixed.exit.expected",
        file2 = ":mixed_%s_exit_report" % checker,
        size = "small",
    )
    for checker in ["vue", "mdx"]
]

[
    tsc_stdout_test(
        name = "%s_stdout_test" % case,
        diagnostics = {
            "tier": """implicit_any.js(1,26): error TS7006: Parameter 'value' implicitly has an 'any' type.
""",
        }.get(case, ""),
        expected = "%s.stdout.expected" % case,
        report = ":%s_stdout_report" % case,
    )
    for case in ["tier", "loose"]
]

tsc_stdout_test(
    name = "mixed_vue_stdout_test",
    diagnostics = """bad.vue(2,18): error TS2305: Module '"./lib.js"' has no exported member 'missing'.
bad.vue(4,28): error TS2345: Argument of type 'string' is not assignable to parameter of type 'number'.
""",
    expected = "mixed.stdout.expected",
    report = ":mixed_vue_stdout_report",
    size = "small",
)

tsc_stdout_test(
    name = "mixed_mdx_stdout_test",
    diagnostics = """page.mdx(1,18): error TS2305: Module '"./lib.js"' has no exported member 'missing'.
page.mdx(3,27): error TS2345: Argument of type 'string' is not assignable to parameter of type 'number'.
page.mdx(7,20): error TS2345: Argument of type 'string' is not assignable to parameter of type 'number'.
""",
    expected = "mixed.stdout.expected",
    report = ":mixed_mdx_stdout_report",
    size = "small",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//:__pkg__"],
)
