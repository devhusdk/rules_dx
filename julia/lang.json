{
  "$schema": "../core/modules/lang.schema.json",
  "name": "julia",
  "title": "Julia",
  "family": "core",
  "ecosystems": [
    "julia"
  ],
  "depcheck": "julia",
  "semver": false,
  "manifests": [
    "Project.toml"
  ],
  "lockfiles": [
    "Manifest.toml"
  ],
  "tools": [
    "julia_format",
    "julialint"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_x86_64"
  ],
  "pins": [],
  "entry_points": [
    "julia_library",
    "julia_binary",
    "julia_test",
    "julia_standalone_binary"
  ],
  "quality": {
    "bzl": "quality:families/julia.bzl",
    "file_extensions": [
      ".jl"
    ],
    "aspects": {
      "format": [
        "real_julia_format_aspect"
      ],
      "lint": [
        "real_julia_lint_aspect"
      ],
      "typecheck": [
        "real_julia_typecheck_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_julia_format_probe_aspect"
      ],
      "lint": [
        "real_julia_lint_probe_aspect"
      ],
      "typecheck": [
        "real_julia_typecheck_probe_aspect"
      ]
    }
  },
  "docs": {
    "bzl": "tools/docs/julia:aspect.bzl",
    "file_extensions": [
      ".jl"
    ],
    "aspects": [
      "real_julia_docs_aspect"
    ]
  }
}
