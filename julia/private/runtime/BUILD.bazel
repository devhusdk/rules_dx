load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@dx_pins_data//:pins.bzl", "ARCHIVES")
load("@dx_prebuilt//:downloads.bzl", "DOWNLOADED")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//cc/private/toolchain:select.bzl", "cc_toolchain_files")
load("//core/modules:versions.bzl", "JULIA_RUNTIME_VERSION")
load("//core/private/testing:defs.bzl", "expect_equal", "starlark_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")
load(":defs.bzl", "julia_runtime_files", "julia_shipped_libs", "julia_source_toolchain", "source_exec_compatible_with")

package(default_visibility = ["//julia:__subpackages__"])

_LINUX_X86_64 = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

exports_files(glob(["*.BUILD.bazel"]))

_MAJOR_MINOR = ".".join(JULIA_RUNTIME_VERSION.split(".")[:2])

_LIBJULIA_INTERNAL = "libjulia-internal.so." + JULIA_RUNTIME_VERSION

# Set by the runtime rules so they resolve the downloaded Julia release, not :source_toolchain.
bool_flag(
    name = "stock",
    build_setting_default = False,
)

config_setting(
    name = "source_runtime",
    flag_values = {":stock": "false"},
)

julia_runtime_files(
    name = "julia_runtime_files",
)

julia_source_toolchain(
    name = "source_julia",
    library = "@dx_prebuilt//:julia_internal",
    target_compatible_with = _LINUX_X86_64,
)

# On Linux x86_64 every Julia action and binary runs on the source-built libjulia-internal.
toolchain(
    name = "source_toolchain",
    # A downloaded libjulia-internal serves any exec host; the source build needs the linux x86_64 gcc (#14377).
    exec_compatible_with = source_exec_compatible_with(DOWNLOADED, _LINUX_X86_64),
    target_compatible_with = _LINUX_X86_64,
    target_settings = [
        "//config:toolchains_on",
        ":source_runtime",
        "@rules_julia//julia/settings:version_" + JULIA_RUNTIME_VERSION,
    ],
    toolchain = ":source_julia",
    toolchain_type = "@rules_julia//julia:toolchain_type",
)

starlark_test(
    name = "julia_src_version_test",
    size = "small",
    checks = [
        expect_equal(
            "julia runtime source follows canonical",
            ARCHIVES["julia_src"]["strip_prefix"],
            "julia-" + JULIA_RUNTIME_VERSION,
        ),
    ],
    mode = "unit",
)

starlark_test(
    name = "source_toolchain_exec_test",
    size = "small",
    checks = [
        expect_equal(
            "a downloaded julia_internal leaves the exec platform open",
            source_exec_compatible_with({"julia_internal": ["linux_x86_64"]}, _LINUX_X86_64),
            [],
        ),
        expect_equal(
            "with no downloads the source build needs linux x86_64",
            source_exec_compatible_with({}, _LINUX_X86_64),
            _LINUX_X86_64,
        ),
        expect_equal(
            "another tool's download keeps the constraint",
            source_exec_compatible_with({"pcov": ["linux_x86_64"]}, _LINUX_X86_64),
            _LINUX_X86_64,
        ),
    ],
    mode = "unit",
)

julia_shipped_libs(
    name = "shipped_libs",
    libraries = [
        "libjulia.so." + _MAJOR_MINOR,
        "libunwind.so.8",
        "libz.so.1",
        "libzstd.so.1",
        "libatomic.so.1",
    ],
    target_compatible_with = _LINUX_X86_64,
)

cc_binary(
    name = _LIBJULIA_INTERNAL,
    additional_linker_inputs = ["@julia_src//:julia_expmap"],
    linkopts = [
        "-Wl,--version-script=$(execpath @julia_src//:julia_expmap)",
        "-Wl,-soname,libjulia-internal.so." + _MAJOR_MINOR,
        "-Wl,-Bsymbolic-functions",
        "-Wl,--enable-new-dtags",
        "-Wl,-z,noexecstack",
        "-Wl,--gc-sections",
        "-Wl,-rpath,$$ORIGIN",
        "-Wl,-rpath,$$ORIGIN/..",
        "-Wl,--no-as-needed",
        "-ldl",
        "-lrt",
        "-lpthread",
        "-lm",
    ],
    linkshared = True,
    target_compatible_with = _LINUX_X86_64,
    deps = [
        ":shipped_libs",
        "@julia_src//:libjulia_internal_objects",
    ],
)

cc_toolchain_files(
    name = "libjulia_internal",
    srcs = [":" + _LIBJULIA_INTERNAL],
    compiler = "gcc",
    platforms = ["//tools/platforms:linux_x86_64"],
    target_compatible_with = _LINUX_X86_64,
    visibility = [
        "//julia:__subpackages__",
        "@dx_prebuilt//:__pkg__",
    ],
)

rust_test(
    name = "libjulia_internal_test",
    size = "small",
    srcs = ["libjulia_internal_test.rs"],
    data = [
        ":julia_runtime_files",
        ":libjulia_internal",
        "@rules_julia//julia:current_julia_toolchain",
    ],
    env = {
        "DX_JULIA": "$(rootpath :julia_runtime_files)",
        "DX_LIBJULIA_INTERNAL": "$(rootpaths :libjulia_internal)",
        "DX_TOOLCHAIN_JULIA": "$(JULIA_RLOCATIONPATH)",
    },
    target_compatible_with = _LINUX_X86_64,
    toolchains = ["@rules_julia//julia:current_julia_toolchain"],
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing:dx_testing",
        "@crates//:object",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "julia_src.BUILD.bazel",
        "libllvm.BUILD.bazel",
        "libunwind.BUILD.bazel",
        "libuv.BUILD.bazel",
        "utf8proc.BUILD.bazel",
        "zstd.BUILD.bazel",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
