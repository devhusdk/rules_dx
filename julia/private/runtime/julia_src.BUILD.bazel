load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(["LICENSE.md"])

config_setting(
    name = "gcc",
    flag_values = {"@rules_dx//cc:compiler": "gcc"},
)

_CPPFLAGS = [
    "-DJULIA_HAS_IFUNC_SUPPORT=1",
    "-DJULIA_NUM_THREADS=1",
    "-DJL_USE_INTEL_JITEVENTS",
    "-DJL_USE_PERF_JITEVENTS",
]

_C_SHIPFLAGS = _CPPFLAGS + [
    "-std=gnu11",
    "-O3",
    "-march=x86-64",
    "-mtune=generic",
    "-fasynchronous-unwind-tables",
    "-fno-strict-aliasing",
    "-falign-functions",
    "-fvisibility=hidden",
    "-ffunction-sections",
    "-fdata-sections",
    "-D_FILE_OFFSET_BITS=64",
    "-DNDEBUG",
    "-DJL_NDEBUG",
] + select({
    ":gcc": [
        "-fno-tree-tail-merge",
        "-fno-gnu-unique",
    ],
    "//conditions:default": [],
})

_WARNINGS = [
    "-Wall",
    "-Wno-strict-aliasing",
    "-Wpointer-arith",
    "-Wundef",
]

genrule(
    name = "julia_version_h",
    srcs = ["VERSION"],
    outs = ["gen/julia_version.h"],
    cmd = """v=$$(cat $<)
{
  echo '// This is an autogenerated header file'
  echo '#ifndef JL_VERSION_H'
  echo '#define JL_VERSION_H'
  echo "#define JULIA_VERSION_STRING \\"$$v\\""
  echo "$$v" | awk 'BEGIN {FS="[.,+-]"} {print "#define JULIA_VERSION_MAJOR " $$1 "\\n#define JULIA_VERSION_MINOR " $$2 "\\n#define JULIA_VERSION_PATCH " $$3; if (NF<4) print "#define JULIA_VERSION_IS_RELEASE 1"; else print "#define JULIA_VERSION_IS_RELEASE 0"}'
  echo '#endif'
} > $@""",
)

genrule(
    name = "jl_internal_funcs",
    srcs = ["src/jl_exported_funcs.inc"],
    outs = ["gen/jl_internal_funcs.inc"],
    cmd = "grep 'XX(..*)' $< | sed -E 's/.*XX\\((.+)\\).*/#define \\1 i\\1/g' > $@",
)

genrule(
    name = "jl_data_globals_defs",
    srcs = ["src/jl_exported_data.inc"],
    outs = ["gen/jl_data_globals_defs.inc"],
    cmd = """{
  grep 'XX(.*)' $< | sed -E 's/.*XX\\(([^,]+), .*\\).*/#define jl_\\1 (sysimg_global.\\1)/g'
  grep 'YY(.*)' $< | sed -E 's/.*YY\\(([^,]+), .*\\).*/#define jl_\\1 (const_globals.jl\\1)/g'
} > $@""",
)

genrule(
    name = "julia_expmap",
    srcs = [
        "VERSION",
        "src/julia.expmap.in",
    ],
    outs = ["julia.expmap"],
    cmd = "v=$$(cut -d. -f1,2 $(execpath VERSION)) && sed -e \"s/@JULIA_SHLIB_SYMBOL_VERSION@/JL_LIBJULIA_$$v/\" -e 's/@LLVM_SHLIB_SYMBOL_VERSION@/JL_LLVM_20.1/' $(execpath src/julia.expmap.in) > $@",
)

cc_library(
    name = "support",
    srcs = glob(
        ["src/support/*.c"],
        exclude = [
            "src/support/asprintf.c",
            "src/support/strptime.c",
            "src/support/MurmurHash3.c",
        ],
    ),
    hdrs = glob(["src/support/*.h"]),
    copts = _C_SHIPFLAGS + _WARNINGS + [
        "-fPIC",
        "-DJL_LIBRARY_EXPORTS_INTERNAL",
        "-DUTF8PROC_EXPORTS",
    ],
    includes = ["src/support"],
    textual_hdrs = glob(["src/support/*.inc"]) + ["src/support/MurmurHash3.c"],
    deps = [
        "@julia_src_libuv//:headers",
        "@julia_src_utf8proc//:utf8proc",
    ],
    alwayslink = True,
)

_FLISP_SRCS = [
    "src/flisp/flisp.c",
    "src/flisp/builtins.c",
    "src/flisp/string.c",
    "src/flisp/equalhash.c",
    "src/flisp/table.c",
    "src/flisp/iostream.c",
    "src/flisp/julia_extensions.c",
]

cc_library(
    name = "flisp_lib",
    srcs = _FLISP_SRCS,
    hdrs = glob(["src/flisp/*.h"]),
    copts = _C_SHIPFLAGS + _WARNINGS + [
        "-fPIC",
        "-DJL_LIBRARY_EXPORTS_INTERNAL",
        "-DUTF8PROC_EXPORTS",
        "-DUSE_COMPUTED_GOTO",
    ],
    includes = ["src/flisp"],
    textual_hdrs = glob(
        ["src/flisp/*.c"],
        exclude = _FLISP_SRCS + ["src/flisp/flmain.c"],
    ),
    deps = [":support"],
    alwayslink = True,
)

cc_binary(
    name = "flisp",
    srcs = ["src/flisp/flmain.c"],
    copts = _C_SHIPFLAGS + ["-DUSE_COMPUTED_GOTO"],
    linkopts = [
        "-lpthread",
        "-ldl",
        "-lm",
    ],
    deps = [
        ":flisp_lib",
        "@julia_src_libuv//:libuv",
    ],
)

_FLISP_RUN = "d=$$(mktemp -d) && cp $(execpath :flisp) $$d/flisp && cp $(execpath src/flisp/flisp.boot) $$d/flisp.boot && "

genrule(
    name = "julia_flisp_boot",
    srcs = [
        "src/flisp/flisp.boot",
        "src/jlfrontend.scm",
        "src/flisp/aliases.scm",
        "src/flisp/profile.scm",
        "src/julia-parser.scm",
        "src/julia-syntax.scm",
        "src/match.scm",
        "src/utils.scm",
        "src/ast.scm",
        "src/macroexpand.scm",
        "src/mk_julia_flisp_boot.scm",
    ],
    outs = ["gen/julia_flisp.boot"],
    cmd = _FLISP_RUN + "$$d/flisp $(execpath src/mk_julia_flisp_boot.scm) $$(dirname $(execpath src/jlfrontend.scm)) jlfrontend.scm $$PWD/$@ && rm -rf $$d",
    tools = [":flisp"],
)

genrule(
    name = "julia_flisp_boot_inc",
    srcs = [
        "src/flisp/flisp.boot",
        "src/bin2hex.scm",
        ":julia_flisp_boot",
    ],
    outs = ["gen/julia_flisp.boot.inc"],
    cmd = _FLISP_RUN + "$$d/flisp $(execpath src/bin2hex.scm) < $(execpath :julia_flisp_boot) > $@ && rm -rf $$d",
    tools = [":flisp"],
)

_RUNTIME_SRCS = [
    "jltypes",
    "gf",
    "typemap",
    "smallintset",
    "ast",
    "builtins",
    "module",
    "interpreter",
    "symbol",
    "dlload",
    "sys",
    "init",
    "task",
    "array",
    "genericmemory",
    "staticdata",
    "toplevel",
    "jl_uv",
    "datatype",
    "simplevector",
    "runtime_intrinsics",
    "precompile",
    "jloptions",
    "mtarraylist",
    "threading",
    "scheduler",
    "stackwalk",
    "null_sysimage",
    "method",
    "jlapi",
    "signal-handling",
    "safepoint",
    "timing",
    "subtype",
    "rtutils",
    "crc32c",
    "ircode",
    "opaque_closure",
    "codegen-stubs",
    "gc-common",
    "gc-stacks",
    "gc-stock",
    "gc-debug",
    "gc-pages",
    "gc-page-profiler",
]

_RUNTIME_CXX_SRCS = [
    "APInt-C",
    "processor",
    "coverage",
    "runtime_ccall",
    "engine",
    "gc-alloc-profiler",
    "gc-heap-snapshot",
]

_RUNTIME_FLAGS = [
    "-fno-omit-frame-pointer",
    "-fno-common",
    "-Wno-comment",
    "-D_GNU_SOURCE",
    "-DJL_BUILD_ARCH='\"x86_64\"'",
    "-DJL_BUILD_UNAME='\"Linux\"'",
    "-DJL_SYSTEM_IMAGE_PATH='\"../lib/julia/sys.so\"'",
    "-DJL_LIBJULIA_SONAME='\"libjulia.so.1\"'",
    "-DLLVM_SHLIB",
    "-DJL_LIBRARY_EXPORTS_INTERNAL",
    "-fPIC",
]

cc_library(
    name = "runtime_headers",
    hdrs = glob([
        "src/*.h",
        "src/*.inc",
        "src/*.c",
        "deps/valgrind/*.h",
    ]) + [
        ":jl_data_globals_defs",
        ":jl_internal_funcs",
        ":julia_flisp_boot_inc",
        ":julia_version_h",
    ],
    includes = [
        "deps/valgrind",
        "gen",
        "src",
    ],
    textual_hdrs = glob(["src/processor_*.cpp"]),
)

cc_library(
    name = "runtime_c",
    srcs = ["src/{}.c".format(s) for s in _RUNTIME_SRCS],
    copts = _C_SHIPFLAGS + _WARNINGS + _RUNTIME_FLAGS + [
        "-Wold-style-definition",
        "-Wstrict-prototypes",
        "-Wc++-compat",
        "-Wno-unused-result",
    ],
    deps = [
        ":flisp_lib",
        ":runtime_headers",
        ":support",
        "@julia_src_libllvm//:headers",
        "@julia_src_libunwind//:headers",
        "@julia_src_libuv//:headers",
        "@julia_src_zstd//:headers",
    ],
    alwayslink = True,
)

cc_library(
    name = "runtime_cxx",
    srcs = ["src/{}.cpp".format(s) for s in _RUNTIME_CXX_SRCS],
    copts = _CPPFLAGS + [
        "-std=c++17",
        "-O3",
        "-march=x86-64",
        "-mtune=generic",
        "-fno-exceptions",
        "-funwind-tables",
        "-fasynchronous-unwind-tables",
        "-fno-rtti",
        "-fno-strict-aliasing",
        "-falign-functions",
        "-fvisibility=hidden",
        "-ffunction-sections",
        "-fdata-sections",
        "-pedantic",
        "-D__STDC_CONSTANT_MACROS",
        "-D__STDC_FORMAT_MACROS",
        "-D__STDC_LIMIT_MACROS",
        "-DNDEBUG",
        "-DJL_NDEBUG",
        "-Wformat",
        "-Wformat-security",
        "-Wno-unused-result",
    ] + _WARNINGS + _RUNTIME_FLAGS,
    deps = [
        ":runtime_headers",
        ":support",
        "@julia_src_libllvm//:headers",
        "@julia_src_libunwind//:headers",
        "@julia_src_libuv//:headers",
    ],
    alwayslink = True,
)

cc_library(
    name = "libjulia_internal_objects",
    deps = [
        ":flisp_lib",
        ":runtime_c",
        ":runtime_cxx",
        ":support",
        "@julia_src_libllvm//:support",
        "@julia_src_libuv//:libuv",
        "@julia_src_utf8proc//:utf8proc",
    ],
)
