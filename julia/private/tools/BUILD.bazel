load("@crates//:crates.bzl", "aliases")
load("@rules_julia//julia:defs.bzl", "julia_binary")
load("@rules_julia//julia/pkg:julia_pkg_resolve.bzl", "julia_pkg_resolve")
load("@rules_julia//julia/pkg:julia_pkg_resolve_test.bzl", "julia_pkg_resolve_test")
load("//julia/private:defs.bzl", "JULIA_COMPATIBLE_WITH")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")
load(":julia_tool.bzl", "dx_julia_tool")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Manifest.bazel.json",
    "Manifest.toml",
    "Project.toml",
])

julia_binary(
    name = "format_bin",
    srcs = ["format.jl"],
    target_compatible_with = JULIA_COMPATIBLE_WITH,
    visibility = ["//visibility:private"],
    deps = [
        "@dx_julia_format//:JuliaFormatter",
        "@dx_julia_format//:JuliaSyntax",
    ],
)

dx_julia_tool(
    name = "julia_format",
    binary = ":format_bin",
    target_compatible_with = JULIA_COMPATIBLE_WITH,
)

julia_binary(
    name = "pkg_update_bin",
    srcs = ["pkg_update.jl"],
    target_compatible_with = JULIA_COMPATIBLE_WITH,
    visibility = ["//visibility:private"],
)

dx_julia_tool(
    name = "pkg_update",
    binary = ":pkg_update_bin",
    target_compatible_with = JULIA_COMPATIBLE_WITH,
)

julia_pkg_resolve(
    name = "resolve",
    manifest_bazel_json = "Manifest.bazel.json",
    manifests = {"Manifest.toml": "1.12"},
    project_toml = "Project.toml",
    target_compatible_with = JULIA_COMPATIBLE_WITH,
)

julia_pkg_resolve_test(
    name = "resolve_test",
    resolver = ":resolve",
    target_compatible_with = JULIA_COMPATIBLE_WITH,
)

rust_test(
    name = "format_cli_test",
    srcs = ["format_cli_test.rs"],
    aliases = aliases(
        package_name = "julia/private/julia_tools",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "format_cli_test",
    crate_root = "format_cli_test.rs",
    data = [":julia_format"],
    env = {"JULIA_FORMAT": "$(rootpath :julia_format)"},
    target_compatible_with = JULIA_COMPATIBLE_WITH,
    deps = ["//tools/testing:dx_testing"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "julia_tool.bzl",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = [
        "Manifest.toml",
        "Project.toml",
        "Cargo.toml",
    ],
)
