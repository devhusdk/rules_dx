load("@crates//:crates.bzl", "aliases")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_julia//julia:defs.bzl", "julia_binary")
load("@rules_julia//julia/pkg:julia_pkg_resolve.bzl", "julia_pkg_resolve")
load("@rules_julia//julia/pkg:julia_pkg_resolve_test.bzl", "julia_pkg_resolve_test")
load("//julia/private:defs.bzl", "JULIA_COMPATIBLE_WITH")
load("//julia/private/tools:julia_tool.bzl", "dx_julia_tool")
load("//rust:defs.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Manifest.bazel.json",
    "Manifest.toml",
    "Project.toml",
])

julia_binary(
    name = "jet_bin",
    srcs = ["jet.jl"],
    target_compatible_with = JULIA_COMPATIBLE_WITH,
    visibility = ["//visibility:private"],
    deps = ["@dx_julia_jet//:JET"],
)

dx_julia_tool(
    name = "jet",
    binary = ":jet_bin",
    target_compatible_with = JULIA_COMPATIBLE_WITH,
)

julia_pkg_resolve(
    name = "resolve",
    manifest_bazel_json = "Manifest.bazel.json",
    manifests = {"Manifest.toml": "1.12"},
    project_toml = "Project.toml",
    target_compatible_with = JULIA_COMPATIBLE_WITH,
)

julia_pkg_resolve_test(
    name = "resolve_test",
    resolver = ":resolve",
    target_compatible_with = JULIA_COMPATIBLE_WITH,
)

rust_test(
    name = "jet_cli_test",
    srcs = ["jet_cli_test.rs"],
    aliases = aliases(
        package_name = "julia/private/tools/julia_jet",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "jet_cli_test",
    crate_root = "jet_cli_test.rs",
    data = [
        "testdata/buggy.jl",
        "testdata/clean.jl",
        ":jet",
    ],
    env = {"JULIA_JET": "$(rootpath :jet)"},
    target_compatible_with = JULIA_COMPATIBLE_WITH,
    deps = ["//tools/testing:dx_testing"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = [
        "Manifest.toml",
        "Project.toml",
        "Cargo.toml",
    ],
)
