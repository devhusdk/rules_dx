load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@dx_pins_data//:pins.bzl", "ARCHIVES")
load("@rules_julia//julia/pkg:julia_pkg_resolve_test.bzl", "julia_pkg_resolve_test")
load("//core/modules:versions.bzl", "JULIA_RUNTIME_VERSION")
load("//core/private/testing:defs.bzl", "expect_equal", "starlark_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//julia/private:defs.bzl", "JULIA_COMPATIBLE_WITH")
load("//julia/private/runtime:defs.bzl", "source_exec_compatible_with")
load("//rust:defs.bzl", "rust_test")
load(":defs_tests.bzl", "julia_wrapper_contract_tests")
load(":resolved_toolchain.bzl", "resolved_source_julia_toolchain")

package(default_visibility = ["//visibility:private"])

_LINUX_X86_64 = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

_SOURCE_EXEC = ["@platforms//os:linux"]

exports_files([
    "precompile_tests.bzl",
    "defs_tests.bzl",
])

julia_wrapper_contract_tests(name = "wrapper_contract_tests")

julia_pkg_resolve_test(
    name = "coverage_resolve_test",
    size = "small",
    resolver = "//julia/private/coverage:resolve",
    target_compatible_with = JULIA_COMPATIBLE_WITH,
)

starlark_test(
    name = "julia_src_version_test",
    size = "small",
    checks = [
        expect_equal(
            "julia runtime source follows canonical",
            ARCHIVES["julia_src"]["strip_prefix"],
            "julia-" + JULIA_RUNTIME_VERSION,
        ),
    ],
    mode = "unit",
)

starlark_test(
    name = "source_toolchain_exec_test",
    size = "small",
    checks = [
        expect_equal(
            "a downloaded julia_internal leaves the exec platform open",
            source_exec_compatible_with(
                {"julia_internal": ["linux_x86_64"]},
                _SOURCE_EXEC,
            ),
            [],
        ),
        expect_equal(
            "with no downloads the source build needs a linux exec host",
            source_exec_compatible_with({}, _SOURCE_EXEC),
            ["@platforms//os:linux"],
        ),
        expect_equal(
            "another tool's download keeps the constraint",
            source_exec_compatible_with(
                {"pcov": ["linux_x86_64"]},
                _SOURCE_EXEC,
            ),
            ["@platforms//os:linux"],
        ),
    ],
    mode = "unit",
)

resolved_source_julia_toolchain(
    name = "source_toolchain_resolved",
    testonly = True,
    target_compatible_with = _LINUX_X86_64,
)

platform_transition_filegroup(
    name = "source_toolchain_linux_x86_64",
    testonly = True,
    srcs = [":source_toolchain_resolved"],
    target_platform = "//tools/platforms:linux_x86_64",
)

build_test(
    name = "source_toolchain_cross_test",
    size = "small",
    target_compatible_with = ["@platforms//os:linux"],
    targets = [":source_toolchain_linux_x86_64"],
)

rust_test(
    name = "libjulia_internal_test",
    size = "small",
    srcs = ["libjulia_internal_test.rs"],
    data = [
        "//julia/private/runtime:julia_runtime_files",
        "//julia/private/runtime:libjulia_internal",
        "@rules_julia//julia:current_julia_toolchain",
    ],
    env = {
        "DX_JULIA": "$(rootpath //julia/private/runtime:julia_runtime_files)",
        "DX_LIBJULIA_INTERNAL": "$(rootpaths //julia/private/runtime:libjulia_internal)",
        "DX_TOOLCHAIN_JULIA": "$(JULIA_RLOCATIONPATH)",
    },
    target_compatible_with = _LINUX_X86_64,
    toolchains = ["@rules_julia//julia:current_julia_toolchain"],
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing:dx_testing",
        "@crates//:object",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "precompile_tests.bzl",
        "defs_tests.bzl",
        "resolved_toolchain.bzl",
    ],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)
