load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//julia:defs.bzl", "julia_binary", "julia_library", "julia_test")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "subject_compatible_with")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

julia_library(
    name = "Greet",
    testonly = True,
    srcs = ["src/Greet.jl"],
    data = ["Project.toml"],
)

julia_library(
    name = "LintDirty",
    srcs = ["lint_dirty/LintDirty.jl"],
    tags = ["manual"],
)

julia_library(
    name = "FormatDirty",
    srcs = ["format_dirty/FormatDirty.jl"],
    tags = ["manual"],
)

julia_binary(
    name = "hello",
    srcs = ["main.jl"],
    data = ["data.txt"],
    deps = [":Greet"],
)

julia_test(
    name = "pass_subject_test",
    size = "small",
    srcs = ["pass_test.jl"],
    target_compatible_with = subject_compatible_with(),
    deps = [":Greet"],
)

julia_test(
    name = "fail_subject_test",
    size = "small",
    srcs = ["fail_test.jl"],
    target_compatible_with = subject_compatible_with(),
    deps = [":Greet"],
)

dx_conformance_suite(
    name = "",
    size = "small",
    binary = ":hello",
    covered_source = "Greet.jl",
    expected = "hello world",
    failing_case = "failing case",
    failing_pattern = "{case}: Test Failed",
    failing_test = ":fail_subject_test",
    lang = "julia",
    lock = {
        "binary": "//julia/tests/conformance/lock:lock_hello",
        "ecosystem": "julia",
        "expected": "hello lock",
        "lockfile": "//julia/tests/fixtures/julia-app/third_party:Manifest.toml",
        "manifest": "//julia/tests/fixtures/julia-app/third_party:Project.toml",
        "package": "OrderedCollections",
        "stale": "Manifest.stale.toml",
    },
    passing_test = ":pass_subject_test",
    quality = {
        "clean": ":Greet",
        "format_dirty": ":FormatDirty",
        "format_source": "format_dirty/FormatDirty.jl",
        "lint_dirty": ":LintDirty",
        "lint_line": 3,
        "lint_rule": "julialint/index_from_length",
        "lint_source": "lint_dirty/LintDirty.jl",
    },
    runfiles = {
        "binary": ":hello",
        "data": "data.txt",
        "expected": "hello runfiles",
    },
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    testonly = True,
    tags = ["corpus"],
    toml_srcs = [
        "Manifest.stale.toml",
        "Project.toml",
    ],
)
