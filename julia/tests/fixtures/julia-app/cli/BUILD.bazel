load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//julia:defs.bzl", "julia_binary", "julia_library", "julia_test")
load("@rules_dx//tools/testing:hello_output.bzl", "dx_hello_output_test")

package(default_visibility = ["//visibility:public"])

exports_files(glob([
    "*.jl",
    "src/*.jl",
]))

string_flag(
    name = "digits",
    build_setting_default = "2",
    values = [
        "2",
        "4",
    ],
)

config_setting(
    name = "four_digits",
    flag_values = {":digits": "4"},
)

# keep
julia_library(
    name = "Report",
    srcs = ["src/Report.jl"],
    data = ["Project.toml"],
    deps = [
        "//julia/tests/fixtures/julia-app/archive:Archive",
        "//julia/tests/fixtures/julia-app/stats:Stats",
    ],
)

julia_binary(
    name = "readings",
    srcs = ["main.jl"],
    data = ["//julia/tests/fixtures/julia-app/data:readings_csv"],
    env = select({
        ":four_digits": {"JULIA_APP_DIGITS": "4"},
        "//conditions:default": {"JULIA_APP_DIGITS": "2"},
    }),
    deps = [
        ":Report",
        "@rules_julia//julia/runfiles",
    ],
)

julia_test(
    name = "report_test",
    srcs = ["report_test.jl"],
    deps = [":Report"],
)

dx_hello_output_test(
    name = "cli_test",
    binary = ":readings",
    condition_env = {
        ":four_digits": {
            "DX_HELLO_EXPECTED": "readings: 8\nmean: 12.7188\nvariance: 19.1631\nmedian: 12.125\nbucket 5.0: 3\nbucket 10.0: 3\nbucket 15.0: 1\nbucket 20.0: 1\narchive: ok",
            "JULIA_APP_DIGITS": "4",
        },
    },
    expected = "readings: 8\nmean: 12.72\nvariance: 19.16\nmedian: 12.12\nbucket 5.0: 3\nbucket 10.0: 3\nbucket 15.0: 1\nbucket 20.0: 1\narchive: ok",
    size = "small",
)

# keep
real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    testonly = True,
    tags = ["corpus"],
    toml_srcs = ["Project.toml"],
)
