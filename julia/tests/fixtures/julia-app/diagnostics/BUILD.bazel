load("@rules_dx//julia:defs.bzl", "JULIA_COMPATIBLE_WITH")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust:defs.bzl", "rust_test")

package(default_visibility = ["//julia/tests/fixtures/julia-app:__subpackages__"])

_FORMATTED = [
    "clean.jl",
    "//julia/tests/fixtures/julia-app/archive:archive_test.jl",
    "//julia/tests/fixtures/julia-app/archive:src/Archive.jl",
    "//julia/tests/fixtures/julia-app/cli:cli_test.jl",
    "//julia/tests/fixtures/julia-app/cli:main.jl",
    "//julia/tests/fixtures/julia-app/cli:report_test.jl",
    "//julia/tests/fixtures/julia-app/cli:src/Report.jl",
    "//julia/tests/fixtures/julia-app/stats:src/Stats.jl",
    "//julia/tests/fixtures/julia-app/stats:stats_test.jl",
]

# rust_test does not expand toolchain make variables in env, so a genrule writes the path.
genrule(
    name = "julia_rlocationpath",
    outs = ["julia_rlocationpath.txt"],
    cmd = "printf '%s' '$(JULIA_RLOCATIONPATH)' > $@",
    target_compatible_with = JULIA_COMPATIBLE_WITH,
    toolchains = ["@rules_julia//julia:current_julia_toolchain"],
)

rust_test(
    name = "diagnostics_test",
    srcs = ["diagnostics_test.rs"],
    data = [
        "clean.jl",
        "julia_rlocationpath.txt",
        "missing_dep.jl",
        "runtime_error.jl",
        "syntax_error.jl",
        "unformatted.jl",
        "@rules_dx//julia/private/tools:julia_format",
        "@rules_julia//julia:current_julia_toolchain",
    ] + _FORMATTED[1:],
    env = {
        "DX_CLEAN": "$(rootpath clean.jl)",
        "DX_FORMAT": "$(rootpath @rules_dx//julia/private/tools:julia_format)",
        "DX_FORMAT_SRCS": " ".join(["$(rootpath %s)" % src for src in _FORMATTED]),
        "DX_JULIA_PATH_FILE": "$(rootpath julia_rlocationpath.txt)",
        "DX_MISSING_DEP": "$(rootpath missing_dep.jl)",
        "DX_RUNTIME": "$(rootpath runtime_error.jl)",
        "DX_SYNTAX": "$(rootpath syntax_error.jl)",
        "DX_UNFORMATTED": "$(rootpath unformatted.jl)",
    },
    target_compatible_with = JULIA_COMPATIBLE_WITH,
    toolchains = ["@rules_julia//julia:current_julia_toolchain"],
    deps = ["@rules_dx//tools/testing:dx_testing"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = [
        "//:__pkg__",
        "@rules_dx//tools/ci:__pkg__",
    ],
)
