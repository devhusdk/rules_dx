load("@rules_julia//julia:defs.bzl", "julia_binary")
load("@rules_julia//julia/pkg:julia_pkg_resolve.bzl", "julia_pkg_resolve")
load("@rules_julia//julia/pkg:julia_pkg_resolve_test.bzl", "julia_pkg_resolve_test")
load("//julia/tools:julia_tool.bzl", "dx_julia_tool")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Manifest.bazel.json",
    "Manifest.toml",
    "Project.toml",
])

julia_binary(
    name = "jet_bin",
    srcs = ["jet.jl"],
    visibility = ["//visibility:private"],
    deps = ["@dx_julia_jet//:JET"],
)

dx_julia_tool(
    name = "jet",
    binary = ":jet_bin",
)

julia_pkg_resolve(
    name = "resolve",
    manifest_bazel_json = "Manifest.bazel.json",
    manifests = {"Manifest.toml": "1.12"},
    project_toml = "Project.toml",
)

julia_pkg_resolve_test(
    name = "resolve_test",
    resolver = ":resolve",
)

rust_test(
    name = "jet_cli_test",
    srcs = ["jet_cli_test.rs"],
    data = [
        ":jet",
        "testdata/buggy.jl",
        "testdata/clean.jl",
    ],
    env = {"JULIA_JET": "$(rootpath :jet)"},
    tags = ["no-remote"],
    deps = ["//tools/testing:dx_testing"],
)

rustfmt_test(
    name = "jet_cli_fmt_test",
    targets = [":jet_cli_test"],
)

rust_clippy_test(
    name = "jet_cli_clippy_test",
    targets = [":jet_cli_test"],
)
