{
  "$schema": "../core/modules/lang.schema.json",
  "name": "kotlin",
  "title": "Kotlin",
  "family": "core",
  "ecosystems": [
    "maven"
  ],
  "depcheck": "kotlin",
  "semver": false,
  "manifests": [
    "libs.versions.toml"
  ],
  "lockfiles": [
    "maven_install.json"
  ],
  "tools": [
    "detekt",
    "kotlinc",
    "ktfmt"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_arm64",
    "windows_x86_64"
  ],
  "pins": [],
  "entry_points": [
    "kotlin_library",
    "kotlin_binary",
    "kotlin_test",
    "kotlin_bench",
    "kotlin_fuzz_test",
    "kotlin_doc_shard"
  ],
  "quality": {
    "bzl": "kotlin/private/quality:kotlin.bzl",
    "classes": [
      "kotlin"
    ],
    "defaults": {
      "audit": [],
      "format": [
        "ktfmt"
      ],
      "lint": [
        "detekt",
        "typos"
      ],
      "typecheck": [
        "kotlinc"
      ]
    },
    "file_extensions": [
      ".kt",
      ".kts"
    ],
    "aspects": {
      "format": [
        "real_kotlin_format_aspect"
      ],
      "lint": [
        "real_kotlin_lint_aspect"
      ],
      "typecheck": [
        "real_kotlin_typecheck_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_kotlin_format_probe_aspect"
      ],
      "lint": [
        "real_kotlin_lint_probe_aspect"
      ],
      "typecheck": [
        "real_kotlin_typecheck_probe_aspect"
      ]
    }
  },
  "docs": {
    "bzl": "tools/docs/kotlin:aspect.bzl",
    "file_extensions": [
      ".kt"
    ],
    "aspects": [
      "real_kotlin_docs_aspect"
    ]
  }
}
