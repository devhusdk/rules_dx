{
  "$schema": "../core/modules/lang.schema.json",
  "name": "kotlin",
  "title": "Kotlin",
  "family": "core",
  "ecosystems": [
    "maven"
  ],
  "depcheck": "kotlin",
  "semver": false,
  "manifests": [
    "MODULE.bazel"
  ],
  "lockfiles": [
    "maven_install.json"
  ],
  "tools": [
    "detekt",
    "kotlinc",
    "ktfmt"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_arm64",
    "windows_x86_64"
  ],
  "pins": [],
  "entry_points": [
    "kotlin_warnings_as_errors_opts",
    "kotlin_library",
    "kotlin_binary",
    "kotlin_test",
    "kotlin_bench",
    "kotlin_fuzz_test"
  ],
  "quality": {
    "bzl": "quality:families/jvm.bzl",
    "file_extensions": [
      ".kt",
      ".kts"
    ]
  },
  "docs": {
    "bzl": "tools/docs/jvm:aspect.bzl",
    "file_extensions": [
      ".kt"
    ],
    "aspects": []
  }
}
