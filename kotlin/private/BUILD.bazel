load("@rules_kotlin//kotlin:core.bzl", "kt_kotlinc_options")
load("//core:wrapper.bzl", "dx_warnings_as_errors")
load("//core/quality:fixtures.bzl", "real_source_target")
load(":defs.bzl", "kotlin_warnings_as_errors_opts")

package(default_visibility = [
    "//:__pkg__",
    "//kotlin:__subpackages__",
    "//tools/ci:__pkg__",
])

kt_kotlinc_options(
    name = "base_opts",
    api_version = "2.2",
    language_version = "2.2",
)

kotlin_warnings_as_errors_opts(
    name = "warnings_as_errors",
    visibility = ["//visibility:public"],
    warnings_as_errors = dx_warnings_as_errors({}, True, False)[1],
)

config_setting(
    name = "windows_coverage",
    constraint_values = ["@platforms//os:windows"],
    values = {"collect_code_coverage": "true"},
    visibility = ["//visibility:public"],
)

exports_files([
    "defs.bzl",
    "kwargs.bzl",
])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "kwargs.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
