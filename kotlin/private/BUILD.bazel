load("@rules_kotlin//kotlin:core.bzl", "kt_kotlinc_options")
load("//core:conformance.bzl", "dx_wrapper_contract_tests")
load("//core:defs.bzl", "expect_equal", "label_string")
load("//core:wrapper.bzl", "dx_warnings_as_errors")
load("//quality:fixtures.bzl", "real_source_target")
load(":defs.bzl", "kotlin_warnings_as_errors_opts")
load(":kwargs.bzl", "kotlin_kotlinc_opts_with_warnings_as_errors", "kotlin_test_class", "kotlin_test_entry_kwargs")

package(default_visibility = ["//visibility:public"])

kt_kotlinc_options(
    name = "base_opts",
    api_version = "2.2",
    language_version = "2.2",
)

kotlin_warnings_as_errors_opts(
    name = "warnings_as_errors",
    warnings_as_errors = dx_warnings_as_errors({}, True, False)[1],
)

exports_files([
    "defs.bzl",
    "kwargs.bzl",
])

dx_wrapper_contract_tests(
    name = "wrapper_contract_tests",
    extra_checks = [
        expect_equal(
            "empty gains warnings-as-errors",
            kotlin_kotlinc_opts_with_warnings_as_errors("x", {})["kotlinc_opts"],
            str(label_string("//kotlin/private:warnings_as_errors")),
        ),
        expect_equal(
            "explicit opts are wrapped",
            kotlin_kotlinc_opts_with_warnings_as_errors(
                "x",
                {"kotlinc_opts": "//custom:opts"},
            )["kotlinc_opts"],
            ":x_kotlinc_opts",
        ),
        expect_equal(
            "attribute alone declares the options rule",
            kotlin_kotlinc_opts_with_warnings_as_errors(
                "x",
                {"warnings_as_errors": False},
            ),
            {"kotlinc_opts": ":x_kotlinc_opts"},
        ),
        expect_equal(
            "none opts gain warnings-as-errors",
            kotlin_kotlinc_opts_with_warnings_as_errors(
                "x",
                {"kotlinc_opts": None},
            )["kotlinc_opts"],
            str(label_string("//kotlin/private:warnings_as_errors")),
        ),
        expect_equal(
            "other kwargs survive",
            kotlin_kotlinc_opts_with_warnings_as_errors(
                "x",
                {"deps": [":hello_lib"]},
            )["deps"],
            [":hello_lib"],
        ),
        expect_equal(
            "kotlin test root infers class",
            kotlin_test_class(
                "FooTest",
                ["src/test/kotlin/hello/FooTest.kt"],
                "p",
            ),
            "hello.FooTest",
        ),
        expect_equal(
            "java test root infers class",
            kotlin_test_class(
                "FooTest",
                ["src/test/java/com/x/FooTest.kt"],
                "p",
            ),
            "com.x.FooTest",
        ),
        expect_equal(
            "package root src infers class",
            kotlin_test_class(
                "FooTest",
                ["FooTest.kt"],
                "kotlin/x",
            ),
            "x.FooTest",
        ),
        expect_equal(
            "no name match infers nothing",
            kotlin_test_class(
                "FooTest",
                ["src/test/kotlin/hello/Other.kt"],
                "p",
            ),
            None,
        ),
        expect_equal(
            "non-list srcs infer nothing",
            kotlin_test_class("FooTest", None, "p"),
            None,
        ),
        expect_equal(
            "empty srcs infer nothing",
            kotlin_test_class("FooTest", [], "p"),
            None,
        ),
        expect_equal(
            "test gains inferred class",
            kotlin_test_entry_kwargs(
                "FooTest",
                ["src/test/kotlin/hello/FooTest.kt"],
                "p",
                {},
            ),
            {"test_class": "hello.FooTest"},
        ),
        expect_equal(
            "explicit test class is kept",
            kotlin_test_entry_kwargs(
                "FooTest",
                ["src/test/kotlin/hello/FooTest.kt"],
                "p",
                {"test_class": "a.B"},
            )["test_class"],
            "a.B",
        ),
        expect_equal(
            "empty test class counts as unset",
            kotlin_test_entry_kwargs(
                "FooTest",
                ["src/test/kotlin/hello/FooTest.kt"],
                "p",
                {"test_class": ""},
            )["test_class"],
            "hello.FooTest",
        ),
        expect_equal(
            "kotlinc opts survive inference",
            kotlin_test_entry_kwargs(
                "FooTest",
                ["src/test/kotlin/hello/FooTest.kt"],
                "p",
                kotlin_kotlinc_opts_with_warnings_as_errors("FooTest", {}),
            )["kotlinc_opts"],
            str(label_string("//kotlin/private:warnings_as_errors")),
        ),
    ],
    file_classes = [
        "kotlin",
        "java",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "kwargs.bzl",
    ],
    tags = ["corpus"],
)
