load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

# Registered toolchains are loaded on every build, so this package must not load
# rules_kotlin: that would fetch the Kotlin compiler for builds that never use it.
toolchain(
    name = "unused_deps",
    toolchain = "//kotlin/private/toolchain/impl:unused_deps_impl",
    toolchain_type = "@rules_kotlin//kotlin:kt_toolchain_type",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
