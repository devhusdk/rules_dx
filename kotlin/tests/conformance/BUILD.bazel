load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//kotlin:defs.bzl", "kotlin_binary", "kotlin_library", "kotlin_test")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "subject_compatible_with")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

kotlin_library(
    name = "conformance",
    testonly = True,
    srcs = ["Greet.kt"],
)

kotlin_binary(
    name = "hello",
    srcs = ["Main.kt"],
    main_class = "conformance.MainKt",
    deps = [":conformance"],
)

kotlin_test(
    name = "pass_subject_test",
    size = "small",
    srcs = ["PassTest.kt"],
    main_class = "conformance.PassTestKt",
    target_compatible_with = subject_compatible_with(),
    deps = [":conformance"],
)

kotlin_test(
    name = "fail_subject_test",
    size = "small",
    srcs = ["FailTest.kt"],
    main_class = "conformance.FailTestKt",
    target_compatible_with = subject_compatible_with(),
    deps = [":conformance"],
)

kotlin_binary(
    name = "runfiles_hello",
    srcs = ["RunfilesMain.kt"],
    data = ["data.txt"],
    main_class = "conformance.RunfilesMainKt",
    deps = ["@rules_java//java/runfiles"],
)

kotlin_binary(
    name = "lock_hello",
    srcs = ["LockMain.kt"],
    main_class = "conformance.LockMainKt",
    deps = ["@maven//:junit_junit"],
)

dx_conformance_suite(
    name = "",
    size = "small",
    binary = ":hello",
    covered_source = "Greet.kt",
    expected = "hello world",
    failing_case = "failingCase",
    failing_pattern = "AssertionError: {case}",
    failing_test = ":fail_subject_test",
    lang = "kotlin",
    lock = {
        "binary": ":lock_hello",
        "ecosystem": "kotlin",
        "expected": "hello lock",
        "lockfile": "//third_party/jvm:maven_install.json",
        "manifest": "jvm_deps.toml",
        "package": "junit:junit",
        "stale": "maven_install.stale.json",
    },
    passing_test = ":pass_subject_test",
    runfiles = {
        "binary": ":runfiles_hello",
        "data": "data.txt",
        "expected": "hello runfiles",
    },
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    testonly = True,
    tags = ["corpus"],
    toml_srcs = ["jvm_deps.toml"],
)
