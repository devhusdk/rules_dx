load("//kotlin/rules:defs.bzl", "kotlin_binary", "kotlin_library", "kotlin_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//tools/testing:hello_output.bzl", "dx_hello_output_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

kotlin_library(
    name = "hello_lib",
    srcs = ["Hello.kt"],
)

kotlin_binary(
    name = "hello",
    srcs = ["Main.kt"],
    main_class = "hello.MainKt",
    deps = [":hello_lib"],
)

kotlin_test(
    name = "hello_test",
    srcs = ["HelloTest.kt"],
    test_class = "hello.HelloTest",
    deps = [
        ":hello_lib",
        "@maven//:junit_junit",
    ],
)

dx_hello_output_test(
    name = "hello_output_test",
    binary = ":hello",
    expected = "hello world",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
