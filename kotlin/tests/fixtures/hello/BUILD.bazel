load("@rules_kotlin//kotlin:core.bzl", "kt_kotlinc_options")
load("//kotlin/rules:defs.bzl", "kotlin_binary", "kotlin_library", "kotlin_test")
load("//libs/starlark/tests:direct_sources.bzl", "dx_direct_sources_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//tools/testing:hello_output.bzl", "dx_hello_output_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

kotlin_library(
    name = "hello_lib",
    srcs = ["Hello.kt"],
)

# Mixed Java needs jvm_target 21 under -Werror.
kt_kotlinc_options(
    name = "jvm21_opts",
    api_version = "2.2",
    jvm_target = "21",
    language_version = "2.2",
)

kotlin_library(
    name = "mixed_lib",
    srcs = [
        "Greeter.java",
        "Mixed.kt",
    ],
    aspect_hints = ["//quality:corpus_checkstyle_config"],
    kotlinc_opts = ":jvm21_opts",
)

dx_direct_sources_test(
    name = "mixed_sources_test",
    expected = {
        "java": ["Greeter.java"],
        "kotlin": ["Mixed.kt"],
    },
    target_under_test = ":mixed_lib",
)

kotlin_binary(
    name = "hello",
    srcs = ["Main.kt"],
    main_class = "hello.MainKt",
    deps = [":hello_lib"],
)

kotlin_test(
    name = "hello_test",
    srcs = ["HelloTest.kt"],
    test_class = "hello.HelloTest",
    deps = [
        ":hello_lib",
        "@maven//:junit_junit",
    ],
)

kotlin_test(
    name = "InferredTest",
    srcs = ["src/test/kotlin/hello/InferredTest.kt"],
    deps = [
        ":hello_lib",
        "@maven//:junit_junit",
    ],
)

dx_hello_output_test(
    name = "hello_output_test",
    binary = ":hello",
    expected = "hello world",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//tools/docs/support_matrix:__pkg__"],
)
