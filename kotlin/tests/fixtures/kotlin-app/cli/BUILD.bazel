load("@crates//:crates.bzl", "aliases")
load("@rules_dx//kotlin:defs.bzl", "kotlin_binary", "kotlin_library", "kotlin_test")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust:defs.bzl", "rust_test")

# gazelle:resolve kotlin grades.BuildInfo //kotlin/tests/fixtures/kotlin-app/grades
# gazelle:resolve kotlin org.junit.Assert.assertEquals @maven//:junit_junit
# gazelle:resolve kotlin org.junit.Rule @maven//:junit_junit
# gazelle:resolve kotlin org.junit.Test @maven//:junit_junit
# gazelle:resolve kotlin org.junit.rules.TemporaryFolder @maven//:junit_junit

package(
    default_testonly = True,
    default_visibility = ["//kotlin/tests/fixtures/kotlin-app:__subpackages__"],
)

exports_files(
    [
        "Cli.kt",
        "CliTest.kt",
        "Main.kt",
    ],
    visibility = ["//visibility:public"],
)

kotlin_library(
    name = "cli",
    testonly = True,
    srcs = ["Cli.kt"],
    deps = ["//kotlin/tests/fixtures/kotlin-app/grades"],
)

kotlin_binary(
    name = "grades",
    srcs = ["Main.kt"],
    main_class = "cli.MainKt",
    visibility = ["//visibility:public"],
    deps = [":cli"],
)

kotlin_test(
    name = "cli_test",
    srcs = ["CliTest.kt"],
    test_class = "cli.CliTest",
    deps = [
        ":cli",
        "@maven//:junit_junit",
    ],
)

rust_test(
    name = "exit_codes_test",
    testonly = True,
    srcs = ["exit_codes_test.rs"],
    aliases = aliases(
        package_name = "kotlin/tests/fixtures/kotlin-app/kotlin_app_cli_fixture",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "exit_codes_test",
    crate_root = "exit_codes_test.rs",
    data = [
        ":grades",
        "//kotlin/tests/fixtures/kotlin-app/grades:grades.json",
        "//kotlin/tests/fixtures/kotlin-app/grades:malformed/above_max.json",
        "//kotlin/tests/fixtures/kotlin-app/grades:malformed/empty.json",
        "//kotlin/tests/fixtures/kotlin-app/grades:malformed/negative.json",
        "//kotlin/tests/fixtures/kotlin-app/grades:malformed/not_array.json",
        "//kotlin/tests/fixtures/kotlin-app/grades:malformed/not_json.txt",
        "//kotlin/tests/fixtures/kotlin-app/grades:malformed/wrong_type.json",
    ],
    env = {
        "GRADES_ABOVE_MAX": "$(rootpath //kotlin/tests/fixtures/kotlin-app/grades:malformed/above_max.json)",
        "GRADES_BIN": "$(rootpath :grades)",
        "GRADES_EMPTY": "$(rootpath //kotlin/tests/fixtures/kotlin-app/grades:malformed/empty.json)",
        "GRADES_JSON": "$(rootpath //kotlin/tests/fixtures/kotlin-app/grades:grades.json)",
        "GRADES_NEGATIVE": "$(rootpath //kotlin/tests/fixtures/kotlin-app/grades:malformed/negative.json)",
        "GRADES_NOT_ARRAY": "$(rootpath //kotlin/tests/fixtures/kotlin-app/grades:malformed/not_array.json)",
        "GRADES_NOT_JSON": "$(rootpath //kotlin/tests/fixtures/kotlin-app/grades:malformed/not_json.txt)",
        "GRADES_WRONG_TYPE": "$(rootpath //kotlin/tests/fixtures/kotlin-app/grades:malformed/wrong_type.json)",
    },
    deps = ["@rules_dx//tools/testing:dx_testing"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = [
        "//:__pkg__",
    ],
)

real_source_target(
    name = "corpus_toml",
    testonly = True,
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
