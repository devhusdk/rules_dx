# gazelle:ignore

load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//java/tests:jvm_compile_tests.bzl", "jvm_classpath_test")
load("@rules_dx//kotlin:defs.bzl", "kotlin_library", "kotlin_test")
load("@rules_dx//tools/testing/conformance:defs.bzl", "dx_coverage_test")

package(
    default_testonly = True,
    default_visibility = ["//kotlin/tests/fixtures/kotlin_app:__subpackages__"],
)

exports_files(
    [
        "ClasspathTest.kt",
        "GradeException.kt",
        "GradeReaderTest.kt",
        "GradeReader.kt",
        "StatsTest.kt",
        "Stats.kt",
        "Student.kt",
        "VERSION",
        "grades.json",
    ] + glob(["malformed/*"]),
    visibility = ["//visibility:public"],
)

genrule(
    name = "build_info",
    srcs = ["VERSION"],
    outs = ["BuildInfo.kt"],
    cmd = "printf 'package grades\\n\\n/** Build constants. */\\nobject BuildInfo {\\n    /** Schema number. */\\n    const val SCHEMA = %s\\n}\\n' \"$$(cat $<)\" > $@",
)

kotlin_library(
    name = "grades",
    testonly = True,
    srcs = [
        "GradeException.kt",
        "GradeReader.kt",
        "Stats.kt",
        "Student.kt",
        ":build_info",  # keep
    ],
    resource_strip_prefix = "kotlin/tests/fixtures/kotlin_app",
    resources = ["grades.json"],
    deps = [
        "@maven//:com_google_code_gson_gson",
        "@maven//:com_google_guava_guava",
    ],
)

kotlin_library(
    name = "without_gson",
    testonly = True,
    srcs = [
        "GradeException.kt",
        "GradeReader.kt",
        "Stats.kt",
        "Student.kt",
        ":build_info",
    ],
    tags = ["manual"],
    deps = ["@maven//:com_google_guava_guava"],
)

jvm_classpath_test(
    name = "without_gson_classpath_test",
    size = "small",
    jar = "gson",
    library = "without_gson",
    mnemonic = "KotlinCompile",
    present = False,
)

jvm_classpath_test(
    name = "grades_gson_classpath_test",
    size = "small",
    jar = "gson",
    library = "grades",
    mnemonic = "KotlinCompile",
    present = True,
)

dx_coverage_test(
    name = "grade_reader_coverage_test",
    size = "small",
    covered_source = "GradeReader.kt",
    subject = ":grade_reader_test",
)

kotlin_test(
    name = "grade_reader_test",
    srcs = ["GradeReaderTest.kt"],
    test_class = "grades.GradeReaderTest",
    deps = [
        ":grades",
        "@maven//:junit_junit",
    ],
)

kotlin_test(
    name = "stats_test",
    srcs = ["StatsTest.kt"],
    test_class = "grades.StatsTest",
    deps = [
        ":grades",
        "@maven//:com_google_guava_guava",
        "@maven//:junit_junit",
    ],
)

kotlin_test(
    name = "classpath_test",
    srcs = ["ClasspathTest.kt"],
    test_class = "grades.ClasspathTest",
    deps = [
        ":grades",
        "@maven//:com_google_code_gson_gson",
        "@maven//:com_google_guava_guava",
        "@maven//:junit_junit",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
