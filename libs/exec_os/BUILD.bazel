load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load(":defs.bzl", "exec_os")
load(":exec_os_tests.bzl", "exec_os_tests")

package(default_visibility = ["//visibility:private"])

exec_os(
    name = "exec_os",
    visibility = ["//visibility:public"],
)

platform(
    name = "windows_x64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "linux_x64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

exec_os_tests(name = "exec_os_tests")

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "exec_os_tests.bzl",
    ],
    tags = ["corpus"],
)
