load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_CLI_TOOLS")

package(default_visibility = VIS_CLI_TOOLS)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

rust_library(
    name = "dx_families",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "libs/dx_families",
        normal = True,
    ),
    compile_data = ["//modules:families.json"],
    crate_name = "dx_families",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "libs/dx_families",
        normal = True,
    ) + ["@crates//:serde"],
)

rust_test(
    name = "dx_families_test",
    size = "small",
    srcs = [
        "src/lib.rs",
        "src/tests.rs",
    ],
    aliases = aliases(
        package_name = "libs/dx_families",
        normal = True,
        normal_dev = True,
    ),
    compile_data = ["//modules:families.json"],
    coverage_lib = ":dx_families",
    crate_name = "dx_families",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "libs/dx_families",
        normal = True,
        normal_dev = True,
    ) + ["@crates//:serde"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)
