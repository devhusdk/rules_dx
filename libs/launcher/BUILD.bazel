load("//quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "exec_launcher",
    srcs = [
        "src/launch.rs",
        "src/main.rs",
    ],
    crate_name = "launcher",
    crate_root = "src/main.rs",
    deps = ["//cli/path:dx_path"],
)

rust_test(
    name = "exec_launcher_test",
    srcs = [
        "src/launch.rs",
        "src/launch_tests.rs",
        "src/main.rs",
    ],
    crate_name = "launcher",
    crate_root = "src/main.rs",
    deps = [
        "//cli/path:dx_path",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
