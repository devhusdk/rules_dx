load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

exports_files([
    "mutate.bzl",
    "none.txt",
    "run.sh",
])

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "macos_x86_64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

# Prebuilt tools; none.txt stands in where no binary is pinned.
alias(
    name = "cargo_mutants",
    actual = select({
        ":linux_x86_64": "@cargo_mutants_linux_x86_64//:cargo-mutants",
        ":macos_arm64": "@cargo_mutants_macos_x86_64//:cargo-mutants",
        ":macos_x86_64": "@cargo_mutants_macos_x86_64//:cargo-mutants",
        "//conditions:default": ":none.txt",
    }),
)

alias(
    name = "gremlins",
    actual = select({
        ":linux_x86_64": "@gremlins_linux_x86_64//:gremlins",
        ":macos_arm64": "@gremlins_macos_arm64//:gremlins",
        "//conditions:default": ":none.txt",
    }),
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "mutate.bzl",
    ],
    tags = ["corpus"],
)
