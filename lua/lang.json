{
  "$schema": "../core/modules/lang.schema.json",
  "name": "lua",
  "title": "Lua",
  "family": "core",
  "ecosystems": [
    "luarocks"
  ],
  "depcheck": "lua",
  "semver": false,
  "manifests": [
    "*.rockspec"
  ],
  "lockfiles": [
    "luarocks.lock"
  ],
  "tools": [
    "selene",
    "stylua"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_arm64",
    "windows_x86_64"
  ],
  "pins": [
    "private/toolchain/pins.json"
  ],
  "entry_points": [
    "lua_library",
    "lua_binary",
    "lua_test"
  ],
  "quality": {
    "bzl": "lua/private/quality:lua.bzl",
    "file_extensions": [
      ".lua"
    ],
    "aspects": {
      "format": [
        "real_lua_format_aspect"
      ],
      "lint": [
        "real_lua_lint_aspect"
      ],
      "typecheck": [
        "real_lua_typecheck_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_lua_format_probe_aspect"
      ],
      "lint": [
        "real_lua_lint_probe_aspect"
      ],
      "typecheck": [
        "real_lua_typecheck_probe_aspect"
      ]
    }
  },
  "docs": {
    "bzl": "tools/docs/lua:aspect.bzl",
    "file_extensions": [
      ".lua"
    ],
    "aspects": [
      "real_lua_docs_aspect"
    ]
  }
}
