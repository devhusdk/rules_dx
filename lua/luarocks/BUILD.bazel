load("@rules_py//py:defs.bzl", "py_unittest_test")
load("//lua:defs.bzl", "lua_binary", "lua_library", "lua_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load(":lock_tests.bzl", "lua_luarocks_lock_tests")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
    "extensions.bzl",
    "lock.bzl",
    "lock_tests.bzl",
    "refresh.py",
    "repos.bzl",
])

lua_luarocks_lock_tests(name = "lock_tests")

lua_library(
    name = "rockspec",
    srcs = ["rockspec.lua"],
    strip_import_prefix = "/lua/luarocks",
)

lua_binary(
    name = "resolve",
    main = "resolve.lua",
    deps = [":rockspec"],
)

lua_test(
    name = "resolve_test",
    main = "resolve_test.lua",
    deps = [":rockspec"],
)

py_unittest_test(
    name = "refresh_unit_test",
    srcs = [
        "refresh.py",
        "refresh_test.py",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "extensions.bzl",
        "lock.bzl",
        "lock_tests.bzl",
        "repos.bzl",
    ],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)
