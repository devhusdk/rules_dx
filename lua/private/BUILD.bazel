load("//core:conformance.bzl", "dx_wrapper_contract_tests")
load("//core:defs.bzl", "expect_equal")
load("//core:wrapper.bzl", "dx_quality_srcs")
load(
    "//lua/private:lua.bzl",
    "LUA_SOURCE_SPECS",
    "canonical_rlocation",
    "entry_lines",
    "lua_executable_name",
    "module_name",
)
load("//quality:fixtures.bzl", "real_source_target")
load(":defs.bzl", "LUA_ENTRY_SUFFIX", "lua_library")

package(default_visibility = ["//lua:__subpackages__", "//tools/ci:__pkg__", "//:__pkg__"])

exports_files([
    "defs.bzl",
    "lua.bzl",
    "providers.bzl",
])

lua_library(
    name = "bench",
    srcs = ["bench/dx_bench.lua"],
    strip_import_prefix = "/lua/private/bench",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

dx_wrapper_contract_tests(
    name = "wrapper_contract_tests",
    extra_checks = [
        expect_equal(
            "one lua class owns .lua files",
            LUA_SOURCE_SPECS,
            [(
                "lua",
                ["lua"],
            )],
        ),
        expect_equal(
            "a/b.lua is module a.b",
            module_name("a/b.lua"),
            "a.b",
        ),
        expect_equal(
            "a/init.lua is module a",
            module_name("a/init.lua"),
            "a",
        ),
        expect_equal(
            "a root init.lua is module init",
            module_name("init.lua"),
            "init",
        ),
        expect_equal(
            "a non-Lua file has no module",
            module_name("a/b.txt"),
            None,
        ),
        expect_equal(
            "a dotted stem has no module",
            module_name("a/b.c.lua"),
            None,
        ),
        expect_equal(
            "a relative strip_import_prefix starts at the package",
            module_name("pkg/src/x/y.lua", "pkg", "src"),
            "x.y",
        ),
        expect_equal(
            "an absolute strip_import_prefix starts at the repository root",
            module_name("pkg/src/x/init.lua", "pkg", "/pkg/src/"),
            "x",
        ),
        expect_equal(
            "a file outside strip_import_prefix has no module",
            module_name("pkg/other/y.lua", "pkg", "src"),
            None,
        ),
        expect_equal(
            "import_prefix is added after stripping",
            module_name("pkg/src/y.lua", "pkg", "src", "vendor.lib"),
            "vendor.lib.y",
        ),
        expect_equal(
            "a root init.lua under import_prefix is the prefix",
            module_name("pkg/init.lua", "pkg", "/pkg", "inspect"),
            "inspect",
        ),
        expect_equal(
            "main repository files key under the workspace name",
            canonical_rlocation("lua/x.lua", "_main"),
            "_main/lua/x.lua",
        ),
        expect_equal(
            "external files key under their canonical repository",
            canonical_rlocation("../lua+/src/x.lua", "_main"),
            "lua+/src/x.lua",
        ),
        expect_equal(
            "the entry file lists main, the source repository and sorted modules",
            entry_lines(
                "_main/a/main.lua",
                "",
                [
                    ("z", "_main/a/z.lua"),
                    ("b.c", "_main/a/b/c.lua"),
                ],
            ),
            "_main/a/main.lua\n\nb.c\t_main/a/b/c.lua\nz\t_main/a/z.lua\n",
        ),
        expect_equal("entry files end in .luaentry", LUA_ENTRY_SUFFIX, ".luaentry"),
        expect_equal(
            "linux executables keep the target name",
            lua_executable_name("app", "launcher"),
            "app",
        ),
        expect_equal(
            "windows executables end in .exe",
            lua_executable_name("app", "launcher.exe"),
            "app.exe",
        ),
        expect_equal(
            "main leads the owned sources",
            dx_quality_srcs(
                "main.lua",
                [
                    "main.lua",
                    "u.lua",
                ],
            ),
            [
                "main.lua",
                "u.lua",
            ],
        ),
    ],
    file_classes = ["lua"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "lua.bzl",
        "providers.bzl",
    ],
    tags = ["corpus"],
)
