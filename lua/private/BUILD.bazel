load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")

# gazelle:exclude bench
load(":defs.bzl", "lua_library")

package(default_visibility = [
    "//:__pkg__",
    "//lua:__subpackages__",
    "//tools/ci:__pkg__",
])

exports_files([
    "BUILD.bazel",
    "defs.bzl",
    "ldoc.BUILD.bazel",
    "luacov.BUILD.bazel",
    "luacov_reporter_lcov.BUILD.bazel",
    "luafilesystem.BUILD.bazel",
    "penlight.BUILD.bazel",
    "lua.bzl",
    "lua_LICENSE.txt",
    "luals.BUILD.bazel",
    "providers.bzl",
])

lua_library(
    name = "bench",
    srcs = ["bench/dx_bench.lua"],
    strip_import_prefix = "/lua/private/bench",
    tags = ["manual"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["*.bzl"]) + [
        "BUILD.bazel",
        "bench/dx_bench.lua",
        "ldoc.BUILD.bazel",
        "lua_LICENSE.txt",
        "luacov.BUILD.bazel",
        "luacov_reporter_lcov.BUILD.bazel",
        "luafilesystem.BUILD.bazel",
        "luals.BUILD.bazel",
        "penlight.BUILD.bazel",
    ],
    visibility = ["//:__subpackages__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "ldoc.BUILD.bazel",
        "lua.bzl",
        "luacov.BUILD.bazel",
        "luacov_reporter_lcov.BUILD.bazel",
        "luafilesystem.BUILD.bazel",
        "luals.BUILD.bazel",
        "penlight.BUILD.bazel",
        "providers.bzl",
    ],
    tags = ["corpus"],
)
