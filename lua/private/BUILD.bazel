# gazelle:exclude bench
load("//core/quality:fixtures.bzl", "real_source_target")
load(":defs.bzl", "lua_library")

package(default_visibility = [
    "//:__pkg__",
    "//lua:__subpackages__",
    "//tools/ci:__pkg__",
])

exports_files([
    "defs.bzl",
    "ldoc.BUILD.bazel",
    "luacov.BUILD.bazel",
    "luacov_reporter_lcov.BUILD.bazel",
    "luafilesystem.BUILD.bazel",
    "penlight.BUILD.bazel",
    "lua.bzl",
    "luals.BUILD.bazel",
    "providers.bzl",
])

lua_library(
    name = "bench",
    srcs = ["bench/dx_bench.lua"],
    strip_import_prefix = "/lua/private/bench",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "lua.bzl",
        "providers.bzl",
        "luals.BUILD.bazel",
        "ldoc.BUILD.bazel",
        "luacov.BUILD.bazel",
        "luacov_reporter_lcov.BUILD.bazel",
        "luafilesystem.BUILD.bazel",
        "penlight.BUILD.bazel",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
    ]),
    visibility = ["//:__subpackages__"],
)
