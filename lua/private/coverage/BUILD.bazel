load("//core/quality:fixtures.bzl", "real_source_target")

# gazelle:dx_ignore_import lua luacov.runner
# gazelle:dx_ignore_import lua luacov.reporter
# gazelle:dx_ignore_import lua luacov.reporter.lcov
load("//lua:defs.bzl", "lua_library")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "coverage_on",
    values = {"collect_code_coverage": "true"},
)

# keep
lua_library(
    name = "luacov",
    srcs = ["@dx_luacov//:sources"],
    strip_import_prefix = "/src",
)

# keep
lua_library(
    name = "lcov",
    srcs = ["@dx_luacov_reporter_lcov//:sources"],
)

lua_library(
    name = "dx",
    srcs = ["dx_coverage.lua"],
    strip_import_prefix = "/lua/private/coverage",
)

# keep
lua_library(
    name = "enabled",
    deps = [
        ":dx",
        ":lcov",
        ":luacov",
    ],
)

# keep
lua_library(name = "none")

alias(
    name = "libs",
    actual = select({
        ":coverage_on": ":enabled",
        "//conditions:default": ":none",
    }),
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
    ],
    tags = ["corpus"],
)
