load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//core/quality:fixtures.bzl", "real_source_target")
load(":hub_tests.bzl", "lua_hub_tests")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:private"])

rust_library(
    name = "lua_lock_lib",
    srcs = [
        "src/resolve.rs",
        "src/rockspec.rs",
    ],
    aliases = aliases(
        package_name = "lua/private/lua_lock",
        normal = True,
    ),
    crate_name = "lua_lock",
    crate_root = "src/resolve.rs",
    deps = all_crate_deps(
        package_name = "lua/private/lua_lock",
        normal = True,
    ) + [
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
    ],
)

rust_binary(
    name = "lock",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "lua/private/lua_lock",
        normal = True,
    ),
    crate_name = "lua_lock_bin",
    crate_root = "src/main.rs",
    visibility = ["//lua:__pkg__"],
    deps = all_crate_deps(
        package_name = "lua/private/lua_lock",
        normal = True,
    ) + [
        ":lua_lock_lib",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
    ],
)

lua_hub_tests(name = "hub", size = "small")

rust_test(
    name = "resolve_test",
    size = "small",
    srcs = ["tests/resolve_test.rs"],
    aliases = aliases(
        package_name = "lua/private/lua_lock",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "resolve_test",
    crate_root = "tests/resolve_test.rs",
    deps = all_crate_deps(
        package_name = "lua/private/lua_lock",
        normal = True,
        normal_dev = True,
    ) + [
        ":lua_lock_lib",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
        "//tools/testing:dx_testing",
    ],
    data = [
        "testdata/app.rockspec",
        "testdata/golden.lock.json",
        "testdata/manifest.json",
        "testdata/mid-2.0-1.rockspec",
        "testdata/mid-2.1-1.rockspec",
        "testdata/leaf-1.2-0.rockspec",
    ],
    env = {
        "APP": "$(rootpath testdata/app.rockspec)",
        "GOLDEN": "$(rootpath testdata/golden.lock.json)",
        "LEAF": "$(rootpath testdata/leaf-1.2-0.rockspec)",
        "MANIFEST": "$(rootpath testdata/manifest.json)",
        "MID_20": "$(rootpath testdata/mid-2.0-1.rockspec)",
        "MID_21": "$(rootpath testdata/mid-2.1-1.rockspec)",
    },
    tags = ["block-network"],
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel", "hub.bzl", "hub_tests.bzl"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml", "hub.bzl"],
    visibility = ["//visibility:public"],
)
