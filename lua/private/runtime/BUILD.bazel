load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("//cc:defs.bzl", "cc_test")
load("//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "launcher",
    srcs = ["launcher.cc"],
    deps = [
        "@lua//:liblua",
        "@rules_cc//cc/runfiles",
    ],
)

write_file(
    name = "launcher_test_entry",
    testonly = True,
    out = "launcher_test.luaentry",
    content = [
        "_main/lua/private/runtime/launcher_test.lua",
        "",
        "helper\t_main/lua/private/runtime/launcher_test_helper.lua",
        "",
    ],
    newline = "unix",
)

cc_test(
    name = "launcher_test",
    srcs = ["launcher.cc"],
    args = ["one"],
    data = [
        "launcher_test.lua",
        "launcher_test_helper.lua",
        ":launcher_test_entry",
    ],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:private"],
    deps = [
        "@lua//:liblua",
        "@rules_cc//cc/runfiles",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
