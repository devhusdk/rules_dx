load("//core/modules:versions.bzl", "LUA_VERSION")
load("//core/quality:fixtures.bzl", "real_source_target")
load(":toolchain.bzl", "lua_toolchain")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "extensions.bzl",
    "toolchain.bzl",
])

toolchain_type(name = "toolchain_type")

lua_toolchain(
    name = "lua",
    launcher = "//lua/private/runtime:launcher",
    luac = "@lua//:bin/luac",
    tags = ["manual"],
    version = LUA_VERSION,
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "extensions.bzl",
        "toolchain.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
    ]),
    visibility = ["//:__subpackages__"],
)
