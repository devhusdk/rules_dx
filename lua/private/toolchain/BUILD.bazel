load("//core/modules:versions.bzl", "LUA_VERSION")
load(":toolchain.bzl", "lua_toolchain")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "extensions.bzl",
    "toolchain.bzl",
])

lua_toolchain(
    name = "lua",
    launcher = "//lua/private/runtime:launcher",
    luac = "@lua//:bin/luac",
    tags = ["manual"],
    version = LUA_VERSION,
)

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
    ]),
    visibility = ["//:__subpackages__"],
)
