load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")
load(":defs_tests.bzl", "lua_wrapper_contract_tests")
load(":hub_tests.bzl", "lua_hub_tests")
load(":lua_header.bzl", "lua_header")
load(":toolchain_tests.bzl", "lua_metadata_tests")

rust_test(
    name = "selene_smoke_test",
    size = "small",
    srcs = ["selene_smoke_test.rs"],
    data = [
        "//lua/private/quality:lua54.yml",
        "//lua/private/quality:selene.toml",
        "//lua/tests/fixtures/selene:lua54_valid.lua",
        "//lua/tests/fixtures/selene:undefined_variable.lua",
        "//rust/private/quality/tools:selene",
    ],
    env = {
        "LUA54_VALID": "$(rootpath //lua/tests/fixtures/selene:lua54_valid.lua)",
        "SELENE": "$(rootpath //rust/private/quality/tools:selene)",
        "SELENE_CONFIG": "$(rootpath //lua/private/quality:selene.toml)",
        "UNDEFINED_VARIABLE": "$(rootpath //lua/tests/fixtures/selene:undefined_variable.lua)",
    },
    tags = ["no-coverage"],
    deps = ["//tools/testing:dx_testing"],
)

lua_header(
    name = "lua_h",
    testonly = True,
    header = "lua.h",
    lib = "@lua//:liblua",
)

rust_test(
    name = "lua_license_test",
    size = "small",
    srcs = ["lua_license_test.rs"],
    data = [
        ":lua_h",
        "//lua/private:lua_LICENSE.txt",
        "@dx_luafilesystem//:LICENSE",
    ],
    env = {
        "LUAFILESYSTEM_LICENSE": "$(rootpath @dx_luafilesystem//:LICENSE)",
        "LUA_H": "$(rootpath :lua_h)",
        "LUA_LICENSE": "$(rootpath //lua/private:lua_LICENSE.txt)",
    },
    deps = ["//tools/testing:dx_testing"],
)

lua_hub_tests(
    name = "hub",
    size = "small",
)

lua_metadata_tests(
    name = "metadata",
    size = "small",
)

lua_wrapper_contract_tests(
    name = "wrapper_contract_tests",
    size = "small",
    wrappers = {
        "binary": "//lua/tests/conformance:hello",
        "library": "//lua/tests/conformance:conformance",
        "test": "//lua/tests/bench:bench_report_test",
    },
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "hub_tests.bzl",
        "toolchain_tests.bzl",
        "defs_tests.bzl",
        "lua_header.bzl",
    ],
    tags = ["corpus"],
