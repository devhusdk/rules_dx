load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//lua:defs.bzl", "lua_binary", "lua_library", "lua_test")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "subject_compatible_with")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

# keep
lua_library(
    name = "conformance",
    srcs = ["greet.lua"],
    strip_import_prefix = "/lua/tests/conformance",
)

lua_library(
    name = "lint_dirty",
    srcs = ["lib/lint_dirty.lua"],
    tags = ["manual"],
)

lua_library(
    name = "format_dirty",
    srcs = ["lib/format_dirty.lua"],
    tags = ["manual"],
)

lua_binary(
    name = "hello",
    main = "main.lua",
    deps = [":conformance"],
)

# keep
lua_binary(
    name = "lock_hello",
    main = "lock_main.lua",
    deps = ["@rocks_lua.tests.luarocks//inspect"],
)

# keep
lua_test(
    name = "pass_subject_test",
    size = "small",
    main = "pass_test.lua",
    target_compatible_with = subject_compatible_with(),
    deps = [":conformance"],
)

# keep
lua_test(
    name = "fail_subject_test",
    size = "small",
    main = "fail_test.lua",
    target_compatible_with = subject_compatible_with(),
    deps = [":conformance"],
)

dx_conformance_suite(
    name = "",
    size = "small",
    binary = ":hello",
    covered_source = "greet.lua",
    expected = "hello world",
    failing_case = "failing_case",
    failing_pattern = ": {case}",
    failing_test = ":fail_subject_test",
    lang = "lua",
    lock = {
        "binary": ":lock_hello",
        "ecosystem": "lua",
        "expected": "hello lock",
        "lockfile": "//lua/tests/luarocks:luarocks.lock.json",
        "manifest": "//lua/tests/luarocks:fixture.rockspec",
        "package": "inspect",
        "stale": "luarocks.stale.lock.json",
    },
    not_applicable = {"cross_test": "lua_binary is a script the interpreter runs; it has no object format"},
    passing_test = ":pass_subject_test",
    quality = {
        "clean": ":conformance",
        "format_dirty": ":format_dirty",
        "format_source": "lib/format_dirty.lua",
        "lint_dirty": ":lint_dirty",
        "lint_line": 1,
        "lint_rule": "unused_variable",
        "lint_source": "lib/lint_dirty.lua",
    },
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
