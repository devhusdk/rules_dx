load("//lua/rules:defs.bzl", "lua_binary")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")

package(default_visibility = ["//lua/tests/fixtures/lua-app:__subpackages__"])

[
    lua_binary(
        name = name,
        testonly = True,
        main = name + ".lua",
    )
    for name in [
        "missing_dep",
        "runtime_error",
    ]
]

rust_test(
    name = "diagnostics_test",
    srcs = ["diagnostics_test.rs"],
    data = [
        "syntax_error.lua",
        "unformatted.lua",
        ":missing_dep",
        ":runtime_error",
        "//lua/tests/fixtures/lua-app/catalog:catalog_test.lua",
        "//lua/tests/fixtures/lua-app/catalog:init.lua",
        "//lua/tests/fixtures/lua-app/catalog:parse.lua",
        "//lua/tests/fixtures/lua-app/cli:main.lua",
        "//lua/tests/fixtures/lua-app/report:init.lua",
        "//lua/tests/fixtures/lua-app/report:report_test.lua",
        "@dx_tools//:stylua",
        "@lua//:bin/luac",
    ],
    env = {
        "LUAC": "$(rootpath @lua//:bin/luac)",
        "MISSING_DEP": "$(rlocationpath :missing_dep)",
        "RUNTIME_ERROR": "$(rlocationpath :runtime_error)",
        "STYLUA": "$(rootpath @dx_tools//:stylua)",
        "STYLUA_CLEAN": " ".join([
            "$(rootpath //lua/tests/fixtures/lua-app/catalog:catalog_test.lua)",
            "$(rootpath //lua/tests/fixtures/lua-app/catalog:init.lua)",
            "$(rootpath //lua/tests/fixtures/lua-app/catalog:parse.lua)",
            "$(rootpath //lua/tests/fixtures/lua-app/cli:main.lua)",
            "$(rootpath //lua/tests/fixtures/lua-app/report:init.lua)",
            "$(rootpath //lua/tests/fixtures/lua-app/report:report_test.lua)",
        ]),
        "SYNTAX_ERROR": "$(rootpath syntax_error.lua)",
        "UNFORMATTED": "$(rootpath unformatted.lua)",
    },
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = ["//tools/testing:dx_testing"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = [
        "//tools/ci:__pkg__",
    ],
)

rustfmt_test(
    name = "diagnostics_fmt_test",
    targets = [":diagnostics_test"],
)

rust_clippy_test(
    name = "diagnostics_clippy_test",
    targets = [":diagnostics_test"],
)
