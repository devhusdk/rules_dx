# gazelle:ignore
load("@rules_dx//lua:defs.bzl", "lua_binary", "lua_test")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//lua/tests/fixtures/lua-app:__subpackages__"])

[
    lua_binary(
        name = name,
        testonly = True,
        main = name + ".lua",
    )
    for name in [
        "missing_dep",
        "runtime_error",
    ]
]

lua_test(
    name = "diagnostics_test",
    main = "diagnostics_test.lua",
    data = [
        "syntax_error.lua",
        "unformatted.lua",
        ":missing_dep",
        ":runtime_error",
        "//lua/tests/fixtures/lua-app/catalog:catalog_test.lua",
        "//lua/tests/fixtures/lua-app/catalog:init.lua",
        "//lua/tests/fixtures/lua-app/catalog:parse.lua",
        "//lua/tests/fixtures/lua-app/cli:main.lua",
        "//lua/tests/fixtures/lua-app/report:init.lua",
        "//lua/tests/fixtures/lua-app/report:report_test.lua",
        "@rules_dx//lua/private/tools:stylua",
        "@lua//:bin/luac",
    ],
    env = {
        "LUAC": "$(rlocationpath @lua//:bin/luac)",
        "MISSING_DEP": "$(rlocationpath :missing_dep)",
        "RUNTIME_ERROR": "$(rlocationpath :runtime_error)",
        "STYLUA": "$(rlocationpath @rules_dx//lua/private/tools:stylua)",
        "STYLUA_CLEAN": " ".join([
            "$(rlocationpath //lua/tests/fixtures/lua-app/catalog:catalog_test.lua)",
            "$(rlocationpath //lua/tests/fixtures/lua-app/catalog:init.lua)",
            "$(rlocationpath //lua/tests/fixtures/lua-app/catalog:parse.lua)",
            "$(rlocationpath //lua/tests/fixtures/lua-app/cli:main.lua)",
            "$(rlocationpath //lua/tests/fixtures/lua-app/report:init.lua)",
            "$(rlocationpath //lua/tests/fixtures/lua-app/report:report_test.lua)",
        ]),
        "SYNTAX_ERROR": "$(rlocationpath syntax_error.lua)",
        "UNFORMATTED": "$(rlocationpath unformatted.lua)",
    },
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = [
        "//:__pkg__",
        "@rules_dx//tools/ci:__pkg__",
    ],
)
