load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//lua:defs.bzl", "lua_binary", "lua_library", "lua_test")

# gazelle:dx_ignore_import lua luacov.runner
# gazelle:exclude lib.lua
# gazelle:exclude pkg

lua_library(
    name = "lib",
    srcs = [
        "lib.lua",
        "pkg/init.lua",
    ],
    strip_import_prefix = "/lua/tests/runtime",
    visibility = [
        "//lua/tests:__subpackages__",
        "@rules_dx//core/quality/testdata:__pkg__",
    ],
)

lua_binary(
    name = "probe",
    main = "probe.lua",
    visibility = ["//lua/tests:__subpackages__"],
    deps = [":lib"],
)

# keep
lua_test(
    name = "probe_test",
    args = [
        "--flag",
        "value",
    ],
    data = ["data.txt"],
    env = {
        "DATA_FILE": "$(rlocationpath data.txt)",
        "LUA_CPATH": "/tmp/?.so",
        "LUA_INIT": "lua_init_ran = true",
        "LUA_PATH": "/tmp/?.lua",
    },
    main = "probe_test.lua",
    deps = [":lib"],
)

# keep
lua_test(
    name = "coverage_probe_test",
    main = "coverage_probe_test.lua",
    deps = [":lib"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//:__pkg__"],
)
