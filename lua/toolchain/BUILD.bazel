load("//modules:versions.bzl", "TESTED_LUA")
load("//quality:fixtures.bzl", "real_source_target")
load(":metadata_tests.bzl", "lua_metadata_tests")
load(":toolchain.bzl", "lua_toolchain")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "metadata_tests.bzl",
    "pins.bzl",
    "repos.bzl",
    "toolchain.bzl",
])

lua_metadata_tests(name = "metadata")

toolchain_type(name = "toolchain_type")

lua_toolchain(
    name = "lua",
    launcher = "//lua/runtime:launcher",
    luac = "@lua//:bin/luac",
    version = TESTED_LUA,
)

toolchain(
    name = "lua_toolchain",
    toolchain = ":lua",
    toolchain_type = ":toolchain_type",
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "metadata_tests.bzl",
        "pins.bzl",
        "repos.bzl",
        "toolchain.bzl",
    ],
    tags = ["corpus"],
)
