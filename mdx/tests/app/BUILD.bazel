load("//core/quality:fixtures.bzl", "real_source_target")
load("//mdx:defs.bzl", "mdx_build", "mdx_library")
load("//tools/testing:web_hello.bzl", "dx_web_app")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

_DEPS = [
    "//:node_modules/clsx",
    "//:node_modules/preact",
    "//:node_modules/preact-render-to-string",
]

dx_web_app(
    size = "small",
    srcs = glob(["src/**"]) + ["index.html"],
    build = mdx_build,
    config = "vite.config.mjs",
    library = mdx_library,
    library_name = "pages",
    library_srcs = glob(["src/**/*.mdx"]),
    ssr_entry = "src/entry-server.jsx",
    tests = {
        "site_static_test": [
            ":site",
            "//:node_modules/jest-environment-jsdom",
        ],
        "site_ssr_test": [
            ":site",
            ":site_ssr",
            "//:node_modules/jest-environment-jsdom",
        ] + _DEPS,
        "site_client_test": [
            ":site",
            "//:node_modules/jest-environment-jsdom",
        ],
    },
    deps = _DEPS,
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
