load("//javascript/rules:defs.bzl", "javascript_test")
load("//mdx/rules:defs.bzl", "mdx_check")
load("//quality:fixtures.bzl", "real_source_target")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

mdx_check(
    name = "check",
    srcs = glob(["src/**"]),
    node_modules = "//:node_modules",
    package_json = "package.json",
    tags = ["manual"],
)

javascript_test(
    name = "parse_error_test",
    srcs = ["parse_error.test.js"],
    aspect_hints = ["//:biome_config"],
    data = [":check.mdx_check.txt"],
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
    package_json = "//:package_json",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
