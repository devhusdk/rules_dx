load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//javascript/rules:defs.bzl", "javascript_library")
load("//mdx/rules:defs.bzl", "mdx_check", "mdx_library")
load("//quality:fixtures.bzl", "real_source_target")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

mdx_library(
    name = "hello_lib",
    srcs = ["Hello.mdx"],
)

javascript_library(
    name = "helper_lib",
    srcs = ["helper.js"],
    aspect_hints = ["//:biome_config"],
)

mdx_check(
    name = "hello_check",
    srcs = [
        "Hello.mdx",
        "helper.js",
    ],
    node_modules = "//:node_modules",
)

build_test(
    name = "hello_aggregate_test",
    targets = [
        ":hello_lib",
        ":hello_check",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
