load("//javascript/rules:defs.bzl", "javascript_library", "javascript_test")
load("//mdx/rules:defs.bzl", "mdx_library")
load("//quality:fixtures.bzl", "real_source_target")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

mdx_library(
    name = "hello_lib",
    srcs = ["Hello.mdx"],
)

javascript_library(
    name = "helper_lib",
    srcs = ["helper.js"],
    aspect_hints = ["//:biome_config"],
)

javascript_test(
    name = "hello_test",
    srcs = ["Hello.test.js"],
    aspect_hints = ["//:biome_config"],
    data = [
        ":Hello.mdx",
        ":helper_lib",
        "//:node_modules/@mdx-js/mdx",
    ],
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
