load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")
load(":consumer_deps.bzl", "consumer_deps_json")
load(":versions_rs.bzl", "versions_rs")
load(":versions_tests.bzl", "versions_contract_tests")

package(default_visibility = ["//visibility:public"])

versions_contract_tests(name = "versions_contract")

consumer_deps_json(name = "consumer_deps_json")

versions_rs(name = "versions_rs")

# keep
rust_library(
    name = "dx_versions",
    srcs = [":versions_rs"],
    crate_name = "dx_versions",
    crate_root = ":versions_rs",
    edition = "2021",
)

# keep
rust_test(
    name = "consumer_deps_test",
    srcs = ["consumer_deps_test.rs"],
    data = [
        ":consumer_deps_json",
        "//:MODULE.bazel",
        "//third_party/go:go.sum",
        "//tools/testing/hermetic:module_fragments",
    ],
    deps = [
        "//libs/module_bazel:dx_module_bazel",
        "//tools/testing:dx_testing",
        "@crates//:serde_json",
    ],
)

rustfmt_test(
    name = "consumer_deps_fmt_test",
    targets = [
        ":consumer_deps_test",
        ":dx_versions",
    ],
)

rust_clippy_test(
    name = "consumer_deps_clippy_test",
    targets = [":consumer_deps_test"],
)

# keep
rust_test(
    name = "families_test",
    srcs = ["families_test.rs"],
    data = [
        "families.json",
        "//:MODULE.bazel",
        "//quality:families/ansible.bzl",
        "//quality:families/cloudformation.bzl",
        "//quality:families/make.bzl",
        "//quality:real_aspects.bzl",
        "//quality:real_core.bzl",
    ],
    tags = [
        "external",
        "no-remote-exec",
    ],
    deps = [
        "//libs/module_bazel:dx_module_bazel",
        "//tools/testing:dx_testing",
        "@crates//:serde_json",
    ],
)

rustfmt_test(
    name = "families_fmt_test",
    targets = [":families_test"],
)

rust_clippy_test(
    name = "families_clippy_test",
    targets = [":families_test"],
)

# keep
rust_test(
    name = "versions_loaded_test",
    srcs = ["versions_loaded_test.rs"],
    data = [
        ":module_srcs",
        "//cuda/toolchain:check.bzl",
        "//java/ide:BUILD.bazel",
        "//libs/testing:tested_stack.bzl",
        "//lua/toolchain:BUILD.bazel",
        "//python/rules:runtime_tests.bzl",
        "//rust/rules:edition.bzl",
        "//tools/docs/components:defs.bzl",
    ],
    deps = ["//tools/testing:dx_testing"],
)

rustfmt_test(
    name = "versions_loaded_fmt_test",
    targets = [":versions_loaded_test"],
)

rust_clippy_test(
    name = "versions_loaded_clippy_test",
    targets = [":versions_loaded_test"],
)

test_suite(
    name = "all",
    tests = [
        ":consumer_deps_test",
        ":families_test",
        ":versions_contract",
        ":versions_loaded_test",
    ],
)

exports_files([
    "consumer_deps.bzl",
    "consumer_graph.json",
    "python_budget.json",
    "cuda.bzl",
    "rust.bzl",
    "python.bzl",
    "js.bzl",
    "java-scala-kotlin.bzl",
    "dotnet.bzl",
    "families.json",
    "powershell.bzl",
    "toolchains.bzl",
    "versions.bzl",
])

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "consumer_deps.bzl",
        "cuda.bzl",
        "dotnet.bzl",
        "java-scala-kotlin.bzl",
        "js.bzl",
        "powershell.bzl",
        "python.bzl",
        "rust.bzl",
        "toolchains.bzl",
        "ruby.bzl",
        "versions.bzl",
        "versions_rs.bzl",
        "versions_tests.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
