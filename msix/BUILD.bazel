load("//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

exports_files([
    "README.md",
    "defs.bzl",
    "extensions.bzl",
    "lang.json",
    "pins.json",
])

toolchain_type(name = "toolchain_type")

platform(
    name = "windows_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:windows",
    ],
)

platform(
    name = "windows_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

platform(
    name = "windows_x86_32",
    constraint_values = [
        "@platforms//cpu:x86_32",
        "@platforms//os:windows",
    ],
)

real_source_target(
    name = "corpus_markdown",
    markdown_siblings = ["//msix/tests/fixtures/msix-app:README.md"],
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "extensions.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
    ]),
    visibility = ["//:__subpackages__"],
)
