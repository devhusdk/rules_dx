_LINUX = ["@platforms//os:linux"]

_WINDOWS = ["@platforms//os:windows"]

cc_binary(
    name = "fake_makeappx_bin",
    srcs = ["fake_makeappx.c"],
)

cc_binary(
    name = "argv_signtool",
    srcs = ["argv_signtool.c"],
    linkopts = ["crypt32.lib"],
    target_compatible_with = _WINDOWS,
)

fake_exe(
    name = "fake_makeappx",
    out = "fake_makeappx.exe",
)

fake_exe(
    name = "cell_exe",
    out = "cell.exe",
    data = [":cell_dll"],
)

fake_exe(
    name = "cell_dll",
    out = "cell.dll",
)

fake_exe(
    name = "other_dll",
    out = "other/cell.dll",
)

fake_exe(
    name = "dll_exe",
    out = "dll.exe",
    data = [":other_dll"],
)

