    notice = ["//examples/msix-app/app:NOTICE.txt"],
    publisher = "CN=DxMsixExample, O=Dx",
    version = "1.2.3.0",
)

pwsh_test(
    name = "tools_test",
    size = "small",
    srcs = ["tools_test.ps1"],
    data = [
        "@dx_msix_tools//:arm64",
        "@dx_msix_tools//:x64",
    ],
    env = {
        "DX_MSIX_TOOLS_ARM64": "$(rlocationpaths @dx_msix_tools//:arm64)",
