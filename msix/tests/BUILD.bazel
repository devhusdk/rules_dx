load("//cc/rules:defs.bzl", "cc_binary")
load("//msix:defs.bzl", "dx_msix", "dx_msix_sign")
load("//msix:repos.bzl", "UNACCEPTED")
load("//msix:toolchain.bzl", "msix_toolchain")
load("//powershell/rules:defs.bzl", "pwsh_test")
load("//quality:fixtures.bzl", "real_source_target")
load(":cell_tests.bzl", "arm64_action_test", "attribute_failure_test", "data_paths_test", "fake_exe", "no_windows_exec_test", "sign_build_test", "sign_env_test", "unaccepted_license_test", "unsupported_cell_test", "x64_action_test")
load(":transition.bzl", "msix_variant")

# gazelle:exclude argv_signtool.c

_LINUX = ["@platforms//os:linux"]

_WINDOWS = ["@platforms//os:windows"]

cc_binary(
    name = "argv_signtool",
    srcs = ["argv_signtool.c"],
    linkopts = ["crypt32.lib"],
    target_compatible_with = _WINDOWS,
)

fake_exe(
    name = "fake_makeappx",
    out = "fake_makeappx.exe",
)

fake_exe(
    name = "cell_exe",
    out = "cell.exe",
    data = [":cell_dll"],
)

fake_exe(
    name = "cell_dll",
    out = "cell.dll",
)

fake_exe(
    name = "other_dll",
    out = "other/cell.dll",
)

fake_exe(
    name = "dll_exe",
    out = "dll.exe",
    data = [":other_dll"],
)

fake_exe(
    name = "cell_txt",
    out = "cell.txt",
)

msix_toolchain(
    name = "fake_tools",
    makeappx = ":fake_makeappx",
    signtool = ":fake_makeappx",
    version = "0.0.0.0",
)

toolchain(
    name = "fake_toolchain",
    toolchain = ":fake_tools",
    toolchain_type = "//msix:toolchain_type",
)

msix_toolchain(
    name = "unaccepted_tools",
    error = UNACCEPTED,
)

toolchain(
    name = "unaccepted_toolchain",
    toolchain = ":unaccepted_tools",
    toolchain_type = "//msix:toolchain_type",
)

dx_msix(
    name = "cell",
    binary = ":cell_exe",
    data = ["fixtures/greeting.txt"],
    identity_name = "Dx.Cell",
    libs = [":cell_dll"],
    logo = "fixtures/logo.png",
    notice = ["fixtures/NOTICE.txt"],
    publisher = "CN=Dx Cell, O=Dx",
    tags = ["manual"],
    version = "1.0.0.0",
)

dx_msix(
    name = "root_data",
    binary = ":cell_exe",
    data = ["//:packaging_root_data"],
    identity_name = "Dx.Cell",
    logo = "fixtures/logo.png",
    notice = ["fixtures/NOTICE.txt"],
    publisher = "CN=Dx Cell, O=Dx",
    tags = ["manual"],
    version = "1.0.0.0",
)

dx_msix_sign(
    name = "cell_sign",
    package = ":cell",
    tags = ["manual"],
)

dx_msix(
    name = "bad_min_version",
    binary = ":cell_exe",
    identity_name = "Dx.Cell",
    logo = "fixtures/logo.png",
    min_version = "10.0",
    notice = ["fixtures/NOTICE.txt"],
    publisher = "CN=Dx Cell",
    tags = ["manual"],
    version = "1.0.0.0",
)

dx_msix(
    name = "bad_max_version",
    binary = ":cell_exe",
    identity_name = "Dx.Cell",
    logo = "fixtures/logo.png",
    max_version_tested = "10.0.<.0",
    notice = ["fixtures/NOTICE.txt"],
    publisher = "CN=Dx Cell",
    tags = ["manual"],
    version = "1.0.0.0",
)

dx_msix(
    name = "bad_version",
    binary = ":cell_exe",
    identity_name = "Dx.Cell",
    logo = "fixtures/logo.png",
    notice = ["fixtures/NOTICE.txt"],
    publisher = "CN=Dx Cell",
    tags = ["manual"],
    version = "1.0.0",
)

dx_msix(
    name = "bad_publisher",
    binary = ":cell_exe",
    identity_name = "Dx.Cell",
    logo = "fixtures/logo.png",
    notice = ["fixtures/NOTICE.txt"],
    publisher = "Dx Cell",
    tags = ["manual"],
    version = "1.0.0.0",
)

dx_msix(
    name = "bad_lib",
    binary = ":cell_exe",
    identity_name = "Dx.Cell",
    libs = [":cell_txt"],
    logo = "fixtures/logo.png",
    notice = ["fixtures/NOTICE.txt"],
    publisher = "CN=Dx Cell",
    tags = ["manual"],
    version = "1.0.0.0",
)

dx_msix(
    name = "dll_clash",
    binary = ":dll_exe",
    identity_name = "Dx.Cell",
    libs = [":cell_dll"],
    logo = "fixtures/logo.png",
    notice = ["fixtures/NOTICE.txt"],
    publisher = "CN=Dx Cell",
    tags = ["manual"],
    version = "1.0.0.0",
)

dx_msix(
    name = "dll_libs_clash",
    binary = ":cell_exe",
    identity_name = "Dx.Cell",
    libs = [
        ":cell_dll",
        ":other_dll",
    ],
    logo = "fixtures/logo.png",
    notice = ["fixtures/NOTICE.txt"],
    publisher = "CN=Dx Cell",
    tags = ["manual"],
    version = "1.0.0.0",
