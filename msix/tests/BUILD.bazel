# size: medium, timed out at 300s on windows, see #6357
[
    powershell_test(
        name = "install_" + case + "_test",
        size = "medium",
        srcs = ["install_test.ps1"],
        data = [
            ":app_noresource",
            ":app_probe",
            "//msix/private:sign.ps1",
            "//msix/private:signtool",
            "//msix/tests/fixtures/msix-app/app",
            "//msix/tests/fixtures/msix-app/app:app_sign",
        ],
        env = {
            "DX_INSTALL_CASE": case,
            "DX_MSIX_NORESOURCE": "$(rlocationpaths :app_noresource)",
            "DX_MSIX_PACKAGE": "$(rlocationpaths //msix/tests/fixtures/msix-app/app)",
            "DX_MSIX_PROBE": "$(rlocationpaths :app_probe)",
            "DX_MSIX_SIGN": "$(rlocationpath //msix/private:sign.ps1)",
            "DX_MSIX_SIGNTOOL": "$(rlocationpaths //msix/private:signtool)",
            "DX_MSIX_X64": "$(rlocationpaths //msix/tests/fixtures/msix-app/app)",
        },
        tags = [
            "exclusive",
            "manual",
        ],
        target_compatible_with = _WINDOWS,
        deps = ["@rules_powershell//powershell/runfiles"],
    )
    for case in [
        "noresource",
        "probe",
        "untrusted",
        "x64",
    ]
]

test_suite(
    name = "install_test",
    tags = ["manual"],
    tests = [
        ":install_noresource_test",
        ":install_probe_test",
        ":install_untrusted_test",
        ":install_x64_test",
    ],
)

