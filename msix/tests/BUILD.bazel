sign_env_test(
    name = "sign_env_test",
    target_compatible_with = _WINDOWS,
    target_under_test = "//examples/msix-app/app:app_sign",
)

pwsh_test(
    name = "install_test",
    size = "medium",
    srcs = ["install_test.ps1"],
    data = [
        ":app_noresource",
