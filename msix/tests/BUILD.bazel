    ],
    publisher = "CN=Dx Cell",
    tags = ["manual"],
    version = "1.0.0.0",
)

unsupported_cell_test(
    name = "x86_cell_fails",
    expected = "target cell this platform is unsupported",
    target_under_test = ":cell",
)

no_windows_exec_test(
    name = "no_windows_exec_fails",
    expected = "packaging needs a windows_x86_64 or windows_arm64 execution platform",
    target_compatible_with = _LINUX,
    target_under_test = ":cell",
)

unaccepted_license_test(
    name = "unaccepted_license_fails",
    expected = "license (https://aka.ms/WinSDKLicenseURL) is not accepted",
    target_under_test = ":cell",
)

no_windows_exec_test(
    name = "signtool_no_windows_exec_fails",
    expected = "signing needs a windows_x86_64 or windows_arm64 execution platform",
    target_compatible_with = _LINUX,
    target_under_test = "//msix:signtool",
)

unaccepted_license_test(
    name = "signtool_unaccepted_license_fails",
    expected = "license (https://aka.ms/WinSDKLicenseURL) is not accepted",
    target_under_test = "//msix:signtool",
)

sign_build_test(
    name = "sign_build_test",
    target_under_test = ":cell_sign",
)

attribute_failure_test(
    name = "bad_version_fails",
    expected = "version '1.0.0' must have four parts",
    target_under_test = ":bad_version",
)

attribute_failure_test(
    name = "bad_min_version_fails",
    expected = "min_version '10.0' must have four parts",
    target_under_test = ":bad_min_version",
)

attribute_failure_test(
    name = "bad_max_version_fails",
    expected = "max_version_tested '10.0.<.0' parts must be numbers",
    target_under_test = ":bad_max_version",
)

attribute_failure_test(
    name = "bad_publisher_fails",
    expected = "publisher 'Dx Cell' must be a distinguished name",
    target_under_test = ":bad_publisher",
)

attribute_failure_test(
    name = "bad_lib_fails",
    expected = "msix/tests:cell_txt has no .dll",
    target_under_test = ":bad_lib",
)

attribute_failure_test(
    name = "clash_fails",
    expected = "both map to licenses/NOTICE.txt",
    target_under_test = ":clash",
)

attribute_failure_test(
    name = "dll_clash_fails",
    expected = "msix/tests:other_dll both provide cell.dll",
    target_under_test = ":dll_clash",
)

attribute_failure_test(
    name = "dll_clash_names_lib_fails",
    expected = "msix/tests:cell_dll and runfiles ",
    target_under_test = ":dll_clash",
)

attribute_failure_test(
    name = "dll_libs_clash_fails",
    expected = "msix/tests:other_dll and libs ",
    target_under_test = ":dll_libs_clash",
)

data_paths_test(
    name = "root_data_test",
    expected = [
        "share/README.md",
        "share/github-ci.md",
    ],
    target_under_test = ":root_data",
)

x64_action_test(
    name = "x64_action_test",
    arch = "x64",
    target_under_test = ":cell",
)

arm64_action_test(
    name = "arm64_action_test",
    arch = "arm64",
    target_under_test = ":cell",
)

