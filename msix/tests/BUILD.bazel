        "//examples/msix-app/app:app_sign",
        "//msix:signtool",
    ],
    env = {
        "DX_MSIX_ARGV_SIGNTOOL": "$(rlocationpaths :argv_signtool)",
        "DX_MSIX_ARM64": "$(rlocationpaths :app_arm64)",
        "DX_MSIX_PACKAGE": "$(rlocationpaths //examples/msix-app/app)",
        "DX_MSIX_SIGN": "_main/examples/msix-app/app/app_sign.bat",
