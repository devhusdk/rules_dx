        ":app_arm64",
        ":app_probe",
        ":app_x64",
    ],
    env = {
        "DX_MSIX_ARM64": "$(rlocationpaths :app_arm64)",
        "DX_MSIX_PROBE": "$(rlocationpaths :app_probe)",
