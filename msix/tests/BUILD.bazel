    platform = "@llvm//platforms:windows_x86_64",
    target_compatible_with = _LINUX,
)

msix_variant(
    name = "pe_arm64",
    src = "//examples/msix-app/app:dxmsix",
    platform = "@llvm//platforms:windows_aarch64",
    target_compatible_with = _LINUX,
)

msix_variant(
    name = "greet_arm64",
    src = "//examples/msix-app/greet:greet_dll",
    platform = "@llvm//platforms:windows_aarch64",
    target_compatible_with = _LINUX,
)

pwsh_test(
    name = "pack_test",
    size = "small",
    srcs = ["pack_test.ps1"],
    data = [
        "fixtures/NOTICE.txt",
        "fixtures/fake_makeappx.sh",
        "fixtures/greeting.txt",
        "fixtures/logo.png",
        ":greet_arm64",
        ":greet_x64",
        ":pe_arm64",
        ":pe_x64",
        "//msix:pack.ps1",
    ],
    env = {
        "DX_MSIX_FAKE_MAKEAPPX": "$(rlocationpath fixtures/fake_makeappx.sh)",
        "DX_MSIX_FIXTURES": "$(rlocationpaths fixtures/NOTICE.txt) $(rlocationpaths fixtures/greeting.txt) $(rlocationpaths fixtures/logo.png)",
        "DX_MSIX_PACK": "$(rlocationpath //msix:pack.ps1)",
        "DX_MSIX_PE_ARM64": "$(rlocationpaths :pe_arm64) $(rlocationpaths :greet_arm64)",
        "DX_MSIX_PE_X64": "$(rlocationpaths :pe_x64) $(rlocationpaths :greet_x64)",
    },
    tags = ["block-network"],
    target_compatible_with = _LINUX,
    deps = ["@rules_powershell//powershell/runfiles"],
)

msix_variant(
    name = "app_arm64",
    src = "//examples/msix-app/app",
    platform = "//msix/platforms:windows_arm64",
    target_compatible_with = _WINDOWS,
)

msix_variant(
    name = "app_x64",
    src = "//examples/msix-app/app",
    platform = "//msix/platforms:windows_x86_64",
    target_compatible_with = _WINDOWS,
)

msix_variant(
    name = "app_probe",
    src = "//examples/msix-app/app",
    copts = ["-DDX_CONSUMER_PROBE"],
    platform = "//msix/platforms:windows_x86_64",
    target_compatible_with = _WINDOWS,
)

dx_msix(
    name = "app_noresource",
