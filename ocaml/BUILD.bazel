load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

exports_files([
    "README.md",
    "defs.bzl",
    "extensions.bzl",
    "lang.json",
    "pins.json",
])

alias(
    name = "bisect_ppx_rewriter",
    actual = "//ocaml/private/coverage:bisect_ppx_rewriter",
)

alias(
    name = "dune",
    actual = "//ocaml/private/toolchain:dune",
)

alias(
    name = "emitter",
    actual = "//ocaml/private/toolchain:emitter",
)

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "extensions.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
        "pins.json",
    ]),
    visibility = ["//:__subpackages__"],
)
