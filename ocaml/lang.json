{
  "$schema": "../core/modules/lang.schema.json",
  "name": "ocaml",
  "title": "OCaml",
  "family": "core",
  "ecosystems": [
    "opam"
  ],
  "depcheck": "ocaml",
  "semver": false,
  "manifests": [
    "dune-project",
    "*.opam"
  ],
  "lockfiles": [],
  "tools": [
    "topiary",
    "zanuda"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_x86_64"
  ],
  "pins": [
    "toolchain/pins.bzl"
  ],
  "entry_points": [
    "ocamllex",
    "toolchain_choice",
    "toolchain_settings",
    "launcher_script",
    "runfiles_path",
    "owned_sources",
    "ocaml_module",
    "ocaml_signature",
    "ocaml_library",
    "ocaml_binary",
    "ocaml_test",
    "ocaml_fuzz_test",
    "ocaml_bench"
  ],
  "quality": {
    "bzl": "quality:families/ocaml.bzl",
    "file_extensions": [
      ".ml",
      ".mli"
    ],
    "aspects": {
      "format": [
        "real_ocaml_format_aspect"
      ],
      "lint": [
        "real_ocaml_lint_aspect"
      ],
      "typecheck": [
        "real_ocaml_typecheck_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_ocaml_format_probe_aspect"
      ],
      "lint": [
        "real_ocaml_lint_probe_aspect"
      ],
      "typecheck": [
        "real_ocaml_typecheck_probe_aspect"
      ]
    }
  },
  "docs": {
    "bzl": "tools/docs/ocaml:aspect.bzl",
    "file_extensions": [
      ".ml",
      ".mli"
    ],
    "aspects": [
      "real_ocaml_docs_aspect"
    ]
  }
}
