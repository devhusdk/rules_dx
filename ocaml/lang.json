{
  "$schema": "../core/modules/lang.schema.json",
  "name": "ocaml",
  "title": "OCaml",
  "family": "core",
  "ecosystems": [
    "opam"
  ],
  "depcheck": "ocaml",
  "semver": false,
  "manifests": [
    "dune-project",
    "*.opam"
  ],
  "lockfiles": [],
  "setup": {
    "hubs": [
      {
        "ecosystem": "opam",
        "manifest": "*.opam",
        "lock": "*.opam.locked",
        "state": null,
        "extension": "@rules_dx//ocaml:extensions.bzl",
        "tag": "lock",
        "hub": "opam",
        "resolver": null,
        "imports": "name"
      }
    ]
  },
  "tools": [
    "topiary",
    "zanuda"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64"
  ],
  "pins": [
    "pins.json"
  ],
  "entry_points": [
    "ocamllex",
    "ocaml_module",
    "ocaml_signature",
    "ocaml_library",
    "ocaml_binary",
    "ocaml_test",
    "ocaml_fuzz_test",
    "ocaml_bench",
    "dx_dune_library"
  ],
  "quality": {
    "bzl": "ocaml/private/quality:ocaml.bzl",
    "file_extensions": [
      ".ml",
      ".mli"
    ],
    "aspects": {
      "format": [
        "real_ocaml_format_aspect"
      ],
      "lint": [
        "real_ocaml_lint_aspect"
      ],
      "typecheck": [
        "real_ocaml_typecheck_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_ocaml_format_probe_aspect"
      ],
      "lint": [
        "real_ocaml_lint_probe_aspect"
      ],
      "typecheck": [
        "real_ocaml_typecheck_probe_aspect"
      ]
    }
  },
  "docs": {
    "bzl": "tools/docs/ocaml:aspect.bzl",
    "file_extensions": [
      ".ml",
      ".mli"
    ],
    "aspects": [
      "real_ocaml_docs_aspect"
    ]
  }
}
