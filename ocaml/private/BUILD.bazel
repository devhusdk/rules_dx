load("//core:conformance.bzl", "dx_wrapper_contract_tests")
load("//core:defs.bzl", "expect_equal", "fake_file", "label_string")
load("//core:wrapper.bzl", "dx_test_forward_kwargs", "dx_test_upstream_kwargs")
load("//core/quality:fixtures.bzl", "real_source_target")
load(":defs.bzl", "launcher_script", "owned_sources", "runfiles_path", "toolchain_choice")
load(":kwargs.bzl", "ocaml_coverage_kwargs", "ocaml_default_module_name", "ocaml_link_kwargs", "ocaml_test_upstream_kwargs", "ocaml_upstream_tags", "ocaml_with_defaults")
load(":providers.bzl", "STANDARD_WARNING_OPTS", "STRICT_WARNING_OPTS", "WARNINGS_AS_ERRORS_OPTS", "bin_annot_opts", "cmt_entries", "profile_warning_opts")

package(default_visibility = ["//ocaml:__subpackages__", "//tools/ci:__pkg__", "//:__pkg__"])

exports_files([
    "dune.bzl",
    "providers.bzl",
    "defs.bzl",
    "kwargs.bzl",
])

dx_wrapper_contract_tests(
    name = "wrapper_contract_tests",
    extra_checks = [
        expect_equal(
            "coverage instruments a hand-written module with a select",
            type(ocaml_coverage_kwargs({}, "a.ml", "p")["ppx"]),
            "select",
        ),
        expect_equal(
            "coverage leaves a module with its own ppx alone",
            ocaml_coverage_kwargs(
                {"ppx": "//x:y"},
                "a.ml",
                "p",
            ),
            {"ppx": "//x:y"},
        ),
        expect_equal(
            "coverage_ppx keeps the module's ppx and adds only the file name, runtime and unused-open waiver",
            sorted(ocaml_coverage_kwargs(
                {"ppx": "//x:y"},
                "a.ml",
                "p",
                True,
            ).keys()),
            [
                "deps",
                "opts",
                "ppx",
                "ppx_args",
            ],
        ),
        expect_equal(
            "coverage_ppx keeps the module's own ppx",
            ocaml_coverage_kwargs(
                {"ppx": "//x:y"},
                "a.ml",
                "p",
                True,
            )["ppx"],
            "//x:y",
        ),
        expect_equal(
            "coverage skips a generated struct",
            ocaml_coverage_kwargs({}, ":lexer", "p"),
            {},
        ),
        expect_equal(
            "the native default builds bytecode",
            toolchain_choice("ocamlopt.opt", "vm"),
            "ocamlc.opt",
        ),
        expect_equal(
            "an explicit toolchain is kept",
            toolchain_choice("ocamlc.byte", "vm"),
            "ocamlc.byte",
        ),
        expect_equal(
            "the sys emitter builds native",
            toolchain_choice("ocamlopt.opt", "sys"),
            "ocamlopt.opt",
        ),
        expect_equal(
            "the sys emitter replaces the bytecode default",
            toolchain_choice("ocamlc.opt", "sys"),
            "ocamlopt.opt",
        ),
        expect_equal(
            "owned sources are .ml and .mli files",
            owned_sources("a.ml", ":sig", None, "b.mli"),
            [
                "a.ml",
                "b.mli",
            ],
        ),
        expect_equal(
            "tags pass through so typecheck covers OCaml",
            ocaml_with_defaults({"tags": ["x"]}).get("tags"),
            ["x"],
        ),
        expect_equal(
            "the guard stays with a user list",
            type(ocaml_with_defaults({"target_compatible_with": ["//x:y"]})["target_compatible_with"]),
            "select",
        ),
        expect_equal(
            "the guard stays with an empty list",
            type(ocaml_with_defaults({"target_compatible_with": []})["target_compatible_with"]),
            "select",
        ),
        expect_equal(
            "upstream actions stay local",
            ocaml_upstream_tags(None)[-1],
            "no-remote-exec",
        ),
        expect_equal(
            "binaries link without a runtime only for the vm emitter",
            type(ocaml_link_kwargs({"opts": ["-g"]})["opts"]),
            "select",
        ),
        expect_equal(
            "binaries without opts get the emitter select",
            type(ocaml_link_kwargs({})["opts"]),
            "select",
        ),
        expect_equal(
            "binaries keep the vm linkage",
            ocaml_link_kwargs({})["vm_linkage"],
            "dynamic",
        ),
        expect_equal(
            "configurable opts stay a select",
            type(ocaml_link_kwargs({"opts": select({"//conditions:default": ["-g"]})})["opts"]),
            "select",
        ),
        expect_equal(
            "test attributes stay on the forwarder",
            ocaml_test_upstream_kwargs({
                "main": ":m",
                "size": "small",
            }),
            {"main": ":m"},
        ),
        expect_equal(
            "testonly is set by ocaml_test, not passed upstream",
            ocaml_test_upstream_kwargs({
                "main": ":m",
                "testonly": True,
            }),
            {"main": ":m"},
        ),
        expect_equal(
            "env and env_inherit leave the upstream binary",
            ocaml_test_upstream_kwargs(dx_test_upstream_kwargs({
                "env": {"K": "1"},
                "env_inherit": ["HOME"],
            })),
            {"tags": ["manual"], "visibility": ["//visibility:private"]},
        ),
        expect_equal(
            "env and env_inherit reach the test forwarder",
            dx_test_forward_kwargs({
                "env": {"K": "1"},
                "env_inherit": ["HOME"],
            }),
            {
                "size": "small",
                "env": {"K": "1"},
                "env_inherit": ["HOME"],
            },
        ),
        expect_equal(
            "a .mli sig keeps the target module name",
            ocaml_default_module_name("m", "m.mli"),
            "m",
        ),
        expect_equal(
            "a signature target sets the module name",
            ocaml_default_module_name("m", ":m_sig"),
            None,
        ),
        expect_equal(
            "a configurable sig leaves the module name upstream",
            ocaml_default_module_name(
                "m",
                select({"//conditions:default": "m.mli"}),
            ),
            None,
        ),
        expect_equal(
            "a Label sig leaves the module name upstream",
            ocaml_default_module_name(
                "m",
                label_string("//ocaml/private:m.mli"),
            ),
            None,
        ),
        expect_equal(
            "modules get -bin-annot",
            bin_annot_opts(None),
            ["-bin-annot"],
        ),
        expect_equal(
            "-bin-annot is appended once",
            bin_annot_opts([
                "-g",
                "-bin-annot",
            ]),
            [
                "-g",
                "-bin-annot",
            ],
        ),
        expect_equal(
            "-no-bin-annot opts out",
            bin_annot_opts(["-no-bin-annot"]),
            ["-no-bin-annot"],
        ),
        expect_equal(
            "standard keeps the usual set and drops shadowing and missing-interface warnings",
            STANDARD_WARNING_OPTS,
            [
                "-w",
                "+a-4-40-42-44-70",
            ],
        ),
        expect_equal(
            "strict enables shadowing warnings and drops the deprecated alert",
            STRICT_WARNING_OPTS,
            [
                "-w",
                "+a-4-70",
                "-alert",
                "-deprecated",
            ],
        ),
        expect_equal(
            "warnings become errors except 3",
            WARNINGS_AS_ERRORS_OPTS,
            [
                "-warn-error",
                "+a-3",
            ],
        ),
        expect_equal(
            "modules get the profile warnings as a select",
            type(profile_warning_opts(bin_annot_opts(None))),
            "select",
        ),
        expect_equal(
            "a target's own -w replaces the profile warnings",
            profile_warning_opts([
                "-w",
                "-27",
            ]),
            [
                "-w",
                "-27",
            ],
        ),
        expect_equal(
            "a struct and sig expose both",
            cmt_entries(
                [
                    fake_file(basename = "m.ml"),
                    fake_file(basename = "m.mli"),
                ],
                [fake_file(basename = "m.cmt")],
                [fake_file(basename = "m.cmti")],
            )[0].cmti,
            fake_file(basename = "m.cmti"),
        ),
        expect_equal(
            "the struct maps to its cmt",
            cmt_entries(
                [
                    fake_file(basename = "m.ml"),
                    fake_file(basename = "m.mli"),
                ],
                [fake_file(basename = "m.cmt")],
                [fake_file(basename = "m.cmti")],
            )[0].source,
            fake_file(basename = "m.ml"),
        ),
        expect_equal(
            "the opt-out exposes nothing",
            cmt_entries(
                [fake_file(basename = "m.ml")],
                [],
                [],
            ),
            [],
        ),
        expect_equal(
            "a signature alone maps to its cmti",
            cmt_entries(
                [fake_file(basename = "s.mli")],
                [],
                [fake_file(basename = "s.cmti")],
            )[0].signature,
            fake_file(basename = "s.mli"),
        ),
        expect_equal(
            "main repo runfiles",
            runfiles_path("_main", "pkg/app.bc"),
            "_main/pkg/app.bc",
        ),
        expect_equal(
            "external runfiles",
            runfiles_path("_main", "../repo/bin/ocamlrun"),
            "repo/bin/ocamlrun",
        ),
        expect_equal(
            "launcher runs bytecode on ocamlrun",
            launcher_script("r", "b").splitlines()[-1],
            'exec "$runfiles/r" "$runfiles/b" "$@"',
        ),
    ],
    file_classes = ["ocaml"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "dune.bzl",
        "kwargs.bzl",
        "providers.bzl",
        "wrapper_tests.bzl",
    ],
    tags = ["corpus"],
)
