load("@rules_dx//ocaml/private:dune.bzl", "dx_dune_build")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//core/quality:unavailable_tool.bzl", "dx_unavailable_tool")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":cmt_list.bzl", "ocaml_cmt_list")
load(":tools_tests.bzl", "ocaml_tools_tests")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["patches/*.patch"]) + [
    "cmt_list.bzl",
    "ocaml.bzl",
    "ocaml_tools.bzl",
    "repos.bzl",
    "tools_tests.bzl",
])

# zanuda 2.1.0, built from source with dune. Licensed LGPL-3.0-only; the
# licenses of the whole source closure are in :zanuda_licenses.
dx_dune_build(
    name = "zanuda",
    srcs = ["@dx_ocaml_tools_duniverse//:srcs"],
    dune = "//ocaml/private/toolchain:dune",
    target = "zanuda/src/main.exe",
    workspace = "@dx_ocaml_tools_duniverse//:dune-project",
)

# The aspect's tool attribute. The hermetic OCaml toolchain has no cell for most
# exec platforms, so the real zanuda resolves only where it is supported
# (linux_x86_64, linux_arm64, macos_arm64); elsewhere the alias selects a marked stub and the aspect skips
# the stage with a note.
alias(
    name = "zanuda_tool",
    actual = select({
        ":zanuda_linux_x86_64": ":zanuda",
        ":zanuda_linux_arm64": ":zanuda",
        ":zanuda_macos_arm64": ":zanuda",
        "//conditions:default": ":zanuda_unsupported",
    }),
)

config_setting(
    name = "zanuda_linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "zanuda_linux_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "zanuda_macos_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
)

dx_unavailable_tool(
    name = "zanuda_unsupported",
    tool = "zanuda",
)

filegroup(
    name = "zanuda_licenses",
    srcs = ["@dx_ocaml_tools_duniverse//:licenses"],
)

ocaml_tools_tests(name = "pins_test")

ocaml_cmt_list(
    name = "dirty_cmts",
    testonly = True,
    target = "//ocaml/private/quality/testdata:dirty",
)

ocaml_cmt_list(
    name = "clean_cmts",
    testonly = True,
    target = "//ocaml/private/quality/testdata:clean",
)

sh_test(
    name = "zanuda_test",
    size = "small",
    srcs = ["zanuda_test.sh"],
    args = [
        "$(rootpath :zanuda)",
        "$(rootpath :dirty_cmts)",
        "$(rootpath :clean_cmts)",
        "$(rootpath @dx_ocaml_toolchains//:stdlib_cmi)",
    ],
    data = [
        ":clean_cmts",
        ":dirty_cmts",
        ":zanuda",
        "@dx_ocaml_toolchains//:stdlib_cmi",
        "@dx_ocaml_toolchains//:stdlib_cmis",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "ocaml.bzl",
        "ocaml_tools.bzl",
        "cmt_list.bzl",
        "repos.bzl",
        "tools_tests.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
    ]),
    visibility = ["//:__subpackages__"],
)
