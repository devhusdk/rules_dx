 let set_plugin_name_suffix s = opts.plugin_name_suffix <- Some s
 let plugin_name_suffix () = opts.plugin_name_suffix
 
+(** Paths the typed tree names (the compile-time source path) that [-cmt-list] reports
+    under the path the list gives instead. *)
+let source_aliases : (string, string) Hashtbl.t = Hashtbl.create 16
+
+let add_source_alias ~compiled ~listed =
+  if compiled <> listed then Hashtbl.replace source_aliases compiled listed
+;;
+
 let recover_filepath filepath =
   let filepath =
+    match Hashtbl.find_opt source_aliases filepath with
+    | Some listed -> listed
+    | None -> filepath
+  in
+  let filepath =
     match prefix_to_cut () with
     | Some prefix when String.starts_with filepath ~prefix ->
       Base.String.drop_prefix filepath (String.length prefix)
