load("@rules_dx//core:cells.bzl", "cell_setting")
load("@rules_dx//core:platform_support.bzl", "lang_cells")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//ocaml/private:kwargs.bzl", "OCAML_COMPATIBLE_WITH")

package(default_visibility = ["//:__subpackages__"])

alias(
    name = "opam_binary",
    actual = select({cell_setting("//ocaml/private/toolchain", cell): "@opam_%s//file" % cell for cell in lang_cells("ocaml")}),
    target_compatible_with = OCAML_COMPATIBLE_WITH,
)

sh_binary(
    name = "opam",
    srcs = ["opam.sh"],
    args = [
        "$(rlocationpath :opam_binary)",
        "$(rlocationpath @dx_opam_repository//:repo)",
    ],
    data = [
        ":opam_binary",
        "@dx_opam_repository//:repo",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
