load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//ocaml:defs.bzl", "ocaml_binary", "ocaml_module", "ocaml_test")
load("//ocaml/private:defs.bzl", "OCAML_COMPATIBLE_WITH")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "subject_compatible_with")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

ocaml_module(
    name = "greet",
    struct = "greet.ml",
    target_compatible_with = OCAML_COMPATIBLE_WITH,
)

ocaml_module(
    name = "lint_dirty",
    struct = "lint_dirty.ml",
    tags = ["manual"],
    target_compatible_with = OCAML_COMPATIBLE_WITH,
)

ocaml_module(
    name = "format_dirty",
    struct = "format_dirty.ml",
    tags = ["manual"],
    target_compatible_with = OCAML_COMPATIBLE_WITH,
)

ocaml_module(
    name = "main",
    struct = "main.ml",
    target_compatible_with = OCAML_COMPATIBLE_WITH,
    deps = [":greet"],
)

ocaml_binary(
    name = "hello",
    main = ":main",
    target_compatible_with = OCAML_COMPATIBLE_WITH,
)

ocaml_module(
    name = "lock_main",
    struct = "lock_main.ml",
    target_compatible_with = OCAML_COMPATIBLE_WITH,
    deps = ["@ocaml_app//astring"],
)

ocaml_binary(
    name = "lock_hello",
    main = ":lock_main",
    target_compatible_with = OCAML_COMPATIBLE_WITH,
)

ocaml_module(
    name = "runfiles_main",
    struct = "runfiles_main.ml",
    target_compatible_with = OCAML_COMPATIBLE_WITH,
)

ocaml_binary(
    name = "runfiles_hello",
    data = ["data.txt"],
    main = ":runfiles_main",
    target_compatible_with = OCAML_COMPATIBLE_WITH,
)

ocaml_module(
    name = "passing",
    struct = "passing.ml",
    target_compatible_with = OCAML_COMPATIBLE_WITH,
    deps = [":greet"],
)

ocaml_module(
    name = "failing",
    struct = "failing.ml",
    target_compatible_with = OCAML_COMPATIBLE_WITH,
    deps = [":greet"],
)

ocaml_test(
    name = "pass_subject_test",
    size = "small",
    main = ":passing",
    target_compatible_with = subject_compatible_with() + OCAML_COMPATIBLE_WITH,
)

ocaml_test(
    name = "fail_subject_test",
    size = "small",
    main = ":failing",
    target_compatible_with = subject_compatible_with() + OCAML_COMPATIBLE_WITH,
)

dx_conformance_suite(
    name = "",
    size = "small",
    binary = ":hello",
    covered_source = "greet.ml",
    expected = "hello world",
    failing_case = "failing_case",
    failing_pattern = "{case}",
    failing_test = ":fail_subject_test",
    lang = "ocaml",
    lock = {
        "binary": ":lock_hello",
        "ecosystem": "ocaml",
        "expected": "hello lock",
        "lockfile": "//ocaml/tests/fixtures/ocaml_app:ocaml_app.opam.locked",
        "manifest": "//ocaml/tests/fixtures/ocaml_app:ocaml_app.opam",
        "package": "astring",
        "stale": "ocaml_app.opam.stale.locked",
    },
    not_applicable = {
        "lint_error_test:windows_x86_64": "zanuda has no Windows build",
        "lint_test:windows_x86_64": "zanuda has no Windows build",
    },
    passing_test = ":pass_subject_test",
    quality = {
        "clean": ":greet",
        "format_dirty": ":format_dirty",
        "format_source": "format_dirty.ml",
        "lint_dirty": ":lint_dirty",
        "lint_line": 1,
        "lint_rule": "list_length_comparisons",
        "lint_source": "lint_dirty.ml",
    },
    runfiles = {
        "binary": ":runfiles_hello",
        "data": "data.txt",
        "expected": "hello runfiles",
    },
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
