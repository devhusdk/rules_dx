load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//core:fuzz_bench_tests.bzl", "dx_runner_attr_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//ocaml:defs.bzl", "OCAML_COMPATIBLE_WITH", "ocaml_bench")
load("//ocaml/tests:wrapper_tests.bzl", "ocaml_native_launcher_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

ocaml_bench(
    name = "sum_bench",
    target_compatible_with = OCAML_COMPATIBLE_WITH,
)

ocaml_native_launcher_test(
    name = "sum_bench_native_test",
    launcher = "sum_bench",
    target_under_test = ":sum_bench",
)

sh_test(
    name = "sum_bench_run_test",
    timeout = "short",
    srcs = ["run_test.sh"],
    args = ["$(rootpath :sum_bench)"],
    data = [":sum_bench"],
    target_compatible_with = OCAML_COMPATIBLE_WITH,
)

ocaml_bench(
    name = "sized_bench",
    size = "large",
    timeout = "long",
    main = "sum_bench.ml",
    target_compatible_with = OCAML_COMPATIBLE_WITH,
)

dx_runner_attr_test(
    name = "sized_bench_attrs",
    expected = {
        "size": "large",
        "timeout": "long",
    },
    runner = "sized_bench",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
