load("@rules_dx//ocaml/rules:defs.bzl", "ocaml_module", "ocaml_signature", "ocaml_test")
load("//quality:fixtures.bzl", "real_source_target")

_PUBLIC = ["//visibility:public"]

package(default_visibility = _PUBLIC)

exports_files(
    [
        "BUILD.bazel",
        "ledger.ml",
        "ledger.mli",
        "ledger_test.ml",
    ],
    visibility = ["//visibility:public"],
)

ocaml_signature(
    name = "ledger_sig",
    src = "ledger.mli",
)

ocaml_module(
    name = "ledger",
    sig = ":ledger_sig",
    struct = "ledger.ml",
    deps = [
        "//ocaml/tests/fixtures/ocaml-app/lexer:tokens",
        "@ocaml_app//:astring",
    ],
)

ocaml_module(
    name = "ledger_test_main",
    testonly = True,
    struct = "ledger_test.ml",
    deps = [":ledger"],
)

ocaml_test(
    name = "ledger_test",
    main = ":ledger_test_main",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
