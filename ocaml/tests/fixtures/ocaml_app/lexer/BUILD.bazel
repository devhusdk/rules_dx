load("@rules_dx//ocaml:defs.bzl", "ocaml_lex", "ocaml_module", "ocaml_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//ocaml/tests:wrapper_tests.bzl", "ocaml_compile_stages_runtime_libs_test")

_PUBLIC = ["//visibility:public"]

package(default_visibility = _PUBLIC)

exports_files(
    [
        "BUILD.bazel",
        "lexer_test.ml",
        "tokens.mll",
    ],
    visibility = ["//visibility:public"],
)

# Generated code: ocaml_lex turns tokens.mll into tokens.ml.
ocaml_lex(
    name = "tokens_ml",
    src = "tokens.mll",
    out = "tokens.ml",
    tags = ["manual"],
)

ocaml_module(
    name = "tokens",
    opts = [
        "-w",
        "-a",
    ],
    struct = ":tokens_ml",
)

ocaml_compile_stages_runtime_libs_test(
    name = "tokens_runtime_libs_test",
    target_under_test = ":tokens_upstream",
)

ocaml_module(
    name = "lexer_test_main",
    testonly = True,
    struct = "lexer_test.ml",
    deps = [":tokens"],
)

ocaml_test(
    name = "lexer_test",
    main = ":lexer_test_main",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
