load("//cc/rules:defs.bzl", "cc_library")
load("//ocaml/rules:defs.bzl", "ocaml_binary", "ocaml_module")
load("//ocaml/tests/negative:negative_tests.bzl", "ocaml_compile_input_test", "ocaml_hermetic_link_test")
load("//quality:fixtures.bzl", "real_source_target")

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "negative_tests.bzl",
    ],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

ocaml_module(
    name = "clean",
    struct = "clean.ml",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

ocaml_module(
    name = "undeclared_dep",
    struct = "user.ml",
    tags = ["manual"],
)

ocaml_module(
    name = "declared_dep",
    struct = "user.ml",
    tags = ["manual"],
    deps = [":clean"],
)

ocaml_compile_input_test(
    name = "undeclared_dep_is_not_a_compile_input_test",
    file = "Clean.cmi",
    present = False,
    target = ":undeclared_dep_upstream",
)

ocaml_compile_input_test(
    name = "declared_dep_is_a_compile_input_test",
    file = "Clean.cmi",
    present = True,
    target = ":declared_dep_upstream",
)

cc_library(
    name = "stub",
    testonly = True,
    srcs = ["stub.c"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

ocaml_module(
    name = "binding",
    cc_deps = {":stub": "static"},
    struct = "binding.ml",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

ocaml_binary(
    name = "app",
    main = ":binding",
    tags = ["manual"],
)

ocaml_hermetic_link_test(
    name = "native_link_uses_hermetic_c_tools_test",
    target = ":app_upstream",
)
