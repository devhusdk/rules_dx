load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("//quality:fixtures.bzl", "real_source_target")
load(":metadata_tests.bzl", "ocaml_metadata_tests")

package(default_visibility = ["//visibility:public"])

exports_files([
    "metadata_tests.bzl",
    "ocaml.bzl",
    "pins.bzl",
    "repos.bzl",
])

ocaml_metadata_tests(name = "metadata")

string_flag(
    name = "emitter",
    build_setting_default = "vm",
    values = [
        "sys",
        "vm",
    ],
)

config_setting(
    name = "emitter_sys",
    flag_values = {":emitter": "sys"},
)

config_setting(
    name = "emitter_vm",
    flag_values = {":emitter": "vm"},
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "metadata_tests.bzl",
        "ocaml.bzl",
        "pins.bzl",
        "repos.bzl",
    ],
    tags = ["corpus"],
)
