+_WINDOWS_RUN_PY = """
+import os
+import runpy
+import site
+import sys
+
+VENV_RLOCATION = "{{VENV_RLOCATION}}"
+SITE_PACKAGES = "{{SITE_PACKAGES}}"
+INCLUDE_SYSTEM_SITE_PACKAGES = {{INCLUDE_SYSTEM_SITE_PACKAGES}}
+
+
+def runfiles_root():
+    root = os.environ.get("RUNFILES_DIR")
+    if root and os.path.isdir(root):
+        return root
+    manifest = os.environ.get("RUNFILES_MANIFEST_FILE")
+    if manifest:
+        if manifest.endswith(".runfiles_manifest"):
+            root = manifest[: -len("_manifest")]
+        else:
+            root = os.path.dirname(manifest)
+        if os.path.isdir(root):
+            return root
+    return None
+
+
+def activate(root):
+    venv = os.path.normpath(os.path.join(root, VENV_RLOCATION))
+    site_packages = os.path.join(venv, SITE_PACKAGES)
+    if not os.path.isdir(site_packages):
+        return False
+    if not INCLUDE_SYSTEM_SITE_PACKAGES:
+        base = set(
+            os.path.normcase(os.path.normpath(p))
+            for p in site.getsitepackages([sys.base_prefix])
+            if os.path.basename(os.path.normpath(p)).lower() == "site-packages"
+        )
+        sys.path[:] = [p for p in sys.path if os.path.normcase(os.path.normpath(p)) not in base]
+    sys.prefix = venv
+    sys.exec_prefix = venv
+    site.addsitedir(site_packages)
+    return True
+
+
+def main():
+    if len(sys.argv) < 2:
+        sys.stderr.write("run.py: missing main script argument\\n")
+        return 2
+    root = runfiles_root()
+    if root is None or not activate(root):
+        sys.stderr.write("run.py: no runfiles tree with venv " + VENV_RLOCATION + " found; Windows Python binaries need --enable_runfiles\\n")
+        return 2
+    script = sys.argv[1]
+    if sys.path and not sys.flags.isolated and not getattr(sys.flags, "safe_path", False):
+        sys.path[0] = os.path.dirname(os.path.abspath(script))
+    sys.argv[:] = sys.argv[1:]
+    runpy.run_path(script, run_name="__main__")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
+"""
+
 def _dict_to_exports(env):
