diff --git a/py/private/py_venv/templates/windows_venv_launcher.py b/py/private/py_venv/templates/windows_venv_launcher.py
new file mode 100644
index 0000000..eed35d6
--- /dev/null
+++ b/py/private/py_venv/templates/windows_venv_launcher.py
@@ -0,0 +1,196 @@
+"""Windows launcher for rules_py venvs.
+
+Runs under the toolchain `python.exe` (started by a hermetic-launcher stub).
+Two modes, selected by the first argument:
+
+    windows_venv_launcher.py <venv-python-rlocation> <python args...>
+        Re-run: start the toolchain python again with `__PYVENV_LAUNCHER__`
+        pointing at the venv's `bin/python.exe`, which makes it a venv
+        interpreter. Used by the venv's own `bin/python.exe` stub.
+
+    windows_venv_launcher.py --run <venv-python-rlocation> <main> <args...>
+        In-process: set up the venv inside this one process and run `main`.
+        Used by `py_binary` launchers so that the process tree is
+        stub -> python, which lets the watchdog below see the stub die.
+
+On Windows a watchdog thread waits on the parent process. When the parent is
+killed (the hermetic-launcher stub uses no job object, so its child is
+orphaned), the watchdog stops the work and exits.
+"""
+
+import os
+import runpy
+import signal
+import site
+import subprocess
+import sys
+
+BACKSLASH = chr(92)
+
+
+def start_watchdog(on_parent_death):
+    """Windows only: run `on_parent_death` then exit when the parent dies."""
+    if os.name != "nt":
+        return
+    import ctypes
+    import threading
+    from ctypes import wintypes
+
+    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+    kernel32.OpenProcess.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.DWORD]
+    kernel32.OpenProcess.restype = wintypes.HANDLE
+    kernel32.WaitForSingleObject.argtypes = [wintypes.HANDLE, wintypes.DWORD]
+    kernel32.WaitForSingleObject.restype = wintypes.DWORD
+    synchronize = 0x00100000
+    infinite = 0xFFFFFFFF
+    handle = kernel32.OpenProcess(synchronize, False, os.getppid())
+    if not handle:
+        return
+
+    def watch():
+        kernel32.WaitForSingleObject(handle, infinite)
+        try:
+            on_parent_death()
+        finally:
+            os._exit(1)
+
+    threading.Thread(target=watch, daemon=True).start()
+
+
+def is_venv(python):
+    return bool(python) and os.path.isfile(os.path.join(venv_root(python), "pyvenv.cfg"))
+
+
+def venv_root(python):
+    return os.path.dirname(os.path.dirname(python))
+
+
+def unescape(text):
+    return text.replace(BACKSLASH + "s", " ").replace(BACKSLASH + "n", chr(10)).replace(BACKSLASH + "b", BACKSLASH)
+
+
+def manifest_entries(manifest):
+    entries = {}
+    with open(manifest, encoding="utf-8") as lines:
+        for line in lines:
+            line = line.rstrip(chr(10))
+            if line.startswith(" "):
+                key, _, value = line[1:].partition(" ")
+                entries[unescape(key)] = unescape(value)
+            else:
+                key, _, value = line.partition(" ")
+                entries[key] = value
+    return entries
+
+
+def site_packages_dir(venv_python):
+    return os.path.join(venv_root(venv_python), "Lib", "site-packages")
+
+
+def pth_imports(site_packages):
+    imports = []
+    for name in sorted(os.listdir(site_packages)):
+        if not name.endswith(".pth"):
+            continue
+        with open(os.path.join(site_packages, name), encoding="utf-8") as lines:
+            for line in lines:
+                line = line.strip()
+                if not line.startswith("../"):
+                    continue
+                while line.startswith("../"):
+                    line = line[3:]
+                if line and line not in imports:
+                    imports.append(line)
+    return imports
+
+
+def import_dirs(entries, venv_python):
+    dirs = []
+    for imp in pth_imports(site_packages_dir(venv_python)):
+        for key, value in entries.items():
+            if not key.startswith(imp + "/"):
+                continue
+            rest = key[len(imp):]
+            value = value.replace(BACKSLASH, "/")
+            if value.endswith(rest):
+                found = os.path.normpath(value[: -len(rest)])
+                if found not in dirs:
+                    dirs.append(found)
+    return dirs
+
+
+def locate_venv(rlocation):
+    """Returns (venv_python, extra_import_dirs); exits with 2 when missing."""
+    runfiles = os.environ.get("RUNFILES_DIR", "")
+    manifest = os.environ.get("RUNFILES_MANIFEST_FILE", "")
+    if not runfiles and manifest:
+        if manifest.endswith("_manifest"):
+            runfiles = manifest[: -len("_manifest")]
+        else:
+            runfiles = os.path.dirname(manifest)
+    venv_python = os.path.normpath(os.path.join(runfiles, rlocation)) if runfiles else ""
+    extra = []
+    if not is_venv(venv_python) and os.path.isfile(manifest):
+        entries = manifest_entries(manifest)
+        venv_python = os.path.normpath(entries.get(rlocation, ""))
+        if is_venv(venv_python):
+            extra = import_dirs(entries, venv_python)
+    if not is_venv(venv_python):
+        sys.stderr.write("venv not found in the runfiles: " + rlocation + chr(10))
+        sys.exit(2)
+    return venv_python, extra
+
+
+def include_system_site_packages(root):
+    with open(os.path.join(root, "pyvenv.cfg"), encoding="utf-8") as lines:
+        for line in lines:
+            key, _, value = line.partition("=")
+            if key.strip() == "include-system-site-packages":
+                return value.strip().lower() == "true"
+    return False
+
+
+def rerun(rlocation, python_args, children):
+    venv_python, extra = locate_venv(rlocation)
+    signal.signal(signal.SIGINT, signal.SIG_IGN)
+    env = dict(os.environ)
+    env["__PYVENV_LAUNCHER__"] = venv_python
+    env["RULES_PY_VENV_PATHS"] = os.pathsep.join(extra)
+    child = subprocess.Popen([sys.executable] + python_args, env=env)
+    children.append(child)
+    sys.exit(child.wait())
+
+
+def run(rlocation, main, args):
+    venv_python, extra = locate_venv(rlocation)
+    root = venv_root(venv_python)
+    base_site_packages = os.path.normcase(os.path.join(sys.base_prefix, "Lib", "site-packages"))
+    if not include_system_site_packages(root):
+        sys.path[:] = [p for p in sys.path if os.path.normcase(p) != base_site_packages]
+    sys.prefix = sys.exec_prefix = root
+    sys.executable = venv_python
+    site.addsitedir(site_packages_dir(venv_python))
+    sys.path.extend(p for p in extra if p not in sys.path)
+    if not sys.flags.isolated and sys.path:
+        # sys.path[0] is this launcher's directory; Python would have put
+        # the main script's directory there.
+        sys.path[0] = os.path.dirname(os.path.abspath(main))
+    sys.argv = [main] + args
+    runpy.run_path(main, run_name="__main__")
+
+
+def entry(argv):
+    # Open the parent handle before anything else so a recycled pid cannot
+    # be mistaken for the launcher stub.
+    children = []
+    start_watchdog(lambda: [child.kill() for child in children])
+    if len(argv) >= 4 and argv[1] == "--run":
+        run(argv[2], argv[3], argv[4:])
+    elif len(argv) >= 2:
+        rerun(argv[1], argv[2:], children)
+    else:
+        sys.exit("usage: windows_venv_launcher.py [--run] <venv-python> ...")
+
+
+if __name__ == "__main__":
+    entry(sys.argv)
