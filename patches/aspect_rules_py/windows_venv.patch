+_WINDOWS_VENV_LAUNCHER = """import os
+import signal
+import subprocess
+import sys
+
+runfiles = os.environ.get("RUNFILES_DIR", "")
+if not runfiles:
+    manifest = os.environ.get("RUNFILES_MANIFEST_FILE", "")
+    if manifest.endswith("_manifest"):
+        runfiles = manifest[: -len("_manifest")]
+    else:
+        runfiles = os.path.dirname(manifest)
+venv_python = os.path.normpath(os.path.join(runfiles, sys.argv[1]))
+if not os.path.isfile(os.path.join(os.path.dirname(os.path.dirname(venv_python)), "pyvenv.cfg")):
+    sys.exit("venv not found in the runfiles tree: " + venv_python)
+signal.signal(signal.SIGINT, signal.SIG_IGN)
+env = dict(os.environ)
+env["__PYVENV_LAUNCHER__"] = venv_python
+sys.exit(subprocess.call([sys.executable] + sys.argv[2:], env=env))
+"""
+
+def _windows_target_path(ctx, out, tree, rfpath, cache):
+    """Execroot-relative symlink target for a runfiles path inside a wheel install tree."""
+    if tree == None:
+        return None
+    root = cache.get(tree)
+    if root == None:
+        root = to_rlocation_path(ctx, tree)
+        cache[tree] = root
+    if not rfpath.startswith(root + "/"):
+        return None
+    return "../" * len(out.dirname.split("/")) + tree.path + rfpath[len(root):]
+
 def _dict_to_exports(env):
     return ["export %s=\"%s\"" % (k, v) for (k, v) in env.items()]
 
