+_WINDOWS_VENV_LAUNCHER = """import os
+import signal
+import subprocess
+import sys
+
+BACKSLASH = chr(92)
+
+
+def is_venv(python):
+    return bool(python) and os.path.isfile(os.path.join(os.path.dirname(os.path.dirname(python)), "pyvenv.cfg"))
+
+
+def unescape(text):
+    return text.replace(BACKSLASH + "s", " ").replace(BACKSLASH + "n", chr(10)).replace(BACKSLASH + "b", BACKSLASH)
+
+
+def manifest_entries(manifest):
+    entries = {}
+    with open(manifest, encoding="utf-8") as lines:
+        for line in lines:
+            line = line.rstrip(chr(10))
+            if line.startswith(" "):
+                key, _, value = line[1:].partition(" ")
+                entries[unescape(key)] = unescape(value)
+            else:
+                key, _, value = line.partition(" ")
+                entries[key] = value
+    return entries
+
+
+def pth_imports(site_packages):
+    imports = []
+    for name in sorted(os.listdir(site_packages)):
+        if not name.endswith(".pth"):
+            continue
+        with open(os.path.join(site_packages, name), encoding="utf-8") as lines:
+            for line in lines:
+                line = line.strip()
+                if not line.startswith("../"):
+                    continue
+                while line.startswith("../"):
+                    line = line[3:]
+                if line and line not in imports:
+                    imports.append(line)
+    return imports
+
+
+def import_dirs(entries, venv_python):
+    site_packages = os.path.join(os.path.dirname(os.path.dirname(venv_python)), "Lib", "site-packages")
+    dirs = []
+    for imp in pth_imports(site_packages):
+        for key, value in entries.items():
+            if not key.startswith(imp + "/"):
+                continue
+            rest = key[len(imp):]
+            value = value.replace(BACKSLASH, "/")
+            if value.endswith(rest):
+                found = os.path.normpath(value[: -len(rest)])
+                if found not in dirs:
+                    dirs.append(found)
+    return dirs
+
+
+rlocation = sys.argv[1]
+runfiles = os.environ.get("RUNFILES_DIR", "")
+manifest = os.environ.get("RUNFILES_MANIFEST_FILE", "")
+if not runfiles and manifest:
+    if manifest.endswith("_manifest"):
+        runfiles = manifest[: -len("_manifest")]
+    else:
+        runfiles = os.path.dirname(manifest)
+venv_python = os.path.normpath(os.path.join(runfiles, rlocation)) if runfiles else ""
+extra = []
+if not is_venv(venv_python) and os.path.isfile(manifest):
+    entries = manifest_entries(manifest)
+    venv_python = os.path.normpath(entries.get(rlocation, ""))
+    if is_venv(venv_python):
+        extra = import_dirs(entries, venv_python)
+if not is_venv(venv_python):
+    sys.exit("venv not found in the runfiles: " + rlocation)
+signal.signal(signal.SIGINT, signal.SIG_IGN)
+env = dict(os.environ)
+env["__PYVENV_LAUNCHER__"] = venv_python
+env["RULES_PY_VENV_PATHS"] = os.pathsep.join(extra)
+sys.exit(subprocess.call([sys.executable] + sys.argv[2:], env=env))
+"""
+
+_WINDOWS_PATHS_LINE = (
+    "import os, sys; " +
+    "sys.path.extend(p for p in os.environ.pop(\"RULES_PY_VENV_PATHS\", \"\").split(os.pathsep) if p)"
+)
+
+def _windows_target_path(ctx, out, tree, rfpath, cache):
+    """Execroot-relative symlink target for a runfiles path inside a wheel install tree."""
+    if tree == None:
+        return None
+    root = cache.get(tree)
+    if root == None:
+        root = to_rlocation_path(ctx, tree)
+        cache[tree] = root
+    if not rfpath.startswith(root + "/"):
+        return None
+    return "../" * len(out.dirname.split("/")) + tree.path + rfpath[len(root):]
+
 def _dict_to_exports(env):
     return ["export %s=\"%s\"" % (k, v) for (k, v) in env.items()]
 
