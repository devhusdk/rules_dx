load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")
load(":fuzzer_build.bzl", "fuzzer_build")

rust_test(
    name = "libunwind_copy_test",
    size = "small",
    srcs = ["libunwind_copy_test.rs"],
    data = ["@llvm-project//libunwind:libunwind.static.gnu_link_name"],
    target_compatible_with = ["@platforms//os:linux"],
    env = {"DX_LIBUNWIND": "$(rootpath @llvm-project//libunwind:libunwind.static.gnu_link_name)"},
    deps = ["//tools/testing:dx_testing"],
)

rust_test(
    name = "msvc_source_directories_test",
    size = "small",
    srcs = ["msvc_source_directories_test.rs"],
    data = ["@llvm//runtimes/msvc:BUILD.bazel"],
    target_compatible_with = ["@platforms//os:linux"],
    env = {"DX_MSVC_RUNTIMES_BUILD": "$(rootpath @llvm//runtimes/msvc:BUILD.bazel)"},
    deps = ["//tools/testing:dx_testing"],
)

rust_test(
    name = "msvc_fuzzer_test",
    size = "small",
    srcs = ["msvc_fuzzer_test.rs"],
    data = ["//patches/llvm:msvc_fuzzer.patch"],
    env = {"DX_MSVC_FUZZER_PATCH": "$(rootpath //patches/llvm:msvc_fuzzer.patch)"},
    deps = ["//tools/testing:dx_testing"],
)

fuzzer_build(
    name = "msvc_fuzzer_runtimes",
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        "@llvm//runtimes:resource_directory_default",
        "@llvm//runtimes/compiler-rt:clang_rt.fuzzer.static",
        "@llvm//runtimes/compiler-rt:clang_rt.fuzzer_interceptors.static",
        "@llvm//runtimes/compiler-rt:clang_rt.fuzzer_no_main.static",
    ],
)

platform_transition_filegroup(
    name = "aarch64_builtins",
    srcs = ["@llvm-project//compiler-rt:clang_rt.builtins.static"],
    target_compatible_with = ["@platforms//os:linux"],
    target_platform = "@llvm//platforms:linux_aarch64",
)

rust_test(
    name = "lse_atomic_sources_test",
    size = "small",
    srcs = ["lse_atomic_sources_test.rs"],
    data = [":aarch64_builtins"],
    target_compatible_with = ["@platforms//os:linux"],
    env = {"DX_AARCH64_BUILTINS": "$(rootpath :aarch64_builtins)"},
    deps = ["//tools/testing:dx_testing"],
)

rust_test(
    name = "macos_sdk_symlinks_test",
    size = "small",
    srcs = ["macos_sdk_symlinks_test.rs"],
    data = ["@macos_sdk//sysroot"],
    target_compatible_with = ["@platforms//os:linux"],
    env = {"DX_MACOS_SYSROOT": "$(rootpath @macos_sdk//sysroot)"},
    deps = ["//tools/testing:dx_testing"],
)

test_suite(
    name = "stage0_features_test",
    tests = ["@llvm//tests/stage0_features:stage0_features_test"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "fuzzer_build.bzl",
    ],
    tags = ["corpus"],
)
