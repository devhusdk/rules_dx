diff --git a/3rd_party/llvm-project/x.x/compiler-rt/lse_variants.bzl b/3rd_party/llvm-project/x.x/compiler-rt/lse_variants.bzl
new file mode 100644
index 0000000..b275140
--- /dev/null
+++ b/3rd_party/llvm-project/x.x/compiler-rt/lse_variants.bzl
@@ -0,0 +1,33 @@
+"""
+The aarch64 outline atomic helpers built from lib/builtins/aarch64/lse.S.
+
+Each (pat, size, model) gets its own lse_<pat>_<size>_<model>.S copy, written
+when llvm-project is fetched, so cc_static_library sees distinct object names.
+"""
+
+LSE_ATOMIC_VARIANTS = [
+    (pat, size, model)
+    for pat in [
+        "cas",
+        "swp",
+        "ldadd",
+        "ldclr",
+        "ldeor",
+        "ldset",
+    ]
+    for size in [
+        1,
+        2,
+        4,
+        8,
+        16,
+    ]
+    for model in [
+        1,
+        2,
+        3,
+        4,
+        5,
+    ]
+    if pat == "cas" or size != 16
+]
