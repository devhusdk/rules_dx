+/// Converts the VM service coverage `package:test --coverage` writes into LCOV.
+///
+/// Sources are reported as the VM names them: `org-dartlang-root:///<path>` for
+/// files of the workspace and `package:<name>/<path>` for libraries. The `dart:`
+/// core libraries and the test bootstrap are left out.
+String lcovFromCoverage(List<String> documents) {
+  final hits = <String, Map<int, int>>{};
+  for (final document in documents) {
+    final decoded = jsonDecode(document);
+    if (decoded is! Map<String, dynamic>) continue;
+    for (final entry in (decoded['coverage'] as List? ?? const [])) {
+      final source = (entry as Map<String, dynamic>)['source'] as String;
+      final reportable =
+          source.startsWith('org-dartlang-root:///') ||
+          source.startsWith('package:');
+      if (!reportable || source.endsWith('.vm_test.dart')) continue;
+      final lines = hits.putIfAbsent(source, () => {});
+      final pairs = (entry['hits'] as List).cast<int>();
+      for (var i = 0; i + 1 < pairs.length; i += 2) {
+        if (pairs[i + 1] > (lines[pairs[i]] ?? -1)) {
+          lines[pairs[i]] = pairs[i + 1];
+        }
+      }
+    }
+  }
+  final out = StringBuffer();
+  for (final source in hits.keys.toList()..sort()) {
+    final lines = hits[source]!;
+    final numbers = lines.keys.toList()..sort();
+    out.writeln('SF:$source');
+    for (final line in numbers) {
+      out.writeln('DA:$line,${lines[line]}');
+    }
+    out
+      ..writeln('LF:${numbers.length}')
+      ..writeln('LH:${numbers.where((line) => lines[line]! > 0).length}')
+      ..writeln('end_of_record');
+  }
+  return out.toString();
+}
+
