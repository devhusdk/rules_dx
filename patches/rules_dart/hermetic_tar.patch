 make_dart_library_build_content = _make_dart_library_build_content
 
+# Host platform -> pinned bsdtar binary. Kept in one helper so other rule sets
+# that extract pub archives can reuse it. No fallback to an ambient `tar`.
+_BSDTAR = {
+    "darwin_amd64": Label("@bsd_tar_toolchains_darwin_amd64//:tar"),
+    "darwin_arm64": Label("@bsd_tar_toolchains_darwin_arm64//:tar"),
+    "linux_amd64": Label("@bsd_tar_toolchains_linux_amd64//:tar"),
+    "linux_arm64": Label("@bsd_tar_toolchains_linux_arm64//:tar"),
+    "windows_amd64": Label("@bsd_tar_toolchains_windows_amd64//:tar.exe"),
+    "windows_arm64": Label("@bsd_tar_toolchains_windows_arm64//:tar.exe"),
+}
+
+def _bsdtar_path(ctx):
+    os_name = ctx.os.name.lower()
+    if os_name.startswith("mac os"):
+        os_key = "darwin"
+    elif os_name.startswith("windows"):
+        os_key = "windows"
+    elif os_name == "linux":
+        os_key = "linux"
+    else:
+        os_key = os_name
+    arch = ctx.os.arch.lower()
+    if arch in ("amd64", "x86_64", "x64"):
+        arch_key = "amd64"
+    elif arch in ("aarch64", "arm64"):
+        arch_key = "arm64"
+    else:
+        arch_key = arch
+    label = _BSDTAR.get("{}_{}".format(os_key, arch_key))
+    if not label:
+        fail("rules_dart: no pinned bsdtar for host os={} arch={}".format(ctx.os.name, ctx.os.arch))
+    return str(ctx.path(label))
+
