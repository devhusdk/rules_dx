diff -ruN a/dotnet/private/compiler_wrapper.bat b/dotnet/private/compiler_wrapper.bat
--- a/dotnet/private/compiler_wrapper.bat
+++ b/dotnet/private/compiler_wrapper.bat
@@ -26,6 +26,8 @@
 shift
 if [%1]==[] goto afterloop
 set args=%args% %1
+set "arg=%~1"
+if "!arg:~0,1!"=="@" set "PARAMS=!arg:~1!"
 goto loop
 :afterloop
 
@@ -35,4 +37,44 @@
   set args=!args:"=\"!
 )
 
-"%DOTNET_EXECUTABLE%" %args% %PATHMAP%
+rem fsc sizes the PE debug directory from the absolute pdb path before the
+rem pathmap applies, so the pdb path needs a root whose length does not follow
+rem the exec root. Bazel points TEMP into the output base, so the junction
+rem lives under %SystemRoot%\Temp with a fixed-length name instead.
+set PDB_ARG=
+set LINK_DIR=
+if not "%COMPILER_BASENAME%" == "fsc.dll" goto run
+if not defined PARAMS goto run
+set TRIES=0
+:mkroot
+set /a TRIES+=1
+if !TRIES! gtr 20 (
+  echo compiler_wrapper: cannot create a directory under %SystemRoot%\Temp 1>&2
+  exit /b 1
+)
+set "N1=0000!RANDOM!"
+set "N2=0000!RANDOM!"
+set "LINK_DIR=%SystemRoot%\Temp\dx_fsc.!N1:~-5!!N2:~-5!"
+mkdir "!LINK_DIR!" 2>nul || goto mkroot
+mklink /J "!LINK_DIR!\r" "%cd%" >nul || (
+  rmdir "!LINK_DIR!"
+  exit /b 1
+)
+set "ROOT=!LINK_DIR!\r"
+for /f "usebackq delims=" %%L in ("!PARAMS!") do (
+  set "line=%%L"
+  if "!line:~0,6!"=="--pdb:" if not "!line:~7,1!"==":" (
+    set "rel=!line:~6!"
+    set PDB_ARG="--pdb:!ROOT!\!rel:/=\!"
+  )
+)
+set PATHMAP=%PATHMAP_FLAG%:"%cd%=.,!ROOT!=."
+
+:run
+"%DOTNET_EXECUTABLE%" %args% !PDB_ARG! %PATHMAP%
+set EXIT_CODE=!ERRORLEVEL!
+if defined LINK_DIR (
+  rmdir "!LINK_DIR!\r"
+  rmdir "!LINK_DIR!"
+)
+exit /b !EXIT_CODE!
diff -ruN a/dotnet/private/compiler_wrapper.sh b/dotnet/private/compiler_wrapper.sh
--- a/dotnet/private/compiler_wrapper.sh
+++ b/dotnet/private/compiler_wrapper.sh
@@ -15,5 +15,30 @@
 fi
 PATHMAP="$PATHMAP_FLAG:$PWD=."
 
+# fsc sizes the PE debug directory from the absolute pdb path before the
+# pathmap applies, so the pdb path needs a root whose length does not follow
+# the exec root. macOS has no /proc/self/cwd: a symlink in a mktemp directory
+# has a fixed-length name, and the pathmap hides its random part.
+if [[ $(basename "$COMPILER") == "fsc.dll" ]]; then
+  if [[ -d /proc/self/cwd ]]; then
+    ROOT=/proc/self/cwd
+  else
+    LINK_DIR=$(mktemp -d /tmp/dx_fsc.XXXXXXXX)
+    trap 'rm -f "$LINK_DIR/r"; rmdir "$LINK_DIR"' EXIT
+    ln -s "$PWD" "$LINK_DIR/r"
+    ROOT="$LINK_DIR/r"
+  fi
+  for arg in "$@"; do
+    if [[ "$arg" == @* ]]; then
+      while IFS= read -r line; do
+        if [[ "$line" == --pdb:* && "$line" != --pdb:/* ]]; then
+          set -- "$@" "--pdb:$ROOT/${line#--pdb:}"
+        fi
+      done <"${arg#@}"
+    fi
+  done
+  PATHMAP="$PATHMAP,$ROOT=."
+fi
+
 # shellcheck disable=SC2145
 ./"$@" "$PATHMAP"
