diff --git a/private/elixirc.exs b/private/elixirc.exs
new file mode 100644
--- /dev/null
+++ b/private/elixirc.exs
@@ -0,0 +1,37 @@
+{opts, files} =
+  OptionParser.parse!(System.argv(),
+    strict: [
+      output: :string,
+      warnings_as_errors: :boolean,
+      docs: :boolean,
+      debug_info: :boolean,
+      ignore_module_conflict: :boolean,
+      verbose: :boolean
+    ],
+    aliases: [o: :output]
+  )
+
+for key <- [:docs, :debug_info, :ignore_module_conflict], Keyword.has_key?(opts, key) do
+  Code.put_compiler_option(key, Keyword.fetch!(opts, key))
+end
+
+output = Keyword.fetch!(opts, :output)
+File.mkdir_p!(output)
+
+verbose =
+  if opts[:verbose] do
+    [each_file: &IO.puts("Compiling #{Path.relative_to_cwd(&1)}")]
+  else
+    []
+  end
+
+case Kernel.ParallelCompiler.compile_to_path(files, output, [return_diagnostics: true] ++ verbose) do
+  {:ok, _modules, %{compile_warnings: compile, runtime_warnings: runtime}} ->
+    if opts[:warnings_as_errors] && compile ++ runtime != [] do
+      IO.puts(:stderr, "Compilation failed due to warnings while using the --warnings-as-errors option")
+      System.halt(1)
+    end
+
+  {:error, _errors, _warnings} ->
+    System.halt(1)
+end
