+def _runfiles_dir(short_path, workspace_name):
+    """Returns the runfiles-relative directory holding a file, without a leading `../`."""
+    directory = short_path.rpartition("/")[0]
+    if directory.startswith("../"):
+        return directory.removeprefix("../")
+    return workspace_name + "/" + directory
