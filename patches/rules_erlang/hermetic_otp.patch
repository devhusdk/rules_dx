@@ -38,9 +38,15 @@
 def _build_info(ctx):
     return ctx.toolchains["//tools:toolchain_type"].otpinfo
 
+def _tree(info):
+    return getattr(info, "tree", None)
+
 def erlang_dirs(ctx):
     info = _build_info(ctx)
-    if info.release_dir_tar != None:
+    tree = _tree(info)
+    if tree != None:
+        runfiles = ctx.runfiles(transitive_files = tree)
+    elif info.release_dir_tar != None:
         runfiles = ctx.runfiles([
             info.release_dir_tar,
             info.version_file,
@@ -53,6 +59,9 @@
 
 def maybe_install_erlang(ctx, short_path = False):
     info = _build_info(ctx)
+    if _tree(info) != None:
+        root = info.version_file.short_path if short_path else info.version_file.path
+        return 'DX_ERLANG_HOME="$(cd "$(dirname "{}")" && pwd)"'.format(root)
     release_dir_tar = info.release_dir_tar
     if release_dir_tar == None:
         return ""
