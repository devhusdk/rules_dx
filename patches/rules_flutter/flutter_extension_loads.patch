+++ b/flutter/private/default_sdk.bzl
@@ -0,0 +1,11 @@
+"""The name of the default SDK, which the `flutter` and `pub` extensions share.
+
+It lives apart from pub_extension.bzl so that the `flutter` extension, which
+every module that depends on rules_flutter evaluates for its toolchains, loads
+no Apple, Swift or Android rules.
+"""
+
+visibility("//flutter/...")
+
+# The name of the SDK every build has: the default `flutter.toolchain`.
+DEFAULT_SDK_NAME = "flutter"
