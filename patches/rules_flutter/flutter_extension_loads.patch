diff --git a/flutter/private/default_sdk.bzl b/flutter/private/default_sdk.bzl
new file mode 100644
--- /dev/null
+++ b/flutter/private/default_sdk.bzl
@@ -0,0 +1,13 @@
+"""The default SDK name and the framework label, which the `flutter` and `pub` extensions share.
+
+They live apart from pub_extension.bzl so that the `flutter` extension, which
+every module that depends on rules_flutter evaluates for its toolchains, loads
+no Apple or Swift package rules.
+"""
+
+# The name of the SDK every build has: the default `flutter.toolchain`.
+DEFAULT_SDK_NAME = "flutter"
+
+def framework_json(framework):
+    """The label of `flutter_framework.json` in a framework source."""
+    return Label("@@{}//:flutter_framework.json".format(framework.repo_name))
