+++ b/flutter/private/required_sha256.bzl
@@ -0,0 +1,6 @@
+"""Rejects an engine artifact that has no sha256."""
+
+def required_sha256(sha256, what):
+    if not sha256:
+        fail("rules_flutter: no sha256 for %s" % what)
+    return sha256
