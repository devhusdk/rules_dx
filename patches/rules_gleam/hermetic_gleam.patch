+def module_name(ctx, src):
+    """Returns the Gleam module name one source file compiles to."""
+    return paths.replace_extension(strip_src_prefix(ctx, src.path), "").replace("/", "@")
+
+def runfiles_path(ctx, file):
+    """Returns one file's path below the runfiles root."""
+    if file.short_path.startswith("../"):
+        return file.short_path[3:]
+    return paths.join(ctx.workspace_name, file.short_path)
+
+def link_dep_beams(ctx, deps, own_dir):
+    """Symlinks every dependency .beam next to the executable's own modules."""
+    links = []
+    seen_beam_module = {}
+    for package in [dep[GleamErlPackageInfo] for dep in deps]:
+        for dep_beam_module in package.beam_module.to_list():
+            dir = paths.dirname(dep_beam_module.path)
+            base = paths.basename(dep_beam_module.path)
+            if base in seen_beam_module:
+                if seen_beam_module[base] != dir:
+                    fail("Beam module {MODULE} conflicts with {EXISTED}. gleam_erl_library() does not namespace modules; make the FFI module name unique.".format(
+                        MODULE = dep_beam_module.path,
+                        EXISTED = paths.join(seen_beam_module[base], base),
+                    ))
+                continue
+            seen_beam_module[base] = dir
+            if dir == own_dir:
+                links.append(dep_beam_module)
+                continue
+            link = ctx.actions.declare_file(paths.join(ctx.label.name, base))
+            ctx.actions.symlink(output = link, target_file = dep_beam_module)
+            links.append(link)
+    return links
+
+def write_entry_point(ctx, template, output, main_module):
+    """Writes the launcher that runs main_module on the toolchain erl from runfiles."""
+    ctx.actions.expand_template(
+        template = template,
+        output = output,
+        is_executable = True,
+        substitutions = {
+            "{PACKAGE}": main_module,
+            "{ERL}": runfiles_path(ctx, get_erl_binary(ctx)),
+            "{EBIN}": paths.dirname(runfiles_path(ctx, output)),
+        },
+    )
+
+def compile_package(ctx, lib_path):
+    """Returns the compile-package command, failing on warnings when warnings_as_errors is set."""
+    pin = """find . -name '*.gleam' -type l | while IFS= read -r src; do cp -L "$src" "$src.dx" && TZ=UTC touch -t 200001010000 "$src.dx" && mv -f "$src.dx" "$src"; done"""
+    command = "$COMPILER compile-package --package '.' --target erlang --out '.' --lib '%s'" % lib_path
+    if not ctx.attr.warnings_as_errors:
+        return pin + " && " + command
+    return pin + """ && (
+                    log="$(mktemp)"
+                    trap 'rm -f "$log"' EXIT
+                    if ! %s >"$log" 2>&1; then cat "$log" >&2; exit 1; fi
+                    cat "$log" >&2
+                    if grep -q '^warning' "$log"; then echo "error: Gleam warnings are errors for %s" >&2; exit 1; fi
+                )""" % (command, ctx.label)
+
 COMMON_ATTRS = {
     "strip_src_prefix": attr.string(
         doc = """Strip the prefix from the source path.
@@ -296,4 +349,5 @@ COMMON_ATTRS = {
         the current repository.""",
     ),
     "data": attr.label_list(doc = "The data available at runtime", allow_files = True),
+    "warnings_as_errors": attr.bool(doc = "Fail the compile when Gleam prints a warning."),
 }
