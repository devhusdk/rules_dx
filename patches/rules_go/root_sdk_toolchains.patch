+def _drop_shadowed_toolchains(toolchains, host_goos, host_goarch):
+    """Drops the non-root SDK toolchains for an exec platform that a root module SDK already covers."""
+
+    def platform(toolchain):
+        return (toolchain.goos or host_goos, toolchain.goarch or host_goarch)
+
+    root = {platform(toolchain): True for toolchain in toolchains if toolchain.root}
+    return [toolchain for toolchain in toolchains if toolchain.root or platform(toolchain) not in root]
