+def _exec_toolchain(ctx):
+    """The Julia toolchain of the execution platform, which runs build-time drivers.
+
+    Args:
+        ctx: Rule context.
+
+    Returns:
+        ToolchainInfo: The execution platform's Julia toolchain.
+    """
+    return ctx.attr._julia_toolchain_exec[platform_common.ToolchainInfo]
+
+def _is_cross(ctx, toolchain_info):
+    """Whether the target platform's Julia differs from the execution platform's.
+
+    Args:
+        ctx: Rule context.
+        toolchain_info (ToolchainInfo): The target platform's Julia toolchain.
+
+    Returns:
+        bool: True when the two toolchains carry different `julia` executables.
+    """
+    return _exec_toolchain(ctx).julia.short_path != toolchain_info.julia.short_path
