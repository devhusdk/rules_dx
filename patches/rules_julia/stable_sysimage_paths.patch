diff -ruN a/julia/private/rules_julia_common.jl b/julia/private/rules_julia_common.jl
--- a/julia/private/rules_julia_common.jl
+++ b/julia/private/rules_julia_common.jl
@@ -262,3 +262,45 @@
     end
     ccall(:_exit, Cvoid, (Cint,), status)
 end
+
+"""
+    stable_path(path)
+
+Return an absolute form of `path` that is the same in every build of an action.
+
+Under a sandbox the working directory differs between builds, and package
+paths end up in the caches and images built from them. On Linux a relative
+path is anchored at `/proc/self/cwd` instead of the real directory. macOS has
+no such path, so a symlink in `/tmp` named after `path` points at it instead.
+"""
+function stable_path(path)
+    isabspath(path) && return path
+    Sys.islinux() && return joinpath("/proc/self/cwd", normpath(path))
+    Sys.iswindows() && return abspath(path)
+    return stable_link(normpath(path))
+end
+
+# Open lock files by link, kept so their locks last until the process exits.
+# A second `flock` on a new handle would wait on this process's own lock.
+const STABLE_LINK_LOCKS = Dict{String, IOStream}()
+
+"""
+    stable_link(path)
+
+Point `/tmp/rules_julia_<hash of path>` at `path` and return the link.
+
+Two output bases can run the same action at once and want the same link, so
+each holds an exclusive `flock` on the link's lock file until it exits.
+"""
+function stable_link(path)
+    link = "/tmp/rules_julia_" * string(hash(path); base = 16, pad = 2 * sizeof(UInt))
+    if !haskey(STABLE_LINK_LOCKS, link)
+        io = open(link * ".lock", "a")
+        ccall(:flock, Cint, (Cint, Cint), fd(io), 2) == 0 ||
+            error("Could not lock `$link.lock`: $(Libc.strerror())")
+        STABLE_LINK_LOCKS[link] = io
+    end
+    rm(link; force = true, recursive = true)
+    symlink(abspath(path), link)
+    return link
+end
