diff --git a/uv/private/constraints/platform/flags/BUILD.bazel b/uv/private/constraints/platform/flags/BUILD.bazel
new file mode 100644
index 0000000..9f27ad9
--- /dev/null
+++ b/uv/private/constraints/platform/flags/BUILD.bazel
@@ -0,0 +1,16 @@
+load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
+load("@rules_py_uv_host//:defs.bzl", "CURRENT_PLATFORM_LIBC", "CURRENT_PLATFORM_VERSION")
+
+# The flags we transition and select on. They live in their own package so that
+# toolchains selecting on them do not load the large //uv/private/constraints/platform package.
+string_flag(
+    name = "platform_libc",
+    build_setting_default = CURRENT_PLATFORM_LIBC,
+    visibility = ["//visibility:public"],
+)
+
+string_flag(
+    name = "platform_version",
+    build_setting_default = CURRENT_PLATFORM_VERSION,
+    visibility = ["//visibility:public"],
+)
