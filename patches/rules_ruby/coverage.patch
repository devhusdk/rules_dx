Upstream: none (rules_dx only: Bundler guard for bundle-less targets, SimpleCov 1.x skip, cwd-relative main under coverage)
diff --git a/ruby/private/binary/binary.sh.tpl b/ruby/private/binary/binary.sh.tpl
--- a/ruby/private/binary/binary.sh.tpl
+++ b/ruby/private/binary/binary.sh.tpl
@@ -81,9 +81,13 @@ if [ "{locate_binary_in_runfiles}" = "true" ]; then
     || (fail "Failed to locate {binary} in the runfiles." \
       "Did you forget to add the binary to the deps?")
 elif [ "{locate_binary_in_runfiles}" = "fallback" ]; then
-  binary="$(rlocation "{binary}" 2>/dev/null || true)"
-  if [ -z "$binary" ] || [ ! -f "$binary" ]; then
+  if [[ "${COVERAGE:-}" == "1" && -f "{binary_fallback}" ]]; then
     binary="{binary_fallback}"
+  else
+    binary="$(rlocation "{binary}" 2>/dev/null || true)"
+    if [ -z "$binary" ] || [ ! -f "$binary" ]; then
+      binary="{binary_fallback}"
+    fi
   fi
 else
   binary="{binary}"
diff --git a/ruby/private/coverage/rules_ruby_coverage.rb b/ruby/private/coverage/rules_ruby_coverage.rb
--- a/ruby/private/coverage/rules_ruby_coverage.rb
+++ b/ruby/private/coverage/rules_ruby_coverage.rb
@@ -1,8 +1,18 @@
 # frozen_string_literal: true
 
 if ENV['COVERAGE'] == '1'
+  # Only set up Bundler when the target has a bundle. Without one, Bundler
+  # looks for a Gemfile above the working directory and raises
+  # GemfileNotFound or GemNotFound, which `rescue LoadError` misses.
+  if ENV['BUNDLE_GEMFILE']
+    begin
+      require 'bundler/setup'
+    rescue StandardError, LoadError => e
+      warn "Coverage enabled but Bundler setup failed: #{e.message}"
+    end
+  end
+
   begin
-    require 'bundler/setup'
     require 'simplecov'
     require 'simplecov-lcov'
 
@@ -30,13 +40,13 @@ if ENV['COVERAGE'] == '1'
         root Dir.pwd
       end
 
-      add_filter '/external/'
-      add_filter '/spec/'
-      add_filter '/test/'
+      skip '/external/'
+      skip '/spec/'
+      skip '/test/'
 
       if ENV['COVERAGE_FILTERS']
         ENV['COVERAGE_FILTERS'].split(',').each do |filter|
-          add_filter filter.strip
+          skip filter.strip
         end
       end
     end
