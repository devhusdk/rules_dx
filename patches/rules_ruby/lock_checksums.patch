+def _parse_checksum(line):
+    """Parses one `CHECKSUMS` entry of a Gemfile.lock.
+
+    > name (version) sha256=hex
+
+    Returns a `(full_name, sha256)` tuple, or `None` for a line without a
+    sha256 digest.
+    """
+    if not line.startswith("  ") or line[2:3].isspace():
+        return None
+    version_start = line.find(" (")
+    version_end = line.find(")", version_start)
+    if version_start < 0 or version_end < 0:
+        return None
+    full_name = "%s-%s" % (line[2:version_start], line[version_start + 2:version_end])
+    for digest in line[version_end + 1:].strip().split(","):
+        if digest.startswith("sha256="):
+            return (full_name, digest.removeprefix("sha256="))
+    return None
+
