+# Strips the self-extractor stub so Bazel can unpack the 7z payload. The
+# payload start is the 7z signature whose start-header CRC matches.
+_STRIP_SFX_RB = """
+require "zlib"
+data = File.binread(ARGV[0])
+sig = "7z\\xBC\\xAF\\x27\\x1C".b
+pos = 0
+while (pos = data.index(sig, pos))
+  head = data[pos, 32]
+  if head.bytesize == 32 && head[8, 4].unpack1("V") == Zlib.crc32(head[12, 20])
+    File.binwrite(ARGV[1], data[pos..-1])
+    exit 0
+  end
+  pos += 1
+end
+abort "no 7z payload in " + ARGV[0]
+"""
