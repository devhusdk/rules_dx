+def _install_via_rubyinstaller(repository_ctx, version, platform, checksums):
+    """Unpacks the sha256-pinned RubyInstaller 7z archive; nothing is installed or downloaded later."""
+    if platform == "x86_64_windows":
+        arch = "x64"
+    elif platform == "arm64_windows":
+        arch = "arm"
+    else:
+        fail("no RubyInstaller archive for platform " + platform)
+    stem = "rubyinstaller-{}-1-{}".format(version, arch)
+    artifact_name = stem + ".7z"
+    if artifact_name not in checksums:
+        fail("missing sha256 for {} in portable_ruby_checksums".format(artifact_name))
+    if arch == "x64":
+        toolchain_name = _W64DEVKIT_NAME
+        toolchain_url = _W64DEVKIT_URL
+        toolchain_dir = "dist/msys64/ucrt64"
+        toolchain_strip = "mingw64"
+    else:
+        toolchain_name = _LLVM_MINGW_NAME
+        toolchain_url = _LLVM_MINGW_URL
+        toolchain_dir = "dist/msys64/clangarm64"
+        toolchain_strip = _LLVM_MINGW_NAME[:-len(".zip")]
+
+    # RubyInstaller devkit layout: MSYS2 (make, sh, coreutils) at
+    # dist/msys64, the native gcc or clang toolchain below it.
+    for name in (_MSYS2_BASE_NAME, _MSYS2_MAKE_NAME, toolchain_name):
+        if name not in checksums:
+            fail("missing sha256 for {} in portable_ruby_checksums".format(name))
+    repository_ctx.report_progress("Extracting MSYS2")
+    repository_ctx.download_and_extract(
+        url = _MSYS2_BASE_URL,
+        sha256 = checksums[_MSYS2_BASE_NAME],
+        output = "dist/msys64",
+        stripPrefix = "msys64",
+    )
+    repository_ctx.download_and_extract(
+        url = _MSYS2_MAKE_URL,
+        sha256 = checksums[_MSYS2_MAKE_NAME],
+        output = "dist/msys64",
+    )
+    repository_ctx.report_progress("Extracting " + toolchain_name)
+    repository_ctx.download_and_extract(
+        url = toolchain_url,
+        sha256 = checksums[toolchain_name],
+        output = toolchain_dir,
+        stripPrefix = toolchain_strip,
+    )
+    for path in (
+        "dist/msys64/usr/share",
+        "dist/msys64/usr/lib/terminfo",
+        "dist/msys64/var",
+        "dist/msys64/.PKGINFO",
+        "dist/msys64/.MTREE",
+        "dist/msys64/.BUILDINFO",
+    ):
+        repository_ctx.delete(path)
+    repository_ctx.report_progress("Extracting RubyInstaller " + version)
+    archive_url = _RUBY_INSTALLER_ARCHIVE_URL.format(version = version, artifact = artifact_name)
+    if arch == "x64":
+        repository_ctx.download_and_extract(
+            url = archive_url,
+            sha256 = checksums[artifact_name],
+            output = "dist",
+            stripPrefix = stem,
+        )
+    else:
+        if _SEVEN_ZIP_NAME not in checksums:
+            fail("missing sha256 for {} in portable_ruby_checksums".format(_SEVEN_ZIP_NAME))
+        repository_ctx.download(
+            url = _SEVEN_ZIP_URL,
+            sha256 = checksums[_SEVEN_ZIP_NAME],
+            output = "7zr.exe",
+            canonical_id = "dx-7zip:" + _SEVEN_ZIP_URL,
+        )
+        repository_ctx.download(
+            url = archive_url,
+            sha256 = checksums[artifact_name],
+            output = artifact_name,
+        )
+        _execute_command(repository_ctx, [
+            repository_ctx.path("7zr.exe"),
+            "x",
+            "-y",
+            "-bd",
+            "-o_rubyinstaller",
+            artifact_name,
+        ])
+        for child in repository_ctx.path("_rubyinstaller/" + stem).readdir():
+            repository_ctx.rename(child, "dist/" + child.basename)
+        for path in (artifact_name, "_rubyinstaller"):
+            repository_ctx.delete(path)
