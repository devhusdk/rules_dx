+def _clang_cl_link_args_for_lld_link(args):
+    """Keeps the linker arguments of a clang-cl link command line, in lld-link syntax."""
+    result = []
+    take_next = False
+    for arg in args:
+        if take_next:
+            take_next = False
+            result.append(arg.removeprefix("/clang:"))
+        elif arg in ("/clang:-Xlinker", "-Xlinker"):
+            take_next = True
+        elif arg.startswith("-Wl,"):
+            result.extend(arg.removeprefix("-Wl,").split(","))
+        elif arg == "/Brepro" or arg.upper().startswith(("/LIBPATH:", "-LIBPATH:")) or not arg.startswith(("-", "/")):
+            result.append(arg)
+    return result
+
