{
  "$schema": "../core/modules/lang.schema.json",
  "name": "perl",
  "title": "Perl",
  "family": "core",
  "ecosystems": [
    "cpan"
  ],
  "depcheck": "perl",
  "semver": false,
  "manifests": [
    "cpanfile"
  ],
  "lockfiles": [
    "cpanfile.snapshot"
  ],
  "setup": {
    "hubs": [
      {
        "ecosystem": "cpan",
        "manifest": "cpanfile",
        "lock": "cpanfile.snapshot.lock.json",
        "state": "cpanfile.snapshot",
        "extension": "@rules_dx//perl:extensions.bzl",
        "tag": "install",
        "hub": "cpan",
        "resolver": null,
        "imports": "name"
      }
    ]
  },
  "tools": [
    "perlcritic",
    "perltidy"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_x86_64"
  ],
  "unsupported": {
    "windows_arm64": "Windows ARM64 perl is not qualified"
  },
  "pins": [],
  "entry_points": [
    "perl_library",
    "perl_binary",
    "perl_test",
    "perl_bench",
    "perl_cpan_compiler"
  ],
  "quality": {
    "bzl": "perl/private/quality:perl.bzl",
    "file_extensions": [
      ".pl",
      ".pm"
    ],
    "aspects": {
      "format": [
        "real_perl_format_aspect"
      ],
      "lint": [
        "real_perl_lint_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_perl_format_probe_aspect"
      ],
      "lint": [
        "real_perl_lint_probe_aspect"
      ]
    }
  },
  "docs": {
    "bzl": "tools/docs/perl:aspect.bzl",
    "file_extensions": [
      ".pl",
      ".pm"
    ],
    "aspects": [
      "real_perl_docs_aspect"
    ]
  }
}
