{
  "$schema": "../modules/lang.schema.json",
  "name": "perl",
  "title": "Perl",
  "family": "core",
  "ecosystems": [
    "cpan"
  ],
  "depcheck": "perl",
  "semver": false,
  "manifests": [
    "cpanfile"
  ],
  "lockfiles": [
    "cpanfile.snapshot"
  ],
  "tools": [
    "perlcritic",
    "perltidy"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_x86_64"
  ],
  "pins": [],
  "entry_points": [
    "perl_library",
    "perl_binary",
    "perl_test",
    "perl_bench"
  ],
  "quality": {
    "bzl": "quality:families/perl.bzl",
    "file_extensions": [
      ".pl",
      ".pm"
    ],
    "aspects": {
      "format": [
        "real_perl_format_aspect"
      ],
      "lint": [
        "real_perl_lint_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_perl_format_probe_aspect"
      ],
      "lint": [
        "real_perl_lint_probe_aspect"
      ]
    }
  }
}
