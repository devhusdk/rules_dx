load("@bazel_skylib//lib:selects.bzl", "selects")
load("//core:cells.bzl", "unsupported_value")
load("//core/quality:fixtures.bzl", "real_source_target")
load(":defs.bzl", "perl_library")
load(":platforms.bzl", "PERL_PLATFORMS")

package(default_visibility = [
    "//:__pkg__",
    "//perl:__subpackages__",
    "//tools/ci:__pkg__",
])

unsupported_value("unsupported")

exports_files([
    "defs.bzl",
    "platforms.bzl",
])

perl_library(
    name = "bench",
    srcs = ["lib/DxBench.pm"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

[
    config_setting(
        name = name,
        constraint_values = [
            "@platforms//os:" + os,
            "@platforms//cpu:" + cpu,
        ],
    )
    for name, (os, cpu) in PERL_PLATFORMS.items()
]

selects.config_setting_group(
    name = "rules_perl_platform",
    match_any = [":" + name for name in PERL_PLATFORMS],
    visibility = ["//visibility:public"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "platforms.bzl",
        ],
    tags = ["corpus"],
)
