load("@rules_perl//perl:perl_library.bzl", _rules_perl_library = "perl_library")
load("//core/quality:fixtures.bzl", "real_source_target")
load(":defs.bzl", "perl_library")

package(default_visibility = [
    "//:__pkg__",
    "//perl:__subpackages__",
    "//tools/ci:__pkg__",
])

exports_files([
    "defs.bzl",
    "platforms.bzl",
])

alias(
    name = "pod",
    actual = select({
        "@platforms//os:macos": "@dx_perl_pod//:pod",
        "//conditions:default": ":no_pod",
    }),
    visibility = ["//visibility:public"],
)

_rules_perl_library(
    name = "no_pod",
)

perl_library(
    name = "bench",
    srcs = ["lib/DxBench.pm"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "platforms.bzl",
        "pod.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
