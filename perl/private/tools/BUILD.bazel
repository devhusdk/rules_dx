load("@rules_perl//perl:perl_binary.bzl", "perl_binary")
load("@rules_perl//perl/cpan:cpan_compiler.bzl", perl_cpan_compiler = "cpan_compiler")
load("//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

exports_files([
    "cpanfile",
    "cpanfile.snapshot",
    "cpanfile.snapshot.lock.json",
    "critic/testdata/clean.pl",
    "critic/testdata/dirty.pl",
])

alias(
    name = "perltidy",
    actual = "@dx_perl_cpan//:Perl-Tidy_bin_perltidy",
)

alias(
    name = "carton",
    actual = "@dx_perl_cpan//:Carton_bin_carton",
)

perl_binary(
    name = "perlcritic",
    srcs = ["perlcritic.pl"],
    main = "perlcritic.pl",
    deps = [
        "@dx_perl_cpan//:Clone-PP",
        "@dx_perl_cpan//:Perl-Critic",
    ],
)

perl_binary(
    name = "cpansa_dump",
    srcs = ["cpansa_dump.pl"],
    main = "cpansa_dump.pl",
    deps = ["@dx_perl_cpan//:CPANSA-DB"],
)

perl_cpan_compiler(
    name = "compiler",
    cpanfile = "cpanfile",
    lockfile = "cpanfile.snapshot.lock.json",
    tags = ["manual"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
