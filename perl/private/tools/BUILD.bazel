load("@rules_perl//perl:perl_binary.bzl", "perl_binary")
load("//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

exports_files([
    "cpanfile",
    "cpanfile.snapshot",
    "cpan.lock.json",
    "critic/testdata/clean.pl",
    "critic/testdata/dirty.pl",
])

alias(
    name = "perltidy",
    actual = "@dx_perl_cpan//Perl-Tidy:bin_perltidy",
)

alias(
    name = "carton",
    actual = "@dx_perl_cpan//Carton:bin_carton",
)

perl_binary(
    name = "perlcritic",
    srcs = ["perlcritic.pl"],
    main = "perlcritic.pl",
    deps = [
        "@dx_perl_cpan//Clone-PP",
        "@dx_perl_cpan//Perl-Critic",
    ],
)

perl_binary(
    name = "cpansa_dump",
    srcs = ["cpansa_dump.pl"],
    main = "cpansa_dump.pl",
    deps = ["@dx_perl_cpan//CPANSA-DB"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
