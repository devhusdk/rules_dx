load("@rules_perl//perl:perl_binary.bzl", "perl_binary")
load("@rules_perl//perl/cpan:cpan_compiler.bzl", "cpan_compiler")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

exports_files([
    "cpanfile",
    "cpanfile.snapshot",
    "cpanfile.snapshot.lock.json",
])

alias(
    name = "perltidy",
    actual = "@dx_perl_cpan//:Perl-Tidy_bin_perltidy",
)

alias(
    name = "carton",
    actual = "@dx_perl_cpan//:Carton_bin_carton",
)

# Perl::Critic needs XS modules the cpan hub cannot build, so perlcritic.pl
# shims them with pure-Perl stand-ins; see the comment there.
perl_binary(
    name = "perlcritic",
    srcs = ["perlcritic.pl"],
    main = "perlcritic.pl",
    deps = [
        "@dx_perl_cpan//:Clone-PP",
        "@dx_perl_cpan//:Perl-Critic",
    ],
)

sh_test(
    name = "perlcritic_smoke_test",
    srcs = ["perlcritic_smoke_test.sh"],
    args = [
        "$(rootpath :perlcritic)",
        "$(rootpath testdata/clean.pl)",
        "$(rootpath testdata/dirty.pl)",
    ],
    data = [
        "testdata/clean.pl",
        "testdata/dirty.pl",
        ":perlcritic",
    ],
)

perl_binary(
    name = "cpansa_dump",
    srcs = ["cpansa_dump.pl"],
    main = "cpansa_dump.pl",
    deps = ["@dx_perl_cpan//:CPANSA-DB"],
)

sh_test(
    name = "cpansa_dump_smoke_test",
    srcs = ["cpansa_dump_smoke_test.sh"],
    args = ["$(rootpath :cpansa_dump)"],
    data = [":cpansa_dump"],
)

cpan_compiler(
    name = "compiler",
    cpanfile = "cpanfile",
    lockfile = "cpanfile.snapshot.lock.json",
    tags = ["manual"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
