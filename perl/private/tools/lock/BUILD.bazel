load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//cli/launcher:defs.bzl", "dx_subcommand")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//:__subpackages__"])

rust_library(
    name = "perl_lock_lib",
    srcs = ["src/resolve.rs"],
    aliases = aliases(
        package_name = "perl/private/tools/perl_lock",
        normal = True,
    ),
    crate_name = "perl_lock",
    crate_root = "src/resolve.rs",
    visibility = ["//cli/cli:__pkg__"],
    deps = all_crate_deps(
        package_name = "perl/private/tools/perl_lock",
        normal = True,
    ) + [
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
    ],
)

dx_subcommand(
    name = "lock",
    subcommand = "perl_lock",
    visibility = ["//:__subpackages__"],
)

rust_test(
    name = "resolve_test",
    size = "small",
    srcs = ["resolve_test.rs"],
    aliases = aliases(
        package_name = "perl/private/tools/perl_lock",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "resolve_test",
    crate_root = "resolve_test.rs",
    data = [
        "testdata/Clone-PP-1.09.tar.gz",
        "testdata/Text-CSV-2.06.tar.gz",
        "testdata/golden.lock.json",
    ],
    env = {
        "GOLDEN": "$(rootpath testdata/golden.lock.json)",
        "CLONE_PP": "$(rootpath testdata/Clone-PP-1.09.tar.gz)",
        "TEXT_CSV": "$(rootpath testdata/Text-CSV-2.06.tar.gz)",
    },
    tags = ["block-network"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = all_crate_deps(
        package_name = "perl/private/tools/perl_lock",
        normal = True,
        normal_dev = True,
    ) + [
        ":perl_lock_lib",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
        "//cli/lock:dx_lock_testing",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "subcommand_test",
    size = "small",
    srcs = ["subcommand_test.rs"],
    aliases = aliases(
        package_name = "perl/private/tools/perl_lock",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "subcommand_test",
    crate_root = "subcommand_test.rs",
    data = [":lock"],
    env = {"LOCK": "$(rlocationpath :lock)"},
    tags = ["block-network"],
    deps = all_crate_deps(
        package_name = "perl/private/tools/perl_lock",
        normal = True,
        normal_dev = True,
    ) + ["//tools/testing:dx_testing"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
