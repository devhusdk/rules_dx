load("@bazel_skylib//lib:selects.bzl", "selects")
load("//libs/starlark:cells.bzl", "unsupported_value")
load("//libs/starlark:conformance.bzl", "dx_wrapper_contract_tests", "dx_wrapper_signature_test")
load("//libs/starlark:defs.bzl", "expect_equal")
load("//libs/starlark:entry.bzl", "dx_entry_quality_srcs")
load("//libs/starlark:wrapper.bzl", "dx_language_kwargs")
load("//quality:fixtures.bzl", "real_source_target")
load(":defs.bzl", "PERL_DEFERRED_SKIP_TAGS", "PERL_QUALITY_TOOLS", "PERL_SOURCE_EXTS", "PERL_SOURCE_SPECS", "perl_library")
load(":platforms.bzl", "PERL_PLATFORMS")

package(default_visibility = ["//visibility:public"])

unsupported_value("unsupported")

exports_files([
    "defs.bzl",
    "platforms.bzl",
    "wrapper_tests.bzl",
])

perl_library(
    name = "bench",
    srcs = ["lib/DxBench.pm"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

dx_wrapper_contract_tests(
    name = "wrapper_contract_tests",
    extra_checks = [
        expect_equal(
            "wrappers carry perlcritic and perltidy",
            sorted(PERL_QUALITY_TOOLS.keys()),
            [
                "perlcritic",
                "perltidy",
            ],
        ),
        expect_equal(
            "one perl class owns scripts, modules and tests",
            PERL_SOURCE_SPECS,
            [(
                "perl",
                [
                    "pl",
                    "pm",
                    "t",
                ],
            )],
        ),
        expect_equal(
            "wrappers accept only Perl sources",
            PERL_SOURCE_EXTS,
            [
                ".pl",
                ".pm",
                ".t",
            ],
        ),
        expect_equal(
            "main leads the owned sources",
            dx_entry_quality_srcs(
                "main.pl",
                ["Util.pm"],
            ),
            [
                "main.pl",
                "Util.pm",
            ],
        ),
        expect_equal(
            "main listed in srcs is owned once",
            dx_entry_quality_srcs(
                "main.pl",
                [
                    "main.pl",
                    "Util.pm",
                ],
            ),
            [
                "main.pl",
                "Util.pm",
            ],
        ),
        expect_equal(
            "rules_perl platforms are the five it ships",
            sorted(PERL_PLATFORMS.keys()),
            [
                "linux_arm64",
                "linux_x86_64",
                "macos_arm64",
                "macos_x86_64",
                "windows_x86_64",
            ],
        ),
        expect_equal(
            "no main and no srcs owns nothing",
            dx_entry_quality_srcs(None, None),
            [],
        ),
        expect_equal(
            "perl rules add no-typecheck once",
            dx_language_kwargs({"tags": ["manual", "no-typecheck"]}, PERL_DEFERRED_SKIP_TAGS)["tags"],
            ["manual", "no-typecheck"],
        ),
        expect_equal(
            "perl rules add no-typecheck to untagged targets",
            dx_language_kwargs({}, PERL_DEFERRED_SKIP_TAGS)["tags"],
            ["no-typecheck"],
        ),
    ],
    file_classes = ["perl"],
)

[
    config_setting(
        name = name,
        constraint_values = [
            "@platforms//os:" + os,
            "@platforms//cpu:" + cpu,
        ],
    )
    for name, (os, cpu) in PERL_PLATFORMS.items()
]

selects.config_setting_group(
    name = "rules_perl_platform",
    match_any = [":" + name for name in PERL_PLATFORMS],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "platforms.bzl",
        "wrapper_tests.bzl",
    ],
    tags = ["corpus"],
)

dx_wrapper_signature_test(name = "wrapper_signature_test")
