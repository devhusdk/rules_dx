load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//perl:defs.bzl", "perl_binary", "perl_library", "perl_test")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "subject_compatible_with")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

perl_library(
    name = "conformance",
    testonly = True,
    srcs = ["lib/Greet.pm"],
)

perl_library(
    name = "lint_dirty",
    testonly = True,
    srcs = ["lib/LintDirty.pm"],
    tags = ["manual"],
)

perl_library(
    name = "format_dirty",
    testonly = True,
    srcs = ["lib/FormatDirty.pm"],
    tags = ["manual"],
)

perl_binary(
    name = "hello",
    srcs = ["main.pl"],
    deps = [":conformance"],
)

perl_binary(
    name = "lock_hello",
    srcs = ["lock_main.pl"],
    deps = ["@perl_cpan//Text-CSV"],  # keep
)

perl_test(
    name = "pass_subject_test",
    size = "small",
    testonly = True,
    srcs = ["t/pass_test.t"],
    target_compatible_with = subject_compatible_with(),
    deps = [":conformance"],
)

perl_test(
    name = "fail_subject_test",
    size = "small",
    testonly = True,
    srcs = ["t/fail_test.t"],
    target_compatible_with = subject_compatible_with(),
    deps = [":conformance"],
)

dx_conformance_suite(
    name = "",
    size = "small",
    binary = ":hello",
    covered_source = "lib/Greet.pm",
    expected = "hello world",
    failing_case = "failing_case",
    failing_pattern = "not ok 1 - {case}",
    failing_test = ":fail_subject_test",
    lock = {
        "binary": ":lock_hello",
        "ecosystem": "perl",
        "expected": "hello lock",
        "lockfile": "//perl/tests/fixtures/perl-app/third_party:cpanfile.snapshot",
        "manifest": "//perl/tests/fixtures/perl-app/third_party:cpanfile",
        "package": "Text::CSV",
        "stale": "cpanfile.stale.snapshot",
    },
    lang = "perl",
    not_applicable = {"cross_test": "perl_binary is a script the interpreter runs; it has no object format"},
    passing_test = ":pass_subject_test",
    quality = {
        "clean": ":conformance",
        "format_dirty": ":format_dirty",
        "format_source": "lib/FormatDirty.pm",
        "lint_dirty": ":lint_dirty",
        "lint_line": 3,
        "lint_rule": "TestingAndDebugging::RequireUseStrict",
        "lint_source": "lib/LintDirty.pm",
    },
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
