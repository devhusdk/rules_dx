load("@rules_dx//perl:defs.bzl", "perl_library", "perl_test")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

exports_files(
    glob([
        "lib/**",
        "t/*",
    ]) + ["BUILD.bazel"],
    visibility = ["@rules_dx//tools/testing/hermetic:__pkg__"],
)

APPS = ["//perl/tests/fixtures/perl-app:__subpackages__"]

perl_library(
    name = "inventory",
    srcs = [
        "lib/Inventory/Item.pm",
        "lib/Inventory/Ledger.pm",
    ],
    visibility = APPS,
)

perl_test(
    name = "item_test",
    srcs = ["t/item.t"],
    deps = [":inventory"],
)

perl_test(
    name = "ledger_test",
    srcs = ["t/ledger.t"],
    deps = [":inventory"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
