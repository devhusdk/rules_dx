load("@rules_dx//perl:defs.bzl", "perl_library", "perl_test")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

exports_files(
    glob([
        "data/*",
        "lib/**",
        "t/*",
    ]) + ["BUILD.bazel"],
    visibility = ["@rules_dx//tools/testing/hermetic:__pkg__"],
)

APPS = ["//perl/tests/fixtures/perl-app:__subpackages__"]

perl_library(
    name = "report",
    srcs = ["lib/Report.pm"],
    data = ["data/units.csv"],
    visibility = APPS,
    deps = [
        "@perl_cpan//:Text-CSV",
        "@rules_perl//perl/runfiles",
    ],
)

perl_test(
    name = "report_test",
    srcs = ["t/report.t"],
    deps = [
        ":report",
        "@perl_cpan//:Text-CSV",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
