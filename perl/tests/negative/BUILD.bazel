load("//libs/starlark:failure_test.bzl", "failure_test")
load("//perl/rules:defs.bzl", "perl_library")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")
load("//tools/testing:nested_bazel.bzl", "NESTED_BAZEL_DATA", "NESTED_BAZEL_NETWORK_ENV", "NESTED_BAZEL_NETWORK_TAGS")

# keep
rust_test(
    name = "negative_test",
    srcs = ["negative_test.rs"],
    data = ["//:module_srcs"] + NESTED_BAZEL_DATA,
    env = {"RUST_TEST_THREADS": "1"} | NESTED_BAZEL_NETWORK_ENV,
    env_inherit = [
        "HOME",
        "PATH",
    ],
    # A tampered CPAN lock must reach the network to fail its checksum.
    tags = NESTED_BAZEL_NETWORK_TAGS,
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [
        "//tools/testing:dx_nested",
        "//tools/testing:dx_testing",
    ],
)

rustfmt_test(
    name = "negative_fmt_test",
    targets = [":negative_test"],
)

rust_clippy_test(
    name = "negative_clippy_test",
    targets = [":negative_test"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

filegroup(
    name = "not_perl",
    srcs = ["Clean.pm"],
)

perl_library(
    name = "wrong_dep",
    testonly = True,
    srcs = ["Clean.pm"],
    tags = ["manual"],
    deps = [":not_perl"],  # keep
)

failure_test(
    name = "dependency_without_perl_info_fails_test",
    expected_failure_substring = "does not have mandatory providers: 'PerlInfo'",
    target = ":wrong_dep",
)
