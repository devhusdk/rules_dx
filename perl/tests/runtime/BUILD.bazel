load("//perl/rules:defs.bzl", "perl_binary", "perl_library", "perl_test")
load("//quality:fixtures.bzl", "real_source_target")

perl_library(
    name = "dx_probe",
    srcs = ["lib/DxProbe.pm"],
)

perl_binary(
    name = "probe",
    srcs = ["bin/probe.pl"],
    deps = [":dx_probe"],
)

perl_test(
    name = "probe_test",
    size = "small",
    srcs = ["t/probe.t"],
    data = ["data.txt"],
    env = {"DATA_FILE": "$(rlocationpath data.txt)"},
    deps = [
        ":dx_probe",
        "@rules_perl//perl/runfiles",
    ],
)

perl_test(
    name = "launcher_test",
    size = "small",
    srcs = ["t/launcher.t"],
    data = [":probe"],
    env = {"PROBE_BIN": "$(rlocationpath :probe)"},
    deps = ["@rules_perl//perl/runfiles"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
