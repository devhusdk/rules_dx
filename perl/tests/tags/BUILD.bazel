# gazelle:ignore

load("//libs/starlark:defs.bzl", "starlark_test")
load("//libs/starlark:tag_probe.bzl", "tag_subject")
load("//perl/rules:defs.bzl", "perl_binary", "perl_library", "perl_test")
load("//quality:fixtures.bzl", "real_source_target")

perl_library(
    name = "lib",
    srcs = ["main.pl"],
    tags = [
        "manual",
        "no-lint",
        "no-remote-exec",
    ],
)

perl_binary(
    name = "bin",
    srcs = ["main.pl"],
    tags = [
        "manual",
        "no-lint",
        "no-remote-exec",
    ],
)

perl_test(
    name = "unit",
    srcs = ["main.pl"],
    tags = [
        "manual",
        "no-lint",
        "no-remote-exec",
    ],
)

tag_subject(
    name = "tags_subject",
    testonly = True,
    targets = [
        ":bin",
        ":bin_upstream",
        ":lib",
        ":lib_upstream",
        ":unit",
        ":unit_upstream",
    ],
)

starlark_test(
    name = "tags_test",
    expected_observations = """subject //perl/tests/tags:tags_subject
field bin=manual,no-format,no-lint,no-remote-exec,no-typecheck
field bin_upstream=dx:no-format,dx:no-lint,dx:no-typecheck,manual,no-remote-exec
field lib=manual,no-format,no-lint,no-remote-exec,no-typecheck
field lib_upstream=dx:no-format,dx:no-lint,dx:no-typecheck,manual,no-remote-exec
field unit=manual,no-format,no-lint,no-remote-exec,no-typecheck
field unit_upstream=dx:no-format,dx:no-lint,dx:no-typecheck,manual,no-remote-exec
aspect_field aspect_seen=True
aspect_field field_count=6
aspect_field has_subject=True
aspect_field subject_label=//perl/tests/tags:tags_subject
aspect_field transitive_count=0
""",
    mode = "analysis",
    subjects = [":tags_subject"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
