exports_files([
    "BUILD.bazel",
    "README.md",
    "defs.bzl",
    "extensions.bzl",
    "lang.json",
    "pins.json",
])

# Public so users can register their own PHP toolchain. Register it for both
# types: the target type is the interpreter php_binary and php_test ship, the
# exec type is the interpreter build actions run on the execution platform.
toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

toolchain_type(
    name = "exec_toolchain_type",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
        "pins.json",
    ]),
    visibility = ["//:__subpackages__"],
)
