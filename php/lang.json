{
  "$schema": "../core/modules/lang.schema.json",
  "name": "php",
  "title": "PHP",
  "family": "core",
  "ecosystems": [
    "composer"
  ],
  "depcheck": "php",
  "semver": false,
  "manifests": [
    "composer.json"
  ],
  "lockfiles": [
    "composer.lock"
  ],
  "setup": {
    "hubs": [
      {
        "ecosystem": "composer",
        "manifest": "composer.json",
        "lock": "composer.lock.json",
        "state": "composer.lock",
        "extension": "@rules_dx//php:extensions.bzl",
        "tag": "lock",
        "hub": "composer",
        "resolver": "@rules_dx//php/private/tools/lock",
        "imports": "provides"
      }
    ]
  },
  "tools": [
    "phpcs",
    "phpstan",
    "prettier"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_x86_64"
  ],
  "unsupported": {
    "windows_arm64": "static-php-cli and windows.php.net ship no Windows arm64 PHP 8.5 build"
  },
  "pins": [
    "pins.json"
  ],
  "entry_points": [
    "php_library",
    "php_binary",
    "php_test",
    "php_bench"
  ],
  "quality": {
    "bzl": "core/quality:families/php.bzl",
    "file_extensions": [
      ".php"
    ],
    "aspects": {
      "lint": [
        "real_php_lint_aspect"
      ],
      "typecheck": [
        "real_php_typecheck_aspect"
      ]
    },
    "probes": {
      "lint": [
        "real_php_lint_probe_aspect"
      ],
      "typecheck": [
        "real_php_typecheck_probe_aspect"
      ]
    }
  },
  "docs": {
    "bzl": "tools/docs/php:aspect.bzl",
    "file_extensions": [
      ".php"
    ],
    "aspects": [
      "real_php_docs_aspect"
    ]
  }
}
