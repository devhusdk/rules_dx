# gazelle:exclude BenchTest.php
# gazelle:exclude Runfiles.php

package(default_visibility = [
    "//:__pkg__",
    "//php:__subpackages__",
    "//tools/ci:__pkg__",
])

exports_files([
    "BUILD.bazel",
    "BenchTest.php",
    "defs.bzl",
    "pcov.BUILD.bazel",
    "php.bzl",
    "providers.bzl",
    "Runfiles.php",
    "tool.php",
])

filegroup(
    name = "module_srcs",
    srcs = glob(["*.bzl"]) + [
        "BUILD.bazel",
        "BenchTest.php",
        "Runfiles.php",
        "pcov.BUILD.bazel",
        "tool.php",
    ],
    visibility = ["//:__subpackages__"],
)
