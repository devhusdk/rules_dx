load("@dx_pins_data//:pins.bzl", "DATA")
load("//php/private/quality:corpus.bzl", "php_corpus")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS_PUBLIC")
load(":coverage.bzl", "php_pcov_runtimes")

package(default_visibility = VIS_TOOLS_PUBLIC)

php_corpus(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "coverage.bzl",
        "extensions.bzl",
        "pcov.BUILD.bazel",
        "repos.bzl",
    ],
    tags = ["corpus"],
)

php_pcov_runtimes(
    name = "runtime",
    coverage_cells = DATA["dx_php_coverage"]["coverage"].keys(),
)

rust_library(
    name = "dx_php_coverage",
    srcs = ["src/lib.rs"],
    crate_root = "src/lib.rs",
    visibility = ["//cli/runtime:__pkg__"],
    deps = [
        "//cli/lcov:dx_lcov",
        "//cli/path:dx_path",
    ],
)

exports_files(
    [
        "src/lib.rs",
    ],
    visibility = ["//core/quality:__pkg__"],
)

rust_test(
    name = "dx_php_coverage_test",
    size = "small",
    crate = ":dx_php_coverage",
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
