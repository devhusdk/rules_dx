load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS_PUBLIC)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

rust_binary(
    name = "coverage_run",
    srcs = ["src/main.rs"],
    crate_name = "coverage",
    crate_root = "src/main.rs",
    deps = ["//cli/lcov:dx_lcov"],
)

exports_files(
    [
        "src/main.rs",
    ],
    visibility = ["//core/quality:__pkg__"],
)

rust_test(
    name = "coverage_test",
    crate = ":coverage_run",
)
