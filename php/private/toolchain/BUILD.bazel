load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//php:defs.bzl", "php_library")
load(":cells.bzl", "PHP_CELLS", "cell_settings", "unsupported_value")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "cells.bzl",
    "php.bzl",
    "repos.bzl",
    "extensions.bzl",
    "version_check.php",
])

unsupported_value("unsupported")

cell_settings(
    name = "cell",
    cells = PHP_CELLS,
)

toolchain_type(name = "toolchain_type")

toolchain_type(name = "exec_toolchain_type")

php_library(
    name = "toolchain",
    srcs = ["version_check.php"],
)

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
    ]),
    visibility = ["//:__subpackages__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "cells.bzl",
        "extensions.bzl",
        "php.bzl",
        "repos.bzl",
    ],
    tags = ["corpus"],
)
