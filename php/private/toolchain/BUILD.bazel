load("@rules_dx//php:defs.bzl", "php_library")
load("//core:cells.bzl", "cell_settings")
load(":cells.bzl", "PHP_CELLS")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "cells.bzl",
    "php.bzl",
    "repos.bzl",
    "extensions.bzl",
    "version_check.php",
])

cell_settings(
    name = "cell",
    cells = PHP_CELLS,
)

php_library(
    name = "toolchain",
    srcs = ["version_check.php"],
)

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
    ]) + [
        "version_check.php",
    ],
    visibility = ["//:__subpackages__"],
)
