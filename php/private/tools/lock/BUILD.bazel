load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:private"])

rust_library(
    name = "php_lock_lib",
    srcs = ["src/resolve.rs"],
    aliases = aliases(
        package_name = "php/private/tools/php_lock",
        normal = True,
    ),
    crate_name = "php_lock",
    crate_root = "src/resolve.rs",
    deps = all_crate_deps(
        package_name = "php/private/tools/php_lock",
        normal = True,
    ) + [
        "//cli/digest:dx_digest",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
    ],
)

rust_binary(
    name = "lock",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "php/private/tools/php_lock",
        normal = True,
    ),
    crate_name = "php_lock_bin",
    crate_root = "src/main.rs",
    visibility = ["//php:__pkg__"],
    deps = all_crate_deps(
        package_name = "php/private/tools/php_lock",
        normal = True,
    ) + [
        ":php_lock_lib",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
    ],
)

rust_test(
    name = "resolve_test",
    size = "small",
    srcs = ["resolve_test.rs"],
    aliases = aliases(
        package_name = "php/private/tools/php_lock",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "resolve_test",
    crate_root = "resolve_test.rs",
    deps = all_crate_deps(
        package_name = "php/private/tools/php_lock",
        normal = True,
        normal_dev = True,
    ) + [
        ":php_lock_lib",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
        "//tools/testing:dx_testing",
    ],
    data = [
        "testdata/factory.zip",
        "testdata/golden.composer.lock",
        "testdata/golden.lock.json",
        "testdata/message.zip",
    ],
    env = {
        "FACTORY": "$(rootpath testdata/factory.zip)",
        "GOLDEN": "$(rootpath testdata/golden.lock.json)",
        "GOLDEN_STATE": "$(rootpath testdata/golden.composer.lock)",
        "MESSAGE": "$(rootpath testdata/message.zip)",
    },
    tags = ["block-network"],
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)
