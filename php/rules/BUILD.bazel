load("//libs/starlark:conformance.bzl", "dx_wrapper_contract_tests")
load("//libs/starlark:defs.bzl", "expect_contains", "expect_equal", "expect_true", "fake_file", "label_string")
load("//libs/starlark:wrapper.bzl", "dx_quality_srcs")
load("//quality:fixtures.bzl", "real_source_target")
load(":defs.bzl", "PHP_COMPATIBLE_WITH", "PHP_DEFERRED_SKIP_TAGS", "PHP_SOURCE_SPECS")
load(":php.bzl", "PHP_SOURCE_EXTS", "autoloader_suffix", "coverage_launcher_script", "env_flag", "ini_flags", "launcher_descriptor", "launcher_script", "lit", "rf", "rf_prefixed", "runfiles_path", "shell_quote", "staged_path")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
    "php.bzl",
    "providers.bzl",
    "tool.php",
])

_BINARY = [
    lit("-d"),
    rf_prefixed("auto_prepend_file=", "_main/t.php/vendor/autoload.php"),
    rf("_main/t.php/app/main.php"),
]

_TEST = [
    rf("phpunit/phpunit.phar"),
    lit("--bootstrap"),
    rf("_main/t.php/vendor/autoload.php"),
    lit("--no-configuration"),
    lit("--fail-on-empty-test-suite"),
    lit("--do-not-cache-test-index"),
    env_flag("--log-junit", "XML_OUTPUT_FILE"),
]

_SELECT = select({"//conditions:default": []})

dx_wrapper_contract_tests(
    name = "wrapper_contract_tests",
    extra_checks = [
        expect_equal(
            "one php class owns every source",
            PHP_SOURCE_SPECS,
            [(
                "php",
                ["php"],
            )],
        ),
        expect_equal(
            "wrappers accept only PHP sources",
            PHP_SOURCE_EXTS,
            [".php"],
        ),
        expect_equal(
            "main leads the owned sources",
            dx_quality_srcs(
                "main.php",
                ["src/A.php"],
            ),
            [
                "main.php",
                "src/A.php",
            ],
        ),
        expect_equal(
            "main listed in srcs is owned once",
            dx_quality_srcs(
                "main.php",
                [
                    "main.php",
                    "src/A.php",
                ],
            ),
            [
                "main.php",
                "src/A.php",
            ],
        ),
        expect_equal(
            "autoload files are owned once",
            dx_quality_srcs(
                None,
                ["a.php"],
                [
                    "a.php",
                    "f.php",
                ],
            ),
            [
                "a.php",
                "f.php",
            ],
        ),
        expect_equal(
            "no main and no srcs owns nothing",
            dx_quality_srcs(None, None),
            [],
        ),
        expect_equal(
            "the deferred class skips quality",
            PHP_DEFERRED_SKIP_TAGS,
            ["no-format"],
        ),
        expect_equal(
            "targets build on the pinned cells",
            type(PHP_COMPATIBLE_WITH),
            "select",
        ),
        expect_equal(
            "workspace sources keep their path",
            staged_path(fake_file(short_path = "app/src/A.php")),
            "app/src/A.php",
        ),
        expect_equal(
            "external sources stage under external/",
            staged_path(fake_file(short_path = "../dep+/src/B.php")),
            "external/dep+/src/B.php",
        ),
        expect_equal(
            "suffixes are identifiers",
            autoloader_suffix(label_string("//app/cli:hello-world")),
            "Dx_main_app_cli_hello_world",
        ),
        expect_equal(
            "root-package suffixes keep the empty package",
            autoloader_suffix(label_string("//:hello")),
            "Dx_main__hello",
        ),
        expect_equal(
            "ini flags sort by key",
            ini_flags({
                "z": "1",
                "a": "b=c",
            }),
            [
                "-d",
                "a=b=c",
                "-d",
                "z=1",
            ],
        ),
        expect_equal(
            "quotes survive the shell",
            shell_quote("it's"),
            "'it'\\''s'",
        ),
        expect_equal(
            "workspace runfiles",
            runfiles_path(
                "_main",
                fake_file(short_path = "app/x.php"),
            ),
            "_main/app/x.php",
        ),
        expect_equal(
            "external runfiles",
            runfiles_path(
                "_main",
                fake_file(short_path = "../dep+/x.php"),
            ),
            "dep+/x.php",
        ),
        expect_contains(
            "the coverage launcher loads pcov on the autoload tree",
            coverage_launcher_script("php+/php", {}, _TEST, "pcov+/pcov.so", "_main/tools/clover_to_lcov", "_main/t.php"),
            "-d \"extension=$runfiles/pcov+/pcov.so\" -d pcov.enabled=1 -d \"pcov.directory=$tree\" \"$runfiles/phpunit/phpunit.phar\" --coverage-filter \"$tree\" --coverage-clover \"$clover\" --bootstrap",
        ),
        expect_contains(
            "the coverage launcher converts the report to LCOV below the tree",
            coverage_launcher_script("php+/php", {}, _TEST, "pcov+/pcov.so", "_main/tools/clover_to_lcov", "_main/t.php"),
            "\"$runfiles/_main/tools/clover_to_lcov\" \"$clover\" \"$COVERAGE_OUTPUT_FILE\" \"/t.php/\"",
        ),
        expect_contains(
            "the coverage launcher keeps the test status",
            coverage_launcher_script("php+/php", {}, _TEST, "pcov+/pcov.so", "_main/tools/clover_to_lcov", "_main/t.php"),
            "exit \"$status\"",
        ),
        expect_contains(
            "the launcher runs php without php.ini",
            launcher_script(
                "php+/php",
                {"memory_limit": "64M"},
                [],
            ),
            'exec "$runfiles/php+/php" -n \'-d\' \'memory_limit=64M\' "$@"\n',
        ),
        expect_true(
            "the launcher exports the runfiles root",
            "export RUNFILES_DIR=\"$runfiles\"" in launcher_script("p", {}, []),
        ),
        expect_contains(
            "a binary launcher keeps its bash tail",
            launcher_script("p", {}, _BINARY),
            '-n -d "auto_prepend_file=$runfiles/_main/t.php/vendor/autoload.php" "$runfiles/_main/t.php/app/main.php" "$@"\n',
        ),
        expect_contains(
            "a test launcher keeps its bash tail",
            launcher_script("p", {}, _TEST),
            '-n "$runfiles/phpunit/phpunit.phar" --bootstrap "$runfiles/_main/t.php/vendor/autoload.php" --no-configuration --fail-on-empty-test-suite --do-not-cache-test-index ${XML_OUTPUT_FILE:+--log-junit "$XML_OUTPUT_FILE"} "$@"\n',
        ),
        expect_equal(
            "odd literals are quoted for bash",
            launcher_script(
                "p",
                {},
                [lit("a b")],
            ).endswith("-n 'a b' \"$@\"\n"),
            True,
        ),
        expect_equal(
            "the descriptor names the program, ini flags and tokens",
            launcher_descriptor(
                "php+/php",
                {
                    "z": "1",
                    "a": "b c",
                },
                _BINARY,
            ),
            "program=php+/php\narg=-n\narg=-d\narg=a=b c\narg=-d\narg=z=1\narg=-d\nprefixed=auto_prepend_file=\t_main/t.php/vendor/autoload.php\npath=_main/t.php/app/main.php\n",
        ),
        expect_contains(
            "the descriptor keeps the junit variable",
            launcher_descriptor("p", {}, _TEST),
            "env_flag=--log-junit\tXML_OUTPUT_FILE\n",
        ),
    ],
    file_classes = ["php"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "php.bzl",
        "providers.bzl",
    ],
    tags = ["corpus"],
)
