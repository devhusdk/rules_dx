load("@rules_dx//php:defs.bzl", "php_bench")
load("//php/private/quality:corpus.bzl", "php_corpus")
load(":bench_tests.bzl", "php_runner_attr_test")

package(
    default_testonly = True,
    default_visibility = ["//visibility:public"],
)

php_bench(
    name = "sum_bench",
    srcs = ["SumBench.php"],
)

php_corpus(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "bench_tests.bzl",
    ],
    tags = ["corpus"],
)

php_runner_attr_test(
    name = "sum_bench_default_size",
    expected = {"size": "small"},
    runner = "sum_bench",
)
