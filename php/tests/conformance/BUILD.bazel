load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")

# gazelle:exclude bin
load("//php:defs.bzl", "php_binary", "php_library", "php_test")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "subject_compatible_with")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

php_library(
    name = "conformance",
    testonly = True,
    srcs = ["src/Conformance/Greet.php"],
)

php_binary(
    name = "hello",
    main = "bin/main.php",
    deps = [":conformance"],
)

php_binary(
    name = "lock_hello",
    main = "bin/lock_main.php",
    deps = ["@php_fixture_vendor//psr/http-factory"],  # keep
)

php_test(
    name = "pass_subject_test",
    size = "small",
    testonly = True,
    srcs = ["test/PassTest.php"],
    target_compatible_with = subject_compatible_with(),
    deps = [":conformance"],
)

php_test(
    name = "fail_subject_test",
    size = "small",
    testonly = True,
    srcs = ["test/FailTest.php"],
    target_compatible_with = subject_compatible_with(),
    deps = [":conformance"],
)

dx_conformance_suite(
    name = "",
    size = "small",
    binary = ":hello",
    covered_source = "src/Conformance/Greet.php",
    expected = "hello world",
    failing_case = "testCase",
    failing_pattern = "FailTest::{case}",
    failing_test = ":fail_subject_test",
    lock = {
        "binary": ":lock_hello",
        "ecosystem": "php",
        "expected": "hello lock",
        "lockfile": "//php/tests/fixtures/composer:composer.lock",
        "manifest": "//php/tests/fixtures/composer:composer.json",
        "package": "psr/http-factory",
        "stale": "composer.stale.lock",
    },
    lang = "php",
    not_applicable = {"cross_test": "php_binary is a script the interpreter runs; it has no object format"},
    passing_test = ":pass_subject_test",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
