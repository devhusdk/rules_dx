load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//php:defs.bzl", "php_binary", "php_library", "php_test")
load("@rules_dx//php/private:defs.bzl", "PHP_COMPATIBLE_WITH")
load("@rules_dx//php/private:php.bzl", "php_autoload_tree")

# gazelle:exclude bin
# gazelle:dx_external composer //php/tests/fixtures/composer/composer.lock.json php_fixture_vendor
# gazelle:resolve php Psr\Http\Message\RequestFactoryInterface @php_fixture_vendor//psr/http-factory
# gazelle:resolve php Psr\Http\Message\RequestInterface @php_fixture_vendor//psr/http-message

package(
    default_testonly = True,
    default_visibility = ["//visibility:public"],
)

exports_files([
    "composer.json",
    "composer.lock",
    "composer.lock.json",
])

php_library(
    name = "factory",
    testonly = True,
    srcs = ["src/Fixture/RequestFactory.php"],
    deps = [
        "@php_fixture_vendor//psr/http-factory",
        "@php_fixture_vendor//psr/http-message",
    ],
)

php_library(
    name = "factory_deprecations",
    srcs = [],
    deps = [
        ":factory",
        "@php_fixture_vendor//symfony/deprecation-contracts",
    ],
)

php_binary(
    name = "main",
    main = "bin/main.php",
    deps = [":factory_deprecations"],
)

php_test(
    name = "request_factory_test",
    size = "small",
    testonly = True,
    srcs = ["test/RequestFactoryTest.php"],
    deps = [
        ":factory",
        ":factory_deprecations",  # keep
        "@php_fixture_vendor//psr/http-factory",
    ],
)

php_binary(
    name = "missing",
    main = "bin/missing.php",
)

php_test(
    name = "cli_test",
    size = "small",
    testonly = True,
    srcs = ["test/CliTest.php"],
    data = [
        ":autoload_a",
        ":autoload_b",
        ":main",
        ":missing",
    ],
    env = {
        "MAIN_BIN": "$(rootpath :main)",
        "MISSING_BIN": "$(rootpath :missing)",
        "TREE_A": "$(rootpath :autoload_a)",
        "TREE_B": "$(rootpath :autoload_b)",
    },
)

[
    php_autoload_tree(
        name = "autoload_" + copy,
        suffix = "Dx_reproducible",
        target_compatible_with = PHP_COMPATIBLE_WITH,
        deps = [":factory_deprecations"],
    )
    for copy in ("a", "b")
]

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
