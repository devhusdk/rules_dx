# gazelle:exclude bin
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//php:defs.bzl", "PHP_COMPATIBLE_WITH", "php_binary", "php_library", "php_test")
load("@rules_dx//php/private:php.bzl", "php_autoload_tree")

package(
    default_testonly = True,
    default_visibility = ["//visibility:public"],
)

php_library(
    name = "format",
    testonly = True,
    srcs = ["src/Hello/Format/Upper.php"],
)

php_library(
    name = "greeter",
    testonly = True,
    srcs = ["src/Hello/Greeter.php"],
    visibility = ["@rules_dx//core/quality/testdata:__pkg__"],
    deps = [":format"],
)

php_binary(
    name = "hello",
    args = ["$(rlocationpath data/name.txt)"],
    data = ["data/name.txt"],
    ini = {"precision": "7"},
    main = "bin/hello.php",
    deps = [":greeter"],
)

php_test(
    name = "greeter_test",
    size = "small",
    testonly = True,
    srcs = ["test/GreeterTest.php"],
    ini = {"precision": "7"},
    deps = [
        ":format",
        ":greeter",
    ],
)

php_test(
    name = "pcov_test",
    size = "small",
    testonly = True,
    srcs = ["test/PcovTest.php"],
)

php_test(
    name = "cli_test",
    size = "small",
    testonly = True,
    srcs = ["test/CliTest.php"],
    data = [
        "data/name.txt",
        ":autoload_a",
        ":autoload_b",
        ":hello",
    ],
    env = {
        "HELLO_BIN": "$(rootpath :hello)",
        "NAME_RLOCATION": "$(rlocationpath data/name.txt)",
        "TREE_A": "$(rootpath :autoload_a)",
        "TREE_B": "$(rootpath :autoload_b)",
    },
)

[
    php_autoload_tree(
        name = "autoload_" + copy,
        suffix = "Dx_reproducible",
        target_compatible_with = PHP_COMPATIBLE_WITH,
        deps = [":greeter"],
    )
    for copy in ("a", "b")
]

php_autoload_tree(
    name = "autoload_root_shape",
    suffix = "Dx_main__hello_",
    target_compatible_with = PHP_COMPATIBLE_WITH,
    deps = [":greeter"],
)

build_test(
    name = "autoload_root_shape_test",
    targets = [":autoload_root_shape"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
