load("//php/rules:defs.bzl", "PHP_COMPATIBLE_WITH")
load("//quality:fixtures.bzl", "real_source_target")
load(":phpcs.bzl", "phpcs_tool")
load(":phpstan.bzl", "phpstan_tool")

package(default_visibility = ["//visibility:public"])

exports_files([
    "phpcs.bzl",
    "phpstan.bzl",
])

phpcs_tool(
    name = "phpcs",
    target_compatible_with = PHP_COMPATIBLE_WITH,
)

phpstan_tool(
    name = "phpstan",
    target_compatible_with = PHP_COMPATIBLE_WITH,
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "phpcs.bzl",
        "phpstan.bzl",
    ],
    tags = ["corpus"],
)
