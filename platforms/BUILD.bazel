load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//platforms/private:names.bzl", "OS_CONSTRAINTS", "PLATFORMS")
load("//platforms/private:target.bzl", "current_target")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
    "extensions.bzl",
])

[
    alias(
        name = name,
        actual = "@dx_platforms//:" + name,
    )
    for name in PLATFORMS
]

[
    config_setting(
        name = "os_" + os,
        constraint_values = constraints,
    )
    for os, constraints in OS_CONSTRAINTS.items()
]

string_flag(
    name = "current",
    build_setting_default = "",
    values = [""] + sorted(PLATFORMS),
)

string_flag(
    name = "min_os_android",
    build_setting_default = "",
)

string_flag(
    name = "min_os_windows",
    build_setting_default = "",
)

constraint_setting(
    name = "family",
    default_constraint_value = ":family_ok",
)

constraint_value(
    name = "family_ok",
    constraint_setting = ":family",
)

constraint_value(
    name = "needs_rules_dx_apple",
    constraint_setting = ":family",
)

constraint_value(
    name = "needs_rules_dx_android",
    constraint_setting = ":family",
)

constraint_value(
    name = "needs_macos_host",
    constraint_setting = ":family",
)

toolchain_type(name = "target_toolchain_type")

current_target(name = "current_target")

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "extensions.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
