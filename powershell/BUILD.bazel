load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

exports_files([
    "README.md",
    "defs.bzl",
    "extensions.bzl",
    "lang.json",
    "pins.json",
])

alias(
    name = "pester",
    actual = "//powershell/private/gallery:pester",
)

# Programs put this in deps to find their runfiles with Resolve-BazelRunfile.
alias(
    name = "runfiles",
    actual = "//powershell/private/runfiles",
)

alias(
    name = "dx_coverage",
    actual = "//powershell/private/coverage:dx_coverage",
)

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
    visibility = ["//:__subpackages__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "extensions.bzl",
    ],
    tags = ["corpus"],
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
        "pins.json",
    ]),
    visibility = ["//:__subpackages__"],
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//tools/api:__pkg__"],
)
