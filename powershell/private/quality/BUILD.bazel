load("@rules_powershell//powershell:defs.bzl", "pwsh_binary")
load("//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

pwsh_binary(
    name = "psscriptanalyzer",
    srcs = ["Invoke-Analyzer.ps1"],
    deps = ["//powershell/private/gallery:psscriptanalyzer"],
)

alias(
    name = "psscriptanalyzer_tool",
    actual = ":psscriptanalyzer",
)

exports_files(["Invoke-Analyzer.ps1"])

exports_files([
    "powershell.bzl",
    "powershell_tools.bzl",
])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "powershell.bzl",
        "powershell_tools.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
    ]),
    visibility = ["//:__subpackages__"],
)
