load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//cli/launcher:defs.bzl", "dx_subcommand")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//:__subpackages__"])

rust_library(
    name = "powershell_lock_lib",
    srcs = ["src/resolve.rs"],
    aliases = aliases(
        package_name = "powershell/private/tools/powershell_lock",
        normal = True,
    ),
    crate_name = "powershell_lock",
    crate_root = "src/resolve.rs",
    visibility = ["//cli/cli:__pkg__"],
    deps = all_crate_deps(
        package_name = "powershell/private/tools/powershell_lock",
        normal = True,
    ) + [
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
    ],
)

rust_binary(
    name = "powershell_lock",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "powershell/private/tools/powershell_lock",
        normal = True,
    ),
    crate_name = "powershell_lock",
    crate_root = "src/main.rs",
    visibility = ["//visibility:public"],
    deps = [":powershell_lock_lib"],
)

dx_subcommand(
    name = "lock",
    subcommand = "powershell_lock",
    visibility = ["//:__subpackages__"],
)

rust_test(
    name = "resolve_test",
    size = "small",
    srcs = ["resolve_test.rs"],
    aliases = aliases(
        package_name = "powershell/private/tools/powershell_lock",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "resolve_test",
    crate_root = "resolve_test.rs",
    data = [
        "testdata/golden.lock.json",
        "testdata/pester.nupkg",
        "testdata/psscriptanalyzer.nupkg",
    ],
    env = {
        "GOLDEN": "$(rootpath testdata/golden.lock.json)",
        "PESTER": "$(rootpath testdata/pester.nupkg)",
        "PSSA": "$(rootpath testdata/psscriptanalyzer.nupkg)",
    },
    tags = ["block-network"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = all_crate_deps(
        package_name = "powershell/private/tools/powershell_lock",
        normal = True,
        normal_dev = True,
    ) + [
        ":powershell_lock_lib",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
        "//cli/lock:dx_lock_testing",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
