load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//powershell:defs.bzl", "powershell_binary", "powershell_library", "powershell_test")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "subject_compatible_with")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

powershell_library(
    name = "conformance",
    testonly = True,
    srcs = [
        "Greet.psd1",
        "Greet.psm1",
    ],
)

powershell_library(
    name = "lint_dirty",
    testonly = True,
    srcs = ["lib/LintDirty.psm1"],
    tags = ["manual"],
)

powershell_library(
    name = "format_dirty",
    testonly = True,
    srcs = ["lib/FormatDirty.psm1"],
    tags = ["manual"],
)

powershell_binary(
    name = "hello",
    srcs = ["main.ps1"],
    deps = [":conformance"],
)

powershell_binary(
    name = "lock_hello",
    srcs = ["lock_main.ps1"],
    deps = ["//powershell:pester"],
)

powershell_test(
    name = "pass_subject_test",
    size = "small",
    srcs = ["pass_test.ps1"],
    data = ["pass.Describe.ps1"],
    target_compatible_with = subject_compatible_with(),
    deps = [
        ":conformance",
        "//powershell:dx_coverage",
        "//powershell:pester",
    ],
)

powershell_test(
    name = "fail_subject_test",
    size = "small",
    srcs = ["fail_test.ps1"],
    data = ["fail.Describe.ps1"],
    target_compatible_with = subject_compatible_with(),
    deps = [
        ":conformance",
        "//powershell:dx_coverage",
        "//powershell:pester",
    ],
)

dx_conformance_suite(
    name = "",
    size = "small",
    binary = ":hello",
    covered_source = "Greet.psm1",
    expected = "hello world",
    failing_case = "failing_case",
    failing_pattern = "[-] {case}",
    failing_test = ":fail_subject_test",
    lang = "powershell",
    not_applicable = {"cross_test": "powershell_binary is a script the interpreter runs; it has no object format"},
    lock = {
        "binary": ":lock_hello",
        "ecosystem": "powershell",
        "expected": "hello lock",
        "lockfile": "//third_party/powershell:powershell.lock.json",
        "manifest": "lock.psd1",
        "package": "Pester",
        "stale": "powershell.stale.lock.json",
    },
    passing_test = ":pass_subject_test",
    quality = {
        "clean": ":conformance",
        "format_dirty": ":format_dirty",
        "format_source": "lib/FormatDirty.psm1",
        "lint_dirty": ":lint_dirty",
        "lint_line": 4,
        "lint_rule": "PSAvoidUsingWriteHost",
        "lint_source": "lib/LintDirty.psm1",
    },
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
