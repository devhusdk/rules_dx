load("//powershell/rules:defs.bzl", "pwsh_binary", "pwsh_library", "pwsh_test")
load("//quality:fixtures.bzl", "real_source_target")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

pwsh_library(
    name = "hello_lib",
    srcs = [
        "Greet.psd1",
        "Greet.psm1",
    ],
)

pwsh_binary(
    name = "hello",
    srcs = ["Hello.ps1"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [":hello_lib"],
)

pwsh_test(
    name = "hello_test",
    srcs = ["HelloTest.ps1"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [":hello_lib"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//tools/docs/support_matrix:__pkg__"],
)
