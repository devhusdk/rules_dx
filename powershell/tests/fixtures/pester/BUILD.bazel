package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

powershell_library(
    name = "greeter_lib",
    testonly = True,
    srcs = ["Greeter.psm1"],
)

powershell_test(
    name = "greeter_test",
    size = "small",
    srcs = ["Greeter.Tests.ps1"],
    data = ["Greeter.Describe.ps1"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":greeter_lib",
        "//powershell:dx_coverage",
        "//powershell:pester",
    ],
)

pwsh_coverage_env_test(
    name = "greeter_test_coverage_env_test",
    target = ":greeter_test",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
    ],
    tags = ["corpus"],
)
