{
  "$schema": "../core/modules/lang.schema.json",
  "name": "python",
  "title": "Python",
  "family": "python",
  "ecosystems": [
    "uv"
  ],
  "depcheck": "python",
  "semver": false,
  "manifests": [
    "pyproject.toml"
  ],
  "lockfiles": [
    "uv.lock"
  ],
  "tools": [
    "pydoclint",
    "ruff",
    "ty"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_arm64",
    "windows_x86_64"
  ],
  "pins": [],
  "entry_points": [
    "python_main",
    "python_main_rejection",
    "python_library",
    "python_binary",
    "python_test_rejection",
    "python_test",
    "python_fuzz_test",
    "python_bench",
    "python_grpc_library"
  ],
  "quality": {
    "bzl": "quality:families/python.bzl",
    "file_extensions": [
      ".py",
      ".pyi"
    ],
    "aspects": {
      "format": [
        "real_python_format_aspect"
      ],
      "lint": [
        "real_python_lint_aspect"
      ],
      "typecheck": [
        "real_python_typecheck_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_python_format_probe_aspect"
      ],
      "lint": [
        "real_python_lint_probe_aspect"
      ],
      "typecheck": [
        "real_python_typecheck_probe_aspect"
      ]
    }
  },
  "docs": {
    "bzl": "tools/docs/python:aspect.bzl",
    "file_extensions": [
      ".py",
      ".pyi"
    ],
    "aspects": [
      "real_python_docs_aspect"
    ]
  }
}
