# gazelle:dx_ignore_import python pytest

load("//core:conformance.bzl", "dx_wrapper_contract_tests")
load("//core:defs.bzl", "expect_equal")
load("//quality:fixtures.bzl", "real_source_target")
load(":defs.bzl", "python_library", "python_main", "python_main_rejection", "python_test_rejection")
load(":runtime_tests.bzl", "python_runtime_unit_tests")
load(":sdist_cargo_vendor.bzl", "parse_cargo_lock", "parse_uv_lock_sdist")

_UV_LOCK = """[[package]]
name = "other"
version = "2"

[[package]]
name = "demo"
version = "1.0"
sdist = { url = "https://files.example/demo-1.0.tar.gz", hash = "sha256:abc123", size = 10 }
"""

_CARGO_LOCK_OK = """[[package]]
name = "demo"
version = "1.0.0"

[[package]]
name = "libc"
version = "0.2.1"
source = "registry+https://github.com/rust-lang/crates.io-index"
checksum = "ff00"
"""

_CARGO_LOCK_GIT = """[[package]]
name = "dep"
version = "1.0.0"
source = "git+https://example.com/dep"
"""

package(default_visibility = ["//visibility:public"])

python_library(
    name = "bench_plugin",
    srcs = ["dx_bench_plugin.py"],
    imports = ["."],
)

exports_files([
    "defs.bzl",
    "runtime_tests.bzl",
    "sdist_cargo_vendor.bzl",
])

dx_wrapper_contract_tests(
    name = "wrapper_contract_tests",
    extra_checks = [
        expect_equal(
            "generic main is rejected",
            python_test_rejection(
                "pytest",
                {"main": "main.py"},
            ) != None,
            True,
        ),
        expect_equal(
            "main rejection names pytest",
            python_test_rejection(
                "pytest",
                {"main": "main.py"},
            ),
            "python_test with runner = \"pytest\" runs pytest; set runner = \"plain\" to use main.",
        ),
        expect_equal(
            "plain runner accepts main",
            python_test_rejection(
                "plain",
                {"main": "main.py"},
            ),
            None,
        ),
        expect_equal(
            "unknown runner is rejected",
            python_test_rejection("nose", {}),
            "python_test runner must be \"pytest\" or \"plain\", got \"nose\".",
        ),
        expect_equal(
            "empty kwargs are clean",
            python_test_rejection("pytest", {}),
            None,
        ),
        expect_equal(
            "ordinary test kwargs are clean",
            python_test_rejection(
                "pytest",
                {
                    "deps": ["@pypi//pytest"],
                    "tags": ["small"],
                },
            ),
            None,
        ),
        expect_equal(
            "pytest-native entrypoint kwargs stay pytest",
            python_test_rejection(
                "pytest",
                {
                    "pytest_args": ["-k foo"],
                    "chdir": "pkg",
                },
            ),
            None,
        ),
        expect_equal(
            "main matches the wrapper name",
            python_main(
                "tool",
                [
                    "tool.py",
                    "tool_util.py",
                ],
            ),
            "tool.py",
        ),
        expect_equal(
            "main keeps the label form",
            python_main(
                "tool",
                [
                    ":tool.py",
                    "tool_util.py",
                ],
            ),
            ":tool.py",
        ),
        expect_equal(
            "main matches a nested src",
            python_main(
                "tool",
                [
                    "sub/tool.py",
                    "tool_util.py",
                ],
            ),
            "sub/tool.py",
        ),
        expect_equal(
            "single src leaves main unset",
            python_main(
                "tool",
                ["other.py"],
            ),
            None,
        ),
        expect_equal(
            "empty srcs leave main unset",
            python_main("tool", []),
            None,
        ),
        expect_equal(
            "none srcs leave main unset",
            python_main("tool", None),
            None,
        ),
        expect_equal(
            "no main match is rejected",
            python_main_rejection(
                "tool",
                [
                    "a.py",
                    "b.py",
                ],
            ),
            "has multiple srcs (a.py, b.py) and none is tool.py; set main.",
        ),
        expect_equal(
            "several main matches are rejected",
            python_main_rejection(
                "tool",
                [
                    "tool.py",
                    "sub/tool.py",
                ],
            ),
            "has multiple srcs matching tool.py: tool.py, sub/tool.py; set main.",
        ),
        expect_equal(
            "one main match is clean",
            python_main_rejection(
                "tool",
                [
                    "tool.py",
                    "tool_util.py",
                ],
            ),
            None,
        ),
        expect_equal(
            "single src is clean",
            python_main_rejection(
                "tool",
                ["other.py"],
            ),
            None,
        ),
        expect_equal(
            "none srcs are clean",
            python_main_rejection("tool", None),
            None,
        ),
        expect_equal(
            "uv.lock sdist url and hash are read",
            parse_uv_lock_sdist(_UV_LOCK, "demo"),
            {
                "sha256": "abc123",
                "url": "https://files.example/demo-1.0.tar.gz",
            },
        ),
        expect_equal(
            "missing uv.lock package is None",
            parse_uv_lock_sdist(_UV_LOCK, "absent"),
            None,
        ),
        expect_equal(
            "registry crates are listed and workspace members skipped",
            parse_cargo_lock(_CARGO_LOCK_OK),
            [[
                "libc",
                "0.2.1",
                "ff00",
            ]],
        ),
        expect_equal(
            "git crates are rejected by name",
            parse_cargo_lock(_CARGO_LOCK_GIT),
            "crate dep has unsupported source git+https://example.com/dep; only crates.io is vendored.",
        ),
    ],
    include_forwarder_checks = False,
    wrappers = {
        "binary": "//python/tests/fixtures/hello:hello",
        "library": "//python/tests/fixtures/hello:hello_lib",
        "test": "//python/tests/fixtures/hello:hello_test",
    },
)

python_runtime_unit_tests(name = "runtime_unit")

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "runtime_tests.bzl",
        "sdist_cargo_vendor.bzl",
    ],
    tags = ["corpus"],
)

exports_files(["grpc_protoc.py"])
