load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//python:defs.bzl", "python_library")

package(default_visibility = ["//python:__subpackages__"])

config_setting(
    name = "coverage_on",
    values = {"collect_code_coverage": "true"},
)

python_library(
    name = "sitecustomize",
    srcs = select({
        ":coverage_on": ["sitecustomize.py"],
        "//conditions:default": [],
    }),  # keep
    imports = ["."],
    visibility = ["//:__subpackages__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = [
        "BUILD.bazel",
        "sitecustomize.py",
    ],
    visibility = ["//:__subpackages__"],
)
