load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")

_EXEC_TOOLS_ENABLED = "@rules_python//python/config_settings:is_exec_tools_toolchain_enabled"

_TOOLCHAINS_ON = "//config:toolchains_on"

[
    [
        toolchain(
            name = "runtime_" + cpu,
            target_compatible_with = [
                "@platforms//os:windows",
                "@platforms//cpu:" + cpu,
            ],
            target_settings = [_TOOLCHAINS_ON],
            toolchain = "@python_3_12_{}-pc-windows-msvc//:python_runtimes".format(cpu),
            toolchain_type = "@rules_python//python:toolchain_type",
        ),
        toolchain(
            name = "py_cc_" + cpu,
            target_compatible_with = [
                "@platforms//os:windows",
                "@platforms//cpu:" + cpu,
            ],
            target_settings = [_TOOLCHAINS_ON],
            toolchain = "@python_3_12_{}-pc-windows-msvc//:py_cc_toolchain".format(cpu),
            toolchain_type = "@rules_python//python/cc:toolchain_type",
        ),
        toolchain(
            name = "exec_tools_" + cpu,
            exec_compatible_with = [
                "@platforms//os:windows",
                "@platforms//cpu:" + cpu,
            ],
            target_settings = [
                _EXEC_TOOLS_ENABLED,
                _TOOLCHAINS_ON,
            ],
            toolchain = "@python_3_12_{}-pc-windows-msvc//:py_exec_tools_toolchain".format(cpu),
            toolchain_type = "@rules_python//python:exec_tools_toolchain_type",
        ),
    ]
    for cpu in [
        "aarch64",
        "x86_64",
    ]
]

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = ["BUILD.bazel"],
    visibility = ["//:__subpackages__"],
)
