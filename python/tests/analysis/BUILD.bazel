    deps = [":dep"],
)

python_binary(
    name = "undeclared",
    srcs = ["user.py"],
    main = "user.py",
)

declared_dep_test(
    name = "declared_dep_test",
    target_under_test = ":declared",
)

undeclared_dep_test(
    name = "undeclared_dep_test",
    target_under_test = ":undeclared",
)

instrumented_sources_test(
    name = "coverage_instrumented_test",
    target_under_test = "//python/tests/fixtures/python-service/ledger/core:catalog_test",
)

no_click_runfiles_test(
    name = "no_click_runfiles_test",
    target_under_test = "//python/tests/fixtures/python-service/ledger/cli:broken",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "coverage_tests.bzl",
        "runfiles_tests.bzl",
    ],
    tags = ["corpus"],
    visibility = ["//:__pkg__"],
