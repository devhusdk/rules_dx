load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//python:defs.bzl", "python_binary", "python_library", "python_test")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "subject_compatible_with")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

python_library(
    name = "conformance",
    testonly = True,
    srcs = ["greet.py"],
    imports = ["."],
)

python_library(
    name = "lint_dirty",
    testonly = True,
    srcs = ["lint_dirty.py"],
    imports = ["."],
    tags = ["manual"],
)

python_library(
    name = "format_dirty",
    testonly = True,
    srcs = ["format_dirty.py"],
    imports = ["."],
    tags = ["manual"],
)

python_binary(
    name = "hello",
    srcs = ["main.py"],
    imports = ["."],
    main = "main.py",
    deps = [":conformance"],
)

python_binary(
    name = "lock_hello",
    srcs = ["lock_main.py"],
    dep_group = "hello",
    main = "lock_main.py",
    deps = ["@dx_pypi_fixtures//pytest"],
)

python_test(
    name = "pass_subject_test",
    size = "small",
    srcs = ["pass_test.py"],
    imports = ["."],
    runner = "plain",
    target_compatible_with = subject_compatible_with(),
    deps = [":conformance"],
)

python_test(
    name = "fail_subject_test",
    size = "small",
    srcs = ["fail_test.py"],
    imports = ["."],
    runner = "plain",
    target_compatible_with = subject_compatible_with(),
    deps = [":conformance"],
)

dx_conformance_suite(
    name = "",
    size = "small",
    binary = ":hello",
    covered_source = "greet.py",
    expected = "hello world",
    failing_case = "test_failing_case",
    failing_pattern = "FAIL: {case} (",
    failing_test = ":fail_subject_test",
    lang = "python",
    lock = {
        "binary": ":lock_hello",
        "ecosystem": "python",
        "expected": "hello lock",
        "lockfile": "//python/tests/fixtures/hello:uv.lock",
        "manifest": "//python/tests/fixtures/hello:pyproject.toml",
        "package": "pytest",
        "stale": "uv.stale.lock",
    },
    not_applicable = {"cross_test": "python_binary is a script the interpreter runs; it has no object format"},
    passing_test = ":pass_subject_test",
    quality = {
        "clean": ":conformance",
        "format_dirty": ":format_dirty",
        "format_source": "format_dirty.py",
        "lint_dirty": ":lint_dirty",
        "lint_line": 3,
        "lint_rule": "F401",
        "lint_source": "lint_dirty.py",
    },
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
