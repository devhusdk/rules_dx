load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")
load("//tools/testing:nested_bazel.bzl", "NESTED_BAZEL_COMPATIBLE_WITH", "NESTED_BAZEL_DATA", "NESTED_BAZEL_ENV_INHERIT", "NESTED_BAZEL_NETWORK_ENV", "NESTED_BAZEL_NETWORK_TAGS")

# keep
rust_test(
    name = "service_consumer_test",
    size = "enormous",
    srcs = ["service_consumer_test.rs"],
    data = [
        "service_consumer_test.rs",
        "//cli/cli:dx",
        "//examples/python-service:consumer_srcs",
    ] + NESTED_BAZEL_DATA,
    env = {
        "DX_BIN": "$(rootpath //cli/cli:dx)",
        "RUST_TEST_THREADS": "1",
    } | NESTED_BAZEL_NETWORK_ENV,
    env_inherit = NESTED_BAZEL_ENV_INHERIT,
    tags = NESTED_BAZEL_NETWORK_TAGS,
    target_compatible_with = NESTED_BAZEL_COMPATIBLE_WITH,
    deps = [
        "//tools/testing:dx_nested",
        "//tools/testing:dx_testing",
    ],
)

rustfmt_test(
    name = "service_consumer_fmt_test",
    size = "small",
    targets = [":service_consumer_test"],
)

rust_clippy_test(
    name = "service_consumer_clippy_test",
    size = "small",
    targets = [":service_consumer_test"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
