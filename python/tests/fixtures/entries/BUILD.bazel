# gazelle:ignore
load("//python:defs.bzl", "python_binary", "python_library", "python_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//tools/testing:hello_output.bzl", "dx_hello_output_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

python_library(
    name = "helper",
    testonly = True,
    srcs = ["helper.py"],
    imports = ["."],
)

python_library(
    name = "main",
    testonly = True,
    srcs = ["main.py"],
    imports = ["."],
    deps = [":helper"],
)

python_binary(
    name = "main_bin",
    testonly = True,
    imports = ["."],
    main = "main.py",
    deps = [":main"],
)

python_test(
    name = "helper_test",
    testonly = True,
    srcs = ["helper_test.py"],
    dep_group = "hello",
    imports = ["."],
    deps = [
        ":helper",
        "@dx_pypi_fixtures//pytest",
    ],
)

python_binary(
    name = "tool",
    testonly = True,
    srcs = [
        "tool.py",
        "tool_util.py",
    ],
    imports = ["."],
)

dx_hello_output_test(
    name = "tool_output_test",
    binary = ":tool",
    expected = "hello world",
)

python_test(
    name = "tool_test",
    srcs = [
        "tool_test.py",
        "tool_util.py",
    ],
    dep_group = "hello",
    imports = ["."],
    runner = "plain",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//:__pkg__"],
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//tools/docs/support_matrix:__pkg__"],
)
