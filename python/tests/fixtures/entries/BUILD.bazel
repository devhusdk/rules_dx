load("//python/rules:defs.bzl", "python_binary", "python_library", "python_py_test", "python_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//tools/testing:hello_output.bzl", "dx_hello_output_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

python_library(
    name = "helper",
    testonly = True,
    srcs = ["helper.py"],
    aspect_hints = ["//:ruff_config"],
    imports = ["."],
)

python_library(
    name = "main",
    testonly = True,
    srcs = ["main.py"],
    aspect_hints = ["//:ruff_config"],
    imports = ["."],
    deps = [":helper"],
)

python_binary(
    name = "main_bin",
    testonly = True,
    aspect_hints = ["//:ruff_config"],
    imports = ["."],
    main = "main.py",
    deps = [":main"],
)

python_test(
    name = "helper_test",
    testonly = True,
    srcs = ["helper_test.py"],
    aspect_hints = ["//:ruff_config"],
    dep_group = "hello",
    imports = ["."],
    deps = [
        ":helper",
        "@pypi//pytest",
    ],
)

python_binary(
    name = "tool",
    testonly = True,
    srcs = [
        "tool.py",
        "tool_util.py",
    ],
    aspect_hints = ["//:ruff_config"],
    imports = ["."],
)

dx_hello_output_test(
    name = "tool_output_test",
    binary = ":tool",
    expected = "hello world",
)

python_py_test(
    name = "tool_test",
    srcs = [
        "tool_test.py",
        "tool_util.py",
    ],
    aspect_hints = ["//:ruff_config"],
    dep_group = "hello",
    imports = ["."],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//tools/docs/support_matrix:__pkg__"],
)
