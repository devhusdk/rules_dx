load("//libs/starlark/tests:thin_compare.bzl", "thin_compare_py_tests", "thin_compare_subject")
load("//python/rules:defs.bzl", "python_binary", "python_library", "python_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//tools/testing:hello_output.bzl", "dx_hello_output_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

python_library(
    name = "hello_lib",
    srcs = ["hello.py"],
    aspect_hints = ["//:ruff_config"],
    imports = ["."],
)

python_binary(
    name = "hello",
    srcs = ["main.py"],
    aspect_hints = ["//:ruff_config"],
    imports = ["."],
    main = "main.py",
    deps = [":hello_lib"],
)

python_test(
    name = "hello_test",
    srcs = ["hello_test.py"],
    aspect_hints = ["//:ruff_config"],
    dep_group = "hello",
    imports = ["."],
    deps = [
        ":hello_lib",
        "@pypi//coverage",
        "@pypi//pytest",
    ],
)

python_test(
    name = "flaky_passthrough_fixture",
    srcs = ["flaky_passthrough_test.py"],
    aspect_hints = ["//:ruff_config"],
    dep_group = "hello",
    flaky = True,
    imports = ["."],
    deps = [
        "@pypi//coverage",
        "@pypi//pytest",
    ],
)

exports_files([
    "pyproject.toml",
    "uv.lock",
])

dx_hello_output_test(
    name = "hello_output_test",
    binary = ":hello",
    expected = "Hello, world!",
)

thin_compare_subject(
    name = "thin_py_subject",
    kind = "python_library",
    thin = ":hello_lib_upstream",
    wrapper = ":hello_lib",
)

thin_compare_py_tests(name = "thin_py_test")

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    testonly = True,
    tags = ["corpus"],
    toml_srcs = ["pyproject.toml"],
)
