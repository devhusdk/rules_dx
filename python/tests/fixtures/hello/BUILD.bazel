# gazelle:ignore
load("//core/tests:thin_compare.bzl", "thin_compare_py_tests", "thin_compare_subject")
load("//core:fuzz_bench_tests.bzl", "dx_runner_attr_test")
load("//python:defs.bzl", "python_bench", "python_binary", "python_library", "python_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//tools/testing:hello_output.bzl", "dx_hello_output_test")

package(
    default_testonly = True,
    default_visibility = [
        "//:__subpackages__",
        "//python/private:__pkg__",
    ],
)

python_library(
    name = "hello_lib",
    srcs = ["hello.py"],
    imports = ["."],
)

# keep
python_library(
    name = "incompatible_lib",
    srcs = ["hello.py"],
    imports = ["."],
    target_compatible_with = ["@platforms//:incompatible"],
)

python_binary(
    name = "hello",
    srcs = ["main.py"],
    imports = ["."],
    main = "main.py",
    deps = [":hello_lib"],
)

python_test(
    name = "hello_test",
    srcs = ["hello_test.py"],
    dep_group = "hello",
    imports = ["."],
    deps = [
        ":hello_lib",
        "@dx_pypi_fixtures//coverage",
        "@dx_pypi_fixtures//pytest",
    ],
)

python_bench(
    name = "parse_bench",
    srcs = ["parse_bench.py"],
    dep_group = "hello",
    imports = ["."],
    deps = [
        "@dx_pypi_fixtures//coverage",
        "@dx_pypi_fixtures//pytest",
        "@dx_pypi_fixtures//pytest_benchmark",
    ],
)

python_test(
    name = "flaky_passthrough_fixture",
    srcs = ["flaky_passthrough_test.py"],
    dep_group = "hello",
    flaky = True,
    imports = ["."],
    deps = [
        "@dx_pypi_fixtures//coverage",
        "@dx_pypi_fixtures//pytest",
    ],
)

python_test(
    name = "generic_unittest_test",
    srcs = ["generic_unittest_test.py"],
    dep_group = "hello",
    imports = ["."],
    runner = "plain",
    deps = [":hello_lib"],
)

python_test(
    name = "generic_main_test",
    srcs = ["generic_main_test.py"],
    dep_group = "hello",
    env = {"DX_GENERIC_FIXTURE": "1"},
    imports = ["."],
    main = "generic_main_test.py",
    runner = "plain",
    deps = [":hello_lib"],
)

python_test(
    name = "venv_rerun_test",
    srcs = ["venv_rerun_test.py"],
    dep_group = "hello",
    imports = ["."],
    main = "venv_rerun_test.py",
    runner = "plain",
    deps = [":hello_lib"],
)

exports_files([
    "pyproject.toml",
    "uv.lock",
])

dx_hello_output_test(
    name = "hello_output_test",
    binary = ":hello",
    expected = "Hello, world!",
)

thin_compare_subject(
    name = "thin_py_subject",
    kind = "python_library",
    thin = ":hello_lib_upstream",
    wrapper = ":hello_lib",
)

thin_compare_py_tests(name = "thin_py_test")

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//:__pkg__"],
)

real_source_target(
    name = "corpus_toml",
    testonly = True,
    tags = ["corpus"],
    toml_srcs = ["pyproject.toml"],
)

dx_runner_attr_test(
    name = "parse_bench_default_size",
    expected = {"size": "small"},
    runner = "parse_bench",
)
