load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("@rules_python//python/cc:py_extension.bzl", "py_extension")
load("//cc/toolchains:select.bzl", "cc_toolchain_test")
load("//python/rules:defs.bzl", "python_test")
load("//quality:fixtures.bzl", "real_source_target")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

py_extension(
    name = "dxnative",
    srcs = ["dxnative.cc"],
    imports = ["."],
)

cc_library(
    name = "dxhelper",
    srcs = ["dxhelper.cc"],
)

cc_shared_library(
    name = "dxhelper_shared",
    deps = [":dxhelper"],
)

py_extension(
    name = "dxlinked",
    srcs = ["dxlinked.cc"],
    dynamic_deps = [":dxhelper_shared"],
    imports = ["."],
    deps = [":dxhelper"],
)

python_test(
    name = "native_ext_test",
    srcs = ["native_ext_test.py"],
    aspect_hints = ["//:ruff_config"],
    env = select({
        "@rules_cc//cc/compiler:clang": {"DX_EXPECTED_COMPILER": "clang"},
        "@rules_cc//cc/compiler:gcc": {"DX_EXPECTED_COMPILER": "gcc"},
        "@rules_cc//cc/compiler:msvc-cl": {"DX_EXPECTED_COMPILER": "msvc"},
        "@rules_cc//cc/compiler:clang-cl": {"DX_EXPECTED_COMPILER": "clang-cl"},
    }),
    imports = ["."],
    runner = "plain",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [
        ":dxlinked",
        ":dxnative",
    ],
)

cc_toolchain_test(
    name = "native_ext_gcc_test",
    compiler = "gcc",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    test = ":native_ext_test",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_cpp",
    testonly = True,
    aspect_hints = ["//:clang_format_config"],
    cpp_srcs = [
        "dxhelper.cc",
        "dxlinked.cc",
        "dxnative.cc",
    ],
    tags = ["corpus"],
)

cc_library(
    name = "native_ext",
    testonly = True,
    srcs = [
        "dxhelper.cc",
        "dxlinked.cc",
        "dxnative.cc",
    ],
)
