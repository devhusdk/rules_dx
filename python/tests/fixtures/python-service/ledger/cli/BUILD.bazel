load("//python/rules:defs.bzl", "python_binary", "python_library", "python_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = [
    "//python/tests/analysis:__pkg__",
    "//python/tests/fixtures/python-service:__subpackages__",
])

python_library(
    name = "cli",
    srcs = [
        "__init__.py",
        "main.py",
    ],
    imports = ["../.."],
    deps = [
        "//python/tests/fixtures/python-service/ledger/core",
        "//python/tests/fixtures/python-service/ledger/service",
        "@pypi//click",
    ],
)

python_binary(
    name = "ledger",
    srcs = ["main.py"],
    dep_group = "ledger",
    imports = ["../.."],
    main = "main.py",
    visibility = ["//visibility:public"],
    deps = [":cli"],
)

python_binary(
    name = "broken",
    testonly = True,
    srcs = ["broken_main.py"],
    dep_group = "ledger",
    imports = ["../.."],
    main = "broken_main.py",
)

python_test(
    name = "cli_test",
    srcs = ["cli_test.py"],
    data = [":ledger"],
    dep_group = "ledger",
    env = {"LEDGER_BIN": "$(rootpath :ledger)"},
    imports = ["../.."],
    deps = [
        ":cli",
        "//python/tests/fixtures/python-service/ledger/core",
        "@pypi//coverage",
        "@pypi//pytest",
    ],
)

python_test(
    runner = "plain",
    name = "cli_unittest_test",
    srcs = ["cli_unittest_test.py"],
    data = [":ledger"],
    dep_group = "ledger",
    env = {"LEDGER_BIN": "$(rootpath :ledger)"},
    imports = ["../.."],
)

python_test(
    name = "broken_test",
    srcs = ["broken_test.py"],
    data = [":broken"],
    dep_group = "ledger",
    env = {"BROKEN_BIN": "$(rootpath :broken)"},
    imports = ["../.."],
    deps = [
        "@pypi//coverage",
        "@pypi//pytest",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

exports_files([
    "BUILD.bazel",
    "__init__.py",
    "broken_main.py",
    "broken_test.py",
    "cli_test.py",
    "cli_unittest_test.py",
    "main.py",
])
