load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//quality:fixtures.bzl", "real_source_target")
load("@rules_py//py/private/toolchain:tools.bzl", "dummy_toolchain")
load("@rules_python//python:py_runtime.bzl", "py_runtime")
load("@rules_python//python:py_runtime_pair.bzl", "py_runtime_pair")
load("//python:defs.bzl", "python_test")
load(":msvc_sdist_tests.bzl", "msvc_sdist_tests")

package(default_visibility = ["//visibility:private"])

platform(
    name = "windows_x64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

toolchain(
    name = "cc_toolchain",
    target_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
    toolchain = "//cc/tests/fixtures/msvc_layout:toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

genrule(
    name = "python_files",
    outs = [
        "python.exe",
        "include/pyconfig.h",
        "libs/python312.lib",
    ],
    cmd = "touch $(OUTS)",
)

py_runtime(
    name = "python_runtime",
    files = [
        "include/pyconfig.h",
        "libs/python312.lib",
    ],
    interpreter = "python.exe",
    interpreter_version_info = {
        "major": "3",
        "minor": "12",
        "micro": "0",
    },
    python_version = "PY3",
)

py_runtime_pair(
    name = "python_runtime_pair",
    py3_runtime = ":python_runtime",
)

toolchain(
    name = "python_toolchain",
    toolchain = ":python_runtime_pair",
    toolchain_type = "@bazel_tools//tools/python:toolchain_type",
)

dummy_toolchain(name = "native_build_sentinel")

toolchain(
    name = "native_build_toolchain",
    exec_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":native_build_sentinel",
    toolchain_type = "@rules_py//py/private/toolchain:native_build_toolchain_type",
)

write_file(
    name = "stub_sdist",
    out = "stub_sdist.tar.gz",
    content = [""],
)

write_file(
    name = "stub_tool",
    out = "stub_tool.sh",
    content = [
        "#!/bin/sh",
        "exit 0",
    ],
    is_executable = True,
)

msvc_sdist_tests(
    name = "msvc_sdist_tests",
    sdist = ":stub_sdist",
    tool = ":stub_tool",
)

python_test(
    name = "build_helper_msvc_test",
    size = "small",
    srcs = ["build_helper_msvc_test.py"],
    data = ["@rules_py//uv/private/pep517_whl/tools:build_helper.py"],
    env = {"BUILD_HELPER": "$(rootpath @rules_py//uv/private/pep517_whl/tools:build_helper.py)"},
    imports = ["."],
    main = "build_helper_msvc_test.py",
    runner = "plain",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "msvc_sdist_tests.bzl",
    ],
    tags = ["corpus"],
    visibility = ["//:__pkg__"],
)
