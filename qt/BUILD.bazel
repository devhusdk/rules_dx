load("//qt/private/sdk:repos.bzl", "qualified_cells")
load("//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

exports_files(["README.md"])

filegroup(
    name = "module_srcs",
    srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "extensions.bzl",
        "//:module_srcs",
        "//qt/private/platforms:module_srcs",
        "//qt/private:module_srcs",
        "//qt/private/rust:module_srcs",
        "//qt/private/sdk:module_srcs",
    ],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@llvm//constraints/cxxstdlib:libstdcxx.14.3.0",
        "@llvm//constraints/libc:gnu.2.39",
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@llvm//constraints/cxxstdlib:libstdcxx.11.5.0",
        "@llvm//constraints/libc:gnu.2.34",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "windows_arm64",
    constraint_values = [
        "@llvm//constraints/windows/abi:msvc",
        "@platforms//cpu:arm64",
        "@platforms//os:windows",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "windows_x86_64",
    constraint_values = [
        "@llvm//constraints/windows/abi:msvc",
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
    visibility = ["//visibility:public"],
)

[
    alias(
        name = cell + "_cell",
        actual = "//qt/private/sdk:" + cell + "_cell",
        visibility = ["//visibility:public"],
    )
    for cell in qualified_cells()
]

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

exports_files([
    "defs.bzl",
    "extensions.bzl",
    "lang.json",
])
