load("@bazel_skylib//lib:selects.bzl", "selects")
load("//qt/sdk:pins.bzl", "CELLS")
load("//qt/sdk:repos.bzl", "qualified_cells")
load("//quality:fixtures.bzl", "real_source_target")
load(":libc.bzl", "glibc_at_least")

package(default_visibility = ["//visibility:public"])

# One setting per qualified Qt cell. QT_COMPATIBLE_WITH and the consumer
# identity selects in //qt/rules:defs.bzl key on these. A Linux cell matches
# only glibc at or above the SDK floor; musl and older glibc do not match.
[
    config_setting(
        name = "cell_" + cell,
        constraint_values = CELLS[cell].constraints,
        flag_values = {"//cc/toolchains:compiler": CELLS[cell].layout.compiler} if CELLS[cell].layout.compiler else {},
    )
    for cell in qualified_cells()
    if CELLS[cell].layout.os != "linux"
]

[
    config_setting(
        name = "cell_{}_gnu.{}".format(cell, version),
        constraint_values = CELLS[cell].constraints + ["@llvm//constraints/libc:gnu." + version],
    )
    for cell in qualified_cells()
    if CELLS[cell].layout.os == "linux"
    for version in glibc_at_least(CELLS[cell].runtime.glibc)
]

[
    selects.config_setting_group(
        name = "cell_" + cell,
        match_any = [
            ":cell_{}_gnu.{}".format(cell, version)
            for version in glibc_at_least(CELLS[cell].runtime.glibc)
        ],
    )
    for cell in qualified_cells()
    if CELLS[cell].layout.os == "linux"
]

platform(
    name = "linux_arm64",
    constraint_values = [
        "@llvm//constraints/cxxstdlib:libstdcxx.14.3.0",
        "@llvm//constraints/libc:gnu.2.39",
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@llvm//constraints/cxxstdlib:libstdcxx.11.5.0",
        "@llvm//constraints/libc:gnu.2.34",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
)

platform(
    name = "windows_arm64",
    constraint_values = [
        "@llvm//constraints/windows/abi:msvc",
        "@platforms//cpu:arm64",
        "@platforms//os:windows",
    ],
)

platform(
    name = "windows_x86_64",
    constraint_values = [
        "@llvm//constraints/windows/abi:msvc",
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "libc.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
