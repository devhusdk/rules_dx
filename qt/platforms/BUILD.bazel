load("//qt/sdk:pins.bzl", "CELLS")
load("//qt/sdk:repos.bzl", "qualified_cells")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

# One os+cpu setting per qualified Qt cell. QT_COMPATIBLE_WITH and the
# consumer identity selects in //qt/rules:defs.bzl key on these.
[
    config_setting(
        name = "cell_" + cell,
        constraint_values = CELLS[cell].constraints,
    )
    for cell in qualified_cells()
]

platform(
    name = "linux_arm64",
    constraint_values = [
        "@llvm//constraints/cxxstdlib:libstdcxx.14.3.0",
        "@llvm//constraints/libc:gnu.2.39",
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@llvm//constraints/cxxstdlib:libstdcxx.11.5.0",
        "@llvm//constraints/libc:gnu.2.34",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
