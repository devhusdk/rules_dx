load("@rules_cc//cc:defs.bzl", "cc_library")
load(":corpus.bzl", "qt_corpus")
load(":coverage.bzl", "qt_coverage_probe")

package(default_visibility = [
    "//:__pkg__",
    "//qt:__subpackages__",
    "//tools/ci:__pkg__",
])

qt_coverage_probe(
    name = "coverage_probe",
    visibility = ["//:__subpackages__"],
)

constraint_setting(name = "unsupported_setting")

constraint_value(
    name = "unsupported",
    constraint_setting = ":unsupported_setting",
    visibility = ["//visibility:public"],
)

exports_files([
    "bundle.bzl",
    "cells.bzl",
    "constants.bzl",
    "corpus.bzl",
    "coverage.bzl",
    "defs.bzl",
    "generate.bzl",
    "providers.bzl",
    "rust_bridge.bzl",
    "text.bzl",
    "validate.bzl",
])

qt_corpus(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "bundle.bzl",
        "cells.bzl",
        "constants.bzl",
        "corpus.bzl",
        "coverage.bzl",
        "defs.bzl",
        "generate.bzl",
        "providers.bzl",
        "rust.bzl",
        "rust_bridge.bzl",
        "text.bzl",
        "validate.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)

cc_library(
    name = "windows_test_console",
    srcs = ["windows_test_console.cc"],
    linkopts = ["user32.lib"],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//visibility:public"],
    alwayslink = True,
)
