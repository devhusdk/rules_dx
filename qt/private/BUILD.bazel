load("@rules_cc//cc:defs.bzl", "cc_library")
load("//deploy/private:native_runtime.bzl", "dx_native_runtime")
load("//qt/private/toolchain:pins.bzl", "CELLS", "IDENTITIES")
load("//qt/private/toolchain:repos.bzl", "qualified_cells")
load(":corpus.bzl", "qt_corpus")
load(":coverage.bzl", "qt_coverage_probe")
load(":defs.bzl", "qt_os_supplied_libraries")

package(default_visibility = [
    "//:__pkg__",
    "//qt:__subpackages__",
    "//tools/ci:__pkg__",
])

qt_coverage_probe(
    name = "coverage_probe",
    visibility = ["//:__subpackages__"],
)

constraint_setting(name = "unsupported_setting")

constraint_value(
    name = "unsupported",
    constraint_setting = ":unsupported_setting",
    visibility = ["//visibility:public"],
)

exports_files([
    "bundle.bzl",
    "cells.bzl",
    "constants.bzl",
    "corpus.bzl",
    "coverage.bzl",
    "defs.bzl",
    "generate.bzl",
    "providers.bzl",
    "rust_bridge.bzl",
    "text.bzl",
    "validate.bzl",
])

[
    dx_native_runtime(
        name = "os_runtime_" + cell,
        provides = qt_os_supplied_libraries(CELLS[cell].needs.library),
        redistribution = "os_supplied",
        source = "operating system",
        version = IDENTITIES[cell].min_runtime,
        visibility = ["//visibility:public"],
    )
    for cell in qualified_cells()
    if CELLS[cell].layout.os == "linux" and IDENTITIES[cell] != None and CELLS[cell].needs != None
]

qt_corpus(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "archive.bzl",
        "bundle.bzl",
        "cells.bzl",
        "constants.bzl",
        "corpus.bzl",
        "coverage.bzl",
        "defs.bzl",
        "generate.bzl",
        "providers.bzl",
        "rust.bzl",
        "rust_bridge.bzl",
        "text.bzl",
        "validate.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)

cc_library(
    name = "windows_test_console",
    srcs = ["windows_test_console.cc"],
    linkopts = ["user32.lib"],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//visibility:public"],
    alwayslink = True,
)
