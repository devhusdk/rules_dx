load("//libs/starlark:conformance.bzl", "dx_wrapper_contract_tests")
load("//libs/starlark:defs.bzl", "expect_equal")
load("//quality:fixtures.bzl", "real_source_target")
load(":defs.bzl", "QT_SOURCE_SPECS")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
])

dx_wrapper_contract_tests(
    name = "wrapper_contract_tests",
    extra_checks = [
        expect_equal(
            "qt rules own c, cpp and qml sources",
            [file_class for file_class, _ in QT_SOURCE_SPECS],
            [
                "c",
                "cpp",
                "qml",
            ],
        ),
    ],
    file_classes = [file_class for file_class, _ in QT_SOURCE_SPECS],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "rust.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
