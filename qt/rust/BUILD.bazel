load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_test", "rustfmt_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_binary(
    name = "qt_rust_bridge",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "qt/qt_rust_bridge",
        normal = True,
    ),
    crate_name = "qt_rust_bridge",
    crate_root = "src/main.rs",
    edition = "2021",
    deps = all_crate_deps(
        package_name = "qt/qt_rust_bridge",
        normal = True,
    ),
)

alias(
    name = "cxx",
    actual = "@crates//:cxx",
)

alias(
    name = "cxx_qt",
    actual = "@crates//:cxx-qt",
)

alias(
    name = "cxx_qt_runtime_files",
    actual = "@crates//:cxx_qt_runtime_files",
)

rustfmt_test(
    name = "qt_rust_bridge_fmt_test",
    targets = [
        ":qt_rust_bridge",
        ":qt_rust_bridge_bin_test",
    ],
)

rust_clippy_test(
    name = "qt_rust_bridge_clippy_test",
    targets = [
        ":qt_rust_bridge",
        ":qt_rust_bridge_bin_test",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

rust_test(
    name = "qt_rust_bridge_bin_test",
    aliases = aliases(
        package_name = "qt/qt_rust_bridge",
        normal = True,
        normal_dev = True,
    ),
    crate = ":qt_rust_bridge",
    deps = all_crate_deps(
        package_name = "qt/qt_rust_bridge",
        normal = True,
        normal_dev = True,
    ),
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
