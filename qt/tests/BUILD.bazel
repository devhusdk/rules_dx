# gazelle:ignore

load("@bazel_lib//lib:transitions.bzl", "platform_transition_binary", "platform_transition_filegroup")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//cc/toolchains:select.bzl", "cc_toolchain_binary", "cc_toolchain_test")
load("//qt/rules:defs.bzl", "QT_COMPATIBLE_WITH", "qt_bundle", "qt_cc_binary", "qt_cc_library", "qt_cc_test", "qt_frameworks", "qt_qml_module")
load("//qt/rules:rust.bzl", "qt_rust_library")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")
load("//tools/testing:child_runfiles.bzl", "child_runfiles")
load(":rules_tests.bzl", "qt_rules_tests")

_MACOS_ARM64 = [
    "@platforms//os:macos",
    "@platforms//cpu:arm64",
]

_LINUX_ARM64 = [
    "@platforms//os:linux",
    "@platforms//cpu:arm64",
]

_LINUX_X86_64 = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

_WINDOWS_ARM64 = [
    "@platforms//os:windows",
    "@platforms//cpu:arm64",
]

_WINDOWS_X86_64 = [
    "@platforms//os:windows",
    "@platforms//cpu:x86_64",
]

qt_frameworks(
    name = "probe_qt_frameworks",
    tags = ["manual"],
    target_compatible_with = QT_COMPATIBLE_WITH,
    deps = ["@dx_qt//:qml"],
)

cc_binary(
    name = "probe",
    srcs = ["probe.cc"],
    copts = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["-fPIC"],
    }),
    data = ["@dx_qt//:qml_imports"],
    linkstatic = False,
    tags = ["manual"],
    target_compatible_with = QT_COMPATIBLE_WITH,
    deps = [
        ":probe_qt_frameworks",
        "@dx_qt//:qml",
    ],
)

platform_transition_binary(
    name = "probe_linux_x86_64",
    binary = ":probe",
    tags = ["manual"],
    target_compatible_with = _LINUX_X86_64,
    target_platform = "//qt/platforms:linux_x86_64",
)

platform_transition_binary(
    name = "probe_linux_arm64",
    binary = ":probe",
    tags = ["manual"],
    target_compatible_with = _LINUX_ARM64,
    target_platform = "//qt/platforms:linux_arm64",
)

platform_transition_binary(
    name = "probe_macos_arm64",
    binary = ":probe",
    tags = ["manual"],
    target_compatible_with = _MACOS_ARM64,
    target_platform = "//qt/platforms:macos_arm64",
)

# Qt's msvc2022 DLLs export Microsoft STL types, so Windows builds with cl.exe.
cc_toolchain_binary(
    name = "probe_windows_x86_64",
    binary = ":probe",
    compiler = "msvc",
    platforms = ["//qt/platforms:windows_x86_64"],
    tags = ["manual"],
    target_compatible_with = _WINDOWS_X86_64,
)

cc_toolchain_binary(
    name = "probe_windows_arm64",
    binary = ":probe",
    compiler = "msvc",
    platforms = ["//qt/platforms:windows_arm64"],
    tags = ["manual"],
    target_compatible_with = _WINDOWS_ARM64,
)

alias(
    name = "probe_native",
    actual = select({
        "@dx_qt//:linux_arm64": ":probe_linux_arm64",
        "@dx_qt//:linux_x86_64": ":probe_linux_x86_64",
        "@dx_qt//:macos_arm64": ":probe_macos_arm64",
        "@dx_qt//:windows_arm64": ":probe_windows_arm64",
        "@dx_qt//:windows_x86_64": ":probe_windows_x86_64",
    }),
    tags = ["manual"],
)

# The windows_x86_64 cell publishes no needs tables; its qt_test skips the table check.
alias(
    name = "needs_native",
    actual = select({
        "@platforms//os:windows": "//qt/sdk:windows_x86_64.bzl",
        "//conditions:default": "@dx_qt//:needs",
    }),
    tags = ["manual"],
)

# A tool run as a data dependency has no runfiles of its own on Windows, so each one carries its manifest.
_WINDOWS_CHILD_TOOLS = [
    "moc",
    "qmlformat",
    "qmllint",
    "qmltyperegistrar",
    "rcc",
    "uic",
]

_QT_FONTS = select({
    "@platforms//os:macos": [],
    "//conditions:default": ["@dx_qt//:fonts"],
})

[
    child_runfiles(
        name = name + "_child",
        binary = "@dx_qt//:" + name,
        tags = ["manual"],
        target_compatible_with = ["@platforms//os:windows"],
    )
    for name in _WINDOWS_CHILD_TOOLS
]

_WINDOWS_CHILDREN = [":" + name + "_child" for name in _WINDOWS_CHILD_TOOLS]

_VCRUNTIME = select({
    "@platforms//os:windows": ["//cc/toolchains:msvc_vcruntime"],
    "//conditions:default": [],
})

_QT_TEST_ENV = {
    "DX_MOC": "$(rootpath @dx_qt//:moc)",
    "DX_QMLFORMAT": "$(rootpath @dx_qt//:qmlformat)",
    "DX_QMLLINT": "$(rootpath @dx_qt//:qmllint)",
    "DX_QMLTYPEREGISTRAR": "$(rootpath @dx_qt//:qmltyperegistrar)",
    "DX_QT_FORM": "$(rootpath fixtures/dialog.ui)",
    "DX_QT_GUI": "$(rootpath :gui_check_native)",
    "DX_QT_LICENSES": "$(rootpaths @dx_qt//:licenses)",
    "DX_QT_NEEDS": "$(rootpath :needs_native)",
    "DX_QT_PLATFORMS": "$(rootpaths @dx_qt//:platforms)",
    "DX_QT_PROBE": "$(rootpath :probe_native)",
    "DX_QT_QMLDIR": "$(rlocationpath @dx_qt//:qtqml_qmldir)",
    "DX_QT_QMLDIR_PATH": "$(rootpath @dx_qt//:qtqml_qmldir)",
    "DX_QT_RUNTIME": "$(rootpaths @dx_qt//:runtime)",
    "DX_QT_SBOM": "$(rootpaths @dx_qt//:sbom)",
    "DX_RCC": "$(rootpath @dx_qt//:rcc)",
    "DX_UIC": "$(rootpath @dx_qt//:uic)",
}

rust_test(
    name = "qt_test",
    srcs = ["qt_test.rs"],
    data = [
        "fixtures/dialog.ui",
        ":gui_check_native",
        ":needs_native",
        ":probe_native",
        "@dx_qt//:licenses",
        "@dx_qt//:moc",
        "@dx_qt//:platforms",
        "@dx_qt//:qml_imports",
        "@dx_qt//:qmlformat",
        "@dx_qt//:qmllint",
        "@dx_qt//:qmltyperegistrar",
        "@dx_qt//:qtqml_qmldir",
        "@dx_qt//:rcc",
        "@dx_qt//:runtime",
        "@dx_qt//:sbom",
        "@dx_qt//:uic",
    ] + _QT_FONTS + _VCRUNTIME + select({
        "@platforms//os:windows": _WINDOWS_CHILDREN + [":console_fixture_windows_x86_64"],
        "//conditions:default": [],
    }),
    env = select({
        "@platforms//os:macos": _QT_TEST_ENV,
        "@platforms//os:windows": dict(
            _QT_TEST_ENV,
            DX_QT_CONSOLE_FIXTURE = "$(rootpath :console_fixture_windows_x86_64)",
            DX_QT_FONTS = "$(rootpaths @dx_qt//:fonts)",
            DX_QT_VCRUNTIME = "$(rootpaths //cc/toolchains:msvc_vcruntime)",
        ),
        "//conditions:default": dict(
            _QT_TEST_ENV,
            DX_QT_FONTS = "$(rootpaths @dx_qt//:fonts)",
        ),
    }),
    tags = [
        "block-network",
        "no-remote-exec",
    ],
    # Windows is data only here: the C++ probes are built with cl.exe by cc_toolchain_binary.
    target_compatible_with = select({
        "@dx_qt//:linux_arm64": [],
        "@dx_qt//:linux_x86_64": [],
        "@dx_qt//:macos_arm64": [],
        "@dx_qt//:windows_arm64": [],
        "@dx_qt//:windows_x86_64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//tools/testing:dx_testing"],
)

rustfmt_test(
    name = "qt_fmt_test",
    targets = [
        ":consumer_identity_test_linux_arm64",
        ":consumer_identity_test_linux_x86_64",
        ":consumer_identity_test_macos_arm64",
        ":qt_test",
    ],
)

rust_clippy_test(
    name = "qt_clippy_test",
    targets = [":qt_test"],
)

qt_cc_library(
    name = "gui",
    testonly = True,
    srcs = ["gui_test.cc"],
    forms = ["fixtures/dialog.ui"],
    moc_hdrs = ["gui_test.h"],
    modules = [
        "quick",
        "test",
        "widgets",
    ],
    target_compatible_with = QT_COMPATIBLE_WITH,
)

qt_cc_test(
    name = "gui_test",
    modules = [
        "quick",
        "test",
        "widgets",
    ],
    target_compatible_with = QT_COMPATIBLE_WITH,
    deps = [":gui"],
)

cc_toolchain_test(
    name = "qt_test_msvc",
    compiler = "msvc",
    tags = [
        "block-network",
        "no-remote-exec",
    ],
    target_compatible_with = _WINDOWS_X86_64,
    test = ":qt_test",
)

cc_toolchain_test(
    name = "gui_test_msvc",
    compiler = "msvc",
    tags = ["no-remote-exec"],
    target_compatible_with = _WINDOWS_X86_64,
    test = ":gui_test",
)

qt_cc_binary(
    name = "gui_check",
    testonly = True,
