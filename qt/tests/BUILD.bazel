# gazelle:ignore

load("@bazel_lib//lib:transitions.bzl", "platform_transition_binary")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//qt/rules:defs.bzl", "qt_bundle", "qt_cc_binary", "qt_cc_library", "qt_cc_test", "qt_frameworks", "qt_qml_module")
load("//qt/rules:rust.bzl", "qt_rust_library")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")
load("//tools/testing:nested_bazel.bzl", "NESTED_BAZEL_DATA", "NESTED_BAZEL_NETWORK_ENV", "NESTED_BAZEL_NETWORK_TAGS")
load(":rules_tests.bzl", "qt_rules_tests")

_LINUX = select({
    "@platforms//cpu:arm64": ["@platforms//os:linux"],
    "@platforms//cpu:x86_64": ["@platforms//os:linux"],
    "//conditions:default": ["@platforms//:incompatible"],
})

_HOSTS = select({
    "@dx_qt//:linux_arm64": [],
    "@dx_qt//:linux_x86_64": [],
    "@dx_qt//:macos_arm64": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

_MACOS_ARM64 = [
    "@platforms//os:macos",
    "@platforms//cpu:arm64",
]

_LINUX_ARM64 = [
    "@platforms//os:linux",
    "@platforms//cpu:arm64",
]

_LINUX_X86_64 = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

qt_frameworks(
    name = "probe_qt_frameworks",
    tags = ["manual"],
    target_compatible_with = _HOSTS,
    deps = ["@dx_qt//:qml"],
)

cc_binary(
    name = "probe",
    srcs = ["probe.cc"],
    copts = ["-fPIC"],
    data = ["@dx_qt//:qml_imports"],
    linkstatic = False,
    tags = ["manual"],
    target_compatible_with = _HOSTS,
    deps = [
        ":probe_qt_frameworks",
        "@dx_qt//:qml",
    ],
)

platform_transition_binary(
    name = "probe_linux_x86_64",
    binary = ":probe",
    tags = ["manual"],
    target_compatible_with = _LINUX_X86_64,
    target_platform = "//qt/platforms:linux_x86_64",
)

platform_transition_binary(
    name = "probe_linux_arm64",
    binary = ":probe",
    tags = ["manual"],
    target_compatible_with = _LINUX_ARM64,
    target_platform = "//qt/platforms:linux_arm64",
)

platform_transition_binary(
    name = "probe_macos_arm64",
    binary = ":probe",
    tags = ["manual"],
    target_compatible_with = _MACOS_ARM64,
    target_platform = "//qt/platforms:macos_arm64",
)

alias(
    name = "probe_native",
    actual = select({
        "@dx_qt//:linux_arm64": ":probe_linux_arm64",
        "@dx_qt//:linux_x86_64": ":probe_linux_x86_64",
        "@dx_qt//:macos_arm64": ":probe_macos_arm64",
    }),
    tags = ["manual"],
)

# The macos_arm64 cell publishes no needs tables; its qt_test skips the table check.
alias(
    name = "needs_native",
    actual = select({
        "@platforms//os:macos": "//qt/sdk:macos_arm64.bzl",
        "//conditions:default": "@dx_qt//:needs",
    }),
    tags = ["manual"],
)

rust_test(
    name = "qt_test",
    size = "small",
    srcs = ["qt_test.rs"],
    data = [
        "fixtures/dialog.ui",
        ":gui_check_native",
        ":needs_native",
        ":probe_native",
        "@dx_qt//:fonts",
        "@dx_qt//:licenses",
        "@dx_qt//:moc",
        "@dx_qt//:platforms",
        "@dx_qt//:qml_imports",
        "@dx_qt//:qmlformat",
        "@dx_qt//:qmllint",
        "@dx_qt//:qmltyperegistrar",
        "@dx_qt//:qtqml_qmldir",
        "@dx_qt//:rcc",
        "@dx_qt//:runtime",
        "@dx_qt//:sbom",
        "@dx_qt//:uic",
    ],
    env = {
        "DX_MOC": "$(rootpath @dx_qt//:moc)",
        "DX_QMLFORMAT": "$(rootpath @dx_qt//:qmlformat)",
        "DX_QMLLINT": "$(rootpath @dx_qt//:qmllint)",
        "DX_QMLTYPEREGISTRAR": "$(rootpath @dx_qt//:qmltyperegistrar)",
        "DX_QT_FONTS": "$(rootpaths @dx_qt//:fonts)",
        "DX_QT_FORM": "$(rootpath fixtures/dialog.ui)",
        "DX_QT_GUI": "$(rootpath :gui_check_native)",
        "DX_QT_LICENSES": "$(rootpaths @dx_qt//:licenses)",
        "DX_QT_NEEDS": "$(rootpath :needs_native)",
        "DX_QT_PLATFORMS": "$(rootpaths @dx_qt//:platforms)",
        "DX_QT_PROBE": "$(rootpath :probe_native)",
        "DX_QT_QMLDIR": "$(rlocationpath @dx_qt//:qtqml_qmldir)",
        "DX_QT_QMLDIR_PATH": "$(rootpath @dx_qt//:qtqml_qmldir)",
        "DX_QT_SBOM": "$(rootpaths @dx_qt//:sbom)",
        "DX_RCC": "$(rootpath @dx_qt//:rcc)",
        "DX_UIC": "$(rootpath @dx_qt//:uic)",
    },
    tags = [
        "block-network",
        "no-remote-exec",
    ],
    target_compatible_with = _HOSTS,
    deps = ["//tools/testing:dx_testing"],
)

rustfmt_test(
    name = "qt_fmt_test",
    targets = [":qt_test"],
)

rust_clippy_test(
    name = "qt_clippy_test",
    targets = [":qt_test"],
)

rust_test(
    name = "qt_app_consumer_test",
    size = "enormous",
    srcs = ["qt_app_consumer_test.rs"],
    data = [
        "//cli/cli:dx",
        "//qt:module_srcs",
    ] + NESTED_BAZEL_DATA,
    env = {
        "DX_BIN": "$(rootpath //cli/cli:dx)",
        "RUST_TEST_THREADS": "1",
    } | NESTED_BAZEL_NETWORK_ENV,
    env_inherit = [
        "HOME",
        "PATH",
    ],
    # Fetches the Qt SDK.
    tags = NESTED_BAZEL_NETWORK_TAGS,
    target_compatible_with = _LINUX,
    deps = [
        ":qt_board_support",
        "//tools/testing:dx_nested",
        "//tools/testing:dx_testing",
    ],
)

rustfmt_test(
    name = "qt_app_consumer_fmt_test",
    targets = [":qt_app_consumer_test"],
)

rust_clippy_test(
    name = "qt_app_consumer_clippy_test",
    targets = [":qt_app_consumer_test"],
)

rust_test(
    name = "qt_cell_consumer_test",
    size = "enormous",
    srcs = ["qt_cell_consumer_test.rs"],
    data = [
        "//qt:module_srcs",
        "//qt/sdk:linux_x86_64_cell",
    ] + NESTED_BAZEL_DATA,
    env = {
        "CELL_SPEC": "$(rootpath //qt/sdk:linux_x86_64_cell)",
        "RUST_TEST_THREADS": "1",
