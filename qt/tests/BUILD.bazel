load("@bazel_lib//lib:transitions.bzl", "platform_transition_binary")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")
load(":unsupported_tests.bzl", "qt_unsupported_tests")

_LINUX_X86_64 = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

cc_binary(
    name = "probe",
    srcs = ["probe.cc"],
    copts = ["-fPIC"],
    data = ["@dx_qt//:qml_imports"],
    linkstatic = False,
    tags = ["manual"],
    target_compatible_with = _LINUX_X86_64,
    deps = ["@dx_qt//:qml"],
)

platform_transition_binary(
    name = "probe_linux_x86_64",
    binary = ":probe",
    tags = ["manual"],
    target_compatible_with = _LINUX_X86_64,
    target_platform = "//qt/platforms:linux_x86_64",
)

rust_test(
    name = "qt_test",
    size = "small",
    srcs = ["qt_test.rs"],
    data = [
        ":probe_linux_x86_64",
        "@dx_qt//:licenses",
        "@dx_qt//:qmlformat",
        "@dx_qt//:qmllint",
        "@dx_qt//:qtqml_qmldir",
        "@dx_qt//:sbom",
    ],
    env = {
        "DX_QMLFORMAT": "$(rootpath @dx_qt//:qmlformat)",
        "DX_QMLLINT": "$(rootpath @dx_qt//:qmllint)",
        "DX_QT_LICENSES": "$(rootpaths @dx_qt//:licenses)",
        "DX_QT_PROBE": "$(rootpath :probe_linux_x86_64)",
        "DX_QT_QMLDIR": "$(rlocationpath @dx_qt//:qtqml_qmldir)",
        "DX_QT_SBOM": "$(rootpaths @dx_qt//:sbom)",
    },
    tags = ["block-network"],
    target_compatible_with = _LINUX_X86_64,
    deps = ["//tools/testing:dx_testing"],
)

rustfmt_test(
    name = "qt_fmt_test",
    targets = [":qt_test"],
)

rust_clippy_test(
    name = "qt_clippy_test",
    targets = [":qt_test"],
)

qt_unsupported_tests(name = "unsupported_test")

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "unsupported_tests.bzl",
    ],
    tags = ["corpus"],
)
