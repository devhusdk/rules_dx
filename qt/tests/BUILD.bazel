    platforms = ["//qt/platforms:windows_arm64"],
    tags = ["manual"],
    target_compatible_with = _WINDOWS_ARM64,
)

alias(
    name = "gui_check_native",
    testonly = True,
    actual = select({
        "@dx_qt//:linux_arm64": ":gui_check_linux_arm64",
        "@dx_qt//:linux_x86_64": ":gui_check_linux_x86_64",
