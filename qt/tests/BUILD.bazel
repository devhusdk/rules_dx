    name = "plugin_path_test",
    srcs = ["fixtures/plugin_path.cc"],
    plugins = ["imageformats"],
    target_compatible_with = QT_COMPATIBLE_WITH,
)

[
    platform_transition_filegroup(
        name = "consumer_archives_" + cell,
        srcs = [
            "//qt/tests/fixtures/qt-rust/app:ledger_release_archive",
            "//qt/tests/fixtures/qt-tasks/app:board_release_archive",
            "//qt/tests/fixtures/qt-tasks/app:tasks_release_archive",
        ],
        tags = ["manual"],
        target_platform = "//qt/platforms:" + cell,
    )
    for cell in [
        "linux_x86_64",
        "linux_arm64",
        "macos_arm64",
        "windows_x86_64",
    ]
]

[
    rust_test(
        name = "consumer_identity_test_" + cell,
        srcs = ["consumer_identity_test.rs"],
        crate_name = "consumer_identity_test_" + cell.replace("-", "_"),
        data = [":consumer_archives_" + cell],
        env = {
            "DX_QT_ARCHIVES": "$(rootpaths :consumer_archives_" + cell + ")",
            "DX_QT_CORE_MEMBER": core,
        } | ({"DX_QT_RUN_LEDGER": "1"} if os != "windows" else {}) | {
            "DX_QT_RUNTIME_RECORD": "msvc_vcruntime * app_local" if os == "windows" else ("os_runtime_" + cell + " " + glibc + " os_supplied" if glibc else ""),
        } | ({"DX_QT_TASKS_RECORD": "runtime_runtime 6.11.3 os_supplied"} if os == "macos" else {}),
        target_compatible_with = ["@platforms//os:" + os, "@platforms//cpu:" + cpu],
        deps = [
            "//deploy/rules:dx_deploy_tools",
            "//tools/testing:dx_testing",
        ],
    )
    for (cell, os, cpu, glibc, core) in [
        ("linux_x86_64", "linux", "x86_64", "glibc-2.34", "resources/lib/libQt6Core.so.6"),
        ("linux_arm64", "linux", "arm64", "glibc-2.39", "resources/lib/libQt6Core.so.6"),
        ("macos_arm64", "macos", "arm64", "", "resources/lib/QtCore.framework/Versions/A/QtCore"),
        ("windows_x86_64", "windows", "x86_64", "", "Qt6Core.dll"),
    ]
]
