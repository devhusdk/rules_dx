rustfmt_test(
    name = "qt_cell_consumer_fmt_test",
    targets = [":qt_cell_consumer_test"],
)

rust_clippy_test(
    name = "qt_cell_consumer_clippy_test",
    targets = [":qt_cell_consumer_test"],
)

rust_library(
    name = "qt_board_support",
    testonly = True,
    srcs = ["qt_board_support.rs"],
    crate_name = "qt_board_support",
    deps = [
        "//tools/testing:dx_nested",
