load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//cc:defs.bzl", "cc_library")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//qt/private:rust_bridge.bzl", "qt_rust_bridge")

exports_files(
    [
        "bridge.rs",
        "shared.h",
    ],
    visibility = ["//qt/tests:__pkg__"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

cc_library(
    name = "other",
    testonly = True,
    hdrs = ["shared.h"],
    visibility = ["//visibility:public"],
)

write_file(
    name = "stub_generator",
    testonly = True,
    out = "stub_generator.sh",
    content = ["#!/bin/sh"],
    is_executable = True,
)

qt_rust_bridge(
    name = "custom_generator_bridge",
    testonly = True,
    bridges = ["bridge.rs"],
    generator = ":stub_generator",
    tags = ["manual"],
    visibility = ["//qt/tests:__pkg__"],
)
