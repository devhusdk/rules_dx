load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_dx//deploy/rules:archive.bzl", "consumer_archive")
load("@rules_dx//qt/rules:defs.bzl", "QT_CONSUMER_ARCH", "QT_CONSUMER_MIN_RUNTIME", "QT_CONSUMER_OS", "QT_CONSUMER_RUNTIME", "qt_bundle", "qt_cc_binary", "qt_cc_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

# The QML plugin imports QtQmlMeta; linking Quick stages it with the binary.
_QML_META = select({
    "@platforms//os:linux": [],
    "//conditions:default": ["@dx_qt//:quick"],
})

# Rust std on Windows imports ntdll.
_NTDLL = select({
    "@platforms//os:windows": ["ntdll.lib"],
    "//conditions:default": [],
})

qt_cc_binary(
    name = "ledger",
    srcs = ["main.cc"],
    linkopts = _NTDLL,
    modules = ["qml"],
    deps = ["//qt/tests/fixtures/qt-rust/ui"] + _QML_META,
)

qt_cc_test(
    name = "ledger_test",
    srcs = ["ledger_test.cc"],
    linkopts = _NTDLL,
    moc_hdrs = ["ledger_test.h"],
    modules = [
        "qml",
        "test",
    ],
    deps = [
        "//qt/tests/fixtures/qt-rust/model",
        "//qt/tests/fixtures/qt-rust/ui",
    ] + _QML_META,
)

sh_test(
    name = "ledger_symbols_test",
    srcs = ["ledger_symbols_test.sh"],
    args = [
        "$(rootpath @llvm//tools:llvm-nm)",
        "$(rootpath :ledger_test)",
    ],
    data = [
        ":ledger_test",
        "@llvm//tools:llvm-nm",
    ],
)

qt_bundle(
    name = "runtime",
    binary = ":ledger",
    licenses = [
        "licenses/apache/LICENSE",
        "licenses/llvm/LICENSE.TXT",
    ],
    qml_modules = [
        "QML",
        "QtQml",
    ],
)

consumer_archive(
    name = "ledger_release",
    app = ":ledger",
    arch = QT_CONSUMER_ARCH,
    min_runtime = QT_CONSUMER_MIN_RUNTIME,
    notice = "NOTICE",
    os = QT_CONSUMER_OS,
    resources = [":runtime"],
    runtime = QT_CONSUMER_RUNTIME,
)

real_source_target(
    name = "corpus_starlark",
    shell_srcs = ["ledger_symbols_test.sh"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
