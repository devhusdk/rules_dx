# gazelle:ignore

load("//libs/starlark:defs.bzl", "starlark_test")
load("//libs/starlark:tag_probe.bzl", "tag_subject")
load("//qt/rules:defs.bzl", "qt_cc_binary", "qt_cc_library", "qt_cc_test")
load("//quality:fixtures.bzl", "real_source_target")

_LINUX = select({
    "@platforms//cpu:arm64": ["@platforms//os:linux"],
    "@platforms//cpu:x86_64": ["@platforms//os:linux"],
    "//conditions:default": ["@platforms//:incompatible"],
})

qt_cc_library(
    name = "lib",
    srcs = ["main.cc"],
    moc_hdrs = ["probe.h"],
    tags = [
        "manual",
        "no-lint",
        "no-remote-exec",
    ],
    target_compatible_with = _LINUX,
)

qt_cc_binary(
    name = "bin",
    srcs = ["main.cc"],
    tags = [
        "manual",
        "no-lint",
        "no-remote-exec",
    ],
    target_compatible_with = _LINUX,
)

qt_cc_test(
    name = "unit",
    srcs = ["main.cc"],
    tags = [
        "manual",
        "no-lint",
        "no-remote-exec",
    ],
    target_compatible_with = _LINUX,
)

tag_subject(
    name = "tags_subject",
    testonly = True,
    target_compatible_with = _LINUX,
    targets = [
        ":bin",
        ":bin_upstream",
        ":lib",
        ":lib_qt",
        ":lib_qt_hdrs",
        ":lib_qt_srcs",
        ":lib_upstream",
        ":unit",
        ":unit_upstream",
    ],
)

starlark_test(
    name = "tags_test",
    expected_observations = """subject //qt/tests/tags:tags_subject
field bin=manual,no-lint,no-remote-exec
field bin_upstream=dx:no-lint,manual,no-remote-exec
field lib=manual,no-lint,no-remote-exec
field lib_qt=dx:no-lint,manual,no-remote-exec
field lib_qt_hdrs=dx:no-lint,manual,no-remote-exec
field lib_qt_srcs=dx:no-lint,manual,no-remote-exec
field lib_upstream=dx:no-lint,manual,no-remote-exec
field unit=manual,no-lint,no-remote-exec
field unit_upstream=dx:no-lint,manual,no-remote-exec
aspect_field aspect_seen=True
aspect_field field_count=9
aspect_field has_subject=True
aspect_field subject_label=//qt/tests/tags:tags_subject
aspect_field transitive_count=0
""",
    mode = "analysis",
    subjects = [":tags_subject"],
    target_compatible_with = _LINUX,
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
