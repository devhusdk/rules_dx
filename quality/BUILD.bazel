consumer_policy_tests(
    name = "consumer_policy",
    cases = [
        {
            "case": "toml_formatted",
            "expected_dx_results": [
                "clean_toml-real-format.pb",
                "clean_toml-real-lint.pb",
            ],
            "policy": "//quality/tests/fixtures/consumer_policy:format_taplo_policy",
            "subject": "//quality/tests/fixtures/consumer_policy:clean_toml",
        },
        {
            "case": "toml_format_off",
            "expected_dx_results": [
                "clean_toml-real-lint.pb",
            ],
            "policy": "//quality/tests/fixtures/consumer_policy:format_off_policy",
            "subject": "//quality/tests/fixtures/consumer_policy:clean_toml",
        },
        {
            "case": "json_prettier",
            "expected_dx_results": [
                "clean_json-real-format-js.pb",
                "clean_json-real-lint.pb",
            ],
            "policy": "//quality/tests/fixtures/consumer_policy:json_prettier_policy",
            "subject": "//quality/tests/fixtures/consumer_policy:clean_json",
        },
        {
            "case": "json_biome",
            "expected_dx_results": [
                "clean_json-real-format.pb",
                "clean_json-real-lint.pb",
            ],
            "policy": "//quality/tests/fixtures/consumer_policy:json_biome_policy",
            "subject": "//quality/tests/fixtures/consumer_policy:clean_json",
        },
        {
            "case": "js_eslint",
            "expected_dx_results": [
                "clean_js-real-lint-js.pb",
            ],
            "policy": "//quality/tests/fixtures/consumer_policy:js_eslint_policy",
            "subject": "//quality/tests/fixtures/consumer_policy:clean_js",
        },
    ],
)

