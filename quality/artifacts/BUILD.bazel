load("//python:defs.bzl", "python_binary", "python_library", "python_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//tools/visibility:visibility.bzl", "VIS_QUALITY")
load(":corpus_tests.bzl", "corpus_coverage_test")
load(":metadata_tests.bzl", "metadata_tests")
load(":platforms_tests.bzl", "platforms_tests")

package(default_visibility = VIS_QUALITY)

python_library(
    name = "update_lib",
    srcs = ["update.py"],
)

python_binary(
    name = "update",
    srcs = ["update.py"],
    main = "update.py",
)

python_test(
    name = "update_unit_test",
    srcs = ["update_test.py"],
    data = ["trivy.bzl"],
    dep_group = "hello",
    imports = ["."],
    deps = [
        ":update_lib",
        "@pypi//pytest",
    ],
)

exports_files(glob(
    ["*.bzl"],
    exclude = [
        "extension.bzl",
        "metadata_tests.bzl",
    ],
))

exports_files(
    ["update.py"],
    visibility = [
        "//quality:__pkg__",
        "//quality:__subpackages__",
        "//tools/ci:__pkg__",
    ],
)

metadata_tests(name = "metadata")

platforms_tests(name = "platforms")

corpus_coverage_test(
    name = "corpus_coverage",
    subject = ":corpus_starlark",
)

test_suite(
    name = "all",
    tests = [
        ":corpus_coverage",
        ":metadata",
        ":platforms",
        ":update_unit_test",
        "//quality/artifacts/acquire_test",
        "//quality/artifacts/hub_test:hub_selection_analysis",
        "//quality/artifacts/hub_test:hub_selection_unit",
        "//quality/artifacts/update_test",
    ],
)

real_source_target(
    name = "corpus_python",
    python_srcs = glob(["*.py"]),
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"] + glob(["*.bzl"]),
    tags = ["corpus"],
    visibility = VIS_QUALITY + ["//tools/ci:__pkg__"],
)

alias(
    name = "gitleaks",
    actual = "@dx_tools//:gitleaks",
    visibility = ["//visibility:public"],
)

alias(
    name = "trivy",
    actual = "@dx_tools//:trivy",
    visibility = ["//visibility:public"],
)
