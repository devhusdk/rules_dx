load("//python/rules:defs.bzl", "python_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//tools/visibility:visibility.bzl", "VIS_QUALITY")

package(default_visibility = VIS_QUALITY)

filegroup(
    name = "fixtures",
    srcs = glob(["fixtures/**"]),
)

filegroup(
    name = "fixture_module",
    srcs = ["workspace/MODULE.bazel.fixture"],
)

# keep
python_test(
    name = "acquire_test",
    size = "small",
    srcs = ["acquire_test.py"],
    aspect_hints = ["//:ruff_config"],
    data = [
        ":fixture_module",
        ":fixtures",
        "//quality/artifacts:acquire.bzl",
        "//quality/artifacts:extension.bzl",
    ],
    dep_group = "hello",
    deps = ["@pypi//pytest"],
