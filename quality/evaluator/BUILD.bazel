load("@crates//:crates.bzl", "aliases", "crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")
load("//tools/visibility:visibility.bzl", "VIS_QUALITY")

package(default_visibility = VIS_QUALITY)

rust_library(
    name = "quality_evaluator_lib",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "quality/quality_evaluator",
        normal = True,
    ),
    crate_name = "quality_evaluator",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = crate_deps(
        [
            "clap",
            "thiserror",
            "tracing",
        ],
        package_name = "quality/quality_evaluator",
    ) + ["//quality/result:quality_result"],
)

rust_binary(
    name = "quality_evaluator",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "quality/quality_evaluator",
        normal = True,
    ),
    crate_name = "quality_evaluator",
    crate_root = "src/main.rs",
    edition = "2021",
    deps = crate_deps(
        [
            "clap",
            "thiserror",
            "tracing",
        ],
        package_name = "quality/quality_evaluator",
    ) + [
        ":quality_evaluator_lib",
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/output:dx_output",
        "//quality/result:quality_result",
    ],
)

# keep
