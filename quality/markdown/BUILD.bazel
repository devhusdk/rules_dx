load("@crates//:crates.bzl", "aliases", "crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")
load("//tools/visibility:visibility.bzl", "VIS_QUALITY_ENV")

package(default_visibility = VIS_QUALITY_ENV)

rust_library(
    name = "quality_markdown_lib",
    srcs = [
        "src/check.rs",
        "src/frontmatter.rs",
        "src/lib.rs",
        "src/lib_tests.rs",
        "src/links.rs",
    ],
    aliases = aliases(
        package_name = "quality/quality_markdown",
        normal = True,
    ),
    crate_name = "quality_markdown",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = crate_deps(
        [
            "clap",
            "deunicode",
            "pulldown-cmark",
            "serde",
            "slug",
            "thiserror",
            "tracing",
        ],
        package_name = "quality/quality_markdown",
    ) + [
        "//cli/fingerprint:dx_fingerprint",
        "//cli/output:dx_output",
    ],
)

rust_binary(
    name = "quality_markdown",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "quality/quality_markdown",
        normal = True,
    ),
    crate_name = "quality_markdown",
    crate_root = "src/main.rs",
    edition = "2021",
    deps = crate_deps(
        [
            "clap",
            "deunicode",
            "pulldown-cmark",
            "serde",
            "slug",
            "thiserror",
            "tracing",
        ],
        package_name = "quality/quality_markdown",
    ) + [
        ":quality_markdown_lib",
        "//cli/output:dx_output",
    ],
)

rustfmt_test(
    name = "quality_markdown_fmt_test",
    size = "small",
    targets = [
        ":quality_markdown",
        ":quality_markdown_lib",
    ],
)

rust_clippy_test(
    name = "quality_markdown_clippy_test",
    size = "small",
    targets = [
        ":quality_markdown",
        ":quality_markdown_lib",
    ],
)

exports_files([
    "Cargo.toml",
    "src/lib.rs",
    "src/main.rs",
])

rust_test(
    name = "quality_markdown_test",
    aliases = aliases(
        package_name = "quality/quality_markdown",
        normal = True,
        normal_dev = True,
    ),
    crate = ":quality_markdown_lib",
    deps = crate_deps(
        [
            "clap",
            "deunicode",
            "pulldown-cmark",
            "serde",
            "serde_json",
            "slug",
            "thiserror",
            "tracing",
        ],
        package_name = "quality/quality_markdown",
    ),
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
