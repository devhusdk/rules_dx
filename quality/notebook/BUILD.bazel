load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_QUALITY_ENV")

package(default_visibility = VIS_QUALITY_ENV)

_LIB_SRCS = [
    "src/cli.rs",
    "src/entry.rs",
    "src/lib.rs",
    "src/outputs.rs",
]

rust_library(
    name = "quality_notebook_lib",
    srcs = [
        "src/cli.rs",
        "src/entry.rs",
        "src/lib.rs",
        "src/outputs.rs",
    ],
    aliases = aliases(
        package_name = "quality/quality_notebook",
        normal = True,
    ),
    crate_name = "quality_notebook",
    crate_root = "src/lib.rs",
    visibility = VIS_QUALITY_ENV + ["//cli/cli:__pkg__"],
    deps = all_crate_deps(
        package_name = "quality/quality_notebook",
        normal = True,
    ),
)

rust_binary(
    name = "quality_notebook",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "quality/quality_notebook",
        normal = True,
    ),
    crate_name = "quality_notebook",
    crate_root = "src/main.rs",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        package_name = "quality/quality_notebook",
        normal = True,
    ) + [":quality_notebook_lib"],
)

rust_test(
    name = "quality_notebook_test",
    aliases = aliases(
        package_name = "quality/quality_notebook",
        normal = True,
        normal_dev = True,
    ),
    crate = ":quality_notebook_lib",
    deps = all_crate_deps(
        package_name = "quality/quality_notebook",
        normal = True,
        normal_dev = True,
    ),
)

exports_files([
    "Cargo.toml",
    "src/lib.rs",
    "src/main.rs",
])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
