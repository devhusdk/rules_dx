load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")
load("//tools/visibility:visibility.bzl", "VIS_QUALITY_CLI")

package(default_visibility = VIS_QUALITY_CLI)

rust_library(
    name = "quality_result",
    srcs = [
        "src/build_deps.rs",
        "src/lib.rs",
    ],
    aliases = aliases(
        package_name = "quality/quality_result",
        normal = True,
    ),
    crate_name = "quality_result",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = all_crate_deps(
        package_name = "quality/quality_result",
        normal = True,
    ) + [
        "//cli/digest:dx_digest",
        "//cli/path:dx_path",
        "//quality:result_proto_rs",
        "@rules_rust_prost//private/3rdparty/crates:prost",
    ],
)

rust_test(
    name = "quality_result_test",
    aliases = aliases(
        package_name = "quality/quality_result",
        normal = True,
        normal_dev = True,
    ),
    crate = ":quality_result",
    deps = all_crate_deps(
        package_name = "quality/quality_result",
        normal = True,
        normal_dev = True,
    ) + ["@rules_rust_prost//private/3rdparty/crates:prost"],
)

rustfmt_test(
    name = "quality_result_fmt_test",
    targets = [
        ":print_result",
        ":quality_result",
    ],
)

rust_clippy_test(
    name = "quality_result_clippy_test",
    targets = [
        ":print_result",
        ":quality_result",
    ],
)

exports_files([
    "Cargo.toml",
    "src/build_deps.rs",
    "src/lib.rs",
    "src/print.rs",
])

rust_binary(
    name = "print_result",
    srcs = ["src/print.rs"],
    aliases = aliases(
        package_name = "quality/quality_result",
        normal = True,
    ),
    crate_name = "print_result",
    crate_root = "src/print.rs",
    edition = "2021",
    deps = all_crate_deps(
        package_name = "quality/quality_result",
        normal = True,
    ) + [
        ":quality_result",
        "//cli/output:dx_output",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
