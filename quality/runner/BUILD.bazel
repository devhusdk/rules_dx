rust_clippy_test(
    name = "quality_runner_clippy_test",
    size = "small",
    targets = [
        ":matrix_harness",
        ":quality_runner_lib",
        ":quality_runner",
    ],
)

exports_files([
    "Cargo.toml",
    "src/lib.rs",
    "src/main.rs",
    "src/matrix_harness.rs",
    "src/real/check.rs",
    "src/real/staging.rs",
