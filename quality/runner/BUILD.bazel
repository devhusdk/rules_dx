load("@crates//:crates.bzl", "aliases", "crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")
load("//tools/visibility:visibility.bzl", "VIS_QUALITY")

package(default_visibility = VIS_QUALITY)

rust_library(
    name = "quality_runner_lib",
    srcs = [
        "src/lib.rs",
        "src/lib_determinism.rs",
        "src/lib_gates.rs",
        "src/lib_pipeline.rs",
        "src/real.rs",
        "src/real/check.rs",
        "src/real/delegated.rs",
        "src/real/pipeline.rs",
        "src/real/staging.rs",
        "src/real_core.rs",
        "src/real_delegated.rs",
        "src/real_fix.rs",
        "src/real_fixtures.rs",
        "src/real_tools.rs",
        "src/request.rs",
    ],
    aliases = aliases(
        package_name = "quality/quality_runner",
        normal = True,
    ),
    crate_name = "quality_runner",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = crate_deps(
        [
            "clap",
            "serde",
            "serde_json",
            "tempfile",
            "thiserror",
            "tracing",
        ],
        package_name = "quality/quality_runner",
    ) + [
        "//cli/digest:dx_digest",
        "//cli/path:dx_path",
        "//quality/adapter:quality_adapter",
        "//quality/result:quality_result",
    ],
)

rust_binary(
    name = "quality_runner",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "quality/quality_runner",
        normal = True,
    ),
    crate_name = "quality_runner",
    crate_root = "src/main.rs",
    edition = "2021",
    deps = crate_deps(
        [
            "clap",
            "serde",
            "serde_json",
            "tempfile",
            "thiserror",
            "tracing",
        ],
        package_name = "quality/quality_runner",
    ) + [
        ":quality_runner_lib",
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/output:dx_output",
        "//quality/result:quality_result",
    ],
)

# keep
rust_binary(
