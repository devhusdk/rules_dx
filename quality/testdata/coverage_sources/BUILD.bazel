load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//haskell/rules:defs.bzl", "HASKELL_COMPATIBLE_WITH", "haskell_test")
load("//perl/rules:defs.bzl", "perl_test")
load("//powershell/rules:defs.bzl", "pwsh_test")
load("//quality:coverage_sources_tests.bzl", "coverage_fixture")
load("//zig/rules:defs.bzl", "zig_library", "zig_test")

package(default_visibility = ["//quality:__subpackages__"])

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

rust_library(
    name = "split_lib",
    srcs = [
        "lib.rs",
        "split.rs",
    ],
    crate_root = "lib.rs",
    tags = ["manual"],
)

rust_test(
    name = "split_lib_test",
    crate = ":split_lib",
    tags = ["manual"],
)

cc_library(
    name = "header_lib",
    srcs = ["header.cc"],
    hdrs = ["header.h"],
    tags = ["manual"],
)

cc_library(
    name = "helper_lib",
    testonly = True,
    srcs = ["helper.cc"],
    tags = ["manual"],
)

genrule(
    name = "gen",
    outs = ["gen.cc"],
    cmd = "echo 'int gen_value(void) { return 5; }' > $@",
    tags = ["manual"],
)

coverage_fixture(
    name = "generated_lib",
    srcs = [":gen"],
    tags = ["manual"],
)

coverage_fixture(
    name = "arm_only_lib",
    srcs = ["common.cc"] + select({
        "@platforms//cpu:arm64": ["arm.cc"],
        "//conditions:default": [],
    }),
    tags = ["manual"],
)

perl_test(
    name = "perl_probe_test",
    srcs = ["perl_probe.t"],
    tags = ["manual"],
)

zig_library(
    name = "calc_lib",
    import_name = "calc",
    main = "calc.zig",
    tags = ["manual"],
)

zig_test(
    name = "calc_test",
    main = "calc_test.zig",
    tags = ["manual"],
    deps = [":calc_lib"],
)

haskell_test(
    name = "haskell_probe_test",
    srcs = ["haskell_probe.hs"],
    tags = ["manual"],
    target_compatible_with = HASKELL_COMPATIBLE_WITH,
    deps = ["@dx_haskell_toolchains//:base"],
)

pwsh_test(
    name = "pwsh_probe_test",
    srcs = ["pwsh_probe.ps1"],
    tags = ["manual"],
)
