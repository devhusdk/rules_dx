load("//elixir:defs.bzl", "ELIXIR_COMPATIBLE_WITH", "elixir_app")
load("//erlang:defs.bzl", "ERLANG_COMPATIBLE_WITH", "erlang_app")
load("//quality:policy.bzl", "quality_family", "workspace_policy")

package(default_visibility = ["//quality/testdata:__pkg__"])

quality_family(
    name = "erlang_family",
    disabled = [
        "audit",
        "format",
        "lint",
    ],
    family_id = "erlang",
    typecheck = ["dialyzer"],
)

workspace_policy(
    name = "erlang_policy",
    families = [":erlang_family"],
)

quality_family(
    name = "elixir_family",
    disabled = [
        "audit",
        "format",
        "lint",
    ],
    family_id = "elixir",
    typecheck = ["dialyzer"],
)

workspace_policy(
    name = "elixir_policy",
    families = [":elixir_family"],
)

erlang_app(
    name = "erlang_dirty",
    app_name = "dx_dialyzer_dirty",
    app_version = "1.0.0",
    target_compatible_with = ERLANG_COMPATIBLE_WITH,
)

elixir_app(
    name = "elixir_dirty",
    app_name = "dx_elixir_dirty",
    app_version = "1.0.0",
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
)
