load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("//typescript/rules:defs.bzl", "typescript_project")

copy_file(
    name = "standard_base",
    src = "//cli/adopt/templates/config:tsconfig/standard.json",
    out = ".dx/config/tsconfig/standard.json",
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = [":standard_base"],
)

typescript_project(
    name = "dep",
    srcs = ["dep.ts"],
    declaration = True,
    isolated_typecheck = False,
    transpiler = "tsc",
    tsconfig = ":tsconfig",
    visibility = ["//quality/testdata:__subpackages__"],
)
