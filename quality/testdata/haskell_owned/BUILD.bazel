load("//haskell/rules:defs.bzl", "HASKELL_COMPATIBLE_WITH", "haskell_library")
load("//quality:policy.bzl", "quality_family", "workspace_policy")

package(default_visibility = ["//quality:__pkg__", "//quality/testdata:__pkg__"])

quality_family(
    name = "haskell_family",
    disabled = [
        "audit",
        "format",
        "lint",
    ],
    family_id = "haskell",
    typecheck = ["ghc"],
)

workspace_policy(
    name = "policy",
    families = [":haskell_family"],
)

quality_family(
    name = "hlint_family",
    disabled = [
        "audit",
        "format",
        "typecheck",
    ],
    family_id = "haskell",
    lint = ["hlint"],
)

workspace_policy(
    name = "hlint_policy",
    families = [":hlint_family"],
)

haskell_library(
    name = "clean",
    srcs = ["Clean.hs"],
    ghcopts = ["-Wall"],
    target_compatible_with = HASKELL_COMPATIBLE_WITH,
    deps = ["@dx_haskell_toolchains//:base"],
)

haskell_library(
    name = "dirty",
    srcs = ["Dirty.hs"],
    ghcopts = ["-Wall"],
    target_compatible_with = HASKELL_COMPATIBLE_WITH,
    deps = ["@dx_haskell_toolchains//:base"],
)

haskell_library(
    name = "redundant",
    srcs = ["Redundant.hs"],
    target_compatible_with = HASKELL_COMPATIBLE_WITH,
    deps = ["@dx_haskell_toolchains//:base"],
)

quality_family(
    name = "weeder_family",
    disabled = [
        "audit",
        "format",
        "typecheck",
    ],
    family_id = "haskell",
    lint = ["weeder"],
)

workspace_policy(
    name = "weeder_policy",
    families = [":weeder_family"],
)

haskell_library(
    name = "weeds",
    srcs = ["Weeds.hs"],
    target_compatible_with = HASKELL_COMPATIBLE_WITH,
    deps = ["@dx_haskell_toolchains//:base"],
)
