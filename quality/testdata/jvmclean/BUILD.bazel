load("//java:defs.bzl", "java_library")
load("//kotlin:defs.bzl", "kotlin_library")
load("//quality:policy.bzl", "quality_family", "workspace_policy")

package(default_visibility = ["//quality/testdata:__pkg__"])

java_library(
    name = "java_clean",
    srcs = ["Clean.java"],
)

kotlin_library(
    name = "kotlin_clean",
    srcs = ["Clean.kt"],
)

quality_family(
    name = "java_pmd_family",
    disabled = [
        "audit",
        "format",
        "typecheck",
    ],
    family_id = "java",
    lint = ["pmd"],
)

quality_family(
    name = "kotlin_detekt_family",
    disabled = [
        "audit",
        "format",
        "typecheck",
    ],
    family_id = "kotlin",
    lint = ["detekt"],
)

workspace_policy(
    name = "pmd_standard_policy",
    configs = ["//quality/tiers/pmd:standard"],
    families = [":java_pmd_family"],
)

workspace_policy(
    name = "pmd_strict_policy",
    configs = ["//quality/tiers/pmd:strict"],
    families = [":java_pmd_family"],
)

workspace_policy(
    name = "detekt_standard_policy",
    configs = ["//quality/tiers/detekt:standard"],
    families = [":kotlin_detekt_family"],
)

workspace_policy(
    name = "detekt_strict_policy",
    configs = ["//quality/tiers/detekt:strict"],
    families = [":kotlin_detekt_family"],
)
