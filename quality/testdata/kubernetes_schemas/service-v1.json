{
  "$schema": "http://json-schema.org/schema#",
  "properties": {
    "apiVersion": {
      "enum": [
        "v1"
      ],
      "type": "string"
    },
    "kind": {
      "enum": [
        "Service"
      ],
      "type": "string"
    },
    "metadata": {
      "properties": {
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "spec": {
      "properties": {
        "ports": {
          "items": {
            "properties": {
              "port": {
                "type": "integer"
              },
              "protocol": {
                "type": "string"
              },
              "targetPort": {
                "type": [
                  "integer",
                  "string"
                ]
              }
            },
            "required": [
              "port"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "selector": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "type": {
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata"
  ],
  "type": "object"
}
