load("@rules_dx_cuda//rules:defs.bzl", "cuda_library")
load("//quality:policy.bzl", "quality_family", "workspace_policy")

package(default_visibility = ["//quality/testdata:__pkg__"])

quality_family(
    name = "cuda_family",
    disabled = [
        "audit",
        "format",
        "lint",
    ],
    family_id = "cuda",
    typecheck = ["nvcc_syntax"],
)

workspace_policy(
    name = "policy",
    families = [":cuda_family"],
)

cuda_library(
    name = "dep",
    srcs = [],
    hdrs = [
        "dep.cuh",
        "host_only.cuh",
    ],
    cuda_archs = ["sm_89"],
    includes = ["."],
)

cuda_library(
    name = "clean",
    srcs = ["clean.cu"],
    cuda_archs = ["sm_89"],
    copts = ["-DCLEAN_OFFSET=1"],
    deps = [":dep"],
)

cuda_library(
    name = "two_archs",
    srcs = ["two_archs.cu"],
    cuda_archs = [
        "sm_80",
        "sm_89",
    ],
    copts = ["-DCLEAN_OFFSET=1"],
    tags = ["manual"],
    deps = [":dep"],
)

cuda_library(
    name = "dirty",
    srcs = ["dirty.cu"],
    cuda_archs = ["sm_89"],
    tags = ["manual"],
    deps = [":dep"],
)
