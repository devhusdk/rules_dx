load("@rules_rust//rust:defs.bzl", "rust_library")
load("//quality:policy.bzl", "quality_family", "workspace_policy")

package(default_visibility = ["//quality/testdata:__pkg__"])

quality_family(
    name = "rust_family",
    disabled = [
        "audit",
        "format",
    ],
    family_id = "rust",
    lint = ["clippy"],
    typecheck = ["rustc"],
)

workspace_policy(
    name = "policy",
    families = [":rust_family"],
)

rust_library(
    name = "clean",
    srcs = ["clean.rs"],
    edition = "2021",
)

rust_library(
    name = "dirty",
    srcs = ["dirty.rs"],
    edition = "2021",
)

rust_library(
    name = "pedantic",
    srcs = ["pedantic.rs"],
    edition = "2021",
)

rust_library(
    name = "unused_dep",
    srcs = ["unused_dep.rs"],
    edition = "2021",
    deps = [":clean"],
)
