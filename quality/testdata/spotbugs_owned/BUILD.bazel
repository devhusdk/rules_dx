load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//java/rules:defs.bzl", "java_library")
load("//quality:native_config.bzl", "checkstyle_config")
load(":results.bzl", "spotbugs_results")

checkstyle_config(
    name = "checkstyle_cfg",
    src = "checkstyle.xml",
)

java_library(
    name = "dep",
    srcs = ["Dirty.java"],
    aspect_hints = [":checkstyle_cfg"],
    tags = ["manual"],
)

java_library(
    name = "app",
    srcs = ["Clean.java"],
    aspect_hints = [":checkstyle_cfg"],
    tags = ["manual"],
    deps = [":dep"],
)

spotbugs_results(
    name = "app_results",
    target = ":app",
)

spotbugs_results(
    name = "dep_results",
    target = ":dep",
)

sh_test(
    name = "spotbugs_owned_test",
    srcs = ["check.sh"],
    data = [
        ":app_results",
        ":dep_results",
    ],
)
