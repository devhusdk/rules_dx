load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//java/rules:defs.bzl", "java_library", "java_test")
load(":results.bzl", "spotbugs_results")

java_library(
    name = "dep",
    srcs = ["Dirty.java"],
    tags = ["manual"],
)

java_library(
    name = "app",
    srcs = ["Clean.java"],
    tags = ["manual"],
    deps = [":dep"],
)

java_library(
    name = "api",
    srcs = ["Api.java"],
    neverlink = True,
    tags = ["manual"],
)

java_library(
    name = "uses_api",
    srcs = ["UsesApi.java"],
    tags = ["manual"],
    deps = [":api"],
)

java_library(
    name = "collide",
    srcs = ["Collide.java"],
    tags = ["manual"],
    deps = [
        "//quality/testdata/spotbugs_owned/a:lib",
        "//quality/testdata/spotbugs_owned/b:lib",
    ],
)

java_test(
    name = "app_test",
    srcs = ["CleanTest.java"],
    tags = ["manual"],
    test_class = "spotbugs_owned.CleanTest",
    deps = [
        ":app",
        "@maven//:junit_junit",
    ],
)

java_test(
    name = "implicit_test",
    srcs = ["ImplicitTest.java"],
    tags = ["manual"],
    test_class = "spotbugs_owned.ImplicitTest",
    deps = [":app"],
)

spotbugs_results(
    name = "implicit_test_results",
    target = ":implicit_test",
)

spotbugs_results(
    name = "uses_api_results",
    target = ":uses_api",
)

spotbugs_results(
    name = "collide_results",
    target = ":collide",
)

spotbugs_results(
    name = "app_test_results",
    target = ":app_test",
)

spotbugs_results(
    name = "app_results",
    target = ":app",
)

spotbugs_results(
    name = "dep_results",
    target = ":dep",
)

config_setting(
    name = "coverage",
    values = {"collect_code_coverage": "true"},
)

sh_test(
    name = "spotbugs_owned_test",
    srcs = ["check.sh"],
    data = [
        ":app_results",
        ":app_test_results",
        ":collide_results",
        ":dep_results",
        ":implicit_test_results",
        ":uses_api_results",
    ],
    target_compatible_with = select({
        ":coverage": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

sh_test(
    name = "spotbugs_native_test",
    srcs = ["native.sh"],
    args = ["$(rootpaths @bazel_tools//tools/jdk:JacocoCoverage)"],
    data = [
        ":app",
        ":dep",
        "//quality/tools/jvm:spotbugs",
        "@bazel_tools//tools/jdk:JacocoCoverage",
    ],
    tags = ["no-coverage"],
)
