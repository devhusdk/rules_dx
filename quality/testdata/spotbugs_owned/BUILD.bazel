load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//java/rules:defs.bzl", "java_library", "java_test")
load("//quality:native_config.bzl", "checkstyle_config")
load(":results.bzl", "spotbugs_results")

checkstyle_config(
    name = "checkstyle_cfg",
    src = "checkstyle.xml",
)

java_library(
    name = "dep",
    srcs = ["Dirty.java"],
    aspect_hints = [":checkstyle_cfg"],
    tags = ["manual"],
)

java_library(
    name = "app",
    srcs = ["Clean.java"],
    aspect_hints = [":checkstyle_cfg"],
    tags = ["manual"],
    deps = [":dep"],
)

java_test(
    name = "app_test",
    srcs = ["CleanTest.java"],
    aspect_hints = [":checkstyle_cfg"],
    tags = ["manual"],
    test_class = "spotbugs_owned.CleanTest",
    deps = [
        ":app",
        "@maven//:junit_junit",
    ],
)

spotbugs_results(
    name = "app_test_results",
    target = ":app_test",
)

spotbugs_results(
    name = "app_results",
    target = ":app",
)

spotbugs_results(
    name = "dep_results",
    target = ":dep",
)

sh_test(
    name = "spotbugs_owned_test",
    srcs = ["check.sh"],
    data = [
        ":app_results",
        ":app_test_results",
        ":dep_results",
    ],
)

sh_test(
    name = "spotbugs_native_test",
    srcs = ["native.sh"],
    data = [
        ":app",
        ":dep",
        "//quality/tools/jvm:spotbugs",
    ],
)
