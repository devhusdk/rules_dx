load("//quality:policy.bzl", "quality_family", "workspace_policy")
load("//swift/rules:defs.bzl", "swift_library")

package(default_visibility = ["//quality/testdata:__pkg__"])

swift_library(
    name = "unused",
    testonly = True,
    srcs = ["unused.swift"],
    module_name = "Unused",
    target_compatible_with = ["@platforms//os:macos"],
)

quality_family(
    name = "swift_family",
    disabled = [
        "audit",
        "format",
        "typecheck",
    ],
    family_id = "swift",
    lint = ["periphery"],
)

workspace_policy(
    name = "policy",
    families = [":swift_family"],
)
