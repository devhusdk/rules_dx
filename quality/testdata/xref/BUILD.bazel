load("//elixir/rules:defs.bzl", "ELIXIR_COMPATIBLE_WITH", "elixir_app")
load("//erlang/rules:defs.bzl", "ERLANG_COMPATIBLE_WITH", "erlang_app")
load("//quality:policy.bzl", "quality_family", "workspace_policy")

package(default_visibility = ["//quality/testdata:__pkg__"])

quality_family(
    name = "erlang_family",
    disabled = [
        "audit",
        "format",
        "typecheck",
    ],
    family_id = "erlang",
    lint = ["xref"],
)

workspace_policy(
    name = "erlang_policy",
    families = [":erlang_family"],
)

quality_family(
    name = "elixir_family",
    disabled = [
        "audit",
        "format",
        "typecheck",
    ],
    family_id = "elixir",
    lint = ["xref"],
)

workspace_policy(
    name = "elixir_policy",
    families = [":elixir_family"],
)

erlang_app(
    name = "erlang_unused",
    app_name = "dx_xref_erlang",
    app_version = "1.0.0",
    target_compatible_with = ERLANG_COMPATIBLE_WITH,
)

elixir_app(
    name = "elixir_unused",
    app_name = "dx_xref_elixir",
    app_version = "1.0.0",
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
)
