load("//ocaml:defs.bzl", "ocaml_module")
load("//quality:policy.bzl", "quality_family", "workspace_policy")

package(default_visibility = ["//quality/testdata:__pkg__"])

quality_family(
    name = "ocaml_family",
    disabled = [
        "audit",
        "format",
        "typecheck",
    ],
    family_id = "ocaml",
    lint = ["zanuda"],
)

workspace_policy(
    name = "policy",
    families = [":ocaml_family"],
)

ocaml_module(
    name = "clean",
    struct = "clean.ml",
)

ocaml_module(
    name = "dirty",
    struct = "dirty.ml",
)
