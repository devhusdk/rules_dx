load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//ocaml/rules:defs.bzl", "ocaml_module")
load("//quality:policy.bzl", "quality_family", "workspace_policy")
load(":results.bzl", "zanuda_results")

quality_family(
    name = "ocaml_family",
    disabled = [
        "audit",
        "format",
        "typecheck",
    ],
    family_id = "ocaml",
    lint = ["zanuda"],
)

workspace_policy(
    name = "policy",
    families = [":ocaml_family"],
)

ocaml_module(
    name = "clean",
    struct = "clean.ml",
)

ocaml_module(
    name = "dirty",
    struct = "dirty.ml",
)

zanuda_results(
    name = "clean_results",
    target = ":clean",
)

zanuda_results(
    name = "dirty_results",
    target = ":dirty",
)

sh_test(
    name = "zanuda_owned_test",
    srcs = ["check.sh"],
    data = [
        ":clean_results",
        ":dirty_results",
    ],
)
