[
    rust_test(
        name = "check_continuation_%s_consumer_test" % case,
        size = "enormous",
        srcs = [
            "check_continuation_common.rs",
            "check_continuation_%s_consumer_test.rs" % case,
        ],
        data = [
            "//:MODULE.bazel",
            "//cli/cli:dx",
        ] + NESTED_BAZEL_DATA,
        env = {
            "DX_BIN": "$(rootpath //cli/cli:dx)",
            "RUST_TEST_THREADS": "1",
        } | NESTED_BAZEL_NETWORK_ENV,
        env_inherit = [
            "HOME",
            "PATH",
        ],
        tags = NESTED_BAZEL_NETWORK_TAGS,
        target_compatible_with = _LINUX_X86_64,
        deps = [
            "//cli/test_scratch:dx_test_scratch",
            "//tools/testing:dx_nested",
            "//tools/testing:dx_testing",
        ],
    )
    for case in _CHECK_CONTINUATION_CASES
]

rustfmt_test(
    name = "check_continuation_consumer_fmt_test",
    targets = [":check_continuation_%s_consumer_test" % case for case in _CHECK_CONTINUATION_CASES],
)

rust_clippy_test(
    name = "check_continuation_consumer_clippy_test",
    targets = [":check_continuation_%s_consumer_test" % case for case in _CHECK_CONTINUATION_CASES],
)

