load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_test")
load("//tools/testing:nested_bazel.bzl", "NESTED_BAZEL_DATA", "NESTED_BAZEL_NETWORK_ENV", "NESTED_BAZEL_NETWORK_TAGS")

_LINUX = select({
    "@platforms//cpu:arm64": ["@platforms//os:linux"],
    "@platforms//cpu:x86_64": ["@platforms//os:linux"],
    "//conditions:default": ["@platforms//:incompatible"],
})

_LINUX_X86_64 = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

rust_test(
    name = "qt_adapter_test",
    srcs = ["qt_adapter_test.rs"],
    data = [
        "//quality/tests/fixtures/qmlformat:Sample.qml",
        "//quality/tests/fixtures/qmllint:Sample.qml",
        "//quality/tests/fixtures/qmllint:check_dirty.json",
        "@dx_qt//:qmlformat",
        "@dx_qt//:qmllint",
    ],
    env = {
        "DX_QMLFORMAT": "$(rootpath @dx_qt//:qmlformat)",
        "DX_QMLFORMAT_FIXTURE": "$(rootpath //quality/tests/fixtures/qmlformat:Sample.qml)",
        "DX_QMLLINT": "$(rootpath @dx_qt//:qmllint)",
        "DX_QMLLINT_FIXTURE": "$(rootpath //quality/tests/fixtures/qmllint:Sample.qml)",
        "DX_QMLLINT_FIXTURE_DIRTY": "$(rootpath //quality/tests/fixtures/qmllint:check_dirty.json)",
    },
    tags = ["block-network"],
    target_compatible_with = _LINUX,
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//quality/adapter:quality_adapter",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "column_units_test",
    srcs = ["column_units_test.rs"],
    data = [
        "//quality/tools/javascript/bin:eslint",
        "//quality/tools/jvm:checkstyle",
        "//quality/tools/jvm:pmd",
    ],
    env = {
        "DX_CHECKSTYLE": "$(rootpath //quality/tools/jvm:checkstyle)",
        "DX_ESLINT": "$(rootpath //quality/tools/javascript/bin:eslint)",
        "DX_PMD": "$(rootpath //quality/tools/jvm:pmd)",
    },
    tags = ["block-network"],
    target_compatible_with = _LINUX_X86_64,
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//quality/adapter:quality_adapter",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "quality_check_smoke_test",
    size = "large",
    timeout = "moderate",
    srcs = [
        "quality_check_smoke_common.rs",
        "quality_check_smoke_test.rs",
    ],
    data = [
        "//:MODULE.bazel",
        "//cli/cli:dx",
    ] + NESTED_BAZEL_DATA,
    env = {
        "DX_BIN": "$(rootpath //cli/cli:dx)",
        "RUST_TEST_THREADS": "1",
    } | NESTED_BAZEL_NETWORK_ENV,
    env_inherit = [
        "HOME",
        "PATH",
    ],
    tags = NESTED_BAZEL_NETWORK_TAGS,
    target_compatible_with = _LINUX_X86_64,
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing:dx_testing",
        "//tools/testing/nested:dx_nested",
    ],
)

rust_test(
    name = "consumer_maven_guard_test",
    srcs = ["consumer_maven_guard_test.rs"],
    data = glob(
        ["*_consumer_test.rs"],
        allow_empty = True,
    ) + [
        "//svelte/tests/consumer:app_consumer_test.rs",
    ],
    env = {"DX_GUARD_FILES": " ".join([
        "$(rlocationpath {})".format(f)
        for f in glob(
            ["*_consumer_test.rs"],
            allow_empty = True,
        ) + [
            "//svelte/tests/consumer:app_consumer_test.rs",
        ]
    ])},
    deps = ["//tools/testing:dx_testing"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

rust_test(
    name = "powershell_gallery_lock_test",
    srcs = ["powershell_gallery_lock_test.rs"],
    data = [
        "//:MODULE.bazel",
        "//third_party/powershell:PSGallery.lock.json",
        "//third_party/powershell:PSGallery.requirements.psd1",
    ],
    env = {
        "DX_GALLERY_REQUIREMENTS": "$(rootpath //third_party/powershell:PSGallery.requirements.psd1)",
        "DX_GALLERY_LOCK": "$(rootpath //third_party/powershell:PSGallery.lock.json)",
        "DX_MODULE_BAZEL": "$(rootpath //:MODULE.bazel)",
    },
    deps = ["//tools/testing:dx_testing"],
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//tools/docs/support_matrix:__pkg__"],
)
