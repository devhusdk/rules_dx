load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")
load("//tools/testing:nested_bazel.bzl", "CONSUMER_MAVEN_DATA", "CONSUMER_MAVEN_ENV", "NESTED_BAZEL_CI_NETWORK_TAGS", "NESTED_BAZEL_DATA", "NESTED_BAZEL_NETWORK_ENV", "NESTED_BAZEL_NETWORK_TAGS")

_LINUX = select({
    "@platforms//cpu:arm64": ["@platforms//os:linux"],
    "@platforms//cpu:x86_64": ["@platforms//os:linux"],
    "//conditions:default": ["@platforms//:incompatible"],
})

_LINUX_X86_64 = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

_CHECK_CONTINUATION_CASES = [
    "clean",
    "findings",
    "generation",
    "later_clean",
    "rejected",
    "views",
]

# keep
rust_test(
    name = "qt_adapter_test",
    size = "small",
    srcs = ["qt_adapter_test.rs"],
    data = [
        "//quality/tests/fixtures/qmlformat:Sample.qml",
        "//quality/tests/fixtures/qmllint:Sample.qml",
        "//quality/tests/fixtures/qmllint:check_dirty.json",
        "@dx_qt//:qmlformat",
        "@dx_qt//:qmllint",
    ],
    env = {
        "DX_QMLFORMAT": "$(rootpath @dx_qt//:qmlformat)",
        "DX_QMLFORMAT_FIXTURE": "$(rootpath //quality/tests/fixtures/qmlformat:Sample.qml)",
        "DX_QMLLINT": "$(rootpath @dx_qt//:qmllint)",
        "DX_QMLLINT_FIXTURE": "$(rootpath //quality/tests/fixtures/qmllint:Sample.qml)",
        "DX_QMLLINT_FIXTURE_DIRTY": "$(rootpath //quality/tests/fixtures/qmllint:check_dirty.json)",
    },
    tags = ["block-network"],
    target_compatible_with = _LINUX,
    deps = [
        "//quality/adapter:quality_adapter",
        "//tools/testing:dx_testing",
    ],
)

rustfmt_test(
    name = "qt_adapter_fmt_test",
    targets = [":qt_adapter_test"],
)

rust_clippy_test(
    name = "qt_adapter_clippy_test",
    targets = [":qt_adapter_test"],
)

