load("//cc/rules:defs.bzl", "cc_library")
load("//quality:fixtures.bzl", "real_source_target")
load("//quality:native_config.bzl", "clang_tidy_config", "eslint_config")
load("//quality:policy.bzl", "quality_family", "workspace_policy")
load(":cc_policy_tests.bzl", "cc_policy_failure_tests")

package(default_visibility = ["//quality:__pkg__"])

exports_files([
    "clean.js",
    "clean.json",
    "clean.toml",
])

quality_family(
    name = "formatted_toml_family",
    disabled = ["typecheck"],
    family_id = "toml",
    format = ["taplo"],
    lint = ["taplo"],
)

workspace_policy(
    name = "format_taplo_policy",
    families = [":formatted_toml_family"],
)

quality_family(
    name = "unformatted_toml_family",
    disabled = [
        "format",
        "typecheck",
    ],
    family_id = "toml",
    lint = ["taplo"],
)

workspace_policy(
    name = "format_off_policy",
    families = [":unformatted_toml_family"],
)

quality_family(
    name = "unconfigured_toml_family",
    family_id = "toml",
    lint = ["taplo"],
)

workspace_policy(
    name = "unconfigured_format_policy",
    families = [":unconfigured_toml_family"],
)

quality_family(
    name = "unwired_toml_family",
    disabled = ["typecheck"],
    family_id = "toml",
    format = ["yamlfmt"],
    lint = ["taplo"],
)

workspace_policy(
    name = "unwired_tool_policy",
    families = [":unwired_toml_family"],
)

quality_family(
    name = "prettier_json_family",
    disabled = ["typecheck"],
    family_id = "json",
    format = ["prettier"],
    lint = ["biome"],
)

workspace_policy(
    name = "json_prettier_policy",
    families = [":prettier_json_family"],
)

quality_family(
    name = "biome_json_family",
    disabled = ["typecheck"],
    family_id = "json",
    format = ["biome"],
    lint = ["biome"],
)

workspace_policy(
    name = "json_biome_policy",
    families = [":biome_json_family"],
)

quality_family(
    name = "eslint_js_family",
    disabled = [
        "format",
        "typecheck",
    ],
    family_id = "javascript",
    lint = ["eslint"],
)

workspace_policy(
    name = "js_eslint_policy",
    families = [":eslint_js_family"],
)

eslint_config(
    name = "consumer_eslint_config",
    src = "eslint.config.js",
)

quality_family(
    name = "cc_declared_family",
    disabled = ["typecheck"],
    family_id = "cc",
    format = ["clang_format"],
    lint = ["clang_tidy"],
)

workspace_policy(
    name = "cc_declared_policy",
    families = [":cc_declared_family"],
)

clang_tidy_config(
    name = "consumer_clang_tidy_config",
    src = ".clang-tidy",
)

cc_library(
    name = "clean_cc",
    srcs = ["clean_cc.cc"],
    aspect_hints = [":consumer_clang_tidy_config"],
    tags = ["corpus"],
)

cc_library(
    name = "unhinted_cc",
    srcs = ["clean_cc.cc"],
    tags = [
        "corpus",
        "manual",
    ],
)

cc_policy_failure_tests(
    name = "cc_policy",
    cases = [
        {
            "case": "tidy_requires_config",
            "expected_failure": "applicable ClangTidy requires declared config",
            "subject": ":unhinted_cc",
        },
    ],
)

real_source_target(
    name = "clean_js",
    aspect_hints = [
        ":consumer_eslint_config",
        "//:biome_config",
    ],
    javascript_srcs = ["clean.js"],
    tags = ["corpus"],
)

real_source_target(
    name = "clean_json",
    aspect_hints = ["//:biome_config"],
    json_srcs = ["clean.json"],
    tags = ["corpus"],
)

real_source_target(
    name = "clean_toml",
    tags = ["corpus"],
    toml_srcs = ["clean.toml"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
