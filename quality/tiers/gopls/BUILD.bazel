load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@crates//:crates.bzl", "aliases")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary")

exports_files(
    [
        "gopls_standard.json",
        "gopls_strict.json",
    ],
    visibility = ["//cli/adopt:__pkg__"],
)

rust_binary(
    name = "gen",
    srcs = ["gen.rs"],
    aliases = aliases(
        package_name = "quality/tiers/gopls_gen",
        normal = True,
    ),
    crate_name = "gen",
    crate_root = "gen.rs",
    deps = [],
)

[
    genrule(
        name = "gen_" + tier,
        srcs = [
            "//quality/tiers/govet:standard.json",
            "//quality/tiers/govet:strict.json",
            "//quality/tiers/staticcheck:standard.conf",
            "//quality/tiers/staticcheck:strict.conf",
        ],
        outs = ["gen_%s.json" % tier],
        cmd = "$(execpath :gen) $(execpath //quality/tiers/govet:%s.json) $(execpath //quality/tiers/staticcheck:%s.conf) $(execpath //quality/tiers/govet:strict.json) $(execpath //quality/tiers/staticcheck:strict.conf) > $@" % (tier, tier),
        tools = [":gen"],
    )
    for tier in [
        "standard",
        "strict",
    ]
]

[
    diff_test(
        name = "gopls_%s_current_test" % tier,
        failure_message = "gopls_%s.json is stale: run bazel build //quality/tiers/gopls:gen_%s and copy bazel-bin/quality/tiers/gopls/gen_%s.json over it" % (tier, tier, tier),
        file1 = "gopls_%s.json" % tier,
        file2 = ":gen_%s" % tier,
    )
    for tier in [
        "standard",
        "strict",
    ]
]

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
