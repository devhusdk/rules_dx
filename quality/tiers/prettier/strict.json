{
  "overrides": [
    {
      "files": "*.{xml,xsd,xsl,xslt,wsdl}",
      "options": {
        "xmlWhitespaceSensitivity": "strict",
        "xmlQuoteAttributes": "preserve",
        "xmlSortAttributesByKey": false
      }
    },
    {
      "files": "*.feature",
      "options": {
        "escapeBackslashes": false,
        "forceNewlineBetweenStepBlocks": false
      }
    }
  ]
}
