load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//quality:native_config.bzl", "ruff_config")

exports_files(
    glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

ruff_config(
    name = "standard",
    src = "standard.toml",
    visibility = ["//visibility:public"],
)

ruff_config(
    name = "strict",
    src = "strict.toml",
    visibility = ["//visibility:public"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = [
        "standard.toml",
        "strict.toml",
    ],
)
