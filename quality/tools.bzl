"""One row per quality tool: adapters, config suffixes and support records.

support.bzl, adapters.bzl and native_config.bzl derive their tables from TOOLS,
and //quality:update_tools writes the Rust tool list from it.
"""

def row(**fields):
    """Returns one support record; the tool id is added by tool()."""
    return fields

def tool(id, adapters, support = [], config_suffix = None):
    """Returns one tool: its adapter classes per capability and its support records."""
    return struct(
        adapters = adapters,
        config_suffix = config_suffix,
        id = id,
        support = [dict(record, tool = id) for record in support],
    )

