load("@rules_java//java:defs.bzl", "java_binary", "java_import")
load("//quality:fixtures.bzl", "real_source_target")
load("//quality/tools/jvm:jar_lsp_tool.bzl", "jar_lsp_tool")
load("//quality/tools/jvm:java_runtime_pin.bzl", "pinned_java_runtime")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_test", "rustfmt_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS_PUBLIC)

exports_files([
    "pmd_default.xml",
    "scalafmt_default.conf",
])

java_import(
    name = "google_java_format_import",
    jars = ["@jvm_google_java_format//file"],
)

java_binary(
    name = "google_java_format",
    jvm_flags = [
        "--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED",
        "--add-exports=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED",
        "--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED",
        "--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED",
        "--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED",
        "--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED",
    ],
    main_class = "com.google.googlejavaformat.java.Main",
    runtime_deps = [":google_java_format_import"],
)

java_import(
    name = "avro_tools_import",
    jars = ["@jvm_avro_tools//file"],
)

java_binary(
    name = "avro_tools",
    main_class = "org.apache.avro.tool.Main",
    runtime_deps = [":avro_tools_import"],
)

java_import(
    name = "checkstyle_import",
    jars = ["@jvm_checkstyle//file"],
)

java_binary(
    name = "checkstyle",
    main_class = "com.puppycrawl.tools.checkstyle.Main",
    runtime_deps = [":checkstyle_import"],
)

java_binary(
    name = "pmd",
    main_class = "net.sourceforge.pmd.cli.PmdCli",
    runtime_deps = ["@jvm_pmd_dist//:lib"],
)

java_binary(
    name = "scalafix",
    main_class = "scalafix.cli.Cli",
    runtime_deps = ["@dx_scalafix//:ch_epfl_scala_scalafix_cli_2_13_18"],
)

java_binary(
    name = "spotbugs",
    main_class = "edu.umd.cs.findbugs.LaunchAppropriateUI",
    runtime_deps = ["@jvm_spotbugs_dist//:lib"],
)

java_import(
    name = "ktfmt_import",
    jars = ["@jvm_ktfmt//file"],
)

java_binary(
    name = "ktfmt",
    main_class = "com.facebook.ktfmt.cli.Main",
    runtime_deps = [":ktfmt_import"],
)

java_import(
    name = "detekt_import",
    jars = ["@jvm_detekt//file"],
)

java_binary(
    name = "detekt",
    main_class = "io.gitlab.arturbosch.detekt.cli.Main",
    runtime_deps = [":detekt_import"],
)

pinned_java_runtime(
    name = "jdk25",
    version = "25",
)

jar_lsp_tool(
    name = "pkl_lsp",
    driver = "//quality/lsp_check",
    jar = "@jvm_pkl_lsp//file",
    runtime = ":jdk25",
)

filegroup(
    name = "pkl_lsp_java",
    srcs = [":pkl_lsp"],
    output_group = "java",
)

filegroup(
    name = "pkl_lsp_jar",
    srcs = [":pkl_lsp"],
    output_group = "jar",
)

rust_test(
    name = "pkl_lsp_smoke_test",
    srcs = ["pkl_lsp_smoke_test.rs"],
    data = [
        "testdata/clean.pkl",
        "testdata/unused.pkl",
        ":jdk25",
        "//quality/lsp_check",
        "@jvm_pkl_lsp//file",
    ],
    env = {
        "LSP_CHECK": "$(rootpath //quality/lsp_check)",
        "PKL_LSP_JAR": "$(rootpath @jvm_pkl_lsp//file)",
        "PKL_LSP_JAVA": "$(JAVA_ROOTPATH)",
    },
    toolchains = [":jdk25"],
    deps = ["//tools/testing:dx_testing"],
)

rustfmt_test(
    name = "pkl_lsp_smoke_fmt_test",
    targets = [":pkl_lsp_smoke_test"],
)

rust_clippy_test(
    name = "pkl_lsp_smoke_clippy_test",
    targets = [":pkl_lsp_smoke_test"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "jar_lsp_tool.bzl",
        "java_runtime_pin.bzl",
    ],
    tags = ["corpus"],
)
