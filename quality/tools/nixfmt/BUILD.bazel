load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//haskell:defs.bzl", "haskell_deps_resolve", "haskell_deps_resolve_test")

package(default_visibility = ["//visibility:public"])

_PROJECT = ["cabal.project"]

exports_files(_PROJECT + ["haskell_deps.json"])

haskell_deps_resolve(
    name = "resolve",
    srcs = _PROJECT,
    target = "exe:nixfmt",
)

haskell_deps_resolve_test(
    name = "resolve_test",
    srcs = _PROJECT,
)

# The upstream static binary exists for linux_x86_64 only. The linux_arm64 cell
# builds the tagged source with the managed GHC. macos_arm64 is not yet supported: the managed GHC cabal path needs libffi headers and an ar the hermetic macOS toolchain lacks. Windows does not build: the
# nixfmt executable requires the unix package.
alias(
    name = "nixfmt",
    actual = select({
        "//haskell/private/toolchain:cell_linux_arm64": "@haskell_nixfmt_hackage//:nixfmt-exe-nixfmt",
        "//conditions:default": "@dx_tools//:nixfmt",
    }),
)

build_test(
    name = "nixfmt_build_test",
    target_compatible_with = select({
        "//haskell/private/toolchain:cell_linux_arm64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    targets = ["@haskell_nixfmt_hackage//:nixfmt-exe-nixfmt"],
)
