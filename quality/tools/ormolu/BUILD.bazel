load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//haskell/rules:deps_resolve.bzl", "haskell_deps_resolve", "haskell_deps_resolve_test")

package(default_visibility = ["//visibility:public"])

_PROJECT = ["cabal.project"]

exports_files(_PROJECT + ["haskell_deps.json"])

haskell_deps_resolve(
    name = "resolve",
    srcs = _PROJECT,
    target = "exe:ormolu",
)

haskell_deps_resolve_test(
    name = "resolve_test",
    srcs = _PROJECT,
)

alias(
    name = "ormolu",
    actual = select({
        "//haskell/toolchain:cell_linux_arm64": "@haskell_ormolu_hackage//:ormolu-exe-ormolu",
        "//conditions:default": "@dx_tools//:ormolu",
    }),
)

build_test(
    name = "ormolu_build_test",
    target_compatible_with = select({
        "//haskell/toolchain:cell_linux_arm64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    targets = ["@haskell_ormolu_hackage//:ormolu-exe-ormolu"],
)
