load("@rules_powershell//powershell:defs.bzl", "pwsh_binary")
load("//quality:fixtures.bzl", "real_source_target")
load("//quality:unavailable_tool.bzl", "dx_unavailable_tool")

package(default_visibility = ["//:__subpackages__"])

pwsh_binary(
    name = "psscriptanalyzer",
    srcs = ["Invoke-Analyzer.ps1"],
    deps = ["//powershell/gallery:psscriptanalyzer"],
)

alias(
    name = "psscriptanalyzer_tool",
    actual = select({
        ":windows": ":psscriptanalyzer_unsupported",
        "//conditions:default": ":psscriptanalyzer",
    }),
)

config_setting(
    name = "windows",
    constraint_values = ["@platforms//os:windows"],
)

dx_unavailable_tool(
    name = "psscriptanalyzer_unsupported",
    tool = "psscriptanalyzer",
)

exports_files(["Invoke-Analyzer.ps1"])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
    ],
    tags = ["corpus"],
)
