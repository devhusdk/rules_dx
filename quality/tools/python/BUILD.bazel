load("@aspect_rules_py//py:defs.bzl", "py_binary")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

exports_files([
    "pyproject.toml",
    "uv.lock",
])

py_binary(
    name = "pydoclint",
    srcs = ["pydoclint_main.py"],
    dep_group = "dx-python-tools",
    main = "pydoclint_main.py",
    deps = ["@pypi//pydoclint"],
)

py_binary(
    name = "flake8",
    srcs = ["flake8_main.py"],
    dep_group = "dx-python-tools",
    main = "flake8_main.py",
    deps = ["@pypi//flake8"],
)

py_binary(
    name = "pylint",
    srcs = ["pylint_main.py"],
    dep_group = "dx-python-tools",
    main = "pylint_main.py",
    deps = ["@pypi//pylint"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["pyproject.toml"],
)
