load(":unconfigured.bzl", "unconfigured_tool")

package(default_visibility = ["//:__subpackages__"])

unconfigured_tool(
    name = "rubocop_unconfigured",
    tool = "rubocop",
)

unconfigured_tool(
    name = "standardrb_unconfigured",
    tool = "standardrb",
)

label_flag(
    name = "rubocop",
    build_setting_default = ":rubocop_unconfigured",
)

label_flag(
    name = "standardrb",
    build_setting_default = ":standardrb_unconfigured",
)
