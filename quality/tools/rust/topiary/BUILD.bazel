load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_test", "rustfmt_test")

package(default_visibility = ["//quality/tools/rust:__pkg__"])

_DEPS = [
    "@dx_quality_crates//:topiary-core",
    "@dx_quality_crates//:topiary-queries",
    "@dx_quality_crates//:tree-sitter",
    "@dx_quality_crates//:tree-sitter-ocaml",
]

# keep
rust_binary(
    name = "dx_topiary",
    srcs = ["main.rs"],
    crate_name = "dx_topiary",
    crate_root = "main.rs",
    edition = "2021",
    deps = _DEPS,
)

# keep
rust_test(
    name = "dx_topiary_test",
    crate = ":dx_topiary",
    deps = _DEPS,
)

rustfmt_test(
    name = "dx_topiary_fmt_test",
    targets = [":dx_topiary"],
)

rust_clippy_test(
    name = "dx_topiary_clippy_test",
    targets = [":dx_topiary"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
