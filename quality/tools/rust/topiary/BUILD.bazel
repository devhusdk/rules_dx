load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_test")

package(default_visibility = ["//quality/tools/rust:__pkg__"])

_DEPS = [
    "@dx_quality_crates//:topiary-core",
    "@dx_quality_crates//:topiary-queries",
    "@dx_quality_crates//:tree-sitter",
    "@dx_quality_crates//:tree-sitter-ocaml",
]

# keep: no Cargo.toml here; Gazelle would delete it
rust_binary(
    name = "dx_topiary",
    srcs = ["main.rs"],
    crate_name = "dx_topiary",
    crate_root = "main.rs",
    deps = _DEPS,
)

# keep: no Cargo.toml here; Gazelle would delete it
rust_test(
    name = "dx_topiary_test",
    crate = ":dx_topiary",
    deps = _DEPS,
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
