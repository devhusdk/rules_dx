load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//rego:__subpackages__"])

exports_files([
    "src/lib.rs",
    "src/opa.rs",
    "src/opa_tests.rs",
])

rust_library(
    name = "dx_opa_test",
    srcs = [
        "src/lib.rs",
        "src/opa.rs",
    ],
    crate_root = "src/lib.rs",
    visibility = ["//cli/runtime:__pkg__"],
    deps = [
        "//cli/path:dx_path",
        "@crates//:tempfile",
    ],
)

rust_test(
    name = "dx_opa_test_test",
    size = "small",
    srcs = [
        "src/lib.rs",
        "src/opa.rs",
        "src/opa_tests.rs",
    ],
    coverage_lib = ":dx_opa_test",
    crate_name = "dx_opa_test",
    crate_root = "src/lib.rs",
    deps = [
        "//cli/path:dx_path",
        "//cli/test_scratch:dx_test_scratch",
        "@crates//:tempfile",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
