# gazelle:exclude fixtures
# gazelle:ignore

load("@crates//:crates.bzl", "aliases")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//core:failure_test.bzl", "failure_test")
load("//core/tests:direct_sources.bzl", "dx_direct_sources_test")
load("//core/tests:no_coverage_tests.bzl", "no_coverage_build_scripts_test")
load("//rego:defs.bzl", "rego_library", "rego_test")
load("//rego/private:defs.bzl", "rego_exec")
load("//rust:defs.bzl", "rust_test")
load(":defs_tests.bzl", "owns_rego_class_test", "test_descriptor_test", "test_sources_test", "transitive_context_test")

rego_library(
    name = "lib",
    srcs = ["fixtures/policy/lib.rego"],
    data = ["fixtures/policy/data.json"],
)

rego_library(
    name = "app",
    srcs = ["fixtures/policy/app.rego"],
    deps = [":lib"],
)

owns_rego_class_test(
    name = "owns_rego_class_test",
    size = "small",
    target_under_test = ":app",
)

transitive_context_test(
    name = "transitive_context_test",
    size = "small",
    target_under_test = ":app",
)

rego_library(
    name = "bad_src",
    srcs = ["fixtures/policy/notes.txt"],
    tags = ["manual"],
)

failure_test(
    name = "non_rego_src_fails",
    expected_failure_substring = "notes.txt",
    target = ":bad_src",
)

rego_test(
    name = "pass_test",
    srcs = ["fixtures/policy/app_test.rego"],
    data = ["fixtures/policy/data.json"],
    deps = [":app"],
)

rego_exec(
    name = "fail_exec",
    testonly = True,
    srcs = ["fixtures/policy/fail_test.rego"],
)

rego_exec(
    name = "empty_exec",
    testonly = True,
    srcs = ["fixtures/policy/empty_test.rego"],
)

test_sources_test(
    name = "test_sources_test",
    size = "small",
    target_under_test = ":pass_test",
)

test_descriptor_test(
    name = "test_descriptor_test",
    size = "small",
    target_under_test = ":pass_test",
)

[
    filegroup(
        name = name + "_manifest",
        testonly = True,
        srcs = [":" + name],
        output_group = "rego_test_manifest",
    )
    for name in [
        "empty_exec",
        "fail_exec",
        "pass_test",
    ]
]

rust_test(
    name = "opa_test_run_test",
    testonly = True,
    srcs = ["opa_test_run_test.rs"],
    aliases = aliases(
        package_name = "rego/rego_tests",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "opa_test_run_test",
    crate_root = "opa_test_run_test.rs",
    data = [
        ":empty_exec",
        ":empty_exec_manifest",
        ":fail_exec",
        ":fail_exec_manifest",
        ":pass_test",
        ":pass_test_manifest",
    ],
    env = {
        "EMPTY_EXE": "$(rootpath :empty_exec)",
        "EMPTY_MANIFEST": "$(rlocationpath :empty_exec_manifest)",
        "FAIL_EXE": "$(rootpath :fail_exec)",
        "FAIL_MANIFEST": "$(rlocationpath :fail_exec_manifest)",
        "PASS_EXE": "$(rootpath :pass_test)",
        "PASS_MANIFEST": "$(rlocationpath :pass_test_manifest)",
    },
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = ["//cli/test_scratch:dx_test_scratch"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "defs_tests.bzl",
    ],
    tags = ["corpus"],
)

genrule(
    name = "generated_rego",
    srcs = ["fixtures/policy/lib.rego"],
    outs = ["generated.rego"],
    cmd = "cp $< $@",
)

rego_library(
    name = "mixed_srcs",
    srcs = [
        "fixtures/policy/app.rego",
        ":generated_rego",
    ],
)

dx_direct_sources_test(
    name = "generated_src_skipped_test",
    expected = {"rego": ["app.rego"]},
    target_under_test = ":mixed_srcs",
)

real_source_target(
    name = "corpus_toml",
    testonly = True,
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

no_coverage_build_scripts_test(
    name = "launcher_build_scripts_no_coverage_test",
    target_under_test = ":pass_test",
)
