{
  "$schema": "../core/modules/lang.schema.json",
  "name": "ruby",
  "title": "Ruby",
  "family": "core",
  "ecosystems": [
    "ruby"
  ],
  "depcheck": "ruby",
  "semver": false,
  "manifests": [
    "Gemfile"
  ],
  "lockfiles": [
    "Gemfile.lock"
  ],
  "setup": {
    "hubs": [
      {
        "ecosystem": "ruby",
        "manifest": "Gemfile",
        "lock": "ruby.lock.json",
        "state": "Gemfile.lock",
        "extension": "@rules_dx//ruby:extensions.bzl",
        "tag": "lock",
        "hub": "gems",
        "resolver": "@rules_dx//ruby/private/tools/lock",
        "imports": "provides"
      }
    ]
  },
  "tools": [
    "rubocop",
    "sorbet"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_x86_64"
  ],
  "pins": [
    "pins.json"
  ],
  "entry_points": [
    "ruby_library",
    "ruby_binary",
    "ruby_test",
    "ruby_bench",
    "ruby_doc_shard"
  ],
  "quality": {
    "bzl": "ruby/private/quality:ruby.bzl",
    "classes": [
      "ruby"
    ],
    "file_extensions": [
      ".rb",
      ".rbs"
    ],
    "aspects": {
      "format": [
        "real_ruby_format_aspect"
      ],
      "lint": [
        "real_ruby_lint_aspect"
      ],
      "typecheck": [
        "real_ruby_typecheck_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_ruby_format_probe_aspect"
      ],
      "lint": [
        "real_ruby_lint_probe_aspect"
      ],
      "typecheck": [
        "real_ruby_typecheck_probe_aspect"
      ]
    }
  },
  "docs": {
    "bzl": "tools/docs/ruby:aspect.bzl",
    "file_extensions": [
      ".rb"
    ],
    "aspects": [
      "real_ruby_docs_aspect"
    ]
  }
}
