{
  "$schema": "../core/modules/lang.schema.json",
  "name": "ruby",
  "title": "Ruby",
  "family": "core",
  "ecosystems": [
    "ruby"
  ],
  "depcheck": "ruby",
  "semver": false,
  "manifests": [
    "Gemfile"
  ],
  "lockfiles": [
    "Gemfile.lock"
  ],
  "tools": [
    "rubocop",
    "sorbet"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_x86_64"
  ],
  "pins": [
    "private/toolchain/pins.json"
  ],
  "entry_points": [
    "ruby_coverage_lib_dirs",
    "ruby_library",
    "ruby_binary",
    "ruby_test",
    "ruby_bench"
  ],
  "quality": {
    "bzl": "quality:families/ruby.bzl",
    "file_extensions": [
      ".rb",
      ".rbs"
    ],
    "aspects": {
      "format": [
        "real_ruby_format_aspect"
      ],
      "lint": [
        "real_ruby_lint_aspect"
      ],
      "typecheck": [
        "real_ruby_typecheck_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_ruby_format_probe_aspect"
      ],
      "lint": [
        "real_ruby_lint_probe_aspect"
      ],
      "typecheck": [
        "real_ruby_typecheck_probe_aspect"
      ]
    }
  }
}
