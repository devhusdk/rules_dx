load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load(":unconfigured.bzl", "unconfigured_tool")

package(default_visibility = ["//:__subpackages__"])

unconfigured_tool(
    name = "rubocop_unconfigured",
    tool = "rubocop",
)

label_flag(
    name = "rubocop",
    scope = "universal",
    build_setting_default = ":rubocop_unconfigured",
)

exports_files([
    "ruby.bzl",
    "ruby_tools.bzl",
])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "ruby.bzl",
        "ruby_tools.bzl",
        "unconfigured.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
    ]),
    visibility = ["//:__subpackages__"],
)
