# The ruby package of the dx_toolchains hub. Labels resolve as in rules_dx.

toolchain(
    name = "toolchain_arm64_darwin",
    exec_compatible_with = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
    target_settings = ["@rules_dx//config:toolchains_on"],
    toolchain = "@dx_ruby_toolchains//:arm64_darwin",
    toolchain_type = "@rules_dx//ruby:toolchain_type",
)

