load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//ruby:defs.bzl", "ruby_binary", "ruby_library", "ruby_test")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "subject_compatible_with")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

ruby_library(
    name = "conformance",
    testonly = True,
    srcs = ["greet.rb"],  # keep
)

ruby_library(
    name = "lint_dirty",
    testonly = True,
    srcs = ["lib/lint_dirty.rb"],
    tags = ["manual"],
)

ruby_library(
    name = "format_dirty",
    testonly = True,
    srcs = ["lib/format_dirty.rb"],
    tags = ["manual"],
)

ruby_binary(
    name = "hello",
    srcs = ["main.rb"],
    main = "main.rb",
    deps = [":conformance"],
)

ruby_binary(
    name = "lock_hello",
    srcs = ["lock_main.rb"],
    main = "lock_main.rb",
    deps = ["@bundle"],
)

ruby_test(
    name = "pass_subject_test",
    size = "small",
    srcs = ["pass_test.rb"],
    main = "pass_test.rb",
    target_compatible_with = subject_compatible_with(),
    deps = [":conformance"],
)

ruby_test(
    name = "fail_subject_test",
    size = "small",
    srcs = ["fail_test.rb"],
    main = "fail_test.rb",
    target_compatible_with = subject_compatible_with(),
    deps = [":conformance"],
)

dx_conformance_suite(
    name = "",
    size = "small",
    binary = ":hello",
    covered_source = "greet.rb",
    expected = "hello world",
    failing_case = "failing_case",
    failing_pattern = "{case}",
    failing_test = ":fail_subject_test",
    lang = "ruby",
    lock = {
        "binary": ":lock_hello",
        "ecosystem": "ruby",
        "expected": "hello lock",
        "lockfile": "//third_party/ruby:Gemfile.lock",
        "manifest": "//third_party/ruby:Gemfile",
        "package": "rspec",
        "stale": "Gemfile.stale.lock",
    },
    not_applicable = {"cross_test": "ruby_binary is a script the interpreter runs; it has no object format"},
    passing_test = ":pass_subject_test",
    quality = {
        "clean": ":conformance",
        "format_dirty": ":format_dirty",
        "format_source": "lib/format_dirty.rb",
        "lint_dirty": ":lint_dirty",
        "lint_line": 1,
        "lint_rule": "Style/FrozenStringLiteralComment",
        "lint_source": "lib/lint_dirty.rb",
    },
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
