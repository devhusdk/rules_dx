load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//ruby:defs.bzl", "ruby_binary", "ruby_library", "ruby_test")
load("@rules_dx//ruby/tests:defs_tests.bzl", "ruby_coverage_env_test")
load("@rules_dx//tools/testing:hello_output.bzl", "dx_hello_output_test")
load(":quality_tests.bzl", "main_outside_srcs_test")

package(
    default_testonly = True,
    default_visibility = ["//visibility:public"],
)

ruby_library(
    name = "hello_lib",
    testonly = True,
    srcs = ["hello.rb"],  # keep
)

ruby_binary(
    name = "hello",
    srcs = ["main.rb"],
    main = "main.rb",
    deps = [":hello_lib"],
)

ruby_binary(
    name = "main_outside_srcs",
    srcs = ["hello.rb"],
    main = "main_outside_srcs.rb",
)

main_outside_srcs_test(
    name = "main_outside_srcs_quality_test",
    target_under_test = ":main_outside_srcs",
)

ruby_test(
    name = "hello_test",
    size = "small",
    srcs = ["hello_test.rb"],
    main = "hello_test.rb",
    deps = [":hello_lib"],
)

ruby_test(
    name = "coverage_probe_test",
    size = "small",
    srcs = ["coverage_probe_test.rb"],
    data = ["hello_test.rb"],
    main = "coverage_probe_test.rb",
    deps = [":hello_lib"],
)

ruby_coverage_env_test(
    name = "hello_test_coverage_env_test",
    target = ":hello_test",
)

dx_hello_output_test(
    name = "hello_output_test",
    binary = ":hello",
    expected = "hello world",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "quality_tests.bzl",
    ],
    tags = ["corpus"],
)
