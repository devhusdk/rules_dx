load("//quality:fixtures.bzl", "real_source_target")
load("//ruby/rules:defs.bzl", "ruby_binary", "ruby_library", "ruby_test")
load("//tools/sh:harness.bzl", "dx_shell_harness")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

ruby_library(
    name = "hello_lib",
    srcs = ["hello.rb"],
)

ruby_binary(
    name = "hello",
    srcs = ["main.rb"],
    main = "main.rb",
    deps = [":hello_lib"],
)

ruby_test(
    name = "hello_test",
    srcs = ["hello_test.rb"],
    deps = [":hello_lib"],
)

dx_shell_harness(
    name = "hello_output_test",
    srcs = ["hello_output_test.sh"],
    args = ["$(rootpath :hello)"],
    data = [
        ":hello",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
