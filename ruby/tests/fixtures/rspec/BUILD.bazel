load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//ruby:defs.bzl", "ruby_library", "ruby_test")
load("//ruby/tests/fixtures/hello:quality_tests.bzl", "rspec_owns_spec_test")

package(
    default_testonly = True,
    default_visibility = ["//visibility:public"],
)

ruby_library(
    name = "greeter_lib",
    srcs = ["greeter.rb"],
)

ruby_library(
    name = "spec_helper",
    srcs = ["spec_helper.rb"],
    deps = [":greeter_lib"],
)

ruby_test(
    name = "greeter_spec",
    srcs = ["greeter_spec.rb"],
    args = ["$(rootpath greeter_spec.rb)"],
    main = "@bundle//bin:rspec",
    deps = [
        ":spec_helper",
        "@bundle",
    ],
)

rspec_owns_spec_test(
    name = "greeter_spec_quality_test",
    target_under_test = ":greeter_spec",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
    ],
    tags = ["corpus"],
)
