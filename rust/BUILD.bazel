load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//rust/private:build_script_cc_env.bzl", "build_script_cc_env")

exports_files([
    "README.md",
    "defs.bzl",
    "extensions.bzl",
    "lang.json",
    "pins.json",
])

# Cargo build scripts list this in `build_script_toolchains` to get the cc tools and flags.
build_script_cc_env(
    name = "build_script_cc_env",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "module_srcs",
    srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "extensions.bzl",
        "lang.json",
        "pins.json",
    ],
    visibility = ["//:__subpackages__"],
)

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "extensions.bzl",
    ],
    tags = ["corpus"],
)
