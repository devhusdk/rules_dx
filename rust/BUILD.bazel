load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library")
load("//rust/private:build_script_cc_env.bzl", "build_script_cc_env")

exports_files([
    "README.md",
    "defs.bzl",
    "extensions.bzl",
    "lang.json",
    "pins.json",
])

# Cargo build scripts list this in `build_script_toolchains` to get the cc tools and flags.
build_script_cc_env(
    name = "build_script_cc_env",
    visibility = ["//visibility:public"],
)

# Native tests list this in `data` to run a WASI module.
alias(
    name = "wasmtime",
    actual = "@dx_tools//:wasmtime",
    visibility = ["//visibility:public"],
)

# Native tests list this in `deps` to run a WASI module and read its output.
# keep: the sources live in tools/testing/wasi, which has no Cargo [lib]
rust_library(
    name = "wasi_run",
    testonly = True,
    srcs = ["//tools/testing/wasi:wasi_run.rs"],
    crate_name = "wasi_run",
    crate_root = "//tools/testing/wasi:wasi_run.rs",
    visibility = ["//visibility:public"],
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing:dx_testing",
    ],
)

filegroup(
    name = "module_srcs",
    srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "extensions.bzl",
        "lang.json",
        "pins.json",
    ],
    visibility = ["//:__subpackages__"],
)

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "extensions.bzl",
    ],
    tags = ["corpus"],
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//tools/api:__pkg__"],
)
