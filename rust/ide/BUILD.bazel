load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rustfmt_test")
load("//tools/ide:ide_acquisition.bzl", "ide_acquisition_test")
load("//tools/ide:ide_tool.bzl", "ide_rust_analyzer_tool")
load("//tools/testing/hermetic:defs.bzl", "nested_bazel_test")

package(default_visibility = ["//:__subpackages__"])

exports_files(["BUILD.bazel"])

ide_acquisition_test(
    name = "ide_acquisition_test",
    binary = "@rules_rust//tools/rust_analyzer:discover_bazel_rust_project",
    binary_two = "@rules_rust//tools/rust_analyzer:flycheck",
    expected = "--bazel_startup_option",
    expected_two = "--output-base",
    version_args = ["--help"],
    version_args_two = ["--help"],
)

ide_rust_analyzer_tool(name = "rust_analyzer_tool")

ide_acquisition_test(
    name = "rust_analyzer_acquisition_test",
    binary = ":rust_analyzer_tool",
    expected = "rust-analyzer",
    tags = ["no-remote-exec"],
    version_args = ["--version"],
)

nested_bazel_test(
    name = "init_rust_analyzer_test",
    size = "enormous",
    srcs = ["tests/init_rust_analyzer.rs"],
    data = [
        "//:module_srcs",
        "//cli/cli:dx",
        "@rust_analyzer_1.98.1_tools//:rust_analyzer",
    ],
    env = {
        "DX_BIN": "$(rootpath //cli/cli:dx)",
        "DX_RUST_ANALYZER": "$(rootpath @rust_analyzer_1.98.1_tools//:rust_analyzer)",
    },
    env_inherit = [
        "HOME",
        "PATH",
    ],
    network = True,
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [
        "//tools/testing:dx_lsp",
        "//tools/testing:dx_nested",
        "//tools/testing:dx_testing",
        "@crates//:serde_json",
    ],
)

rustfmt_test(
    name = "init_rust_analyzer_fmt_test",
    size = "small",
    targets = [":init_rust_analyzer_test"],
)

rust_clippy_test(
    name = "init_rust_analyzer_clippy_test",
    size = "small",
    targets = [":init_rust_analyzer_test"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
