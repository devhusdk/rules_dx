{
  "$schema": "../modules/lang.schema.json",
  "name": "rust",
  "title": "Rust",
  "family": "core",
  "ecosystems": [
    "cargo"
  ],
  "depcheck": "rust",
  "semver": true,
  "manifests": [
    "Cargo.toml"
  ],
  "lockfiles": [
    "Cargo.lock"
  ],
  "tools": [
    "clippy",
    "rustc",
    "rustfmt"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_arm64",
    "windows_x86_64"
  ],
  "pins": [],
  "entry_points": [
    "rust_library",
    "rust_binary",
    "rust_test",
    "rust_bench",
    "rust_proc_macro",
    "rust_shared_library",
    "rust_static_library",
    "rust_fuzz_test"
  ],
  "quality": {
    "bzl": "rust/private/quality:rust.bzl",
    "file_extensions": [
      ".rs"
    ],
    "aspects": {
      "format": [
        "real_rust_format_aspect"
      ],
      "lint": [
        "real_rust_lint_aspect"
      ],
      "typecheck": [
        "real_rust_typecheck_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_rust_format_probe_aspect"
      ],
      "lint": [
        "real_rust_lint_probe_aspect"
      ],
      "typecheck": [
        "real_rust_typecheck_probe_aspect"
      ]
    }
  }
}
