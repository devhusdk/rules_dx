{
  "$schema": "../core/modules/lang.schema.json",
  "name": "rust",
  "title": "Rust",
  "family": "core",
  "ecosystems": [
    "cargo"
  ],
  "depcheck": "rust",
  "semver": true,
  "manifests": [
    "Cargo.toml"
  ],
  "lockfiles": [
    "Cargo.lock"
  ],
  "setup": {
    "cc_toolchains": true,
    "flags": [
      "build --@rules_dx//config:clippy_output_diagnostics=true",
      "build --@rules_dx//config:rustc_output_diagnostics=true",
      "build:windows --@rules_dx//config:toolchain_linker_preference=rust"
    ],
    "hubs": [
      {
        "ecosystem": "cargo",
        "manifest": "Cargo.toml",
        "lock": "Cargo.lock",
        "state": null,
        "extension": "@rules_dx//rust:extensions.bzl",
        "tag": "from_cargo",
        "hub": "crates",
        "resolver": null,
        "imports": "name"
      }
    ]
  },
  "commands": {
    "discover": "@rules_dx//rust/private/ide:discover",
    "flycheck": "@rules_dx//rust/private/ide:flycheck"
  },
  "tools": [
    "clippy",
    "rustc",
    "rustfmt"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_arm64",
    "windows_x86_64"
  ],
  "pins": [
    "pins.json"
  ],
  "entry_points": [
    "rust_library",
    "rust_binary",
    "rust_test",
    "rust_bench",
    "rust_proc_macro",
    "rust_shared_library",
    "rust_static_library",
    "rust_fuzz_test",
    "rust_build_script",
    "rust_docs_site"
  ],
  "quality": {
    "bzl": "rust/private/quality:rust.bzl",
    "classes": [
      "rust"
    ],
    "defaults": {
      "audit": [],
      "format": [
        "rustfmt"
      ],
      "lint": [
        "clippy",
        "typos"
      ],
      "typecheck": [
        "rustc"
      ]
    },
    "file_extensions": [
      ".rs"
    ],
    "aspects": {
      "format": [
        "real_rust_format_aspect"
      ],
      "lint": [
        "real_rust_lint_aspect"
      ],
      "typecheck": [
        "real_rust_typecheck_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_rust_format_probe_aspect"
      ],
      "lint": [
        "real_rust_lint_probe_aspect"
      ],
      "typecheck": [
        "real_rust_typecheck_probe_aspect"
      ]
    }
  },
  "docs": {
    "bzl": "tools/docs/rust:aspect.bzl",
    "file_extensions": [
      ".rs"
    ],
    "aspects": [
      "real_rust_docs_aspect"
    ]
  }
}
