load("@rules_cc//cc:defs.bzl", "cc_import")
load("//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = [
    "//:__pkg__",
    "//rust:__subpackages__",
    "//tools/ci:__pkg__",
])

cc_import(
    name = "fuzz_asan_runtime_macos",
    shared_library = "@llvm//runtimes/compiler-rt:clang_rt.asan.shared",
    target_compatible_with = ["@platforms//os:macos"],
    visibility = ["//visibility:public"],
)

cc_import(
    name = "fuzz_libfuzzer_macos",
    static_library = "@llvm//runtimes/compiler-rt:clang_rt.fuzzer.static",
    target_compatible_with = ["@platforms//os:macos"],
    visibility = ["//visibility:public"],
    alwayslink = True,
)

cc_import(
    name = "unwind",
    static_library = "@llvm//runtimes/libunwind:libunwind.static",
    visibility = ["//visibility:public"],
)

exports_files([
    "build_script_cc_env.bzl",
    "defs.bzl",
    "selene.BUILD.bazel",
])

exports_files(
    [
        "edition.bzl",
        "probe.bzl",
    ],
    visibility = ["//:__subpackages__"],
)

exports_files(
    ["wasi_run.rs"],
    visibility = ["//rust:__pkg__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "build_script_cc_env.bzl",
        "defs.bzl",
        "edition.bzl",
        "probe.bzl",
        "selene.BUILD.bazel",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
