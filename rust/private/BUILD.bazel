load("@rules_cc//cc:defs.bzl", "cc_import")
load("//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = [
    "//:__pkg__",
    "//rust:__subpackages__",
    "//tools/ci:__pkg__",
])

config_setting(
    name = "browser_linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "msvc",
    constraint_values = [
        "@llvm//constraints/windows/abi:msvc",
        "@platforms//os:windows",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "msvc_opt",
    constraint_values = [
        "@llvm//constraints/windows/abi:msvc",
        "@platforms//os:windows",
    ],
    values = {"compilation_mode": "opt"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "libstdcxx",
    constraint_values = ["@llvm//constraints/cxxstdlib:libstdcxx"],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "libstdcxx_ready",
    constraint_values = ["@llvm//constraints/cxxstdlib:libstdcxx"],
    values = {"features": "-static_link_cpp_runtimes"},
    visibility = ["//visibility:public"],
)

cc_import(
    name = "unwind",
    static_library = "@llvm//runtimes/libunwind:libunwind.static",
    visibility = ["//visibility:public"],
)

exports_files([
    "defs.bzl",
    "selene.BUILD.bazel",
])

exports_files(
    [
        "edition.bzl",
        "pdb.bzl",
        "probe.bzl",
        "wrapper_tests.bzl",
    ],
    visibility = ["//:__subpackages__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "edition.bzl",
        "pdb.bzl",
        "probe.bzl",
        "wrapper_tests.bzl",
        "selene.BUILD.bazel",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
