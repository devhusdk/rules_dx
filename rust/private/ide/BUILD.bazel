load("//core/quality:fixtures.bzl", "real_source_target")
load("//tools/ide:ide_tool.bzl", "ide_rust_analyzer_tool")

package(default_visibility = ["//:__subpackages__"])

exports_files(["BUILD.bazel"])

alias(
    name = "flycheck",
    actual = "@rules_rust//tools/rust_analyzer:flycheck",
)

alias(
    name = "discover",
    actual = "@rules_rust//tools/rust_analyzer:discover_bazel_rust_project",
)

ide_rust_analyzer_tool(name = "rust_analyzer_tool")

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
