load("//core/quality:fixtures.bzl", "real_source_target")
load(":rust_clippy_tests.bzl", "rust_clippy_test_suite")

package(default_visibility = [
    "//core/modules:__pkg__",
    "//core/quality:__subpackages__",
    "//rust:__subpackages__",
    "//tools/ci:__pkg__",
])

exports_files([
    "rust.bzl",
    "rust_clippy.bzl",
    "rust_tools.bzl",
])

rust_clippy_test_suite(name = "rust_clippy_tests")

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "rust.bzl",
        "rust_clippy.bzl",
        "rust_clippy_tests.bzl",
        "rust_tools.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
    ]),
    visibility = ["//:__subpackages__"],
)
