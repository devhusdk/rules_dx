# gazelle:ignore
# Quality tools built from Rust source through the dx_quality_crates hub.

load("//core/quality:unavailable_tool.bzl", "dx_unavailable_tool")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.lock",
    "Cargo.toml",
    "cargo-bazel-lock.json",
    "selene.BUILD.bazel",
])

filegroup(
    name = "crate_carrier",
    srcs = ["src/lib.rs"],
)

alias(
    name = "deadnix",
    actual = "@dx_quality_crates//:deadnix__deadnix",
)

alias(
    name = "progenitor",
    actual = "//rust/private/quality/tools/progenitor:dx_progenitor",
)

alias(
    name = "selene",
    actual = "@dx_selene_src//:selene",
)

alias(
    name = "topiary",
    actual = "//rust/private/quality/tools/topiary:dx_topiary",
)

# The dx_quality_crates hub has no windows_arm64 cell, so the aspect tool
# attributes select a marked stub there and the stage is skipped with a note.
config_setting(
    name = "windows_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:windows",
    ],
)

alias(
    name = "deadnix_tool",
    actual = select({
        ":windows_arm64": ":deadnix_unsupported",
        "//conditions:default": ":deadnix",
    }),
)

dx_unavailable_tool(
    name = "deadnix_unsupported",
    tool = "deadnix",
)

alias(
    name = "selene_tool",
    actual = select({
        ":windows_arm64": ":selene_unsupported",
        "//conditions:default": ":selene",
    }),
)

dx_unavailable_tool(
    name = "selene_unsupported",
    tool = "selene",
)

alias(
    name = "topiary_tool",
    actual = select({
        ":windows_arm64": ":topiary_unsupported",
        "//conditions:default": ":topiary",
    }),
)

dx_unavailable_tool(
    name = "topiary_unsupported",
    tool = "topiary",
)
