load("@dx_quality_crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust:defs.bzl", "rust_binary", "rust_test")

# gazelle:dx_rust_crates_hub dx_quality_crates

package(default_visibility = ["//rust/private/quality/tools:__pkg__"])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

rust_binary(
    name = "dx_topiary",
    srcs = ["main.rs"],
    aliases = aliases(
        package_name = "rust/private/quality/tools/dx_topiary",
        normal = True,
    ),
    crate_name = "dx_topiary",
    crate_root = "main.rs",
    deps = all_crate_deps(
        package_name = "rust/private/quality/tools/dx_topiary",
        normal = True,
    ),
)

rust_test(
    name = "dx_topiary_bin_test",
    aliases = aliases(
        package_name = "rust/private/quality/tools/dx_topiary",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_topiary",
    deps = all_crate_deps(
        package_name = "rust/private/quality/tools/dx_topiary",
        normal = True,
        normal_dev = True,
    ),
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
