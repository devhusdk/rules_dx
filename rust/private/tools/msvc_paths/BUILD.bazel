load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("@rules_rust//rust/private:rust.bzl", "rust_binary_without_process_wrapper", "rust_library_without_process_wrapper")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust/private:defs.bzl", "MSVC_LINK_FLAGS")
load(":exec_tool.bzl", "exec_tool")

_RUSTC_FLAGS = select({
    "//core/platforms:msvc": MSVC_LINK_FLAGS,
    "//conditions:default": [],
})

# keep: only msvc_lib depends on it
rust_library(
    name = "msvc_paths",
    srcs = ["src/lib.rs"],
    crate_name = "msvc_paths",
    crate_root = "src/lib.rs",
    edition = "2024",
    visibility = ["//visibility:private"],
)

# msvc_link's copy: process_wrapper links through msvc_link, so neither can use it.
rust_library_without_process_wrapper(
    name = "msvc_paths_bootstrap",
    srcs = ["src/lib.rs"],
    crate_name = "msvc_paths",
    crate_root = "src/lib.rs",
    edition = "2024",
    visibility = ["//visibility:private"],
)

# rust-lld links it, so it writes no PDB, whose paths would vary.
rust_binary_without_process_wrapper(
    name = "msvc_link",
    srcs = ["src/msvc_link.rs"],
    edition = "2024",
    rustc_flags = select({
        "//core/platforms:msvc": MSVC_LINK_FLAGS + [
            "-Clink-arg=/DEBUG:NONE",
            "-Clink-arg=/Brepro",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [":msvc_paths_bootstrap"],
)

exec_tool(
    name = "msvc_link_exec",
    tool = "@dx_prebuilt//:msvc_link",
    visibility = ["//visibility:public"],
)

filegroup(name = "no_linker")

# The rules_rust toolchain linker on Windows, in every configuration except msvc_link's own.
alias(
    name = "toolchain_linker",
    actual = select({
        "//core/platforms:msvc": ":msvc_link_exec",
        "//conditions:default": ":no_linker",
    }),
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "msvc_lib",
    srcs = ["src/msvc_lib.rs"],
    edition = "2024",
    rustc_flags = _RUSTC_FLAGS,
    visibility = ["//visibility:public"],
    deps = [":msvc_paths"],
)

alias(
    name = "clang_cl",
    actual = "@llvm//tools:clang-cl",
    visibility = ["//visibility:public"],
)

rust_test(
    name = "msvc_paths_test",
    size = "small",
    crate = ":msvc_paths",
    edition = "2024",
    rustc_flags = _RUSTC_FLAGS,
    deps = ["//cli/test_scratch:dx_test_scratch"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "exec_tool.bzl",
    ],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

exports_files(
    [
        "src/lib.rs",
    ],
    visibility = ["//core/quality:__pkg__"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
