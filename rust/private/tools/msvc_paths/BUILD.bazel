load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust/private:defs.bzl", "MSVC_LINK_FLAGS")

# Plain rules_rust rules: the dx Rust macros link through msvc_link.

_RUSTC_FLAGS = select({
    "//rust/private:msvc": MSVC_LINK_FLAGS,
    "//conditions:default": [],
})

rust_library(
    name = "msvc_paths",
    srcs = ["src/lib.rs"],
    crate_name = "msvc_paths",
    crate_root = "src/lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "msvc_link",
    srcs = ["src/msvc_link.rs"],
    edition = "2024",
    rustc_flags = _RUSTC_FLAGS,
    visibility = ["//visibility:public"],
    deps = [":msvc_paths"],
)

rust_binary(
    name = "msvc_lib",
    srcs = ["src/msvc_lib.rs"],
    edition = "2024",
    rustc_flags = _RUSTC_FLAGS,
    visibility = ["//visibility:public"],
    deps = [":msvc_paths"],
)

alias(
    name = "clang_cl",
    actual = "@llvm//tools:clang-cl",
    visibility = ["//visibility:public"],
)

rust_test(
    name = "msvc_paths_test",
    size = "small",
    crate = ":msvc_paths",
    edition = "2024",
    rustc_flags = _RUSTC_FLAGS,
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

exports_files(
    [
        "src/lib.rs",
    ],
    visibility = ["//core/quality:__pkg__"],
)
