load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust/private:defs.bzl", "MSVC_LINK_FLAGS")
load(":exec_tool.bzl", "exec_tool")

_RUSTC_FLAGS = select({
    "//core/platforms:msvc": MSVC_LINK_FLAGS,
    "//conditions:default": [],
})

# keep: only msvc_link and msvc_lib depend on it
rust_library(
    name = "msvc_paths",
    srcs = ["src/lib.rs"],
    crate_name = "msvc_paths",
    crate_root = "src/lib.rs",
    edition = "2024",
    visibility = ["//visibility:private"],
)

rust_binary(
    name = "msvc_link",
    srcs = ["src/msvc_link.rs"],
    edition = "2024",
    rustc_flags = _RUSTC_FLAGS,
    visibility = ["//visibility:public"],
    deps = [":msvc_paths"],
)

exec_tool(
    name = "msvc_link_exec",
    tool = "@dx_prebuilt//:msvc_link",
    visibility = ["//visibility:public"],
)

filegroup(name = "no_linker")

# The rules_rust toolchain linker on Windows; exec config resets the flag, so msvc_link links with rust-lld.
alias(
    name = "toolchain_linker",
    actual = select({
        "//core/platforms:msvc": ":msvc_link_exec",
        "//conditions:default": ":no_linker",
    }),
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "msvc_lib",
    srcs = ["src/msvc_lib.rs"],
    edition = "2024",
    rustc_flags = _RUSTC_FLAGS,
    visibility = ["//visibility:public"],
    deps = [":msvc_paths"],
)

alias(
    name = "clang_cl",
    actual = "@llvm//tools:clang-cl",
    visibility = ["//visibility:public"],
)

rust_test(
    name = "msvc_paths_test",
    size = "small",
    crate = ":msvc_paths",
    edition = "2024",
    rustc_flags = _RUSTC_FLAGS,
    deps = ["//cli/test_scratch:dx_test_scratch"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "exec_tool.bzl",
    ],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

exports_files(
    [
        "src/lib.rs",
    ],
    visibility = ["//core/quality:__pkg__"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
