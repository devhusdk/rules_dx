load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//:__subpackages__"])

rust_library(
    name = "dx_shard_runner",
    srcs = ["src/lib.rs"],
    crate_root = "src/lib.rs",
    visibility = ["//cli/runtime:__pkg__"],
    deps = ["@rules_rust//rust/runfiles"],
)

rust_test(
    name = "dx_shard_runner_test",
    size = "small",
    crate = ":dx_shard_runner",
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
