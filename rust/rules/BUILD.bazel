load("@rules_cc//cc:defs.bzl", "cc_import")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

bool_flag(
    name = "msvc_crt_from_rust",
    build_setting_default = False,
)

config_setting(
    name = "browser_linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "msvc",
    constraint_values = [
        "@llvm//constraints/windows/abi:msvc",
        "@platforms//os:windows",
    ],
)

config_setting(
    name = "msvc_opt",
    constraint_values = [
        "@llvm//constraints/windows/abi:msvc",
        "@platforms//os:windows",
    ],
    values = {"compilation_mode": "opt"},
)

config_setting(
    name = "libstdcxx",
    constraint_values = ["@llvm//constraints/cxxstdlib:libstdcxx"],
)

config_setting(
    name = "libstdcxx_ready",
    constraint_values = ["@llvm//constraints/cxxstdlib:libstdcxx"],
    values = {"features": "-static_link_cpp_runtimes"},
)

cc_import(
    name = "unwind",
    static_library = "@llvm//runtimes/libunwind:libunwind.static",
)

exports_files([
    "README.md",
    "defs.bzl",
])

exports_files(
    [
        "edition.bzl",
        "msvc_crt.bzl",
        "pdb.bzl",
        "probe.bzl",
        "wrapper_tests.bzl",
    ],
    visibility = ["//:__subpackages__"],
)

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "edition.bzl",
        "msvc_crt.bzl",
        "pdb.bzl",
        "probe.bzl",
        "wrapper_tests.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
