load("@rules_cc//cc:defs.bzl", "cc_import")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "libstdcxx",
    constraint_values = ["@llvm//constraints/cxxstdlib:libstdcxx"],
)

config_setting(
    name = "libstdcxx_ready",
    constraint_values = ["@llvm//constraints/cxxstdlib:libstdcxx"],
    values = {"features": "-static_link_cpp_runtimes"},
)

cc_import(
    name = "unwind",
    static_library = "@llvm//runtimes/libunwind:libunwind.static",
)

exports_files(
    ["crate.bzl"],
    visibility = ["//:__subpackages__"],
)

exports_files([
    "README.md",
    "defs.bzl",
])

exports_files(
    [
        "edition.bzl",
        "probe.bzl",
        "wrapper_tests.bzl",
    ],
    visibility = ["//:__subpackages__"],
)

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["//quality:corpus_vale_config"],
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "crate.bzl",
        "defs.bzl",
        "edition.bzl",
        "probe.bzl",
        "wrapper_tests.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
