load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_test", "rustfmt_test")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "bench_report",
    srcs = ["src/main.rs"],
)

rust_test(
    name = "bench_report_test",
    srcs = ["src/main.rs"],
)

rustfmt_test(
    name = "bench_report_fmt_test",
    targets = [
        ":bench_report",
        ":bench_report_test",
    ],
)

rust_clippy_test(
    name = "bench_report_clippy_test",
    targets = [":bench_report"],
)
