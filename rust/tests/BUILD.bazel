load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")
load("//tools/ide:ide_acquisition.bzl", "ide_acquisition_test")
load(":cargo_bazel_generator_tests.bzl", "cargo_bazel_generator_test")
load(":crate_build_script_tests.bzl", "crate_build_scripts_no_coverage_test", "raw_build_script_coverage_env_test")
load(":cross_link_tests.bzl", "cross_link_tests")
load(":defs_tests.bzl", "rust_wrapper_registry_tests")
load(":lint_test.bzl", "lint_binary")
load(":musl_toolchain_tests.bzl", "musl_toolchain_tests")
load(":platform_config_tests.bzl", "rust_platform_config_test")
load(":rust_clippy_tests.bzl", "rust_clippy_test_suite")
load(":toolchain_tests.bzl", "toolchain_identity_tests")

exports_files(["cargo-bazel-lock.json"])

exports_files(["defs_tests.bzl"])

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "cargo_bazel_generator_tests.bzl",
        "crate_build_script_tests.bzl",
        "cross_link_tests.bzl",
        "defs_tests.bzl",
        "lint_test.bzl",
        "musl_toolchain_tests.bzl",
        "platform_config_tests.bzl",
        "rust_clippy_tests.bzl",
        "toolchain_tests.bzl",
    ],
    tags = ["corpus"],
)

ide_acquisition_test(
    name = "ide_acquisition_test",
    size = "small",
    binary = "@rules_rust//tools/rust_analyzer:discover_bazel_rust_project",
    binary_two = "@rules_rust//tools/rust_analyzer:flycheck",
    expected = "--bazel_startup_option",
    expected_two = "--output-base",
    version_args = ["--help"],
    version_args_two = ["--help"],
)

ide_acquisition_test(
    name = "rust_analyzer_acquisition_test",
    size = "small",
    binary = "//rust/private/ide:rust_analyzer_tool",
    expected = "rust-analyzer",
    tags = ["no-remote-exec"],
    version_args = ["--version"],
)

cargo_bazel_generator_test(
    name = "cargo_bazel_generator_test",
    size = "small",
    target_under_test = "@dx_cargo_bazel//:generator",
)

crate_build_scripts_no_coverage_test(
    name = "crate_build_scripts_no_coverage_test",
    size = "small",
    target_under_test = "@dx_crates__anyhow-1.0.104//:anyhow",
)

raw_build_script_coverage_env_test(
    name = "raw_build_script_coverage_env_test",
    size = "small",
    target_under_test = "//tools/docs/rust/fixture:docs_fixture_build_script",
)

rust_wrapper_registry_tests(
    name = "wrapper_registry_tests",
    size = "small",
)

toolchain_identity_tests(
    name = "identity",
    size = "small",
)

cross_link_tests(
    name = "cross_link",
    size = "small",
)

musl_toolchain_tests(
    name = "musl_toolchain",
    size = "small",
)

rust_clippy_test_suite(
    name = "rust_clippy_tests",
    size = "small",
)

lint_binary(
    name = "lint_dirty_findings",
    testonly = True,
    targets = ["//rust/tests/conformance:lint_dirty"],
)

filegroup(
    name = "lint_dirty_diagnostics",
    testonly = True,
    srcs = [":lint_dirty_findings"],
    output_group = "clippy_diagnostics",
)

rust_test(
    name = "lint_test_fails_test",
    size = "small",
    srcs = ["lint_test_fails_test.rs"],
    crate_root = "lint_test_fails_test.rs",
    data = [
        ":lint_dirty_diagnostics",
        ":lint_dirty_findings",
    ],
    env = {
        "DX_CLIPPY_DIAGNOSTICS": "$(rlocationpaths :lint_dirty_diagnostics)",
        "DX_LINT_BINARY": "$(rlocationpath :lint_dirty_findings)",
    },
    deps = ["//tools/testing:dx_testing"],
)

build_test(
    name = "release_tools_build_test",
    size = "small",
    target_compatible_with = select({
        "//rust/private/quality/tools:windows_arm64": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    targets = [
        "//rust/private/quality/tools:deadnix",
        "//rust/private/quality/tools:selene",
    ],
)

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "*.rs",
        "BUILD.bazel",
    ]),
    visibility = ["//:__subpackages__"],
)

rust_platform_config_test(
    name = "platform_config_analysis",
    size = "small",
)

# keep
rust_test(
    name = "wasi_run_unit_test",
    size = "small",
    crate = "//rust:wasi_run",
    tags = ["row:wasi"],
)
