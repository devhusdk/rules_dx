load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//rust/tests:rust_clippy_tests.bzl", "clippy_out_dir_test")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "dx_coverage_test", "subject_compatible_with")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

rust_library(
    name = "conformance",
    srcs = ["greet.rs"],
    crate_name = "conformance",
    crate_root = "greet.rs",
    edition = "2024",
)

rust_library(
    name = "lint_dirty",
    srcs = ["lint_dirty.rs"],
    crate_root = "lint_dirty.rs",
    edition = "2024",
    tags = ["manual"],
)

clippy_out_dir_test(
    name = "lint_dirty_clippy_out_dir_test",
    size = "small",
    target_under_test = ":lint_dirty_upstream",
)

rust_library(
    name = "format_dirty",
    srcs = ["format_dirty.rs"],
    crate_root = "format_dirty.rs",
    edition = "2024",
    tags = ["manual"],
)

rust_binary(
    name = "hello",
    srcs = ["main.rs"],
    crate_root = "main.rs",
    edition = "2024",
    deps = [":conformance"],
)

rust_binary(
    name = "lock_hello",
    srcs = ["lock_main.rs"],
    crate_root = "lock_main.rs",
    edition = "2024",
    deps = ["@dx_rust_fixture_crates//:anyhow"],
)

rust_test(
    name = "pass_subject_test",
    size = "small",
    srcs = ["pass_test.rs"],
    crate_name = "pass_subject_test",
    crate_root = "pass_test.rs",
    edition = "2024",
    target_compatible_with = subject_compatible_with(),
    deps = [":conformance"],
)

rust_test(
    name = "fail_subject_test",
    size = "small",
    srcs = ["fail_test.rs"],
    crate_name = "fail_subject_test",
    crate_root = "fail_test.rs",
    edition = "2024",
    target_compatible_with = subject_compatible_with(),
    deps = [":conformance"],
)

rust_test(
    name = "sharded_subject_test",
    size = "small",
    srcs = ["sharded_pass_test.rs"],
    crate_name = "sharded_subject_test",
    crate_root = "sharded_pass_test.rs",
    edition = "2024",
    shard_count = 2,
    target_compatible_with = subject_compatible_with(),
    deps = [":conformance"],
)

dx_coverage_test(
    name = "sharded_coverage_test",
    size = "small",
    covered_source = "greet.rs",
    subject = ":sharded_subject_test",
)

rust_binary(
    name = "runfiles_hello",
    srcs = ["runfiles_main.rs"],
    crate_root = "runfiles_main.rs",
    data = ["data.txt"],
    edition = "2024",
    deps = ["@rules_rust//rust/runfiles"],
)

dx_conformance_suite(
    name = "",
    size = "small",
    binary = ":hello",
    covered_source = "greet.rs",
    expected = "hello world",
    failing_case = "failing_case",
    failing_pattern = "test {case} ... FAILED",
    failing_test = ":fail_subject_test",
    lang = "rust",
    lock = {
        "binary": ":lock_hello",
        "ecosystem": "rust",
        "expected": "hello lock",
        "lockfile": "//rust/tests/fixtures/hello:Cargo.lock",
        "manifest": "//rust/tests/fixtures/hello:Cargo.toml",
        "package": "anyhow",
        "stale": "Cargo.stale.lock",
    },
    passing_test = ":pass_subject_test",
    quality = {
        "clean": ":conformance",
        "format_dirty": ":format_dirty",
        "format_source": "format_dirty.rs",
        "lint_dirty": ":lint_dirty",
        "lint_line": 5,
        "lint_rule": "clippy::len_zero",
        "lint_source": "lint_dirty.rs",
    },
    runfiles = {
        "binary": ":runfiles_hello",
        "data": "data.txt",
        "expected": "hello runfiles",
    },
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
