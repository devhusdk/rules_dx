load("@consumer_hub//:crates.bzl", "crate_deps")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust/rules:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("@rules_dx//tools/testing:hello_output.bzl", "dx_hello_output_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

exports_files([
    "repos.bzl",
    "src/lib.rs",
    "src/main.rs",
])

rust_library(
    name = "consumer_hub_lib",
    srcs = ["src/lib.rs"],
    crate_name = "consumer_hub_fixture",
    crate_root = "src/lib.rs",
    deps = crate_deps(
        ["greeting"],
        package_name = "rust/tests/fixtures/consumer_hub",
    ),
)

rust_binary(
    name = "consumer_hub",
    srcs = ["src/main.rs"],
    crate_name = "consumer_hub_fixture_bin",
    crate_root = "src/main.rs",
    deps = crate_deps(
        ["greeting"],
        package_name = "rust/tests/fixtures/consumer_hub",
    ) + [":consumer_hub_lib"],
)

rust_test(
    name = "consumer_hub_test",
    crate = ":consumer_hub_lib",
    deps = crate_deps(
        ["greeting"],
        package_name = "rust/tests/fixtures/consumer_hub",
    ),
)

dx_hello_output_test(
    name = "consumer_hub_output_test",
    binary = ":consumer_hub",
    expected = "Hello from the consumer hub",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "repos.bzl",
    ],
    tags = ["corpus"],
)
