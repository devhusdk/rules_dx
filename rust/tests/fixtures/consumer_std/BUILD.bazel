load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("@rules_dx//tools/testing:hello_output.bzl", "dx_hello_output_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

exports_files([
    "src/lib.rs",
    "src/main.rs",
])

rust_library(
    name = "consumer_std_lib",
    srcs = ["src/lib.rs"],
    crate_name = "consumer_std",
    crate_root = "src/lib.rs",
    edition = "2021",
)

rust_binary(
    name = "consumer_std",
    srcs = ["src/main.rs"],
    crate_name = "consumer_std",
    crate_root = "src/main.rs",
    edition = "2021",
    deps = [":consumer_std_lib"],
)

rust_test(
    name = "consumer_std_test",
    crate = ":consumer_std_lib",
)

dx_hello_output_test(
    name = "consumer_std_output_test",
    binary = ":consumer_std",
    expected = "Hello from a std-only consumer",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
