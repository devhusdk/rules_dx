load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust/rules:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")
load("@rules_dx//rust/rules:wrapper_tests.bzl", "dx_wasi_binary_tests")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load(":acquisition.bzl", "consumer_wasi_acquisition_tests")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

exports_files([
    "build.rs",
    "data/input.txt",
    "data/secret.txt",
    "injecting_runtime.cmd",
    "injecting_runtime.sh",
    "macros/lib.rs",
    "src/lib.rs",
    "src/main.rs",
])

cargo_build_script(
    name = "consumer_wasi_build_script",
    srcs = ["build.rs"],
    crate_name = "consumer_wasi_build_script",
    crate_root = "build.rs",
    edition = "2021",
    pkg_name = "consumer_wasi",
    use_cc_toolchain = 0,
    use_default_shell_env = 0,
    version = "0.1.0",
)

rust_proc_macro(
    name = "consumer_wasi_macros",
    srcs = ["macros/lib.rs"],
    crate_name = "consumer_wasi_macros",
    crate_root = "macros/lib.rs",
    edition = "2021",
)

rust_library(
    name = "consumer_wasi_lib",
    srcs = ["src/lib.rs"],
    crate_name = "consumer_wasi",
    crate_root = "src/lib.rs",
    edition = "2021",
    proc_macro_deps = [":consumer_wasi_macros"],
    deps = [":consumer_wasi_build_script"],
)

rust_test(
    name = "consumer_wasi_lib_test",
    crate = ":consumer_wasi_lib",
    proc_macro_deps = [":consumer_wasi_macros"],
    deps = [":consumer_wasi_build_script"],
)

rust_binary(
    name = "consumer_wasi",
    srcs = ["src/main.rs"],
    crate_name = "consumer_wasi_bin",
    crate_root = "src/main.rs",
    edition = "2021",
    deps = [":consumer_wasi_lib"],
)

# keep
rust_binary(
    name = "consumer_wasi_module",
    srcs = ["src/main.rs"],
    crate_name = "consumer_wasi_bin",
    crate_root = "src/main.rs",
    edition = "2021",
    wasm = "wasi",
    deps = [":consumer_wasi_lib"],
)

dx_wasi_binary_tests(
    name = "consumer_wasi_module_test",
    target = ":consumer_wasi_module",
)

rust_test(
    name = "consumer_wasi_run_test",
    srcs = ["src/run_test.rs"],
    crate_root = "src/run_test.rs",
    data = [
        ":consumer_wasi_module",
        ":data/input.txt",
        ":data/secret.txt",
        "@rules_dx//wasi/runtime:wasmtime",
    ],
    edition = "2021",
    env = {
        "DX_WASI_HOSTILE": "1",
        "DX_WASI_INPUT": "$(rootpath :data/input.txt)",
        "DX_WASI_MODULE": "$(rootpath :consumer_wasi_module)",
        "DX_WASI_RUNTIME": "$(rootpath @rules_dx//wasi/runtime:wasmtime)",
    },
    deps = [
        "@rules_dx//tools/testing:dx_testing",
        "@rules_dx//wasi/testing:wasi_run",
    ],
)

rust_test(
    name = "guest_test",
    srcs = ["src/guest_test.rs"],
    crate_root = "src/guest_test.rs",
    edition = "2021",
    wasm = "wasi",
    deps = [":consumer_wasi_lib"],
)

rust_test(
    name = "custom_runtime",
    srcs = ["src/custom_runtime_test.rs"],
    crate_root = "src/custom_runtime_test.rs",
    edition = "2021",
    runtime = select({
        "@platforms//os:windows": "injecting_runtime.cmd",
        "//conditions:default": "injecting_runtime.sh",
    }),
    wasm = "wasi",
    deps = [":consumer_wasi_lib"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "acquisition.bzl",
    ],
    tags = ["corpus"],
)

consumer_wasi_acquisition_tests(
    name = "acquisition",
    binary = ":consumer_wasi",
    module = ":consumer_wasi_module",
    run = ":guest_test",
)
