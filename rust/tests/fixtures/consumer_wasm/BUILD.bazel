load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")
load("@rules_dx//tools/testing:hello_output.bzl", "dx_hello_output_test")
load("@rules_rust_wasm_bindgen//:defs.bzl", "rust_wasm_bindgen", "rust_wasm_bindgen_test", "rust_wasm_bindgen_toolchain")
load("//libs/starlark:failure_test.bzl", "failure_test")
load(":acquisition.bzl", "consumer_acquisition_tests")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

exports_files([
    "src/lib.rs",
    "src/main.rs",
])

rust_library(
    name = "consumer_wasm_lib",
    srcs = ["src/lib.rs"],
    aspect_hints = ["//:rustfmt_config"],
    crate_name = "consumer_wasm",
    crate_root = "src/lib.rs",
    edition = "2021",
)

rust_binary(
    name = "consumer_wasm",
    srcs = ["src/main.rs"],
    crate_name = "consumer_wasm",
    crate_root = "src/main.rs",
    edition = "2021",
    deps = [":consumer_wasm_lib"],
)

rust_test(
    name = "consumer_wasm_test",
    crate = ":consumer_wasm_lib",
)

rust_binary(
    name = "consumer_wasm_bind",
    srcs = ["src/main_bind.rs"],
    crate_name = "consumer_wasm_bind",
    crate_root = "src/main_bind.rs",
    edition = "2021",
    deps = ["@rules_rust_wasm_bindgen//3rdparty:wasm_bindgen"],
)

rust_wasm_bindgen(
    name = "consumer_wasm_web",
    target = "web",
    wasm_file = ":consumer_wasm_bind",
)

rust_wasm_bindgen(
    name = "consumer_wasm_node",
    bindgen_flags = ["--no-typescript"],
    target = "nodejs",
    wasm_file = ":consumer_wasm_bind",
)

rust_wasm_bindgen_test(
    name = "consumer_wasm_browser_test",
    wasm = ":consumer_wasm_web",
)

genrule(
    name = "consumer_wasm_web_wasm",
    srcs = [":consumer_wasm_web"],
    outs = ["web_bg.wasm"],
    cmd = "for f in $(locations :consumer_wasm_web); do case $$f in *_bg.wasm) cp $$f $@;; esac; done && test -f $@",
)

genrule(
    name = "consumer_wasm_web_js",
    srcs = [":consumer_wasm_web"],
    outs = ["web.js"],
    cmd = "for f in $(locations :consumer_wasm_web); do case $$f in *.js) cp $$f $@;; esac; done && test -f $@",
)

genrule(
    name = "consumer_wasm_web_dts",
    srcs = [":consumer_wasm_web"],
    outs = ["web.d.ts"],
    cmd = "for f in $(locations :consumer_wasm_web); do case $$f in *.d.ts) cp $$f $@;; esac; done && test -f $@",
)

genrule(
    name = "consumer_wasm_node_wasm",
    srcs = [":consumer_wasm_node"],
    outs = ["node_bg.wasm"],
    cmd = "for f in $(locations :consumer_wasm_node); do case $$f in *.d.ts) echo unexpected typescript >&2; exit 1;; *_bg.wasm) cp $$f $@;; esac; done && test -f $@",
)

genrule(
    name = "consumer_wasm_node_js",
    srcs = [":consumer_wasm_node"],
    outs = ["node.js"],
    cmd = "for f in $(locations :consumer_wasm_node); do case $$f in *.js) cp $$f $@;; esac; done && test -f $@",
)

rust_test(
    name = "consumer_wasm_artifacts_test",
    srcs = ["src/artifacts_test.rs"],
    data = [
        ":consumer_wasm_node_js",
        ":consumer_wasm_node_wasm",
        ":consumer_wasm_web_dts",
        ":consumer_wasm_web_js",
        ":consumer_wasm_web_wasm",
    ],
    edition = "2021",
    env = {
        "NODE_JS": "$(rootpath :consumer_wasm_node_js)",
        "NODE_WASM": "$(rootpath :consumer_wasm_node_wasm)",
        "WEB_DTS": "$(rootpath :consumer_wasm_web_dts)",
        "WEB_JS": "$(rootpath :consumer_wasm_web_js)",
        "WEB_WASM": "$(rootpath :consumer_wasm_web_wasm)",
    },
    deps = ["//tools/testing:dx_testing"],
)

rust_wasm_bindgen(
    name = "consumer_wasm_rlib_subject",
    tags = ["manual"],
    wasm_file = ":consumer_wasm_lib",
)

failure_test(
    name = "consumer_wasm_rejects_rlib_input",
    expected_failure_substring = "No attribute 'crate' in attr",
    target = ":consumer_wasm_rlib_subject",
)

rust_wasm_bindgen_toolchain(
    name = "consumer_wasm_firefox_impl",
    browser = "@firefox",
    browser_type = "firefox",
    tags = ["manual"],
    wasm_bindgen_cli = "@rules_rust_wasm_bindgen//3rdparty:wasm_bindgen_cli",
    wasm_bindgen_test = "@rules_rust_wasm_bindgen//3rdparty:wasm_bindgen_test",
    wasm_bindgen_test_runner = "@rules_rust_wasm_bindgen//3rdparty:wasm_bindgen_test_runner",
    webdriver = "@geckodriver",
    webdriver_args = ["--log", "debug"],
    webdriver_json = ":webdriver.json",
)

toolchain(
    name = "consumer_wasm_firefox",
    tags = ["manual"],
    toolchain = ":consumer_wasm_firefox_impl",
    toolchain_type = "@rules_rust_wasm_bindgen//:toolchain_type",
)

rustfmt_test(
    name = "consumer_wasm_fmt_test",
    size = "small",
    targets = [
        ":consumer_wasm_artifacts_test",
        ":consumer_wasm_bind",
        ":consumer_wasm_lib",
        ":consumer_wasm",
    ],
)

rust_clippy_test(
    name = "consumer_wasm_clippy_test",
    size = "small",
    targets = [
        ":consumer_wasm_artifacts_test",
        ":consumer_wasm_bind",
        ":consumer_wasm_lib",
        ":consumer_wasm",
    ],
)

dx_hello_output_test(
    name = "consumer_wasm_output_test",
    binary = ":consumer_wasm",
    expected = "Hello from an opt-in wasm consumer",
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "acquisition.bzl",
    ],
    tags = ["corpus"],
)

consumer_acquisition_tests(
    name = "acquisition",
    binary = ":consumer_wasm",
    lib = ":consumer_wasm_lib",
)
