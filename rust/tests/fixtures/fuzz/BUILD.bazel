load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_fuzz_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

rust_fuzz_test(
    name = "parse_fuzz",
    srcs = ["parse_fuzz.rs"],
    crate_root = "parse_fuzz.rs",
)

sh_test(
    name = "parse_fuzz_run_test",
    srcs = ["run_test.sh"],
    args = ["$(rootpath :parse_fuzz)"],
    data = [
        ":parse_fuzz",
        "//cc/rules:fuzz_run.sh",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    timeout = "short",
)

real_source_target(
    name = "corpus_toml",
    testonly = True,
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
