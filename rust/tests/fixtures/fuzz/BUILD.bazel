load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust:defs.bzl", "rust_fuzz_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

rust_fuzz_test(
    name = "parse_fuzz",
    srcs = ["parse_fuzz.rs"],
    crate_root = "parse_fuzz.rs",
    libfuzzer_sys = "@dx_rust_fixture_crates//:libfuzzer-sys",
)

sh_test(
    name = "parse_fuzz_run_test",
    env = {"DX_RUNTIME_TOOL": "fuzz_run"},
    srcs = ["run_test.sh"],
    args = [
        "$(rlocationpath @rules_dx//cli/runtime:dx_runtime)",
        "$(rootpath :parse_fuzz)",
    ],
    data = [
        ":parse_fuzz",
        "@rules_dx//cli/runtime:dx_runtime",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    timeout = "short",
)

real_source_target(
    name = "corpus_toml",
    testonly = True,
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
