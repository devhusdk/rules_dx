load("@crates//:crates.bzl", "aliases", "crate_deps")
load("//deploy/rules:archive.bzl", "archive_deploy")
load("//libs/starlark/tests:thin_compare.bzl", "thin_compare_rust_tests", "thin_compare_subject")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_library", "rust_proc_macro", "rust_shared_library", "rust_static_library", "rust_test", "rustfmt_test")
load("//rust/rules:probe.bzl", "dx_wrapper_cc_subject", "dx_wrapper_subject")
load("//rust/rules:wrapper_tests.bzl", "dx_wrapper_conformance_tests", "dx_wrapper_registry_tests")
load("//tools/testing:hello_output.bzl", "dx_hello_output_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

rust_library(
    name = "hello_lib",
    testonly = True,
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "rust/tests/fixtures/hello",
        normal = True,
    ),
    aspect_hints = ["//:rustfmt_config"],
    crate_name = "hello",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = crate_deps(
        ["anyhow"],
        package_name = "rust/tests/fixtures/hello",
    ),
)

rust_binary(
    name = "hello",
    testonly = True,
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "rust/tests/fixtures/hello",
        normal = True,
    ),
    crate_name = "hello",
    crate_root = "src/main.rs",
    edition = "2021",
    deps = crate_deps(
        ["anyhow"],
        package_name = "rust/tests/fixtures/hello",
    ) + [":hello_lib"],
)

rustfmt_test(
    name = "hello_fmt_test",
    size = "small",
    targets = [
        ":hello_lib",
        ":hello",
    ],
)

rust_clippy_test(
    name = "hello_clippy_test",
    size = "small",
    targets = [
        ":hello_lib",
        ":hello",
    ],
)

# keep
rust_proc_macro(
    name = "hello_derive",
    srcs = ["src/derive.rs"],
    crate_name = "hello_derive",
    crate_root = "src/derive.rs",
)

# keep
rust_shared_library(
    name = "hello_cdylib",
    srcs = ["src/cdylib.rs"],
    crate_name = "hello_cdylib",
    crate_root = "src/cdylib.rs",
)

# keep
rust_static_library(
    name = "hello_staticlib",
    srcs = ["src/staticlib.rs"],
    crate_name = "hello_staticlib",
    crate_root = "src/staticlib.rs",
)

rustfmt_test(
    name = "hello_flavors_fmt_test",
    size = "small",
    targets = [
        ":hello_cdylib",
        ":hello_derive",
        ":hello_staticlib",
    ],
)

rust_clippy_test(
    name = "hello_flavors_clippy_test",
    size = "small",
    targets = [
        ":hello_cdylib",
        ":hello_derive",
        ":hello_staticlib",
    ],
)

rust_library(
    name = "edition_2015_lib",
    testonly = True,
    srcs = ["edition_2015.rs"],
    aspect_hints = ["//:rustfmt_config"],
    crate_name = "edition_2015",
    crate_root = "edition_2015.rs",
    edition = "2015",
)

rustfmt_test(
    name = "edition_fmt_test",
    size = "small",
    targets = [":edition_2015_lib"],
)

exports_files([
    "Cargo.toml",
    "Cargo.lock",
])

dx_wrapper_subject(
    name = "hello_lib_subject",
    testonly = True,
    clippy_test = ":hello_clippy_test",
    fmt_test = ":hello_fmt_test",
    upstream = ":hello_lib_upstream",
    wrapper = ":hello_lib",
)

dx_wrapper_subject(
    name = "hello_subject",
    testonly = True,
    clippy_test = ":hello_clippy_test",
    fmt_test = ":hello_fmt_test",
    upstream = ":hello_upstream",
    wrapper = ":hello",
)

dx_wrapper_subject(
    name = "hello_test_subject",
    testonly = True,
    clippy_test = ":hello_clippy_test",
    fmt_test = ":hello_fmt_test",
    upstream = ":hello_test_upstream",
    wrapper = ":hello_test",
)

dx_wrapper_subject(
    name = "hello_derive_subject",
    testonly = True,
    clippy_test = ":hello_flavors_clippy_test",
    fmt_test = ":hello_flavors_fmt_test",
    upstream = ":hello_derive_upstream",
    wrapper = ":hello_derive",
)

dx_wrapper_cc_subject(
    name = "hello_cdylib_subject",
    testonly = True,
    clippy_test = ":hello_flavors_clippy_test",
    fmt_test = ":hello_flavors_fmt_test",
    upstream = ":hello_cdylib_upstream",
    wrapper = ":hello_cdylib",
)

dx_wrapper_cc_subject(
    name = "hello_staticlib_subject",
    testonly = True,
    clippy_test = ":hello_flavors_clippy_test",
    fmt_test = ":hello_flavors_fmt_test",
    upstream = ":hello_staticlib_upstream",
    wrapper = ":hello_staticlib",
)

dx_wrapper_registry_tests(name = "wrapper_registry_tests")

dx_wrapper_conformance_tests(
    name = "wrapper_conformance_tests",
    subjects = [
        ":hello_lib_subject",
        ":hello_subject",
        ":hello_test_subject",
        ":hello_derive_subject",
        ":hello_cdylib_subject",
        ":hello_staticlib_subject",
    ],
)

rust_test(
    name = "hello_test",
    testonly = True,
    aliases = aliases(
        package_name = "rust/tests/fixtures/hello",
        normal = True,
        normal_dev = True,
    ),
    crate = ":hello_lib",
    deps = crate_deps(
        ["anyhow"],
        package_name = "rust/tests/fixtures/hello",
    ),
)

dx_hello_output_test(
    name = "hello_output_test",
    binary = ":hello",
    expected = "Hello, world!",
)

thin_compare_subject(
    name = "thin_rust_subject",
    kind = "rust_library",
    thin = ":hello_lib_upstream",
    wrapper = ":hello_lib",
)

thin_compare_rust_tests(name = "thin_rust_test")

archive_deploy(
    name = "release",
    app = ":hello",
)

# keep
rust_test(
    name = "release_verify",
    srcs = ["//deploy/rules:verify_test.rs"],
    data = [
        ":release_archive",
        ":release_checksum",
    ],
    env = {
        "DX_ARCHIVE_CHECKSUM": "$(rootpath :release_checksum)",
        "DX_ARCHIVE_MEMBER": "hello",
        "DX_ARCHIVE_TARBALL": "$(rootpath :release_archive)",
        "DX_VERIFY_MODE": "archive",
    },
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["//tools/testing:dx_testing"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    testonly = True,
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
