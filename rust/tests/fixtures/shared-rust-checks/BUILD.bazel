load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//rust/rules:defs.bzl", "rust_test", "rustfmt_test")

package(default_visibility = ["//:__subpackages__"])

exports_files(["check_lifecycle.sh"])

sh_test(
    name = "inspect_apk_test",
    srcs = ["inspect_apk.sh"],
    args = [
        "$(location //examples/shared-rust:tasks_apk_file)",
        "com.example.dxsharedtasks",
        "tasks_apk_bin",
        "arm64-v8a,x86_64",
        "$(location @android_ndk_toolchain//:llvm_readelf)",
        "31",
        "'DX Shared Tasks'",
        "$(location //examples/shared-rust:assets/board.txt)",
        "$(location //examples/shared-rust:assets/notes.txt)",
    ],
    data = [
        "@dx_android_sdk//:aapt",
        "@dx_android_sdk//:apksigner_jar",
        "@rules_java//toolchains:current_java_runtime",
        "//examples/shared-rust:assets/board.txt",
        "//examples/shared-rust:assets/notes.txt",
        "//examples/shared-rust:tasks_apk_file",
        "@android_ndk_toolchain//:llvm_readelf",
    ],
    env = {
        "DX_AAPT": "$(rootpath @dx_android_sdk//:aapt)",
        "DX_APKSIGNER_JAR": "$(rootpath @dx_android_sdk//:apksigner_jar)",
        "DX_JAVA": "$(JAVA_ROOTPATH)",
    },
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    toolchains = ["@rules_java//toolchains:current_java_runtime"],
)

