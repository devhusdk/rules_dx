sh_test(
    name = "lifecycle_check_test",
    srcs = ["check_lifecycle.sh"],
    args = ["$(location testdata/lifecycle_ok.log)"],
    data = ["testdata/lifecycle_ok.log"],
)

sh_test(
    name = "lifecycle_check_missing_destroy_test",
    srcs = ["check_lifecycle.sh"],
    args = [
        "$(location testdata/lifecycle_no_destroy.log)",
        "--expect-fail",
    ],
    data = ["testdata/lifecycle_no_destroy.log"],
)

rust_test(
    name = "consumer_browser_test",
    srcs = ["tests/consumer_browser_test.rs"],
    data = [
        "//tools/docs/site/browser:firefox",
        "//tools/docs/site/browser:firefox_tree",
        "@shared_consumer//:consumer_app",
        "@shared_consumer//:consumer_serve",
    ],
    env = {
        "DX_FIREFOX": "$(rootpath //tools/docs/site/browser:firefox)",
        "DX_SHARED_CONSUMER_SERVE": "$(rootpath @shared_consumer//:consumer_serve)",
    },
    tags = [
        "block-network",
        "no-coverage",
        "no-remote-exec",
        "resources:cpu:2",
        "resources:memory:2048",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//tools/docs/site/browser:dx_site_browser",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "consumer_native_test",
    srcs = ["tests/consumer_native_test.rs"],
    data = [
        "@shared_consumer//:consumer_probe",
        "@shared_consumer//:consumer_release",
    ],
    env = {
        "DX_SHARED_CONSUMER_PROBE": "$(rootpath @shared_consumer//:consumer_probe)",
        "DX_SHARED_CONSUMER_RELEASE": "$(rootpath @shared_consumer//:consumer_release)",
    },
    tags = ["block-network"],
    deps = ["//tools/testing:dx_testing"],
)

test_suite(
    name = "consumer_wasi_test",
    tests = [
        "@shared_consumer//:consumer_wasi_runtime_test",
        "@shared_consumer//:consumer_wasi_test",
    ],
)

rustfmt_test(
    name = "shared_rust_checks_fmt_test",
    targets = [":consumer_native_test"],
)

rustfmt_test(
    name = "shared_rust_checks_linux_fmt_test",
    targets = [":consumer_browser_test"],
