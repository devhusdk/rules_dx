load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_library", "rust_test", "rust_wasm_bindgen", "rust_wasm_bindgen_test", "rust_wasm_bindgen_toolchain", "rustfmt_test")
load("@rules_rust//rust:defs.bzl", upstream_rust_library = "rust_library")
load("//libs/starlark:failure_test.bzl", "failure_test")
load(":raw_transition.bzl", "raw_wasm_proxy")

# gazelle:resolve rust wasm_bindgen @rules_rust_wasm_bindgen//3rdparty:wasm_bindgen
# gazelle:resolve rust wasm_bindgen_test @rules_rust_wasm_bindgen//3rdparty:wasm_bindgen_test

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

rust_library(
    name = "wasm_hello_lib",
    srcs = ["src/lib.rs"],
    aspect_hints = ["//:rustfmt_config"],
    crate_name = "wasm_hello",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = ["@rules_rust_wasm_bindgen//3rdparty:wasm_bindgen"],
)

rust_test(
    name = "wasm_hello_test",
    crate = ":wasm_hello_lib",
)

rust_binary(
    name = "wasm_hello_bin",
    srcs = ["src/main.rs"],
    crate_name = "wasm_hello_bin",
    crate_root = "src/main.rs",
    edition = "2021",
    deps = [":wasm_hello_lib"],
)

rustfmt_test(
    name = "wasm_hello_fmt_test",
    size = "small",
    targets = [
        ":wasm_hello_bin",
        ":wasm_hello_lib",
    ],
)

rust_clippy_test(
    name = "wasm_hello_clippy_test",
    size = "small",
    targets = [":wasm_hello_lib"],
)

raw_wasm_proxy(
    name = "wasm_hello_raw",
    target = ":wasm_hello_bin",
    visibility = ["//visibility:public"],
)

rust_wasm_bindgen(
    name = "wasm_hello_bundler",
    wasm_file = ":wasm_hello_bin_upstream",
)

rust_wasm_bindgen(
    name = "wasm_hello_web",
    target = "web",
    visibility = ["//visibility:public"],
    wasm_file = ":wasm_hello_bin_upstream",
)

rust_wasm_bindgen(
    name = "wasm_hello_web_bare",
    bindgen_flags = [
        "--debug",
        "--no-typescript",
    ],
    target = "web",
    visibility = ["//visibility:public"],
    wasm_file = ":wasm_hello_bin_upstream",
)

rust_wasm_bindgen_test(
    name = "wasm_hello_browser_test",
    tags = ["manual"],
    wasm = ":wasm_hello_web",
)

rust_wasm_bindgen_toolchain(
    name = "wasm_hello_custom_toolchain",
    browser = "@firefox//:firefox",
    browser_type = "firefox",
    wasm_bindgen_cli = "@rules_rust_wasm_bindgen//3rdparty:wasm_bindgen_cli",
    wasm_bindgen_test = "@rules_rust_wasm_bindgen//3rdparty:wasm_bindgen_test",
    wasm_bindgen_test_runner = "@rules_rust_wasm_bindgen//3rdparty:wasm_bindgen_test_runner",
    webdriver = "@geckodriver//:geckodriver",
    webdriver_json = "@rules_rust_wasm_bindgen//:webdriver.json",
)

toolchain(
    name = "wasm_hello_custom_toolchain_def",
    toolchain = ":wasm_hello_custom_toolchain",
    toolchain_type = "@rules_rust_wasm_bindgen//:toolchain_type",
)

rust_wasm_bindgen_toolchain(
    name = "wasm_hello_partial_toolchain",
    browser_type = "firefox",
    tags = ["manual"],
)

failure_test(
    name = "wasm_hello_partial_toolchain_test",
    expected_failure_substring = "Not all webdriver attributes provided",
    target = ":wasm_hello_partial_toolchain",
)

filegroup(
    name = "wasm_hello_empty_files",
    tags = ["manual"],
)

rust_wasm_bindgen(
    name = "wasm_hello_missing_bindgen",
    tags = ["manual"],
    wasm_file = ":wasm_hello_empty_files",
)

failure_test(
    name = "wasm_hello_missing_output_test",
    expected_failure_substring = "mandatory providers",
    target = ":wasm_hello_missing_bindgen",
)

rust_wasm_bindgen_test(
    name = "wasm_hello_raw_browser_test",
    tags = ["manual"],
    wasm = ":wasm_hello_bin_upstream",
)

failure_test(
    name = "wasm_hello_raw_browser_rejected_test",
    expected_failure_substring = "No attribute 'wasm_file' in attr",
    target = ":wasm_hello_raw_browser_test",
)

rust_library(
    name = "wasm_stale_lib",
    srcs = ["src/stale_lib.rs"],
    crate_name = "wasm_stale",
    crate_root = "src/stale_lib.rs",
    edition = "2021",
    tags = ["manual"],
    deps = ["@crates//:wasm-bindgen-0.2.128"],
)

rust_binary(
    name = "wasm_stale_bin",
    srcs = ["src/stale_main.rs"],
    crate_name = "wasm_stale_bin",
    crate_root = "src/stale_main.rs",
    edition = "2021",
    tags = ["manual"],
    deps = [":wasm_stale_lib"],
)

rust_wasm_bindgen(
    name = "wasm_stale_bindgen",
    tags = ["manual"],
    wasm_file = ":wasm_stale_bin_upstream",
)

upstream_rust_library(
    name = "wasm_hello_rlib_subject",
    srcs = ["src/lib.rs"],
    crate_name = "wasm_hello_rlib",
    edition = "2021",
    tags = ["manual"],
    deps = ["@rules_rust_wasm_bindgen//3rdparty:wasm_bindgen"],
)

rust_wasm_bindgen(
    name = "wasm_hello_rlib_bindgen",
    tags = ["manual"],
    wasm_file = ":wasm_hello_rlib_subject",
)

failure_test(
    name = "wasm_hello_rlib_test",
    expected_failure_substring = "No attribute 'crate' in attr",
    target = ":wasm_hello_rlib_bindgen",
)

rust_test(
    name = "wasm_hello_bundle_test",
    srcs = ["src/bundle_check.rs"],
    data = [
        "@consumer_wasm_bindgen//:bundle_bare_js",
        "@consumer_wasm_bindgen//:bundle_bare_no_ts",
        "@consumer_wasm_bindgen//:bundle_raw",
        "@consumer_wasm_bindgen//:bundle_web_js",
        "@consumer_wasm_bindgen//:bundle_web_wasm",
    ],
    env = {
        "DX_WASM_BARE_JS": "$(rootpath @consumer_wasm_bindgen//:bundle_bare_js)",
        "DX_WASM_BOUND": "$(rootpath @consumer_wasm_bindgen//:bundle_web_wasm)",
        "DX_WASM_JS": "$(rootpath @consumer_wasm_bindgen//:bundle_web_js)",
        "DX_WASM_RAW": "$(rootpath @consumer_wasm_bindgen//:bundle_raw)",
    },
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "raw_transition.bzl",
        "repos.bzl",
    ],
    tags = ["corpus"],
)
