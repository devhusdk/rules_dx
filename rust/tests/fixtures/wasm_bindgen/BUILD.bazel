load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")
load("@rules_dx//rust/rules:wrapper_tests.bzl", "dx_browser_binary_tests", "dx_browser_cell_tests")
load("@rules_rust_wasm_bindgen//:defs.bzl", "rust_wasm_bindgen", "rust_wasm_bindgen_toolchain")
load("//javascript/rules:defs.bzl", "javascript_library", "javascript_test", "javascript_wasm_bindgen_library")
load("//libs/starlark:failure_test.bzl", "failure_test")
load("//typescript/rules:defs.bzl", "typescript_project")
load(":js_parity.bzl", "synthetic_bindgen", "wasm_js_parity_subject", "wasm_js_parity_tests")
load(":raw_transition.bzl", "raw_wasm_proxy")

# gazelle:dx_ignore_import typescript wasm_nodejs_types
# gazelle:resolve rust wasm_bindgen @rules_rust_wasm_bindgen//3rdparty:wasm_bindgen
# gazelle:resolve rust wasm_bindgen_test @rules_rust_wasm_bindgen//3rdparty:wasm_bindgen_test

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

# keep
rust_library(
    name = "wasm_hello_lib",
    srcs = ["src/lib.rs"],
    crate_name = "wasm_hello",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = ["@rules_rust_wasm_bindgen//3rdparty:wasm_bindgen"],
)

# keep
rust_test(
    name = "wasm_hello_test",
    crate = ":wasm_hello_lib",
)

# keep
rust_binary(
    name = "wasm_hello_bin",
    srcs = ["src/main.rs"],
    crate_name = "wasm_hello_bin",
    crate_root = "src/main.rs",
    edition = "2021",
    deps = [":wasm_hello_lib"],
)

rustfmt_test(
    name = "wasm_hello_fmt_test",
    targets = [
        ":wasm_hello_bin",
        ":wasm_hello_lib",
    ],
)

rust_clippy_test(
    name = "wasm_hello_clippy_test",
    targets = [":wasm_hello_lib"],
)

raw_wasm_proxy(
    name = "wasm_hello_raw",
    target = ":wasm_hello_bin",
    visibility = ["//visibility:public"],
)

rust_wasm_bindgen(
    name = "wasm_hello_bundler",
    wasm_file = ":wasm_hello_web_wasm_input",
)

# keep
rust_binary(
    name = "wasm_hello_web",
    srcs = ["src/main.rs"],
    crate_name = "wasm_hello_bin",
    crate_root = "src/main.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    wasm = "browser",
    deps = [":wasm_hello_lib"],
)

dx_browser_binary_tests(
    name = "wasm_hello_web_outputs_test",
    target = ":wasm_hello_web",
)

rust_wasm_bindgen(
    name = "wasm_hello_web_bare",
    bindgen_flags = [
        "--debug",
        "--no-typescript",
    ],
    target = "web",
    visibility = ["//visibility:public"],
    wasm_file = ":wasm_hello_web_wasm_input",
)

rust_wasm_bindgen(
    name = "wasm_hello_nodejs",
    target = "nodejs",
    visibility = ["//visibility:public"],
    wasm_file = ":wasm_hello_web_wasm_input",
)

# keep
javascript_library(
    name = "wasm_helper_lib",
    srcs = ["helper.js"],
)

javascript_wasm_bindgen_library(
    name = "wasm_hello_web_js",
    bindgen = ":wasm_hello_web",
    visibility = ["//visibility:public"],
    deps = [":wasm_helper_lib"],
)

javascript_wasm_bindgen_library(
    name = "wasm_hello_nodejs_js",
    bindgen = ":wasm_hello_nodejs",
    visibility = ["//visibility:public"],
)

javascript_test(
    name = "wasm_node_test",
    srcs = ["wasm_node_test.js"],
    data = [":wasm_hello_web_js"],
    entry_point = "wasm_node_test.js",
    package_json = "//:package_json",
    runner = "node",
)

genrule(
    name = "wasm_nodejs_types",
    srcs = [":wasm_hello_nodejs"],
    outs = ["wasm_nodejs_types.d.ts"],
    cmd = """
        for f in $(locations :wasm_hello_nodejs); do
          case "$$f" in
            *.d.ts) cp "$$f" $@ ;;
          esac
        done
    """,
)

typescript_project(
    name = "wasm_ts_consumer",
    testonly = True,
    srcs = ["wasm_ts_consumer.ts"],
    declaration = True,
    declaration_srcs = [":wasm_nodejs_types"],
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
)

rust_test(
    name = "wasm_hello_browser_test",
    crate = ":wasm_hello_web",
    tags = ["manual"],
    wasm = "browser",
)

dx_browser_cell_tests(
    name = "wasm_hello_browser_cell_test",
    target = ":wasm_hello_browser_test",
)

rust_wasm_bindgen_toolchain(
    name = "wasm_hello_custom_toolchain",
    browser = "@firefox//:firefox",
    browser_type = "firefox",
    wasm_bindgen_cli = "@rules_rust_wasm_bindgen//3rdparty:wasm_bindgen_cli",
    wasm_bindgen_test = "@rules_rust_wasm_bindgen//3rdparty:wasm_bindgen_test",
    wasm_bindgen_test_runner = "@rules_rust_wasm_bindgen//3rdparty:wasm_bindgen_test_runner",
    webdriver = "@geckodriver//:geckodriver",
    webdriver_json = "@rules_rust_wasm_bindgen//:webdriver.json",
)

toolchain(
    name = "wasm_hello_custom_toolchain_def",
    toolchain = ":wasm_hello_custom_toolchain",
    toolchain_type = "@rules_rust_wasm_bindgen//:toolchain_type",
)

rust_wasm_bindgen_toolchain(
    name = "wasm_hello_partial_toolchain",
    browser_type = "firefox",
    tags = ["manual"],
)

failure_test(
    name = "wasm_hello_partial_toolchain_test",
    expected_failure_substring = "Not all webdriver attributes provided",
    target = ":wasm_hello_partial_toolchain",
)

rust_test(
    name = "wasm_hello_raw_browser_test",
    crate = ":wasm_hello_bin",
    tags = ["manual"],
    wasm = "browser",
)

failure_test(
    name = "wasm_hello_raw_browser_rejected_test",
    expected_failure_substring = "No attribute 'wasm_file' in attr",
    target = ":wasm_hello_raw_browser_test",
)

javascript_wasm_bindgen_library(
    name = "wasm_hello_bare_js",
    bindgen = ":wasm_hello_web_bare",
    tags = ["manual"],
)

failure_test(
    name = "wasm_hello_bare_declarations_test",
    expected_failure_substring = "produces no TypeScript declarations",
    target = ":wasm_hello_bare_js",
)

javascript_wasm_bindgen_library(
    name = "wasm_hello_raw_js",
    bindgen = ":wasm_hello_raw",
    tags = ["manual"],
)

failure_test(
    name = "wasm_hello_raw_shape_test",
    expected_failure_substring = "requires bindgen to provide RustWasmBindgenInfo",
    target = ":wasm_hello_raw_js",
)

synthetic_bindgen(
    name = "wasm_missing_wasm",
    flavor = "missing_wasm",
    tags = ["manual"],
)

javascript_wasm_bindgen_library(
    name = "wasm_missing_wasm_js",
    bindgen = ":wasm_missing_wasm",
    tags = ["manual"],
)

failure_test(
    name = "wasm_missing_wasm_test",
    expected_failure_substring = "produces no Wasm output",
    target = ":wasm_missing_wasm_js",
)

synthetic_bindgen(
    name = "wasm_missing_snippets",
    flavor = "missing_snippets",
    tags = ["manual"],
)

javascript_wasm_bindgen_library(
    name = "wasm_missing_snippets_js",
    bindgen = ":wasm_missing_snippets",
    tags = ["manual"],
)

failure_test(
    name = "wasm_missing_snippets_test",
    expected_failure_substring = "produces no snippets directory",
    target = ":wasm_missing_snippets_js",
)

# keep
rust_library(
    name = "wasm_stale_lib",
    srcs = ["src/stale_lib.rs"],
    crate_name = "wasm_stale",
    crate_root = "src/stale_lib.rs",
    edition = "2021",
    tags = ["manual"],
    deps = ["@crates//:wasm-bindgen-0.2.130"],
)

# keep
rust_binary(
    name = "wasm_stale_bin",
    srcs = ["src/stale_main.rs"],
    crate_name = "wasm_stale_bin",
    crate_root = "src/stale_main.rs",
    edition = "2021",
    tags = ["manual"],
    wasm = "browser",
    deps = [":wasm_stale_lib"],
)

# keep
rust_test(
    name = "wasm_hello_bundle_test",
    srcs = ["src/bundle_check.rs"],
    data = [
        "@consumer_wasm_bindgen//:bundle_bare_js",
        "@consumer_wasm_bindgen//:bundle_bare_no_ts",
        "@consumer_wasm_bindgen//:bundle_raw",
        "@consumer_wasm_bindgen//:bundle_web_js",
        "@consumer_wasm_bindgen//:bundle_web_wasm",
    ],
    env = {
        "DX_WASM_BARE_JS": "$(rootpath @consumer_wasm_bindgen//:bundle_bare_js)",
        "DX_WASM_BOUND": "$(rootpath @consumer_wasm_bindgen//:bundle_web_wasm)",
        "DX_WASM_JS": "$(rootpath @consumer_wasm_bindgen//:bundle_web_js)",
        "DX_WASM_RAW": "$(rootpath @consumer_wasm_bindgen//:bundle_raw)",
    },
)

wasm_js_parity_subject(
    name = "web_parity",
    adapter = ":wasm_hello_web_js",
    expected_transitives = ["helper.js"],
    upstream = ":wasm_hello_web",
)

wasm_js_parity_subject(
    name = "nodejs_parity",
    adapter = ":wasm_hello_nodejs_js",
    upstream = ":wasm_hello_nodejs",
)

wasm_js_parity_subject(
    name = "consumer_parity",
    adapter = "@consumer_wasm_bindgen//:selected_web_js",
    upstream = ":wasm_hello_web",
)

wasm_js_parity_tests(
    name = "wasm_js_parity_test",
    subjects = [
        "consumer_parity",
        "nodejs_parity",
        "web_parity",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "js_parity.bzl",
        "raw_transition.bzl",
        "repos.bzl",
    ],
    tags = ["corpus"],
)

rustfmt_test(
    name = "wasm_bindgen_fmt_test",
    targets = [
        ":wasm_hello_bundle_test",
        ":wasm_hello_browser_test",
        ":wasm_hello_web",
        ":wasm_stale_bin",
        ":wasm_stale_lib",
    ],
)
