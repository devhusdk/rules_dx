{
  "$schema": "../core/modules/lang.schema.json",
  "name": "scala",
  "title": "Scala",
  "family": "core",
  "ecosystems": [
    "maven"
  ],
  "depcheck": "scala",
  "semver": false,
  "manifests": [
    "MODULE.bazel"
  ],
  "lockfiles": [
    "maven_install.json"
  ],
  "tools": [
    "scalac",
    "scalafix",
    "scalafmt"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_arm64",
    "windows_x86_64"
  ],
  "pins": [],
  "entry_points": [
    "scala_library",
    "scala_binary",
    "scala_test",
    "scala_fuzz_test",
    "scala_bench"
  ],
  "quality": {
    "bzl": "quality:families/jvm.bzl",
    "file_extensions": [
      ".sc",
      ".scala"
    ],
    "aspects": {
      "format": [
        "real_scala_format_aspect"
      ],
      "lint": [
        "real_scala_lint_aspect"
      ]
    }
  },
  "docs": {
    "bzl": "tools/docs/jvm:aspect.bzl",
    "file_extensions": [
      ".scala"
    ],
    "aspects": []
  }
}
