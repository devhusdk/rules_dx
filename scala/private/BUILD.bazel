load("//core:conformance.bzl", "dx_wrapper_contract_tests")
load("//core:defs.bzl", "expect_equal")
load("//quality:fixtures.bzl", "real_source_target")
load(":validate.bzl", "scala_scalacopts_with_warnings_as_errors")

package(default_visibility = ["//visibility:public"])

_ON = {"warnings_as_errors": True}

exports_files([
    "defs.bzl",
    "validate.bzl",
])

dx_wrapper_contract_tests(
    name = "wrapper_contract_tests",
    extra_checks = [
        expect_equal(
            "empty gains fatal warnings",
            scala_scalacopts_with_warnings_as_errors(_ON)["scalacopts"],
            ["-Xfatal-warnings"],
        ),
        expect_equal(
            "existing flag is kept without duplication",
            scala_scalacopts_with_warnings_as_errors(dict(
                _ON,
                scalacopts = ["-Xfatal-warnings"],
            ))["scalacopts"],
            ["-Xfatal-warnings"],
        ),
        expect_equal(
            "other flags are kept",
            scala_scalacopts_with_warnings_as_errors(dict(
                _ON,
                scalacopts = ["-deprecation"],
            ))["scalacopts"],
            [
                "-deprecation",
                "-Xfatal-warnings",
            ],
        ),
        expect_equal(
            "turned off adds no flag",
            scala_scalacopts_with_warnings_as_errors({"warnings_as_errors": False})["scalacopts"],
            [],
        ),
        expect_equal(
            "other kwargs survive",
            scala_scalacopts_with_warnings_as_errors(dict(
                _ON,
                deps = [":hello_lib"],
            ))["deps"],
            [":hello_lib"],
        ),
    ],
    file_classes = [
        "scala",
        "java",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "validate.bzl",
    ],
    tags = ["corpus"],
)
