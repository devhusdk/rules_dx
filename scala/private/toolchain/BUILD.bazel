load("@rules_scala//scala:scala_toolchain.bzl", "scala_toolchain")
load("//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

scala_toolchain(
    name = "semanticdb_impl",
    dependency_tracking_method = "ast",
    enable_semanticdb = True,
    scalacopts = [
        "-Wunused:imports,privates,locals,implicits",
        "-Wconf:cat=unused:info",
    ],
    semanticdb_bundle_in_jar = True,
    unused_dependency_checker_mode = "warn",
    use_argument_file_in_runner = True,
)

toolchain(
    name = "semanticdb",
    target_settings = ["@rules_scala_config//:scala_version_2_13_18"],
    toolchain = ":semanticdb_impl",
    toolchain_type = "@rules_scala//scala:toolchain_type",
)

scala_toolchain(
    name = "semanticdb_scala3_impl",
    enable_semanticdb = True,
    scalacopts = ["-Wunused:all"],
    semanticdb_bundle_in_jar = True,
    use_argument_file_in_runner = True,
)

toolchain(
    name = "semanticdb_scala3",
    target_settings = ["@rules_scala_config//:scala_version_3_3_9"],
    toolchain = ":semanticdb_scala3_impl",
    toolchain_type = "@rules_scala//scala:toolchain_type",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
