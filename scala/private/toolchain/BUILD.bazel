load("@rules_scala//scala:scala_toolchain.bzl", "scala_toolchain")
load("//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

exports_files(["config_extension.bzl"])

scala_toolchain(
    name = "semanticdb_impl",
    dependency_mode = "transitive",
    dependency_tracking_method = "ast",
    enable_semanticdb = True,
    # Scalac writes the compile time into the stats file, so it differs on every build.
    enable_stats_file = False,
    scalacopts = [
        "-Wunused:imports,privates,locals,implicits",
        "-Wconf:cat=unused:info",
        # semanticdb-scalac sorts occurrences by start position only, so two that
        # start together keep hash-map order. Without text the map keys hash the
        # source's absolute path, and the order changes with the checkout; with
        # text they hash its relative path and contents.
        "-P:semanticdb:text:on",
    ],
    semanticdb_bundle_in_jar = True,
    strict_deps_mode = "off",
    unused_dependency_checker_mode = "warn",
    use_argument_file_in_runner = True,
    visibility = ["@dx_scala_toolchains//:__pkg__"],
)

scala_toolchain(
    name = "semanticdb_scala3_impl",
    enable_semanticdb = True,
    # Scalac writes the compile time into the stats file, so it differs on every build.
    enable_stats_file = False,
    scalacopts = ["-Wunused:all"],
    semanticdb_bundle_in_jar = True,
    use_argument_file_in_runner = True,
    visibility = ["@dx_scala_toolchains//:__pkg__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "config_extension.bzl",
        "deps_extension.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
