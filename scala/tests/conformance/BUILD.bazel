load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//scala:defs.bzl", "scala_binary", "scala_library", "scala_test")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "subject_compatible_with")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

scala_library(
    name = "conformance",
    testonly = True,
    srcs = ["Greet.scala"],
)

scala_binary(
    name = "hello",
    srcs = ["Main.scala"],
    main_class = "conformance.Main",
    deps = [":conformance"],
)

scala_test(
    name = "pass_subject_test",
    size = "small",
    srcs = ["PassTest.scala"],
    main_class = "conformance.PassTest",
    target_compatible_with = subject_compatible_with(),
    deps = [":conformance"],
)

scala_test(
    name = "fail_subject_test",
    size = "small",
    srcs = ["FailTest.scala"],
    main_class = "conformance.FailTest",
    target_compatible_with = subject_compatible_with(),
    deps = [":conformance"],
)

scala_binary(
    name = "runfiles_hello",
    srcs = ["RunfilesMain.scala"],
    data = ["data.txt"],
    main_class = "conformance.RunfilesMain",
    deps = ["@rules_java//java/runfiles"],
)

dx_conformance_suite(
    name = "",
    size = "small",
    binary = ":hello",
    covered_source = "Greet.scala",
    expected = "hello world",
    failing_case = "failingCase",
    failing_pattern = "AssertionError: {case}",
    failing_test = ":fail_subject_test",
    lang = "scala",
    passing_test = ":pass_subject_test",
    runfiles = {
        "binary": ":runfiles_hello",
        "data": "data.txt",
        "expected": "hello runfiles",
    },
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
