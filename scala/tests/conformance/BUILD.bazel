load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//scala:defs.bzl", "scala_binary", "scala_library", "scala_test")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "subject_compatible_with")

# The dirty fixtures stay in their own manual targets; gazelle would merge them
# into the clean library.
# gazelle:exclude FormatDirty.scala
# gazelle:exclude LintDirty.scala

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

scala_library(
    name = "conformance",
    testonly = True,
    srcs = ["Greet.scala"],
)

# keep
scala_library(
    name = "format_dirty",
    srcs = ["FormatDirty.scala"],
    tags = ["manual"],
)

# keep
scala_library(
    name = "lint_dirty",
    srcs = ["LintDirty.scala"],
    tags = ["manual"],
)

scala_binary(
    name = "hello",
    srcs = ["Main.scala"],
    main_class = "conformance.Main",
    deps = [":conformance"],
)

scala_test(
    name = "pass_subject_test",
    size = "small",
    srcs = ["PassTest.scala"],
    main_class = "conformance.PassTest",
    target_compatible_with = subject_compatible_with(),
    deps = [":conformance"],
)

scala_test(
    name = "fail_subject_test",
    size = "small",
    srcs = ["FailTest.scala"],
    main_class = "conformance.FailTest",
    target_compatible_with = subject_compatible_with(),
    deps = [":conformance"],
)

scala_binary(
    name = "runfiles_hello",
    srcs = ["RunfilesMain.scala"],
    data = ["data.txt"],
    main_class = "conformance.RunfilesMain",
    deps = ["@rules_java//java/runfiles"],
)

scala_binary(
    name = "lock_hello",
    srcs = ["LockMain.scala"],
    main_class = "conformance.LockMain",
    deps = ["@maven//:junit_junit"],
)

# Fails analysis when scala_binary stops exposing <name>_deploy.jar.
filegroup(
    name = "hello_deploy_jar",
    srcs = [":hello_deploy.jar"],
)

dx_conformance_suite(
    name = "",
    size = "small",
    binary = ":hello",
    covered_source = "Greet.scala",
    cross_runfile = "java",
    expected = "hello world",
    failing_case = "failingCase",
    failing_pattern = "AssertionError: {case}",
    failing_test = ":fail_subject_test",
    lang = "scala",
    lock = {
        "binary": ":lock_hello",
        "ecosystem": "scala",
        "expected": "hello lock",
        "lockfile": "//third_party/jvm:maven_install.json",
        "manifest": "jvm_deps.toml",
        "package": "junit:junit",
        "stale": "maven_install.stale.json",
    },
    passing_test = ":pass_subject_test",
    quality = {
        "clean": ":conformance",
        "format_dirty": ":format_dirty",
        "format_source": "FormatDirty.scala",
        "lint_dirty": ":lint_dirty",
        "lint_line": 4,
        "lint_rule": "DisableSyntax.var",
        "lint_source": "LintDirty.scala",
    },
    runfiles = {
        "binary": ":runfiles_hello",
        "data": "data.txt",
        "expected": "hello runfiles",
    },
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    testonly = True,
    tags = ["corpus"],
    toml_srcs = ["jvm_deps.toml"],
)
