load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//scala:defs.bzl", "scala_fuzz_test", "scala_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

scala_fuzz_test(
    name = "parse_fuzz",
    srcs = ["ParseFuzz.scala"],
)

sh_test(
    name = "parse_fuzz_run_test",
    timeout = "short",
    srcs = ["//java/tests/fixtures/fuzz:run_test.sh"],
    args = [
        "$(rlocationpath @rules_dx//cli/fuzz_run:fuzz_run)",
        "$(rootpath :parse_fuzz)",
        "tests.fixtures.fuzz.ParseFuzz",
    ],
    data = [
        ":parse_fuzz",
        "@rules_dx//cli/fuzz_run",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

scala_library(
    name = "fuzz",
    testonly = True,
    srcs = ["ParseFuzz.scala"],
)
