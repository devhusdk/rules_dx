load("//quality:fixtures.bzl", "real_source_target")
load("//scala/rules:defs.bzl", "scala_binary", "scala_library", "scala_test")
load("//tools/testing:hello_output.bzl", "dx_hello_output_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

scala_library(
    name = "hello_lib",
    srcs = ["Hello.scala"],
    aspect_hints = ["//:scalafmt_config"],
)

scala_binary(
    name = "hello",
    srcs = ["Main.scala"],
    aspect_hints = ["//:scalafmt_config"],
    main_class = "hello.Main",
    deps = [":hello_lib"],
)

scala_test(
    name = "hello_test",
    srcs = ["HelloTest.scala"],
    aspect_hints = ["//:scalafmt_config"],
    deps = [
        ":hello_lib",
        "@maven//:org_scalactic_scalactic_2_13",
        "@maven//:org_scalatest_scalatest_2_13",
        "@maven//:org_scalatest_scalatest_flatspec_2_13",
    ],
)

dx_hello_output_test(
    name = "hello_output_test",
    binary = ":hello",
    expected = "hello world",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
