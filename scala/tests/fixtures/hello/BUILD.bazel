# gazelle:ignore
load("@rules_dx//java/private:coverage_tests.bzl", "jvm_coverage_env_test")
load("@rules_dx//core/tests:direct_sources.bzl", "dx_direct_sources_test")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//scala:defs.bzl", "scala_binary", "scala_library", "scala_test")
load("@rules_dx//tools/testing:hello_output.bzl", "dx_hello_output_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

scala_library(
    name = "hello_lib",
    srcs = ["Hello.scala"],
)

scala_library(
    name = "mixed_lib",
    srcs = [
        "Greeter.java",
        "Mixed.scala",
    ],
)

dx_direct_sources_test(
    name = "mixed_sources_test",
    expected = {
        "java": ["Greeter.java"],
        "scala": ["Mixed.scala"],
    },
    target_under_test = ":mixed_lib",
)

scala_binary(
    name = "hello",
    srcs = ["Main.scala"],
    main_class = "hello.Main",
    deps = [":hello_lib"],
)

scala_test(
    name = "hello_test",
    srcs = ["HelloTest.scala"],
    deps = [
        ":hello_lib",
        "@maven//:org_scalactic_scalactic_2_13",
        "@maven//:org_scalatest_scalatest_flatspec_2_13",
    ],
)

jvm_coverage_env_test(
    name = "hello_test_coverage_env_test",
    main_class = "io.bazel.rulesscala.scala_test.Runner",
    target = ":hello_test",
)

dx_hello_output_test(
    name = "hello_output_test",
    binary = ":hello",
    expected = "hello world",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["@rules_dx//tools/docs/support_matrix:__pkg__"],
)
