load("//javascript/rules:defs.bzl", "javascript_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//svelte/rules:defs.bzl", "svelte_check")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

svelte_check(
    name = "check",
    srcs = glob(["src/**"]),
    node_modules = "//:node_modules",
    package_json = "package.json",
    tags = ["manual"],
    tsconfig = "tsconfig.json",
)

javascript_test(
    name = "errors_test",
    srcs = ["errors.test.js"],
    data = [":check.svelte_check.txt"],
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
    package_json = "//:package_json",
)

_VITE = [
    "//:node_modules/@sveltejs/vite-plugin-svelte",
    "//:node_modules/svelte",
    "//:node_modules/vite",
]

javascript_test(
    name = "build_errors_test",
    srcs = ["build_errors.test.js"],
    data = glob(["build_fail/**"]) + ["//svelte/rules:svelte_tool_entry"] + _VITE,
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
    package_json = "//:package_json",
)

javascript_test(
    name = "render_ssr_test",
    srcs = ["render_ssr.test.js"],
    data = ["//svelte/tests/app_errors/throwing:site_ssr"],
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
    package_json = "//:package_json",
)

javascript_test(
    name = "render_client_test",
    srcs = ["render_client.test.js"],
    data = [
        "//:node_modules/jest-environment-jsdom",
        "//svelte/tests/app_errors/throwing:site",
    ],
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
    package_json = "//:package_json",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
