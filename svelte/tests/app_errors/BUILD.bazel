load("//javascript/rules:defs.bzl", "javascript_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//svelte/rules:defs.bzl", "svelte_check")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

svelte_check(
    name = "check",
    srcs = glob(["src/**"]),
    node_modules = "//:node_modules",
    package_json = "package.json",
    tags = ["manual"],
    tsconfig = "tsconfig.json",
)

javascript_test(
    name = "errors_test",
    srcs = ["errors.test.js"],
    aspect_hints = ["//:biome_config"],
    data = [":check.svelte_check.txt"],
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
    package_json = "//:package_json",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
