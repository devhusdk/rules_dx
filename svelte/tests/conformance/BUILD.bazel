# gazelle:ignore
load("//svelte:defs.bzl", "svelte_library", "svelte_test")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "subject_compatible_with")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

svelte_library(
    name = "conformance",
    srcs = ["Hello.svelte"],
)

svelte_test(
    name = "pass_subject_test",
    size = "small",
    srcs = ["pass.test.js"],
    data = [
        ":Hello.svelte",
        ":helper.js",
    ],
    node_modules = "//:node_modules",
    package_json = "//:package_json",
    target_compatible_with = subject_compatible_with(),
)

svelte_test(
    name = "fail_subject_test",
    size = "small",
    srcs = ["fail.test.js"],
    data = [
        ":Hello.svelte",
        ":helper.js",
    ],
    node_modules = "//:node_modules",
    package_json = "//:package_json",
    target_compatible_with = subject_compatible_with(),
)

svelte_test(
    name = "wrapper_test",
    size = "small",
    srcs = ["pass.test.js"],
    data = [
        ":Hello.svelte",
        ":helper.js",
    ],
    node_modules = "//:node_modules",
    package_json = "//:package_json",
)

dx_conformance_suite(
    name = "",
    binary = ":conformance",
    covered_source = "helper.js",
    expected = "",
    failing_case = "failing case",
    failing_pattern = "Hello.svelte › {case}",
    failing_test = ":fail_subject_test",
    lang = "svelte",
    not_applicable = {
        "build_test": "svelte has no binary rule",
        "cross_test": "svelte has no binary rule",
        "lock_test": "svelte has no binary rule",
        "runfiles_test": "svelte has no binary rule",
    },
    passing_test = ":pass_subject_test",
    size = "small",
)
