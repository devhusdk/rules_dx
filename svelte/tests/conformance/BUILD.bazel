# gazelle:ignore
# Why: gazelle adds plain javascript_test targets for pass/fail tests the suite runs itself.
load("//svelte:defs.bzl", "svelte_library", "svelte_test")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "dx_coverage_test", "subject_compatible_with")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

svelte_library(
    name = "conformance",
    srcs = ["Hello.svelte"],
    aspect_hints = ["//core/quality/testdata:eslint_cfg_svelte"],
)

svelte_library(
    name = "lint_dirty",
    srcs = ["lint_dirty.svelte"],
    aspect_hints = ["//core/quality/testdata:eslint_cfg_svelte"],
)

svelte_library(
    name = "format_dirty",
    srcs = ["format_dirty.svelte"],
    aspect_hints = ["//core/quality/testdata:eslint_cfg_svelte"],
)

svelte_test(
    name = "pass_subject_test",
    size = "small",
    srcs = ["pass.test.js"],
    data = [
        ":Hello.svelte",
        ":helper.js",
    ],
    node_modules = "//:node_modules",
    package_json = "//:package_json",
    target_compatible_with = subject_compatible_with(),
)

svelte_test(
    name = "fail_subject_test",
    size = "small",
    srcs = ["fail.test.js"],
    data = [
        ":Hello.svelte",
        ":helper.js",
    ],
    node_modules = "//:node_modules",
    package_json = "//:package_json",
    target_compatible_with = subject_compatible_with(),
)

svelte_test(
    name = "wrapper_test",
    size = "small",
    srcs = ["pass.test.js"],
    data = [
        ":Hello.svelte",
        ":helper.js",
    ],
    node_modules = "//:node_modules",
    package_json = "//:package_json",
)

dx_coverage_test(
    name = "component_coverage_test",
    size = "small",
    covered_source = "conformance/Hello.svelte",
    subject = ":wrapper_test",
)

dx_conformance_suite(
    name = "",
    binary = ":conformance",
    covered_source = "helper.js",
    expected = "",
    failing_case = "failing case",
    failing_pattern = "Hello.svelte › {case}",
    failing_test = ":fail_subject_test",
    lang = "svelte",
    not_applicable = {
        "build_test": "svelte has no binary rule",
        "cross_test": "svelte has no binary rule",
        "lock_test": "svelte has no binary rule",
        "runfiles_test": "svelte has no binary rule",
    },
    passing_test = ":pass_subject_test",
    quality = {
        "clean": ":conformance",
        "format_dirty": ":format_dirty",
        "format_source": "format_dirty.svelte",
        "lint_dirty": ":lint_dirty",
        "lint_line": 2,
        "lint_rule": "no-unused-vars",
        "lint_source": "lint_dirty.svelte",
    },
    size = "small",
)
