load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_test")
load("//tools/testing:nested_bazel.bzl", "CONSUMER_MAVEN_DATA", "CONSUMER_MAVEN_ENV", "NESTED_BAZEL_CI_NETWORK_TAGS", "NESTED_BAZEL_DATA", "NESTED_BAZEL_ENV_INHERIT", "NESTED_BAZEL_NETWORK_ENV")

# keep
rust_test(
    name = "svelte_consumer_smoke_test",
    timeout = "moderate",
    srcs = ["app_consumer_test.rs"],
    crate_root = "app_consumer_test.rs",
    data = [
        "app_consumer_test.rs",
        "//:MODULE.bazel.lock",
        "//cli/cli:dx",
        "//svelte/tests/fixtures/svelte-app:consumer_srcs",
    ] + NESTED_BAZEL_DATA + CONSUMER_MAVEN_DATA,
    env = {
        "DX_BIN": "$(rootpath //cli/cli:dx)",
        "RUST_TEST_THREADS": "1",
    } | NESTED_BAZEL_NETWORK_ENV | CONSUMER_MAVEN_ENV,
    env_inherit = NESTED_BAZEL_ENV_INHERIT,
    tags = NESTED_BAZEL_CI_NETWORK_TAGS,
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [
        "//tools/testing/nested:dx_nested",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//tools/ci:__pkg__"],
)

exports_files(
    ["app_consumer_test.rs"],
    visibility = ["//quality/tests:__pkg__"],
)
