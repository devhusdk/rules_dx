load("//javascript/rules:defs.bzl", "javascript_library", "javascript_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//svelte/rules:defs.bzl", "svelte_library")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

svelte_library(
    name = "hello_lib",
    srcs = ["Hello.svelte"],
)

javascript_library(
    name = "helper_lib",
    srcs = ["helper.js"],
    aspect_hints = ["//:biome_config"],
)

javascript_test(
    name = "hello_test",
    srcs = ["Hello.test.js"],
    aspect_hints = ["//:biome_config"],
    data = [
        ":Hello.svelte",
        ":helper_lib",
        "//:node_modules/svelte",
    ],
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
