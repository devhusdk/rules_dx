load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_dx//javascript/rules:defs.bzl", "javascript_library", "javascript_test")
load("@rules_dx//quality:native_config.bzl", "biome_config")
load("@rules_dx//svelte/rules:defs.bzl", "svelte_build", "svelte_check", "svelte_library")

# gazelle:exclude src

package(default_visibility = ["//visibility:public"])

exports_files(["package.json"])

biome_config(
    name = "biome_config",
    src = "biome.json",
)

npm_link_all_packages(name = "node_modules")

# keep
javascript_library(
    name = "vite_config",
    aspect_hints = [":biome_config"],
    srcs = ["vite.config.mjs"],
)

# keep
svelte_library(
    name = "components",
    aspect_hints = [":biome_config"],
    srcs = glob(["src/**/*.svelte"]),
)

# keep
svelte_build(
    name = "site",
    aspect_hints = [":biome_config"],
    srcs = glob(["src/**"]) + ["index.html"],
    config = "vite.config.mjs",
    node_modules = ":node_modules",
    package_json = "package.json",
    public = glob(["public/**"]),
    ssr_entry = "src/entry-server.ts",
    deps = [":node_modules/clsx"],
)

# keep
svelte_check(
    name = "check",
    aspect_hints = [":biome_config"],
    srcs = glob(["src/**"]),
    node_modules = ":node_modules",
    package_json = "package.json",
    tsconfig = "tsconfig.json",
    deps = [":node_modules/clsx"],
)

# keep
javascript_test(
    name = "site_ssr_test",
    aspect_hints = [":biome_config"],
    srcs = ["site_ssr.test.js"],
    data = [
        ":node_modules/clsx",
        ":node_modules/svelte",
        ":site_ssr",
    ],
    node_modules = ":node_modules",
    node_options = ["--experimental-vm-modules"],
    package_json = "package.json",
)

# keep
javascript_test(
    name = "site_client_test",
    aspect_hints = [":biome_config"],
    srcs = ["site_client.test.js"],
    data = [
        ":node_modules/jest-environment-jsdom",
        ":site",
    ],
    node_modules = ":node_modules",
    node_options = ["--experimental-vm-modules"],
    package_json = "package.json",
)
