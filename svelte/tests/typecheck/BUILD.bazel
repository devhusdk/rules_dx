load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("//javascript/rules:defs.bzl", "javascript_library")
load("//svelte/rules:defs.bzl", "svelte_library")
load("//quality:tsc_report.bzl", "tsc_report")

package(
    default_testonly = True,
    default_visibility = ["//visibility:private"],
)

javascript_library(
    name = "lib",
    srcs = ["lib.js"],
)

svelte_library(
    name = "bad",
    srcs = ["bad.svelte"],
    deps = [":lib", "//:node_modules/svelte"],
)

svelte_library(
    name = "broken",
    srcs = ["broken.svelte"],
    deps = ["//:node_modules/svelte"],
)

svelte_library(
    name = "clean",
    srcs = ["clean.svelte"],
    deps = [":lib", "//:node_modules/svelte"],
)

[
    tsc_report(
        name = "%s_%s_report" % (case, kind),
        kind = kind,
        target = ":" + case,
    )
    for case in ["bad", "broken", "clean"]
    for kind in ["stdout", "exit"]
]

[
    diff_test(
        name = "%s_%s_test" % (case, kind),
        file1 = "%s.%s.expected" % (case, kind),
        file2 = ":%s_%s_report" % (case, kind),
        target_compatible_with = select({
            "@platforms//os:windows": ["@platforms//:incompatible"] if kind == "stdout" else [],
            "//conditions:default": [],
        }),
    )
    for case in ["bad", "broken", "clean"]
    for kind in ["stdout", "exit"]
]
