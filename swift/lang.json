{
  "$schema": "../core/modules/lang.schema.json",
  "name": "swift",
  "title": "Swift",
  "family": "core",
  "ecosystems": [
    "swiftpm"
  ],
  "depcheck": "swift",
  "semver": false,
  "manifests": [
    "Package.swift"
  ],
  "lockfiles": [
    "Package.resolved"
  ],
  "setup": {
    "hubs": [
      {
        "ecosystem": "swiftpm",
        "manifest": "Package.swift",
        "lock": "swiftpm.lock.json",
        "state": "Package.resolved",
        "extension": "@rules_dx//swift:extensions.bzl",
        "tag": "lock",
        "hub": "swiftpkg",
        "resolver": "@rules_dx//swift/private/tools/lock",
        "imports": "provides"
      }
    ]
  },
  "tools": [
    "swift_format",
    "swift_lint"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64"
  ],
  "unsupported": {
    "windows_arm64": "The Swift Windows arm64 toolchain is registered but unverified on Windows ARM",
    "windows_x86_64": "rules_dx registers no Swift toolchain for Windows"
  },
  "pins": [
    "pins.json"
  ],
  "entry_points": [
    "swift_interop_hint",
    "swift_library",
    "swift_library_group",
    "swift_binary",
    "swift_test",
    "swift_fuzz_test",
    "swift_bench"
  ],
  "quality": {
    "bzl": "swift/private/quality:swift.bzl",
    "file_extensions": [
      ".swift"
    ],
    "aspects": {
      "format": [
        "real_swift_format_aspect"
      ],
      "lint": [
        "real_swift_lint_aspect"
      ],
      "typecheck": [
        "real_swift_typecheck_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_swift_format_probe_aspect"
      ],
      "lint": [
        "real_swift_lint_probe_aspect"
      ],
      "typecheck": [
        "real_swift_typecheck_probe_aspect"
      ]
    }
  },
  "docs": {
    "bzl": "tools/docs/swift:aspect.bzl",
    "file_extensions": [
      ".swift"
    ],
    "aspects": [
      "real_swift_docs_aspect"
    ]
  }
}
