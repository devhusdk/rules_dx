{
  "$schema": "../core/modules/lang.schema.json",
  "name": "swift",
  "title": "Swift",
  "family": "core",
  "ecosystems": [
    "swiftpm"
  ],
  "depcheck": "swift",
  "semver": false,
  "manifests": [
    "Package.swift"
  ],
  "lockfiles": [
    "Package.resolved"
  ],
  "tools": [
    "swift_format",
    "swift_lint"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64"
  ],
  "pins": [],
  "entry_points": [
    "swift_interop_hint",
    "swift_library",
    "swift_binary",
    "swift_test",
    "swift_fuzz_test",
    "swift_bench"
  ],
  "quality": {
    "bzl": "quality:families/swift.bzl",
    "file_extensions": [
      ".swift"
    ],
    "aspects": {
      "format": [
        "real_swift_format_aspect"
      ],
      "lint": [
        "real_swift_lint_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_swift_format_probe_aspect"
      ],
      "lint": [
        "real_swift_lint_probe_aspect"
      ]
    }
  },
  "docs": {
    "bzl": "tools/docs/swift:aspect.bzl",
    "file_extensions": [
      ".swift"
    ],
    "aspects": [
      "real_swift_docs_aspect"
    ]
  }
}
