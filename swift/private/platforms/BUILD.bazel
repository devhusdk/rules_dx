load("//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

[
    platform(
        name = "linux_" + cpu,
        constraint_values = [
            "@llvm//constraints/cxxstdlib:libstdcxx.11.5.0",
            "@llvm//constraints/libc:gnu.2.35",
            "@platforms//cpu:" + cpu,
            "@platforms//os:linux",
        ],
    )
    for cpu in [
        "aarch64",
        "x86_64",
    ]
]

[
    platform(
        name = "exec_linux_" + cpu,
        constraint_values = [
            "@llvm//constraints/libc:gnu.2.35",
            "@platforms//cpu:" + cpu,
            "@platforms//os:linux",
        ],
    )
    for cpu in [
        "aarch64",
        "x86_64",
    ]
]

[
    config_setting(
        name = "is_linux_" + cpu,
        constraint_values = [
            "@platforms//cpu:" + cpu,
            "@platforms//os:linux",
        ],
    )
    for cpu in [
        "aarch64",
        "x86_64",
    ]
]

[
    config_setting(
        name = "is_windows_" + cpu,
        constraint_values = [
            "@platforms//cpu:" + cpu,
            "@platforms//os:windows",
        ],
    )
    for cpu in [
        "aarch64",
        "x86_64",
    ]
]

config_setting(
    name = "is_windows_x86_64_static_crt",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
    values = {"features": "static_link_msvcrt"},
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "support.bzl",
        "settings.bzl",
    ],
    tags = ["corpus"],
)
