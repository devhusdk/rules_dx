# The Swift archive's libFuzzer is built for libstdc++, which Swift binaries link;
# the pinned LLVM's libFuzzer is built for libc++.
cc_library(
    name = "libfuzzer",
    srcs = select({
        "//swift/private/platforms:is_linux_aarch64": ["@dx_swift_linux_aarch64//:usr/lib/clang/21/lib/linux/libclang_rt.fuzzer-aarch64.a"],
        "//swift/private/platforms:is_linux_x86_64": ["@dx_swift_linux_x86_64//:usr/lib/clang/21/lib/linux/libclang_rt.fuzzer-x86_64.a"],
        "//conditions:default": [],
    }),
    target_compatible_with = ["@platforms//os:linux"],
    testonly = True,
)

# The profile runtime of the Swift archive, which reads the raw profile layout swiftc emits.
# A swift_test links it under bazel coverage in place of the pinned cc toolchain's.
cc_library(
    name = "profile_runtime",
    testonly = True,
    srcs = select({
        "//swift/private/platforms:is_linux_aarch64": ["@dx_swift_linux_aarch64//:usr/lib/clang/21/lib/linux/libclang_rt.profile-aarch64.a"],
        "//swift/private/platforms:is_linux_x86_64": ["@dx_swift_linux_x86_64//:usr/lib/clang/21/lib/linux/libclang_rt.profile-x86_64.a"],
        "//conditions:default": [],
    }),
    alwayslink = True,
)

