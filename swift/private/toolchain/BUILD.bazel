load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//core/quality:fixtures.bzl", "real_source_target")
load(":toolchain.bzl", "SWIFT_LINUX_CPUS", "swift_linux_toolchain")
load(":windows.bzl", "swift_windows_toolchain")

# gazelle:exclude libc_single_threaded.c

package(default_visibility = ["//visibility:public"])

[
    swift_linux_toolchain(
        name = "swift_toolchain_%s_%s" % (exec_cpu, target_cpu),
        exec_cpu = exec_cpu,
        target_cpu = target_cpu,
    )
    for exec_cpu in SWIFT_LINUX_CPUS
    for target_cpu in SWIFT_LINUX_CPUS
]

swift_windows_toolchain(
    name = "swift_toolchain_windows_x86_64",
    cpu = "x86_64",
)

swift_windows_toolchain(
    name = "swift_toolchain_windows_aarch64",
    cpu = "aarch64",
)

exports_files([
    "extensions.bzl",
    "extract_windows.ps1",
    "repos.bzl",
    "windows.bzl",
])

filegroup(
    name = "runtime_libs",
    testonly = True,
    srcs = select({
        "//swift/private/platforms:is_linux_aarch64": ["@dx_swift_libs_linux_aarch64//:runtime_libs"],
        "//swift/private/platforms:is_linux_x86_64": ["@dx_swift_libs_linux_x86_64//:runtime_libs"],
        "//conditions:default": [],
    }),
)

# libFuzzer built for libstdc++, which Swift binaries link.
# keep
cc_library(
    name = "libfuzzer",
    testonly = True,
    srcs = select({
        "//swift/private/platforms:is_linux_aarch64": ["@dx_swift_linux_aarch64//:usr/lib/clang/21/lib/linux/libclang_rt.fuzzer-aarch64.a"],
        "//swift/private/platforms:is_linux_x86_64": ["@dx_swift_linux_x86_64//:usr/lib/clang/21/lib/linux/libclang_rt.fuzzer-x86_64.a"],
        "//conditions:default": [],
    }),
    target_compatible_with = ["@platforms//os:linux"],
)

# The Swift archive's AddressSanitizer runtime; the pinned LLVM toolchain ships none.
# keep
cc_library(
    name = "asan_archives",
    testonly = True,
    srcs = select({
        "//swift/private/platforms:is_linux_aarch64": [
            "libc_single_threaded.c",
            "@dx_swift_linux_aarch64//:usr/lib/clang/21/lib/linux/libclang_rt.asan-aarch64.a",
            "@dx_swift_linux_aarch64//:usr/lib/clang/21/lib/linux/libclang_rt.asan_static-aarch64.a",
        ],
        "//swift/private/platforms:is_linux_x86_64": [
            "libc_single_threaded.c",
            "@dx_swift_linux_x86_64//:usr/lib/clang/21/lib/linux/libclang_rt.asan-x86_64.a",
            "@dx_swift_linux_x86_64//:usr/lib/clang/21/lib/linux/libclang_rt.asan_static-x86_64.a",
        ],
        "//conditions:default": [],
    }),
    linkopts = [
        "-Wl,--export-dynamic",
        "-ldl",
        "-lpthread",
        "-lrt",
        "-lm",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

# keep
cc_library(
    name = "asan_runtime",
    testonly = True,
    target_compatible_with = ["@platforms//os:linux"],
    deps = select({
        "@llvm//config:asan_enabled": [],
        "//conditions:default": [":asan_archives"],
    }),
)

# Swift profile runtime, linked by swift_test under bazel coverage.
# keep
cc_library(
    name = "profile_runtime",
    testonly = True,
    srcs = select({
        "//swift/private/platforms:is_linux_aarch64": ["@dx_swift_linux_aarch64//:usr/lib/clang/21/lib/linux/libclang_rt.profile-aarch64.a"],
        "//swift/private/platforms:is_linux_x86_64": ["@dx_swift_linux_x86_64//:usr/lib/clang/21/lib/linux/libclang_rt.profile-x86_64.a"],
        "//conditions:default": [],
    }),
    alwayslink = True,
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "repos.bzl",
        "extensions.bzl",
        "tests.bzl",
        "toolchain.bzl",
        "windows.bzl",
    ],
    tags = ["corpus"],
)
