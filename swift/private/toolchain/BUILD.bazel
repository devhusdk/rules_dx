load("//quality:fixtures.bzl", "real_source_target")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load(":toolchain.bzl", "swift_linux_toolchain")
load(":windows.bzl", "swift_windows_toolchain")

package(default_visibility = ["//visibility:public"])

[
    swift_linux_toolchain(
        name = "toolchain_" + cpu,
        cpu = cpu,
    )
    for cpu in [
        "aarch64",
        "x86_64",
    ]
]

swift_windows_toolchain(
    name = "toolchain_windows_x86_64",
    cpu = "x86_64",
)

swift_windows_toolchain(
    name = "toolchain_windows_aarch64",
    cpu = "aarch64",
)

exports_files([
    "extract_windows.ps1",
    "pins.json",
    "swift_format.build",
])

