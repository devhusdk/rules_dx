load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//quality:fixtures.bzl", "real_source_target")
load("//quality:unavailable_tool.bzl", "dx_unavailable_tool")
load(":swift_tool.bzl", "swift_format_tool")

package(default_visibility = ["//visibility:public"])

swift_format_tool(
    name = "swift_format_linux",
    srcs = select({
        "@platforms//cpu:aarch64": ["@dx_swift_linux_aarch64//:files"],
        "//conditions:default": ["@dx_swift_linux_x86_64//:files"],
    }),
)

dx_unavailable_tool(
    name = "swift_format_unsupported",
    tool = "swift_format",
)

# The Swift archives are Linux builds. On macOS arm64 swift-format is the
# sha256-pinned release build.
config_setting(
    name = "is_macos_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
)

native_binary(
    name = "swift_format_macos",
    src = "@dx_swift_format_macos_arm64//:bin/swift-format",
    out = "swift_format_macos_bin",
)

# Elsewhere the alias is a marked stub and the aspect skips the stage with a note.
alias(
    name = "swift_format",
    actual = select({
        "@platforms//os:linux": ":swift_format_linux",
        ":is_macos_arm64": ":swift_format_macos",
        "//conditions:default": ":swift_format_unsupported",
    }),
)

# The llvm-cov and llvm-profdata that ship with the Swift toolchain read the profiles and coverage maps swiftc writes.
# Elsewhere the pinned LLVM pair is used.
[
    alias(
        name = "llvm_" + tool,
        actual = select({
            "//swift/private/platforms:is_linux_aarch64": "@dx_swift_linux_aarch64//:usr/bin/llvm-" + tool.replace("_", ""),
            "//swift/private/platforms:is_linux_x86_64": "@dx_swift_linux_x86_64//:usr/bin/llvm-" + tool.replace("_", ""),
            "//conditions:default": "@llvm//tools:llvm-" + tool.replace("_", ""),
        }),
    )
    for tool in ["cov", "profdata"]
]

sh_binary(
    name = "swift",
    srcs = ["@dx_swift_host//:swift"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "swift_tool.bzl",
    ],
    tags = ["corpus"],
)
