load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//core/quality:unavailable_tool.bzl", "dx_unavailable_tool")
load(":swift_tool.bzl", "swift_format_tool")
load(":swift_tool_tests.bzl", "swift_format_copy_test")
load(":xcode_swift.bzl", "swift_xcode_launcher")

package(default_visibility = ["//visibility:public"])

swift_format_tool(
    name = "swift_format_linux",
    srcs = select({
        "@platforms//cpu:aarch64": ["@dx_swift_linux_aarch64//:files"],
        "//conditions:default": ["@dx_swift_linux_x86_64//:files"],
    }),
    target_compatible_with = ["@platforms//os:linux"],
)

swift_format_copy_test(
    name = "swift_format_copy_test",
    size = "small",
    target_compatible_with = ["@platforms//os:linux"],
    target_under_test = ":swift_format_linux",
)

dx_unavailable_tool(
    name = "swift_format_unsupported",
    tool = "swift_format",
)

config_setting(
    name = "is_macos_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
)

native_binary(
    name = "swift_format_macos",
    src = "@dx_swift_format_macos_arm64//:bin/swift-format",
    out = "swift_format_macos_bin",
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
)

alias(
    name = "swift_format",
    actual = select({
        "@platforms//os:linux": ":swift_format_linux",
        ":is_macos_arm64": ":swift_format_macos",
        "//conditions:default": ":swift_format_unsupported",
    }),
)

[
    alias(
        name = "llvm_" + tool,
        actual = select({
            "//swift/private/platforms:is_linux_aarch64": "@dx_swift_linux_aarch64//:usr/bin/llvm-" + tool.replace("_", ""),
            "//swift/private/platforms:is_linux_x86_64": "@dx_swift_linux_x86_64//:usr/bin/llvm-" + tool.replace("_", ""),
            "//conditions:default": "@llvm//tools:llvm-" + tool.replace("_", ""),
        }),
    )
    for tool in [
        "cov",
        "profdata",
    ]
]

swift_xcode_launcher(
    name = "swift_macos",
    target_compatible_with = ["@platforms//os:macos"],
)

sh_binary(
    name = "swift_linux",
    srcs = ["@dx_swift_host//:swift"],
    target_compatible_with = ["@platforms//os:linux"],
)

alias(
    name = "swift",
    actual = select({
        "@platforms//os:macos": ":swift_macos",
        "//conditions:default": ":swift_linux",
    }),
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "swift_tool.bzl",
        "swift_tool_tests.bzl",
        "xcode_swift.bzl",
    ],
    tags = ["corpus"],
)
