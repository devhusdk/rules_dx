load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("//powershell:defs.bzl", "powershell_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//core/quality:unavailable_tool.bzl", "dx_unavailable_tool")
load(":host_swift.bzl", "swift_host_launcher")
load(":swift_tool.bzl", "swift_format_tool", "swift_format_windows")
load(":swift_tool_tests.bzl", "swift_format_copy_test")
load(":xcode_swift.bzl", "swift_xcode_launcher")

package(default_visibility = ["//visibility:public"])

swift_format_tool(
    name = "swift_format_linux",
    srcs = select({
        "@platforms//cpu:aarch64": ["@dx_swift_linux_aarch64//:files"],
        "//conditions:default": ["@dx_swift_linux_x86_64//:files"],
    }),
    target_compatible_with = ["@platforms//os:linux"],
)

swift_format_copy_test(
    name = "swift_format_copy_test",
    size = "small",
    target_compatible_with = ["@platforms//os:linux"],
    target_under_test = ":swift_format_linux",
)

dx_unavailable_tool(
    name = "swift_format_unsupported",
    tool = "swift_format",
)

config_setting(
    name = "is_macos_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
)

native_binary(
    name = "swift_format_macos",
    src = "@dx_swift_format_macos_arm64//:bin/swift-format",
    out = "swift_format_macos_bin",
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
)

[
    swift_format_windows(
        name = "swift_format_windows_" + cpu,
        data = ["@dx_swift_windows_%s//:toolchain_bin" % cpu],
        program = "@dx_swift_windows_%s//:toolchain/usr/bin/swift-format.exe" % cpu,
        target_compatible_with = [
            "@platforms//cpu:" + cpu,
            "@platforms//os:windows",
        ],
    )
    for cpu in [
        "aarch64",
        "x86_64",
    ]
]

powershell_test(
    name = "swift_format_windows_test",
    size = "small",
    srcs = ["swift_format_windows_test.ps1"],
    data = [":swift_format"],
    env = {"DX_SWIFT_FORMAT": "$(rlocationpath :swift_format)"},
    target_compatible_with = ["@platforms//os:windows"],
    deps = ["@rules_powershell//powershell/runfiles"],
)

alias(
    name = "swift_format",
    actual = select({
        "@platforms//os:linux": ":swift_format_linux",
        ":is_macos_arm64": ":swift_format_macos",
        "//swift/private/platforms:is_windows_aarch64": ":swift_format_windows_aarch64",
        "//swift/private/platforms:is_windows_x86_64": ":swift_format_windows_x86_64",
        "//conditions:default": ":swift_format_unsupported",
    }),
)

[
    alias(
        name = "llvm_" + tool,
        actual = select({
            "//swift/private/platforms:is_linux_aarch64": "@dx_swift_linux_aarch64//:usr/bin/llvm-" + tool.replace("_", ""),
            "//swift/private/platforms:is_linux_x86_64": "@dx_swift_linux_x86_64//:usr/bin/llvm-" + tool.replace("_", ""),
            "//swift/private/platforms:is_windows_aarch64": "@dx_swift_windows_aarch64//:toolchain/usr/bin/llvm-%s.exe" % tool.replace("_", ""),
            "//swift/private/platforms:is_windows_x86_64": "@dx_swift_windows_x86_64//:toolchain/usr/bin/llvm-%s.exe" % tool.replace("_", ""),
            "@platforms//os:macos": ":llvm_%s_macos" % tool,
            "//conditions:default": "@llvm//tools:llvm-" + tool.replace("_", ""),
        }),
    )
    for tool in [
        "cov",
        "profdata",
    ]
]

swift_xcode_launcher(
    name = "swift_macos",
    target_compatible_with = ["@platforms//os:macos"],
)

[
    swift_xcode_launcher(
        name = "%s_macos" % tool.replace("-", "_"),
        target_compatible_with = ["@platforms//os:macos"],
        tool = tool,
    )
    for tool in [
        "llvm-cov",
        "llvm-profdata",
    ]
]

swift_host_launcher(
    name = "swift_linux",
    data = select({
        "@platforms//cpu:aarch64": ["@dx_swift_linux_aarch64//:files"],
        "//conditions:default": ["@dx_swift_linux_x86_64//:files"],
    }),
    linker = select({
        "@platforms//cpu:aarch64": "@dx_swift_linux_aarch64//:usr/bin/ld",
        "//conditions:default": "@dx_swift_linux_x86_64//:usr/bin/ld",
    }),
    swift = select({
        "@platforms//cpu:aarch64": "@dx_swift_linux_aarch64//:usr/bin/swift",
        "//conditions:default": "@dx_swift_linux_x86_64//:usr/bin/swift",
    }),
    target_compatible_with = ["@platforms//os:linux"],
)

alias(
    name = "swift",
    actual = select({
        "@platforms//os:macos": ":swift_macos",
        "//conditions:default": ":swift_linux",
    }),
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "swift_tool.bzl",
        "swift_tool_tests.bzl",
        "xcode_swift.bzl",
        "host_swift.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob([
        "*.bzl",
        "BUILD.bazel",
    ]),
    visibility = ["//:__subpackages__"],
)
