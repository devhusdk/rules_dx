load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:private"])

rust_library(
    name = "swift_lock_lib",
    srcs = ["src/resolve.rs"],
    aliases = aliases(
        package_name = "swift/private/tools/swift_lock",
        normal = True,
    ),
    crate_name = "swift_lock",
    crate_root = "src/resolve.rs",
    deps = all_crate_deps(
        package_name = "swift/private/tools/swift_lock",
        normal = True,
    ) + [
        "//cli/digest:dx_digest",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
        "@crates//:serde_json",
    ],
)

rust_binary(
    name = "lock",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "swift/private/tools/swift_lock",
        normal = True,
    ),
    crate_name = "swift_lock_bin",
    crate_root = "src/main.rs",
    data = ["@dx_swift_host//:swift"],
    env = {"SWIFT": "$(rlocationpath @dx_swift_host//:swift)"},
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        package_name = "swift/private/tools/swift_lock",
        normal = True,
    ) + [
        ":swift_lock_lib",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
    ],
)

rust_test(
    name = "resolve_test",
    size = "small",
    srcs = ["resolve_test.rs"],
    aliases = aliases(
        package_name = "swift/private/tools/swift_lock",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "resolve_test",
    crate_root = "resolve_test.rs",
    data = [
        "testdata/golden.lock.json",
        "testdata/mini.tar.gz",
        "testdata/multi.lock.json",
        "testdata/multi.tar.gz",
        "@dx_swift_host//:swift",
    ],
    env = {
        "ARCHIVE": "$(rootpath testdata/mini.tar.gz)",
        "ARCHIVE_MULTI": "$(rootpath testdata/multi.tar.gz)",
        "GOLDEN": "$(rootpath testdata/golden.lock.json)",
        "GOLDEN_MULTI": "$(rootpath testdata/multi.lock.json)",
        "SWIFT": "$(rootpath @dx_swift_host//:swift)",
    },
    tags = ["block-network"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = all_crate_deps(
        package_name = "swift/private/tools/swift_lock",
        normal = True,
        normal_dev = True,
    ) + [
        ":swift_lock_lib",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)
