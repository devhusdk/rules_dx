load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//cli/launcher:defs.bzl", "dx_subcommand")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:private"])

rust_library(
    name = "swift_lock_lib",
    srcs = ["src/resolve.rs"],
    aliases = aliases(
        package_name = "swift/private/tools/swift_lock",
        normal = True,
    ),
    crate_name = "swift_lock",
    crate_root = "src/resolve.rs",
    visibility = ["//cli/cli:__pkg__"],
    deps = all_crate_deps(
        package_name = "swift/private/tools/swift_lock",
        normal = True,
    ) + [
        "//cli/archive:dx_archive",
        "//cli/digest:dx_digest",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
        "@crates//:serde_json",
    ],
)

dx_subcommand(
    name = "lock",
    path_args = {"--swift": "//swift/private/tools:swift"},
    subcommand = "swift_lock",
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//:__subpackages__"],
)

rust_test(
    name = "resolve_test",
    size = "small",
    srcs = ["resolve_test.rs"],
    aliases = aliases(
        package_name = "swift/private/tools/swift_lock",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "resolve_test",
    crate_root = "resolve_test.rs",
    data = [
        "testdata/golden.lock.json",
        "testdata/mini.tar.gz",
        "testdata/multi.lock.json",
        "testdata/multi.tar.gz",
        "//swift/private/tools:swift",
    ],
    env = {
        "ARCHIVE": "$(rootpath testdata/mini.tar.gz)",
        "ARCHIVE_MULTI": "$(rootpath testdata/multi.tar.gz)",
        "GOLDEN": "$(rootpath testdata/golden.lock.json)",
        "GOLDEN_MULTI": "$(rootpath testdata/multi.lock.json)",
        "SWIFT": "$(rootpath //swift/private/tools:swift)",
    },
    tags = ["block-network"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = all_crate_deps(
        package_name = "swift/private/tools/swift_lock",
        normal = True,
        normal_dev = True,
    ) + [
        ":swift_lock_lib",
        "//cli/archive:dx_archive",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
        "//cli/lock:dx_lock_testing",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "subcommand_test",
    size = "small",
    srcs = ["subcommand_test.rs"],
    aliases = aliases(
        package_name = "swift/private/tools/swift_lock",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "subcommand_test",
    crate_root = "subcommand_test.rs",
    data = [":lock"],
    env = {"LOCK": "$(rlocationpath :lock)"},
    tags = ["block-network"],
    deps = all_crate_deps(
        package_name = "swift/private/tools/swift_lock",
        normal = True,
        normal_dev = True,
    ) + ["//tools/testing:dx_testing"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
