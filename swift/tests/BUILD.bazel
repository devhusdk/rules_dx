load("//core:conformance.bzl", "dx_wrapper_contract_tests")
load("//core:defs.bzl", "expect_equal")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//powershell:defs.bzl", "powershell_test")
load("//rust:defs.bzl", "rust_test")
load("//swift/private:defs.bzl", "swift_kwargs")
load("//swift/private/toolchain:tests.bzl", "swift_toolchain_hub_test", "swift_windows_extract_test")
load(":host_swift_tests.bzl", "swift_host_descriptor_test")
load(":hub_tests.bzl", "swift_hub_tests")
load(":transition_tests.bzl", "transition_test_suite")

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "host_swift_tests.bzl",
        "hub_tests.bzl",
        "transition_tests.bzl",
        "wrapper_tests.bzl",
    ],
    tags = ["corpus"],
)

dx_wrapper_contract_tests(
    name = "wrapper_contract_tests",
    size = "small",
    extra_checks = [
        expect_equal(
            "swift guard is a select by default",
            type(swift_kwargs({})["target_compatible_with"]),
            "select",
        ),
        expect_equal(
            "swift guard stays with a user list",
            type(swift_kwargs({"target_compatible_with": ["//x:y"]})["target_compatible_with"]),
            "select",
        ),
        expect_equal(
            "swift keeps user tags",
            swift_kwargs({"tags": ["t"]})["tags"],
            ["t"],
        ),
    ],
    file_classes = ["swift"],
    wrappers = {
        "binary": "//swift/tests/fixtures/hello:hello",
        "library": "//swift/tests/fixtures/hello:greet",
        "test": "//swift/tests/fixtures/hello:xctest",
    },
)

swift_hub_tests(
    name = "hub",
    size = "small",
)

swift_host_descriptor_test(
    name = "host_descriptor_test",
    size = "small",
    target_compatible_with = ["@platforms//os:linux"],
    target_under_test = "//swift/private/tools:swift_linux",
)

swift_toolchain_hub_test(
    name = "toolchain_hub_test",
    size = "small",
)

swift_windows_extract_test(
    name = "windows_extract_test",
    size = "small",
)

powershell_test(
    name = "toolchain_dlls_test_x86_64",
    size = "small",
    srcs = ["toolchain_dlls_test.ps1"],
    data = [
        "@dx_swift_windows_x86_64//:swiftc",
        "@dx_swift_windows_x86_64//:toolchain_files",
    ],
    env = {"DX_SWIFTC": "$(rlocationpath @dx_swift_windows_x86_64//:swiftc)"},
    target_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
    deps = ["@rules_powershell//powershell/runfiles"],
)

[
    rust_test(
        name = "toolchain_libs_test_" + cpu,
        size = "small",
        srcs = ["toolchain_libs_test.rs"],
        data = [
            "@dx_swift_linux_%s//:files" % cpu,
            "@dx_swift_linux_%s//:usr/bin/llvm-objdump" % cpu,
            "@dx_swift_libs_linux_%s//:host_libs" % cpu,
            "@dx_swift_libs_linux_%s//:host_libs/libz.so.1" % cpu,
        ],
        env = {"LLVM_OBJDUMP": "$(rootpath @dx_swift_linux_%s//:usr/bin/llvm-objdump)" % cpu},
        tags = ["no-coverage"],
        target_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:" + cpu,
        ],
        deps = ["//tools/testing:dx_testing"],
    )
    for cpu in [
        "aarch64",
        "x86_64",
    ]
]

transition_test_suite(name = "transition_tests")

test_suite(
    name = "fixture_tests",
    testonly = True,
    tests = [
        "//swift/tests/fixtures/warnings:warnings_as_errors_test",
    ],
)
