load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//powershell:defs.bzl", "powershell_test")
load("//swift/private/toolchain:tests.bzl", "swift_host_test", "swift_windows_extract_test")
load(":hub_tests.bzl", "swift_hub_tests")

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "hub_tests.bzl",
    ],
    tags = ["corpus"],
)

swift_hub_tests(
    name = "hub",
    size = "small",
)

swift_host_test(name = "host_test", size = "small")

swift_windows_extract_test(name = "windows_extract_test", size = "small")

powershell_test(
    name = "toolchain_dlls_test_x86_64",
    size = "small",
    srcs = ["toolchain_dlls_test.ps1"],
    data = [
        "@dx_swift_windows_x86_64//:swiftc",
        "@dx_swift_windows_x86_64//:toolchain_files",
    ],
    env = {"DX_SWIFTC": "$(rlocationpath @dx_swift_windows_x86_64//:swiftc)"},
    target_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
    deps = ["@rules_powershell//powershell/runfiles"],
)

# The Swift toolchain binaries load nothing from the host except glibc.
[
    sh_test(
        name = "toolchain_libs_test_" + cpu,
        srcs = ["toolchain_libs_test.sh"],
        args = [
            "$(rootpath @dx_swift_linux_%s//:usr/bin/llvm-objdump)" % cpu,
            "$(rootpath @dx_swift_sysroot_linux_%s//:host_libs/libz.so.1)" % cpu,
        ],
        data = [
            "@dx_swift_linux_%s//:files" % cpu,
            "@dx_swift_linux_%s//:usr/bin/llvm-objdump" % cpu,
            "@dx_swift_sysroot_linux_%s//:files" % cpu,
            "@dx_swift_sysroot_linux_%s//:host_libs/libz.so.1" % cpu,
        ],
        target_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:" + cpu,
        ],
    )
    for cpu in [
        "aarch64",
        "x86_64",
    ]
]
