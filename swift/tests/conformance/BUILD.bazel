# gazelle:ignore
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//swift:defs.bzl", "swift_binary", "swift_library", "swift_test")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "subject_compatible_with")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

swift_library(
    name = "conformance",
    srcs = ["Greet.swift"],
    module_name = "Conformance",
)

swift_library(
    name = "lint_dirty",
    testonly = True,
    srcs = ["LintDirty.swift"],
    module_name = "LintDirty",
    tags = ["manual"],
)

swift_library(
    name = "format_dirty",
    testonly = True,
    srcs = ["FormatDirty.swift"],
    module_name = "FormatDirty",
    tags = ["manual"],
)

swift_binary(
    name = "hello",
    srcs = ["main.swift"],
    deps = [":conformance"],
)

swift_binary(
    name = "lock_hello",
    srcs = ["LockMain.swift"],
    deps = ["@swiftpkg//swift-argument-parser:ArgumentParser"],
)

swift_binary(
    name = "runfiles_hello",
    srcs = ["RunfilesMain.swift"],
    data = ["data.txt"],
    deps = ["@rules_swift//swift/runfiles"],
)

swift_test(
    name = "pass_subject_test",
    size = "small",
    srcs = ["PassTest.swift"],
    target_compatible_with = subject_compatible_with(),
    deps = [":conformance"],
)

swift_test(
    name = "fail_subject_test",
    size = "small",
    srcs = ["FailTest.swift"],
    target_compatible_with = subject_compatible_with(),
    deps = [":conformance"],
)

dx_conformance_suite(
    name = "",
    size = "small",
    binary = ":hello",
    covered_source = "Greet.swift",
    expected = "hello world",
    failing_case = "failingCase",
    failing_pattern = "Test {case}() recorded an issue",
    failing_test = ":fail_subject_test",
    lang = "swift",
    lock = {
        "binary": ":lock_hello",
        "ecosystem": "swift",
        "expected": "hello lock",
        "lockfile": "//swift/tests/fixtures/swift_app:Package.resolved",
        "manifest": "//swift/tests/fixtures/swift_app:Package.swift",
        "package": "swift-argument-parser",
        "stale": "Package.stale.resolved",
    },
    not_applicable = {
        "cross_test:macos_arm64": "swift cross-compiles to linux only from a linux host",
        "cross_test:windows_arm64": "swift cross-compiles to linux only from a linux host",
        "cross_test:windows_x86_64": "swift cross-compiles to linux only from a linux host",
    },
    passing_test = ":pass_subject_test",
    quality = {
        "clean": ":conformance",
        "format_dirty": ":format_dirty",
        "format_source": "FormatDirty.swift",
        "lint_dirty": ":lint_dirty",
        "lint_line": 2,
        "lint_rule": "DoNotUseSemicolons",
        "lint_source": "LintDirty.swift",
    },
    runfiles = {
        "binary": ":runfiles_hello",
        "data": "data.txt",
        "expected": "hello runfiles",
    },
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
