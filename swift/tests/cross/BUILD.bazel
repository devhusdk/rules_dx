load("//core/quality:fixtures.bzl", "real_source_target")
load("//swift:defs.bzl", "swift_library")
load("//swift/private/toolchain:tests.bzl", "swift_cross_runtime_test", "swift_tool_inputs_test")

package(default_testonly = True)

[
    swift_cross_runtime_test(
        name = "cross_runtime_%s_%s_test" % (exec_cpu, target_cpu),
        exec_cpu = exec_cpu,
        target_cpu = target_cpu,
    )
    for exec_cpu, target_cpu in [
        ("aarch64", "x86_64"),
        ("x86_64", "aarch64"),
    ]
]

swift_library(
    name = "tool_inputs",
    srcs = ["tool_inputs.swift"],
    module_name = "ToolInputs",
    target_compatible_with = ["@platforms//os:linux"],
)

[
    swift_tool_inputs_test(
        name = "tool_inputs_%s_test" % cpu,
        cpu = cpu,
        target_under_test = ":tool_inputs_upstream",
    )
    for cpu in [
        "aarch64",
        "x86_64",
    ]
]

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
