load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")
load("//swift:defs.bzl", "swift_binary")

package(default_testonly = True)

platform(
    name = "linux_arm64",
    parents = ["//swift/private/platforms:exec_linux_aarch64"],
)

swift_binary(
    name = "hello_arm64",
    srcs = ["main.swift"],
    platforms = [":linux_arm64"],
)

rust_test(
    name = "cross_arm64_test",
    srcs = ["cross_arm64_test.rs"],
    data = [":hello_arm64"],
    env = {"HELLO_ARM64": "$(rootpath :hello_arm64)"},
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = ["//tools/testing:dx_testing"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
