load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//core:fuzz_bench_tests.bzl", "dx_runner_attr_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//swift/rules:defs.bzl", "swift_fuzz_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

swift_fuzz_test(
    name = "parse_fuzz",
    srcs = ["parse.swift"],
)

sh_test(
    name = "parse_fuzz_run_test",
    srcs = ["run_test.sh"],
    args = ["$(rootpath :parse_fuzz)"],
    data = [
        ":parse_fuzz",
        "//libs/fuzz_run:fuzz_run",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    timeout = "short",
)

swift_fuzz_test(
    name = "args_fuzz",
    srcs = ["parse.swift"],
    args = ["-max_total_time=1"],
)

dx_runner_attr_test(
    name = "args_fuzz_attrs",
    expected = {
        "args": ["-max_total_time=1"],
        "tags": ["dx-fuzz", "manual"],
    },
    runner = "args_fuzz",
)

dx_runner_attr_test(
    name = "parse_fuzz_run_attrs",
    expected = {"args": ["libfuzzer", "$(rootpath :parse_fuzz)"]},
    runner = "parse_fuzz_run",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
