load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//swift/rules:defs.bzl", "swift_binary", "swift_library", "swift_test")
load("//swift/rules:tests.bzl", "swift_binary_provider_test", "swift_library_provider_test")
load("//tools/testing:hello_output.bzl", "dx_hello_output_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

_LINUX = ["@platforms//os:linux"]

swift_library(
    name = "greet",
    srcs = ["greet.swift"],
    module_name = "Greet",
)

swift_binary(
    name = "hello",
    srcs = ["main.swift"],
    target_compatible_with = _LINUX,
    deps = [":greet"],
)

swift_test(
    name = "xctest",
    srcs = ["greet_xctest.swift"],
    target_compatible_with = _LINUX,
    deps = [":greet"],
)

swift_test(
    name = "testing",
    srcs = ["greet_testing.swift"],
    target_compatible_with = _LINUX,
    deps = [":greet"],
)

swift_library_provider_test(
    name = "greet_providers_test",
    target_under_test = ":greet",
)

swift_binary_provider_test(
    name = "hello_providers_test",
    target_compatible_with = _LINUX,
    target_under_test = ":hello",
)

sh_test(
    name = "hello_link_test",
    srcs = ["arch_test.sh"],
    args = [
        "$(location @llvm//tools:llvm-readelf)",
        "$(location :hello)",
    ],
    data = [
        ":hello",
        "@llvm//tools:llvm-readelf",
    ],
    target_compatible_with = _LINUX,
)

dx_hello_output_test(
    name = "hello_output_test",
    binary = ":hello",
    expected = "Hello, swift!",
    target_compatible_with = _LINUX,
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
