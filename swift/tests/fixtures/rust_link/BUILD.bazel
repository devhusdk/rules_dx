load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary")
load("//swift:defs.bzl", "swift_library")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

_WINDOWS_X86_64 = ["@platforms//os:windows", "@platforms//cpu:x86_64"]

swift_library(
    name = "add",
    srcs = ["add.swift"],
    module_name = "Add",
    target_compatible_with = _WINDOWS_X86_64,
)

rust_binary(
    name = "rust_link",
    srcs = ["rust_link.rs"],
    edition = "2024",
    link_deps = [":add"],
    target_compatible_with = _WINDOWS_X86_64,
)

build_test(
    name = "rust_link_build_test",
    size = "small",
    targets = [":rust_link"],
    target_compatible_with = _WINDOWS_X86_64,
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
