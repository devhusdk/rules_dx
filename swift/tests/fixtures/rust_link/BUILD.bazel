load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")
load("//swift:defs.bzl", "swift_library")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)


swift_library(
    name = "add",
    srcs = ["add.swift"],
    module_name = "Add",
    target_compatible_with = ["@platforms//os:windows"],
)

rust_test(
    name = "rust_link",
    size = "small",
    srcs = ["rust_link.rs"],
    edition = "2024",
    link_deps = [":add"],
    runtime_dlls = select({
        "//swift/private/platforms:is_windows_aarch64": ["@dx_swift_windows_aarch64//:runtime_dlls"],
        "//swift/private/platforms:is_windows_x86_64": ["@dx_swift_windows_x86_64//:runtime_dlls"],
    }),
    target_compatible_with = ["@platforms//os:windows"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
