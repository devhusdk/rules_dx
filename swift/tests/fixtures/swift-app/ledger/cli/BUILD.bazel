load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//swift/rules:defs.bzl", "swift_binary")
load("//swift/rules:tests.bzl", "swift_binary_provider_test")
load("//tools/testing:hello_output.bzl", "dx_hello_output_test")

package(
    default_testonly = True,
    default_visibility = ["//swift/tests/fixtures/swift-app:__subpackages__"],
)

_LINUX = ["@platforms//os:linux"]

swift_binary(
    name = "ledger",
    testonly = False,
    srcs = ["main.swift"],
    copts = ["-DLEDGER_STRICT"],
    deps = [
        "//swift/tests/fixtures/swift-app/ledger/core",
        "@swiftpkg_swift_argument_parser//:ArgumentParser",
    ],
)

swift_binary_provider_test(
    name = "ledger_providers_test",
    tags = ["block-network"],
    target_under_test = ":ledger",
)

dx_hello_output_test(
    name = "ledger_output_test",
    binary = ":ledger",
    expected = "mode: strict\ntotal: 0\ndigest: 2166136261",
    tags = ["block-network"],
)

sh_test(
    name = "usage_test",
    srcs = ["usage_test.sh"],
    args = ["$(location :ledger)"],
    data = [":ledger"],
    tags = ["block-network"],
)

sh_test(
    name = "relocate_test",
    srcs = ["relocate_test.sh"],
    args = [
        "$(location @llvm//tools:llvm-readelf)",
        "$(location :ledger)",
    ],
    data = [
        ":ledger",
        "@llvm//tools:llvm-readelf",
    ],
    tags = ["block-network"],
    target_compatible_with = _LINUX,
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
