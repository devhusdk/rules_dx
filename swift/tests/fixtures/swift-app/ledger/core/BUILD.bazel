load("//core:failure_test.bzl", "failure_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//swift:defs.bzl", "swift_library", "swift_test")
load("//swift/private:tests.bzl", "swift_library_provider_test")

package(
    default_testonly = True,
    default_visibility = ["//swift/tests/fixtures/swift-app:__subpackages__"],
)

swift_library(
    name = "core",
    testonly = False,
    srcs = ["ledger.swift"],
    module_name = "LedgerCore",
    deps = ["//swift/tests/fixtures/swift-app/ledger/cdigest"],
)

swift_test(
    name = "xctest",
    srcs = ["ledger_xctest.swift"],
    tags = ["block-network"],
    deps = [":core"],
)

swift_test(
    name = "testing",
    srcs = ["ledger_testing.swift"],
    tags = ["block-network"],
    deps = [":core"],
)

swift_library_provider_test(
    name = "core_providers_test",
    tags = ["block-network"],
    target_under_test = ":core",
)

filegroup(
    name = "a_filegroup",
    srcs = ["ledger.swift"],
)

swift_library(
    name = "bad_dep",
    srcs = ["ledger.swift"],
    module_name = "BadDep",
    tags = ["manual"],
    deps = [":a_filegroup"],
)

failure_test(
    name = "bad_dep_test",
    expected_failure_substring = "does not have mandatory providers: 'CcInfo'",
    tags = ["block-network"],
    target = ":bad_dep",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
