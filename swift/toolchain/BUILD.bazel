load("//quality:fixtures.bzl", "real_source_target")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load(":toolchain.bzl", "swift_linux_toolchain")

package(default_visibility = ["//visibility:public"])

[
    swift_linux_toolchain(
        name = "toolchain_" + cpu,
        cpu = cpu,
    )
    for cpu in [
        "aarch64",
        "x86_64",
    ]
]

# The shared libraries a Swift test binary loads that the sysroot ships, so it runs without host libraries.
filegroup(
    name = "runtime_libs",
    testonly = True,
    srcs = select({
        "//swift/platforms:is_linux_aarch64": [
            "@dx_swift_sysroot_linux_aarch64//:host_libs/libedit.so.2",
            "@dx_swift_sysroot_linux_aarch64//:host_libs/libicudata.so.70",
            "@dx_swift_sysroot_linux_aarch64//:host_libs/libicuuc.so.70",
            "@dx_swift_sysroot_linux_aarch64//:host_libs/liblzma.so.5",
            "@dx_swift_sysroot_linux_aarch64//:host_libs/libncurses.so.6",
            "@dx_swift_sysroot_linux_aarch64//:host_libs/libsqlite3.so.0",
            "@dx_swift_sysroot_linux_aarch64//:host_libs/libtinfo.so.6",
            "@dx_swift_sysroot_linux_aarch64//:host_libs/libuuid.so.1",
            "@dx_swift_sysroot_linux_aarch64//:host_libs/libxml2.so.2",
        ],
        "//swift/platforms:is_linux_x86_64": [
            "@dx_swift_sysroot_linux_x86_64//:host_libs/libedit.so.2",
            "@dx_swift_sysroot_linux_x86_64//:host_libs/libicudata.so.70",
            "@dx_swift_sysroot_linux_x86_64//:host_libs/libicuuc.so.70",
            "@dx_swift_sysroot_linux_x86_64//:host_libs/liblzma.so.5",
            "@dx_swift_sysroot_linux_x86_64//:host_libs/libncurses.so.6",
            "@dx_swift_sysroot_linux_x86_64//:host_libs/libsqlite3.so.0",
            "@dx_swift_sysroot_linux_x86_64//:host_libs/libtinfo.so.6",
            "@dx_swift_sysroot_linux_x86_64//:host_libs/libuuid.so.1",
            "@dx_swift_sysroot_linux_x86_64//:host_libs/libxml2.so.2",
        ],
        "//conditions:default": [],
    }),
)

# The Swift archive's libFuzzer is built for libstdc++, which Swift binaries link;
# the pinned LLVM's libFuzzer is built for libc++.
cc_library(
    name = "libfuzzer",
    srcs = select({
        "//swift/platforms:is_linux_aarch64": ["@dx_swift_linux_aarch64//:usr/lib/clang/21/lib/linux/libclang_rt.fuzzer-aarch64.a"],
        "//swift/platforms:is_linux_x86_64": ["@dx_swift_linux_x86_64//:usr/lib/clang/21/lib/linux/libclang_rt.fuzzer-x86_64.a"],
        "//conditions:default": [],
    }),
    target_compatible_with = ["@platforms//os:linux"],
    testonly = True,
)

# The profile runtime of the Swift archive, which reads the raw profile layout swiftc emits.
# A swift_test links it under bazel coverage in place of the pinned cc toolchain's.
cc_library(
    name = "profile_runtime",
    testonly = True,
    srcs = select({
        "//swift/platforms:is_linux_aarch64": ["@dx_swift_linux_aarch64//:usr/lib/clang/21/lib/linux/libclang_rt.profile-aarch64.a"],
        "//swift/platforms:is_linux_x86_64": ["@dx_swift_linux_x86_64//:usr/lib/clang/21/lib/linux/libclang_rt.profile-x86_64.a"],
        "//conditions:default": [],
    }),
    alwayslink = True,
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "repos.bzl",
        "toolchain.bzl",
    ],
    tags = ["corpus"],
)
