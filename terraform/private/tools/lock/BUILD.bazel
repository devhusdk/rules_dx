load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//:__subpackages__"])

rust_library(
    name = "terraform_lock_lib",
    srcs = ["src/resolve.rs"],
    aliases = aliases(
        package_name = "terraform/private/tools/terraform_lock",
        normal = True,
    ),
    crate_name = "terraform_lock",
    crate_root = "src/resolve.rs",
    deps = all_crate_deps(
        package_name = "terraform/private/tools/terraform_lock",
        normal = True,
    ) + [
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
    ],
)

rust_binary(
    name = "lock",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "terraform/private/tools/terraform_lock",
        normal = True,
    ),
    crate_name = "terraform_lock_bin",
    crate_root = "src/main.rs",
    visibility = ["//:__subpackages__"],
    deps = all_crate_deps(
        package_name = "terraform/private/tools/terraform_lock",
        normal = True,
    ) + [
        ":terraform_lock_lib",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
    ],
)

rust_test(
    name = "resolve_test",
    size = "small",
    srcs = ["resolve_test.rs"],
    aliases = aliases(
        package_name = "terraform/private/tools/terraform_lock",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "resolve_test",
    crate_root = "resolve_test.rs",
    data = [
        "testdata/download_darwin_arm64.json",
        "testdata/download_linux_amd64.json",
        "testdata/golden.lock.json",
        "testdata/golden.terraform.lock.hcl",
        "testdata/versions.json",
    ],
    env = {
        "GOLDEN": "$(rootpath testdata/golden.lock.json)",
        "GOLDEN_STATE": "$(rootpath testdata/golden.terraform.lock.hcl)",
        "VERSIONS": "$(rootpath testdata/versions.json)",
        "DOWNLOAD_DARWIN_ARM64": "$(rootpath testdata/download_darwin_arm64.json)",
        "DOWNLOAD_LINUX_AMD64": "$(rootpath testdata/download_linux_amd64.json)",
    },
    tags = ["block-network"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = all_crate_deps(
        package_name = "terraform/private/tools/terraform_lock",
        normal = True,
        normal_dev = True,
    ) + [
        ":terraform_lock_lib",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//:__subpackages__"],
)

exports_files(
    [
        "src/main.rs",
    ],
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
