"""Builds the Apache Thrift compiler from the release tarball."""

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_java//java:java_library.bzl", "java_library")
load("@rules_rust//rust:defs.bzl", "rust_library")

# Generators register through static constructors in t_generator_registry.h, so every
# generator source is compiled straight into the binary rather than via a library.
cc_binary(
    name = "thrift_compiler",
    srcs = glob([
        "compiler/cpp/src/thrift/**/*.cc",
        "compiler/cpp/src/thrift/**/*.cpp",
        "compiler/cpp/src/thrift/**/*.h",
        "compiler/cpp/src/thrift/**/*.hh",
    ], exclude = [
        # Test-only duplicate of the diagnostics main.cc defines.
        "compiler/cpp/src/thrift/logging.cc",
    ]),
    copts = select({
        "@platforms//os:windows": ["/w"],
        "//conditions:default": ["-w"],
    }),
    includes = ["compiler/cpp/src"],
    linkopts = select({
        "@platforms//os:windows": [
            "ole32.lib",
            "uuid.lib",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)

# A real upstream schema, used by the thrift_library cross-repo analysis test.
filegroup(
    name = "sample_schema",
    srcs = ["test/ThriftTest.thrift"],
    visibility = ["//visibility:public"],
)

genrule(
    name = "cpp_config",
    outs = ["cpp_config/thrift/config.h"],
    cmd = "printf '#pragma once\\n#include <arpa/inet.h>\\n#define HAVE_STRERROR_R 1\\n#if defined(__GLIBC__) && defined(_GNU_SOURCE)\\n#define STRERROR_R_CHAR_P 1\\n#endif\\n' > $@",
)

cc_library(
    name = "cpp_runtime",
    srcs = [
        "lib/cpp/src/thrift/TApplicationException.cpp",
        "lib/cpp/src/thrift/TOutput.cpp",
        "lib/cpp/src/thrift/async/TConcurrentClientSyncInfo.cpp",
        "lib/cpp/src/thrift/concurrency/Monitor.cpp",
        "lib/cpp/src/thrift/concurrency/Mutex.cpp",
        "lib/cpp/src/thrift/protocol/TProtocol.cpp",
        "lib/cpp/src/thrift/transport/TBufferTransports.cpp",
        "lib/cpp/src/thrift/transport/TTransportException.cpp",
    ],
    hdrs = glob(
        [
            "lib/cpp/src/thrift/**/*.h",
            "lib/cpp/src/thrift/**/*.tcc",
        ],
        exclude = [
            "lib/cpp/src/thrift/windows/**",
            "lib/cpp/src/thrift/qt/**",
        ],
    ) + [":cpp_config"],
    copts = ["-w"],
    linkopts = ["-lpthread"],
    includes = [
        "cpp_config",
        "lib/cpp/src",
    ],
    visibility = ["//visibility:public"],
)

java_library(
    name = "java_runtime",
    srcs = glob(
        ["lib/java/src/main/java/**/*.java"],
        exclude = [
            "lib/java/src/main/java/org/apache/thrift/server/TExtensibleServlet.java",
            "lib/java/src/main/java/org/apache/thrift/server/TServlet.java",
            "lib/java/src/main/java/org/apache/thrift/THttpClientResponseHandler.java",
            "lib/java/src/main/java/org/apache/thrift/transport/THttpClient.java",
        ],
    ),
    exports = ["@dx_thrift_slf4j//jar"],
    javacopts = [
        "-Xlint:none",
        "-nowarn",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@dx_thrift_commons_lang3//jar",
        "@dx_thrift_slf4j//jar",
    ],
)

rust_library(
    name = "rust_runtime",
    srcs = glob(["lib/rs/src/**/*.rs"]),
    crate_features = ["server"],
    crate_name = "thrift",
    crate_root = "lib/rs/src/lib.rs",
    edition = "2018",
    rustc_flags = ["--cap-lints=allow"],
    visibility = ["//visibility:public"],
    deps = [
        "@dx_thrift_crates//:byteorder",
        "@dx_thrift_crates//:log",
        "@dx_thrift_crates//:ordered-float",
        "@dx_thrift_crates//:threadpool",
        "@dx_thrift_crates//:uuid",
        "@dx_thrift_crates//:varint-rs",
    ],
)
