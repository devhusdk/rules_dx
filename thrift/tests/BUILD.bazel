load("@rules_dx//quality:fixtures.bzl", "real_source_target")

# gazelle:dx_ignore_import cc common_types.h
# gazelle:dx_ignore_import cc shape_types.h

load("//cc/rules:defs.bzl", "cc_test")
load("//generation:codegen_tests.bzl", "codegen_shard_argv_test")
load("//java/rules:defs.bzl", "java_test")
load("//thrift/rules:codegen.bzl", "thrift_cc_library", "thrift_codegen_shard", "thrift_java_library", "thrift_rust_library")

package(default_visibility = ["//visibility:private"])

thrift_cc_library(
    name = "shapes_cc",
    deps = [
        "//thrift/tests/api",
        "//thrift/tests/base",
    ],
)

cc_test(
    name = "cc_roundtrip_test",
    size = "small",
    srcs = ["cc_roundtrip_test.cc"],
    copts = ["-std=c++17"],
    deps = [":shapes_cc"],
)

thrift_java_library(
    name = "shapes_java",
    deps = [
        "//thrift/tests/api",
        "//thrift/tests/base",
    ],
)

java_test(
    name = "JavaRoundtripTest",
    size = "small",
    srcs = ["JavaRoundtripTest.java"],
    main_class = "JavaRoundtripTest",
    tags = ["no-lint"],
    test_class = "JavaRoundtripTest",
    use_testrunner = False,
    deps = [":shapes_java"],
)

thrift_rust_library(
    name = "shapes_rs",
    deps = [
        "//thrift/tests/api",
        "//thrift/tests/base",
    ],
)

thrift_codegen_shard(
    name = "shapes_rs_shard",
    entries = [
        "gen/lib.rs|gen|dx|thrift/tests/shapes_rs_generated_thrift_rs/lib.rs",
        "gen/common.rs|gen|dx|thrift/tests/shapes_rs_generated_thrift_rs/common.rs",
        "gen/shape.rs|gen|dx|thrift/tests/shapes_rs_generated_thrift_rs/shape.rs",
    ],
    language = "rust",
    library = ":shapes_rs_generated",
)

codegen_shard_argv_test(
    name = "shapes_rs_shard_argv_test",
    expected = [
        "--producer",
        "//thrift/tests:shapes_rs_shard",
        "--language",
        "rust",
        "--entry",
        "gen/lib.rs|gen|dx|thrift/tests/shapes_rs_generated_thrift_rs/lib.rs",
        "--entry",
        "gen/common.rs|gen|dx|thrift/tests/shapes_rs_generated_thrift_rs/common.rs",
        "--entry",
        "gen/shape.rs|gen|dx|thrift/tests/shapes_rs_generated_thrift_rs/shape.rs",
        "--output",
    ],
    output = "thrift/tests/shapes_rs_shard.dxcodegen.pb",
    target_under_test = ":shapes_rs_shard",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
