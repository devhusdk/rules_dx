load("@rules_dx//quality:fixtures.bzl", "real_source_target")

# gazelle:dx_ignore_import cc common_types.h
# gazelle:dx_ignore_import cc shape_types.h

load("//cc/rules:defs.bzl", "cc_test")
load("//java/rules:defs.bzl", "java_test")
load("//thrift/rules:codegen.bzl", "thrift_cc_library", "thrift_java_library", "thrift_rust_library")

package(default_visibility = ["//visibility:private"])

thrift_cc_library(
    name = "shapes_cc",
    deps = [
        "//thrift/tests/api",
        "//thrift/tests/base",
    ],
)

cc_test(
    name = "cc_roundtrip_test",
    size = "small",
    srcs = ["cc_roundtrip_test.cc"],
    copts = ["-std=c++17"],
)

thrift_java_library(
    name = "shapes_java",
    deps = [
        "//thrift/tests/api",
        "//thrift/tests/base",
    ],
)

java_test(
    name = "JavaRoundtripTest",
    size = "small",
    srcs = ["JavaRoundtripTest.java"],
    main_class = "JavaRoundtripTest",
    tags = ["no-lint"],
    test_class = "JavaRoundtripTest",
    use_testrunner = False,
    deps = [":shapes_java"],
)

thrift_rust_library(
    name = "shapes_rs",
    deps = [
        "//thrift/tests/api",
        "//thrift/tests/base",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
