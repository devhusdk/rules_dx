# gazelle:ignore
# gazelle:resolve cc common_types.h //thrift/tests:shapes_cc
# gazelle:resolve cc shape_types.h //thrift/tests:shapes_cc
load("//quality:fixtures.bzl", "real_source_target")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//cc/rules:defs.bzl", "cc_test")
load("//generation:codegen_tests.bzl", "codegen_shard_argv_test")
load("//java:defs.bzl", "java_test")
load("//thrift:defs.bzl", "thrift_cc_library", "thrift_codegen_shard", "thrift_java_library", "thrift_rust_library")

package(default_visibility = ["//visibility:private"])

thrift_cc_library(
    name = "shapes_cc",
    deps = [
        "//thrift/tests/api",
        "//thrift/tests/base",
    ],
)

cc_test(
    name = "cc_roundtrip_test",
    srcs = ["cc_roundtrip_test.cc"],
    copts = ["-std=c++17"],
    linkstatic = True,
    deps = [":shapes_cc"],  # keep
)

thrift_codegen_shard(
    name = "shapes_cc_shard",
    entries = [
        "gen/base/common.srcjar|gen|dx|thrift/tests/base/_thrift_cc/base.srcjar",
        "gen/api/shape.srcjar|gen|dx|thrift/tests/api/_thrift_cc/api.srcjar",
    ],
    language = "cpp",
    generated = ":shapes_cc",
)

codegen_shard_argv_test(
    name = "shapes_cc_shard_argv_test",
    expected = [
        "--producer",
        "//thrift/tests:shapes_cc_shard",
        "--language",
        "cpp",
        "--entry",
        "gen/base/common.srcjar|gen|dx|thrift/tests/base/_thrift_cc/base.srcjar",
        "--entry",
        "gen/api/shape.srcjar|gen|dx|thrift/tests/api/_thrift_cc/api.srcjar",
        "--output",
    ],
    output = "thrift/tests/shapes_cc_shard.dxcodegen.pb",
    target_under_test = ":shapes_cc_shard",
)

thrift_java_library(
    name = "shapes_java",
    deps = [
        "//thrift/tests/api",
        "//thrift/tests/base",
    ],
)

java_test(
    name = "JavaRoundtripTest",
    srcs = ["JavaRoundtripTest.java"],
    main_class = "JavaRoundtripTest",
    tags = ["no-lint"],
    test_class = "JavaRoundtripTest",
    use_testrunner = False,
    deps = [":shapes_java"],
)

thrift_codegen_shard(
    name = "shapes_java_shard",
    entries = [
        "gen/base/common.srcjar|gen|dx|thrift/tests/base/_thrift_java/base.srcjar",
        "gen/api/shape.srcjar|gen|dx|thrift/tests/api/_thrift_java/api.srcjar",
    ],
    language = "java",
    generated = ":shapes_java",
)

codegen_shard_argv_test(
    name = "shapes_java_shard_argv_test",
    expected = [
        "--producer",
        "//thrift/tests:shapes_java_shard",
        "--language",
        "java",
        "--entry",
        "gen/base/common.srcjar|gen|dx|thrift/tests/base/_thrift_java/base.srcjar",
        "--entry",
        "gen/api/shape.srcjar|gen|dx|thrift/tests/api/_thrift_java/api.srcjar",
        "--output",
    ],
    output = "thrift/tests/shapes_java_shard.dxcodegen.pb",
    target_under_test = ":shapes_java_shard",
)

thrift_rust_library(
    name = "shapes_rs",
    library = "//thrift/tests/api",
)

thrift_codegen_shard(
    name = "shapes_rs_shard",
    entries = [
        "gen/lib.rs|gen|dx|thrift/tests/shapes_rs_generated_thrift_rs/lib.rs",
        "gen/common.rs|gen|dx|thrift/tests/shapes_rs_generated_thrift_rs/common.rs",
        "gen/shape.rs|gen|dx|thrift/tests/shapes_rs_generated_thrift_rs/shape.rs",
    ],
    language = "rust",
    generated = ":shapes_rs_generated",
)

codegen_shard_argv_test(
    name = "shapes_rs_shard_argv_test",
    expected = [
        "--producer",
        "//thrift/tests:shapes_rs_shard",
        "--language",
        "rust",
        "--entry",
        "gen/lib.rs|gen|dx|thrift/tests/shapes_rs_generated_thrift_rs/lib.rs",
        "--entry",
        "gen/common.rs|gen|dx|thrift/tests/shapes_rs_generated_thrift_rs/common.rs",
        "--entry",
        "gen/shape.rs|gen|dx|thrift/tests/shapes_rs_generated_thrift_rs/shape.rs",
        "--output",
    ],
    output = "thrift/tests/shapes_rs_shard.dxcodegen.pb",
    target_under_test = ":shapes_rs_shard",
)

sh_test(
    name = "undeclared_include_test",
    size = "small",
    srcs = ["undeclared_include_test.sh"],
    data = [
        "undeclared.thrift",
        "//thrift:thrift_compiler",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//:__pkg__"],
)
