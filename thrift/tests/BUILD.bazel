# gazelle:ignore
# gazelle:resolve cc common_types.h //thrift/tests:shapes_cc
# gazelle:resolve cc shape_types.h //thrift/tests:shapes_cc
load("//core/quality:fixtures.bzl", "real_source_target")
load("//cc:defs.bzl", "cc_test")
load("//core/codegen:codegen_tests.bzl", "codegen_shard_argv_test")
load("//java:defs.bzl", "java_test")
load("//rust:defs.bzl", "rust_test")
load("//thrift:defs.bzl", "thrift_cc_library", "thrift_java_library", "thrift_rust_library")
load(":defs_tests.bzl", "thrift_library_tests")
load(":failure_tests.bzl", "thrift_undeclared_rust_test")

package(default_visibility = ["//visibility:private"])

thrift_library_tests(name = "thrift_library_tests")

thrift_cc_library(
    name = "shapes_cc",
    deps = [
        "//thrift/tests/api",
        "//thrift/tests/base",
    ],
)

cc_test(
    name = "cc_roundtrip_test",
    srcs = ["cc_roundtrip_test.cc"],
    copts = select({
        "@platforms//os:windows": ["/std:c++17"],
        "//conditions:default": ["-std=c++17"],
    }),
    linkstatic = True,
    deps = [":shapes_cc"],  # keep
    # Windows: generated code includes arpa/inet.h.
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

codegen_shard_argv_test(
    name = "shapes_cc_shard_argv_test",
    expected = [
        "--producer",
        "//thrift/tests:shapes_cc",
        "--language",
        "cpp",
        "--entry",
        "gen/thrift/tests/api/api.srcjar|gen||thrift/tests/api/_thrift_cc/api.srcjar",
        "--entry",
        "gen/thrift/tests/base/base.srcjar|gen||thrift/tests/base/_thrift_cc/base.srcjar",
        "--output",
    ],
    output = "thrift/tests/shapes_cc.dxcodegen.pb",
    target_under_test = ":shapes_cc",
)

thrift_java_library(
    name = "shapes_java",
    deps = [
        "//thrift/tests/api",
        "//thrift/tests/base",
    ],
)

java_test(
    name = "JavaRoundtripTest",
    srcs = ["JavaRoundtripTest.java"],
    main_class = "JavaRoundtripTest",
    tags = ["no-lint"],
    test_class = "JavaRoundtripTest",
    use_testrunner = False,
    deps = [":shapes_java"],
)

codegen_shard_argv_test(
    name = "shapes_java_shard_argv_test",
    expected = [
        "--producer",
        "//thrift/tests:shapes_java",
        "--language",
        "java",
        "--entry",
        "gen/thrift/tests/api/api.srcjar|gen||thrift/tests/api/_thrift_java/api.srcjar",
        "--entry",
        "gen/thrift/tests/base/base.srcjar|gen||thrift/tests/base/_thrift_java/base.srcjar",
        "--output",
    ],
    output = "thrift/tests/shapes_java.dxcodegen.pb",
    target_under_test = ":shapes_java",
)

thrift_rust_library(
    name = "shapes_rs",
    library = "//thrift/tests/api",
)

codegen_shard_argv_test(
    name = "shapes_rs_shard_argv_test",
    expected = [
        "--producer",
        "//thrift/tests:shapes_rs_generated",
        "--language",
        "rust",
        "--entry",
        "gen/lib.rs|gen||thrift/tests/shapes_rs_generated_thrift_rs/lib.rs",
        "--entry",
        "gen/common.rs|gen||thrift/tests/shapes_rs_generated_thrift_rs/common.rs",
        "--entry",
        "gen/shape.rs|gen||thrift/tests/shapes_rs_generated_thrift_rs/shape.rs",
        "--output",
    ],
    output = "thrift/tests/shapes_rs_generated.dxcodegen.pb",
    target_under_test = ":shapes_rs_generated",
)

thrift_undeclared_rust_test(
    name = "undeclared_rs_test",
    size = "small",
    target_under_test = "//thrift/tests/fixtures/lost:lost_rs_generated",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "defs_tests.bzl",
        "failure_tests.bzl",
    ],
    tags = ["corpus"],
    visibility = ["//:__pkg__"],
)

rust_test(
    name = "rust_roundtrip_test",
    srcs = ["rs_roundtrip_test.rs"],
    deps = [
        ":shapes_rs",
        "@dx_thrift//:rust_runtime",
    ],
)

real_source_target(
    name = "corpus_toml",
    testonly = True,
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
