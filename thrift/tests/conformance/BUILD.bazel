load("//core/quality:fixtures.bzl", "real_source_target")
load("//thrift:defs.bzl", "thrift_cc_library", "thrift_java_library", "thrift_library", "thrift_rust_library")
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite")

# The dirty fixtures stay in their own manual targets; gazelle would merge them
# into the clean library.
# gazelle:exclude lint_dirty.thrift

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

thrift_library(
    name = "conformance",
    testonly = True,
    srcs = ["clean.thrift"],
)

# keep
thrift_library(
    name = "lint_dirty",
    srcs = ["lint_dirty.thrift"],
    tags = ["manual"],
)

dx_conformance_suite(
    name = "",
    size = "small",
    binary = ":conformance",
    covered_source = "",
    expected = "",
    failing_case = "",
    failing_test = ":conformance",
    lang = "thrift",
    not_applicable = {
        "build_test": "thrift has no binary rule",
        "coverage_test": "thrift has no test rule",
        "cross_test": "thrift has no binary rule",
        "fail_test": "thrift has no test rule",
        "format_error_test": "the thrift compiler has no formatter",
        "format_test": "the thrift compiler has no formatter",
        "lock_test": "thrift has no package manager",
        "pass_test": "thrift has no test rule",
        "runfiles_test": "thrift has no binary rule",
    },
    passing_test = ":conformance",
    quality = {
        "clean": ":conformance",
        "lint_dirty": ":lint_dirty",
        "lint_line": 4,
        "lint_rule": "error",
        "lint_source": "lint_dirty.thrift",
    },
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

thrift_cc_library(
    name = "conformance_cc",
    testonly = True,
    visibility = ["//visibility:public"],
    deps = [":conformance"],
)

thrift_java_library(
    name = "conformance_java",
    testonly = True,
    visibility = ["//visibility:public"],
    deps = [":conformance"],
)

thrift_rust_library(
    name = "conformance_rust",
    testonly = True,
    library = ":conformance",
    visibility = ["//visibility:public"],
)
