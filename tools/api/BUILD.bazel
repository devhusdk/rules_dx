load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//core/modules:langs.bzl", "LANGS")
load("//rust:defs.bzl", "rust_binary", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")

package(default_visibility = VIS_TOOLS)

_DEPS = [
    "//cli/digest:dx_digest",
    "//cli/dx_config",
    "//cli/module_bazel:dx_module_bazel",
    "//cli/output:dx_output",
    "//cli/plan:dx_plan",
    "@crates//:serde",
    "@crates//:serde_json",
]

_SNAPSHOT_SRCS = [
    "//cli/dx_config:schema/dx.schema.json",
    "//cli/output:schema/events.schema.json",
    "//config:BUILD.bazel",
]

_LANG_BUILDS = ["//%s:BUILD.bazel" % lang for lang in sorted(LANGS)]

_LANG_ENV = {"DX_API_LANG_BUILDS": " ".join(["$(rootpath %s)" % build for build in _LANG_BUILDS])}

# Rewrites api/ and docs/supported-surface.md from the code. Run it when api_test says the public API changed.
rust_binary(
    name = "update",
    srcs = [
        "page.rs",
        "snapshot.rs",
        "update.rs",
    ],
    compile_data = _SNAPSHOT_SRCS,
    crate_name = "update",
    crate_root = "update.rs",
    data = _LANG_BUILDS,
    env = _LANG_ENV,
    deps = _DEPS,
)

rust_test(
    name = "api_test",
    size = "small",
    srcs = [
        "api_test.rs",
        "page.rs",
        "snapshot.rs",
    ],
    compile_data = _SNAPSHOT_SRCS,
    crate_name = "api_test",
    crate_root = "api_test.rs",
    data = [
        "//api:snapshot",
        "//docs:supported-surface.md",
    ] + _LANG_BUILDS,
    env = _LANG_ENV | {
        "DX_API_SNAPSHOT": "$(rlocationpaths //api:snapshot)",
        "DX_SURFACE_PAGE": "$(rlocationpath //docs:supported-surface.md)",
    },
    deps = _DEPS + ["//tools/testing:dx_testing"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
