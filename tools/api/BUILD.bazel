load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//core/modules:langs.bzl", "LANGS")
load("//rust:defs.bzl", "rust_binary", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")
load(":bzl_srcs.bzl", "bzl_srcs")
load(":public_builds.bzl", "public_builds")

package(default_visibility = VIS_TOOLS)

_DEPS = [
    "//cli/digest:dx_digest",
    "//cli/dx_config",
    "//cli/families:dx_families",
    "//cli/module_bazel:dx_module_bazel",
    "//cli/output:dx_output",
    "//cli/plan:dx_plan",
    "//tools/api/stardoc:stardoc_output_proto_rs",
    "@crates//:serde",
    "@crates//:serde_json",
    "@rules_rust_prost//private/3rdparty/crates:prost",
]

_SNAPSHOT_SRCS = [
    "//cli/dx_config:schema/dx.schema.json",
    "//cli/output:schema/events.schema.json",
    "//config:BUILD.bazel",
]

_LANG_BUILDS = ["//%s:BUILD.bazel" % lang for lang in sorted(LANGS)]

_COMMAND_BUILDS = [
    "//:BUILD.bazel",
    "//deploy:BUILD.bazel",
    "//dx:BUILD.bazel",
    "//dx/advisory_prep:BUILD.bazel",
    "//dx/tool_resolve:BUILD.bazel",
]

_BUILDS_ENV = {
    "DX_API_COMMAND_BUILDS": " ".join(["$(rootpath %s)" % build for build in _COMMAND_BUILDS]),
    "DX_API_LANG_BUILDS": " ".join(["$(rootpath %s)" % build for build in _LANG_BUILDS]),
    "DX_API_PACKAGE_BUILDS": "$(rootpaths :public_builds)",
}

_STARLARK_SRCS = [
    "//api_spec:defs.bzl",
    "//apple:extensions.bzl",
    "//avro:extensions.bzl",
    "//bicep:defs.bzl",
    "//bicep:extensions.bzl",
    "//core:defs.bzl",
    "//core:extensions.bzl",
    "//dotnet:defs.bzl",
    "//helm:defs.bzl",
    "//lua:defs.bzl",
    "//lua:extensions.bzl",
    "//php:defs.bzl",
    "//php:extensions.bzl",
    "//powershell:extensions.bzl",
    "//qt:extensions.bzl",
    "//rego:defs.bzl",
    "//sql:defs.bzl",
    "//terraform:defs.bzl",
    "//terraform:extensions.bzl",
    "//zig:extensions.bzl",
]

_STARLARK_DOCS = {
    "doc_" + src.removeprefix("//").removesuffix(".bzl").replace(":", "_"): src
    for src in _STARLARK_SRCS
}

bzl_srcs(
    name = "repo_bzl",
    srcs = ["//:module_srcs"],
)

[
    starlark_doc_extract(
        name = name,
        src = src,
        render_main_repo_name = True,
        deps = [
            ":repo_bzl",
            "@bazel_tools//tools:bzl_srcs",
        ],
    )
    for name, src in _STARLARK_DOCS.items()
]

public_builds(
    name = "public_builds",
    srcs = ["//:module_srcs"],
)

filegroup(
    name = "starlark_docs",
    srcs = [":%s.binaryproto" % name for name in _STARLARK_DOCS],
)

# Rewrites api/ and docs/supported-surface.md from the code. Run it when api_test says the public API changed.
rust_binary(
    name = "update",
    srcs = [
        "page.rs",
        "snapshot.rs",
        "update.rs",
    ],
    compile_data = _SNAPSHOT_SRCS,
    crate_name = "update",
    crate_root = "update.rs",
    data = [
        ":public_builds",
        ":starlark_docs",
    ] + _LANG_BUILDS + _COMMAND_BUILDS,
    env = _BUILDS_ENV | {"DX_API_STARLARK": "$(rlocationpaths :starlark_docs)"},
    deps = _DEPS + ["@rules_rust//rust/runfiles"],
)

rust_test(
    name = "api_test",
    size = "small",
    srcs = [
        "api_test.rs",
        "page.rs",
        "snapshot.rs",
    ],
    compile_data = _SNAPSHOT_SRCS,
    crate_name = "api_test",
    crate_root = "api_test.rs",
    data = [
        ":public_builds",
        ":starlark_docs",
        "//api:snapshot",
        "//docs:supported-surface.md",
    ] + _LANG_BUILDS + _COMMAND_BUILDS,
    env = _BUILDS_ENV | {
        "DX_API_STARLARK": "$(rlocationpaths :starlark_docs)",
        "DX_API_SNAPSHOT": "$(rlocationpaths //api:snapshot)",
        "DX_SURFACE_PAGE": "$(rlocationpath //docs:supported-surface.md)",
    },
    deps = _DEPS + ["//tools/testing:dx_testing"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "bzl_srcs.bzl",
        "public_builds.bzl",
    ],
    tags = ["corpus"],
)
