# Fixtures whose forwards genquery does not build on every host. A genquery loads every select branch of its scope.
_SWIFT_FORMAT = "swift-format is pinned for macos_arm64 only and fails to fetch on every other host (#14051)"

_FORWARDS_PENDING = {
    "android": "closure selects every host's SDK (#14050)",
    "apple": _SWIFT_FORMAT + "; macros take no **kwargs (#14051)",
    "cuda": "closure selects every host's SDK (#14050)",
    "erlang": "update: generator_function erlc_opts names no public function with a **kwargs param",
    "flutter": "not extracted (#14040, #14050)",
    "qt": "closure selects every host's SDK (#14050)",
    "swift": _SWIFT_FORMAT,
}

_FORWARDS_SUBPACKAGES = {
    "haskell": ["src"],
    "ocaml": [
        "src",
        "test",
    ],
}

_FORWARDS_PACKAGES = {
    lang: ["%s/tests/consumer" % lang] + ["%s/tests/consumer/%s" % (lang, sub) for sub in _FORWARDS_SUBPACKAGES.get(lang, [])]
    for lang in CONSUMER_FIXTURES
    if lang not in _FORWARDS_PENDING
} | {"bcr_test_module": ["bcr_test_module"]}

[fail("_FORWARDS_PENDING names %s, which is not in CONSUMER_FIXTURES" % lang) for lang in _FORWARDS_PENDING if lang not in CONSUMER_FIXTURES]

[
    genquery(
        name = "forwards_" + name,
        expression = "attr(generator_function, '.', deps(%s, 1))" % " + ".join([
            "@dx_api_fixtures//%s:dx_api_forwards_scope" % package
            for package in packages
        ]),
        opts = [
            "--output=streamed_jsonproto",
            "--proto:default_values=false",
            "--proto:rule_inputs_and_outputs=false",
        ],
        scope = ["@dx_api_fixtures//%s:dx_api_forwards_scope" % package for package in packages],
    )
    for name, packages in _FORWARDS_PACKAGES.items()
]

filegroup(
    name = "forwards",
    srcs = [":forwards_" + name for name in _FORWARDS_PACKAGES],
)

# Rewrites api/ and docs/supported-surface.md from the code. Run it when api_test says the public API changed.
rust_binary(
    name = "update",
    srcs = [
        "page.rs",
        "snapshot.rs",
        "update.rs",
    ],
    compile_data = _SNAPSHOT_SRCS,
    crate_name = "update",
    crate_root = "update.rs",
    data = [
        ":forwards",
        ":public_builds",
        ":starlark_docs",
    ] + _LANG_BUILDS + _COMMAND_BUILDS,
    env = _BUILDS_ENV | {
        "DX_API_FORWARDS": "$(rlocationpaths :forwards)",
        "DX_API_STARLARK": "$(rlocationpaths :starlark_docs)",
    },
    deps = _DEPS + ["@rules_rust//rust/runfiles"],
)

rust_test(
    name = "api_test",
    size = "small",
    srcs = [
        "api_test.rs",
        "page.rs",
        "snapshot.rs",
    ],
    compile_data = _SNAPSHOT_SRCS,
    crate_name = "api_test",
    crate_root = "api_test.rs",
    data = [
        ":forwards",
        ":public_builds",
        ":public_bzl",
        ":starlark_docs",
        "//api:snapshot",
        "//docs:supported-surface.md",
    ] + _LANG_BUILDS + _COMMAND_BUILDS,
    env = _BUILDS_ENV | {
        "DX_API_FORWARDS": "$(rlocationpaths :forwards)",
        "DX_API_EXTRACTED": " ".join(_STARLARK_SRCS),
        "DX_API_NOT_EXTRACTED": " ".join(_NOT_EXTRACTED),
        "DX_API_PUBLIC_BZL": "$(rootpaths :public_bzl)",
        "DX_API_STARLARK": "$(rlocationpaths :starlark_docs)",
        "DX_API_SNAPSHOT": "$(rlocationpaths //api:snapshot)",
        "DX_SURFACE_PAGE": "$(rlocationpath //docs:supported-surface.md)",
    },
    deps = _DEPS + ["//tools/testing:dx_testing"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "bzl_srcs.bzl",
        "public_builds.bzl",
    ],
    tags = ["corpus"],
)
