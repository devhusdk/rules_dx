load("@crates//:crates.bzl", "aliases", "crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")
load(":preset_tests.bzl", "preset_update_tests")

package(default_visibility = ["//:__subpackages__"])

rust_library(
    name = "dx_preset",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "tools/dx_preset",
        normal = True,
    ),
    crate_name = "dx_preset",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = crate_deps(
        [],
        package_name = "tools/dx_preset",
    ),
)

rust_test(
    name = "dx_preset_test",
    size = "small",
    aliases = aliases(
        package_name = "tools/dx_preset",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_preset",
    deps = crate_deps(
        ["tempfile"],
        package_name = "tools/dx_preset",
    ),
)

rustfmt_test(
    name = "dx_preset_fmt_test",
    size = "small",
    targets = [
        ":dx_preset",
        ":preset_update",
        ":preset_update_bin_test",
    ],
)

rust_clippy_test(
    name = "dx_preset_clippy_test",
    size = "small",
    targets = [
        ":dx_preset",
        ":preset_update",
    ],
)

exports_files([
    "Cargo.toml",
    "preset.bazelrc",
    "src/bin_preset_update.rs",
    "src/lib.rs",
])

preset_update_tests(name = "preset_update_test")

test_suite(
    name = "all",
    tests = [
        ":preset_update_bin_test",
        ":preset_update_test",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "preset_tests.bzl",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

rust_binary(
    name = "preset_update",
    srcs = ["src/bin_preset_update.rs"],
    aliases = aliases(
        package_name = "tools/dx_preset",
        normal = True,
    ),
    crate_name = "preset_update",
    crate_root = "src/bin_preset_update.rs",
    edition = "2021",
    deps = crate_deps(
        [],
        package_name = "tools/dx_preset",
    ) + [":dx_preset"],
)

# keep
rust_test(
    name = "preset_update_bin_test",
    size = "small",
    aliases = aliases(
        package_name = "tools/dx_preset",
        normal = True,
        normal_dev = True,
    ),
    crate = ":preset_update",
    deps = crate_deps(
        ["tempfile"],
        package_name = "tools/dx_preset",
    ) + [":dx_preset"],
)
