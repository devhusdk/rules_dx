load("@crates//:crates.bzl", "aliases")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/testing/hermetic:defs.bzl", "nested_bazel_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_CLI_TEST")

package(default_visibility = VIS_TOOLS)

rust_library(
    name = "dx_preset",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "tools/dx_preset",
        normal = True,
    ),
    crate_name = "dx_preset",
    crate_root = "src/lib.rs",
    rustc_env_files = ["@dx_bazel_version//:rustc_env"],
    visibility = VIS_TOOLS_CLI_TEST,
    deps = [],
)

rust_test(
    name = "dx_preset_test",
    size = "small",
    aliases = aliases(
        package_name = "tools/dx_preset",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_preset",
    deps = [],
)

nested_bazel_test(
    name = "ci_remote_outage_test",
    size = "large",
    timeout = "moderate",
    srcs = ["ci_remote_outage_test.rs"],
    cache = "harness",
    cache_locks = "//tools/testing/nested_cache:harness_locks",
    crate_name = "ci_remote_outage_test",
    crate_root = "ci_remote_outage_test.rs",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":dx_preset",
        "//tools/testing:dx_testing",
        "//tools/testing/nested:dx_nested",
    ],
)

exports_files(
    [
        "Cargo.toml",
        "src/lib.rs",
    ],
    visibility = VIS_TOOLS,
)

test_suite(
    name = "all",
    tests = [
        ":ci_remote_outage_test",
        ":dx_preset_test",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "repos.bzl",
        "extensions.bzl",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
