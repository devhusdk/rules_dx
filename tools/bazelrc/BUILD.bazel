load("@crates//:crates.bzl", "aliases")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_CLI_TEST")

package(default_visibility = VIS_TOOLS)

rust_library(
    name = "dx_preset",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "tools/dx_preset",
        normal = True,
    ),
    crate_name = "dx_preset",
    crate_root = "src/lib.rs",
    rustc_env_files = ["@dx_bazel_version//:rustc_env"],
    visibility = VIS_TOOLS_CLI_TEST,
    deps = [],
)

rust_test(
    name = "dx_preset_test",
    aliases = aliases(
        package_name = "tools/dx_preset",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_preset",
    deps = [],
)

exports_files(
    [
        "Cargo.toml",
        "src/lib.rs",
    ],
    visibility = VIS_TOOLS,
)

test_suite(
    name = "all",
    tests = [":dx_preset_test"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "repos.bzl",
        "extensions.bzl",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
