load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust:defs.bzl", "rust_library")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")

package(default_visibility = VIS_TOOLS)

rust_library(
    name = "ci_workflow",
    testonly = True,
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "tools/ci/ci_workflow",
        normal = True,
    ),
    crate_name = "ci_workflow",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "tools/ci/ci_workflow",
        normal = True,
    ) + [
        "//tools/testing:dx_testing",
        "@crates//:serde_json",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    [
        "src/lib.rs",
    ],
    visibility = ["//core/quality:__pkg__"],
)
