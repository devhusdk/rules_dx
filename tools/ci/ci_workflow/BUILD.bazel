load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")

package(default_visibility = VIS_TOOLS)

rust_library(
    name = "ci_workflow",
    testonly = True,
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "tools/ci/ci_workflow",
        normal = True,
    ),
    crate_name = "ci_workflow",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "tools/ci/ci_workflow",
        normal = True,
    ) + [
        "//tools/testing:dx_testing",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "ci_workflow_test",
    srcs = ["tests/ci_workflow_test.rs"],
    aliases = aliases(
        package_name = "tools/ci/ci_workflow",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "ci_workflow_test",
    crate_root = "tests/ci_workflow_test.rs",
    data = [
        "//.github:actions",
        "//.github:workflows/ci.yml",
        "//.github:workflows/gate.yml",
        "//.github:workflows/reusable-consumer.yml",
    ],
    deps = all_crate_deps(
        package_name = "tools/ci/ci_workflow",
        normal = True,
        normal_dev = True,
    ) + [
        ":ci_workflow",
        "@crates//:serde_json",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
