load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust:defs.bzl", "rust_binary", "rust_library")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")

package(default_visibility = VIS_TOOLS)

rust_library(
    name = "coverage_cells",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "tools/ci/ci_coverage_cells",
        normal = True,
    ),
    crate_name = "coverage_cells",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "tools/ci/ci_coverage_cells",
        normal = True,
    ) + ["@crates//:serde_json"],
)

rust_binary(
    name = "coverage_cells_bin",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "tools/ci/ci_coverage_cells",
        normal = True,
    ),
    crate_name = "coverage_cells_bin",
    crate_root = "src/main.rs",
    deps = all_crate_deps(
        package_name = "tools/ci/ci_coverage_cells",
        normal = True,
    ) + [":coverage_cells"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    [
        "src/lib.rs",
        "src/main.rs",
    ],
    visibility = ["//core/quality:__pkg__"],
)
