load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")

package(default_visibility = VIS_TOOLS)

rust_library(
    name = "coverage_cells",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "tools/ci/coverage_cells",
        normal = True,
    ),
    crate_name = "coverage_cells",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "tools/ci/coverage_cells",
        normal = True,
    ) + ["@crates//:serde_json"],
)

rust_binary(
    name = "coverage_cells_bin",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "tools/ci/coverage_cells",
        normal = True,
    ),
    crate_name = "coverage_cells_bin",
    crate_root = "src/main.rs",
    deps = all_crate_deps(
        package_name = "tools/ci/coverage_cells",
        normal = True,
    ) + [":coverage_cells"],
)

rust_test(
    name = "coverage_cells_test",
    srcs = ["tests/coverage_cells_test.rs"],
    aliases = aliases(
        package_name = "tools/ci/coverage_cells",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "coverage_cells_test",
    crate_root = "tests/coverage_cells_test.rs",
    data = ["//tools/coverage:cells.txt"],
    deps = all_crate_deps(
        package_name = "tools/ci/coverage_cells",
        normal = True,
        normal_dev = True,
    ) + [
        ":coverage_cells",
        "//tools/testing:dx_testing",
        "@crates//:serde_json",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
