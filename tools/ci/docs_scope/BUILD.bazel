load("@crates//:crates.bzl", "aliases")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS)

rust_library(
    name = "docs_scope",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "tools/ci/docs_scope",
        normal = True,
    ),
    crate_name = "docs_scope",
    crate_root = "src/lib.rs",
    deps = [],
)

rust_binary(
    name = "docs_scope_bin",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "tools/ci/docs_scope",
        normal = True,
    ),
    crate_name = "docs_scope_bin",
    crate_root = "src/main.rs",
    visibility = VIS_TOOLS_PUBLIC,
    deps = [":docs_scope"],
)

rust_test(
    name = "docs_scope_test",
    srcs = ["tests/docs_scope_test.rs"],
    aliases = aliases(
        package_name = "tools/ci/docs_scope",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "docs_scope_test",
    crate_root = "tests/docs_scope_test.rs",
    data = [":docs_scope_bin"],
    env = {"DX_DOCS_SCOPE_BIN": "$(rootpath :docs_scope_bin)"},
    deps = [
        ":docs_scope",
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing:dx_testing",
    ],
)

exports_files(
    ["src/lib.rs"],
    visibility = VIS_TOOLS,
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
