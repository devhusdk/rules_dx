load("@crates//:crates.bzl", "aliases")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust:defs.bzl", "rust_binary", "rust_library")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")

package(default_visibility = VIS_TOOLS)

rust_library(
    name = "gate_base",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "tools/ci/ci_gate_base",
        normal = True,
    ),
    crate_name = "gate_base",
    crate_root = "src/lib.rs",
    deps = ["//cli/process:dx_process"],
)

rust_binary(
    name = "gate_base_bin",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "tools/ci/ci_gate_base",
        normal = True,
    ),
    crate_name = "gate_base_bin",
    crate_root = "src/main.rs",
    deps = [":gate_base"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
