load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS)

rust_library(
    name = "input_validation",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "tools/ci/input_validation",
        normal = True,
    ),
    crate_name = "input_validation",
    crate_root = "src/lib.rs",
    deps = [],
)

rust_binary(
    name = "input_validation_bin",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "tools/ci/input_validation",
        normal = True,
    ),
    crate_name = "input_validation_bin",
    crate_root = "src/main.rs",
    visibility = VIS_TOOLS_PUBLIC,
    deps = [":input_validation"],
)

rust_test(
    name = "input_validation_test",
    srcs = ["tests/input_validation_test.rs"],
    aliases = aliases(
        package_name = "tools/ci/input_validation",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "input_validation_test",
    crate_root = "tests/input_validation_test.rs",
    data = [
        ":input_validation_bin",
        "//.github:actionlint.yaml",
        "//.github:workflows/ci.yml",
        "//.github:workflows/release-cells.yml",
        "//.github:workflows/release-consumer.yml",
        "//docs:github-ci.md",
        "//examples:consumer-ci/caller.yml",
        "//tools/ci:input_validation_fixtures",
    ],
    env = {"DX_INPUT_VALIDATION": "$(rootpath :input_validation_bin)"},
    deps = all_crate_deps(
        package_name = "tools/ci/input_validation",
        normal = True,
        normal_dev = True,
    ) + [
        ":input_validation",
        "//cli/test_scratch:dx_test_scratch",
        "//tools/ci/evidence_inputs",
        "//tools/testing:dx_testing",
        "@crates//:serde_json",
    ],
)

exports_files(
    ["src/lib.rs"],
    visibility = VIS_TOOLS,
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
