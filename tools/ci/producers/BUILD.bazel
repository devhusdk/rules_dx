load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust:defs.bzl", "rust_binary", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")

package(default_visibility = VIS_TOOLS)

rust_binary(
    name = "producers_bin",
    testonly = True,
    srcs = [
        "src/blocker_refs.rs",
        "src/evidence.rs",
        "src/lock_merge.rs",
        "src/main.rs",
        "src/review_paths.rs",
    ],
    aliases = aliases(
        package_name = "tools/ci/ci_producers",
        normal = True,
    ),
    crate_name = "producers_bin",
    crate_root = "src/main.rs",
    deps = all_crate_deps(
        package_name = "tools/ci/ci_producers",
        normal = True,
    ) + [
        "//cli/binfmt:dx_binfmt",
        "//tools/testing:dx_testing",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "producers_bin_test",
    size = "small",
    aliases = aliases(
        package_name = "tools/ci/ci_producers",
        normal = True,
        normal_dev = True,
    ),
    crate = ":producers_bin",
    deps = all_crate_deps(
        package_name = "tools/ci/ci_producers",
        normal = True,
        normal_dev = True,
    ) + [
        "//cli/test_scratch:dx_test_scratch",
        "@crates//:serde_json",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    [
        "src/main.rs",
    ],
    visibility = ["//core/quality:__pkg__"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
