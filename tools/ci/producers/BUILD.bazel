load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust/rules:defs.bzl", "rust_binary")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")

package(default_visibility = VIS_TOOLS)

rust_binary(
    name = "producers_bin",
    testonly = True,
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "tools/ci/ci_producers",
        normal = True,
    ),
    crate_name = "producers_bin",
    crate_root = "src/main.rs",
    deps = all_crate_deps(
        package_name = "tools/ci/ci_producers",
        normal = True,
    ) + ["//libs/binfmt:dx_binfmt"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
