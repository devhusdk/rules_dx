load("@crates//:crates.bzl", "aliases")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS)

rust_library(
    name = "remote_cache_flags",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "tools/ci/remote_cache_flags",
        normal = True,
    ),
    crate_name = "remote_cache_flags",
    crate_root = "src/lib.rs",
    deps = [],
)

rust_binary(
    name = "remote_cache_flags_bin",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "tools/ci/remote_cache_flags",
        normal = True,
    ),
    crate_name = "remote_cache_flags_bin",
    crate_root = "src/main.rs",
    visibility = VIS_TOOLS_PUBLIC,
    deps = [":remote_cache_flags"],
)

rust_test(
    name = "remote_cache_flags_test",
    srcs = ["tests/remote_cache_flags_test.rs"],
    aliases = aliases(
        package_name = "tools/ci/remote_cache_flags",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "remote_cache_flags_test",
    crate_root = "tests/remote_cache_flags_test.rs",
    deps = [":remote_cache_flags"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
