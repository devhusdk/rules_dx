load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary")
load(":cells.bzl", "INVENTORY_FILES", "coverage_cells")
load(":cells_tests.bzl", "coverage_cells_tests")

package(default_visibility = ["//:__subpackages__"])

exports_files(INVENTORY_FILES)

coverage_cells(name = "cell_inventories")

