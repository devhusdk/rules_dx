load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//cli/launcher:defs.bzl", "dx_subcommand")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")

package(default_visibility = VIS_TOOLS)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

rust_library(
    name = "collect_native_lib",
    srcs = [
        "src/apple.rs",
        "src/apple_post.rs",
        "src/collect.rs",
        "src/gcov.rs",
        "src/lib.rs",
        "src/linemap.rs",
    ],
    aliases = aliases(
        package_name = "tools/coverage/collect_native",
        normal = True,
    ),
    crate_name = "collect_native",
    crate_root = "src/lib.rs",
    visibility = VIS_TOOLS + ["//cli/cli:__pkg__"],
    deps = all_crate_deps(
        package_name = "tools/coverage/collect_native",
        normal = True,
    ) + ["@crates//:serde_json"],
)

rust_binary(
    name = "collect_native",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "tools/coverage/collect_native",
        normal = True,
    ),
    crate_name = "collect_native",
    crate_root = "src/main.rs",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        package_name = "tools/coverage/collect_native",
        normal = True,
    ) + [":collect_native_lib"],
)

dx_subcommand(
    name = "apple_post_action",
    path_args = {
        "--llvm-cov": "@llvm//tools:llvm-cov",
        "--llvm-profdata": "@llvm//tools:llvm-profdata",
    },
    subcommand = "apple_post_action",
    visibility = ["//visibility:public"],
)

rust_test(
    name = "gcov_native_test",
    size = "small",
    srcs = ["tests/gcov_native_test.rs"],
    aliases = aliases(
        package_name = "tools/coverage/collect_native",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "gcov_native_test",
    crate_root = "tests/gcov_native_test.rs",
    data = [
        ":collect_native",
        "//cc/tests/fixtures/gcc_coverage:gcov_fixture",
        "//cc/tests/fixtures/gcc_coverage:gcov_fixture_alt",
        "@bazel_tools//tools/test:lcov_merger",
    ],
    env = {
        "COLLECT_NATIVE": "$(rootpath :collect_native)",
        "LCOV_MERGER": "$(rootpath @bazel_tools//tools/test:lcov_merger)",
        "GCOV_FIXTURE": "$(rootpath //cc/tests/fixtures/gcc_coverage:gcov_fixture)",
        "GCOV_FIXTURE_ALT": "$(rootpath //cc/tests/fixtures/gcc_coverage:gcov_fixture_alt)",
    },
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = all_crate_deps(
        package_name = "tools/coverage/collect_native",
        normal = True,
        normal_dev = True,
    ) + [":collect_native_lib"],
)

rust_test(
    name = "collect_native_test",
    size = "small",
    aliases = aliases(
        package_name = "tools/coverage/collect_native",
        normal = True,
        normal_dev = True,
    ),
    crate = ":collect_native_lib",
    deps = all_crate_deps(
        package_name = "tools/coverage/collect_native",
        normal = True,
        normal_dev = True,
    ),
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    [
        "src/lib.rs",
        "src/main.rs",
    ],
    visibility = ["//core/quality:__pkg__"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
