load("@crates//:crates.bzl", "aliases")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

rust_binary(
    name = "d_coverage_launcher",
    srcs = [
        "src/lst.rs",
        "src/main.rs",
    ],
    aliases = aliases(
        package_name = "tools/coverage/d_coverage_launcher",
        normal = True,
    ),
    crate_name = "d_coverage_launcher",
    crate_root = "src/main.rs",
    visibility = VIS_TOOLS_PUBLIC,
    deps = [],
)

rust_test(
    name = "d_coverage_launcher_bin_test",
    aliases = aliases(
        package_name = "tools/coverage/d_coverage_launcher",
        normal = True,
        normal_dev = True,
    ),
    crate = ":d_coverage_launcher",
    deps = [],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    [
        "src/main.rs",
    ],
    visibility = ["//core/quality:__pkg__"],
)
