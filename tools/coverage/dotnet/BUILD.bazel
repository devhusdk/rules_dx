load("@crates//:crates.bzl", "aliases")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "coverage.bzl",
    ],
    tags = ["corpus"],
)

alias(
    name = "coverlet",
    actual = "@paket.main//coverlet.console/tools:coverlet",
    visibility = VIS_TOOLS_PUBLIC,
)

rust_binary(
    name = "coverlet_launcher",
    srcs = [
        "src/lcov.rs",
        "src/main.rs",
        "src/plan.rs",
    ],
    aliases = aliases(
        package_name = "tools/coverage/coverlet_launcher",
        normal = True,
    ),
    crate_name = "coverlet_launcher",
    crate_root = "src/main.rs",
    visibility = VIS_TOOLS_PUBLIC,
    deps = [],
)

rust_test(
    name = "coverlet_launcher_bin_test",
    aliases = aliases(
        package_name = "tools/coverage/coverlet_launcher",
        normal = True,
        normal_dev = True,
    ),
    crate = ":coverlet_launcher",
    deps = [],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
