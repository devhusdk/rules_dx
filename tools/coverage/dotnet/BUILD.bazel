load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_test", "rustfmt_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "coverage.bzl",
    ],
    tags = ["corpus"],
)

alias(
    name = "coverlet",
    actual = "@paket.main//coverlet.console/tools:coverlet",
    visibility = VIS_TOOLS_PUBLIC,
)

rust_binary(
    name = "coverlet_launcher",
    srcs = [
        "src/lcov.rs",
        "src/main.rs",
        "src/plan.rs",
    ],
    crate_name = "coverlet_launcher",
    crate_root = "src/main.rs",
    visibility = VIS_TOOLS_PUBLIC,
)

rust_test(
    name = "coverlet_launcher_test",
    srcs = [
        "src/lcov.rs",
        "src/main.rs",
        "src/plan.rs",
    ],
    crate_root = "src/main.rs",
)

rustfmt_test(
    name = "coverlet_launcher_fmt_test",
    targets = [
        ":coverlet_launcher",
        ":coverlet_launcher_test",
    ],
)

rust_clippy_test(
    name = "coverlet_launcher_clippy_test",
    targets = [
        ":coverlet_launcher",
        ":coverlet_launcher_test",
    ],
)
