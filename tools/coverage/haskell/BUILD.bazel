load("//haskell/rules:defs.bzl", "HASKELL_COMPATIBLE_WITH", "haskell_binary", "haskell_library", "haskell_test")
load("//quality:fixtures.bzl", "real_source_target")
load(":coverage_tests.bzl", "dx_haskell_coverage_tests")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "coverage.bzl",
        "coverage_tests.bzl",
    ],
    tags = ["corpus"],
)

haskell_binary(
    name = "hpc_lcov",
    srcs = ["src/HpcLcov.hs"],
    target_compatible_with = HASKELL_COMPATIBLE_WITH,
    visibility = VIS_TOOLS_PUBLIC,
    deps = [
        "@dx_haskell_toolchains//:base",
        "@dx_haskell_toolchains//:containers",
        "@dx_haskell_toolchains//:hpc",
    ],
)

haskell_library(
    name = "greeter",
    testonly = True,
    srcs = ["fixture/Greeter.hs"],
    target_compatible_with = HASKELL_COMPATIBLE_WITH,
    deps = ["@dx_haskell_toolchains//:base"],
)

haskell_test(
    name = "greeter_test",
    srcs = ["fixture/GreeterTest.hs"],
    target_compatible_with = HASKELL_COMPATIBLE_WITH,
    deps = [
        ":greeter",
        "@dx_haskell_toolchains//:base",
    ],
)

dx_haskell_coverage_tests(
    name = "haskell_coverage_test",
    target = ":greeter_test",
)
