load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_PUBLIC", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")
load(":kcov_tests.bzl", "dx_kcov_unpinned_test")

package(default_visibility = VIS_TOOLS)

exports_files(
    [
        "kcov.BUILD",
        "pins.json",
    ],
    visibility = VIS_TOOLS,
)

exports_files(
    ["kcov_tests.bzl"],
    visibility = VIS_PUBLIC,
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "kcov.bzl",
        "kcov_tests.bzl",
    ],
    tags = ["corpus"],
)

alias(
    name = "kcov",
    actual = "@kcov//:kcov",
    visibility = VIS_TOOLS_PUBLIC,
)

alias(
    name = "kcov_or_none",
    actual = select({
        "@platforms//os:linux": "@dx_prebuilt//:kcov",
        "//conditions:default": ":none",
    }),
    visibility = VIS_TOOLS_PUBLIC,
)

alias(
    name = "to_lcov_or_none",
    actual = select({
        "@platforms//os:linux": "@dx_prebuilt//:runtime",
        "//conditions:default": ":none",
    }),
    visibility = VIS_TOOLS_PUBLIC,
)

filegroup(
    name = "none",
    visibility = VIS_TOOLS_PUBLIC,
)

platform_transition_filegroup(
    name = "kcov_static",
    srcs = ["@kcov"],
    target_compatible_with = ["@platforms//os:linux"],
    target_platform = select({
        "@platforms//cpu:aarch64": "@llvm//platforms:linux_aarch64_musl",
        "//conditions:default": "@llvm//platforms:linux_x86_64_musl",
    }),
)

platform_transition_filegroup(
    name = "kcov_linux_arm64",
    testonly = True,
    srcs = [
        ":kcov",
        ":kcov_static",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    target_platform = "//tools/platforms:linux_arm64",
)

build_test(
    name = "linux_arm64_build_test",
    size = "small",
    target_compatible_with = ["@platforms//os:linux"],
    targets = [":kcov_linux_arm64"],
)

sh_binary(
    name = "kcov_launcher",
    srcs = ["kcov_launcher.sh"],
    data = ["//tools/coverage/lib:runfile.sh"],
    visibility = VIS_TOOLS_PUBLIC,
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

cc_binary(
    name = "smoke",
    testonly = True,
    srcs = ["smoke.c"],
    copts = ["-g"],
    features = ["-strip_debug_symbols"],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:linux"],
)

rust_test(
    name = "smoke_test",
    size = "small",
    srcs = ["smoke_test.rs"],
    data = [
        "smoke.c",
        ":kcov",
        ":smoke",
    ],
    env = {
        "DX_KCOV": "$(rootpath :kcov)",
        "DX_KCOV_SMOKE": "$(rootpath :smoke)",
    },
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["//tools/testing:dx_testing"],
)

rust_test(
    name = "static_smoke_test",
    size = "small",
    srcs = ["smoke_test.rs"],
    data = [
        "smoke.c",
        ":kcov_static",
        ":smoke",
    ],
    env = {
        "DX_KCOV": "$(rootpath :kcov_static)",
        "DX_KCOV_SMOKE": "$(rootpath :smoke)",
    },
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["//tools/testing:dx_testing"],
)

rust_test(
    name = "release_launcher_test",
    size = "small",
    srcs = ["release_launcher_test.rs"],
    data = [
        "smoke.c",
        ":kcov_launcher",
        ":kcov_static",
        ":smoke",
        "//cli/runtime:dx_runtime",
        "//tools/coverage/lib:runfile.sh",
    ],
    env = {
        "DX_KCOV_LAUNCHER": "$(rootpath :kcov_launcher)",
        "DX_KCOV_SMOKE": "$(rootpath :smoke)",
        "DX_KCOV_STATIC": "$(rootpath :kcov_static)",
        "DX_RUNFILE_LIB": "$(rootpath //tools/coverage/lib:runfile.sh)",
        "DX_RUNTIME": "$(rootpath //cli/runtime:dx_runtime)",
    },
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["//tools/testing:dx_testing"],
)

dx_kcov_unpinned_test(
    name = "unpinned_test",
    size = "small",
    upstream = ":kcov_launcher",
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
