load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//tools/visibility:visibility.bzl", "VIS_PUBLIC", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS)

exports_files(
    ["kcov.BUILD"],
    visibility = VIS_TOOLS,
)

exports_files(
    ["kcov_tests.bzl"],
    visibility = VIS_PUBLIC,
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "kcov.bzl",
        "kcov_tests.bzl",
    ],
    tags = ["corpus"],
)

alias(
    name = "kcov",
    actual = "@kcov//:kcov",
    visibility = VIS_TOOLS_PUBLIC,
)

alias(
    name = "kcov_or_none",
    actual = select({
        "@platforms//os:linux": "@kcov//:kcov",
        "//conditions:default": ":none",
    }),
    visibility = VIS_TOOLS_PUBLIC,
)

alias(
    name = "to_lcov_or_none",
    actual = select({
        "@platforms//os:linux": "//cli/lcov:to_lcov",
        "//conditions:default": ":none",
    }),
    visibility = VIS_TOOLS_PUBLIC,
)

filegroup(name = "none")

sh_binary(
    name = "kcov_launcher",
    srcs = ["kcov_launcher.sh"],
    data = ["//tools/coverage/lib:runfile.sh"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
    visibility = VIS_TOOLS_PUBLIC,
)

cc_binary(
    name = "smoke",
    testonly = True,
    srcs = ["smoke.c"],
    copts = ["-g"],
    features = ["-strip_debug_symbols"],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:linux"],
)

sh_test(
    name = "smoke_test",
    size = "small",
    srcs = ["smoke_test.sh"],
    args = [
        "$(rootpath :kcov)",
        "$(rootpath :smoke)",
    ],
    data = [
        "smoke.c",
        ":kcov",
        ":smoke",
    ],
    tags = ["no-remote-exec"],
    target_compatible_with = ["@platforms//os:linux"],
)
