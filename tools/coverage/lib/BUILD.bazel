load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")

package(default_visibility = VIS_TOOLS)

exports_files(
    ["runfile.sh"],
    visibility = VIS_TOOLS,
)

rust_test(
    name = "runfile_test",
    size = "small",
    srcs = ["runfile_test.rs"],
    data = [
        "runfile.sh",
        "//tools/coverage/kcov:kcov_launcher",
    ],
    env = {
        "DX_KCOV_LAUNCHER": "$(rootpath //tools/coverage/kcov:kcov_launcher)",
        "DX_RUNFILE_LIB": "$(rootpath runfile.sh)",
    },
    deps = ["//tools/testing:dx_testing"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
    ],
    tags = ["corpus"],
)
