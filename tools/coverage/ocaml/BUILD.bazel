load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//ocaml/rules:dune.bzl", "dx_dune_build", "dx_dune_library")
load("//ocaml/rules:defs.bzl", "ocaml_library", "ocaml_module", "ocaml_signature")
load("//quality:fixtures.bzl", "real_source_target")
load("//tools/visibility:visibility.bzl", "VIS_PUBLIC", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")
load(":marker.bzl", "ocaml_executable_marker")

package(default_visibility = VIS_TOOLS)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "marker.bzl",
    ],
    tags = ["corpus"],
)

dx_dune_build(
    name = "bisect_driver_exe",
    srcs = ["@dx_ocaml_tools_duniverse//:srcs"],
    dune = "//ocaml/toolchain:dune",
    target = "bisect_ppx/src/driver/driver.exe",
    workspace = "@dx_ocaml_tools_duniverse//:dune-project",
)

dx_dune_build(
    name = "bisect_report",
    srcs = ["@dx_ocaml_tools_duniverse//:srcs"],
    dune = "//ocaml/toolchain:dune",
    target = "bisect_ppx/src/report/main.exe",
    workspace = "@dx_ocaml_tools_duniverse//:dune-project",
)

dx_dune_library(
    name = "bisect_ppx_rewriter",
    srcs = ["@dx_ocaml_tools_duniverse//:srcs"],
    dune = "//ocaml/toolchain:dune",
    library = "bisect_ppx",
    package = "bisect_ppx",
    visibility = VIS_PUBLIC,
    workspace = "@dx_ocaml_tools_duniverse//:dune-project",
)

ocaml_executable_marker(
    name = "bisect_driver",
    exe = ":bisect_driver_exe",
    visibility = VIS_PUBLIC,
)

genrule(
    name = "runtime_sources",
    srcs = [
        "@dx_ocaml_tools_duniverse//:bisect_ppx/src/runtime/native/runtime.ml",
        "@dx_ocaml_tools_duniverse//:bisect_ppx/src/runtime/native/runtime.mli",
    ],
    outs = [
        "bisect_runtime.ml",
        "bisect_runtime.mli",
    ],
    cmd = "cp $(location @dx_ocaml_tools_duniverse//:bisect_ppx/src/runtime/native/runtime.ml) $(location bisect_runtime.ml) && cp $(location @dx_ocaml_tools_duniverse//:bisect_ppx/src/runtime/native/runtime.mli) $(location bisect_runtime.mli)",
)

genrule(
    name = "bisect_source",
    outs = ["bisect.ml"],
    cmd = "echo 'module Runtime = Bisect_runtime' > $@",
)

ocaml_signature(
    name = "bisect_common_sig",
    src = "@dx_ocaml_tools_duniverse//:bisect_ppx/src/common/bisect_common.mli",
)

ocaml_module(
    name = "bisect_common",
    instrument_coverage = False,
    sig = ":bisect_common_sig",
    struct = "@dx_ocaml_tools_duniverse//:bisect_ppx/src/common/bisect_common.ml",
)

ocaml_signature(
    name = "bisect_runtime_sig",
    src = "bisect_runtime.mli",
    deps = [":bisect_common"],
)

ocaml_module(
    name = "bisect_runtime_module",
    instrument_coverage = False,
    sig = ":bisect_runtime_sig",
    struct = "bisect_runtime.ml",
    deps = [":bisect_common"],
)

ocaml_module(
    name = "bisect",
    instrument_coverage = False,
    struct = "bisect.ml",
    deps = [":bisect_runtime_module"],
)

ocaml_library(
    name = "bisect_runtime",
    manifest = [
        ":bisect",
        ":bisect_common",
        ":bisect_runtime_module",
    ],
    visibility = VIS_PUBLIC,
)

config_setting(
    name = "collecting",
    values = {"collect_code_coverage": "true"},
)

selects.config_setting_group(
    name = "coverage_active",
    match_all = [
        ":bisect_cell",
        ":collecting",
    ],
    visibility = VIS_PUBLIC,
)

filegroup(name = "none")

alias(
    name = "report_or_none",
    actual = select({
        ":bisect_cell": ":bisect_report",
        "//conditions:default": ":none",
    }),
    visibility = VIS_TOOLS_PUBLIC,
)

alias(
    name = "to_lcov_or_none",
    actual = select({
        ":bisect_cell": "//cli/lcov:to_lcov",
        "//conditions:default": ":none",
    }),
    visibility = VIS_TOOLS_PUBLIC,
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
)

selects.config_setting_group(
    name = "bisect_cell",
    match_any = [
        ":linux_x86_64",
        ":linux_arm64",
        ":macos_arm64",
    ],
)

sh_binary(
    name = "collect",
    srcs = ["collect.sh"],
    data = ["//tools/coverage/lib:runfile.sh"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
    visibility = VIS_TOOLS_PUBLIC,
)

sh_binary(
    name = "collect_test_upstream",
    srcs = ["collect_test_upstream.sh"],
)

sh_test(
    name = "collect_test",
    size = "small",
    srcs = ["collect_test.sh"],
    args = [
        "$(rootpath :collect)",
        "$(rlocationpath :collect_test_upstream)",
    ],
    data = [
        ":collect",
        ":collect_test_upstream",
    ],
)

filegroup(
    name = "bisect_licenses",
    srcs = ["@dx_ocaml_tools_duniverse//:licenses"],
)
