load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "sancov.bzl",
    ],
    tags = ["corpus"],
)

rust_binary(
    name = "sancov_launcher",
    srcs = ["sancov_launcher.rs"],
    visibility = VIS_TOOLS_PUBLIC,
    deps = [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/error:dx_error",
        "//cli/lcov:dx_lcov",
        "@rules_rust//rust/runfiles",
    ],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
