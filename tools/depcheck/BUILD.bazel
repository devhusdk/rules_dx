load("@crates//:crates.bzl", "aliases", "crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")

package(default_visibility = VIS_TOOLS)

rust_library(
    name = "depcheck_lib",
    srcs = [
        "src/consistency.rs",
        "src/ecosystem/cc.rs",
        "src/ecosystem/dotnet.rs",
        "src/ecosystem/go.rs",
        "src/ecosystem/js.rs",
        "src/ecosystem/jvm.rs",
        "src/ecosystem/mod.rs",
        "src/ecosystem/python.rs",
        "src/ecosystem/ruby.rs",
        "src/ecosystem/rust.rs",
        "src/exceptions.rs",
        "src/lib.rs",
        "src/tests.rs",
        "src/toml_util.rs",
        "src/types.rs",
        "src/usage.rs",
        "src/version.rs",
    ],
    aliases = aliases(
        package_name = "tools/dx_depcheck",
        normal = True,
    ),
    crate_name = "dx_depcheck",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = crate_deps(
        [
            "clap",
            "pep440_rs",
            "regex",
            "semver",
            "serde_json",
            "thiserror",
            "toml",
            "yaml_serde",
        ],
        package_name = "tools/dx_depcheck",
    ) + [
        "//cli/path:dx_path",
        "//libs/gomod:dx_gomod",
    ],
)

rust_binary(
    name = "depcheck",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "tools/dx_depcheck",
        normal = True,
    ),
    crate_name = "depcheck",
    crate_root = "src/main.rs",
    edition = "2021",
    deps = crate_deps(
        [
            "clap",
            "pep440_rs",
            "regex",
            "semver",
            "serde_json",
            "thiserror",
            "toml",
        ],
        package_name = "tools/dx_depcheck",
    ) + [
        ":depcheck_lib",
        "//libs/gomod:dx_gomod",
    ],
)

