# keep
rust_test(
    name = "repo_locks_test",
    srcs = ["repo_locks_test.rs"],
    data = [
        ":depcheck",
        "//:package.json",
        "//:pnpm-lock.yaml",
        "//python/tests/fixtures/hello:pyproject.toml",
        "//python/tests/fixtures/hello:uv.lock",
        "//rust/tests/fixtures/hello:Cargo.lock",
        "//rust/tests/fixtures/hello:Cargo.toml",
        "//third_party/dotnet:paket.dependencies",
        "//third_party/dotnet:paket.lock",
        "//third_party/go:go.mod",
        "//third_party/go:go.sum",
        "//third_party/jvm:maven_install.json",
        "//third_party/jvm:pins.bzl",
        "//third_party/ruby:Gemfile",
        "//third_party/ruby:Gemfile.lock",
    ],
    env = {
        "DX_CARGO_LOCK": "$(rootpath //rust/tests/fixtures/hello:Cargo.lock)",
        "DX_CARGO_MANIFEST": "$(rootpath //rust/tests/fixtures/hello:Cargo.toml)",
        "DX_DEPCHECK_BIN": "$(rootpath :depcheck)",
        "DX_GO_LOCK": "$(rootpath //third_party/go:go.sum)",
        "DX_GO_MANIFEST": "$(rootpath //third_party/go:go.mod)",
        "DX_MAVEN_LOCK": "$(rootpath //third_party/jvm:maven_install.json)",
        "DX_MAVEN_MANIFEST": "$(rootpath //third_party/jvm:pins.bzl)",
        "DX_PAKET_LOCK": "$(rootpath //third_party/dotnet:paket.lock)",
        "DX_PAKET_MANIFEST": "$(rootpath //third_party/dotnet:paket.dependencies)",
        "DX_PNPM_LOCK": "$(rootpath //:pnpm-lock.yaml)",
        "DX_PNPM_MANIFEST": "$(rootpath //:package.json)",
        "DX_RUBY_LOCK": "$(rootpath //third_party/ruby:Gemfile.lock)",
        "DX_RUBY_MANIFEST": "$(rootpath //third_party/ruby:Gemfile)",
        "DX_UV_LOCK": "$(rootpath //python/tests/fixtures/hello:uv.lock)",
        "DX_UV_MANIFEST": "$(rootpath //python/tests/fixtures/hello:pyproject.toml)",
    },
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["//tools/testing:dx_testing"],
)

