load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_test", "rustfmt_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS_PUBLIC)

exports_files(
    ["defs.bzl"],
    visibility = VIS_TOOLS,
)

# keep
rust_test(
    name = "extract_test",
    size = "small",
    srcs = ["extract_test.rs"],
    data = [
        "//tools/docs/components/extract:component_extract",
        "//tools/docs/components/fixture/vue:src/Button.vue",
        "//tools/docs/components/fixture/vue:ui_docs",
        "//tools/docs/components/fixture/vue:ui_docs.component_meta.json",
        "//tools/docs/components/fixture/vue:ui_docs_loose",
        "//tools/docs/components/fixture/vue:ui_docs_loose.component_meta.json",
    ],
    env = {
        "DX_COMPONENT_EXTRACT": "$(rootpath //tools/docs/components/extract:component_extract)",
        "DX_FIXTURE_BUTTON_SOURCE": "$(rootpath //tools/docs/components/fixture/vue:src/Button.vue)",
        "DX_FIXTURE_LOOSE_META": "$(rootpath //tools/docs/components/fixture/vue:ui_docs_loose.component_meta.json)",
        "DX_FIXTURE_LOOSE_SHARD": "$(rootpath //tools/docs/components/fixture/vue:ui_docs_loose)",
        "DX_FIXTURE_META": "$(rootpath //tools/docs/components/fixture/vue:ui_docs.component_meta.json)",
        "DX_FIXTURE_SHARD": "$(rootpath //tools/docs/components/fixture/vue:ui_docs)",
    },
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//tools/docs/ir/ir:documentation_ir",
        "//tools/testing:dx_testing",
    ],
)

