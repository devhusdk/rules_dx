load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//tools/docs/components:defs.bzl", "mdx_doc_shard")
load("//mdx:defs.bzl", "mdx_library")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")

package(default_visibility = VIS_TOOLS)

mdx_doc_shard(
    name = "ui_docs",
    srcs = glob(["src/*.mdx"]) + ["side_effect.mjs"],
    entry_points = [
        "src/Intro.mdx",
        "src/Outro.mdx",
    ],
    package = "ui",
    tsconfig = "tsconfig.json",
)

js_library(
    name = "tsconfig",
    srcs = ["tsconfig.json"],
)

mdx_library(
    name = "ui_library",
    srcs = glob(["src/*.mdx"]),
    deps = [":tsconfig"],
)

exports_files(["src/Intro.mdx"])

filegroup(
    name = "project",
    testonly = True,
    srcs = glob(["src/*"]) + [
        "side_effect.mjs",
        "tsconfig.json",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
