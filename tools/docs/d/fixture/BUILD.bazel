)

dx_extract_test(
    name = "geometry_docs_dx_extract_test",
    size = "small",
    mnemonic = "DxDocsDExtract",
    subcommand = "d_extract",
    target_compatible_with = D_COMPATIBLE_WITH,
    target_under_test = ":geometry_docs",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
