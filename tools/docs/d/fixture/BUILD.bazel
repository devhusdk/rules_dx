load("//core/quality:fixtures.bzl", "real_source_target")
load("//d:defs.bzl", "d_library")
load("//d/private:defs.bzl", "D_COMPATIBLE_WITH")
load("//tools/docs/d:defs.bzl", "d_doc_shard")
load("//tools/docs/ir:dx_extract_test.bzl", "dx_extract_test")
