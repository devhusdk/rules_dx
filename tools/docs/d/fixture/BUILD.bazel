load("//d/rules:defs.bzl", "D_COMPATIBLE_WITH", "d_library")
load("//quality:fixtures.bzl", "real_source_target")
load("//tools/docs/d:defs.bzl", "d_doc_shard")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")

package(default_visibility = VIS_TOOLS)

d_library(
    name = "geometry",
    srcs = ["geometry/shapes.d"],
    target_compatible_with = D_COMPATIBLE_WITH,
)

d_doc_shard(
    name = "geometry_docs",
    lib = ":geometry",
    target_compatible_with = D_COMPATIBLE_WITH,
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
