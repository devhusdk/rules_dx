load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_test", "rustfmt_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS_PUBLIC)

exports_files(
    [
        "defs.bzl",
        "extract_test.rs",
        "fsharp_extract_test.rs",
        "pinned_driver.sh",
        "shard.bzl",
    ],
    visibility = VIS_TOOLS,
)

rust_test(
    name = "extract_test",
    srcs = ["extract_test.rs"],
    data = [
        "//tools/docs/dotnet/fixture/csharp:ledger_docs",
        "//tools/docs/dotnet/fixture/csharp:ledger_extra_docs",
    ],
    env = {
        "DX_FIXTURE_EXTRA_SHARD": "$(rootpath //tools/docs/dotnet/fixture/csharp:ledger_extra_docs)",
        "DX_FIXTURE_SHARD": "$(rootpath //tools/docs/dotnet/fixture/csharp:ledger_docs)",
    },
    tags = ["no-coverage"],
    deps = [
        "//tools/docs/ir/ir:documentation_ir",
        "//tools/testing:dx_testing",
    ],
)

rustfmt_test(
    name = "csharp_extract_fmt_test",
    targets = [":extract_test"],
)

rust_test(
    name = "fsharp_extract_test",
    srcs = ["fsharp_extract_test.rs"],
    data = [
        "//tools/docs/dotnet/fixture/fsharp:ledger_docs",
        "//tools/docs/dotnet/fixture/fsharp:ledger_extra_docs",
    ],
    env = {
        "DX_FIXTURE_FSHARP_EXTRA_SHARD": "$(rootpath //tools/docs/dotnet/fixture/fsharp:ledger_extra_docs)",
        "DX_FIXTURE_FSHARP_SHARD": "$(rootpath //tools/docs/dotnet/fixture/fsharp:ledger_docs)",
    },
    tags = ["no-coverage"],
    deps = [
        "//tools/docs/ir/ir:documentation_ir",
        "//tools/testing:dx_testing",
    ],
)

rustfmt_test(
    name = "fsharp_extract_fmt_test",
    targets = [":fsharp_extract_test"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "shard.bzl",
    ],
    tags = ["corpus"],
)
