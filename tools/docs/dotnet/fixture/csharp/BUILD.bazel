    deps = [":core"],
)

csharp_library(
    name = "ledger_extra",
    srcs = [
        "ledger/Account.cs",
        "ledger/Nullable.cs",
        "ledger/Types.cs",
    ],
    defines = ["DX_EXTRA"],
    deps = [":core"],
)

csharp_doc_shard(
    name = "ledger_docs",
    library = ":ledger",
    package = "Dx.Fixture.Ledger",
)

