    name = "ledger_extra_docs",
    library = ":ledger_extra",
    package = "Dx.Fixture.Ledger",
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
