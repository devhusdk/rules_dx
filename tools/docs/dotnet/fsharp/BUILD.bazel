load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_dotnet//dotnet:defs.bzl", "fsharp_binary")
load("//quality:fixtures.bzl", "real_source_target")
load("//third_party/dotnet:framework.bzl", "DOTNET_TOOL_FRAMEWORK", "framework_pinned")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")

package(default_visibility = VIS_TOOLS)

fsharp_binary(
    name = "fsharp_api_upstream",
    srcs = ["Program.fs"],
    target_frameworks = [DOTNET_TOOL_FRAMEWORK],
    visibility = ["//tools/docs/dotnet:__pkg__"],
    deps = [
        "@paket.docs_fsharp//fsharp.compiler.service",
        "@paket.docs_fsharp//fsharp.core",
        "@paket.docs_fsharp//fsharp.formatting",
    ],
)

framework_pinned(
    name = "fsharp_api_pinned_files",
    actual = ":fsharp_api_upstream",
)

sh_binary(
    name = "fsharp_api_pinned",
    srcs = ["//tools/docs/dotnet:pinned_driver.sh"],
    data = [":fsharp_api_pinned_files"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
