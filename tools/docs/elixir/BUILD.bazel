load("//core/quality:fixtures.bzl", "real_source_target")
load("//elixir:defs.bzl", "ELIXIR_COMPATIBLE_WITH")
load("//tools/docs/elixir:tool.bzl", "elixir_dump_tool")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS_PUBLIC)

exports_files(
    [
        "defs.bzl",
        "elixir_dump.exs",
    ],
    visibility = VIS_TOOLS,
)

# gazelle:exclude elixir_dump.exs

elixir_dump_tool(
    name = "elixir_dump",
    driver = "elixir_dump.exs",
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "tool.bzl",
    ],
    tags = ["corpus"],
)
