load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//elixir:defs.bzl", "elixir_app")
load("//elixir/private:defs.bzl", "ELIXIR_COMPATIBLE_WITH")
load("//tools/docs/beam:path_tests.bzl", "beam_shard_path_test")
load("//tools/docs/elixir:defs.bzl", "elixir_doc_shard")

elixir_app(
    name = "geometry",
    srcs = ["lib/geometry.ex"],
    app_name = "geometry",
    app_version = "1.0.0",
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
)

elixir_doc_shard(
    name = "geometry_docs",
    app = ":geometry",
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
)

build_test(
    name = "shard_build_test",
    targets = [":geometry_docs"],
)

beam_shard_path_test(
    name = "shard_path_test",
    size = "small",
    language = "elixir",
    target = ":geometry_docs",
    target_compatible_with = ELIXIR_COMPATIBLE_WITH,
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
