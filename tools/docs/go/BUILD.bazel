load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_test", "rustfmt_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS_PUBLIC)

exports_files(["defs.bzl"], visibility = VIS_TOOLS)

filegroup(
    name = "fixture_godoc_json",
    testonly = True,
    srcs = ["//tools/docs/go/fixture:money_docs"],
    output_group = "godoc_json",
)

# keep
rust_test(
    name = "extract_test",
    size = "small",
    srcs = ["extract_test.rs"],
    data = [
        ":fixture_godoc_json",
        "//tools/docs/go/extract:go_extract",
        "//tools/docs/go/fixture:money_changed_docs",
        "//tools/docs/go/fixture:money_docs",
        "//tools/docs/go/fixture:money_windows_docs",
        "//tools/docs/go/godoc:godoc_json",
    ],
    env = {
        "DX_FIXTURE_CHANGED_SHARD": "$(rootpath //tools/docs/go/fixture:money_changed_docs)",
        "DX_FIXTURE_JSON": "$(rootpath :fixture_godoc_json)",
        "DX_FIXTURE_SHARD": "$(rootpath //tools/docs/go/fixture:money_docs)",
        "DX_FIXTURE_WINDOWS_SHARD": "$(rootpath //tools/docs/go/fixture:money_windows_docs)",
        "DX_GO_EXTRACT": "$(rootpath //tools/docs/go/extract:go_extract)",
        "DX_GODOC_JSON": "$(rootpath //tools/docs/go/godoc:godoc_json)",
    },
    tags = ["no-coverage"],
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//tools/docs/ir/ir:documentation_ir",
        "//tools/testing:dx_testing",
    ],
)

rustfmt_test(
    name = "go_extract_fmt_test",
    size = "small",
    targets = [":extract_test"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
    ],
    tags = ["corpus"],
)
