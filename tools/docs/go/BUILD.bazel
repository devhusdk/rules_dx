load("@crates//:crates.bzl", "aliases")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS_PUBLIC)

exports_files(
    ["defs.bzl"],
    visibility = VIS_TOOLS,
)

filegroup(
    name = "fixture_godoc_json",
    testonly = True,
    srcs = ["//tools/docs/go/fixture:money_docs"],
    output_group = "godoc_json",
)

rust_test(
    name = "extract_test",
    size = "small",
    srcs = ["extract_test.rs"],
    aliases = aliases(
        package_name = "tools/docs/go_docs_tests",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "extract_test",
    crate_root = "extract_test.rs",
    data = [
        ":fixture_godoc_json",
        "//tools/docs/go/fixture:money_changed_docs",
        "//tools/docs/go/fixture:money_docs",
        "//tools/docs/go/fixture:money_windows_docs",
        "@dx_prebuilt//:dx_godoc_json",
        "@dx_prebuilt//dx:go_extract",
    ],
    env = {
        "DX_FIXTURE_CHANGED_SHARD": "$(rootpath //tools/docs/go/fixture:money_changed_docs)",
        "DX_FIXTURE_JSON": "$(rootpath :fixture_godoc_json)",
        "DX_FIXTURE_SHARD": "$(rootpath //tools/docs/go/fixture:money_docs)",
        "DX_FIXTURE_WINDOWS_SHARD": "$(rootpath //tools/docs/go/fixture:money_windows_docs)",
        "DX_GO_EXTRACT": "$(rootpath @dx_prebuilt//dx:go_extract)",
        "DX_GODOC_JSON": "$(rootpath @dx_prebuilt//:dx_godoc_json)",
    },
    tags = ["no-coverage"],
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//tools/docs/ir/ir:documentation_ir",
        "//tools/docs/ir/ir:shard_test_support",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "aspect.bzl",
        "defs.bzl",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

filegroup(
    name = "module_srcs",
    srcs = [
        "BUILD.bazel",
        "Cargo.toml",
    ] + glob(["*.bzl"]),
    visibility = ["//:__subpackages__"],
)
