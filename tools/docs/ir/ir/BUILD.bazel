load("@crates//:crates.bzl", "aliases", "crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")

# gazelle:resolve rust proto //tools/docs/ir:doc_ir_proto_rs
# gazelle:resolve rust doc_ir_proto //tools/docs/ir:doc_ir_proto_rs

package(default_visibility = VIS_TOOLS)

rust_library(
    name = "documentation_ir",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "tools/docs/ir/documentation_ir",
        normal = True,
    ),
    crate_name = "documentation_ir",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = crate_deps(
        [],
        package_name = "tools/docs/ir/documentation_ir",
    ) + [
        "//cli/path:dx_path",
        "//cli/proto_validate:dx_proto_validate",
        "//cli/schema:dx_schema",
        "//tools/docs/ir:doc_ir_proto_rs",
    ],
)

rust_test(
    name = "documentation_ir_test",
    size = "small",
    aliases = aliases(
        package_name = "tools/docs/ir/documentation_ir",
        normal = True,
        normal_dev = True,
    ),
    crate = ":documentation_ir",
    deps = crate_deps(
        [],
        package_name = "tools/docs/ir/documentation_ir",
    ) + [
        "//tools/docs/ir:doc_ir_proto_rs",
        "@rules_rust_prost//private/3rdparty/crates:prost",
    ],
)

# keep
rust_test(
    name = "site_shard_test",
    size = "small",
    srcs = ["site_shard_test.rs"],
    data = [
        "//tools/docs/rust/fixture:docs_fixture_changed_docs",
        "//tools/docs/rust/fixture:docs_fixture_docs",
    ],
    deps = [
        ":documentation_ir",
        "//tools/testing:dx_testing",
    ],
)

rustfmt_test(
    name = "documentation_ir_fmt_test",
    size = "small",
    targets = [":documentation_ir"],
)

rust_clippy_test(
    name = "documentation_ir_clippy_test",
    size = "small",
    targets = [":documentation_ir"],
)

exports_files(
    [
        "Cargo.toml",
        "src/lib.rs",
    ],
    visibility = VIS_TOOLS,
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

rustfmt_test(
    name = "ir_fmt_test",
    size = "small",
    targets = [
        ":site_shard_test",
    ],
)
