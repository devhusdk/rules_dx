load("@crates//:crates.bzl", "aliases")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS_PUBLIC)

exports_files(
    [
        "defs.bzl",
        "shard.bzl",
    ],
    visibility = VIS_TOOLS,
)

filegroup(
    name = "fixture_shapes_json",
    testonly = True,
    srcs = ["//tools/docs/jvm/fixture:shapes_docs"],
    output_group = "api_json",
)

rust_library(
    name = "jvm_test_support",
    testonly = True,
    srcs = ["jvm_test_support.rs"],
    aliases = aliases(
        package_name = "tools/docs/jvm_test_support",
        normal = True,
    ),
    crate_name = "jvm_test_support",
    crate_root = "jvm_test_support.rs",
    deps = [
        "//tools/docs/ir/ir:documentation_ir",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "java_extract_test",
    srcs = ["java_extract_test.rs"],
    aliases = aliases(
        package_name = "tools/docs/jvm_test_support",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "java_extract_test",
    crate_root = "java_extract_test.rs",
    data = [
        ":fixture_shapes_json",
        "//tools/docs/jvm/convert:jvm_convert",
        "//tools/docs/jvm/fixture:java/dx/fixture/shapes/Circle.java",
        "//tools/docs/jvm/fixture:java/dx/fixture/shapes/Shape.java",
        "//tools/docs/jvm/fixture:paint_docs",
        "//tools/docs/jvm/fixture:paint_nodep_docs",
        "//tools/docs/jvm/fixture:shapes_docs",
        "//tools/docs/jvm/javadoc:javadoc_extract",
    ],
    env = {
        "DX_CIRCLE_JAVA": "$(rootpath //tools/docs/jvm/fixture:java/dx/fixture/shapes/Circle.java)",
        "DX_JAVADOC_EXTRACT": "$(rootpath //tools/docs/jvm/javadoc:javadoc_extract)",
        "DX_JVM_CONVERT": "$(rootpath //tools/docs/jvm/convert:jvm_convert)",
        "DX_PAINT_NODEP_SHARD": "$(rootpath //tools/docs/jvm/fixture:paint_nodep_docs)",
        "DX_PAINT_SHARD": "$(rootpath //tools/docs/jvm/fixture:paint_docs)",
        "DX_SHAPES_JSON": "$(rootpath :fixture_shapes_json)",
        "DX_SHAPES_SHARD": "$(rootpath //tools/docs/jvm/fixture:shapes_docs)",
        "DX_SHAPE_JAVA": "$(rootpath //tools/docs/jvm/fixture:java/dx/fixture/shapes/Shape.java)",
    },
    tags = ["no-coverage"],
    deps = [
        ":jvm_test_support",
        "//cli/test_scratch:dx_test_scratch",
        "//tools/docs/ir/ir:documentation_ir",
        "//tools/testing:dx_testing",
    ],
)

