        "DX_JVM_CONVERT": "$(rootpath //tools/docs/jvm/convert:jvm_convert)",
        "DX_PAINT_NODEP_SHARD": "$(rootpath //tools/docs/jvm/fixture:kotlin_paint_nodep_docs)",
        "DX_PAINT_SHARD": "$(rootpath //tools/docs/jvm/fixture:kotlin_paint_docs)",
        "DX_SHAPES_SHARD": "$(rootpath //tools/docs/jvm/fixture:kotlin_shapes_docs)",
        "DX_SHAPE_KT": "$(rootpath //tools/docs/jvm/fixture:kotlin/dx/fixture/shapes/Shape.kt)",
    },
    tags = ["no-coverage"],
    deps = [
        ":jvm_test_support",
        "//cli/test_scratch:dx_test_scratch",
        "//tools/docs/ir/ir:documentation_ir",
        "//tools/testing:dx_testing",
    ],
