scala_version_tests(
    name = "scala_version_tests",
    lib = "//tools/docs/jvm/fixture:scala_shapes",
    shard = "//tools/docs/jvm/fixture:scala_shapes_docs",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "aspect.bzl",
        "defs.bzl",
        "scala_version_tests.bzl",
        "shard.bzl",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

filegroup(
    name = "module_srcs",
    srcs = [
        "BUILD.bazel",
        "Cargo.toml",
    ] + glob(["*.bzl"]),
    visibility = ["//:__subpackages__"],
)
