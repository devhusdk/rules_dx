load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS_PUBLIC)

exports_files(
    [
        "Cargo.toml",
        "src/lib.rs",
        "src/lib_tests.rs",
        "src/main.rs",
    ],
    visibility = VIS_TOOLS,
)

rust_library(
    name = "dx_docs_jvm_convert",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "tools/docs/jvm/jvm_convert",
        normal = True,
    ),
    crate_name = "dx_docs_jvm_convert",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "tools/docs/jvm/jvm_convert",
        normal = True,
    ) + [
        "//tools/docs/ir/ir:documentation_ir",
        "@crates//:serde_json",
    ],
)

rust_binary(
    name = "jvm_convert",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "tools/docs/jvm/jvm_convert",
        normal = True,
    ),
    crate_name = "jvm_convert",
    crate_root = "src/main.rs",
    deps = all_crate_deps(
        package_name = "tools/docs/jvm/jvm_convert",
        normal = True,
    ) + [":dx_docs_jvm_convert"],
)

rust_test(
    name = "dx_docs_jvm_convert_test",
    srcs = [
        "src/lib.rs",
        "src/lib_tests.rs",
    ],
    aliases = aliases(
        package_name = "tools/docs/jvm/jvm_convert",
        normal = True,
        normal_dev = True,
    ),
    coverage_lib = ":dx_docs_jvm_convert",
    crate_name = "dx_docs_jvm_convert",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "tools/docs/jvm/jvm_convert",
        normal = True,
        normal_dev = True,
    ) + [
        "//tools/docs/ir/ir:documentation_ir",
        "@crates//:serde_json",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
