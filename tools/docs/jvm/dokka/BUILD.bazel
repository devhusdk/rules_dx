load("//kotlin/rules:defs.bzl", "kotlin_binary")
load("//quality:fixtures.bzl", "real_source_target")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS_PUBLIC)

# Dokka 2.2.0 brings kotlin-stdlib 2.0.21 (API levels below 2.2 only warn as deprecated, which the
# warnings-as-errors default rejects), so keep the sources to stable stdlib APIs.
kotlin_binary(
    name = "dokka_extract",
    srcs = [
        "Docs.kt",
        "DxIrPlugin.kt",
        "Extractor.kt",
        "IrGeneration.kt",
        "Keys.kt",
        "Main.kt",
        "SourceMap.kt",
        "Types.kt",
    ],
    main_class = "dx.docs.dokka.Main",
    # The default src/main/resources prefix strip also works from an external repository, where
    # rules_kotlin cannot match an explicit resource_strip_prefix.
    resources = ["src/main/resources/META-INF/services/org.jetbrains.dokka.plugability.DokkaPlugin"],
    runtime_deps = ["@dx_dokka//:org_jetbrains_dokka_analysis_kotlin_symbols"],
    deps = [
        "//tools/docs/jvm/record:api_record_writer",
        "@dx_dokka//:org_jetbrains_dokka_dokka_base",
        "@dx_dokka//:org_jetbrains_dokka_dokka_core",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
