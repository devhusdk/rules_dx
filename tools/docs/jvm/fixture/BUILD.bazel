load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//java/rules:defs.bzl", "java_library")
load("//kotlin/rules:defs.bzl", "kotlin_library")
load("//quality:fixtures.bzl", "real_source_target")
load("//scala/rules:defs.bzl", "scala_library")
load("//tools/docs/jvm:defs.bzl", "java_doc_shard", "kotlin_doc_shard", "scala_doc_shard")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")

package(default_visibility = VIS_TOOLS)

exports_files(
    [
        "kotlin/dx/fixture/paint/Square.kt",
        "kotlin/dx/fixture/shapes/Circle.kt",
        "kotlin/dx/fixture/shapes/Shape.kt",
        "java/dx/fixture/paint/Square.java",
        "java/dx/fixture/shapes/Circle.java",
        "java/dx/fixture/shapes/Shape.java",
        "java/dx/fixture/shapes/package-info.java",
        "scala/dx/fixture/paint/Square.scala",
        "scala/dx/fixture/shapes/Circle.scala",
        "scala/dx/fixture/shapes/Shape.scala",
    ],
    visibility = VIS_TOOLS,
)

java_library(
    name = "shapes",
    srcs = [
        "java/dx/fixture/shapes/Circle.java",
        "java/dx/fixture/shapes/Internal.java",
        "java/dx/fixture/shapes/Shape.java",
        "java/dx/fixture/shapes/package-info.java",
    ],
    aspect_hints = ["//quality:corpus_checkstyle_config"],
)

java_library(
    name = "paint",
    srcs = ["java/dx/fixture/paint/Square.java"],
    aspect_hints = ["//quality:corpus_checkstyle_config"],
    deps = [":shapes"],
)

java_doc_shard(
    name = "shapes_docs",
    lib = ":shapes",
    package = "shapes",
)

java_doc_shard(
    name = "paint_docs",
    lib = ":paint",
    package = "paint",
    deps = [":shapes_docs"],
)

java_doc_shard(
    name = "paint_nodep_docs",
    lib = ":paint",
    package = "paint",
    tags = ["manual"],
)

write_file(
    name = "empty_src",
    out = "empty/Hidden.java",
    content = [
        "package dx.fixture.empty;",
        "",
        "class Hidden {}",
        "",
    ],
    tags = ["manual"],
)

java_library(
    name = "empty",
    srcs = [":empty_src"],
    aspect_hints = ["//quality:corpus_checkstyle_config"],
    tags = ["manual"],
)

java_doc_shard(
    name = "empty_docs",
    lib = ":empty",
    tags = ["manual"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

write_file(
    name = "reexport_src",
    out = "reexport/dx/fixture/reexport/Reexport.java",
    content = [
        "package dx.fixture.reexport;",
        "",
        "import dx.fixture.shapes.Shape;",
        "",
        "/** Uses a type from an exported dependency. */",
        "public interface Reexport {",
        "  /** Returns the shape. */",
        "  Shape shape();",
        "}",
        "",
    ],
    tags = ["manual"],
)

java_library(
    name = "reexport",
    srcs = [":reexport_src"],
    tags = ["manual"],
    exports = [":shapes"],
    deps = [":shapes"],
)

java_doc_shard(
    name = "reexport_docs",
    lib = ":reexport",
    package = "reexport",
    tags = ["manual"],
)

kotlin_library(
    name = "kotlin_shapes",
    srcs = [
        "kotlin/dx/fixture/shapes/Circle.kt",
        "kotlin/dx/fixture/shapes/Extras.kt",
        "kotlin/dx/fixture/shapes/Shape.kt",
    ],
)

kotlin_library(
    name = "kotlin_paint",
    srcs = ["kotlin/dx/fixture/paint/Square.kt"],
    deps = [":kotlin_shapes"],
)

kotlin_doc_shard(
    name = "kotlin_shapes_docs",
    lib = ":kotlin_shapes",
    package = "shapes",
)

kotlin_doc_shard(
    name = "kotlin_paint_docs",
    lib = ":kotlin_paint",
    package = "paint",
    deps = [":kotlin_shapes_docs"],
)

kotlin_doc_shard(
    name = "kotlin_paint_nodep_docs",
    lib = ":kotlin_paint",
    package = "paint",
    tags = ["manual"],
)

scala_library(
    name = "scala_shapes",
    srcs = [
        "scala/dx/fixture/shapes/Circle.scala",
        "scala/dx/fixture/shapes/Shape.scala",
    ],
    aspect_hints = ["//:scalafmt_config"],
)

scala_library(
    name = "scala_paint",
    srcs = ["scala/dx/fixture/paint/Square.scala"],
    aspect_hints = ["//:scalafmt_config"],
    deps = [":scala_shapes"],
)

scala_doc_shard(
    name = "scala_shapes_docs",
    lib = ":scala_shapes",
    package = "shapes",
)

scala_doc_shard(
    name = "scala_paint_docs",
    lib = ":scala_paint",
    package = "paint",
    deps = [":scala_shapes_docs"],
)

scala_doc_shard(
    name = "scala_paint_nodep_docs",
    lib = ":scala_paint",
    package = "paint",
    tags = ["manual"],
)
