load("@rules_java//java:defs.bzl", "java_binary")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//scala:defs.bzl", "scala_library")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS_PUBLIC)

# Only Scala 2.13 has this doc model.
scala_library(
    name = "scaladoc_extract_lib",
    srcs = [
        "Docs.scala",
        "Main.scala",
        "Model.scala",
    ],
    deps = [
        "//tools/docs/jvm/record:api_record_writer",
        "@rules_scala//scala/private/toolchain_deps:scala_compile_classpath",
    ],
)

java_binary(
    name = "scaladoc_extract",
    main_class = "dx.docs.scaladoc.Main",
    runtime_deps = [":scaladoc_extract_lib"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
