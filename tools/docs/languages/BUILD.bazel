load("@rules_dx//python:defs.bzl", "python_binary", "python_test")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")

python_binary(
    name = "languages_bin",
    srcs = ["languages.py"],
    data = ["//tools/docs/support_matrix:facts"],
    main = "languages.py",
    visibility = ["//visibility:public"],
)

python_test(
    name = "languages_test",
    srcs = ["languages.py"],
    data = [
        "//tools/docs/support_matrix:facts",
        "@dx_test_tags_sources//:files.json",
        "@dx_test_tags_sources//:sources.json",
    ],
    env = {
        "DX_FILES_JSON": "$(rlocationpath @dx_test_tags_sources//:files.json)",
        "DX_SOURCES_JSON": "$(rlocationpath @dx_test_tags_sources//:sources.json)",
    },
    main = "languages.py",
    runner = "plain",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
