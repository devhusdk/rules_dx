load("@bazel_skylib//lib:selects.bzl", "selects")
load("//ocaml/private:dune.bzl", "dx_dune_build")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//core/quality:unavailable_tool.bzl", "dx_unavailable_tool")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS_PUBLIC)

exports_files(
    ["defs.bzl"],
    visibility = VIS_TOOLS,
)

# odoc 3.2.2, built from source with dune on every OCaml cell.
dx_dune_build(
    name = "odoc",
    srcs = ["@dx_ocaml_tools_duniverse//:srcs"],
    dune = "//ocaml/private/toolchain:dune",
    target = "odoc/src/odoc/bin/main.exe",
    workspace = "@dx_ocaml_tools_duniverse//:dune-project",
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
)

selects.config_setting_group(
    name = "odoc_cell",
    match_any = [
        ":linux_x86_64",
        ":linux_arm64",
        ":macos_arm64",
    ],
)

dx_unavailable_tool(
    name = "odoc_unavailable",
    tool = "odoc",
)

# The tool attribute of the docs aspect and the shard rule: odoc where the OCaml toolchain has a
# cell, a marked stub elsewhere, which makes the aspect skip OCaml targets.
alias(
    name = "odoc_tool",
    actual = select({
        ":odoc_cell": ":odoc",
        "//conditions:default": ":odoc_unavailable",
    }),
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "aspect.bzl",
        "defs.bzl",
    ],
    tags = ["corpus"],
)
