load("@crates//:crates.bzl", "aliases")
load("//powershell:defs.bzl", "powershell_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")

# gazelle:dx_ignore_import powershell Pester

package(default_visibility = VIS_TOOLS_PUBLIC)

exports_files(
    [
        "defs.bzl",
        "extract.ps1",
    ],
    visibility = VIS_TOOLS,
)

rust_test(
    name = "extract_test",
    srcs = ["extract_test.rs"],
    aliases = aliases(
        package_name = "tools/docs/docs_powershell",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "extract_test",
    crate_root = "extract_test.rs",
    data = [
        "//tools/docs/powershell/extract:powershell_extract",
        "//tools/docs/powershell/fixture:ledger_docs",
        "//tools/docs/powershell/fixture:ledger_srcs",
        "//tools/docs/powershell/fixture:scoped_docs",
        "//tools/docs/powershell/fixture:scoped_srcs",
        "//tools/docs/powershell/fixture:tally_docs",
        "//tools/docs/powershell/fixture:tally_srcs",
    ],
    env = {
        "DX_LEDGER_SHARD": "$(rootpath //tools/docs/powershell/fixture:ledger_docs)",
        "DX_POWERSHELL_EXTRACT": "$(rootpath //tools/docs/powershell/extract:powershell_extract)",
        "DX_SCOPED_SHARD": "$(rootpath //tools/docs/powershell/fixture:scoped_docs)",
        "DX_TALLY_SHARD": "$(rootpath //tools/docs/powershell/fixture:tally_docs)",
    },
    tags = ["no-coverage"],
    deps = [
        "//tools/docs/ir/ir:documentation_ir",
        "//tools/testing:dx_testing",
    ],
)

# keep: Gazelle drops the pester dep
powershell_test(
    name = "extract_script_test",
    srcs = ["extract_script.Tests.ps1"],
    data = [
        "extract.ps1",
        "extract_script.Describe.ps1",
        "//tools/docs/powershell/fixture:bad_srcs",
        "//tools/docs/powershell/fixture:ledger_srcs",
        "//tools/docs/powershell/fixture:scoped_srcs",
    ],
    deps = ["//powershell/private/gallery:pester"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "aspect.bzl",
        "defs.bzl",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
