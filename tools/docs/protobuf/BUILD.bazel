load("@crates//:crates.bzl", "aliases")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS_PUBLIC)

exports_files(
    ["defs.bzl"],
    visibility = VIS_TOOLS,
)

rust_test(
    name = "shard_test",
    srcs = ["shard_test.rs"],
    aliases = aliases(
        package_name = "tools/docs/docs_protobuf_tests",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "shard_test",
    crate_root = "shard_test.rs",
    data = ["//tools/docs/protobuf/fixture:shop_docs"],
    env = {"DX_FIXTURE_SHARD": "$(rootpath //tools/docs/protobuf/fixture:shop_docs)"},
    deps = [
        "//tools/docs/ir/ir:documentation_ir",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "aspect.bzl",
        "defs.bzl",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
