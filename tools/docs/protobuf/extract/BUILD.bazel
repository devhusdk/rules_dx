load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS_PUBLIC)

exports_files(
    [
        "Cargo.toml",
        "src/lib.rs",
        "src/lib_tests.rs",
    ],
    visibility = VIS_TOOLS,
)

rust_library(
    name = "dx_docs_protobuf_extract",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "tools/docs/protobuf/protobuf_extract",
        normal = True,
    ),
    crate_name = "dx_docs_protobuf_extract",
    crate_root = "src/lib.rs",
    visibility = VIS_TOOLS_PUBLIC + ["//cli/cli:__pkg__"],
    deps = all_crate_deps(
        package_name = "tools/docs/protobuf/protobuf_extract",
        normal = True,
    ) + [
        "//rust:prost",
        "//rust:prost_types",
        "//tools/docs/ir/ir:documentation_ir",
    ],
)

rust_binary(
    name = "protobuf_extract",
    srcs = ["src/bin_protobuf_extract.rs"],
    crate_name = "protobuf_extract",
    crate_root = "src/bin_protobuf_extract.rs",
    visibility = ["//visibility:public"],
    deps = [":dx_docs_protobuf_extract"],
)

rust_test(
    name = "dx_docs_protobuf_extract_test",
    size = "small",
    srcs = [
        "src/lib.rs",
        "src/lib_tests.rs",
    ],
    aliases = aliases(
        package_name = "tools/docs/protobuf/protobuf_extract",
        normal = True,
        normal_dev = True,
    ),
    coverage_lib = ":dx_docs_protobuf_extract",
    crate_name = "dx_docs_protobuf_extract",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "tools/docs/protobuf/protobuf_extract",
        normal = True,
        normal_dev = True,
    ) + [
        "//rust:prost",
        "//rust:prost_types",
        "//tools/docs/ir/ir:documentation_ir",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
