load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//tools/docs/protobuf:defs.bzl", "protobuf_doc_shard")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")

package(default_visibility = VIS_TOOLS)

exports_files(
    [
        "common.proto",
        "shop.proto",
    ],
    visibility = VIS_TOOLS,
)

proto_library(
    name = "common_proto",
    srcs = ["common.proto"],
    deps = ["@protobuf//:timestamp_proto"],
)

proto_library(
    name = "shop_proto",
    srcs = ["shop.proto"],
    deps = [":common_proto"],
)

protobuf_doc_shard(
    name = "shop_docs",
    testonly = True,
    package = "shop",
    proto = ":shop_proto",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
