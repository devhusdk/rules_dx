load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS_PUBLIC)

exports_files(
    [
        "defs.bzl",
        "shard.bzl",
    ],
    visibility = VIS_TOOLS,
)

# keep
rust_test(
    name = "extract_test",
    srcs = ["extract_test.rs"],
    data = [
        "//tools/docs/python/fixture:mylib_docs",
        "//tools/docs/python/fixture:npylib_docs",
        "//tools/docs/python/fixture:src/mylib/shapes.py",
    ],
    env = {
        "DX_FIXTURE_SHAPES_PY": "$(rootpath //tools/docs/python/fixture:src/mylib/shapes.py)",
        "DX_FIXTURE_NUMPY_SHARD": "$(rootpath //tools/docs/python/fixture:npylib_docs)",
        "DX_FIXTURE_SHARD": "$(rootpath //tools/docs/python/fixture:mylib_docs)",
    },
    tags = ["no-coverage"],
    deps = [
        "//tools/docs/ir/ir:documentation_ir",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "shard.bzl",
    ],
    tags = ["corpus"],
