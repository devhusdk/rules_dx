load("@crates//:crates.bzl", "aliases")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")
load(":defs.bzl", "ruby_doc_runtime")

package(default_visibility = VIS_TOOLS_PUBLIC)

exports_files(
    [
        "defs.bzl",
        "repos.bzl",
        "extensions.bzl",
        "yard_dump.rb",
    ],
    visibility = VIS_TOOLS,
)

# The shard rule runs the driver itself with the pinned YARD on its load path.
# gazelle:exclude yard_dump.rb

ruby_doc_runtime(
    name = "ruby_runtime",
    testonly = True,
)

filegroup(
    name = "fixture_yard_json",
    testonly = True,
    srcs = ["//tools/docs/ruby/fixture:geometry_docs"],
    output_group = "yard_json",
)

rust_test(
    name = "extract_test",
    srcs = ["extract_test.rs"],
    aliases = aliases(
        package_name = "tools/docs/ruby_docs_tests",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "extract_test",
    crate_root = "extract_test.rs",
    data = [
        "yard_dump.rb",
        ":fixture_yard_json",
        ":ruby_runtime",
        "//tools/docs/ruby/extract:ruby_extract",
        "//tools/docs/ruby/fixture:ext/square.rb",
        "//tools/docs/ruby/fixture:geometry_changed_docs",
        "//tools/docs/ruby/fixture:geometry_crlf_docs",
        "//tools/docs/ruby/fixture:geometry_docs",
        "//tools/docs/ruby/fixture:geometry_ext_docs",
        "//tools/docs/ruby/fixture:lib/geometry.rb",
        "//tools/docs/ruby/fixture:lib/geometry/shapes.rb",
        "//tools/docs/ruby/fixture:testdata",
        "//tools/docs/ruby/fixture:testdata/broken.rb",
        "@dx_yard//:lib",
        "@dx_yard//:lib/yard.rb",
    ],
    env = {
        "DX_FIXTURE_CHANGED_SHARD": "$(rootpath //tools/docs/ruby/fixture:geometry_changed_docs)",
        "DX_FIXTURE_CRLF_SHARD": "$(rootpath //tools/docs/ruby/fixture:geometry_crlf_docs)",
        "DX_FIXTURE_EXT_SHARD": "$(rootpath //tools/docs/ruby/fixture:geometry_ext_docs)",
        "DX_FIXTURE_JSON": "$(rootpath :fixture_yard_json)",
        "DX_FIXTURE_GEOMETRY_RB": "$(rootpath //tools/docs/ruby/fixture:lib/geometry.rb)",
        "DX_FIXTURE_SHAPES_RB": "$(rootpath //tools/docs/ruby/fixture:lib/geometry/shapes.rb)",
        "DX_FIXTURE_SQUARE_RB": "$(rootpath //tools/docs/ruby/fixture:ext/square.rb)",
        "DX_FIXTURE_SHARD": "$(rootpath //tools/docs/ruby/fixture:geometry_docs)",
        "DX_RUBY": "$(rootpath :ruby_runtime)",
        "DX_RUBY_EXTRACT": "$(rootpath //tools/docs/ruby/extract:ruby_extract)",
        "DX_YARD_DUMP": "$(rootpath yard_dump.rb)",
        "DX_TESTDATA_BROKEN": "$(rootpath //tools/docs/ruby/fixture:testdata/broken.rb)",
        "DX_YARD_RB": "$(rootpath @dx_yard//:lib/yard.rb)",
    },
    tags = ["no-coverage"],
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//tools/docs/ir/ir:documentation_ir",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "aspect.bzl",
        "defs.bzl",
        "extensions.bzl",
        "repos.bzl",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
