load("@crates//:crates.bzl", "aliases")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//core/quality/testdata:real_aspect_subject.bzl", "real_docs_shard_files")
load("//rust:defs.bzl", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS_PUBLIC)

exports_files(
    ["defs.bzl"],
    visibility = VIS_TOOLS,
)

real_docs_shard_files(
    name = "fixture_rustdoc_json",
    testonly = True,
    group = "rustdoc_json",
    target = "//tools/docs/rust/fixture:docs_fixture",
)

real_docs_shard_files(
    name = "fixture_srcs_file",
    testonly = True,
    group = "srcs_manifest",
    target = "//tools/docs/rust/fixture:docs_fixture",
)

rust_test(
    name = "extract_test",
    srcs = ["extract_test.rs"],
    aliases = aliases(
        package_name = "tools/docs/docs_rust",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "extract_test",
    crate_root = "extract_test.rs",
    data = [
        ":fixture_rustdoc_json",
        ":fixture_srcs_file",
        "//core/quality/testdata:docs_fixture_aspect_shard",
        "//tools/docs/rust/extract:rust_extract",
    ],
    env = {
        "DX_ASPECT_SHARD": "$(rootpath //core/quality/testdata:docs_fixture_aspect_shard)",
        "DX_FIXTURE_RUSTDOC": "$(rootpath :fixture_rustdoc_json)",
        "DX_FIXTURE_SRCS": "$(rootpath :fixture_srcs_file)",
        "DX_RUST_EXTRACT": "$(rootpath //tools/docs/rust/extract:rust_extract)",
    },
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//tools/docs/ir/ir:documentation_ir",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "aspect.bzl",
        "defs.bzl",
        "site.bzl",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
