load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_library", "rust_test", "rustfmt_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")

package(default_visibility = VIS_TOOLS)

exports_files([
    "src/lib.rs",
    "src/lib_changed.rs",
    "src/shapes.rs",
], visibility = VIS_TOOLS)

# keep
cargo_build_script(
    name = "docs_fixture_build_script",
    srcs = ["build.rs"],
    crate_name = "build_script_build",
    crate_root = "build.rs",
    pkg_name = "docs_fixture",
    version = "1.0.0",
)

# keep
rust_library(
    name = "docs_fixture",
    srcs = [
        "src/lib.rs",
        "src/shapes.rs",
    ],
    crate_features = ["extra"],
    crate_name = "docs_fixture",
    crate_root = "src/lib.rs",
    deps = [":docs_fixture_build_script"],
)

# keep
rust_library(
    name = "docs_fixture_changed",
    srcs = [
        "src/lib_changed.rs",
        "src/shapes.rs",
    ],
    crate_features = ["extra"],
    crate_name = "docs_fixture",
    crate_root = "src/lib_changed.rs",
    deps = [":docs_fixture_build_script"],
)

# keep
rust_test(
    name = "docs_fixture_test",
    crate = ":docs_fixture",
    tags = ["manual"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

rustfmt_test(
    name = "fixture_fmt_test",
    targets = [
        ":docs_fixture",
        ":docs_fixture_build_script_",
        ":docs_fixture_changed",
    ],
)
