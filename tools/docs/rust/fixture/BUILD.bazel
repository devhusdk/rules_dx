load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_lint_config", upstream_rust_library = "rust_library")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")

package(default_visibility = VIS_TOOLS)

exports_files(
    [
        "src/lib.rs",
        "src/lib_changed.rs",
        "src/shapes.rs",
    ],
    visibility = VIS_TOOLS,
)

cargo_build_script(
    name = "docs_fixture_build_script",
    srcs = ["build.rs"],
    crate_name = "build_script_build",
    crate_root = "build.rs",
    pkg_name = "docs_fixture",
    version = "1.0.0",
)

rust_library(
    name = "docs_fixture",
    srcs = [
        "src/lib.rs",
        "src/shapes.rs",
    ],
    crate_features = ["extra"],
    crate_name = "docs_fixture",
    crate_root = "src/lib.rs",
    deps = [":docs_fixture_build_script"],
)

rust_library(
    name = "docs_fixture_changed",
    srcs = [
        "src/lib_changed.rs",
        "src/shapes.rs",
    ],
    crate_features = ["extra"],
    crate_name = "docs_fixture",
    crate_root = "src/lib_changed.rs",
    deps = [":docs_fixture_build_script"],
)

rust_test(
    name = "docs_fixture_test",
    crate = ":docs_fixture",
)

rust_lint_config(
    name = "docs_fixture_lints",
    rustdoc = {"broken_intra_doc_links": "warn"},
)

upstream_rust_library(
    name = "docs_fixture_lints_upstream",
    srcs = [
        "src/lib.rs",
        "src/shapes.rs",
    ],
    crate_name = "docs_fixture_lints_upstream",
    lint_config = ":docs_fixture_lints",
    deps = [":docs_fixture_build_script"],
)

rust_library(
    name = "docs_fixture_lints_dx",
    srcs = [
        "src/lib.rs",
        "src/shapes.rs",
    ],
    crate_name = "docs_fixture_lints_dx",
    lint_config = ":docs_fixture_lints",
    deps = [":docs_fixture_build_script"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
