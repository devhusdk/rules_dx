)

# keep
rust_test(
    name = "browser_test",
    size = "large",
    srcs = [
        "browser_test.rs",
        "preview_server.rs",
    ],
    crate_root = "browser_test.rs",
    data = [
        ":user_site",
        "//tools/docs/site/browser:firefox",
        "//tools/docs/site/browser:firefox_tree",
    ],
    env = {
        "DX_FIREFOX": "$(rootpath //tools/docs/site/browser:firefox)",
        "DX_USER_SITE": "$(rootpath :user_site)",
    },
    tags = [
        "no-coverage",
        "no-remote-exec",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//tools/docs/site/browser:dx_site_browser",
        "//tools/testing:dx_testing",
    ],
)

