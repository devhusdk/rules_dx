load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust/rules:defs.bzl", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")
load("@rules_dx//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS_PUBLIC)

filegroup(
    name = "firefox",
    srcs = ["@dx_firefox//:firefox"],
    target_compatible_with = ["@platforms//os:linux"],
)

filegroup(
    name = "firefox_tree",
    srcs = ["@dx_firefox//:tree"],
    target_compatible_with = ["@platforms//os:linux"],
)

exports_files([
    "Cargo.toml",
    "repos.bzl",
    "src/lib.rs",
    "src/lib_tests.rs",
], visibility = VIS_TOOLS)

rust_library(
    name = "dx_site_browser",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "tools/docs/site/site_browser",
        normal = True,
    ),
    crate_name = "dx_site_browser",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = all_crate_deps(
        package_name = "tools/docs/site/site_browser",
        normal = True,
    ),
)

rust_test(
    name = "dx_site_browser_test",
    size = "small",
    srcs = [
        "src/lib.rs",
        "src/lib_tests.rs",
    ],
    aliases = aliases(
        package_name = "tools/docs/site/site_browser",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "dx_site_browser",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = all_crate_deps(
        package_name = "tools/docs/site/site_browser",
        normal = True,
        normal_dev = True,
    ) + ["//cli/test_scratch:dx_test_scratch"],
)

rustfmt_test(
    name = "dx_site_browser_fmt_test",
    size = "small",
    targets = [
        ":dx_site_browser",
        ":dx_site_browser_test",
    ],
)

rust_clippy_test(
    name = "dx_site_browser_clippy_test",
    size = "small",
    targets = [":dx_site_browser"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "repos.bzl",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
