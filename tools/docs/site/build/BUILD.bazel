load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("@rules_dx//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS_PUBLIC)

exports_files(
    [
        "Cargo.toml",
        "src/lib.rs",
        "src/lib_tests.rs",
        "src/main.rs",
    ],
    visibility = VIS_TOOLS,
)

rust_library(
    name = "dx_site_build",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "tools/docs/site/site_build",
        normal = True,
    ),
    crate_name = "dx_site_build",
    crate_root = "src/lib.rs",
    visibility = VIS_TOOLS_PUBLIC,
    deps = [],
)

rust_test(
    name = "dx_site_build_test",
    srcs = [
        "src/lib.rs",
        "src/lib_tests.rs",
    ],
    aliases = aliases(
        package_name = "tools/docs/site/site_build",
        normal = True,
        normal_dev = True,
    ),
    coverage_lib = ":dx_site_build",
    crate_name = "dx_site_build",
    crate_root = "src/lib.rs",
    deps = [],
)

rust_binary(
    name = "site_build",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "tools/docs/site/site_build",
        normal = True,
    ),
    crate_name = "site_build",
    crate_root = "src/main.rs",
    deps = all_crate_deps(
        package_name = "tools/docs/site/site_build",
        normal = True,
    ) + [":dx_site_build"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
