load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//python:defs.bzl", "python_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")
load(":facts.bzl", "support_matrix_facts")
load(":facts_tests.bzl", "support_matrix_facts_tests")
load(":languages.bzl", "support_matrix_inputs")

package(default_visibility = VIS_TOOLS)

support_matrix_facts(name = "facts")

support_matrix_facts_tests(name = "facts_test")

filegroup(
    name = "inputs",
    srcs = [
        ":facts",
        "//.github:workflows/ci.yml",
        "//cli/cli:src/exec/unsupported.json",
    ] + support_matrix_inputs(),
)

rust_library(
    name = "support_matrix",
    srcs = [
        "src/lib.rs",
        "src/render.rs",
        "src/runfiles_source.rs",
        "src/starlark.rs",
        "src/workflows.rs",
    ],
    aliases = aliases(
        package_name = "tools/docs/support_matrix",
        normal = True,
    ),
    crate_name = "support_matrix",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "tools/docs/support_matrix",
        normal = True,
    ) + [
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:yaml_serde",
        "@rules_rust//rust/runfiles",
    ],
)

rust_test(
    name = "support_matrix_test",
    aliases = aliases(
        package_name = "tools/docs/support_matrix",
        normal = True,
        normal_dev = True,
    ),
    crate = ":support_matrix",
    deps = all_crate_deps(
        package_name = "tools/docs/support_matrix",
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "generate_test",
    srcs = ["src/generate_test.rs"],
    aliases = aliases(
        package_name = "tools/docs/support_matrix",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "generate_test",
    crate_root = "src/generate_test.rs",
    data = [
        ":inputs",
        "//docs:support-matrix.md",
    ],
    deps = all_crate_deps(
        package_name = "tools/docs/support_matrix",
        normal = True,
        normal_dev = True,
    ) + [
        ":support_matrix",
        "@rules_rust//rust/runfiles",
    ],
)

rust_binary(
    name = "update",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "tools/docs/support_matrix",
        normal = True,
    ),
    args = ["--write"],
    crate_name = "update",
    crate_root = "src/main.rs",
    data = [":inputs"],
    deps = all_crate_deps(
        package_name = "tools/docs/support_matrix",
        normal = True,
    ) + [":support_matrix"],
)

python_test(
    name = "macro_rows_test",
    srcs = ["macro_rows.py"],
    data = [":languages.bzl"],
    main = "macro_rows.py",
    runner = "plain",
    tags = [
        "external",
        "local",
        "no-sandbox",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "facts.bzl",
        "facts_tests.bzl",
        "languages.bzl",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
