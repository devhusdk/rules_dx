load("@crates//:crates.bzl", "aliases")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")

package(default_visibility = VIS_TOOLS)

exports_files(["tiers.bzl"])

rust_library(
    name = "tiers",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "tools/docs/tiers",
        normal = True,
    ),
    crate_name = "tiers",
    crate_root = "src/lib.rs",
    deps = ["//cli/diff:dx_diff"],
)

rust_test(
    name = "tiers_test",
    aliases = aliases(
        package_name = "tools/docs/tiers",
        normal = True,
        normal_dev = True,
    ),
    crate = ":tiers",
    deps = [],
)

rust_binary(
    name = "render",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "tools/docs/tiers",
        normal = True,
    ),
    crate_name = "render",
    crate_root = "src/main.rs",
    deps = [":tiers"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "tiers.bzl",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    [
        "src/lib.rs",
        "src/main.rs",
    ],
    visibility = ["//core/quality:__pkg__"],
)
