load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")

package(default_visibility = VIS_TOOLS)

exports_files(["tiers.bzl"])

# keep
rust_library(
    name = "tiers",
    srcs = ["src/lib.rs"],
    crate_name = "tiers",
    crate_root = "src/lib.rs",
    deps = ["//cli/diff:dx_diff"],
)

# keep
rust_test(
    name = "tiers_test",
    crate = ":tiers",
)

# keep
rust_binary(
    name = "render",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    deps = [":tiers"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "tiers.bzl",
    ],
    tags = ["corpus"],
)
