load("@crates//:crates.bzl", "aliases")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS_PUBLIC)

exports_files(
    [
        "defs.bzl",
        "shard.bzl",
    ],
    visibility = VIS_TOOLS,
)

rust_test(
    name = "extract_test",
    srcs = ["extract_test.rs"],
    aliases = aliases(
        package_name = "tools/docs/typescript_docs_tests",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "extract_test",
    crate_root = "extract_test.rs",
    data = [
        "//tools/docs/typescript/extract:typescript_extract",
        "//tools/docs/typescript/fixture:geometry_docs",
        "//tools/docs/typescript/fixture:geometry_docs.typedoc.json",
    ],
    env = {
        "DX_FIXTURE_SHARD": "$(rootpath //tools/docs/typescript/fixture:geometry_docs)",
        "DX_FIXTURE_TYPEDOC": "$(rootpath //tools/docs/typescript/fixture:geometry_docs.typedoc.json)",
        "DX_TYPESCRIPT_EXTRACT": "$(rootpath //tools/docs/typescript/extract:typescript_extract)",
    },
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//tools/docs/ir/ir:documentation_ir",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "isolation_test",
    srcs = ["isolation_test.rs"],
    aliases = aliases(
        package_name = "tools/docs/typescript_docs_tests",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "isolation_test",
    crate_root = "isolation_test.rs",
    data = [
        "//tools/docs/typescript/fixture/hostile:hostile_control_base",
        "//tools/docs/typescript/fixture/hostile:hostile_control_package",
        "//tools/docs/typescript/fixture/hostile:hostile_control_tsconfig.typedoc.json",
        "//tools/docs/typescript/fixture/hostile:hostile_docs",
        "//tools/docs/typescript/fixture/hostile:hostile_docs.typedoc.json",
    ],
    env = {
        "DX_HOSTILE_CONTROL_BASE": "$(rootpath //tools/docs/typescript/fixture/hostile:hostile_control_base)",
        "DX_HOSTILE_CONTROL_PACKAGE": "$(rootpath //tools/docs/typescript/fixture/hostile:hostile_control_package)",
        "DX_HOSTILE_CONTROL_TSCONFIG": "$(rootpath //tools/docs/typescript/fixture/hostile:hostile_control_tsconfig.typedoc.json)",
        "DX_HOSTILE_SHARD": "$(rootpath //tools/docs/typescript/fixture/hostile:hostile_docs)",
        "DX_HOSTILE_TYPEDOC": "$(rootpath //tools/docs/typescript/fixture/hostile:hostile_docs.typedoc.json)",
    },
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//tools/docs/ir/ir:documentation_ir",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "shard.bzl",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
