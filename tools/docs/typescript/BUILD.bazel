load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_test", "rustfmt_test")
load("//tools/visibility:visibility.bzl", "VIS_PUBLIC")

package(default_visibility = VIS_PUBLIC)

exports_files(["defs.bzl"])

# keep
rust_test(
    name = "extract_test",
    size = "small",
    srcs = ["extract_test.rs"],
    data = [
        "//tools/docs/typescript/extract:typescript_extract",
        "//tools/docs/typescript/fixture:geometry_docs",
        "//tools/docs/typescript/fixture:geometry_docs.typedoc.json",
    ],
    env = {
        "DX_FIXTURE_SHARD": "$(rootpath //tools/docs/typescript/fixture:geometry_docs)",
        "DX_FIXTURE_TYPEDOC": "$(rootpath //tools/docs/typescript/fixture:geometry_docs.typedoc.json)",
        "DX_TYPESCRIPT_EXTRACT": "$(rootpath //tools/docs/typescript/extract:typescript_extract)",
    },
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//tools/docs/ir/ir:documentation_ir",
        "//tools/testing:dx_testing",
    ],
)

rustfmt_test(
    name = "typescript_extract_fmt_test",
    size = "small",
    targets = [":extract_test"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
    ],
    tags = ["corpus"],
)
