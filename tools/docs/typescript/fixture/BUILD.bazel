load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//tools/docs/typescript:defs.bzl", "typescript_doc_shard")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")

package(default_visibility = VIS_TOOLS)

typescript_doc_shard(
    name = "geometry_docs",
    srcs = glob(["src/*.ts"]),
    entry_points = ["src/index.ts"],
    package = "geometry",
    tsconfig = "tsconfig.json",
)

ts_project(
    name = "geometry_library",
    srcs = glob(["src/*.ts"]),
    declaration = True,
    no_emit = True,
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
