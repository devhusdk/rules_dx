load("//core/quality:fixtures.bzl", "real_source_target")
load("//tools/docs/ir:dx_extract_test.bzl", "dx_extract_test")
load("//tools/docs/zig:defs.bzl", "zig_doc_shard")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")
load("//zig:defs.bzl", "zig_library")

package(default_visibility = VIS_TOOLS)

# keep
zig_library(
    name = "geometry",
    srcs = ["geometry/shapes.zig"],
    main = "geometry/geometry.zig",
    deps = [":units"],
)

# keep
zig_library(
    name = "units",
    main = "units/units.zig",
)

zig_doc_shard(
    name = "units_docs",
    lib = ":units",
)

dx_extract_test(
    name = "units_docs_dx_extract_test",
    size = "small",
    mnemonic = "DxDocsZigExtract",
    subcommand = "zig_extract",
    target_under_test = ":units_docs",
)

zig_doc_shard(
    name = "geometry_docs",
    lib = ":geometry",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
