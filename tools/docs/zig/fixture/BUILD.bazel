load("//quality:fixtures.bzl", "real_source_target")
load("//tools/docs/zig:defs.bzl", "zig_doc_shard")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")
load("//zig/rules:defs.bzl", "zig_library")

package(default_visibility = VIS_TOOLS)

zig_library(
    name = "geometry",
    srcs = ["geometry/shapes.zig"],
    main = "geometry/geometry.zig",
    deps = [":units"],
)

zig_library(
    name = "units",
    main = "units/units.zig",
)

zig_doc_shard(
    name = "units_docs",
    lib = ":units",
)

zig_doc_shard(
    name = "geometry_docs",
    lib = ":geometry",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
