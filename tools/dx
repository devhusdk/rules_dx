#!/bin/sh
set -eu
die() {
  echo "dx: $1" >&2
  exit 1
}
is_ci() {
  case "${CI:-}" in
  [Tt][Rr][Uu][Ee] | 1 | [Yy][Ee][Ss]) return 0 ;;
  esac
  return 1
}
case $0 in
*/*) self_dir=${0%/*} ;;
*) self_dir=. ;;
esac
root=$(CDPATH='' cd -- "${self_dir:-/}/.." && pwd)
os=
exe=
case "$(uname -s)" in
Linux) os=linux ;;
Darwin) os=macos ;;
MINGW* | MSYS* | CYGWIN*)
  os=windows
  exe=.exe
  MSYS2_ARG_CONV_EXCL='*'
  export MSYS2_ARG_CONV_EXCL
  ;;
esac
if [ "$os" = linux ] && [ -z "${MALLOC_ARENA_MAX+x}" ]; then
  case ${GLIBC_TUNABLES:-} in
  *glibc.malloc.arena_max*) ;;
  *) MALLOC_ARENA_MAX=2 && export MALLOC_ARENA_MAX ;;
  esac
fi
source_checkout() {
  [ -f "$1/cli/cli/BUILD.bazel" ] && [ -f "$1/MODULE.bazel" ] || return 1
  while IFS= read -r sc_line || [ -n "$sc_line" ]; do
    case $sc_line in
    '    name = "rules_dx",'*) return 0 ;;
    esac
  done <"$1/MODULE.bazel" 2>/dev/null
  return 1
}
execroot_marker() {
  _p=${1%/*}
  [ "${_p##*/}" = execroot ] && [ -f "$_p/DO_NOT_BUILD_HERE" ]
}
bin="$root/bazel-bin/cli/cli/dx$exe"
state="$root/.dx/local/launcher"
if [ "${1:-}" = worktree ] && [ "${2:-}" = hook ]; then
  [ -x "$state/dx$exe" ] && exec "$state/dx$exe" "$@"
  [ -x "$bin" ] && exec "$bin" "$@"
fi
here=$(pwd -P) || here=/
while [ "$here" != / ]; do
  if source_checkout "$here"; then
    execroot_marker "$here" || break
    # Inside a Bazel execroot (reached through bazel-bin): follow Bazel's own
    # marker back to the real checkout, once.
    v=
    IFS= read -r v <"${here%/*}/DO_NOT_BUILD_HERE" || true
    v=${v%"$(printf '\r')"}
    if [ -n "$v" ]; then v=$(CDPATH='' cd -P -- "$v" 2>/dev/null && pwd -P) || v=; fi
    if [ -n "$v" ] && source_checkout "$v" && ! execroot_marker "$v"; then
      here=$v
      break
    fi
  fi
  here=${here%/*}
  here=${here:-/}
done
if [ "$here" != / ] && [ "$here" != "$(cd -P -- "$root" && pwd -P)" ] && [ -x "$here/tools/dx" ]; then
  exec "$here/tools/dx" "$@"
fi
# Worktree add and release must stay fast and must not wait on Bazel: run the last built dx without a stale check.
# Keep this list in sync with tools/dx.cmd.
if [ "${1:-}" = worktree ]; then
  case "${2:-}" in
  add | release)
    [ -x "$state/dx$exe" ] && exec "$state/dx$exe" "$@"
    [ -x "$bin" ] && exec "$bin" "$@"
    ;;
  esac
fi
# Sets rc_u to $1 without one pair of matching outer quotes.
rc_unq() {
  rc_u=$1
  case $1 in
  \"*\" | \'*\') rc_u=${1#?} rc_u=${rc_u%?} ;;
  esac
}
# Scans one bazelrc file and the files it imports. Prints cache and returns 0 when a disk cache option is set; prints gc
# when only a disk cache gc option is set. Always run it in a command substitution: it sets -f and its variables are
# not restored.
rc_scan() {
  set -f
  rs_file=$1
  rs_depth=$2
  if [ -z "$rs_file" ] || [ "$rs_depth" -gt 16 ]; then return 1; fi
  case "$rc_seen" in
  *"
$rs_file
"*) return 1 ;;
  esac
  rc_seen="$rc_seen$rs_file
"
  [ -r "$rs_file" ] || return 1
  rs_cr=$(printf '\r')
  rs_ws=" 	$rs_cr"
  rs_tok='%workspace%'
  rs_gc=
  while IFS= read -r rs_line || [ -n "$rs_line" ]; do
    case $rs_line in
    *[!$rs_ws]*) ;;
    *) continue ;;
    esac
    rs_line=${rs_line#"${rs_line%%[!$rs_ws]*}"}
    rs_line=${rs_line%"${rs_line##*[!$rs_ws]}"}
    case $rs_line in
    '#'*) continue ;;
    esac
    rs_first=${rs_line%%[$rs_ws]*}
    rs_rest=${rs_line#"$rs_first"}
    rs_rest=${rs_rest#"${rs_rest%%[!$rs_ws]*}"}
    rc_unq "$rs_first"
    case $rc_u in
    import | try-import)
      rc_unq "$rs_rest"
      rs_t=$rc_u
      rs_r=
      while :; do
        case $rs_t in
        *"$rs_tok"*) rs_r=$rs_r${rs_t%%"$rs_tok"*}$root rs_t=${rs_t#*"$rs_tok"} ;;
        *) break ;;
        esac
      done
      rs_t=$rs_r$rs_t
      case $rs_t in
      /* | [A-Za-z]:*) ;;
      *) rs_t=$root/$rs_t ;;
      esac
      rs_sub=$(rc_scan "$rs_t" "$((rs_depth + 1))") || true
      case $rs_sub in
      *cache*)
        echo cache
        return 0
        ;;
      *gc*) rs_gc=1 ;;
      esac
      continue
      ;;
    esac
    for rs_w in $rs_line; do
      rc_unq "$rs_w"
      rs_t=$rc_u
      while :; do
        case $rs_t in
        \"* | \'*) rs_t=${rs_t#?} ;;
        *) break ;;
        esac
      done
      case $rs_t in
      --disk_cache* | --nodisk_cache*)
        echo cache
        return 0
        ;;
      --experimental_disk_cache_gc_max_size | --experimental_disk_cache_gc_max_size=* | --experimental_disk_cache_gc_max_age | --experimental_disk_cache_gc_max_age=*) rs_gc=1 ;;
      esac
    done
  done <"$rs_file"
  [ -z "$rs_gc" ] || echo gc
  return 1
}
rc_scan_all() {
  rc_seen='
'
  rsa_gc=
  for rsa_f in "$@"; do
    rsa_o=$(rc_scan "$rsa_f" 0) || true
    case $rsa_o in
    *cache*)
      echo cache
      return 0
      ;;
    *gc*) rsa_gc=1 ;;
    esac
  done
  if [ -n "$rsa_gc" ]; then echo gc; else echo none; fi
}
tag_state() {
  { printf '%s\n%s\n' 'Signature: 8a477f597d28d172789f06886806bc55' '# Rebuildable copy of dx kept by tools/dx; see https://bford.info/cachedir/' >"$state/CACHEDIR.TAG.$$" && mv -f "$state/CACHEDIR.TAG.$$" "$state/CACHEDIR.TAG"; } 2>/dev/null || rm -f "$state/CACHEDIR.TAG.$$"
}
stale() {
  [ -x "$bin" ] && [ -s "$state/inputs" ] && [ -f "$state/built" ] || return 0
  while IFS= read -r st_p || [ -n "$st_p" ]; do
    st_p=${st_p#//}
    st_p=${st_p#:}
    case $st_p in
    *:*) st_p=${st_p%%:*}/${st_p#*:} ;;
    esac
    [ -n "$st_p" ] || continue
    [ "$root/$st_p" -nt "$state/built" ] && return 0
  done <"$state/inputs"
  for st_p in .bazelrc .bazelversion user.bazelrc .dx/bazelrc/correctness.bazelrc .dx/bazelrc/performance.bazelrc .dx/bazelrc/resources.bazelrc MODULE.bazel MODULE.bazel.lock cargo-bazel-lock.json; do
    [ "$root/$st_p" -nt "$state/built" ] && return 0
  done
  return 1
}
# Keep in sync with DX_SYNC in tools/dx.cmd: a copy is current when size and mtime match bin's, and cp -p keeps the
# mtime, so a copy made by either launcher counts for the other. The copy is never written in place; on Windows the
# running copy is renamed aside first because a running exe cannot be replaced.
copy_current() {
  [ -f "$state/dx$exe" ] && [ -f "$bin" ] && [ "$(wc -c <"$state/dx$exe")" = "$(wc -c <"$bin")" ] &&
    ! [ "$state/dx$exe" -nt "$bin" ] && ! [ "$state/dx$exe" -ot "$bin" ]
}
# A run killed before its trap ran leaves its pid's temp files behind. A pid that still answers kill -0 belongs to a live run.
sweep_temps() {
  for t in "$state/dx$exe".[0-9]* "$state/built".[0-9]* "$state/inputs".[0-9]* "$state/query".[0-9]*; do
    [ -e "$t" ] || continue
    kill -0 "${t##*.}" 2>/dev/null || rm -f "$t"
  done
}
sync_copy() {
  sweep_temps
  rm -f "$state/dx$exe".old.* 2>/dev/null || true
  if ! copy_current; then
    [ -f "$bin" ] || return 1
    if cp -p "$bin" "$state/dx$exe.$$" 2>/dev/null && ! copy_current; then
      if [ "$os" = windows ] && [ -e "$state/dx$exe" ]; then
        mv "$state/dx$exe" "$state/dx$exe.old.$$" 2>/dev/null || true
      fi
      mv -f "$state/dx$exe.$$" "$state/dx$exe" 2>/dev/null || true
    fi
    rm -f "$state/dx$exe.$$" 2>/dev/null || true
    rm -f "$state/dx$exe".old.* 2>/dev/null || true
    tag_state
  fi
  copy_current
}
# Bazel exits 33 (out of memory) or 37 (internal error) when its server crashes. A build or an inputs lookup is safe
# to run again, so try once more after a short wait. Keep the codes and wait in sync with RESTART_EXIT and
# backoff in cli/cli/src/bazel_restart.rs, and with tools/dx.cmd.
retry_crash() {
  "$@" && return 0 || ec=$?
  case $ec in 33 | 37) ;; *) return "$ec" ;; esac
  echo "dx: the Bazel server crashed (exit $ec); trying //:dx again" >&2
  sleep "${DX_RESTART_WAIT:-2}"
  "$@" && return 0 || return $?
}
build_dx() {
  # shellcheck disable=SC2086 # rc and gc are option lists that must split
  (cd "$root" && bazel $rc build ${dc:+"$dc"} $gc --curses=no --show_progress_rate_limit=30 --progress_report_interval=30 --show_result=0 --ui_event_filters=-info //:dx >&2)
}
query_inputs() {
  # shellcheck disable=SC2086 # rc is an option list that must split
  # Each attempt truncates the file, so a retry never keeps a crashed attempt's partial output.
  (cd "$root" && bazel $rc query --noshow_progress --ui_event_filters=-info 'kind("source file", deps(//:dx)) + buildfiles(deps(//:dx))' >"$state/query.$$")
}
# True for `update --apply [dx_crates]` without --frozen or --offline: the only launches that may repin.
wants_cargo_repin() {
  [ "${1:-}" = update ] || return 1
  shift
  w_apply=
  w_sel=0
  for w_arg in "$@"; do
    case $w_arg in
    --apply) w_apply=1 ;;
    --frozen | --offline) return 1 ;;
    -*) ;;
    dx_crates) w_sel=$((w_sel + 1)) ;;
    *) return 1 ;;
    esac
  done
  [ -n "$w_apply" ] && [ "$w_sel" -le 1 ]
}
cleanup() {
  rm -f "$state/built.$$" "$state/inputs.$$" "$state/query.$$" "$state/dx$exe.$$"
}
on_signal() {
  cleanup
  trap - EXIT INT TERM HUP
  kill -s "$1" "$$"
  case $1 in INT) exit 130 ;; TERM) exit 143 ;; *) exit 129 ;; esac
}
guard_temps() {
  trap cleanup EXIT
  trap 'on_signal INT' INT
  trap 'on_signal TERM' TERM
  trap 'on_signal HUP' HUP
}
if stale; then
  command -v bazel >/dev/null 2>&1 || die "bazel is not on PATH"
  mkdir -p "$state"
  tag_state
  guard_temps
  : >"$state/built.$$"
  rc="--nohome_rc --nosystem_rc"
  [ -n "${BAZEL_TEST:-}" ] || rc=
  dc=
  gc=
  found=
  cache=${XDG_CACHE_HOME:-${HOME:+$HOME/.cache}}
  cache=${cache:-${LOCALAPPDATA:-}}
  home=${HOME:-${USERPROFILE:-}}
  sysrc=/etc/bazel.bazelrc
  [ "$os" != windows ] || sysrc=${ProgramData:+$ProgramData/bazel.bazelrc}
  [ -n "$rc" ] || [ -z "$cache" ] || found=$(rc_scan_all "$root/.bazelrc" "${home:+$home/.bazelrc}" "$sysrc" 2>/dev/null) || found=
  if [ -z "$rc" ] && ! is_ci && [ -n "$cache" ] && [ "${found:-}" != cache ]; then
    dc="--disk_cache=$cache/dx/disk-cache"
    [ "$os" != windows ] || dc="--disk_cache=$(cygpath -w "$cache/dx/disk-cache")"
    # Keep in sync with DISK_CACHE_GC_MAX_SIZE and DISK_CACHE_GC_MAX_AGE in cli/process/src/rc.rs.
    [ "${found:-}" = gc ] || gc="--experimental_disk_cache_gc_max_size=20G --experimental_disk_cache_gc_max_age=14d"
  fi
  echo "dx: building //:dx" >&2
  built=
  hint=
  if retry_crash build_dx; then
    built=1
  elif wants_cargo_repin "$@"; then
    echo "dx: //:dx does not build; repinning the Cargo lock (CARGO_BAZEL_REPIN=1) and building it again" >&2
    # Keep in sync with the SetId::Cargo plan env in cli/update/src/backend.rs.
    # shellcheck disable=SC2086 # rc and gc are option lists that must split
    if (cd "$root" && CARGO_BAZEL_REPIN=1 bazel $rc build ${dc:+"$dc"} $gc --curses=no --show_progress_rate_limit=30 --progress_report_interval=30 --show_result=0 --ui_event_filters=-info //:dx >&2); then
      built=1
    fi
  else
    hint=1
  fi
  if [ -z "$built" ]; then
    [ -z "$hint" ] || echo "dx: if a Cargo.toml dependency changed, run tools/dx update --apply dx_crates to repin" >&2
    if [ -x "$state/dx$exe" ]; then
      rm -f "$state/built.$$"
      echo "dx: //:dx does not build; running the previous dx" >&2
      exec "$state/dx$exe" "$@"
    fi
    die "bazel build //:dx failed"
  fi
  sync_copy || true
  if retry_crash query_inputs; then
    : >"$state/inputs.$$"
    while IFS= read -r q_line || [ -n "$q_line" ]; do
      q_line=${q_line%"$(printf '\r')"}
      case $q_line in
      //*) printf '%s\n' "$q_line" >>"$state/inputs.$$" ;;
      esac
    done <"$state/query.$$"
    rm -f "$state/query.$$"
    mv "$state/inputs.$$" "$state/inputs"
    mv "$state/built.$$" "$state/built"
  else
    # The fresh dx is already stored. Leave built alone so the next call rebuilds and queries again.
    echo "dx: bazel query for the inputs of //:dx failed; running the fresh dx anyway" >&2
    rm -f "$state/built.$$" "$state/inputs.$$" "$state/query.$$"
  fi
fi
if [ -x "$bin" ]; then
  guard_temps
  # Run the copy so a running dx never locks bazel-bin. Any failure falls back to bin.
  if sync_copy && [ -x "$state/dx$exe" ]; then bin="$state/dx$exe"; fi
fi
exec "$bin" "$@"
