#!/bin/sh
set -eu
die() {
  echo "dx: $1" >&2
  exit 1
}
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
os=
exe=
case "$(uname -s)" in
  Linux) os=linux ;;
  Darwin) os=macos ;;
  MINGW* | MSYS* | CYGWIN*)
    os=windows
    exe=.exe
    MSYS2_ARG_CONV_EXCL='*'
    export MSYS2_ARG_CONV_EXCL
    ;;
esac
source_checkout() {
  [ -f "$1/cli/cli/BUILD.bazel" ] && grep -q '^    name = "rules_dx",' "$1/MODULE.bazel" 2> /dev/null
}
execroot_marker() {
  _p=${1%/*}
  [ "${_p##*/}" = execroot ] && [ -f "$_p/DO_NOT_BUILD_HERE" ]
}
bin="$root/bazel-bin/cli/cli/dx$exe"
state="$root/.dx/launcher"
if [ "${1:-}" = worktree ] && [ "${2:-}" = hook ]; then
  [ -x "$state/dx$exe" ] && exec "$state/dx$exe" "$@"
  [ -x "$bin" ] && exec "$bin" "$@"
fi
here=$(pwd -P) || here=/
while [ "$here" != / ]; do
  if source_checkout "$here"; then
    execroot_marker "$here" || break
    # Inside a Bazel execroot (reached through bazel-bin): follow Bazel's own
    # marker back to the real checkout, once.
    v=
    IFS= read -r v < "${here%/*}/DO_NOT_BUILD_HERE" || true
    v=${v%"$(printf '\r')"}
    if [ -n "$v" ]; then v=$(CDPATH= cd -P -- "$v" 2> /dev/null && pwd -P) || v=; fi
    if [ -n "$v" ] && source_checkout "$v" && ! execroot_marker "$v"; then
      here=$v
      break
    fi
  fi
  here=${here%/*}
  here=${here:-/}
done
if [ "$here" != / ] && [ "$here" != "$(cd -P -- "$root" && pwd -P)" ] && [ -x "$here/tools/dx" ]; then
  exec "$here/tools/dx" "$@"
fi
tag_state() {
  { printf '%s\n%s\n' 'Signature: 8a477f597d28d172789f06886806bc55' '# Rebuildable copy of dx kept by tools/dx; see https://bford.info/cachedir/' > "$state/CACHEDIR.TAG.$$" && mv -f "$state/CACHEDIR.TAG.$$" "$state/CACHEDIR.TAG"; } 2> /dev/null || rm -f "$state/CACHEDIR.TAG.$$"
}
if [ -d "$state" ] && [ ! -f "$state/CACHEDIR.TAG" ]; then
  tag_state
fi
stale() {
  [ -x "$bin" ] && [ -s "$state/inputs" ] && [ -f "$state/built" ] || return 0
  newer=$(cd "$root" && {
    sed -e 's|^//||' -e 's|^:||' -e 's|:|/|' "$state/inputs"
    printf '%s\n' .bazelrc .bazelversion user.bazelrc tools/bazelrc/correctness.bazelrc tools/bazelrc/performance.bazelrc tools/bazelrc/resources.bazelrc MODULE.bazel MODULE.bazel.lock cargo-bazel-lock.json
  } | tr '\n' '\0' | xargs -0 sh -c 'find "$@" -newer "$0" -print' "$state/built" 2> /dev/null) || true
  [ -n "$newer" ]
}
keep_copy() {
  { cp "$bin" "$state/dx$exe.$$" && mv -f "$state/dx$exe.$$" "$state/dx$exe"; } 2> /dev/null || rm -f "$state/dx$exe.$$"
  tag_state
}
# Bazel exits 33 (out of memory) or 37 (internal error) when its server crashes. A build or an inputs lookup is safe
# to run again, so try once more after a short wait. Keep the codes and wait in sync with RESTART_EXIT and
# backoff in cli/cli/src/bazel_restart.rs, and with tools/dx.cmd.
retry_crash() {
  "$@" && return 0 || ec=$?
  case $ec in 33 | 37) ;; *) return "$ec" ;; esac
  echo "dx: the Bazel server crashed (exit $ec); trying //:dx again" >&2
  sleep 2
  "$@" && return 0 || return $?
}
build_dx() {
  (cd "$root" && bazel $rc build ${dc:+"$dc"} $gc --curses=no --show_progress_rate_limit=30 --progress_report_interval=30 --show_result=0 --ui_event_filters=-info //:dx >&2)
}
query_inputs() {
  (cd "$root" && bazel $rc query --noshow_progress --ui_event_filters=-info 'kind("source file", deps(//cli/cli:dx)) + buildfiles(deps(//cli/cli:dx))')
}
# True for `update --apply [cargo]` without --check, --frozen or --offline: the only launches that may repin.
wants_cargo_repin() {
  [ "${1:-}" = update ] || return 1
  shift
  w_apply=
  w_sel=0
  for w_arg in "$@"; do
    case $w_arg in
      --apply) w_apply=1 ;;
      --check | --frozen | --offline) return 1 ;;
      -*) ;;
      cargo) w_sel=$((w_sel + 1)) ;;
      *) return 1 ;;
    esac
  done
  [ -n "$w_apply" ] && [ "$w_sel" -le 1 ]
}
if stale; then
  command -v bazel > /dev/null 2>&1 || die "bazel is not on PATH"
  mkdir -p "$state"
  : > "$state/built.$$"
  trap 'rm -f "$state/built.$$" "$state/inputs.$$" "$state/dx$exe.$$"' EXIT
  rc="--nohome_rc --nosystem_rc"
  [ "${CI:-}" = true ] || [ -n "${BAZEL_TEST:-}" ] || rc=
  dc=
  gc=
  found=
  cache=${XDG_CACHE_HOME:-${HOME:+$HOME/.cache}}
  cache=${cache:-${LOCALAPPDATA:-}}
  home=${HOME:-${USERPROFILE:-}}
  sysrc=/etc/bazel.bazelrc
  [ "$os" != windows ] || sysrc=${ProgramData:+$ProgramData/bazel.bazelrc}
  [ -n "$rc" ] || [ -z "$cache" ] || found=$(awk -v root="$root" '
    function trim(t) {
      sub(/^[ \t\r]+/, "", t)
      sub(/[ \t\r]+$/, "", t)
      return t
    }
    function unq(t, a) {
      a = substr(t, 1, 1)
      if (length(t) > 1 && (a == "\"" || a == "\047") && substr(t, length(t)) == a) return substr(t, 2, length(t) - 2)
      return t
    }
    function scan(f, d, line, w, n, i, t, r) {
      if (f == "" || d > 16 || (f in seen)) return 0
      seen[f] = 1
      while ((getline line < f) > 0) {
        line = trim(line)
        if (substr(line, 1, 1) == "#") continue
        n = split(line, w)
        t = unq(w[1])
        if (t == "import" || t == "try-import") {
          t = unq(trim(substr(line, length(t) + 1)))
          r = ""
          while ((i = index(t, "%workspace%")) > 0) {
            r = r substr(t, 1, i - 1) root
            t = substr(t, i + 11)
          }
          t = r t
          if (t !~ /^\// && t !~ /^[A-Za-z]:/) t = root "/" t
          if (scan(t, d + 1)) return 1
          continue
        }
        for (i = 1; i <= n; i++) {
          t = unq(w[i])
          while (substr(t, 1, 1) == "\"" || substr(t, 1, 1) == "\047") t = substr(t, 2)
          if (t ~ /^--(no)?disk_cache/) return 1
          if (t ~ /^--experimental_disk_cache_gc_max_(size|age)(=|$)/) gc = 1
        }
      }
      close(f)
      return 0
    }
    BEGIN {
      for (i = 1; i < ARGC; i++) if (scan(ARGV[i], 0)) { print "cache"; exit }
      print (gc ? "gc" : "none")
    }
  ' "$root/.bazelrc" "${home:+$home/.bazelrc}" "$sysrc" 2> /dev/null) || found=
  if [ -z "$rc" ] && [ -n "$cache" ] && [ "${found:-}" != cache ]; then
    dc="--disk_cache=$cache/dx/disk-cache"
    [ "$os" != windows ] || dc="--disk_cache=$(cygpath -w "$cache/dx/disk-cache")"
    # Keep in sync with DISK_CACHE_GC_MAX_SIZE and DISK_CACHE_GC_MAX_AGE in cli/process/src/rc.rs.
    [ "${found:-}" = gc ] || gc="--experimental_disk_cache_gc_max_size=20G --experimental_disk_cache_gc_max_age=14d"
  fi
  echo "dx: building //:dx" >&2
  built=
  hint=
  if retry_crash build_dx; then
    built=1
  elif wants_cargo_repin "$@"; then
    echo "dx: //:dx does not build; repinning the Cargo lock (CARGO_BAZEL_REPIN=1) and building it again" >&2
    # Keep in sync with the SetId::Cargo plan env in cli/update/src/backend.rs.
    if (cd "$root" && CARGO_BAZEL_REPIN=1 bazel $rc build ${dc:+"$dc"} $gc --curses=no --show_progress_rate_limit=30 --progress_report_interval=30 --show_result=0 --ui_event_filters=-info //:dx >&2); then
      built=1
    fi
  else
    hint=1
  fi
  if [ -z "$built" ]; then
    [ -z "$hint" ] || echo "dx: if a Cargo.toml dependency changed, run tools/dx update --apply cargo to repin" >&2
    if [ -x "$state/dx$exe" ]; then
      rm -f "$state/built.$$"
      echo "dx: //:dx does not build; running the previous dx" >&2
      exec "$state/dx$exe" "$@"
    fi
    die "bazel build //:dx failed"
  fi
  keep_copy
  if q=$(retry_crash query_inputs); then
    printf '%s\n' "$q" | tr -d '\r' | grep '^//' > "$state/inputs.$$" || true
    mv "$state/inputs.$$" "$state/inputs"
    mv "$state/built.$$" "$state/built"
  else
    # The fresh dx is already stored. Leave built alone so the next call rebuilds and queries again.
    echo "dx: bazel query for the inputs of //cli/cli:dx failed; running the fresh dx anyway" >&2
    rm -f "$state/built.$$" "$state/inputs.$$"
  fi
elif [ ! -x "$state/dx$exe" ] && [ -x "$bin" ]; then
  trap 'rm -f "$state/dx$exe.$$"' EXIT
  keep_copy
fi
exec "$bin" "$@"
