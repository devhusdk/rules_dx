#!/bin/sh
set -eu
die() {
  echo "dx: $1" >&2
  exit 1
}
is_ci() {
  case "${CI:-}" in
  [Tt][Rr][Uu][Ee] | 1 | [Yy][Ee][Ss]) return 0 ;;
  esac
  return 1
}
case $0 in
*/*) self_dir=${0%/*} ;;
*) self_dir=. ;;
esac
root=$(CDPATH='' cd -- "${self_dir:-/}/.." && pwd)
os=
exe=
case "$(uname -s)" in
Linux) os=linux ;;
Darwin) os=macos ;;
MINGW* | MSYS* | CYGWIN*)
  os=windows
  exe=.exe
  MSYS2_ARG_CONV_EXCL='*'
  export MSYS2_ARG_CONV_EXCL
  ;;
esac
# Says whether $1 is rooted, so it does not move with the current directory.
rooted() {
  case $1 in
  /*) return 0 ;;
  esac
  [ "$os" = windows ] || return 1
  case $1 in
  \\* | [A-Za-z]:/* | [A-Za-z]:\\*) return 0 ;;
  esac
  return 1
}
# Prints the user cache dir. The XDG spec says to skip a relative XDG_CACHE_HOME; it would give each cwd its own cache.
user_cache() {
  if [ -n "${XDG_CACHE_HOME:-}" ] && rooted "$XDG_CACHE_HOME"; then
    printf '%s\n' "$XDG_CACHE_HOME"
  elif [ -n "${HOME:-}" ]; then
    printf '%s\n' "$HOME/.cache"
  fi
}
if [ "$os" = linux ] && [ -z "${MALLOC_ARENA_MAX+x}" ]; then
  case ${GLIBC_TUNABLES:-} in
  *glibc.malloc.arena_max*) ;;
  *) MALLOC_ARENA_MAX=2 && export MALLOC_ARENA_MAX ;;
  esac
fi
source_checkout() {
  [ -f "$1/cli/cli/BUILD.bazel" ] && [ -f "$1/MODULE.bazel" ] || return 1
  while IFS= read -r sc_line || [ -n "$sc_line" ]; do
    case $sc_line in
    '    name = "rules_dx",'*) return 0 ;;
    esac
  done <"$1/MODULE.bazel" 2>/dev/null
  return 1
}
execroot_marker() {
  _p=${1%/*}
  [ "${_p##*/}" = execroot ] && [ -f "$_p/DO_NOT_BUILD_HERE" ]
}
bin="$root/bazel-bin/cli/cli/dx$exe"
state="$root/.dx/local/launcher"
if [ "${1:-}" = worktree ] && [ "${2:-}" = hook ]; then
  [ -x "$state/dx$exe" ] && exec "$state/dx$exe" "$@"
  [ -x "$bin" ] && exec "$bin" "$@"
  # No dx is built yet, as in a fresh clone. Agents run guard and stop on every tool call, and their hook timeout
  # would kill the first dx build again and again, so they pass. Without a dx no slot is leased; guard still holds
  # back a deploy with --apply.
  case ${3:-} in
  guard)
    hk_in=
    while IFS= read -r hk_line || [ -n "$hk_line" ]; do hk_in="$hk_in $hk_line"; done
    case $hk_in in
    *deploy*)
      case $hk_in in
      *--apply*)
        echo "dx: dx is not built yet; run tools/dx --version, then run the deploy again" >&2
        exit 2
        ;;
      esac
      ;;
    esac
    exit 0
    ;;
  stop) exit 0 ;;
  esac
fi
here=$(pwd -P) || here=/
while [ "$here" != / ]; do
  if source_checkout "$here"; then
    execroot_marker "$here" || break
    # Inside a Bazel execroot (reached through bazel-bin): follow Bazel's own
    # marker back to the real checkout, once.
    v=
    IFS= read -r v <"${here%/*}/DO_NOT_BUILD_HERE" || true
    v=${v%"$(printf '\r')"}
    if [ -n "$v" ]; then v=$(CDPATH='' cd -P -- "$v" 2>/dev/null && pwd -P) || v=; fi
    if [ -n "$v" ] && source_checkout "$v" && ! execroot_marker "$v"; then
      here=$v
      break
    fi
    # An execroot can sit inside another one (a test's temp dir, say); never climb into the outer one's checkout.
    here=/
    break
  fi
  here=${here%/*}
  here=${here:-/}
done
if [ "$here" != / ] && [ "$here" != "$(cd -P -- "$root" && pwd -P)" ] && [ -x "$here/tools/dx" ]; then
  exec "$here/tools/dx" "$@"
fi
# Without bazel on PATH, Linux uses the Bazelisk pinned in tools/bazelisk/pin.env, kept under the user cache, as
# bazel. dx runs bazel from PATH, so its directory goes on PATH for dx too. Sets bz_dir; fails when there is no pin.
bazelisk_pin() {
  case $os/$(uname -m) in
  linux/x86_64) bz_arch=linux-amd64 bz_key=BAZELISK_SHA256_LINUX_AMD64 ;;
  linux/aarch64 | linux/arm64) bz_arch=linux-arm64 bz_key=BAZELISK_SHA256_LINUX_ARM64 ;;
  *) return 1 ;;
  esac
  bz_v=
  bz_sum=
  [ -r "$root/tools/bazelisk/pin.env" ] || return 1
  while IFS='=' read -r bz_k bz_val || [ -n "$bz_k" ]; do
    case $bz_k in
    BAZELISK_VERSION) bz_v=$bz_val ;;
    "$bz_key") bz_sum=$bz_val ;;
    esac
  done <"$root/tools/bazelisk/pin.env"
  bz_cache=$(user_cache)
  [ -n "$bz_v" ] && [ -n "$bz_sum" ] && [ -n "$bz_cache" ] || return 1
  bz_dir=$bz_cache/dx/bazelisk/$bz_v
}
# Downloads $1 to the file $3 through a temp file and keeps it, executable, only when its sha256 is $2. $4 names it
# and $5 holds its pin in messages. Returns 2 when curl or wget cannot fetch it.
fetch_pinned() {
  fp_tmp=$3.$$
  mkdir -p "${3%/*}" || return 1
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --proto '=https' --tlsv1.2 --retry 3 -o "$fp_tmp" "$1" || {
      rm -f "$fp_tmp"
      return 2
    }
  elif command -v wget >/dev/null 2>&1; then
    wget -q --https-only -O "$fp_tmp" "$1" || {
      rm -f "$fp_tmp"
      return 2
    }
  else
    echo "dx: neither curl nor wget is on PATH" >&2
    return 1
  fi
  fp_got=$(sha256sum "$fp_tmp") || fp_got=
  if [ "${fp_got%% *}" != "$2" ]; then
    rm -f "$fp_tmp"
    echo "dx: the $4 download does not match its sha256 in $5" >&2
    return 1
  fi
  chmod +x "$fp_tmp" && mv -f "$fp_tmp" "$3" || {
    rm -f "$fp_tmp"
    return 1
  }
}
download_bazelisk() {
  bz_url=https://github.com/bazelbuild/bazelisk/releases/download/v$bz_v/bazelisk-$bz_arch
  echo "dx: bazel is not on PATH; fetching Bazelisk $bz_v to $bz_dir" >&2
  fetch_pinned "$bz_url" "$bz_sum" "$bz_dir/bazel" Bazelisk tools/bazelisk/pin.env || {
    [ $? -ne 2 ] || die "cannot download Bazelisk from github.com; allow it in the network settings or put bazel on PATH"
    return 1
  }
}
if ! command -v bazel >/dev/null 2>&1 && bazelisk_pin; then
  if [ -x "$bz_dir/bazel" ] || download_bazelisk; then
    PATH=$bz_dir:$PATH
    case $bz_arch in linux-amd64) bz_bazel_arch=linux-x86_64 ;; *) bz_bazel_arch=$bz_arch ;; esac
    # Some container proxies block releases.bazel.build; GitHub serves the same Bazel releases.
    BAZELISK_BASE_URL=${BAZELISK_BASE_URL:-https://github.com/bazelbuild/bazel/releases/download}
    export PATH BAZELISK_BASE_URL
  fi
fi
# A release checkout pins the released dx in cli/prebuilt/pins.bzl. Linux runs that dx instead of building one when
# the checkout is that release: a git checkout at tag v<DX_VERSION> with no tracked edits, or a release archive.
# Sets pb_v, pb_url, pb_sum and pb_bin; fails when the checkout does not match.
prebuilt_pin() {
  case $os/$(uname -m) in
  linux/x86_64) pb_key=linux_x86_64 ;;
  linux/aarch64 | linux/arm64) pb_key=linux_arm64 ;;
  *) return 1 ;;
  esac
  pb_v=
  pb_url=
  pb_sum=
  pb_in=
  [ -r "$root/cli/prebuilt/pins.bzl" ] || return 1
  while IFS= read -r pb_line || [ -n "$pb_line" ]; do
    pb_line=${pb_line%"$(printf '\r')"}
    case $pb_line in
    'DX_VERSION = "'*'"') pb_v=${pb_line#*\"} pb_v=${pb_v%\"} ;;
    'URL_TEMPLATE = "'*'"') pb_url=${pb_line#*\"} pb_url=${pb_url%\"} ;;
    '    "dx": {') pb_in=1 ;;
    '    }'*) pb_in= ;;
    "        \"$pb_key\": \""*'",') [ -z "$pb_in" ] || pb_sum=${pb_line#*: \"} pb_sum=${pb_sum%\",} ;;
    esac
  done <"$root/cli/prebuilt/pins.bzl"
  [ -n "$pb_v" ] && [ "$pb_v" != 0.0.0 ] && [ -n "$pb_url" ] && [ -n "$pb_sum" ] || return 1
  if [ -e "$root/.git" ]; then
    command -v git >/dev/null 2>&1 || return 1
    pb_head=$(git -C "$root" rev-parse -q --verify HEAD 2>/dev/null) || return 1
    pb_tag=$(git -C "$root" rev-parse -q --verify "refs/tags/v$pb_v^{commit}" 2>/dev/null) || return 1
    [ "$pb_head" = "$pb_tag" ] || return 1
    git -C "$root" diff --quiet HEAD -- 2>/dev/null || return 1
  fi
  pb_cache=$(user_cache)
  [ -n "$pb_cache" ] || return 1
  pb_bin=$pb_cache/dx/prebuilt/$pb_sum/dx
  pb_url=${pb_url%%"{version}"*}$pb_v${pb_url#*"{version}"}
  pb_url=${pb_url%%"{asset}"*}dx-${pb_key%%_*}-${pb_key#*_}${pb_url#*"{asset}"}
}
if prebuilt_pin; then
  if [ -x "$pb_bin" ] || {
    echo "dx: fetching the released dx $pb_v to ${pb_bin%/*}" >&2
    fetch_pinned "$pb_url" "$pb_sum" "$pb_bin" "released dx" cli/prebuilt/pins.bzl
  }; then
    exec "$pb_bin" "$@"
  fi
  echo "dx: cannot fetch the released dx $pb_v; building //cli/cli:dx instead" >&2
fi
# False only when curl or wget runs and cannot fetch $1. Redirects are followed: GitHub serves release files from
# another host.
reachable() {
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --max-time 10 -o /dev/null "$1" 2>/dev/null
  elif command -v wget >/dev/null 2>&1; then
    wget -q -T 10 -O /dev/null "$1"
  fi
}
# False only when the launcher put Bazelisk on PATH and the pinned Bazel's checksum cannot be fetched from
# BAZELISK_BASE_URL. Sets bz_base_host.
bazel_reachable() {
  [ -n "${bz_bazel_arch:-}" ] || return 0
  bz_ver=${USE_BAZEL_VERSION:-}
  if [ -z "$bz_ver" ] && [ -r "$root/.bazelversion" ]; then IFS= read -r bz_ver <"$root/.bazelversion" || :; fi
  bz_ver=${bz_ver%"$(printf '\r')"}
  [ -n "$bz_ver" ] || return 0
  bz_base_host=${BAZELISK_BASE_URL#*://}
  bz_base_host=${bz_base_host%%/*}
  reachable "$BAZELISK_BASE_URL/$bz_ver/bazel-$bz_ver-$bz_bazel_arch.sha256"
}
# True when an input of the last built dx is newer than that build. With arguments, only inputs under those path
# prefixes count.
input_newer() {
  while IFS= read -r st_p || [ -n "$st_p" ]; do
    st_p=${st_p#//}
    st_p=${st_p#:}
    case $st_p in
    *:*) st_p=${st_p%%:*}/${st_p#*:} ;;
    esac
    [ -n "$st_p" ] || continue
    if [ $# -gt 0 ]; then
      st_m=
      for st_x in "$@"; do
        case $st_p in "$st_x"*) st_m=1 ;; esac
      done
      [ -n "$st_m" ] || continue
    fi
    [ "$root/$st_p" -nt "$state/built" ] && return 0
  done <"$state/inputs"
  return 1
}
# Worktree add and release must stay fast and must not wait on Bazel: run the last built dx without a stale check,
# unless a worktree source is newer than that dx. Keep this list and the prefixes in sync with tools/dx.cmd.
if [ "${1:-}" = worktree ]; then
  case "${2:-}" in
  add | release)
    if [ -s "$state/inputs" ] && [ -f "$state/built" ] && input_newer cli/worktree/ cli/process/; then
      echo "dx: worktree sources are newer than the built dx; rebuilding" >&2
    else
      [ -x "$state/dx$exe" ] && exec "$state/dx$exe" "$@"
      [ -x "$bin" ] && exec "$bin" "$@"
    fi
    ;;
  esac
fi
# Sets rc_u to $1 without one pair of matching outer quotes.
rc_unq() {
  rc_u=$1
  case $1 in
  \"*\" | \'*\') rc_u=${1#?} rc_u=${rc_u%?} ;;
  esac
}
# Scans one bazelrc file and the files it imports. Prints cache and returns 0 when a disk cache option is set; prints gc
# when only a disk cache gc option is set. Always run it in a command substitution: it sets -f and its variables are
# not restored.
rc_scan() {
  set -f
  rs_file=$1
  rs_depth=$2
  if [ -z "$rs_file" ] || [ "$rs_depth" -gt 16 ]; then return 1; fi
  case "$rc_seen" in
  *"
$rs_file
"*) return 1 ;;
  esac
  rc_seen="$rc_seen$rs_file
"
  [ -r "$rs_file" ] || return 1
  rs_cr=$(printf '\r')
  rs_ws=" 	$rs_cr"
  rs_tok='%workspace%'
  rs_gc=
  while IFS= read -r rs_line || [ -n "$rs_line" ]; do
    case $rs_line in
    *[!$rs_ws]*) ;;
    *) continue ;;
    esac
    rs_line=${rs_line#"${rs_line%%[!$rs_ws]*}"}
    rs_line=${rs_line%"${rs_line##*[!$rs_ws]}"}
    case $rs_line in
    '#'*) continue ;;
    esac
    rs_first=${rs_line%%[$rs_ws]*}
    rs_rest=${rs_line#"$rs_first"}
    rs_rest=${rs_rest#"${rs_rest%%[!$rs_ws]*}"}
    rc_unq "$rs_first"
    case $rc_u in
    import | try-import)
      rc_unq "$rs_rest"
      rs_t=$rc_u
      rs_r=
      while :; do
        case $rs_t in
        *"$rs_tok"*) rs_r=$rs_r${rs_t%%"$rs_tok"*}$root rs_t=${rs_t#*"$rs_tok"} ;;
        *) break ;;
        esac
      done
      rs_t=$rs_r$rs_t
      case $rs_t in
      /* | [A-Za-z]:*) ;;
      *) rs_t=$root/$rs_t ;;
      esac
      rs_sub=$(rc_scan "$rs_t" "$((rs_depth + 1))") || true
      case $rs_sub in
      *cache*)
        echo cache
        return 0
        ;;
      *gc*) rs_gc=1 ;;
      esac
      continue
      ;;
    esac
    for rs_w in $rs_line; do
      rc_unq "$rs_w"
      rs_t=$rc_u
      while :; do
        case $rs_t in
        \"* | \'*) rs_t=${rs_t#?} ;;
        *) break ;;
        esac
      done
      case $rs_t in
      --disk_cache* | --nodisk_cache*)
        echo cache
        return 0
        ;;
      --experimental_disk_cache_gc_max_size | --experimental_disk_cache_gc_max_size=* | --experimental_disk_cache_gc_max_age | --experimental_disk_cache_gc_max_age=*) rs_gc=1 ;;
      esac
    done
  done <"$rs_file"
  [ -z "$rs_gc" ] || echo gc
  return 1
}
rc_scan_all() {
  rc_seen='
'
  rsa_gc=
  for rsa_f in "$@"; do
    rsa_o=$(rc_scan "$rsa_f" 0) || true
    case $rsa_o in
    *cache*)
      echo cache
      return 0
      ;;
    *gc*) rsa_gc=1 ;;
    esac
  done
  if [ -n "$rsa_gc" ]; then echo gc; else echo none; fi
}
tag_state() {
  { printf '%s\n%s\n' 'Signature: 8a477f597d28d172789f06886806bc55' '# Rebuildable copy of dx kept by tools/dx; see https://bford.info/cachedir/' >"$state/CACHEDIR.TAG.$$" && mv -f "$state/CACHEDIR.TAG.$$" "$state/CACHEDIR.TAG"; } 2>/dev/null || rm -f "$state/CACHEDIR.TAG.$$"
}
stale() {
  [ -x "$bin" ] && [ -s "$state/inputs" ] && [ -f "$state/built" ] || return 0
  input_newer && return 0
  for st_p in .bazelrc .bazelversion user.bazelrc .dx/bazelrc/correctness.bazelrc .dx/bazelrc/performance.bazelrc .dx/bazelrc/resources.bazelrc MODULE.bazel MODULE.bazel.lock cargo-bazel-lock.json; do
    [ "$root/$st_p" -nt "$state/built" ] && return 0
  done
  return 1
}
# Keep in sync with DX_SYNC in tools/dx.cmd: a copy is current when size and mtime match bin's, and cp -p keeps the
# mtime, so a copy made by either launcher counts for the other. The copy is never written in place; on Windows the
# running copy is renamed aside first because a running exe cannot be replaced.
copy_current() {
  [ -f "$state/dx$exe" ] && [ -f "$bin" ] && [ "$(wc -c <"$state/dx$exe")" = "$(wc -c <"$bin")" ] &&
    ! [ "$state/dx$exe" -nt "$bin" ] && ! [ "$state/dx$exe" -ot "$bin" ]
}
# A run killed before its trap ran leaves its pid's temp files behind. A pid that still answers kill -0 belongs to a live run.
sweep_temps() {
  for t in "$state/dx$exe".[0-9]* "$state/built".[0-9]* "$state/inputs".[0-9]* "$state/query".[0-9]* "$state/deps".[0-9]*; do
    [ -e "$t" ] || continue
    kill -0 "${t##*.}" 2>/dev/null || rm -f "$t"
  done
}
sync_copy() {
  sweep_temps
  rm -f "$state/dx$exe".old.* 2>/dev/null || true
  if ! copy_current; then
    [ -f "$bin" ] || return 1
    if cp -p "$bin" "$state/dx$exe.$$" 2>/dev/null && ! copy_current; then
      if [ "$os" = windows ] && [ -e "$state/dx$exe" ]; then
        mv "$state/dx$exe" "$state/dx$exe.old.$$" 2>/dev/null || true
      fi
      mv -f "$state/dx$exe.$$" "$state/dx$exe" 2>/dev/null || true
    fi
    rm -f "$state/dx$exe.$$" 2>/dev/null || true
    rm -f "$state/dx$exe".old.* 2>/dev/null || true
    tag_state
  fi
  copy_current
}
# Bazel exits 33 (out of memory) or 37 (internal error) when its server crashes. A build or an inputs lookup is safe
# to run again, so try once more after a short wait. Keep the codes and wait in sync with RESTART_EXIT and
# backoff in cli/exec_core/src/bazel_restart.rs, and with tools/dx.cmd.
retry_crash() {
  "$@" && return 0 || ec=$?
  case $ec in 33 | 37) ;; *) return "$ec" ;; esac
  echo "dx: the Bazel server crashed (exit $ec); trying //cli/cli:dx again" >&2
  sleep "${DX_RESTART_WAIT:-2}"
  "$@" && return 0 || return $?
}
# DX_LAUNCHER_BAZEL_FLAGS changes how dx is built, not what is built, so changing it never makes dx stale. Its flags
# come after the launcher's own, so they override them; set -f keeps them from globbing.
build_dx() {
  # shellcheck disable=SC2086 # rc, gc and DX_LAUNCHER_BAZEL_FLAGS are option lists that must split
  (set -f && cd "$root" && bazel $rc build ${dc:+"$dc"} $gc --curses=no --show_progress_rate_limit=30 --progress_report_interval=30 --show_result=0 --ui_event_filters=-info ${DX_LAUNCHER_BAZEL_FLAGS-} //cli/cli:dx >&2)
}
# A plain query follows every select() branch and fetches repos only other platforms use, like the MinGW runtime.
# cquery keeps to the main repo targets this host builds; the query adds their BUILD and .bzl files. Its only warning
# is that a listed //pkg:all target shadows the wildcard.
query_inputs() {
  # shellcheck disable=SC2086,SC2016 # rc is an option list that must split; $s is a query variable, not shell
  # Each attempt truncates the files, so a retry never keeps a crashed attempt's partial output.
  (set -f && cd "$root" && echo 'let s = set(//cli/cli:dx' >"$state/deps.$$" &&
    bazel $rc cquery --noshow_progress --ui_event_filters=-info ${DX_LAUNCHER_BAZEL_FLAGS-} --output=starlark "--starlark:expr=repr('//' + target.label.package + ':' + target.label.name) if target.label.repo_name == '' else ''" 'deps(//cli/cli:dx)' >>"$state/deps.$$" &&
    echo ') in kind("source file", $s) + buildfiles($s)' >>"$state/deps.$$" &&
    bazel $rc query --noshow_progress --ui_event_filters=-info,-warning ${DX_LAUNCHER_BAZEL_FLAGS-} --query_file="${state#"$root"/}/deps.$$" >"$state/query.$$")
}
# True for `update --apply [dx_crates]` without --frozen or --offline: the only launches that may repin.
wants_cargo_repin() {
  [ "${1:-}" = update ] || return 1
  shift
  w_apply=
  w_sel=0
  for w_arg in "$@"; do
    case $w_arg in
    --apply) w_apply=1 ;;
    --frozen | --offline) return 1 ;;
    -*) ;;
    dx_crates) w_sel=$((w_sel + 1)) ;;
    *) return 1 ;;
    esac
  done
  [ -n "$w_apply" ] && [ "$w_sel" -le 1 ]
}
cleanup() {
  rm -f "$state/built.$$" "$state/inputs.$$" "$state/query.$$" "$state/deps.$$" "$state/dx$exe.$$"
}
on_signal() {
  cleanup
  trap - EXIT INT TERM HUP
  kill -s "$1" "$$"
  case $1 in INT) exit 130 ;; TERM) exit 143 ;; *) exit 129 ;; esac
}
guard_temps() {
  trap cleanup EXIT
  trap 'on_signal INT' INT
  trap 'on_signal TERM' TERM
  trap 'on_signal HUP' HUP
}
if stale; then
  command -v bazel >/dev/null 2>&1 || die "bazel is not on PATH"
  mkdir -p "$state"
  tag_state
  guard_temps
  : >"$state/built.$$"
  rc="--nohome_rc --nosystem_rc"
  [ -n "${BAZEL_TEST:-}" ] || rc=
  dc=
  gc=
  found=
  cache=$(user_cache)
  cache=${cache:-${LOCALAPPDATA:-}}
  home=${HOME:-${USERPROFILE:-}}
  sysrc=/etc/bazel.bazelrc
  [ "$os" != windows ] || sysrc=${ProgramData:+$ProgramData/bazel.bazelrc}
  [ -n "$rc" ] || [ -z "$cache" ] || found=$(rc_scan_all "$root/.bazelrc" "${home:+$home/.bazelrc}" "$sysrc" 2>/dev/null) || found=
  if [ -z "$rc" ] && ! is_ci && [ -n "$cache" ] && [ "${found:-}" != cache ]; then
    dc="--disk_cache=$cache/dx/disk-cache"
    [ "$os" != windows ] || dc="--disk_cache=$(cygpath -w "$cache/dx/disk-cache")"
    # Keep in sync with DISK_CACHE_GC_MAX_SIZE and DISK_CACHE_GC_MAX_AGE in cli/process/src/rc.rs.
    [ "${found:-}" = gc ] || gc="--experimental_disk_cache_gc_max_size=20G --experimental_disk_cache_gc_max_age=14d"
  fi
  echo "dx: building //cli/cli:dx" >&2
  built=
  hint=
  if retry_crash build_dx; then
    built=1
  elif wants_cargo_repin "$@"; then
    echo "dx: //cli/cli:dx does not build; repinning the Cargo lock (CARGO_BAZEL_REPIN=1) and building it again" >&2
    # Keep in sync with the SetId::Cargo plan env in cli/update/src/backend.rs.
    # shellcheck disable=SC2086 # rc, gc and DX_LAUNCHER_BAZEL_FLAGS are option lists that must split
    if (set -f && cd "$root" && CARGO_BAZEL_REPIN=1 bazel $rc build ${dc:+"$dc"} $gc --curses=no --show_progress_rate_limit=30 --progress_report_interval=30 --show_result=0 --ui_event_filters=-info ${DX_LAUNCHER_BAZEL_FLAGS-} //cli/cli:dx >&2); then
      built=1
    fi
  else
    hint=1
  fi
  if [ -z "$built" ]; then
    [ -z "$hint" ] || echo "dx: if a Cargo.toml dependency changed, run tools/dx update --apply dx_crates to repin" >&2
    if [ -x "$state/dx$exe" ]; then
      rm -f "$state/built.$$"
      echo "dx: //cli/cli:dx does not build; running the previous dx" >&2
      exec "$state/dx$exe" "$@"
    fi
    # A proxy that blocks Bazel's download or the module registry fails the first build; name the host, not only
    # the fetch error.
    bazel_reachable ||
      die "cannot download Bazel from $bz_base_host for Bazelisk; allow it in the network settings or set BAZELISK_BASE_URL"
    reachable https://bcr.bazel.build/bazel_registry.json ||
      die "cannot reach bcr.bazel.build, the Bazel module registry; allow it in the network settings"
    die "bazel build //cli/cli:dx failed"
  fi
  sync_copy || true
  if retry_crash query_inputs; then
    : >"$state/inputs.$$"
    while IFS= read -r q_line || [ -n "$q_line" ]; do
      q_line=${q_line%"$(printf '\r')"}
      case $q_line in
      //*) printf '%s\n' "$q_line" >>"$state/inputs.$$" ;;
      esac
    done <"$state/query.$$"
    rm -f "$state/query.$$" "$state/deps.$$"
    mv "$state/inputs.$$" "$state/inputs"
    mv "$state/built.$$" "$state/built"
  else
    # The fresh dx is already stored. Leave built alone so the next call rebuilds and queries again.
    echo "dx: bazel query for the inputs of //cli/cli:dx failed; running the fresh dx anyway" >&2
    rm -f "$state/built.$$" "$state/inputs.$$" "$state/query.$$" "$state/deps.$$"
  fi
fi
if [ -x "$bin" ]; then
  guard_temps
  # Run the copy so a running dx never locks bazel-bin. Any failure falls back to bin.
  if sync_copy && [ -x "$state/dx$exe" ]; then bin="$state/dx$exe"; fi
fi
exec "$bin" "$@"
