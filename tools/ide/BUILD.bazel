load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")

package(default_visibility = VIS_TOOLS)

exports_files(
    [
        "ide_acquisition.bzl",
        "ide_tool.bzl",
    ],
    visibility = VIS_TOOLS,
)

exports_files(
    ["ide_acquisition_test.rs"],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "lsp_headless_clangd_test",
    srcs = ["lsp_headless_clangd_test.rs"],
    data = [
        "@llvm//tools:clang",
        "@llvm//tools:clangd",
    ],
    env = {
        "DX_LSP_CLANG": "$(rootpath @llvm//tools:clang)",
        "DX_LSP_CLANGD": "$(rootpath @llvm//tools:clangd)",
    },
    tags = ["no-remote-exec"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        "//cc/context:cc_context",
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing:dx_lsp",
        "//tools/testing:dx_testing",
        "@crates//:serde_json",
    ],
)

# size: medium, rust-analyzer startup, measured 60s linux_x86_64 2026-11-04
rust_test(
    name = "lsp_headless_rust_analyzer_test",
    size = "medium",
    srcs = ["lsp_headless_rust_analyzer_test.rs"],
    data = ["@rules_rust//rust/toolchain:current_rust_analyzer_toolchain"],
    env = {
        "DX_LSP_TOOLCHAIN_FILES": "$(rootpaths @rules_rust//rust/toolchain:current_rust_analyzer_toolchain)",
    },
    tags = ["no-remote-exec"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing:dx_lsp",
        "//tools/testing:dx_testing",
        "@crates//:serde_json",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "ide_acquisition.bzl",
        "ide_tool.bzl",
    ],
    tags = ["corpus"],
)
