load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_test", "rustfmt_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS")

package(default_visibility = VIS_TOOLS)

exports_files([
    "ide_acquisition.bzl",
    "ide_acquisition_test.rs",
    "ide_tool.bzl",
], visibility = VIS_TOOLS)

# keep
rust_test(
    name = "lsp_headless_test",
    size = "medium",
    timeout = "long",
    srcs = ["lsp_headless_test.rs"],
    data = [
        "@llvm//tools:clang",
        "@llvm//tools:clangd",
        "@rules_rust//rust/toolchain:current_rust_analyzer_toolchain",
    ],
    env = {
        "DX_LSP_CLANG": "$(rootpath @llvm//tools:clang)",
        "DX_LSP_CLANGD": "$(rootpath @llvm//tools:clangd)",
        "DX_LSP_TOOLCHAIN_FILES": "$(rootpaths @rules_rust//rust/toolchain:current_rust_analyzer_toolchain)",
    },
    tags = ["no-remote-exec"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        "//cc/context:cc_context",
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing:dx_testing",
        "@crates//:serde_json",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "ide_acquisition.bzl",
        "ide_tool.bzl",
    ],
    tags = ["corpus"],
)

rustfmt_test(
    name = "ide_linux_x86_64_fmt_test",
    size = "small",
    targets = [
        ":lsp_headless_test",
    ],
)
