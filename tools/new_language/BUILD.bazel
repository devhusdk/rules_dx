load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS_PUBLIC)

rust_binary(
    name = "new_language",
    srcs = ["src/main.rs"],
    crate_name = "new_language",
    crate_root = "src/main.rs",
)

rust_test(
    name = "new_language_test",
    crate = ":new_language",
    deps = ["//cli/test_scratch:dx_test_scratch"],
)

exports_files(
    [
        "src/main.rs",
    ],
    visibility = ["//core/quality:__pkg__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
