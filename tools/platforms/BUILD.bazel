load("//core/quality:fixtures.bzl", "real_source_target")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS_PUBLIC")
load(":defs.bzl", "WINDOWS_MSVC_HOST_CONSTRAINTS")

package(default_visibility = VIS_TOOLS_PUBLIC)

platform(
    name = "windows_msvc_host",
    constraint_values = WINDOWS_MSVC_HOST_CONSTRAINTS,
    parents = ["@platforms//host"],
    required_settings = ["@llvm//toolchain:runtimes_all"],
)

platform(
    name = "host",
    parents = ["@platforms//host"],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "linux_arm64_musl",
    constraint_values = [
        "@llvm//constraints/libc:musl",
        "@llvm//constraints/pie:off",
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "linux_x86_64_musl",
    constraint_values = [
        "@llvm//constraints/libc:musl",
        "@llvm//constraints/pie:off",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
)

platform(
    name = "windows_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:windows",
    ] + WINDOWS_MSVC_HOST_CONSTRAINTS,
)

platform(
    name = "windows_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ] + WINDOWS_MSVC_HOST_CONSTRAINTS,
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
