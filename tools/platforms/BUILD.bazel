load("//quality:fixtures.bzl", "real_source_target")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS_PUBLIC")

package(default_visibility = VIS_TOOLS_PUBLIC)

platform(
    name = "windows_msvc_host",
    constraint_values = ["@llvm//constraints/windows/abi:msvc"],
    parents = ["@platforms//host"],
    required_settings = ["@llvm//toolchain:runtimes_all"],
)

toolchain(
    name = "protoc_windows_arm64",
    exec_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:arm64",
    ],
    toolchain = "@prebuilt_protoc.win64//:prebuilt_protoc_toolchain",
    toolchain_type = "@protobuf//bazel/private:proto_toolchain_type",
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
