# Loaded as an external repo via --override_repository, where @rules_dx is not visible:
# it must stay load-free, so Gazelle (gazelle:exclude in the root BUILD) never touches it.
# Stands in for @local_config_winsdk on Windows, so Bazel never probes for an installed SDK.
exports_files([
    "BUILD.bazel",
    "REPO.bazel",
    "toolchains.bzl",
])
