load("@crates//:crates.bzl", "aliases")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_test", "rustfmt_test")
load("//tools/visibility:visibility.bzl", "VIS_PUBLIC")

package(default_visibility = VIS_PUBLIC)

exports_files([
    "Cargo.toml",
    "src/main.rs",
])

rust_binary(
    name = "repin_all",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "tools/repin_all",
        normal = True,
    ),
    crate_name = "repin_all",
    crate_root = "src/main.rs",
    edition = "2021",
    deps = [
        "//cli/plan:dx_plan",
        "//cli/process:dx_process",
    ],
)

rust_test(
    name = "workspace_cwd_test",
    size = "small",
    srcs = ["tests/workspace_cwd_test.rs"],
    aliases = aliases(
        package_name = "tools/repin_all",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "workspace_cwd_test",
    crate_root = "tests/workspace_cwd_test.rs",
    data = [":repin_all"],
    edition = "2021",
    env = {
        "DX_REPIN_ALL": "$(rootpath :repin_all)",
    },
    deps = [
        "//cli/plan:dx_plan",
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing:dx_testing",
    ],
)

rustfmt_test(
    name = "repin_all_fmt_test",
    size = "small",
    targets = [
        ":repin_all",
        ":workspace_cwd_test",
    ],
)

rust_clippy_test(
    name = "repin_all_clippy_test",
    size = "small",
    targets = [
        ":repin_all",
        ":workspace_cwd_test",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
