load("@crates//:crates.bzl", "aliases", "crate_deps")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rustfmt_test")
load("//tools/visibility:visibility.bzl", "VIS_PUBLIC")

package(default_visibility = VIS_PUBLIC)

exports_files([
    "Cargo.toml",
    "src/main.rs",
])

rust_binary(
    name = "repin_all",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "tools/repin_all",
        normal = True,
    ),
    crate_name = "repin_all",
    crate_root = "src/main.rs",
    edition = "2021",
    deps = crate_deps(
        [],
        package_name = "tools/repin_all",
    ),
)

rustfmt_test(
    name = "repin_all_fmt_test",
    size = "small",
    targets = [":repin_all"],
)

rust_clippy_test(
    name = "repin_all_clippy_test",
    size = "small",
    targets = [":repin_all"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
