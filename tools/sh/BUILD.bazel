load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@rules_shell//shell:sh_library.bzl", "sh_library")
load("//quality:fixtures.bzl", "real_source_target")
load(":harness.bzl", "dx_shell_harness")
load(":harness_tests.bzl", "harness_unit_tests")

package(default_visibility = ["//:__subpackages__"])

exports_files([
    "harness.bzl",
    "harness_tests.bzl",
])

harness_unit_tests(name = "harness_unit")

sh_library(
    name = "bootstrap",
    srcs = ["bootstrap.sh"],
    target_compatible_with = ["@platforms//os:linux"],
)

sh_library(
    name = "lib",
    srcs = ["lib.sh"],
    data = ["hermetic_grep.py"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [":bootstrap"],
)

sh_library(
    name = "snapshot",
    srcs = ["snapshot.sh"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [":bootstrap"],
)

sh_library(
    name = "guards",
    srcs = ["guards.sh"],
    data = ["hermetic_grep.py"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":bootstrap",
        ":lib",
    ],
)

sh_library(
    name = "assert",
    srcs = ["assert.sh"],
    data = ["hermetic_grep.py"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":bootstrap",
        ":lib",
    ],
)

py_library(
    name = "hermetic_grep_lib",
    srcs = ["hermetic_grep.py"],
    imports = ["."],
)

py_binary(
    name = "hermetic_grep",
    srcs = ["hermetic_grep.py"],
    main = "hermetic_grep.py",
)

py_test(
    name = "hermetic_grep_test",
    srcs = ["hermetic_grep_test.py"],
    deps = [":hermetic_grep_lib"],
)

dx_shell_harness(
    name = "assert_test",
    srcs = ["assert_test.sh"],
    data = [":assert"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "harness.bzl",
        "harness_tests.bzl",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_python",
    aspect_hints = ["//:ruff_config"],
    python_srcs = [
        "hermetic_grep.py",
        "hermetic_grep_test.py",
    ],
    tags = ["corpus"],
)
