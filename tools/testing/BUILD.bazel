load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/testing/hermetic:defs.bzl", "nested_bazel_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS_CLI_TEST", "VIS_TOOLS_PUBLIC")
load(":child_runfiles.bzl", "child_runfiles")
load(":nested_bazel.bzl", "CONSUMER_MAVEN_DATA", "CONSUMER_MAVEN_ENV")
load(":test.bzl", "testing_rust_test")

package(default_visibility = VIS_TOOLS_CLI_TEST)

# gazelle:resolve rust dx_nested //tools/testing/nested:dx_nested

exports_files(
    [
        "action_input.bzl",
        "child_runfiles.bzl",
        "clang_diagnostics_test.rs",
        "format_test.rs",
        "gazelle_compile_test.rs",
        "hello_output.bzl",
        "java_diagnostics_test.rs",
        "kotlin_diagnostics_test.rs",
        "nested_bazel.bzl",
        "node_diagnostics_test.rs",
        "stub_target.bzl",
        "test_macros.bzl",
        "web_hello.bzl",
        "web_hello_coverage_test.rs",
    ],
    visibility = VIS_TOOLS_PUBLIC,
)

rust_library(
    name = "dx_testing",
    testonly = True,
    srcs = [
        "src/cli.rs",
        "src/exec_log.rs",
        "src/fatbin.rs",
        "src/http.rs",
        "src/lib.rs",
    ],
    aliases = aliases(
        package_name = "tools/dx_testing",
        normal = True,
    ),
    crate_name = "dx_testing",
    crate_root = "src/lib.rs",
    visibility = VIS_TOOLS_PUBLIC + VIS_TOOLS_CLI_TEST,
    deps = all_crate_deps(
        package_name = "tools/dx_testing",
        normal = True,
    ) + [
        "//cli/binfmt:dx_binfmt",
        "//cli/path:dx_path",
        "//tools/bazelrc:dx_preset",
        "@crates//:serde_json",
        "@rules_rust//rust/runfiles",
    ],
)

rust_test(
    name = "dx_testing_test",
    aliases = aliases(
        package_name = "tools/dx_testing",
        normal = True,
        normal_dev = True,
    ),
    compile_data = [
        "exec_log_fixtures/first.log.zst",
        "exec_log_fixtures/second.log.zst",
    ],
    crate = ":dx_testing",
    data = [
        ":process_probe_child",
        "//:.bazelversion",
        "//:MODULE.bazel",
        "//tools/testing/process_probe",
    ],
    env = {
        "DX_PROCESS_PROBE": "$(rootpath //tools/testing/process_probe:process_probe)",
    },
    deps = all_crate_deps(
        package_name = "tools/dx_testing",
        normal = True,
        normal_dev = True,
    ),
)

child_runfiles(
    name = "process_probe_child",
    testonly = True,
    binary = "//tools/testing/process_probe",
)

[
    config_setting(
        name = "nested_bazel_" + os + "_" + cpu,
        constraint_values = [
            "@platforms//os:" + os,
            "@platforms//cpu:" + cpu,
        ],
    )
    for os in [
        "linux",
        "macos",
    ]
    for cpu in [
        "aarch64",
        "x86_64",
    ]
]

config_setting(
    name = "nested_bazel_windows_x86_64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

alias(
    name = "nested_bazel_bin",
    actual = select({
        ":nested_bazel_linux_aarch64": "@nested_bazel_linux_arm64//file",
        ":nested_bazel_linux_x86_64": "@nested_bazel_linux_x86_64//file",
        ":nested_bazel_macos_aarch64": "@nested_bazel_darwin_arm64//file",
        ":nested_bazel_macos_x86_64": "@nested_bazel_darwin_x86_64//file",
        ":nested_bazel_windows_x86_64": "@nested_bazel_windows_x86_64//file",
        "//conditions:default": ":nested_bazel_unpinned",
    }),
    visibility = VIS_TOOLS_PUBLIC,
)

filegroup(
    name = "nested_bazel_unpinned",
    target_compatible_with = ["@platforms//:incompatible"],
)

rust_binary(
    name = "nested_bazel_probe",
    testonly = True,
    srcs = ["nested_bazel_probe.rs"],
    aliases = aliases(
        package_name = "tools/dx_testing",
        normal = True,
    ),
    crate_name = "nested_bazel_probe",
    crate_root = "nested_bazel_probe.rs",
    deps = all_crate_deps(
        package_name = "tools/dx_testing",
        normal = True,
    ) + [
        ":dx_testing",
        "//tools/testing/nested:dx_nested",
    ],
)

rust_binary(
    name = "nested_bazel_shim",
    testonly = True,
    srcs = ["nested_bazel_shim.rs"],
    aliases = aliases(
        package_name = "tools/dx_testing",
        normal = True,
    ),
    crate_name = "nested_bazel_shim",
    crate_root = "nested_bazel_shim.rs",
    visibility = VIS_TOOLS_PUBLIC,
    deps = all_crate_deps(
        package_name = "tools/dx_testing",
        normal = True,
    ) + [
        ":dx_testing",
        "//tools/testing/nested:dx_nested",
    ],
)

testing_rust_test(
    name = "root_layout_test",
    data = ["//:module_srcs"],
    deps = [":dx_testing"],
)

testing_rust_test(
    name = "language_skeleton_test",
    size = "small",
    data = [
        "language_skeleton_allowlist.txt",
        "@dx_test_tags_sources//:files.json",
        "@dx_test_tags_sources//:paths.json",
        "@dx_test_tags_sources//:sources.json",
    ],
    env = {
        "DX_FILES_JSON": "$(rlocationpath @dx_test_tags_sources//:files.json)",
        "DX_PATHS_JSON": "$(rlocationpath @dx_test_tags_sources//:paths.json)",
        "DX_SOURCES_JSON": "$(rlocationpath @dx_test_tags_sources//:sources.json)",
        "LANGUAGE_SKELETON_ALLOWLIST": "$(rlocationpath language_skeleton_allowlist.txt)",
    },
    deps = [
        ":dx_testing",
        "@crates//:starlark_syntax",
    ],
)

testing_rust_test(
    name = "dx_generated_fresh_test",
    data = ["//:module_srcs"],
    deps = [
        ":dx_testing",
        "//cli/adopt:dx_adopt",
        "//cli/generate:dx_generate",
