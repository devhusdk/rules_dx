    "//:module_srcs",
    "//patches/rules_py:external_repo_pytest_paths.patch",
    "//patches/rules_py:host_interpreter_windows_arm64.patch",
    "//patches/rules_py:native_sdist_toolchain_flags.patch",
    "//patches/rules_py:pep517_msvc.patch",
    "//patches/rules_py:py_cc_toolchain_platform.patch",
    "//patches/rules_py:venv_bin_files.patch",
]

# size: large, nested Bazel consumer build, see #5689
nested_bazel_test(
    name = "nested_bazel_harness_test",
    size = "large",
    timeout = "moderate",
    srcs = ["nested_bazel_harness_test.rs"],
    aliases = aliases(
        package_name = "tools/dx_testing",
        normal = True,
        normal_dev = True,
    ),
    cache = "harness",
    cache_locks = "//tools/testing/nested_cache:harness_locks",
    crate_name = "nested_bazel_harness_test",
    crate_root = "nested_bazel_harness_test.rs",
    data = [
        ":nested_bazel_probe",
        "//:.bazelversion",
    ] + _HARNESS_CONSUMER_DATA,
    env = {"DX_NESTED_PROBE": "$(rootpath :nested_bazel_probe)"},
    deps = all_crate_deps(
        package_name = "tools/dx_testing",
        normal = True,
        normal_dev = True,
    ) + [
        ":dx_testing",
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing/nested:dx_nested",
        "@crates//:serde_json",
    ],
)

