load("@crates//:crates.bzl", "aliases", "crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")

package(default_visibility = ["//:__subpackages__"])

exports_files([
    "hello_output.bzl",
    "hello_output_test.rs",
])

rust_library(
    name = "dx_testing",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "tools/dx_testing",
        normal = True,
    ),
    crate_name = "dx_testing",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = crate_deps(
        ["serde_json"],
        package_name = "tools/dx_testing",
    ) + ["//cli/path:dx_path"],
)

rust_test(
    name = "dx_testing_test",
    size = "small",
    aliases = aliases(
        package_name = "tools/dx_testing",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_testing",
    data = ["//tools/testing/process_probe"],
    env = {
        "DX_PROCESS_PROBE": "$(rootpath //tools/testing/process_probe:process_probe)",
    },
    deps = crate_deps(
        [
            "serde_json",
            "tempfile",
        ],
        package_name = "tools/dx_testing",
    ),
)

rustfmt_test(
    name = "dx_testing_fmt_test",
    size = "small",
    targets = [":dx_testing"],
)

rust_clippy_test(
    name = "dx_testing_clippy_test",
    size = "small",
    targets = [":dx_testing"],
)

exports_files(["Cargo.toml"])

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "hello_output.bzl",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
