# size: large, nested Bazel consumer build, see #5689
rust_test(
    name = "nested_bazel_harness_test",
    size = "large",
    timeout = "moderate",
    srcs = ["nested_bazel_harness_test.rs"],
    aliases = aliases(
        package_name = "tools/dx_testing",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "nested_bazel_harness_test",
    crate_root = "nested_bazel_harness_test.rs",
    data = [
        ":nested_bazel_probe",
        "//:.bazelversion",
        "//:module_srcs",
    ] + NESTED_BAZEL_DATA,
    env = select({
        "@platforms//os:linux": NESTED_BAZEL_ENV | {
            "DX_NESTED_PROBE": "$(rootpath :nested_bazel_probe)",
            "PATH": "/usr/bin:/bin",
            "RUST_TEST_THREADS": "1",
        },
        "//conditions:default": NESTED_BAZEL_ENV | {
            "DX_NESTED_PROBE": "$(rootpath :nested_bazel_probe)",
            "RUST_TEST_THREADS": "1",
        },
    }),
    env_inherit = select({
        "@platforms//os:linux": [],
        "//conditions:default": NESTED_BAZEL_ENV_INHERIT,
    }),
    tags = NESTED_BAZEL_TAGS,
    deps = all_crate_deps(
        package_name = "tools/dx_testing",
        normal = True,
        normal_dev = True,
    ) + [
        ":dx_testing",
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing/nested:dx_nested",
    ],
)

