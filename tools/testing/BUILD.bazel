load("@crates//:crates.bzl", "aliases", "crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")
load(":child_runfiles.bzl", "child_runfiles")
load(":nested_bazel.bzl", "NESTED_BAZEL_TAGS")

package(default_visibility = ["//:__subpackages__"])

exports_files([
    "child_runfiles.bzl",
    "clang_diagnostics_test.rs",
    "clang_format_test.rs",
    "hello_output.bzl",
    "hello_output_test.rs",
    "java_diagnostics_test.rs",
    "jvm_format_test.rs",
    "kotlin_diagnostics_test.rs",
    "nested_bazel.bzl",
    "node_diagnostics_test.rs",
    "node_format_test.rs",
])

rust_library(
    name = "dx_testing",
    srcs = [
        "src/lib.rs",
        "src/nested.rs",
    ],
    aliases = aliases(
        package_name = "tools/dx_testing",
        normal = True,
    ),
    crate_name = "dx_testing",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = crate_deps(
        [
            "serde_json",
            "sha2",
        ],
        package_name = "tools/dx_testing",
    ) + [
        "//cli/path:dx_path",
        "@rules_rust//rust/runfiles",
    ],
)

rust_test(
    name = "dx_testing_test",
    size = "small",
    aliases = aliases(
        package_name = "tools/dx_testing",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_testing",
    data = [
        ":process_probe_child",
        "//tools/testing/process_probe",
    ],
    env = {
        "DX_PROCESS_PROBE": "$(rootpath //tools/testing/process_probe:process_probe)",
    },
    deps = crate_deps(
        [
            "serde_json",
            "sha2",
            "tempfile",
        ],
        package_name = "tools/dx_testing",
    ),
)

child_runfiles(
    name = "process_probe_child",
    testonly = True,
    binary = "//tools/testing/process_probe",
)

# keep
rust_binary(
    name = "nested_bazel_probe",
    testonly = True,
    srcs = ["nested_bazel_probe.rs"],
    edition = "2021",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [":dx_testing"],
)

# keep
rust_test(
    name = "nested_bazel_leak_test",
    size = "large",
    srcs = ["nested_bazel_leak_test.rs"],
    data = [
        ":nested_bazel_probe",
        "//:.bazelversion",
    ],
    env = {
        "DX_NESTED_PROBE": "$(rootpath :nested_bazel_probe)",
        "RUST_TEST_THREADS": "1",
    },
    env_inherit = [
        "HOME",
        "PATH",
    ],
    tags = NESTED_BAZEL_TAGS,
    target_compatible_with = ["@platforms//os:linux"],
    deps = [":dx_testing"],
)

rustfmt_test(
    name = "dx_testing_fmt_test",
    size = "small",
    targets = [
        ":dx_testing",
        ":nested_bazel_leak_test",
        ":nested_bazel_probe",
        ":preflight_smoke_test",
        ":starlark_harness",
    ],
)

rust_clippy_test(
    name = "dx_testing_clippy_test",
    size = "small",
    targets = [
        ":dx_testing",
        ":nested_bazel_leak_test",
        ":nested_bazel_probe",
        ":preflight_smoke_test",
        ":starlark_harness",
    ],
)

# keep
rust_binary(
    name = "starlark_harness",
    srcs = ["starlark_harness.rs"],
    aliases = aliases(
        package_name = "tools/dx_testing",
        normal = True,
    ),
    crate_name = "starlark_harness",
    crate_root = "starlark_harness.rs",
    edition = "2021",
    deps = crate_deps(
        ["serde_json"],
        package_name = "tools/dx_testing",
    ) + ["//cli/path:dx_path"],
)

# keep
rust_test(
    name = "starlark_harness_test",
    size = "small",
    aliases = aliases(
        package_name = "tools/dx_testing",
        normal = True,
        normal_dev = True,
    ),
    crate = ":starlark_harness",
    deps = crate_deps(
        ["serde_json"],
        package_name = "tools/dx_testing",
    ) + ["//cli/path:dx_path"],
)

# keep
rust_test(
    name = "preflight_smoke_test",
    size = "small",
    srcs = ["preflight_smoke_test.rs"],
    data = [
        "//cc/tests/fixtures/hello",
        "//cli/cli:dx",
    ],
    env = {
        "DX_PREFLIGHT_DX": "$(rootpath //cli/cli:dx)",
        "DX_PREFLIGHT_HELLO": "$(rootpath //cc/tests/fixtures/hello:hello)",
    },
    env_inherit = [
        "PROCESSOR_ARCHITECTURE",
        "PROCESSOR_ARCHITEW6432",
    ],
    deps = ["//tools/testing:dx_testing"],
)

exports_files(["Cargo.toml"])

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "child_runfiles.bzl",
        "hello_output.bzl",
        "nested_bazel.bzl",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
