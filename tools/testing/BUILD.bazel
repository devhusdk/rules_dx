rust_test(
    name = "consumer_maven_lock_test",
    srcs = ["consumer_maven_lock_test.rs"],
    aliases = aliases(
        package_name = "tools/dx_testing",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "consumer_maven_lock_test",
    crate_root = "consumer_maven_lock_test.rs",
    data = CONSUMER_MAVEN_DATA,
    env = CONSUMER_MAVEN_ENV,
    deps = all_crate_deps(
