load("@crates//:crates.bzl", "aliases", "all_crate_deps", "crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")
load(":child_runfiles.bzl", "child_runfiles")
load(":nested_bazel.bzl", "NESTED_BAZEL_COMPATIBLE_WITH", "NESTED_BAZEL_DATA", "NESTED_BAZEL_ENV", "NESTED_BAZEL_ENV_INHERIT", "NESTED_BAZEL_NETWORK_TAGS", "NESTED_BAZEL_TAGS")

package(default_visibility = ["//:__subpackages__"])

exports_files([
    "child_runfiles.bzl",
    "clang_diagnostics_test.rs",
    "clang_format_test.rs",
    "gazelle_compile_test.rs",
    "hello_output.bzl",
    "hello_output_test.rs",
    "java_diagnostics_test.rs",
    "jvm_format_test.rs",
    "kotlin_diagnostics_test.rs",
    "nested_bazel.bzl",
    "node_diagnostics_test.rs",
    "node_format_test.rs",
])

rust_library(
    name = "dx_testing",
    srcs = [
        "src/cli.rs",
        "src/fatbin.rs",
        "src/latency.rs",
        "src/lib.rs",
    ],
    aliases = aliases(
        package_name = "tools/dx_testing",
        normal = True,
    ),
    crate_name = "dx_testing",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = all_crate_deps(
        package_name = "tools/dx_testing",
        normal = True,
    ) + [
        "//cli/binfmt:dx_binfmt",
        "//cli/path:dx_path",
        "@rules_rust//rust/runfiles",
    ],
)

rust_test(
    name = "dx_testing_test",
    size = "small",
    aliases = aliases(
        package_name = "tools/dx_testing",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_testing",
    data = [
        ":process_probe_child",
        "//:.bazelversion",
        "//:MODULE.bazel",
        "//tools/testing/process_probe",
    ],
    env = {
        "DX_PROCESS_PROBE": "$(rootpath //tools/testing/process_probe:process_probe)",
    },
    deps = all_crate_deps(
        package_name = "tools/dx_testing",
        normal = True,
        normal_dev = True,
    ),
)

rust_library(
    name = "dx_nested",
    srcs = ["src/nested.rs"],
    crate_name = "dx_nested",
    crate_root = "src/nested.rs",
    edition = "2021",
    deps = [
        ":dx_testing",
        "//cli/path:dx_path",
    ],
)

rust_test(
    name = "dx_nested_test",
    size = "small",
    crate = ":dx_nested",
    data = [":nested_bazel_shim"],
    env = {"DX_TEST_NESTED_BAZEL_SHIM": "$(rlocationpath :nested_bazel_shim)"},
    deps = crate_deps(
        ["tempfile"],
        package_name = "tools/dx_testing",
    ),
)

child_runfiles(
    name = "process_probe_child",
    testonly = True,
    binary = "//tools/testing/process_probe",
)

[
    config_setting(
        name = "nested_bazel_" + os + "_" + cpu,
        constraint_values = [
            "@platforms//os:" + os,
            "@platforms//cpu:" + cpu,
        ],
    )
    for os in [
        "linux",
        "macos",
    ]
    for cpu in [
        "aarch64",
        "x86_64",
    ]
]

config_setting(
    name = "nested_bazel_windows_x86_64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

alias(
    name = "nested_bazel_bin",
    actual = select({
        ":nested_bazel_linux_aarch64": "@nested_bazel_linux_arm64//file",
        ":nested_bazel_linux_x86_64": "@nested_bazel_linux_x86_64//file",
        ":nested_bazel_macos_aarch64": "@nested_bazel_darwin_arm64//file",
        ":nested_bazel_macos_x86_64": "@nested_bazel_darwin_x86_64//file",
        ":nested_bazel_windows_x86_64": "@nested_bazel_windows_x86_64//file",
        "//conditions:default": ":nested_bazel_unpinned",
    }),
)

filegroup(
    name = "nested_bazel_unpinned",
    target_compatible_with = ["@platforms//:incompatible"],
)

# keep
rust_binary(
    name = "nested_bazel_probe",
    testonly = True,
    srcs = ["nested_bazel_probe.rs"],
    edition = "2021",
    target_compatible_with = NESTED_BAZEL_COMPATIBLE_WITH,
    deps = [":dx_nested"],
)

# keep
rust_binary(
    name = "nested_bazel_shim",
    testonly = True,
    srcs = ["nested_bazel_shim.rs"],
    edition = "2021",
    deps = [":dx_nested"],
)

# keep
rust_test(
    name = "module_srcs_test",
    size = "small",
    srcs = ["module_srcs_test.rs"],
    data = [
        "//apple:module_srcs",
        "//deploy:module_srcs",
        "//erlang:module_srcs",
        "//gleam:module_srcs",
        "//qt:module_srcs",
    ],
    deps = [":dx_testing"],
)

# keep
rust_test(
    name = "nested_bazel_leak_test",
    size = "large",
    srcs = ["nested_bazel_leak_test.rs"],
    data = [
        ":nested_bazel_probe",
        "//:.bazelversion",
    ] + NESTED_BAZEL_DATA,
    env = NESTED_BAZEL_ENV | {
        "DX_NESTED_PROBE": "$(rootpath :nested_bazel_probe)",
        "RUST_TEST_THREADS": "1",
    },
    env_inherit = NESTED_BAZEL_ENV_INHERIT,
    tags = NESTED_BAZEL_NETWORK_TAGS,
    target_compatible_with = NESTED_BAZEL_COMPATIBLE_WITH,
    deps = [
        ":dx_nested",
        ":dx_testing",
    ],
)

# keep
rust_test(
    name = "nested_bazel_pinned_test",
    size = "large",
    srcs = ["nested_bazel_pinned_test.rs"],
    data = ["//:.bazelversion"] + NESTED_BAZEL_DATA,
    env = NESTED_BAZEL_ENV | {"PATH": "/usr/bin:/bin"},
    tags = NESTED_BAZEL_TAGS,
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":dx_nested",
        ":dx_testing",
    ],
)

