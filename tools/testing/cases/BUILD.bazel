load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(
    default_testonly = True,
    default_visibility = ["//visibility:private"],
)

sh_test(
    name = "passes_and_skips",
    srcs = ["cases.sh"],
    env = {"DX_CASES": "pass"},
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)

sh_test(
    name = "fails_one_case",
    srcs = ["cases.sh"],
    env = {"DX_CASES": "fail"},
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)

sh_test(
    name = "no_cases",
    srcs = ["cases.sh"],
    env = {"DX_CASES": "none"},
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)

sh_test(
    name = "incompatible",
    srcs = ["cases.sh"],
    tags = ["manual"],
    target_compatible_with = ["@platforms//:incompatible"],
)

genrule(
    name = "broken",
    outs = ["broken.txt"],
    cmd = "exit 1",
    tags = ["manual"],
)

sh_test(
    name = "fails_to_build",
    srcs = ["cases.sh"],
    data = [":broken"],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
