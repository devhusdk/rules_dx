load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")
load(":fixtures.bzl", "CONSUMER_FIXTURES", "consumer_fixture_tests")

consumer_fixture_tests(
    name = "fixture_tests",
    size = "small",
)

rust_test(
    name = "root_module_test",
    size = "small",
    srcs = ["root_module_test.rs"],
    data = [
        "pending.txt",
        "@dx_test_tags_sources//:consumer.json",
        "@dx_test_tags_sources//:files.json",
        "@dx_test_tags_sources//:sources.json",
    ],
    env = {
        "DX_CONSUMER_FIXTURES": " ".join(CONSUMER_FIXTURES),
        "DX_CONSUMER_JSON": "$(rlocationpath @dx_test_tags_sources//:consumer.json)",
        "DX_CONSUMER_PENDING": "$(rootpath pending.txt)",
        "DX_FILES_JSON": "$(rlocationpath @dx_test_tags_sources//:files.json)",
        "DX_SOURCES_JSON": "$(rlocationpath @dx_test_tags_sources//:sources.json)",
    },
    deps = [
        "//tools/testing:dx_testing",
        "@crates//:starlark_syntax",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "fixtures.bzl",
    ],
    tags = ["corpus"],
)
