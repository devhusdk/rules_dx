load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_test")
load("//tools/testing/hermetic:defs.bzl", "nested_bazel_test")
load(":fixtures.bzl", "CONSUMER_FIXTURES", "consumer_fixture_tests")

consumer_fixture_tests(
    name = "fixture_tests",
    size = "small",
)

rust_test(
    name = "root_module_test",
    size = "small",
    srcs = ["root_module_test.rs"],
    data = [
        "pending.txt",
        "@dx_test_tags_sources//:consumer.json",
        "@dx_test_tags_sources//:files.json",
        "@dx_test_tags_sources//:sources.json",
    ],
    env = {
        "DX_CONSUMER_FIXTURES": " ".join(CONSUMER_FIXTURES),
        "DX_CONSUMER_JSON": "$(rlocationpath @dx_test_tags_sources//:consumer.json)",
        "DX_CONSUMER_PENDING": "$(rootpath pending.txt)",
        "DX_FILES_JSON": "$(rlocationpath @dx_test_tags_sources//:files.json)",
        "DX_SOURCES_JSON": "$(rlocationpath @dx_test_tags_sources//:sources.json)",
    },
    deps = [
        "//tools/testing:dx_testing",
        "@crates//:starlark_syntax",
    ],
)

# size: large, nested Bazel consumer build and test from an empty output base. Fails when the
# repositories a fresh Go-only consumer fetches differ from cold_start/go.txt (#13210).
nested_bazel_test(
    name = "go_cold_start_test",
    size = "large",
    timeout = "long",
    srcs = ["cold_start_test.rs"],
    crate_name = "cold_start_test",
    crate_root = "cold_start_test.rs",
    # //:module_srcs leaves out //patches/rules_py, which write_rules_py_patches copies.
    data = [
        "cold_start/go.txt",
        "//:module_srcs",
        "//patches/rules_py:external_repo_pytest_paths.patch",
        "//patches/rules_py:host_interpreter_windows_arm64.patch",
        "//patches/rules_py:host_libc_glibc.patch",
        "//patches/rules_py:native_sdist_toolchain_flags.patch",
        "//patches/rules_py:pep517_msvc.patch",
        "//patches/rules_py:py_cc_toolchain_platform.patch",
        "//patches/rules_py:venv_bin_files.patch",
        "//patches/rules_py:win32_x86_32.patch",
        "@dx_test_tags_sources//:consumer.json",
    ],
    env = {
        "DX_COLD_START_LANG": "go",
        "DX_COLD_START_LIST": "$(rlocationpath cold_start/go.txt)",
        "DX_CONSUMER_JSON": "$(rlocationpath @dx_test_tags_sources//:consumer.json)",
    },
    network = True,
    deps = [
        "//tools/testing:dx_testing",
        "//tools/testing/nested:dx_nested",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "fixtures.bzl",
    ],
    tags = ["corpus"],
)
