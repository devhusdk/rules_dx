# Run with --bazel and --out: rules_dx as the root module with --//cli/prebuilt:guard_view analyzes the
# IN_GRAPH_GUARD_LANGS consumer fixtures, or those of --langs, under the dx check and dx docs aspects
# and fails when they compile a rules_dx binary that prebuilt_guard_allowlist.txt does not name.
IN_GRAPH_GUARD_ENV = {
    "DX_CONSUMER_JSON": "$(rlocationpath @dx_consumer_fixtures//:consumer.json)",
    "DX_IN_GRAPH_GUARD_LANGS": " ".join(IN_GRAPH_GUARD_LANGS),
    "DX_PREBUILT_GUARD_ALLOWLIST": "$(rlocationpath prebuilt_guard_allowlist.txt)",
}

rust_binary(
    name = "in_graph_prebuilt_guard",
    testonly = True,
    srcs = ["in_graph_prebuilt_guard.rs"],
    crate_name = "in_graph_prebuilt_guard",
    crate_root = "in_graph_prebuilt_guard.rs",
    data = [
        "prebuilt_guard_allowlist.txt",
        "@dx_consumer_fixtures//:consumer.json",
    ],
    env = IN_GRAPH_GUARD_ENV,
    deps = [
        ":prebuilt_guard",
        "//cli/adopt:dx_adopt",
        "//tools/testing:dx_testing",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "in_graph_prebuilt_guard_test",
    size = "small",
    crate = ":in_graph_prebuilt_guard",
    data = [
        "prebuilt_guard_allowlist.txt",
        "@dx_consumer_fixtures//:consumer.json",
    ],
    env = IN_GRAPH_GUARD_ENV | {
        "DX_CONSUMER_FIXTURES": " ".join(CONSUMER_FIXTURES),
        "DX_GO_GUARD_LANGS": " ".join(GO_GUARD_LANGS),
        "DX_GUARD_PENDING": " ".join(GUARD_PENDING),
        "DX_JAVA_GUARD_LANGS": " ".join(JAVA_GUARD_LANGS),
        "DX_MACOS_IN_GRAPH_GUARD_LANGS": " ".join(MACOS_IN_GRAPH_GUARD_LANGS),
        "DX_WINDOWS_IN_GRAPH_GUARD_LANGS": " ".join(WINDOWS_IN_GRAPH_GUARD_LANGS),
    },
)

# One shard per case. A go, java or rust consumer fails when its build and test, or the java check
# analysis, fetch other repositories than cold_start/<case>.txt or another language's ones. A consumer
# of the GO_GUARD_LANGS or JAVA_GUARD_LANGS fixtures pins every registry tool of the host, and every
# registry key of each DX_PREBUILT_TARGET_TOOLS tool, with a stub. It fails when it still compiles a
# rules_dx binary that prebuilt_guard_allowlist.txt does not name, or when a target tool does not
# select its download on each of its release platforms.
rust_library(
    name = "consumer_network",
    testonly = True,
    srcs = [
        "cold_start_test.rs",
        "consumer_network.rs",
        "prebuilt_guard_test.rs",
    ],
    crate_name = "consumer_network",
    crate_root = "consumer_network.rs",
    deps = [
        ":prebuilt_guard",
        "//cli/adopt:dx_adopt",
        "//tools/testing:dx_testing",
        "//tools/testing/nested:dx_nested",
    ],
)

COLD_START_LISTS = [
    "cold_start/go.txt",
    "cold_start/java.txt",
    "cold_start/java_check.txt",
    "cold_start/rust.txt",
]

COLD_START_ENV = {
    "DX_COLD_START_LISTS": "$(rlocationpath cold_start/go.txt) $(rlocationpath cold_start/java.txt) $(rlocationpath cold_start/java_check.txt) $(rlocationpath cold_start/rust.txt)",
}

rust_test(
    name = "consumer_network_lib_test",
    size = "small",
    crate = ":consumer_network",
    data = COLD_START_LISTS,
    env = COLD_START_ENV,
)

nested_bazel_test(
    name = "network_test",
    size = "small",
    srcs = ["network_test.rs"],
    crate_name = "network_test",
    crate_root = "network_test.rs",
    # //:module_srcs leaves out //patches/rules_py, which write_rules_py_patches copies.
    data = COLD_START_LISTS + [
        "prebuilt_guard_allowlist.txt",
        "//:module_srcs",
        "//cli/prebuilt:go_hub_targets",
        "//cli/prebuilt:python_hub_targets",
        "//cli/prebuilt:registry",
        "//cli/prebuilt:target_tools",
        "//patches/rules_py:patches",
        "@dx_consumer_fixtures//:consumer.json",
    ],
    env = COLD_START_ENV | {
        "DX_CONSUMER_JSON": "$(rlocationpath @dx_consumer_fixtures//:consumer.json)",
        "DX_GO_GUARD_LANGS": " ".join(GO_GUARD_LANGS),
        "DX_JAVA_GUARD_LANGS": " ".join(JAVA_GUARD_LANGS),
        "DX_PREBUILT_GO_HUB_TARGETS": "$(rlocationpath //cli/prebuilt:go_hub_targets)",
        "DX_PREBUILT_GUARD_ALLOWLIST": "$(rlocationpath prebuilt_guard_allowlist.txt)",
        "DX_PREBUILT_PYTHON_HUB_TARGETS": "$(rlocationpath //cli/prebuilt:python_hub_targets)",
        "DX_PREBUILT_REGISTRY": "$(rlocationpath //cli/prebuilt:registry)",
        "DX_PREBUILT_TARGET_TOOLS": "$(rlocationpath //cli/prebuilt:target_tools)",
    },
    network = True,
    shard_count = 6,
    deps = [":consumer_network"],
)

real_source_target(
