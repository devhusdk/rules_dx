load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/testing/hermetic:defs.bzl", "nested_bazel_test")
load(":fixtures.bzl", "CONSUMER_FIXTURES", "GO_GUARD_LANGS", "GUARD_PENDING", "IN_GRAPH_GUARD_LANGS", "JAVA_GUARD_LANGS", "MACOS_IN_GRAPH_GUARD_LANGS", "WINDOWS_IN_GRAPH_GUARD_LANGS", "consumer_fixture_tests")

consumer_fixture_tests(
    name = "fixture_tests",
    size = "small",
)

rust_library(
    name = "prebuilt_guard",
