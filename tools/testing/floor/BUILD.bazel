load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = [
    "//core/modules:__pkg__",
    "//deploy/private/release/tests:__pkg__",
    "//tools/testing/hermetic:__pkg__",
])

rust_library(
    name = "dx_floor",
    testonly = True,
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "tools/testing/dx_floor",
        normal = True,
    ),
    crate_name = "dx_floor",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "tools/testing/dx_floor",
        normal = True,
    ) + ["//cli/module_bazel:dx_module_bazel"],
)

rust_test(
    name = "dx_floor_test",
    srcs = [
        "src/lib.rs",
        "src/tests.rs",
    ],
    aliases = aliases(
        package_name = "tools/testing/dx_floor",
        normal = True,
        normal_dev = True,
    ),
    compile_data = ["testdata/graph_bazel_9_2_0.json"],
    coverage_lib = ":dx_floor",
    crate_name = "dx_floor",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "tools/testing/dx_floor",
        normal = True,
        normal_dev = True,
    ) + ["//cli/module_bazel:dx_module_bazel"],
)

exports_files(["testdata/graph_bazel_9_2_0.json"])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
