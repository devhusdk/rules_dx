load("@crates//:crates.bzl", "all_crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_library", "rust_test")

package(default_visibility = [
    "//deploy/release/tests:__pkg__",
    "//modules:__pkg__",
    "//tools/testing/hermetic:__pkg__",
])

# keep
rust_library(
    name = "dx_floor",
    testonly = True,
    srcs = [
        "src/lib.rs",
        "src/tests.rs",
    ],
    crate_name = "dx_floor",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "tools/dx_testing",
        normal = True,
    ) + [
        "//libs/module_bazel:dx_module_bazel",
    ],
)

# keep
rust_test(
    name = "dx_floor_test",
    compile_data = ["testdata/graph_bazel_9_2_0.json"],
    crate = ":dx_floor",
)

exports_files(["testdata/graph_bazel_9_2_0.json"])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
