load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS_CLI_TEST")
load(":defs.bzl", "MANIFEST_COMPATIBLE_WITH", "QUALIFICATION_TAGS", "hermetic_qualification", "nested_bazel_test")

package(default_visibility = VIS_TOOLS_CLI_TEST)

exports_files(
    [
        "BUILD.bazel",
        "consumers/cuda/module_fragment.bazel",
        "defs.bzl",
        "manifest_golden_test.rs",
        "qualification_test.rs",
    ],
    visibility = VIS_TOOLS_CLI_TEST,
)

WINDOWS = ["@platforms//os:windows"]

LINUX_MACOS = select({
    "@platforms//os:linux": [],
    "@platforms//os:macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

LINUX_MACOS_WINDOWS = select({
    "@platforms//os:linux": [],
    "@platforms//os:macos": [],
    "@platforms//os:windows": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

MANIFEST_HOSTS = MANIFEST_COMPATIBLE_WITH

# The fragments of the hermetic consumers, read by //modules:consumer_deps_test.
filegroup(
    name = "module_fragments",
    srcs = glob(["consumers/*/module_fragment.bazel"]),
    visibility = ["//modules:__pkg__"],
)

rust_library(
    name = "hermetic",
    testonly = True,
    srcs = [
        "src/lib.rs",
        "src/tests.rs",
    ],
    aliases = aliases(
        package_name = "tools/dx_testing",
        normal = True,
    ),
    crate_name = "hermetic",
    crate_root = "src/lib.rs",
    target_compatible_with = MANIFEST_HOSTS,
    deps = all_crate_deps(
        package_name = "tools/dx_testing",
        normal = True,
    ) + [
        "//libs/binfmt:dx_binfmt",
        "//cli/lcov:dx_lcov",
        "//cli/process:dx_process",
        "//tools/testing:dx_nested",
        "//tools/testing:dx_testing",
        "//tools/testing/floor:dx_floor",
    ],
)

rust_test(
    name = "hermetic_unit_test",
    aliases = aliases(
        package_name = "tools/dx_testing",
        normal = True,
        normal_dev = True,
    ),
    crate = ":hermetic",
    data = [
        ":cpp_rust_manifest",
    ],
    env = {
        "DX_HERMETIC_MANIFEST": "$(rootpath :cpp_rust_manifest)",
    },
    tags = ["no-remote-exec"],
    target_compatible_with = MANIFEST_HOSTS,
    deps = all_crate_deps(
        package_name = "tools/dx_testing",
        normal = True,
        normal_dev = True,
    ),
)

rust_binary(
    name = "verify",
    testonly = True,
    srcs = ["verify.rs"],
    target_compatible_with = LINUX_MACOS_WINDOWS,
    deps = [
        ":hermetic",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "consumer_repos_test",
    srcs = ["consumer_repos_test.rs"],
    data = glob([
        "consumers/**/*BUILD.bazel",
        "consumers/*/module_fragment.bazel",
    ]),
    deps = [
        "//libs/module_bazel:dx_module_bazel",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "isolation_probe_test",
    srcs = ["isolation_test.rs"],
    tags = QUALIFICATION_TAGS,
    target_compatible_with = MANIFEST_HOSTS,
    deps = [":hermetic"],
)

rust_binary(
    name = "appcontainer_run",
    srcs = [
        "appcontainer/args.rs",
        "appcontainer/main.rs",
        "appcontainer/sys.rs",
        "appcontainer/user.rs",
    ],
    aliases = aliases(
        package_name = "tools/dx_testing",
        normal = True,
    ),
    crate_root = "appcontainer/main.rs",
    target_compatible_with = WINDOWS,
    deps = all_crate_deps(
        package_name = "tools/dx_testing",
        normal = True,
    ),
)

rust_test(
    name = "appcontainer_args_test",
    srcs = ["appcontainer/args.rs"],
)

rust_binary(
    name = "isolation_windows_probe",
    testonly = True,
    srcs = ["isolation_windows_probe.rs"],
    target_compatible_with = WINDOWS,
)

rust_test(
    name = "isolation_windows_probe_test",
    srcs = ["isolation_windows_test.rs"],
    data = [
        ":appcontainer_run",
        ":isolation_windows_probe",
    ],
    env = {
        "DX_HERMETIC_APPCONTAINER": "$(rlocationpath :appcontainer_run)",
        "DX_HERMETIC_WINDOWS_PROBE": "$(rlocationpath :isolation_windows_probe)",
    },
    tags = QUALIFICATION_TAGS,
    target_compatible_with = WINDOWS,
    deps = [
        ":hermetic",
        "//tools/testing:dx_testing",
    ],
)

