load("@crates//:crates.bzl", "aliases", "crate_deps")
load("//powershell/rules:defs.bzl", "pwsh_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS_CLI_TEST")
load(":defs.bzl", "QUALIFICATION_TAGS", "hermetic_qualification", "nested_bazel_test")

package(default_visibility = VIS_TOOLS_CLI_TEST)

exports_files(
    [
        "BUILD.bazel",
        "consumers/cuda/module_fragment.bazel",
        "defs.bzl",
        "qualification_test.rs",
    ],
    visibility = VIS_TOOLS_CLI_TEST,
)

LINUX = ["@platforms//os:linux"]

# The fragments of the hermetic consumers, read by //modules:consumer_deps_test.
filegroup(
    name = "module_fragments",
    srcs = glob(["consumers/*/module_fragment.bazel"]),
    visibility = ["//modules:__pkg__"],
)

rust_library(
    name = "hermetic",
    testonly = True,
    srcs = [
        "src/lib.rs",
        "src/tests.rs",
    ],
    aliases = aliases(
        package_name = "tools/dx_testing",
        normal = True,
    ),
    crate_name = "hermetic",
    crate_root = "src/lib.rs",
    edition = "2021",
    target_compatible_with = LINUX,
    deps = crate_deps(
        [
            "serde_json",
            "sha2",
        ],
        package_name = "tools/dx_testing",
    ) + [
        "//cli/binfmt:dx_binfmt",
        "//cli/lcov:dx_lcov",
        "//cli/process:dx_process",
        "//tools/testing:dx_testing",
        "//tools/testing/floor:dx_floor",
    ],
)

rust_test(
    name = "hermetic_unit_test",
    size = "small",
    aliases = aliases(
        package_name = "tools/dx_testing",
        normal = True,
        normal_dev = True,
    ),
    crate = ":hermetic",
    data = [
        ":c_starter_manifest",
        ":cpp_rust_manifest",
    ],
    env = {
        "DX_HERMETIC_MANIFEST": "$(rootpath :cpp_rust_manifest)",
        "DX_HERMETIC_STARTER_MANIFEST": "$(rootpath :c_starter_manifest)",
    },
    tags = ["no-remote-exec"],
    target_compatible_with = LINUX,
    deps = crate_deps(
        [
            "serde_json",
            "tempfile",
        ],
        package_name = "tools/dx_testing",
    ),
)

rust_binary(
    name = "verify",
    testonly = True,
    srcs = ["verify.rs"],
    edition = "2021",
    target_compatible_with = LINUX,
    deps = [
        ":hermetic",
        "//tools/testing:dx_testing",
    ],
)

rust_test(
    name = "isolation_probe_test",
    size = "small",
    srcs = ["isolation_test.rs"],
    tags = QUALIFICATION_TAGS,
    target_compatible_with = LINUX,
    deps = [":hermetic"],
)

