bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_shell", version = "0.10.0")
bazel_dep(name = "rules_android", version = "0.8.1")

dx_licenses = use_extension("@rules_dx//core:extensions.bzl", "dx_licenses")
dx_licenses.accept(ids = ["android-sdk-license"])

android = use_extension("@rules_dx//android:extensions.bzl", "android")

android.configure(extra_packages = ["platform-tools"])
use_repo(android, "dx_android_sdk", "dx_androidsdk")

android_sdk_repository = use_extension("@rules_android//rules/android_sdk_repository:rule.bzl", "android_sdk_repository_extension")
override_repo(android_sdk_repository, androidsdk = "dx_androidsdk")

bazel_dep(name = "rules_rust", version = "0.75.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    rustfmt_version = "1.99.1",
    versions = ["1.99.1"],
)
use_repo(rust, "rust_toolchains")
