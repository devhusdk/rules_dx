load("@rules_dx//cc/rules:defs.bzl", "cc_binary", "cc_library", "cc_test")

cc_library(
    name = "cli",
    srcs = ["cli.c"],
    hdrs = ["cli.h"],
    linkstatic = True,
    copts = ["-std=c11"],
    data = ["//cc/tests/fixtures/c-app/store:stock_json"],
    local_defines = ['STOCK_RLOCATION=\\"$(rlocationpath //cc/tests/fixtures/c-app/store:stock_json)\\"'],
    deps = ["//cc/tests/fixtures/c-app/store"],
)

cc_binary(
    name = "stock",
    srcs = ["main.c"],
    copts = ["-std=c11"],
    data = ["//cc/tests/fixtures/c-app/store:stock_json"],
    deps = [":cli"],
)

cc_test(
    name = "cli_test",
    srcs = ["cli_test.c"],
    linkstatic = True,
    copts = ["-std=c11"],
    data = [
        "//cc/tests/fixtures/c-app/store:negative_json",
        "//cc/tests/fixtures/c-app/store:stock_json",
    ],
    local_defines = ['STOCK_RLOCATION=\\"$(rlocationpath //cc/tests/fixtures/c-app/store:stock_json)\\"'],
    deps = [":cli"],
)
