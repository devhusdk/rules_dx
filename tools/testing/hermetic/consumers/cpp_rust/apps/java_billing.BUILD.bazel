load("@rules_dx//java/rules:defs.bzl", "java_library", "java_test")

_PUBLIC = ["//visibility:public"]

# gazelle:exclude without_gson

genrule(
    name = "build_info",
    srcs = ["VERSION"],
    outs = ["BuildInfo.java"],
    cmd = "printf 'package billing;\\n\\n/** Build constants. */\\npublic final class BuildInfo {\\n  /** Schema number. */\\n  public static final int SCHEMA = %s;\\n\\n  private BuildInfo() {}\\n}\\n' \"$$(cat $<)\" > $@",
)

java_library(
    name = "billing",
    srcs = [
        "Invoice.java",
        "InvoiceException.java",
        "InvoiceReader.java",
        "LineItem.java",
        "Totals.java",
        ":build_info",  # keep
    ],
    resource_strip_prefix = "java/tests/fixtures/java-app",
    resources = ["invoices.json"],
    visibility = _PUBLIC,
    deps = [
        "@maven//:com_google_code_gson_gson",
        "@maven//:com_google_guava_guava",
    ],
)

java_test(
    name = "invoice_reader_test",
    srcs = ["InvoiceReaderTest.java"],
    test_class = "billing.InvoiceReaderTest",
    deps = [":billing"],
)

java_test(
    name = "totals_test",
    srcs = ["TotalsTest.java"],
    test_class = "billing.TotalsTest",
    deps = [
        ":billing",
        "@maven//:com_google_guava_guava",
    ],
)

java_test(
    name = "classpath_test",
    srcs = ["ClasspathTest.java"],
    test_class = "billing.ClasspathTest",
    deps = [
        ":billing",
        "@maven//:com_google_code_gson_gson",
        "@maven//:com_google_guava_guava",
    ],
)

filegroup(
    name = "billing_srcs",
    srcs = [
        "Invoice.java",
        "InvoiceException.java",
        "InvoiceReader.java",
        "LineItem.java",
        "Totals.java",
        ":build_info",
    ],
    visibility = _PUBLIC,
)
