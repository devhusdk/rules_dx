load("@rules_dx//java/rules:defs.bzl", "java_binary", "java_library", "java_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

java_library(
    name = "cli",
    srcs = ["Cli.java"],
    deps = ["//examples/java-app/billing"],
)

java_library(
    name = "cli_indirect",
    srcs = ["Cli.java"],
    tags = ["manual"],
    deps = [":cli"],
)

java_binary(
    name = "invoice",
    srcs = ["Main.java"],
    main_class = "cli.Main",
    deps = [":cli"],
)

java_test(
    name = "cli_test",
    srcs = ["CliTest.java"],
    test_class = "cli.CliTest",
    deps = [
        ":cli",
        "@maven//:junit_junit",
    ],
)

sh_test(
    name = "exit_codes_test",
    srcs = ["exit_codes.sh"],
    args = ["$(rootpath :invoice)"],
    data = [":invoice"],
)

java_test(
    name = "consumer_choice_test",
    srcs = ["ConsumerChoiceTest.java"],
    test_class = "cli.ConsumerChoiceTest",
    deps = ["@maven//:junit_junit"],
)
