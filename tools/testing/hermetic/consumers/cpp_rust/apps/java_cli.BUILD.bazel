load("@rules_dx//java/rules:defs.bzl", "java_binary", "java_library", "java_test")

java_library(
    name = "cli",
    srcs = ["Cli.java"],
    deps = [
        "//examples/java-app/billing",
        "@maven//:com_google_guava_guava",
    ],
)

java_binary(
    name = "invoice",
    srcs = ["Main.java"],
    main_class = "cli.Main",
    deps = [":cli"],
)

java_test(
    name = "cli_test",
    srcs = ["CliTest.java"],
    test_class = "cli.CliTest",
    deps = [
        ":cli",
        "@maven//:junit_junit",
    ],
)
