load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_dx//kotlin/rules:defs.bzl", "kotlin_binary", "kotlin_library", "kotlin_test")

kotlin_library(
    name = "cli",
    srcs = ["Cli.kt"],
    deps = [
        "//examples/kotlin-app/grades",
        "@maven//:com_google_guava_guava",
    ],
)

kotlin_binary(
    name = "grades",
    srcs = ["Main.kt"],
    main_class = "cli.MainKt",
    deps = [":cli"],
)

kotlin_test(
    name = "cli_test",
    srcs = ["CliTest.kt"],
    test_class = "cli.CliTest",
    deps = [
        ":cli",
        "@maven//:junit_junit",
    ],
)

sh_test(
    name = "exit_codes_test",
    srcs = ["exit_codes.sh"],
    args = ["$(rootpath :grades)"],
    data = [":grades"],
)

kotlin_test(
    name = "consumer_choice_test",
    srcs = ["ConsumerChoiceTest.kt"],
    test_class = "cli.ConsumerChoiceTest",
    deps = ["@maven//:junit_junit"],
)
