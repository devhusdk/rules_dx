load("@rules_dx//kotlin:defs.bzl", "kotlin_binary", "kotlin_library", "kotlin_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# gazelle:resolve kotlin grades.BuildInfo //kotlin/tests/fixtures/kotlin-app/grades

_PUBLIC = ["//visibility:public"]

kotlin_library(
    name = "cli",
    srcs = ["Cli.kt"],
    visibility = _PUBLIC,
    deps = ["//kotlin/tests/fixtures/kotlin-app/grades"],
)

kotlin_binary(
    name = "grades",
    srcs = ["Main.kt"],
    main_class = "cli.MainKt",
    deps = [":cli"],
)

kotlin_test(
    name = "cli_test",
    srcs = ["CliTest.kt"],
    test_class = "cli.CliTest",
    deps = [
        ":cli",
        "@maven//:junit_junit",
    ],
)

sh_test(
    name = "exit_codes_test",
    srcs = ["exit_codes.sh"],
    args = ["$(rootpath :grades)"],
    data = [":grades"],
    # Bazel's sh_test cannot collect coverage of a JVM binary in data: it runs the
    # gcov collector without a C++ toolchain. The JVM tests cover this code.
    tags = ["no-coverage"],
)

kotlin_test(
    name = "consumer_choice_test",
    srcs = ["ConsumerChoiceTest.kt"],
    test_class = "cli.ConsumerChoiceTest",
    deps = [
        ":cli",
        "@maven//:junit_junit",
    ],
)
