load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@rules_dx//typescript/rules:defs.bzl", "typescript_js_test", "typescript_project", "typescript_test")

_PUBLIC = ["//visibility:public"]

genrule(
    name = "build_info",
    srcs = ["VERSION"],
    outs = ["build_info.ts"],
    cmd = "printf 'export const SCHEMA = %s;\\n' \"$$(cat $<)\" > $@",
)

typescript_project(
    name = "registry",
    srcs = [
        "registry.ts",
        ":build_info",
    ],
    data = ["packages.json"],
    declaration = True,
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
    visibility = _PUBLIC,
    deps = [
        "//examples/node-app:node_modules/@types/semver",
        "//examples/node-app:node_modules/semver",
    ],
)

npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        ":registry",
    ],
    visibility = _PUBLIC,
)

typescript_test(
    name = "registry_test",
    srcs = ["registry_test.ts"],
    config = "jest.config.cjs",
    declaration = True,
    node_modules = "//examples/node-app:node_modules",
    node_options = ["--experimental-vm-modules"],
    package_json = "//examples/node-app:package_json",
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
    deps = [":registry"],
)

typescript_js_test(
    name = "plain_test",
    srcs = ["plain_test.ts"],
    data = [
        "VERSION",
        "packages.json",
    ],
    declaration = True,
    entry_point = "plain_test.js",
    package_json = "//examples/node-app:package_json",
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
    deps = [
        ":registry",
        "//examples/node-app:node_modules/@types/node",
    ],
)
