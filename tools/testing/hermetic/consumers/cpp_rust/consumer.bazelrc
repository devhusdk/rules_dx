import %workspace%/.dx/bazelrc/correctness.bazelrc
build --config=consumer
build:consumer --copt=-DDX_CONSUMER_CONFIG=1
build --java_runtime_version=remotejdk_21
build --tool_java_runtime_version=remotejdk_21
build --jvmopt=-Ddx.consumer.choice=kept
build --enable_platform_specific_config
common:windows --experimental_override_platform_cpu_name=@my_dx//tools/platforms:windows_msvc_host=wx
common:windows --repo_env=BAZEL_MSVC_RUNTIME_VISUAL_STUDIO_EULA=1
common:windows --repo_env=BAZEL_WINDOWS_SDK_EULA=1
build:windows --per_file_copt=external/protobuf[+]/upb/wire/encode[.]c@-D__SEH__
build:windows --host_per_file_copt=external/protobuf[+]/upb/wire/encode[.]c@-D__SEH__
# build, not coverage: the fetch_coverage probe runs build --collect_code_coverage.
build:windows --features=-coverage
build:windows --features=-gcc_coverage_map_format
build:windows --per_file_copt=.*compiler-rt/lib/profile/.*@-D__MINGW_EXTENSION=
build:macos --dynamic_mode=off
