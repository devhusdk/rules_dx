bazel_dep(name = "googletest", version = "1.18.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_shell", version = "0.8.0")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "c_app_cjson",
    build_file = "//examples/c-app/store:cjson.build",
    sha256 = "3aa806844a03442c00769b83e99970be70fbef03735ff898f4811dd03b9f5ee5",
    strip_prefix = "cJSON-1.7.18",
    urls = ["https://github.com/DaveGamble/cJSON/archive/refs/tags/v1.7.18.tar.gz"],
)

http_archive(
    name = "cpp_app_fmt",
    build_file = "//examples/cpp-app/core:fmt.build",
    sha256 = "ea7de4299689e12b6dddd392f9896f08fb0777ac7168897a244a6d6085043fea",
    strip_prefix = "fmt-12.1.0",
    urls = ["https://github.com/fmtlib/fmt/archive/refs/tags/12.1.0.tar.gz"],
)

bazel_dep(name = "rules_jvm_external", version = "7.1")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "com.google.code.gson:gson:2.8.9",
        "com.google.guava:guava:32.0.1-jre",
        "junit:junit:4.13.2",
    ],
    fail_if_repin_required = True,
    known_contributing_modules = ["protobuf"],
    lock_file = "//:maven_install.json",
    repositories = [
        "https://maven-central.storage-download.googleapis.com/maven2",
        "https://repo1.maven.org/maven2",
    ],
)
use_repo(maven, "maven")

bazel_dep(name = "aspect_rules_js", version = "3.5.2")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "aspect_rules_jest", version = "0.26.0")

typescript = use_extension("@aspect_rules_ts//ts:extensions.bzl", "typescript")
typescript.deps(
    integrity = "sha512-jl1vZzPDinLr9eUt3J/t7V6FgNEw9QjvBPdysz9KfQDD41fQrC2Y4vKQdiaUpFT4bXlb1RHhLpp8wtm6M5TgSw==",
    version = "5.9.3",
)
use_repo(typescript, "npm_typescript")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm_consumer_app",
    npmrc = "//:.npmrc",
    pnpm_lock = "//examples/node-app:pnpm-lock.yaml",
)
use_repo(npm, "npm_consumer_app")
