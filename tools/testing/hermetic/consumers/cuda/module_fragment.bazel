bazel_dep(name = "llvm", version = "0.8.26")
bazel_dep(name = "rules_cuda", version = "0.4.0-beta1")
bazel_dep(name = "rules_shell", version = "0.8.0")

cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
cuda.redist_json(
    name = "cuda_redist",
    components = ["cccl", "crt", "cublas", "cudart", "cufft", "curand", "nvcc", "nvvm"],
    platforms = ["linux-x86_64", "linux-sbsa", "windows-x86_64", "windows-arm64"],
    sha256 = "015b97aa3977d4d0bade1631b226b6d4cbe48751cc841aad9193295df7f9047a",
    version = "13.4.2",
)
cuda.toolkit(
    name = "cuda",
    nvcc_version = "13.4",
)
use_repo(cuda, "cuda")

# The CUDA Toolkit is licensed under the NVIDIA EULA: https://docs.nvidia.com/cuda/eula/index.html
cuda_license = use_extension("@rules_dx_cuda//toolchain:repos.bzl", "cuda_license")
cuda_license.license(accept = ["cuda-eula"])
