bazel_dep(name = "rules_dart", version = "0.8.1")
bazel_dep(name = "rules_flutter", version = "0.0.8")

flutter_pub = use_extension("@rules_dx//flutter:extensions.bzl", "pub")
flutter_pub.lock(
    name = "dx_flutter_app_deps",
    lock = "//flutter/tests/fixtures/flutter-app:pubspec.lock",
)
use_repo(flutter_pub, "dx_flutter_app_deps")

bazel_dep(name = "rules_android", version = "0.8.1")
bazel_dep(name = "rules_shell", version = "0.8.0")

android_sdk = use_extension("@rules_dx//android:extensions.bzl", "android_sdk")
android_sdk.configure(accept_licenses = ["android-sdk-license"])
use_repo(android_sdk, "dx_android_sdk", "dx_androidsdk")

android_sdk_repository = use_extension("@rules_android//rules/android_sdk_repository:rule.bzl", "android_sdk_repository_extension")
override_repo(android_sdk_repository, androidsdk = "dx_androidsdk")
