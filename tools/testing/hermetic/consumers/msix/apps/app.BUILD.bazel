load("@rules_dx//cc/rules:defs.bzl", "cc_binary")
load("@rules_dx//msix:defs.bzl", "dx_msix", "dx_msix_sign")
load("@rules_dx//powershell/rules:defs.bzl", "pwsh_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

cc_binary(
    name = "dxmsix",
    srcs = ["main.c"],
    dynamic_deps = ["//examples/msix-app/greet:greet_dll"],
    features = [
        "-runtime_library_search_directories",
        "-runtime_library_search_directories_workaround",
    ],
    target_compatible_with = ["@platforms//os:windows"],
    deps = ["//examples/msix-app/greet"],
)

dx_msix(
    name = "app",
    alias = "dxmsix.exe",
    binary = ":dxmsix",
    data = ["greeting.txt"],
    display_name = "dx MSIX example",
    identity_name = "DxMsix.Example",
    logo = "logo.png",
    notice = ["NOTICE.txt"],
    publisher = "CN=DxMsixExample, O=Dx",
    version = "1.2.3.0",
)

dx_msix_sign(
    name = "app_sign",
    package = ":app",
)

pwsh_test(
    name = "sign_check",
    size = "small",
    srcs = ["sign_check.ps1"],
    data = [
        ":app",
        ":app_sign",
        "@rules_dx//msix:signtool",
    ],
    env = {
        "DX_MSIX_PACKAGE": "$(rlocationpaths :app)",
        "DX_MSIX_PUBLISHER": "CN=DxMsixExample, O=Dx",
        "DX_MSIX_SIGN": "_main/examples/msix-app/app/app_sign.bat",
        "DX_MSIX_SIGNTOOL": "$(rlocationpaths @rules_dx//msix:signtool)",
    },
    target_compatible_with = ["@platforms//os:windows"],
    deps = ["@rules_powershell//powershell/runfiles"],
)

sh_test(
    name = "tools_test",
    size = "small",
    srcs = ["tools_test.sh"],
    args = [
        "$(rlocationpaths @dx_msix_tools//:x64)",
        "$(rlocationpaths @dx_msix_tools//:arm64)",
    ],
    data = [
        "@dx_msix_tools//:arm64",
        "@dx_msix_tools//:x64",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
