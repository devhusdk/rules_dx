load("@rules_dx//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

_PUBLIC = ["//visibility:public"]

rust_library(
    name = "tasks_model",
    srcs = ["model/lib.rs"],
    crate_name = "shared_tasks_model",
    crate_root = "model/lib.rs",
)

rust_test(
    name = "tasks_model_test",
    crate = ":tasks_model",
)

rust_library(
    name = "tasks_core",
    srcs = ["core/lib.rs"],
    crate_name = "shared_tasks",
    crate_root = "core/lib.rs",
    visibility = _PUBLIC,
    deps = [
        ":tasks_model",
        "@shared_tasks_adler2//:adler2",
    ],
)

rust_test(
    name = "tasks_core_test",
    crate = ":tasks_core",
)

rust_binary(
    name = "tasks",
    srcs = ["cli/main.rs"],
    crate_name = "shared_tasks_cli",
    crate_root = "cli/main.rs",
    visibility = _PUBLIC,
    deps = [":tasks_core"],
)

rust_binary(
    name = "tasks_without_core",
    srcs = ["cli/main.rs"],
    crate_name = "shared_tasks_cli",
    crate_root = "cli/main.rs",
    tags = ["manual"],
    deps = [":tasks_model"],
)

rust_binary(
    name = "consumer_report",
    srcs = ["consumer_report.rs"],
    crate_root = "consumer_report.rs",
    deps = [":tasks_core"],
)

rust_binary(
    name = "consumer_report_wasi",
    srcs = ["consumer_report.rs"],
    crate_root = "consumer_report.rs",
    wasm = "wasi",
    deps = [":tasks_core"],
)

rust_test(
    name = "consumer_report_test",
    srcs = ["consumer_report_test.rs"],
    data = [
        ":consumer_report_wasi",
        "@rules_dx//wasi:wasmtime",
    ],
    env = {
        "REPORT_WASM": "$(rootpath :consumer_report_wasi)",
        "WASMTIME": "$(rootpath @rules_dx//wasi:wasmtime)",
    },
    tags = ["block-network"],
    deps = ["@rules_dx//wasi:wasi_run"],
)

# keep
rust_binary(
    name = "tasks_wasi",
    srcs = ["cli/main.rs"],
    crate_name = "shared_tasks_cli",
    crate_root = "cli/main.rs",
    visibility = _PUBLIC,
    wasm = "wasi",
    deps = [":tasks_core"],
)

rust_test(
    name = "wasi_test",
    srcs = ["tests/wasi_test.rs"],
    data = [
        "assets/board.txt",
        "assets/notes.txt",
        ":tasks_wasi",
        "@rules_dx//wasi:wasmtime",
    ],
    env = {
        "BOARD": "$(rootpath assets/board.txt)",
        "NOTES": "$(rootpath assets/notes.txt)",
        "TASKS_WASM": "$(rootpath :tasks_wasi)",
        "WASMTIME": "$(rootpath @rules_dx//wasi:wasmtime)",
    },
    tags = ["block-network"],
    deps = ["@rules_dx//wasi:wasi_run"],
)

rust_test(
    name = "runtime_test",
    srcs = ["runtime_test.rs"],
    env = {"DX_WASI_NOTE": "declared"},
    runtime = select({
        "@platforms//os:windows": "custom_runtime.cmd",
        "//conditions:default": "custom_runtime.sh",
    }),
    tags = ["block-network"],
    wasm = "wasi",
)
