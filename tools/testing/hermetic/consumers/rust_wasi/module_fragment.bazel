bazel_dep(name = "rules_shell", version = "0.8.0")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "shared_tasks_adler2",
    build_file = "//examples/shared-rust:adler2.build",
    sha256 = "320119579fcad9c21884f5c4861d16174d0e06250625266f50fe6898340abefa",
    strip_prefix = "adler2-2.0.1",
    type = "tar.gz",
    urls = ["https://static.crates.io/crates/adler2/adler2-2.0.1.crate"],
)

bazel_dep(name = "rules_rust", version = "0.75.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    extra_rustc_flags = ["--cfg=consumer_toolchain"],
    extra_target_triples = ["wasm32-wasip1"],
    rustfmt_version = "1.99.1",
    versions = ["1.99.1"],
)
use_repo(rust, "rust_toolchains")
