load("@rules_dx//quality:native_config.bzl", "scalafix_config")
load("@rules_dx//quality/private:generated_policy.bzl", "dx_generated_policy")

_PUBLIC = ["//visibility:public"]

package(default_visibility = _PUBLIC)

dx_generated_policy(
    name = "policy",
    defaults = False,
    families = {
        "scala": {
            "disabled": [
                "audit",
                "format",
                "typecheck",
            ],
            "lint": ["scalafix"],
        },
    },
    profile = "standard",
)

scalafix_config(
    name = "scalafix_config",
    src = "scalafix.conf",
)
