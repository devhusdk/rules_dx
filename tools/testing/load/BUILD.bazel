load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS_CLI_TEST")

package(default_visibility = VIS_TOOLS_CLI_TEST)

rust_binary(
    name = "parallel_worktrees",
    srcs = [
        "src/main.rs",
        "src/metrics.rs",
        "src/mnemonics.rs",
    ],
    aliases = aliases(
        package_name = "tools/testing/parallel_worktrees",
        normal = True,
    ),
    crate_name = "parallel_worktrees",
    crate_root = "src/main.rs",
    data = ["//cli/cli:dx"],
    env = {"DX_LOAD_DX": "$(rootpath //cli/cli:dx)"},
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = all_crate_deps(
        package_name = "tools/testing/parallel_worktrees",
        normal = True,
    ) + [
        "//cli/process:dx_process",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "load_test",
    aliases = aliases(
        package_name = "tools/testing/parallel_worktrees",
        normal = True,
        normal_dev = True,
    ),
    crate = ":parallel_worktrees",
    target_compatible_with = ["@platforms//os:linux"],
    deps = all_crate_deps(
        package_name = "tools/testing/parallel_worktrees",
        normal = True,
        normal_dev = True,
    ) + ["//cli/process:dx_process"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
