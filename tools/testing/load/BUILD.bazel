load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_test", "rustfmt_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS_CLI_TEST")

package(default_visibility = VIS_TOOLS_CLI_TEST)

# keep
rust_binary(
    name = "parallel_worktrees",
    srcs = [
        "src/main.rs",
        "src/metrics.rs",
        "src/mnemonics.rs",
    ],
    crate_name = "parallel_worktrees",
    crate_root = "src/main.rs",
    data = ["//cli/cli:dx"],
    env = {"DX_LOAD_DX": "$(rootpath //cli/cli:dx)"},
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//cli/process:dx_process",
        "@crates//:serde_json",
    ],
)

# keep
rust_test(
    name = "load_test",
    crate = ":parallel_worktrees",
    target_compatible_with = ["@platforms//os:linux"],
)

rustfmt_test(
    name = "parallel_worktrees_fmt_test",
    targets = [":parallel_worktrees"],
)

rust_clippy_test(
    name = "parallel_worktrees_clippy_test",
    targets = [":parallel_worktrees"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)
