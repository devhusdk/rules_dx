load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS_CLI_TEST")

package(default_visibility = VIS_TOOLS_CLI_TEST)

rust_library(
    name = "dx_lsp",
    testonly = True,
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "tools/testing/dx_lsp",
        normal = True,
    ),
    crate_name = "dx_lsp",
    crate_root = "src/lib.rs",
    deps = all_crate_deps(
        package_name = "tools/testing/dx_lsp",
        normal = True,
    ),
)

rust_test(
    name = "dx_lsp_test",
    aliases = aliases(
        package_name = "tools/testing/dx_lsp",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_lsp",
    deps = all_crate_deps(
        package_name = "tools/testing/dx_lsp",
        normal = True,
        normal_dev = True,
    ),
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
