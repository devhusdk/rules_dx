load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS_CLI_TEST", "VIS_TOOLS_PUBLIC")
load(":sh_env.bzl", "sh_rustc_env")

package(default_visibility = VIS_TOOLS_CLI_TEST)

rust_library(
    name = "dx_nested",
    testonly = True,
    srcs = [
        "src/cache.rs",
        "src/compose.rs",
        "src/footprint.rs",
        "src/lib.rs",
        "src/plain_consumer.rs",
        "src/plain_fixture.rs",
        "src/record.rs",
        "src/shared.rs",
    ],
    aliases = aliases(
        package_name = "tools/testing/dx_nested",
        normal = True,
    ),
    compile_data = ["//:MODULE.bazel"],
    crate_name = "dx_nested",
    crate_root = "src/lib.rs",
    rustc_env_files = [":sh_rustc_env"],
    visibility = VIS_TOOLS_PUBLIC,
    deps = all_crate_deps(
        package_name = "tools/testing/dx_nested",
        normal = True,
    ) + [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/digest:dx_digest",
        "//cli/families:dx_families",
        "//cli/os_sys:dx_os_sys",
        "//cli/path:dx_path",
        "//cli/process:dx_process",
        "//tools/bazelrc:dx_preset",
        "//tools/testing:dx_testing",
        "@crates//:serde_json",
    ],
)

sh_rustc_env(
    name = "sh_rustc_env",
    testonly = True,
)

# keep
rust_binary(
    name = "nested_probe",
    testonly = True,
    srcs = ["probe/main.rs"],
    crate_name = "nested_probe",
    crate_root = "probe/main.rs",
)

rust_test(
    name = "dx_nested_test",
    size = "small",
    aliases = aliases(
        package_name = "tools/testing/dx_nested",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_nested",
    data = [
        ":nested_probe",
        "//:.bazelrc",
        "//tools/testing:nested_bazel_shim",
    ],
    env = {
        "DX_TEST_NESTED_PROBE": "$(rlocationpath :nested_probe)",
        "DX_TEST_NESTED_BAZEL_SHIM": "$(rlocationpath //tools/testing:nested_bazel_shim)",
        "DX_TEST_ROOT_BAZELRC": "$(rlocationpath //:.bazelrc)",
    },
    deps = all_crate_deps(
        package_name = "tools/testing/dx_nested",
        normal = True,
        normal_dev = True,
    ) + [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/digest:dx_digest",
        "//cli/families:dx_families",
        "//cli/os_sys:dx_os_sys",
        "//cli/path:dx_path",
        "//cli/process:dx_process",
        "//cli/test_wait:dx_test_wait",
        "//tools/bazelrc:dx_preset",
        "//tools/testing:dx_testing",
        "@crates//:serde_json",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "sh_env.bzl",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    [
        "src/lib.rs",
    ],
    visibility = ["//core/quality:__pkg__"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
