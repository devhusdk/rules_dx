load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_test")
load("//tools/visibility:visibility.bzl", "VIS_TOOLS_CLI_TEST")

package(
    default_testonly = True,
    default_visibility = VIS_TOOLS_CLI_TEST + ["@dx_consumer_completion//:__pkg__"],
)

exports_files(
    ["src/main.rs"],
    visibility = VIS_TOOLS_CLI_TEST,
)

rust_binary(
    name = "process_probe",
    srcs = ["src/main.rs"],
    crate_name = "process_probe",
    crate_root = "src/main.rs",
)

rust_test(
    name = "process_probe_test",
    srcs = ["probe_test.rs"],
    data = [":process_probe"],
    env = {
        "DX_PROCESS_PROBE": "$(rootpath :process_probe)",
    },
    deps = [
        "//cli/test_scratch:dx_test_scratch",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
