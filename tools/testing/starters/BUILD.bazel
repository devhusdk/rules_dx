# One consumer test per hello-world fixture under fixtures/. Each runs `dx init --apply` into a
# new directory, adds the fixture sources, points the project at this checkout and runs
# `bazel test //...` in a nested Bazel. The targets are manual; the CI `starter-consumer` job
# selects them by tag. Write each call literally: the support matrix reader does not expand
# loops. cuda and rust-android have their own tests under //cuda/tests/starter and
# //android/tests/starter.

nested_bazel_test(
    name = "astro",
    size = "enormous",
    srcs = ["starter_consumer_test.rs"],
    crate_root = "starter_consumer_test.rs",
    data = [
        "//:module_srcs",
        "//cli/cli:dx",
        "//tools/testing/starters/fixtures:astro",
    ],
    env = {
        "DX_BIN": "$(rootpath //cli/cli:dx)",
        "DX_FIXTURE": "astro",
        "DX_FIXTURE_FILES": "$(rootpaths //tools/testing/starters/fixtures:astro)",
    },
    network = True,
    tags = STARTER_CONSUMER_TAGS,
    deps = [
        "//tools/testing:dx_nested",
        "//tools/testing:dx_testing",
    ],
)

