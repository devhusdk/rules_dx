    name = "starter_init_smoke_test",
    size = "enormous",
    srcs = ["starter_init_smoke_test.rs"],
    crate_root = "starter_init_smoke_test.rs",
    data = [
        "//:module_srcs",
        "//cli/cli:dx",
        "//tools/testing/starters/fixtures:c",
    ],
    env = {
        "DX_BIN": "$(rootpath //cli/cli:dx)",
        "DX_FIXTURE": "c",
        "DX_FIXTURE_FILES": "$(rootpaths //tools/testing/starters/fixtures:c)",
    },
    env_inherit = NESTED_BAZEL_ENV_INHERIT,
    network = True,
    tags = STARTER_CONSUMER_TAGS,
    deps = [
        ":starter_scaffold",
        "//tools/testing:dx_nested",
        "//tools/testing:dx_testing",
    ],
)

