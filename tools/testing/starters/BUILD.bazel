load("@crates//:crates.bzl", "aliases")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_library")

rust_library(
    name = "starter_scaffold",
    testonly = True,
    srcs = ["scaffold.rs"],
    aliases = aliases(
        package_name = "tools/testing/starter_scaffold",
        normal = True,
    ),
    crate_name = "starter_scaffold",
    crate_root = "scaffold.rs",
    visibility = ["//visibility:public"],
