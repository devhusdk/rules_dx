# One consumer test per `dx new` starter. Each scaffolds the starter, points it at this
# checkout and runs `bazel test //...` in a nested Bazel. The targets are manual; the CI
# `starter-consumer` job selects them by tag. Write each call literally: the support
# matrix reader does not expand loops. cuda, rust-android and rust-web are not covered yet, and neither are the adopt-style starters
# (csharp, fsharp, go, java, javascript, kotlin, python, rust, scala, typescript), which ship a
# MODULE.bazel.snippet and no BUILD files, so they need a gazelle-driven flow.

nested_bazel_test(
    name = "astro",
    size = "enormous",
    srcs = ["starter_consumer_test.rs"],
    crate_root = "starter_consumer_test.rs",
    data = [
        "//:module_srcs",
        "//cli/cli:dx",
    ],
    env = {
        "DX_BIN": "$(rootpath //cli/cli:dx)",
        "DX_STARTER": "astro",
    },
    network = True,
    tags = STARTER_CONSUMER_TAGS,
    deps = [
        "//tools/testing:dx_nested",
        "//tools/testing:dx_testing",
    ],
)

