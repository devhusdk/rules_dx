load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@demo_npm//:defs.bzl", "npm_link_all_packages")
load("@rules_dx//javascript:defs.bzl", "javascript_test", "javascript_library")
load("@rules_dx//astro:defs.bzl", "astro_library")

npm_link_all_packages(name = "node_modules")

js_library(
    name = "package_json",
    srcs = ["package.json"],
)

javascript_library(
    name = "helper",
    srcs = ["helper.js"],
)

astro_library(
    name = "demo-app",
    srcs = ["Hello.astro"],
    deps = [":helper"],
)

javascript_test(
    name = "demo-app_test",
    runner = "node",
    size = "small",
    srcs = ["hello.test.js"],
    data = [
        ":demo-app",
        ":node_modules/@astrojs/compiler",
    ],
    main = "hello.test.js",
    package_json = ":package_json",
)
