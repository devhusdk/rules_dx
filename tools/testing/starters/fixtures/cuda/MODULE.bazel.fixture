cuda = use_extension("@rules_dx//cuda:extensions.bzl", "cuda")
# The CUDA Toolkit is licensed under the NVIDIA EULA: https://docs.nvidia.com/cuda/eula/index.html
# The next line accepts it for this build; remove it to decline (CUDA targets then fail to build).
dx_licenses = use_extension("@rules_dx//core:extensions.bzl", "dx_licenses")
dx_licenses.accept(ids = ["cuda-eula"])
