#include <cstdio>
#include <vector>

#include "scale.h"

int main() {
  const int n = 8;
  std::vector<float> x(n);
  std::vector<float> y(n, 0.0f);
  for (int i = 0; i < n; ++i) {
    x[i] = static_cast<float>(i);
  }
  if (scale_device_count() == 0 || scale_gpu(n, 2.0f, x.data(), y.data()) != 0) {
    scale_cpu(n, 2.0f, x.data(), y.data());
  }
  float sum = 0.0f;
  for (int i = 0; i < n; ++i) {
    sum += y[i];
  }
  std::printf("scaled sum=%g\n", sum);
  return 0;
}
