load("@rules_dx//elixir:defs.bzl", "elixir_app", "elixir_test", "escript_archive", "escript_headers")

elixir_app(
    name = "demo-app",
    app_name = "hello",
    app_version = "0.1.0",
)

escript_archive(
    name = "demo-app_bin",
    app = ":demo-app",
    headers = escript_headers("Hello.CLI"),
)

elixir_test(
    name = "demo-app_test",
    srcs = [
        "test/hello_test.exs",
        "test/test_helper.exs",
    ],
    deps = [":demo-app"],
)
