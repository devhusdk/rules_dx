load("@rules_dx//erlang:defs.bzl", "erlang_app", "erlang_bytecode", "erlang_erlc_opts", "erlang_escript_archive", "erlang_eunit_test", "erlang_test_app")

erlang_app(
    name = "demo-app",
    app_description = "Greets people.",
    app_name = "hello",
    app_version = "0.1.0",
)

erlang_test_app(
    name = "demo-app_test_app",
    app_description = "Greets people.",
    app_name = "hello",
    app_version = "0.1.0",
)

erlang_erlc_opts(
    name = "test_erlc_opts",
    values = [
        "+deterministic",
        "+debug_info",
        "+warn_export_vars",
        "+warn_shadow_vars",
        "+warn_obsolete_guard",
        "-DTEST=1",
    ],
)

erlang_bytecode(
    name = "demo-app_test_modules",
    testonly = True,
    srcs = ["test/hello_tests.erl"],
    outs = ["test/hello_tests.beam"],
    erlc_opts = ":test_erlc_opts",
    deps = [":demo-app_test_app"],
)

erlang_eunit_test(
    name = "demo-app_test",
    compiled_suites = [":demo-app_test_modules"],
    target = ":demo-app_test_app",
)

erlang_escript_archive(
    name = "demo-app_bin",
    app = ":demo-app",
    headers = [
        "shebang",
        "{emu_args, \"-escript main hello_cli\"}",
    ],
)
