load("@rules_dx//flutter:defs.bzl", "flutter_library", "flutter_test")

flutter_library(
    name = "demo-app",
    srcs = ["lib/hello.dart"],
    package_name = "demo_app",
    deps = ["@demo_flutter_deps//:flutter"],
)

flutter_test(
    name = "demo-app_test",
    size = "small",
    package_name = "demo_app",
    main = "test/hello_test.dart",
    deps = [
        ":demo-app",
        "@demo_flutter_deps//:flutter_test",
    ],
)
