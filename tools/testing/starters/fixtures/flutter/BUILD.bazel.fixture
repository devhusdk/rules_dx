load("@rules_dx//dart:defs.bzl", "dart_package_metadata")
load("@rules_dx//flutter:defs.bzl", "flutter_library", "flutter_test")

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "demo_app",
)

flutter_library(
    name = "demo-app",
    srcs = ["lib/hello.dart"],
    package = ":pubspec-metadata",
    deps = ["@demo_flutter_deps//:flutter"],
)

flutter_test(
    name = "demo-app_test",
    size = "small",
    main = "test/hello_test.dart",
    package = ":pubspec-metadata",
    deps = [
        ":demo-app",
        "@demo_flutter_deps//:flutter_test",
    ],
)
