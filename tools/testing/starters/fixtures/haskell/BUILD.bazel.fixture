load("@rules_dx//haskell/rules:defs.bzl", "HASKELL_COMPATIBLE_WITH", "haskell_binary", "haskell_library", "haskell_test")

haskell_library(
    name = "demo-app",
    srcs = ["src/Hello.hs"],
    target_compatible_with = HASKELL_COMPATIBLE_WITH,
    deps = ["@rules_dx//haskell/toolchain:base"],
)

haskell_binary(
    name = "demo-app_bin",
    srcs = ["src/Main.hs"],
    target_compatible_with = HASKELL_COMPATIBLE_WITH,
    deps = [
        ":demo-app",
        "@rules_dx//haskell/toolchain:base",
    ],
)

haskell_test(
    name = "demo-app_test",
    srcs = ["test/HelloTest.hs"],
    target_compatible_with = HASKELL_COMPATIBLE_WITH,
    deps = [
        ":demo-app",
        "@rules_dx//haskell/toolchain:base",
    ],
)
