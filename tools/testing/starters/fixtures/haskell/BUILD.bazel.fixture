load("@rules_dx//haskell:defs.bzl", "haskell_binary", "haskell_library", "haskell_test")

haskell_library(
    name = "demo-app",
    srcs = ["src/Hello.hs"],
    deps = ["@rules_dx//haskell:base"],
)

haskell_binary(
    name = "demo-app_bin",
    srcs = ["src/Main.hs"],
    deps = [
        ":demo-app",
        "@rules_dx//haskell:base",
    ],
)

haskell_test(
    name = "demo-app_test",
    srcs = ["test/HelloTest.hs"],
    deps = [
        ":demo-app",
        "@rules_dx//haskell:base",
    ],
)
