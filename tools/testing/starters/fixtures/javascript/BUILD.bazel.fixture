load("@rules_dx//javascript/rules:defs.bzl", "javascript_binary", "javascript_test", "javascript_library")

exports_files(["package.json"])

javascript_library(
    name = "demo-app",
    srcs = ["hello.js"],
)

javascript_binary(
    name = "demo-app_bin",
    data = [":demo-app"],
    entry_point = "main.js",
)

javascript_test(
    name = "demo-app_test",
    runner = "node",
    srcs = ["hello.test.js"],
    data = [":demo-app"],
    main = "hello.test.js",
    package_json = "package.json",
)
