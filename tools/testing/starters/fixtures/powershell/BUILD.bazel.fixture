load("@rules_dx//powershell:defs.bzl", "powershell_binary", "powershell_library", "powershell_test")

powershell_library(
    name = "demo-app",
    srcs = [
        "Hello.psd1",
        "Hello.psm1",
    ],
)

powershell_binary(
    name = "demo-app_bin",
    srcs = ["Main.ps1"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [":demo-app"],
)

powershell_test(
    name = "demo-app_test",
    srcs = ["Hello.Tests.ps1"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [":demo-app"],
)
