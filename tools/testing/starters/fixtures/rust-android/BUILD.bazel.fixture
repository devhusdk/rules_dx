# gazelle:ignore
load("@rules_dx//android/packaging:defs.bzl", "android_adb_install", "android_adb_log", "android_adb_start", "android_apk_check", "android_apk_release_sign", "rust_android_apk")
load("@rules_dx//cc/rules:defs.bzl", "cc_library")
load("@rules_dx//rust/rules:defs.bzl", "rust_clippy_test", "rust_static_library", "rust_test", "rustfmt_test")

rust_static_library(
    name = "demo-app",
    srcs = ["src/lib.rs"],
    crate_name = "demo_app",
    crate_root = "src/lib.rs",
    edition = "2021",
)

rust_test(
    name = "demo-app_test",
    crate = ":demo-app",
)

rustfmt_test(
    name = "demo-app_fmt_test",
    size = "small",
    targets = [":demo-app"],
)

rust_clippy_test(
    name = "demo-app_clippy_test",
    size = "small",
    targets = [":demo-app"],
)

cc_library(
    name = "demo-app_activity",
    srcs = ["activity.c"],
    linkopts = [
        "-landroid",
        "-llog",
    ],
    tags = ["manual"],
    deps = [":demo-app"],
    alwayslink = True,
)

rust_android_apk(
    name = "demo-app_apk",
    abis = [
        "arm64-v8a",
        "x86_64",
    ],
    api_level = 31,
    app_id = "com.example.demo_app",
    resource_files = ["res/values/strings.xml"],
    version_code = 1,
    version_name = "1.0",
    deps = [":demo-app_activity"],
)

android_apk_check(
    name = "demo-app_check_test",
    apk = ":demo-app_apk_unsigned_file",
    tags = ["manual"],
)

android_apk_release_sign(
    name = "demo-app_release_sign",
    apk = ":demo-app_apk_unsigned_file",
)

android_adb_install(
    name = "demo-app_install",
    apk = ":demo-app_apk_file",
    serial = "emulator-5554",
)

android_adb_start(
    name = "demo-app_start",
    app_id = "com.example.demo_app",
    serial = "emulator-5554",
)

android_adb_log(
    name = "demo-app_log",
    serial = "emulator-5554",
)
