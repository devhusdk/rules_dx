bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rust", version = "0.75.0")
bazel_dep(name = "rules_android", version = "0.8.1")

# The Android Rust targets need the two Android triples in the root toolchain.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    extra_target_triples = [
        "aarch64-linux-android",
        "x86_64-linux-android",
    ],
    rustfmt_version = "1.99.1",
    versions = ["1.99.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

android_ndk_toolchain_repo = use_repo_rule("@rules_dx//android:repos.bzl", "android_ndk_toolchain_repo")

android_ndk_toolchain_repo(
    name = "android_ndk_toolchain",
    api_level = 31,
    cxx_runtime = "static",
)

register_toolchains(
    "@android_ndk_toolchain//:ndk_cc_toolchain_device",
    "@android_ndk_toolchain//:ndk_cc_toolchain_emulator",
)

android_sdk = use_extension("@rules_dx//android:extensions.bzl", "android_sdk")
android_sdk.configure(accept_licenses = ["android-sdk-license"])
use_repo(android_sdk, "dx_android_sdk", "dx_androidsdk")

android_sdk_repository = use_extension("@rules_android//rules/android_sdk_repository:rule.bzl", "android_sdk_repository_extension")
override_repo(android_sdk_repository, androidsdk = "dx_androidsdk")
