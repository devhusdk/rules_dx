bazel_dep(name = "rules_rust", version = "0.75.0")

# The Android Rust targets need the two Android triples in the root toolchain.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    extra_target_triples = [
        "aarch64-linux-android",
        "x86_64-linux-android",
    ],
    rustfmt_version = "1.98.1",
    versions = ["1.98.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# The NDK C toolchain reads ANDROID_SDK_ROOT and ANDROID_NDK_REVISION; without them it is empty.
android_ndk_toolchain_repo = use_repo_rule("@rules_dx//android/toolchain:repos.bzl", "android_ndk_toolchain_repo")

android_ndk_toolchain_repo(
    name = "android_ndk_toolchain",
    api_level = 31,
    cxx_runtime = "static",
)
