android_ndk_toolchain_repo = use_repo_rule("@rules_dx//android:extensions.bzl", "android_ndk_toolchain_repo")

android_ndk_toolchain_repo(
    name = "android_ndk_toolchain",
    api_level = 31,
    cxx_runtime = "static",
)

register_toolchains(
    "@android_ndk_toolchain//:all",
)

dx_licenses = use_extension("@rules_dx//core:extensions.bzl", "dx_licenses")
dx_licenses.accept(ids = ["android-sdk-license"])

android = use_extension("@rules_dx//android:extensions.bzl", "android")
use_repo(android, "dx_android_sdk", "dx_androidsdk")

android_sdk_repository = use_extension("@rules_dx//android:extensions.bzl", "android_sdk_repository")
override_repo(android_sdk_repository, androidsdk = "dx_androidsdk")
