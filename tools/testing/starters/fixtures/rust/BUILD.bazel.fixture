load("@rules_dx//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

rust_library(
    name = "demo-app",
    srcs = ["src/lib.rs"],
    crate_name = "demo_app",
    crate_root = "src/lib.rs",
    edition = "2021",
)

rust_binary(
    name = "demo-app_bin",
    srcs = ["src/main.rs"],
    crate_name = "demo_app_bin",
    crate_root = "src/main.rs",
    edition = "2021",
    deps = [":demo-app"],
)

rust_test(
    name = "demo-app_test",
    crate = ":demo-app",
)
