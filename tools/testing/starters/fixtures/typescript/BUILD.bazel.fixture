load("@rules_dx//javascript:defs.bzl", "javascript_binary")
load("@rules_dx//typescript:defs.bzl", "typescript_test", "typescript_library")

exports_files(["package.json"])

typescript_library(
    name = "demo-app",
    srcs = [
        "hello.ts",
        "main.ts",
    ],
    declaration = True,
    tsconfig = "tsconfig.json",
)

javascript_binary(
    name = "demo-app_bin",
    data = [":demo-app"],
    main = "main.js",
)

typescript_test(
    name = "demo-app_test",
    runner = "node",
    srcs = ["hello_test.ts"],
    declaration = True,
    main = "hello_test.js",
    package_json = "package.json",
    tsconfig = "tsconfig.json",
    deps = [":demo-app"],
)
