load("@crates//:crates.bzl", "aliases")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "wasi_test_runner",
    testonly = True,
    srcs = ["wasi_test_runner.rs"],
    aliases = aliases(
        package_name = "tools/testing/wasi_testing",
        normal = True,
    ),
    crate_name = "wasi_test_runner",
    crate_root = "wasi_test_runner.rs",
    deps = [
        "//rust:wasi_run",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
