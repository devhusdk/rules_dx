load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//quality:fixtures.bzl", "real_source_target")
load(":clippy_tests.bzl", "clippy_config_test")

# Repo policy files that .bazelrc flags point at. Keep them out of the root
# package: loading it fetches every npm link repo.
package(default_visibility = ["//:__subpackages__"])

exports_files(["clippy.toml"])

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["clippy.toml"],
)

clippy_config_test(name = "clippy_config_test")

genquery(
    name = "dx_process_root_deps",
    expression = "filter('^//:', deps(//cli/process:dx_process_test))",
    scope = ["//cli/process:dx_process_test"],
)

write_file(
    name = "no_root_deps",
    out = "no_root_deps.txt",
    content = [],
)

# Rust tests must not depend on a //: label: loading the root package fetches every npm repo.
diff_test(
    name = "dx_process_root_deps_test",
    file1 = ":dx_process_root_deps",
    file2 = ":no_root_deps",
)
