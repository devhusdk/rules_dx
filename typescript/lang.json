{
  "$schema": "../core/modules/lang.schema.json",
  "name": "typescript",
  "title": "TypeScript",
  "family": "core",
  "ecosystems": [
    "npm"
  ],
  "depcheck": "ts",
  "semver": true,
  "manifests": [
    "package.json",
    "tsconfig.json"
  ],
  "lockfiles": [
    "pnpm-lock.yaml"
  ],
  "tools": [
    "biome",
    "eslint"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_arm64",
    "windows_x86_64"
  ],
  "pins": [],
  "entry_points": [
    "typescript_library",
    "typescript_proto_library",
    "typescript_binary",
    "typescript_test",
    "typescript_bench",
    "typescript_fuzz_test",
    "typescript_playwright_test"
  ],
  "quality": {
    "bzl": "javascript/private/quality:js.bzl",
    "file_extensions": [
      ".cts",
      ".mts",
      ".ts",
      ".tsx"
    ]
  },
  "docs": {
    "bzl": "tools/docs/typescript:aspect.bzl",
    "file_extensions": [
      ".cts",
      ".mts",
      ".ts",
      ".tsx"
    ],
    "aspects": [
      "real_typescript_docs_aspect"
    ]
  }
}
