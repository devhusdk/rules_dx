# gazelle:ignore
load("@aspect_rules_js//js:defs.bzl", "js_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//javascript:defs.bzl", "javascript_test")
load("//typescript/private/playwright:closure.bzl", "CLOSURE_DIR")
load("//typescript/private/playwright:repos.bzl", "CHROMIUM_REVISION", "CHROMIUM_VERSION", "PLAYWRIGHT_VERSION")
load(":playwright_tests.bzl", "playwright_compatibility_tests")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

playwright_compatibility_tests(name = "playwright_compatibility_tests")

javascript_test(
    name = "playwright_pins_test",
    size = "small",
    srcs = ["playwright_pins_test.cjs"],
    data = [
        "//:node_modules",
        "//:package_json",
        "//typescript:README.md",
        "//typescript/private/playwright:pins",
    ],
    env = {
        "DX_PACKAGE_JSON": "$(rlocationpath //:package_json)",
        "DX_PLAYWRIGHT_CHROMIUM_REVISION": CHROMIUM_REVISION,
        "DX_PLAYWRIGHT_CHROMIUM_VERSION": CHROMIUM_VERSION,
        "DX_PLAYWRIGHT_PINS": "$(rlocationpath //typescript/private/playwright:pins)",
        "DX_PLAYWRIGHT_VERSION": PLAYWRIGHT_VERSION,
        "DX_README": "$(rlocationpath //typescript:README.md)",
    },
    main = "playwright_pins_test.cjs",
    no_copy_to_bin = ["//typescript:README.md"],
    runner = "node",
)

javascript_test(
    name = "playwright_chromium_env_test",
    size = "small",
    srcs = ["playwright_chromium_env_test.cjs"],
    data = ["//typescript/private/playwright:chromium_env"],
    env = {"DX_PLAYWRIGHT_CHROMIUM_ENV": "$(rlocationpath //typescript/private/playwright:chromium_env)"},
    main = "playwright_chromium_env_test.cjs",
    runner = "node",
)

javascript_test(
    name = "playwright_closure_test",
    size = "small",
    srcs = ["playwright_closure_test.cjs"],
    data = [
        "@dx_playwright_chromium//:browsers",
        "@dx_playwright_chromium//:closure",
        "@dx_playwright_chromium//:marker",
    ],
    env = {
        "DX_PLAYWRIGHT_CLOSURE_DIR": CLOSURE_DIR,
        "DX_PLAYWRIGHT_MARKER": "$(rlocationpath @dx_playwright_chromium//:marker)",
    },
    main = "playwright_closure_test.cjs",
    no_copy_to_bin = [
        "@dx_playwright_chromium//:browsers",
        "@dx_playwright_chromium//:closure",
        "@dx_playwright_chromium//:marker",
    ],
    runner = "node",
    target_compatible_with = ["@platforms//os:linux"],
)

js_test(
    name = "tsc_gate_test",
    size = "small",
    data = ["//typescript/private/quality:tsc_gate.mjs"],
    entry_point = "tsc_gate_test.mjs",
    env = {"DX_TSC_GATE": "$(rlocationpath //typescript/private/quality:tsc_gate.mjs)"},
    no_copy_to_bin = ["//typescript/private/quality:tsc_gate.mjs"],
)

test_suite(
    name = "fixture_tests",
    tests = [
        "//typescript/tests/fixtures/root_dir/app:app_gate_exit_test",
        "//typescript/tests/fixtures/root_dir/app:app_gate_manual_test",
        "//typescript/tests/fixtures/declarations:main_bin_typecheck_test",
        "//typescript/tests/fixtures/declarations:main_output_test",
        "//typescript/tests/fixtures/hello:hello_output_test",
        "//typescript/tests/fixtures/hello:hello_test",
        "//typescript/tests/fixtures/hello:plain_test",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "playwright_tests.bzl",
    ],
    tags = ["corpus"],
)
