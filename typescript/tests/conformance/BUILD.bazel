# gazelle:ignore
load("//tools/testing/conformance:defs.bzl", "dx_conformance_suite", "subject_compatible_with")
load("//typescript:defs.bzl", "typescript_binary", "typescript_library", "typescript_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

typescript_library(
    name = "conformance",
    srcs = ["greet.ts"],
    declaration = True,
    tsconfig = "tsconfig.json",
)

typescript_library(
    name = "lint_dirty",
    srcs = ["lint_dirty.ts"],
    declaration = True,
    tsconfig = "tsconfig.json",
)

typescript_library(
    name = "format_dirty",
    srcs = ["format_dirty.ts"],
    declaration = True,
    tsconfig = "tsconfig.json",
)

typescript_binary(
    name = "hello",
    srcs = ["main.ts"],
    declaration = True,
    tsconfig = "tsconfig.json",
    deps = [":conformance"],
)

typescript_binary(
    name = "lock_hello",
    srcs = ["lock_main.ts"],
    data = ["//:package_json"],
    declaration = True,
    tsconfig = "tsconfig.json",
    deps = ["//:node_modules/clsx"],
)

typescript_binary(
    name = "runfiles_hello",
    srcs = ["runfiles_main.ts"],
    data = [
        "data.txt",
        "//:package_json",
    ],
    declaration = True,
    tsconfig = "tsconfig.json",
)

typescript_test(
    name = "pass_subject_test",
    size = "small",
    srcs = ["pass_test.ts"],
    config = "jest.config.cjs",
    declaration = True,
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
    package_json = "//:package_json",
    target_compatible_with = subject_compatible_with(),
    tsconfig = "tsconfig.json",
    deps = [":conformance"],
)

typescript_test(
    name = "fail_subject_test",
    size = "small",
    srcs = ["fail_test.ts"],
    config = "jest.config.cjs",
    declaration = True,
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
    package_json = "//:package_json",
    target_compatible_with = subject_compatible_with(),
    tsconfig = "tsconfig.json",
    deps = [":conformance"],
)

dx_conformance_suite(
    name = "",
    size = "small",
    binary = ":hello",
    covered_source = "greet.js",
    cross_runfile = "node",
    expected = "hello world",
    failing_case = "failing case",
    failing_pattern = "{case} (",
    failing_test = ":fail_subject_test",
    lang = "typescript",
    lock = {
        "binary": ":lock_hello",
        "ecosystem": "js",
        "expected": "hello lock",
        "lockfile": "//:pnpm-lock.yaml",
        "manifest": "//:package.json",
        "package": "clsx",
        "stale": "pnpm-lock.stale.yaml",
    },
    passing_test = ":pass_subject_test",
    quality = {
        "clean": ":conformance",
        "format_dirty": ":format_dirty",
        "format_source": "format_dirty.ts",
        "lint_dirty": ":lint_dirty",
        "lint_line": 2,
        "lint_rule": "lint/correctness/noUnusedVariables",
        "lint_source": "lint_dirty.ts",
    },
    runfiles = {
        "binary": ":runfiles_hello",
        "data": "data.txt",
        "expected": "hello runfiles",
    },
)
