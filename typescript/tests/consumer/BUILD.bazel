    name = "greet",
    srcs = ["greet.ts"],
    declaration = True,
    tsconfig = ":tsconfig",
    visibility = ["//visibility:public"],
)

typescript_binary(
    name = "main_bin",
    srcs = ["main.ts"],
    main = "main.ts",
    tsconfig = ":tsconfig",
    deps = [":greet"],
