load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("//javascript:defs.bzl", "javascript_binary")
load("//quality:fixtures.bzl", "real_source_target")
load("//typescript:defs.bzl", "typescript_library")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

typescript_library(
    name = "helper",
    testonly = True,
    srcs = ["helper.ts"],
    declaration = True,
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
)

typescript_library(
    name = "main",
    testonly = True,
    srcs = ["main.ts"],
    declaration = True,
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
    deps = [":helper"],
)

javascript_binary(
    name = "main_bin",
    testonly = True,
    data = [":main"],
    main = "main.js",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

ts_config(
    name = "tsconfig",
    testonly = True,
    src = "tsconfig.json",
    visibility = ["//visibility:public"],
)
