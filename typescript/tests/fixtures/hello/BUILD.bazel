load("//javascript/rules:defs.bzl", "javascript_binary")
load("//quality:fixtures.bzl", "real_source_target")
load("//tools/sh:harness.bzl", "dx_shell_harness")
load("//typescript/rules:defs.bzl", "typescript_project", "typescript_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

typescript_project(
    name = "hello_lib",
    srcs = [
        "hello.ts",
        "main.ts",
    ],
    declaration = True,
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
)

javascript_binary(
    name = "hello",
    data = [":hello_lib"],
    entry_point = "main.js",
)

typescript_test(
    name = "hello_test",
    srcs = ["hello_test.ts"],
    config = "jest.config.cjs",
    declaration = True,
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
    deps = [":hello_lib"],
)

dx_shell_harness(
    name = "hello_output_test",
    srcs = ["hello_output_test.sh"],
    args = ["$(rootpath :hello)"],
    data = [
        ":hello",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
