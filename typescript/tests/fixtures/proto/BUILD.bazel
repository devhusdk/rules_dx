# gazelle:ignore
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//typescript:defs.bzl", "typescript_proto_library")
load(":proto_args_tests.bzl", "proto_args_tests")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

proto_library(
    name = "user_proto",
    srcs = ["user.proto"],
    visibility = [
        "//:__subpackages__",
        "//gazelle/protobuf/tests/grpc:__pkg__",
    ],
    strip_import_prefix = "/",
)

typescript_proto_library(
    name = "user_proto_ts",
    deps = ["//:node_modules/@bufbuild/protobuf"],
    proto = ":user_proto",
    tsconfig = "tsconfig.json",
)

proto_library(
    name = "order_proto",
    srcs = ["v1/order.proto"],
    strip_import_prefix = "/",
)

typescript_proto_library(
    name = "order_proto_ts",
    deps = ["//:node_modules/@bufbuild/protobuf"],
    proto = ":order_proto",
    tsconfig = "tsconfig.json",
)

proto_library(
    name = "item_proto",
    srcs = ["stripped/item.proto"],
    strip_import_prefix = "stripped",
)

typescript_proto_library(
    name = "item_proto_ts",
    deps = ["//:node_modules/@bufbuild/protobuf"],
    proto = ":item_proto",
    tsconfig = "tsconfig.json",
)

proto_library(
    name = "event_proto",
    srcs = ["event.proto"],
    strip_import_prefix = "/",
    deps = ["@protobuf//:timestamp_proto"],
)

typescript_proto_library(
    name = "event_proto_ts",
    deps = ["//:node_modules/@bufbuild/protobuf"],
    proto = ":event_proto",
    tsconfig = "tsconfig.json",
)

proto_args_tests(
    name = "proto_args_test",
    target = ":event_proto_ts_srcs",
)
