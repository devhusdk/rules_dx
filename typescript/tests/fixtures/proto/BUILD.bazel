# gazelle:ignore
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//typescript/rules:defs.bzl", "ts_proto_library")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

proto_library(
    name = "user_proto",
    srcs = ["user.proto"],
    strip_import_prefix = "/",
)

ts_proto_library(
    name = "user_proto_ts",
    deps = ["//:node_modules/@bufbuild/protobuf"],
    proto = ":user_proto",
    tsconfig = "tsconfig.json",
)

proto_library(
    name = "order_proto",
    srcs = ["v1/order.proto"],
    strip_import_prefix = "/",
)

ts_proto_library(
    name = "order_proto_ts",
    deps = ["//:node_modules/@bufbuild/protobuf"],
    proto = ":order_proto",
    tsconfig = "tsconfig.json",
)

proto_library(
    name = "item_proto",
    srcs = ["stripped/item.proto"],
    strip_import_prefix = "stripped",
)

ts_proto_library(
    name = "item_proto_ts",
    deps = ["//:node_modules/@bufbuild/protobuf"],
    proto = ":item_proto",
    tsconfig = "tsconfig.json",
)
