# gazelle:ignore
load("//core/quality:fixtures.bzl", "real_source_target")
load("//javascript:defs.bzl", "javascript_test")
load("//typescript/private/playwright:closure.bzl", "CLOSURE_DIR")
load("//typescript/private/playwright:repos.bzl", "CHROMIUM_REVISION", "CHROMIUM_VERSION", "PLAYWRIGHT_VERSION")
load(":compatibility_tests.bzl", "playwright_compatibility_tests")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

playwright_compatibility_tests(name = "compatibility_tests")

javascript_test(
    name = "pins_test",
    size = "small",
    srcs = ["pins_test.cjs"],
    data = [
        "//:node_modules",
        "//:package_json",
        "//typescript:README.md",
        "//typescript/private/playwright:pins",
    ],
    env = {
        "DX_PACKAGE_JSON": "$(rlocationpath //:package_json)",
        "DX_PLAYWRIGHT_CHROMIUM_REVISION": CHROMIUM_REVISION,
        "DX_PLAYWRIGHT_CHROMIUM_VERSION": CHROMIUM_VERSION,
        "DX_PLAYWRIGHT_PINS": "$(rlocationpath //typescript/private/playwright:pins)",
        "DX_PLAYWRIGHT_VERSION": PLAYWRIGHT_VERSION,
        "DX_README": "$(rlocationpath //typescript:README.md)",
    },
    main = "pins_test.cjs",
    no_copy_to_bin = ["//typescript:README.md"],
    runner = "node",
)

javascript_test(
    name = "chromium_env_test",
    size = "small",
    srcs = ["chromium_env_test.cjs"],
    data = ["//typescript/private/playwright:chromium_env"],
    env = {"DX_PLAYWRIGHT_CHROMIUM_ENV": "$(rlocationpath //typescript/private/playwright:chromium_env)"},
    main = "chromium_env_test.cjs",
    runner = "node",
)

javascript_test(
    name = "closure_test",
    size = "small",
    srcs = ["closure_test.cjs"],
    data = [
        "@dx_playwright_chromium//:browsers",
        "@dx_playwright_chromium//:closure",
        "@dx_playwright_chromium//:marker",
    ],
    env = {
        "DX_PLAYWRIGHT_CLOSURE_DIR": CLOSURE_DIR,
        "DX_PLAYWRIGHT_MARKER": "$(rlocationpath @dx_playwright_chromium//:marker)",
    },
    main = "closure_test.cjs",
    no_copy_to_bin = [
        "@dx_playwright_chromium//:browsers",
        "@dx_playwright_chromium//:closure",
        "@dx_playwright_chromium//:marker",
    ],
    runner = "node",
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "compatibility_tests.bzl",
    ],
    tags = ["corpus"],
)
