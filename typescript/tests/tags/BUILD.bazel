    testonly = True,
    srcs = ["tagged.ts"],
    aspect_hints = ["//:biome_config"],
    declaration = True,
    tags = [
        "manual",
        "no-lint",
        "no-remote-exec",
    ],
    tsconfig = "base_tagged.json",
)

typescript_project(
    name = "plain",
    testonly = True,
    srcs = ["plain.ts"],
    aspect_hints = ["//:biome_config"],
    declaration = True,
    tsconfig = "base_plain.json",
)

tag_subject(
    name = "tags_subject",
    testonly = True,
    targets = [
        ":plain",
        ":plain_upstream",
        ":plain_typecheck",
        ":plain_typecheck_test",
        ":plain_upstream_typecheck",
        ":plain_upstream_typecheck_test",
