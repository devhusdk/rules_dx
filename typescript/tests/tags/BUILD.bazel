        ":tagged_typecheck",
        ":tagged_typecheck_test",
        ":tagged_upstream_typecheck",
        ":tagged_upstream_typecheck_test",
    ],
)

starlark_test(
    name = "tags_test",
    expected_observations = """subject //typescript/tests/tags:tags_subject
field plain=(none)
field plain_typecheck=manual
field plain_typecheck_test=(none)
field plain_upstream=manual
field plain_upstream_typecheck=manual
field plain_upstream_typecheck_test=manual
field tagged=manual,no-lint,no-remote-exec
field tagged_typecheck=dx:no-lint,manual,no-remote-exec
field tagged_typecheck_test=manual,no-lint,no-remote-exec
field tagged_upstream=dx:no-lint,manual,no-remote-exec
field tagged_upstream_typecheck=dx:no-lint,manual,no-remote-exec
field tagged_upstream_typecheck_test=dx:no-lint,manual,no-remote-exec
aspect_field aspect_seen=True
aspect_field field_count=12
aspect_field has_subject=True
aspect_field subject_label=//typescript/tests/tags:tags_subject
aspect_field transitive_count=0
""",
    mode = "analysis",
    subjects = [":tags_subject"],
)

real_source_target(
