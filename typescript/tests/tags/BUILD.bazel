load("//libs/starlark:defs.bzl", "starlark_test")
load("//libs/starlark:tag_probe.bzl", "tag_subject")
load("//quality:fixtures.bzl", "real_source_target")
load("//typescript/rules:defs.bzl", "typescript_project")

typescript_project(
    name = "tagged",
    testonly = True,
    srcs = ["tagged.ts"],
    declaration = True,
    tags = [
        "manual",
        "no-lint",
        "no-remote-exec",
    ],
    tsconfig = "base_tagged.json",
)

typescript_project(
    name = "plain",
    testonly = True,
    srcs = ["plain.ts"],
    declaration = True,
    tsconfig = "base_plain.json",
)

tag_subject(
    name = "tags_subject",
    testonly = True,
    targets = [
        ":plain",
        ":plain_upstream",
        ":tagged",
        ":tagged_upstream",
    ],
)

starlark_test(
    name = "tags_test",
    expected_observations = """subject //typescript/tests/tags:tags_subject
field plain=(none)
field plain_upstream=manual
field tagged=manual,no-lint,no-remote-exec
field tagged_upstream=dx:no-lint,manual,no-remote-exec
aspect_field aspect_seen=True
aspect_field field_count=4
aspect_field has_subject=True
aspect_field subject_label=//typescript/tests/tags:tags_subject
aspect_field transitive_count=0
""",
    mode = "analysis",
    subjects = [":tags_subject"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
