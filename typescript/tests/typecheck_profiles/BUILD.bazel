# gazelle:exclude src
load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//javascript/private/quality:tsc_report.bzl", "tsc_report")
load("//typescript:defs.bzl", "typescript_library")

package(
    default_testonly = True,
    default_visibility = ["//visibility:private"],
)

[
    copy_file(
        name = "%s_base" % profile,
        src = "//core/quality/tiers/tsconfig:%s.json" % profile,
        out = ".dx/config/tsconfig/%s.json" % profile,
    )
    for profile in [
        "standard",
        "strict",
    ]
]

ts_config(
    name = "standard_config",
    src = "standard.tsconfig.json",
    deps = [":standard_base"],
)

ts_config(
    name = "strict_config",
    src = "strict.tsconfig.json",
    deps = [
        ":standard_base",
        ":strict_base",
    ],
)

[
    typescript_library(
        name = profile,
        srcs = ["src/main.ts"],
        isolated_typecheck = False,
        out_dir = profile,
        tags = tags,
        transpiler = "tsc",
        tsconfig = ":%s_config" % profile,
    )
    for profile, tags in [
        ("standard", []),
        # strict fails on purpose (TS6133); strict_test diffs the tsc output instead.
        ("strict", ["manual"]),
    ]
]

[
    tsc_report(
        name = "%s_report" % profile,
        kind = "stdout",
        target = ":" + profile,
    )
    for profile in [
        "standard",
        "strict",
    ]
]

[
    diff_test(
        name = "%s_test" % profile,
        file1 = "%s.stdout.expected" % profile,
        file2 = ":%s_report" % profile,
    )
    for profile in [
        "standard",
        "strict",
    ]
]

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//:__pkg__"],
)
