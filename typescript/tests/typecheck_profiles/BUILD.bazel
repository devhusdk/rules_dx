# gazelle:exclude src
load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//typescript:defs.bzl", "typescript_library")
load("//typescript/private/quality:tsc_report.bzl", "tsc_report", "tsc_stdout_test")

package(
    default_testonly = True,
    default_visibility = ["//visibility:private"],
)

[
    copy_file(
        name = "%s_base" % profile,
        src = "//core/quality/tiers/tsconfig:%s.json" % profile,
        out = ".dx/config/tsconfig/%s.json" % profile,
    )
    for profile in [
        "standard",
        "strict",
    ]
]

ts_config(
    name = "standard_config",
    src = "standard.tsconfig.json",
    deps = [":standard_base"],
)

ts_config(
    name = "strict_config",
    src = "strict.tsconfig.json",
    deps = [
        ":standard_base",
        ":strict_base",
    ],
)

[
    typescript_library(
        name = profile,
        srcs = ["src/main.ts"],
        isolated_typecheck = False,
        out_dir = profile,
        tags = tags,
        transpiler = "tsc",
        tsconfig = ":%s_config" % profile,
    )
    for profile, tags in [
        ("standard", []),
        (
            "strict",
            ["manual"],
        ),
    ]
]

[
    tsc_report(
        name = "%s_report" % profile,
        kind = "stdout",
        target = ":" + profile,
    )
    for profile in [
        "standard",
        "strict",
    ]
]

[
    tsc_stdout_test(
        name = "%s_test" % profile,
        diagnostics = {"strict": """main.ts(2,9): error TS6133: 'unused' is declared but its value is never read.
"""}.get(profile, ""),
        expected = "%s.stdout.expected" % profile,
        report = ":%s_report" % profile,
    )
    for profile in [
        "standard",
        "strict",
    ]
]

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
    visibility = ["//:__pkg__"],
)
