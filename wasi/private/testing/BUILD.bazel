load("@crates//:crates.bzl", "aliases")
load("//core/quality:fixtures.bzl", "real_source_target")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "wasi_run",
    testonly = True,
    srcs = ["wasi_run.rs"],
    aliases = aliases(
        package_name = "wasi/private/wasi_testing",
        normal = True,
    ),
    crate_name = "wasi_run",
    crate_root = "wasi_run.rs",
    deps = ["//tools/testing:dx_testing"],
)

rust_test(
    name = "wasi_run_unit_test",
    aliases = aliases(
        package_name = "wasi/private/wasi_testing",
        normal = True,
        normal_dev = True,
    ),
    crate = ":wasi_run",
    deps = [],
)

rust_binary(
    name = "wasi_test_runner",
    testonly = True,
    srcs = ["wasi_test_runner.rs"],
    aliases = aliases(
        package_name = "wasi/private/wasi_testing",
        normal = True,
    ),
    crate_name = "wasi_test_runner",
    crate_root = "wasi_test_runner.rs",
    deps = [
        ":wasi_run",
        "//tools/testing:dx_testing",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//tools/docs/support_matrix:__pkg__"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)
