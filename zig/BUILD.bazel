load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")

exports_files([
    "README.md",
    "defs.bzl",
    "extensions.bzl",
    "lang.json",
    "pins.json",
])

bool_flag(
    name = "kcov",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "kcov_build",
    flag_values = {":kcov": "true"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "sancov_build",
    constraint_values = ["@platforms//os:macos"],
    flag_values = {":kcov": "true"},
    visibility = ["//visibility:public"],
)

real_source_target(
    name = "corpus_markdown",
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "extensions.bzl",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//tools/api:__pkg__"],
)
