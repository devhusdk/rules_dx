{
  "$schema": "../core/modules/lang.schema.json",
  "name": "zig",
  "title": "Zig",
  "family": "core",
  "ecosystems": [
    "zig"
  ],
  "depcheck": "zig",
  "semver": false,
  "manifests": [
    "build.zig.zon"
  ],
  "lockfiles": [],
  "setup": {
    "hubs": [
      {
        "ecosystem": "zig",
        "manifest": "build.zig.zon",
        "lock": "zig.lock.json",
        "state": null,
        "extension": "@rules_dx//zig:extensions.bzl",
        "tag": "lock",
        "hub": "zig",
        "resolver": "@rules_dx//zig/private/tools/lock",
        "imports": "provides"
      }
    ]
  },
  "tools": [
    "zig_fmt"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_arm64",
    "windows_x86_64"
  ],
  "pins": [
    "pins.json"
  ],
  "entry_points": [
    "zig_library",
    "zig_binary",
    "zig_test",
    "zig_bench"
  ],
  "quality": {
    "bzl": "zig/private/quality:zig.bzl",
    "file_extensions": [
      ".zig"
    ],
    "aspects": {
      "format": [
        "real_zig_format_aspect"
      ],
      "lint": [
        "real_zig_lint_aspect"
      ],
      "typecheck": [
        "real_zig_typecheck_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_zig_format_probe_aspect"
      ],
      "lint": [
        "real_zig_lint_probe_aspect"
      ],
      "typecheck": [
        "real_zig_typecheck_probe_aspect"
      ]
    }
  },
  "docs": {
    "bzl": "tools/docs/zig:aspect.bzl",
    "file_extensions": [
      ".zig"
    ],
    "aspects": [
      "real_zig_docs_aspect"
    ]
  }
}
