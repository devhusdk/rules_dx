{
  "$schema": "../core/modules/lang.schema.json",
  "name": "zig",
  "title": "Zig",
  "family": "core",
  "ecosystems": [
    "zig"
  ],
  "depcheck": "zig",
  "semver": false,
  "manifests": [
    "build.zig.zon"
  ],
  "lockfiles": [],
  "tools": [
    "zig_fmt"
  ],
  "platforms": [
    "linux_arm64",
    "linux_x86_64",
    "macos_arm64",
    "windows_arm64",
    "windows_x86_64"
  ],
  "pins": [],
  "entry_points": [
    "zig_import_name",
    "zig_library",
    "zig_binary",
    "zig_test",
    "zig_bench"
  ],
  "quality": {
    "bzl": "core/quality:families/zig.bzl",
    "file_extensions": [
      ".zig"
    ],
    "aspects": {
      "format": [
        "real_zig_format_aspect"
      ],
      "lint": [
        "real_zig_lint_aspect"
      ],
      "typecheck": [
        "real_zig_typecheck_aspect"
      ]
    },
    "probes": {
      "format": [
        "real_zig_format_probe_aspect"
      ],
      "lint": [
        "real_zig_lint_probe_aspect"
      ],
      "typecheck": [
        "real_zig_typecheck_probe_aspect"
      ]
    }
  },
  "docs": {
    "bzl": "tools/docs/zig:aspect.bzl",
    "file_extensions": [
      ".zig"
    ],
    "aspects": [
      "real_zig_docs_aspect"
    ]
  }
}
