# gazelle:exclude coverage_runner.zig
# Why: a zig_test coverage build passes it as test_runner; it is no module.
load("//core/quality:fixtures.bzl", "real_source_target")
load(":mode.bzl", "zig_release_fast")

package(default_visibility = [
    "//:__pkg__",
    "//tools/ci:__pkg__",
    "//zig:__subpackages__",
])

exports_files([
    "bench_run.sh",
    "coverage_runner.zig",
    "defs.bzl",
    "toolchains.BUILD.bazel",
])

platform(
    name = "kcov_linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    visibility = ["//tools/coverage/kcov:__pkg__"],
)

platform(
    name = "kcov_macos_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
    visibility = ["//tools/coverage/kcov:__pkg__"],
)

zig_release_fast(
    name = "release_fast",
    value = select({
        "@rules_zig//zig/config/mode:release_fast": True,
        "//conditions:default": False,
    }),
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
        "mode.bzl",
        "toolchains.BUILD.bazel",
    ],
    tags = ["corpus"],
)

filegroup(
    name = "module_srcs",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)
