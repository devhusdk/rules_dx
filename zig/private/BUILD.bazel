load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = [
    "//:__pkg__",
    "//tools/ci:__pkg__",
    "//zig:__subpackages__",
])

exports_files([
    "bench_run.sh",
    "defs.bzl",
])

bool_flag(
    name = "kcov",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "kcov_build",
    flag_values = {":kcov": "true"},
    visibility = ["//visibility:public"],
)

platform(
    name = "kcov_linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    visibility = ["//tools/coverage/kcov:__pkg__"],
)

platform(
    name = "kcov_macos_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
    visibility = ["//tools/coverage/kcov:__pkg__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "defs.bzl",
    ],
    tags = ["corpus"],
)
