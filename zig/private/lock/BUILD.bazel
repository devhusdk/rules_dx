load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("//core/quality:fixtures.bzl", "real_source_target")
load(":hub_tests.bzl", "zig_hub_tests")
load("//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:private"])

rust_library(
    name = "zig_lock_lib",
    srcs = ["src/resolve.rs"],
    aliases = aliases(
        package_name = "zig/private/zig_lock",
        normal = True,
    ),
    crate_name = "zig_lock",
    crate_root = "src/resolve.rs",
    deps = all_crate_deps(
        package_name = "zig/private/zig_lock",
        normal = True,
    ) + [
        "//cli/digest:dx_digest",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
    ],
)

rust_binary(
    name = "lock",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "zig/private/zig_lock",
        normal = True,
    ),
    crate_name = "zig_lock_bin",
    crate_root = "src/main.rs",
    visibility = ["//zig:__pkg__"],
    deps = all_crate_deps(
        package_name = "zig/private/zig_lock",
        normal = True,
    ) + [
        ":zig_lock_lib",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
    ],
)

zig_hub_tests(name = "hub", size = "small")

rust_test(
    name = "resolve_test",
    size = "small",
    srcs = ["tests/resolve_test.rs"],
    aliases = aliases(
        package_name = "zig/private/zig_lock",
        normal = True,
        normal_dev = True,
    ),
    crate_name = "resolve_test",
    crate_root = "tests/resolve_test.rs",
    deps = all_crate_deps(
        package_name = "zig/private/zig_lock",
        normal = True,
        normal_dev = True,
    ) + [
        ":zig_lock_lib",
        "//cli/families:dx_families",
        "//cli/lock:dx_lock",
        "//tools/testing:dx_testing",
    ],
    data = [
        "testdata/base.zip",
        "testdata/golden.lock.json",
        "testdata/mini.tar.gz",
    ],
    env = {
        "BASE": "$(rootpath testdata/base.zip)",
        "GOLDEN": "$(rootpath testdata/golden.lock.json)",
        "MINI": "$(rootpath testdata/mini.tar.gz)",
    },
    tags = ["block-network"],
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel", "hub.bzl", "hub_tests.bzl"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

exports_files(
    ["Cargo.toml", "hub.bzl"],
    visibility = ["//visibility:public"],
)
