load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")
load("//core:conformance.bzl", "dx_wrapper_contract_tests")
load("//core:defs.bzl", "expect_equal")
load("//core:entry.bzl", "dx_entry_quality_srcs")
load("//core:wrapper.bzl", "DX_NO_COVERAGE_COLLECTOR_TAG", "dx_with_tag")
load("//zig/private:defs.bzl", "ZIG_COVERAGE_COLLECTOR", "ZIG_QUALITY_TOOLS", "zig_import_name")
load(":hub_tests.bzl", "zig_hub_tests")

package(default_visibility = ["//visibility:private"])

dx_wrapper_contract_tests(
    name = "wrapper_contract_tests",
    size = "small",
    extra_checks = [
        expect_equal(
            "wrappers carry zig_ast_check and zig_fmt",
            sorted(ZIG_QUALITY_TOOLS.keys()),
            [
                "zig_ast_check",
                "zig_fmt",
            ],
        ),
        expect_equal(
            "main leads the owned sources",
            dx_entry_quality_srcs(
                "main.zig",
                ["util.zig"],
            ),
            [
                "main.zig",
                "util.zig",
            ],
        ),
        expect_equal(
            "main listed in srcs is owned once",
            dx_entry_quality_srcs(
                "main.zig",
                [
                    "main.zig",
                    "util.zig",
                ],
            ),
            [
                "main.zig",
                "util.zig",
            ],
        ),
        expect_equal(
            "root-module binaries own no direct sources",
            dx_entry_quality_srcs(None, None),
            [],
        ),
        expect_equal(
            "import name defaults to the public target name",
            zig_import_name("greet", None),
            "greet",
        ),
        expect_equal(
            "zig tests collect coverage with kcov",
            ZIG_COVERAGE_COLLECTOR,
            True,
        ),
        expect_equal(
            "no-collector tag is appended after user tags",
            dx_with_tag(
                ["manual"],
                DX_NO_COVERAGE_COLLECTOR_TAG,
            ),
            [
                "manual",
                "dx-no-coverage-collector",
            ],
        ),
        expect_equal(
            "no-collector tag is added once",
            dx_with_tag(
                ("dx-no-coverage-collector",),
                DX_NO_COVERAGE_COLLECTOR_TAG,
            ),
            ["dx-no-coverage-collector"],
        ),
        expect_equal(
            "no-collector tag on no tags",
            dx_with_tag(None, DX_NO_COVERAGE_COLLECTOR_TAG),
            ["dx-no-coverage-collector"],
        ),
        expect_equal(
            "explicit import name wins",
            zig_import_name("greet_lib", "greet"),
            "greet",
        ),
    ],
    file_classes = ["zig"],
)

zig_hub_tests(
    name = "hub",
    size = "small",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "hub_tests.bzl",
    ],
    tags = ["corpus"],
)
