load("//quality:fixtures.bzl", "real_source_target")
load("//zig/rules:defs.bzl", "zig_library", "zig_test")
load("//zig/rules:wrapper_tests.bzl", "zig_kcov_env_test")

package(default_visibility = ["//:__subpackages__"])

zig_library(
    name = "calc",
    testonly = True,
    main = "calc.zig",
)

zig_test(
    name = "calc_test",
    main = "calc_test.zig",
    deps = [":calc"],
)

zig_kcov_env_test(
    name = "calc_test_kcov_test",
    instrumented = ["zig/tests/fixtures/calc/calc.zig"],
    target = ":calc_test",
    upstream = "calc_test_upstream",
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)
