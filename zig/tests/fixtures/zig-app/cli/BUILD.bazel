load("@rules_dx//zig:defs.bzl", "zig_binary", "zig_library", "zig_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_dx//core/quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//zig/tests/fixtures/zig-app:__subpackages__"])

exports_files(
    [
        "BUILD.bazel",
        "exit_codes.sh",
        "main.zig",
        "report.zig",
        "report_test.zig",
    ],
    visibility = ["//visibility:public"],
)

zig_library(
    name = "report",
    main = "report.zig",
    deps = [
        "//zig/tests/fixtures/zig-app/catalog",
        "//zig/tests/fixtures/zig-app/digest",
    ],
)

zig_test(
    name = "report_test",
    main = "report_test.zig",
    deps = [
        ":report",
        "//zig/tests/fixtures/zig-app/catalog",
        "//zig/tests/fixtures/zig-app/digest",
    ],
)

zig_binary(
    name = "manifest",
    main = "main.zig",
    deps = [
        ":report",
        "//zig/tests/fixtures/zig-app/catalog",
    ],
)

sh_test(
    name = "exit_codes_test",
    size = "small",
    srcs = ["exit_codes.sh"],
    args = ["$(rootpath :manifest)"],
    data = [":manifest"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],    visibility = ["//:__pkg__"],
)
